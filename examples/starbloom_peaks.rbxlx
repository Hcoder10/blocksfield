LookKit.presets = LOOKS
LookKit.looks = { "toon_bright", "realistic", "cozy", "neon_night", "dark_fantasy", "snow", "desert", "candy", "space" }
LookKit.current = nil
LookKit.palette = merge(BASE_PALETTE, LOOKS.toon_bright.palette)
LookKit.materials = TOON_MATS
LookKit.isToon = true

-- ---------------------------------------------------------------------------------------------------- apply

local function ensure(parent, class, name)
	local inst = parent:FindFirstChild(name)
	if not inst or not inst:IsA(class) then
		inst = Instance.new(class)
		inst.Name = name
		inst.Parent = parent
	end
	return inst
end

local function setProps(inst, props, tweenTime)
	local tweenable, direct = {}, {}
	for k, v in pairs(props) do
		local t = typeof(v)
		if tweenTime and tweenTime > 0 and (t == "number" or t == "Color3") then
			tweenable[k] = v
		else
			direct[k] = v
		end
	end
	for k, v in pairs(direct) do
		pcall(function() inst[k] = v end)
	end
	if next(tweenable) then
		local ok = pcall(function()
			TweenService:Create(inst, TweenInfo.new(tweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				tweenable):Play()
		end)
		if not ok then
			for k, v in pairs(tweenable) do
				pcall(function() inst[k] = v end)
			end
		end
	end
end

local function deepMerge(base, over)
	local out = {}
	for k, v in pairs(base) do
		out[k] = v
	end
	for k, v in pairs(over or {}) do
		if type(v) == "table" and type(out[k]) == "table" then
			out[k] = deepMerge(out[k], v)
		else
			out[k] = v
		end
	end
	return out
end

-- LookKit.apply(look, overrides?) -> palette. overrides may replace any preset section
-- ({lighting={}, atmosphere={}, sky={}, clouds={}, bloom={}, grade={}, sunrays={}, dof=false|{}, terrain={Grass=Color3},
-- water={}, palette={role=Color3|"#hex"}, mats={role=Enum.Material}}) plus tween=seconds to blend from the current look.
function LookKit.apply(look, overrides)
	local base = LOOKS[look or "toon_bright"]
	if not base then
		warn("[LookKit] unknown look " .. tostring(look) .. "; using toon_bright")
		look = "toon_bright"
		base = LOOKS.toon_bright
	end
	overrides = overrides or {}
	local p = deepMerge(base, overrides)
	local tw = overrides.tween

	Lighting.GlobalShadows = true
	setProps(Lighting, p.lighting, tw)
	-- an Atmosphere makes legacy Fog inert; park it far so a leftover FogEnd never greys the look
	Lighting.FogEnd = 100000
	Lighting.FogStart = 0

	-- remove leftovers that fight the look (another game's Sky / second Atmosphere)
	-- and hand-made post effects (live: a builder's own orange "grade" survived every re-apply)
	local keep = { KitSky = true, Atmosphere = true, KitBloom = true, KitGrade = true, KitSunRays = true }
	for _, ch in ipairs(Lighting:GetChildren()) do
		if (ch:IsA("Sky") or ch:IsA("Atmosphere") or ch:IsA("PostEffect")) and not keep[ch.Name] then
			ch:Destroy()
		end
	end
	setProps(ensure(Lighting, "Atmosphere", "Atmosphere"), p.atmosphere, tw)
	local sky = ensure(Lighting, "Sky", "KitSky")
	setProps(sky, p.sky, nil)
	if LookKit._skybox then
		LookKit.skybox(LookKit._skybox)
	end
	setProps(ensure(Lighting, "BloomEffect", "KitBloom"), p.bloom, tw)
	local grade = ensure(Lighting, "ColorCorrectionEffect", "KitGrade")
	setProps(grade, p.grade, tw)
	setProps(ensure(Lighting, "SunRaysEffect", "KitSunRays"), p.sunrays, tw)
	if p.dof then
		local dof = ensure(Lighting, "DepthOfFieldEffect", "KitDOF")
		dof.Enabled = true
		setProps(dof, p.dof, tw)
	else
		local dof = Lighting:FindFirstChild("KitDOF")
		if dof then dof:Destroy() end
	end

	local terrain = Workspace.Terrain
	local clouds = terrain:FindFirstChildOfClass("Clouds")
	if p.clouds and p.clouds.Enabled ~= false then
		if not clouds then
			clouds = Instance.new("Clouds")
			clouds.Parent = terrain
		end
		clouds.Enabled = true
		setProps(clouds, p.clouds, tw)
	elseif clouds then
		clouds.Enabled = false
	end
	for matName, col in pairs(p.terrain or {}) do
		pcall(function() -- an unknown Enum.Material name throws; skip it
			terrain:SetMaterialColor((Enum.Material :: any)[matName], c3(col, Color3.new(1, 1, 1)))
		end)
	end
	setProps(terrain, p.water or {}, nil)

	local pal = merge(BASE_PALETTE, base.palette)
	for k, v in pairs(overrides.palette or {}) do
		pal[k] = c3(v, pal[k])
	end
	pal.neon = p.neon or { pal.primary, pal.secondary, pal.accent, pal.glow }
	pal.candy = p.candy or { pal.primary, pal.secondary, pal.accent, pal.groundAlt }
	LookKit.palette = pal
	LookKit.materials = merge(TOON_MATS, p.mats)
	LookKit.isToon = p.toon == true or p.mats == TOON_MATS
	LookKit.current = look
	Lighting:SetAttribute("KitLook", look)
	return pal
end

-- LookKit.color(role, fallback?) -> Color3 from the current look's palette.
function LookKit.color(role, fallback)
	return LookKit.palette[role] or c3(fallback, BASE_PALETTE[role] or Color3.new(1, 0, 1))
end

-- LookKit.mat(role) -> Enum.Material the current look uses for that role
-- (default, ground, stone, wood, metal, fabric, glass, roof, floor, wall, glow, leaf, road).
function LookKit.mat(role)
	return LookKit.materials[role] or LookKit.materials.default or M.SmoothPlastic
end

-- LookKit.style(part, colorRole, materialRole?) paints a part from the look (materialRole defaults to "default").
function LookKit.style(part, colorRole, materialRole)
	part.Color = LookKit.color(colorRole)
	part.Material = LookKit.mat(materialRole or "default")
	return part
end

local function asId(v)
	if type(v) == "number" then
		return "rbxassetid://" .. tostring(v)
	end
	if type(v) == "string" and v:match("^%d+$") then
		return "rbxassetid://" .. v
	end
	return v
end

-- LookKit.skybox({bk, dn, ft, lf, rt, up} image ids or rbxassetid strings, orientation=Vector3?) sets the six faces
-- (e.g. generated art). It persists across later LookKit.apply calls; LookKit.skybox(nil) returns to the default sky.
function LookKit.skybox(faces)
	LookKit._skybox = faces
	local sky = ensure(Lighting, "Sky", "KitSky")
	if not faces then
		return sky
	end
	local map = { bk = "SkyboxBk", dn = "SkyboxDn", ft = "SkyboxFt", lf = "SkyboxLf", rt = "SkyboxRt", up = "SkyboxUp" }
	for k, prop in pairs(map) do
		if faces[k] then
			pcall(function() (sky :: any)[prop] = asId(faces[k]) end)
		end
	end
	if faces.orientation then
		sky.SkyboxOrientation = faces.orientation
	end
	return sky
end

-- ---------------------------------------------------------------------------------------------------- materials

local customMats = {}

-- LookKit.material(name, {base=Enum.Material, colorMap=imageId, normalMap?, roughnessMap?, metalnessMap?,
-- studsPerTile=8, overrideBase=false}) registers a tileable material. Creates a MaterialVariant in MaterialService when
-- the engine lets this script set its maps (plugin / edit-mode builds); otherwise LookKit.useMaterial tiles Texture
-- instances on the faces instead. overrideBase=true also makes terrain/parts of that base material use it.
function LookKit.material(name, spec)
	spec = spec or {}
	local rec = { name = name, base = spec.base or M.SmoothPlastic, colorMap = asId(spec.colorMap),
		studs = spec.studsPerTile or 8, color = c3(spec.color, nil), variant = nil }
	local old = MaterialService:FindFirstChild(name)
	if old and old:IsA("MaterialVariant") then
		old:Destroy()
	end
	local ok = pcall(function()
		local mv = Instance.new("MaterialVariant")
		mv.Name = name
		mv.BaseMaterial = rec.base
		mv.StudsPerTile = rec.studs
		local any = mv :: any
		if rec.colorMap then any.ColorMap = rec.colorMap end
		if spec.normalMap then any.NormalMap = asId(spec.normalMap) end
		if spec.roughnessMap then any.RoughnessMap = asId(spec.roughnessMap) end
		if spec.metalnessMap then any.MetalnessMap = asId(spec.metalnessMap) end
		mv.Parent = MaterialService
		rec.variant = mv
	end)
	if not ok and rec.variant == nil then
		local stray = MaterialService:FindFirstChild(name)
		if stray then stray:Destroy() end
	end
	if rec.variant and spec.overrideBase then
		pcall(function() MaterialService:SetBaseMaterialOverride(rec.base, name) end)
	end
	customMats[name] = rec
	return rec
end

local FACES = { Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left,
	Enum.NormalId.Right }

-- LookKit.useMaterial(partOrModel, name) applies a registered material (variant, or tiled textures as fallback).
function LookKit.useMaterial(target, name)
	local rec = customMats[name]
	if not rec then
		warn("[LookKit] material not registered: " .. tostring(name))
		return false
	end
	local parts = {}
	if target:IsA("BasePart") then
		table.insert(parts, target)
	else
		for _, d in ipairs(target:GetDescendants()) do
			if d:IsA("BasePart") then table.insert(parts, d) end
		end
	end
	for _, p in ipairs(parts) do
		p.Material = rec.base
		if rec.color then p.Color = rec.color end
		if rec.variant then
			p.MaterialVariant = name
		elseif rec.colorMap then
			for _, face in ipairs(FACES) do
				local t = p:FindFirstChild("LookTex_" .. face.Name)
				if not t then
					t = Instance.new("Texture")
					t.Name = "LookTex_" .. face.Name
					t.Face = face
					t.Parent = p
				end
				t.Texture = rec.colorMap
				t.StudsPerTileU = rec.studs
				t.StudsPerTileV = rec.studs
			end
		end
	end
	return true
end

-- ---------------------------------------------------------------------------------------------------- cel helpers

local HIGHLIGHT_BUDGET = 31
local liveHighlights = 0
LookKit.highlightBudget = HIGHLIGHT_BUDGET

-- LookKit.outline(model, color=palette.ink, thickness?) -> Highlight? Cel outline via Highlight (fill hidden).
-- Budget: 31 Highlights render at once engine-wide; this returns nil past the budget (counted for LookKit's own).
-- thickness is ignored (Highlight outlines are fixed-width). Outline a parent Model to cover many props with one.
function LookKit.outline(model, color, thickness)
	local _ = thickness
	local existing = model:FindFirstChild("KitOutline")
	if existing and existing:IsA("Highlight") then
		existing.OutlineColor = c3(color, LookKit.palette.ink)
		return existing
	end
	if liveHighlights >= HIGHLIGHT_BUDGET then
		warn("[LookKit] Highlight budget (31) reached; outline the parent model instead")
		return nil
	end
	local h = Instance.new("Highlight")
	h.Name = "KitOutline"
	h.FillTransparency = 1
	h.OutlineTransparency = 0
	h.OutlineColor = c3(color, LookKit.palette.ink)
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Adornee = model
	h.Parent = model
	liveHighlights += 1
	h.Destroying:Connect(function()
		liveHighlights -= 1
	end)
	return h
end

local function nearest(col, list)
	local best, bestD = col, math.huge
	for _, c in ipairs(list) do
		-- weighted RGB distance (cheap perceptual approximation)
		local dr, dg, db = col.R - c.R, col.G - c.G, col.B - c.B
		local d = 0.3 * dr * dr + 0.59 * dg * dg + 0.11 * db * db
		if d < bestD then
			best, bestD = c, d
		end
	end
	return best
end

-- LookKit.toonify(model, {quantize=true, palette?, keepNeon=true, outline=false}) flattens a model to the cel look:
-- SmoothPlastic, no reflectance, each colour snapped to the nearest palette colour. Returns the model.
function LookKit.toonify(model, opts)
	opts = opts or {}
	local list = {}
	for k, v in pairs(opts.palette or LookKit.palette) do
		if typeof(v) == "Color3" and k ~= "sky" then
			table.insert(list, v)
		end
	end
	local parts = model:IsA("BasePart") and { model } or model:GetDescendants()
	for _, p in ipairs(parts) do
		if p:IsA("BasePart") and p.Material ~= M.Neon and p.Material ~= M.Glass and p.Material ~= M.ForceField then
			p.Material = M.SmoothPlastic
			p.Reflectance = 0
			p.MaterialVariant = ""
			if opts.quantize ~= false and #list > 0 then
				p.Color = nearest(p.Color, list)
			end
		end
	end
	if opts.outline then
		LookKit.outline(model, opts.outlineColor)
	end
	return model
end

return LookKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Maid</string>
          <string name="Source"><![CDATA[-- Maid: collects connections, instances, cleanup functions, threads and objects with :Destroy(),
-- and cleans them all at once when a screen, round or effect ends.
local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ _jobs = {} }, Maid)
end

-- Give(job) -> job. Accepts RBXScriptConnection, Instance, function, thread, or a table with :Destroy().
function Maid:Give(job)
	table.insert(self._jobs, job)
	return job
end

local function clean(job)
	local kind = typeof(job)
	if kind == "RBXScriptConnection" then
		job:Disconnect()
	elseif kind == "Instance" then
		job:Destroy()
	elseif kind == "function" then
		job()
	elseif kind == "thread" then
		pcall(task.cancel, job)
	elseif kind == "table" and type(job.Destroy) == "function" then
		job:Destroy()
	end
end

function Maid:Clean()
	local jobs = self._jobs
	self._jobs = {}
	for i = #jobs, 1, -1 do
		local ok, err = pcall(clean, jobs[i])
		if not ok then
			warn("[Maid] cleanup failed: " .. tostring(err))
		end
	end
end

Maid.Destroy = Maid.Clean

return Maid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Motion</string>
          <string name="Source"><![CDATA[-- Motion: UI and object motion from the game's motion tokens.
--   Motion.tween(obj, {Position = ...}, "base")        eased tween using Tokens.motion
--   Motion.press(button) / Motion.hover(button, true)  tactile button response
--   Motion.enter(frame, {stagger = 0.04}) / Motion.exit(frame)   panel entrance / exit with staggered children
--   Motion.punch(gui, 0.12)                            scale bounce for rewards and hits
--   Motion.countUp(label, 0, 1250, 0.6, "%d")          number roll-up
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tokens
do
	local ok, result = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Shared", 5):WaitForChild("Tokens", 5))
	end)
	Tokens = ok and result or nil
end

local DUR = { fast = 0.12, base = 0.2, slow = 0.35, dramatic = 0.6 }

local Motion = {}

local function duration(kind)
	if type(kind) == "number" then
		return kind
	end
	local m = Tokens and Tokens.motion
	return (m and m[kind or "base"]) or DUR[kind or "base"] or DUR.base
end

function Motion.info(kind, style, direction, delay)
	local easeOut = (Tokens and Tokens.motion and Tokens.motion.easeOut) or Enum.EasingStyle.Quint
	return TweenInfo.new(duration(kind), style or easeOut, direction or Enum.EasingDirection.Out, 0, false, delay or 0)
end

function Motion.tween(obj, goal, kind, style, direction, delay)
	local tween = TweenService:Create(obj, Motion.info(kind, style, direction, delay), goal)
	tween:Play()
	return tween
end

-- A UIScale owned by Motion, so press / punch / enter never fight a layout's own UIScale.
function Motion.scaleOf(gui)
	local s = gui:FindFirstChild("MotionScale")
	if not s then
		s = Instance.new("UIScale")
		s.Name = "MotionScale"
		s.Parent = gui
	end
	return s
end

function Motion.press(gui)
	local s = Motion.scaleOf(gui)
	local down = Motion.tween(s, { Scale = 0.94 }, "fast", Enum.EasingStyle.Quad)
	down.Completed:Once(function()
		Motion.tween(s, { Scale = 1 }, "base", Enum.EasingStyle.Back)
	end)
end

function Motion.hover(gui, on)
	Motion.tween(Motion.scaleOf(gui), { Scale = on and 1.04 or 1 }, "fast", Enum.EasingStyle.Quad)
end

function Motion.punch(gui, amount)
	local s = Motion.scaleOf(gui)
	s.Scale = 1 + (amount or 0.12)
	Motion.tween(s, { Scale = 1 }, "slow", Enum.EasingStyle.Back)
end

local function basePosition(gui)
	local p = gui:GetAttribute("MotionBasePosition")
	if typeof(p) ~= "UDim2" then
		p = gui.Position
		gui:SetAttribute("MotionBasePosition", p)
	end
	return p
end

local function slideIn(gui, offsetY, kind, delay)
	local base = basePosition(gui)
	gui.Position = base + UDim2.fromOffset(0, offsetY)
	Motion.tween(gui, { Position = base }, kind, nil, nil, delay)
	local s = Motion.scaleOf(gui)
	s.Scale = 0.96
	Motion.tween(s, { Scale = 1 }, kind, nil, nil, delay)
	if gui:IsA("CanvasGroup") then
		gui.GroupTransparency = 1
		Motion.tween(gui, { GroupTransparency = 0 }, kind, nil, nil, delay)
	end
end

-- Shows a panel with a slide + scale (and fade for CanvasGroups); children in LayoutOrder are staggered.
function Motion.enter(gui, opts)
	opts = opts or {}
	gui.Visible = true
	slideIn(gui, opts.offset or 20, opts.kind or "slow", 0)
	if opts.stagger ~= false then
		local kids = {}
		for _, child in gui:GetChildren() do
			if child:IsA("GuiObject") and child.Visible then
				table.insert(kids, child)
			end
		end
		table.sort(kids, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i, child in kids do
			if not child.Parent:FindFirstChildWhichIsA("UIGridStyleLayout") then
				slideIn(child, opts.childOffset or 12, opts.kind or "slow", (opts.stagger or 0.04) * i)
			else
				local s = Motion.scaleOf(child)
				s.Scale = 0.9
				Motion.tween(s, { Scale = 1 }, opts.kind or "slow", Enum.EasingStyle.Back, nil, (opts.stagger or 0.04) * i)
			end
		end
	end
end

function Motion.exit(gui, opts)
	opts = opts or {}
	local base = basePosition(gui)
	local t = Motion.tween(gui, { Position = base + UDim2.fromOffset(0, opts.offset or 16) }, opts.kind or "base",
		Motion.info().EasingStyle, Enum.EasingDirection.In)
	Motion.tween(Motion.scaleOf(gui), { Scale = 0.97 }, opts.kind or "base", nil, Enum.EasingDirection.In)
	if gui:IsA("CanvasGroup") then
		Motion.tween(gui, { GroupTransparency = 1 }, opts.kind or "base", nil, Enum.EasingDirection.In)
	end
	t.Completed:Once(function()
		gui.Visible = false
		gui.Position = base
	end)
	return t
end

-- Rolls a TextLabel from one number to another with an ease-out curve.
function Motion.countUp(label, from, to, seconds, format)
	seconds = seconds or 0.6
	local start = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local a = math.clamp((os.clock() - start) / seconds, 0, 1)
		local eased = 1 - (1 - a) ^ 4
		local v = from + (to - from) * eased
		label.Text = string.format(format or "%d", math.floor(v + 0.5))
		if a >= 1 then
			conn:Disconnect()
		end
	end)
	return conn
end

return Motion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">PropKit</string>
          <string name="Source"><![CDATA[--!strict
-- PropKit: spawns generated props (the builder tool generate_prop writes one ModuleScript per prop to
-- ReplicatedStorage.Shared.Props.<Name>) as anchored part-built Models. Server or client.
--   PropKit.spawn("Mushroom", { position = Vector3.new(0, 0, 10), scale = 8 })   bottom centre sits on position
--   PropKit.scatter(Props.Rock, { center = Vector3.zero, radius = 60 }, 20, { minSpacing = 8 })
--   for _, o in PropKit.variants(asset, 5, 1) do PropKit.spawn(asset, o) end
-- Asset format: { name, style = "voxel"|"blob", size = Vector3 (longest side 1), palette = {Color3},
--   parts = {{ shape = "Block"|"Ball"|"Ellipsoid" (nil = Block), p = {x,y,z} centre, s = {x,y,z} full size,
--   r = {rx,ry,rz} degrees (optional, XYZ Euler), c = palette index }} }. Y up, origin at the bbox bottom centre, front = -Z.
--
-- Engine facts this file is written around:
--   * Shape=Ball is always a sphere; ellipsoids are block Parts with a SpecialMesh(MeshType=Sphere), which stretches to
--     the part's full non-uniform size. No MeshParts and no asset ids anywhere.
--   * The PrimaryPart is an invisible root at the bottom centre, so model:PivotTo(CFrame.new(groundPoint)) grounds it.
--   * Each visual part keeps its palette index in the attribute PropColor; PropKit.recolor uses it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local PropKit = {}
PropKit.DEFAULT_SCALE = 6 -- longest side in studs
PropKit.LOW_DETAIL = 0.04 -- detail="low" drops parts whose largest side is under this fraction of the prop

local V3 = Vector3.new
local rad = math.rad

type Opts = { [string]: any }
type Piece = { shape: string, p: Vector3, s: Vector3, rot: CFrame?, c: number, big: number }
type Prepared = { name: string, size: Vector3, longest: number, palette: { Color3 }, pieces: { Piece } }

local prepared: { [any]: Prepared } = setmetatable({}, { __mode = "k" }) :: any
local byName: { [string]: any } = {}

------------------------------------------------------------------------------------------------ assets
local function propsFolder(wait: boolean): Instance?
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	if not shared and wait and RunService:IsClient() then
		shared = ReplicatedStorage:WaitForChild("Shared", 5)
	end
	if not shared then
		return nil
	end
	local props = shared:FindFirstChild("Props")
	if not props and wait and RunService:IsClient() then
		props = shared:WaitForChild("Props", 5)
	end
	return props
end

local function vec(v: any, what: string): Vector3
	if typeof(v) == "Vector3" then
		return v
	end
	if type(v) == "table" and type(v[1]) == "number" and type(v[2]) == "number" and type(v[3]) == "number" then
		return V3(v[1], v[2], v[3])
	end
	error("[PropKit] " .. what .. " must be {x, y, z} or a Vector3, got " .. typeof(v), 4)
end

local function prepare(asset: any): Prepared
	local cached = prepared[asset]
	if cached then
		return cached
	end
	local name = type(asset.name) == "string" and asset.name or "Prop"
	local pal = asset.palette
	if type(pal) ~= "table" or #pal == 0 then
		error("[PropKit] asset '" .. name .. "' has no palette (array of Color3)", 3)
	end
	for i, c in pal do
		if typeof(c) ~= "Color3" then
			error(("[PropKit] asset '%s' palette[%s] is not a Color3"):format(name, tostring(i)), 3)
		end
	end
	if type(asset.parts) ~= "table" or #asset.parts == 0 then
		error("[PropKit] asset '" .. name .. "' has no parts", 3)
	end
	local size = vec(asset.size, "asset '" .. name .. "'.size")
	local pieces: { Piece } = {}
	for i, part in asset.parts do
		local where = ("asset '%s' parts[%d]"):format(name, i)
		if type(part) ~= "table" then
			error("[PropKit] " .. where .. " is not a table", 3)
		end
		local shape: string = part.shape or "Block"
		if shape ~= "Block" and shape ~= "Ball" and shape ~= "Ellipsoid" then
			error("[PropKit] " .. where .. " has unknown shape " .. tostring(shape), 3)
		end
		local c = part.c or 1
		if type(c) ~= "number" or not pal[c] then
			error("[PropKit] " .. where .. " colour index " .. tostring(c) .. " is outside the palette", 3)
		end
		local s = vec(part.s, where .. ".s")
		local rot: CFrame? = nil
		if part.r then
			local r = vec(part.r, where .. ".r")
			if r ~= Vector3.zero then
				rot = CFrame.fromEulerAnglesXYZ(rad(r.X), rad(r.Y), rad(r.Z))
			end
		end
		table.insert(pieces, {
			shape = shape :: string,
			p = vec(part.p, where .. ".p"),
			s = s,
			rot = rot,
			c = c,
			big = math.max(s.X, s.Y, s.Z),
		})
	end
	local longest = math.max(size.X, size.Y, size.Z)
	if longest <= 0 then
		error("[PropKit] asset '" .. name .. "' has an empty size", 3)
	end
	local out: Prepared = { name = name, size = size, longest = longest, palette = pal, pieces = pieces }
	prepared[asset] = out
	return out
end

-- asset: the module table, its ModuleScript, or a name under ReplicatedStorage.Shared.Props.
local function resolve(asset: any): any
	if type(asset) == "string" then
		local hit = byName[asset]
		if hit then
			return hit
		end
		local folder = propsFolder(true)
		if not folder then
			error("[PropKit] no ReplicatedStorage.Shared.Props folder (looking for prop '" .. asset .. "')", 3)
		end
		local mod = folder:FindFirstChild(asset)
		if not mod and RunService:IsClient() then
			mod = folder:WaitForChild(asset, 5)
		end
		if not mod or not mod:IsA("ModuleScript") then
			error("[PropKit] no prop named '" .. asset .. "' under ReplicatedStorage.Shared.Props", 3)
		end
		local t = require(mod :: ModuleScript) :: any
		if type(t) ~= "table" then
			error("[PropKit] prop module '" .. asset .. "' did not return a table", 3)
		end
		byName[asset] = t
		return t
	elseif typeof(asset) == "Instance" and (asset :: Instance):IsA("ModuleScript") then
		return resolve((asset :: Instance).Name)
	elseif type(asset) == "table" then
		return asset
	end
	error("[PropKit] asset must be a prop table, ModuleScript or prop name, got " .. typeof(asset), 3)
end

-- palette: array or map index -> Color3; entries that are not Color3 are ignored.
local function remap(base: { Color3 }, palette: any): { Color3 }
	local out = table.clone(base)
	if type(palette) == "table" then
		for i, c in palette do
			if type(i) == "number" and typeof(c) == "Color3" and out[i] then
				out[i] = c
			end
		end
	end
	return out
end

------------------------------------------------------------------------------------------------ spawn
local function rotationCF(r: any): CFrame
	if type(r) == "number" then
		return CFrame.Angles(0, rad(r), 0)
	elseif typeof(r) == "Vector3" then
		return CFrame.fromEulerAnglesXYZ(rad(r.X), rad(r.Y), rad(r.Z))
	end
	return CFrame.identity
end

local function invisible(name: string, size: Vector3, cf: CFrame, anchored: boolean): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Anchored = anchored
	p.Transparency = 1
	p.CastShadow = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

-- PropKit.spawn(asset, opts?) -> Model. See the header / docs/PropKit.md for opts.
function PropKit.spawn(asset: any, opts: Opts?): Model
	local o: Opts = opts or {}
	local data = prepare(resolve(asset))
	local scale = tonumber(o.scale) or PropKit.DEFAULT_SCALE
	if scale <= 0 then
		error("[PropKit] scale must be > 0", 2)
	end
	local k = scale / data.longest
	local anchored = o.anchored ~= false
	local collide = o.collide or "box"
	if collide ~= "box" and collide ~= "parts" and collide ~= "none" then
		error("[PropKit] collide must be \"box\", \"parts\" or \"none\", got " .. tostring(collide), 2)
	end
	local material: Enum.Material = Enum.Material.SmoothPlastic
	local mat: any = o.material
	if typeof(mat) == "EnumItem" and mat.EnumType == Enum.Material then
		material = mat :: any
	end

	local colors = remap(data.palette, o.palette)
	if typeof(o.tint) == "Color3" then
		local amt = tonumber(o.tintAmount) or 0.35
		for i, c in colors do
			colors[i] = c:Lerp(o.tint, amt)
		end
	end

	local base: CFrame
	if typeof(o.cframe) == "CFrame" then
		base = o.cframe
	else
		base = CFrame.new(typeof(o.position) == "Vector3" and o.position or Vector3.zero)
	end
	base *= rotationCF(o.rotation)

	local minBig = if o.detail == "low" then PropKit.LOW_DETAIL * data.longest else 0
	local keep: { Piece } = {}
	for _, piece in data.pieces do
		if piece.big >= minBig then
			table.insert(keep, piece)
		end
	end
	if #keep == 0 then
		keep = data.pieces
	end

	local model = Instance.new("Model")
	model.Name = if type(o.name) == "string" then o.name else data.name
	local root = invisible("Root", V3(0.2, 0.2, 0.2), base, anchored)
	root.Parent = model
	model.PrimaryPart = root

	local solid = collide == "parts"
	for i, piece in keep do
		local part = Instance.new("Part")
		local s = piece.s * k
		if piece.shape == "Ball" then
			part.Shape = Enum.PartType.Ball
			local d = math.max(piece.big * k, 0.05)
			s = V3(d, d, d)
		else
			s = V3(math.max(s.X, 0.05), math.max(s.Y, 0.05), math.max(s.Z, 0.05))
		end
		part.Name = "P" .. i
		part.Size = s
		local cf = base * CFrame.new(piece.p * k)
		part.CFrame = if piece.rot then cf * piece.rot else cf
		part.Color = colors[piece.c]
		part.Material = material
		part.Anchored = anchored
		part.CastShadow = true
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CanCollide = solid
		part.CanQuery = solid
		part.CanTouch = solid
		part.Massless = not solid
		part:SetAttribute("PropColor", piece.c)
		if piece.shape == "Ellipsoid" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		part.Parent = model
	end

	if collide == "box" then
		local size = data.size * k
		local box = invisible("Hitbox", size, base * CFrame.new(0, size.Y / 2, 0), anchored)
		box.CanCollide = true
		box.CanQuery = true
		box.CanTouch = true
		box.Parent = model
	end

	if not anchored then
		for _, child in model:GetChildren() do
			if child ~= root and child:IsA("BasePart") then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = child
				weld.Parent = child
			end
		end
	end

	model:SetAttribute("PropName", data.name)
	model:SetAttribute("PropScale", scale)
	model.Parent = if typeof(o.parent) == "Instance" then o.parent else Workspace
	return model
end

-- PropKit.recolor(model, palette): palette = array or map index -> Color3 (missing indices keep their colour).
function PropKit.recolor(model: Instance, palette: { [number]: Color3 })
	if typeof(model) ~= "Instance" or type(palette) ~= "table" then
		error("[PropKit] recolor(model, palette) expects a Model and a table of Color3", 2)
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local idx = d:GetAttribute("PropColor")
			local c = if type(idx) == "number" then palette[idx] else nil
			if typeof(c) == "Color3" then
				d.Color = c
			end
		end
	end
end

-- PropKit.bounds(asset, scale = 6) -> Vector3 bounding-box size in studs.
function PropKit.bounds(asset: any, scale: number?): Vector3
	local data = prepare(resolve(asset))
	return data.size * ((scale or PropKit.DEFAULT_SCALE) / data.longest)
end

-- PropKit.list() -> sorted names of the prop ModuleScripts under ReplicatedStorage.Shared.Props ({} if none).
function PropKit.list(): { string }
	local names = {}
	local folder = propsFolder(false)
	if folder then
		for _, child in folder:GetChildren() do
			if child:IsA("ModuleScript") then
				table.insert(names, child.Name)
			end
		end
	end
	table.sort(names)
	return names
end

------------------------------------------------------------------------------------------------ variety
-- PropKit.variants(asset, n, seed?, base?) -> {opts}: copies of base with scale = (base.scale or 6) * (1 +- 15%),
-- a random yaw, and the whole palette (after base.palette) hue-shifted by up to +-0.04 and value by +-8%, one
-- shift per variant so the prop stays coherent.
function PropKit.variants(asset: any, n: number, seed: number?, base: Opts?): { Opts }
	local data = prepare(resolve(asset))
	local rng = if seed then Random.new(seed) else Random.new()
	local b: Opts = base or {}
	local pal = remap(data.palette, b.palette)
	local scale = tonumber(b.scale) or PropKit.DEFAULT_SCALE
	local out = {}
	for _ = 1, math.max(0, math.floor(n)) do
		local o = table.clone(b)
		o.scale = scale * (1 + rng:NextNumber(-0.15, 0.15))
		o.rotation = rng:NextNumber(0, 360)
		local dh, dv = rng:NextNumber(-0.04, 0.04), rng:NextNumber(0.92, 1.08)
		local shifted = {}
		for i, c in pal do
			local h, s, v = c:ToHSV()
			shifted[i] = Color3.fromHSV((h + dh) % 1, s, math.clamp(v * dv, 0, 1))
		end
		o.palette = shifted
		table.insert(out, o)
	end
	return out
end

local SCATTER_KEYS = { "jitter", "seed", "minSpacing", "castHeight", "exclude", "position", "cframe", "rotation" }

-- PropKit.scatter(asset, area, count, opts?) -> {Model}. area = {center, radius} | {min, max} | BasePart (top face).
-- Raycasts down from castHeight (default 200) above the area; points with no ground are skipped. opts: jitter=0.2
-- (scale +-), seed, minSpacing (studs, XZ), exclude = {Instance} (extra ray filter), plus any spawn opts.
function PropKit.scatter(asset: any, area: any, count: number, opts: Opts?): { Model }
	local o: Opts = opts or {}
	local a = resolve(asset)
	prepare(a)
	local rng = if o.seed then Random.new(o.seed) else Random.new()
	local castHeight = tonumber(o.castHeight) or 200
	local sample: () -> Vector3
	if typeof(area) == "Instance" and (area :: Instance):IsA("BasePart") then
		local p = area :: BasePart
		sample = function()
			return (p.CFrame * CFrame.new(rng:NextNumber(-0.5, 0.5) * p.Size.X, p.Size.Y / 2, rng:NextNumber(-0.5, 0.5) * p.Size.Z)).Position
		end
	elseif type(area) == "table" and typeof(area.center) == "Vector3" and type(area.radius) == "number" then
		sample = function()
			local r, t = area.radius * math.sqrt(rng:NextNumber()), rng:NextNumber(0, 2 * math.pi)
			return area.center + V3(r * math.cos(t), 0, r * math.sin(t))
		end
	elseif type(area) == "table" and typeof(area.min) == "Vector3" and typeof(area.max) == "Vector3" then
		local lo, hi = area.min:Min(area.max), area.min:Max(area.max)
		sample = function()
			return V3(rng:NextNumber(lo.X, hi.X), hi.Y, rng:NextNumber(lo.Z, hi.Z))
		end
	else
		error("[PropKit] scatter area must be {center, radius}, {min, max} or a BasePart", 2)
	end

	local pass: Opts = table.clone(o)
	for _, key in SCATTER_KEYS do
		pass[key] = nil
	end
	local jitter = tonumber(o.jitter) or 0.2
	local baseScale = tonumber(o.scale) or PropKit.DEFAULT_SCALE
	local spacing = tonumber(o.minSpacing) or 0
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter: { Instance } = {}
	if type(o.exclude) == "table" then
		for _, inst in o.exclude do
			if typeof(inst) == "Instance" then
				table.insert(filter, inst)
			end
		end
	end
	params.FilterDescendantsInstances = filter

	local placed: { Vector3 } = {}
	local models: { Model } = {}
	local tries = 0
	while #models < count and tries < count * 10 do
		tries += 1
		local at = sample()
		local hit = Workspace:Raycast(at + V3(0, castHeight, 0), V3(0, -(castHeight + 1000), 0), params)
		if hit then
			local ok = true
			if spacing > 0 then
				for _, q in placed do
					if V3(q.X - hit.Position.X, 0, q.Z - hit.Position.Z).Magnitude < spacing then
						ok = false
						break
					end
				end
			end
			if ok then
				local so = table.clone(pass)
				so.position = hit.Position
				so.rotation = rng:NextNumber(0, 360)
				so.scale = baseScale * (1 + rng:NextNumber(-jitter, jitter))
				local m = PropKit.spawn(a, so)
				table.insert(models, m)
				table.insert(placed, hit.Position)
				table.insert(filter, m)
				params.FilterDescendantsInstances = filter
			end
		end
	end
	return models
end

return PropKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Screen</string>
          <string name="Source"><![CDATA[-- Screen: fit a UI designed on the 1920x1080 canvas to any viewport, and tell compact (phone) layouts apart.
--   local gui = Screen.gui("Hud", 10)       a ScreenGui in PlayerGui with sane defaults and a FitScale
--   Screen.isCompact()                        true on small screens: switch to the compact layout
--   Screen.topInset()                         height of the Roblox top bar to keep clear
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")

local Screen = {}
local CANVAS = Vector2.new(1920, 1080)
local MIN_SCALE = 0.55 -- keeps phone text readable; compact layouts must fit the larger effective canvas

function Screen.scale()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or CANVAS
	return math.clamp(math.min(v.X / CANVAS.X, v.Y / CANVAS.Y), MIN_SCALE, 2)
end

-- The canvas size the UI actually has at the current scale (use it to fit panels on compact screens).
function Screen.canvas()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or CANVAS
	return v / Screen.scale()
end

function Screen.isCompact()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or CANVAS
	return math.min(v.X, v.Y) < 600
end

function Screen.topInset()
	local inset = GuiService:GetGuiInset()
	return inset.Y
end

function Screen.fit(gui)
	local scale = gui:FindFirstChild("FitScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "FitScale"
		scale.Parent = gui
	end
	local function update()
		scale.Scale = Screen.scale()
	end
	update()
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	return scale
end

function Screen.gui(name, displayOrder)
	local player = Players.LocalPlayer
	local pg = player:WaitForChild("PlayerGui")
	local gui = pg:FindFirstChild(name)
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = name
		gui.ResetOnSpawn = false
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = displayOrder or 0
		gui.Parent = pg
	end
	Screen.fit(gui)
	return gui
end

return Screen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Shake</string>
          <string name="Source"><![CDATA[-- Shake: trauma-based camera shake (client only). Trauma decays; shake grows with trauma squared, so small
-- events barely move the camera and big ones land.
--   Shake.kick(0.4)             add trauma to the shared shaker (auto-binds after the camera each frame)
--   Shake.reduceMotion = true   a settings toggle scales every shake to zero
--   local s = Shake.new(); local offset = s:Step(dt)   for a custom camera module (multiply into its CFrame)
local RunService = game:GetService("RunService")

local Shake = {}
Shake.__index = Shake
Shake.reduceMotion = false

function Shake.new(opts)
	opts = opts or {}
	return setmetatable({
		trauma = 0,
		decay = opts.decay or 1.8, -- trauma lost per second
		maxAngle = opts.maxAngle or math.rad(2.5),
		maxOffset = opts.maxOffset or 0.3, -- studs
		frequency = opts.frequency or 18,
		t = 0,
	}, Shake)
end

function Shake:Add(amount)
	self.trauma = math.clamp(self.trauma + amount, 0, 1)
end

function Shake:Step(dt)
	self.t += dt
	self.trauma = math.max(0, self.trauma - self.decay * dt)
	if Shake.reduceMotion or self.trauma <= 0 then
		return CFrame.identity
	end
	local s = self.trauma * self.trauma
	local f = self.t * self.frequency
	local x = math.noise(f, 1.37) * self.maxOffset * s
	local y = math.noise(f, 7.91) * self.maxOffset * s
	local roll = math.noise(f, 13.3) * self.maxAngle * s
	local pitch = math.noise(f, 21.7) * self.maxAngle * 0.5 * s
	return CFrame.new(x, y, 0) * CFrame.Angles(pitch, 0, roll)
end

local shared
function Shake.kick(amount)
	if not RunService:IsClient() then
		return
	end
	if not shared then
		shared = Shake.new()
		RunService:BindToRenderStep("KitShake", Enum.RenderPriority.Camera.Value + 2, function(dt)
			local cam = workspace.CurrentCamera
			if cam then
				cam.CFrame = cam.CFrame * shared:Step(dt)
			end
		end)
	end
	shared:Add(amount)
end

return Shake
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Sound</string>
          <string name="Source"><![CDATA[-- Sound: named sounds in SoundGroups, with variation, 3D placement, music crossfades and ducking.
--   Sound.register("ui_click", { ids = {"rbxassetid://..."}, group = "UI", volume = 0.5, pitch = 0.06 })
--   Sound.play("ui_click")                         2D
--   Sound.play("impact", { parent = part })        3D, positioned on a part or attachment
--   Sound.music("explore", 1.5)                    crossfade to a looping track
--   Sound.duck(0.35, 1.2)                          dip music for a payoff moment
--   Sound.manifest()                               every registered sound with its load state (for the audio review)
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")

local Sound = {}
local Debug
do
	local ok, result = pcall(function()
		return require(script.Parent:WaitForChild("Debug", 5))
	end)
	Debug = ok and result or nil
end
local GROUP_VOLUME = { Music = 0.45, SFX = 0.8, UI = 0.6, Ambience = 0.5 }
local registry = {}
local rng = Random.new()
local currentMusic, currentMusicName = nil, nil

function Sound.group(name)
	local g = SoundService:FindFirstChild(name)
	if not g then
		g = Instance.new("SoundGroup")
		g.Name = name
		g.Volume = GROUP_VOLUME[name] or 0.7
		g.Parent = SoundService
	end
	return g
end

function Sound.register(name, def)
	assert(type(def) == "table" and type(def.ids) == "table" and #def.ids > 0, "Sound.register needs ids")
	registry[name] = {
		ids = def.ids,
		group = def.group or "SFX",
		volume = def.volume or 0.7,
		pitch = def.pitch or 0,
		looped = def.looped or false,
		rollOff = def.rollOff or { 8, 120 },
	}
end

local function make(name, def, opts)
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = def.ids[rng:NextInteger(1, #def.ids)]
	s.Volume = (opts and opts.volume) or def.volume
	s.Looped = def.looped
	s.SoundGroup = Sound.group(def.group)
	local var = (opts and opts.pitch) or def.pitch
	s.PlaybackSpeed = 1 + (var > 0 and rng:NextNumber(-var, var) or 0)
	local parent = opts and opts.parent
	if parent then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = def.rollOff[1]
		s.RollOffMaxDistance = def.rollOff[2]
		s.Parent = parent
	else
		s.Parent = SoundService
	end
	return s
end

function Sound.play(name, opts)
	local def = registry[name]
	if not def then
		warn("[Sound] not registered: " .. tostring(name))
		return nil
	end
	local s = make(name, def, opts)
	s:Play()
	if Debug then
		Debug.event("sound", { name = name, group = def.group, volume = s.Volume, id = s.SoundId,
			spatial = opts ~= nil and opts.parent ~= nil })
	end
	if not def.looped then
		s.Ended:Once(function()
			s:Destroy()
		end)
		task.delay(30, function()
			if s.Parent then
				s:Destroy()
			end
		end)
	end
	return s
end

function Sound.music(name, fade)
	if name == currentMusicName then
		return currentMusic
	end
	fade = fade or 1.5
	local old = currentMusic
	if old then
		local t = TweenService:Create(old, TweenInfo.new(fade), { Volume = 0 })
		t:Play()
		t.Completed:Once(function()
			old:Destroy()
		end)
	end
	currentMusicName = name
	currentMusic = nil
	if not name then
		return nil
	end
	local def = registry[name]
	if not def then
		warn("[Sound] music not registered: " .. tostring(name))
		return nil
	end
	local s = make(name, { ids = def.ids, group = "Music", volume = def.volume, pitch = 0, looped = true, rollOff = def.rollOff })
	local target = s.Volume
	s.Volume = 0
	s:Play()
	TweenService:Create(s, TweenInfo.new(fade), { Volume = target }):Play()
	currentMusic = s
	if Debug then
		Debug.event("sound", { name = name, group = "Music", volume = target, id = s.SoundId, music = true })
	end
	return s
end

function Sound.duck(amount, seconds)
	local g = Sound.group("Music")
	local base = GROUP_VOLUME.Music
	g.Volume = base * (1 - (amount or 0.35))
	task.delay(seconds or 1, function()
		TweenService:Create(g, TweenInfo.new(0.6), { Volume = base }):Play()
	end)
end

function Sound.preload()
	local list = {}
	for name, def in registry do
		for _, id in def.ids do
			local s = Instance.new("Sound")
			s.Name = name
			s.SoundId = id
			table.insert(list, s)
		end
	end
	pcall(function()
		ContentProvider:PreloadAsync(list)
	end)
	return list
end

-- For the audio review: every registered sound, whether its assets load, and their lengths.
function Sound.manifest()
	local out = {}
	local probes = Sound.preload()
	for _, s in probes do
		local entry = out[s.Name] or { group = registry[s.Name].group, volume = registry[s.Name].volume,
			pitch = registry[s.Name].pitch, looped = registry[s.Name].looped, ids = {} }
		table.insert(entry.ids, { id = s.SoundId, loaded = s.IsLoaded, length = s.TimeLength })
		out[s.Name] = entry
		s:Destroy()
	end
	return out
end

return Sound
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Spring</string>
          <string name="Source"><![CDATA[-- Spring: a damped spring for numbers, Vector2 and Vector3 (camera follow, UI wobble, recoil, sway).
--   local s = Spring.new(Vector3.zero, 12, 1)   -- initial, speed (angular frequency), damping ratio (1 = critical)
--   s.Target = goal; local pos = s:Step(dt); s:Impulse(Vector3.new(0, 5, 0))
-- Frame-rate independent: integrates in fixed substeps.
local Spring = {}
Spring.__index = Spring

local SUBSTEP = 1 / 240

function Spring.new(initial, speed, damping)
	local zero = initial * 0
	return setmetatable({
		Position = initial,
		Velocity = zero,
		Target = initial,
		Speed = speed or 12,
		Damping = damping or 1,
	}, Spring)
end

function Spring:Step(dt)
	local steps = math.clamp(math.ceil(dt / SUBSTEP), 1, 64)
	local h = dt / steps
	local k, d = self.Speed, self.Damping
	for _ = 1, steps do
		local accel = (self.Target - self.Position) * (k * k) - self.Velocity * (2 * d * k)
		self.Velocity += accel * h
		self.Position += self.Velocity * h
	end
	return self.Position
end

function Spring:Impulse(velocity)
	self.Velocity += velocity
end

function Spring:Snap(value)
	self.Position = value
	self.Target = value
	self.Velocity = value * 0
end

return Spring
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">TexCodec</string>
          <string name="Source"><![CDATA[--!native
--!strict
-- TexCodec: decodes the texture data the harness writes (harness/tools/texpack.py) into RGBA8 pixel buffers.
-- Pure Luau (standard library and buffer only), so it runs in the game and under the standalone Luau runtime.
--   local pixels = TexCodec.decode(data, 64, 64, "RGBA")   -- buffer of 64 * 64 * 4 bytes, rows top to bottom
--   TexCodec.checksum(pixels) == entry.checksum             -- Adler-32; a mismatch means corrupted data
-- LA textures decode to RGBA with R = G = B = L. decode() errors on data it cannot read; callers pcall it.
-- Format: base85 text -> bytes; an 8-byte header; a 2-bit predictor per row per plane; canonical Huffman codes
-- (at most 12 bits, LSB first) over residual bytes and zero runs; planes alpha first, then R, G, B (or L).

local TexCodec = {}

local ALPHABET = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#"
local VERSION = 1
local MAX_BITS = 12
local TABLE_SIZE = 4096
local RUN_BASE = 256

-- base85 character -> digit (255 for characters outside the alphabet)
local DIGIT = buffer.create(256)
buffer.fill(DIGIT, 0, 255)
for i = 1, #ALPHABET do
	buffer.writeu8(DIGIT, string.byte(ALPHABET, i), i - 1)
end

-- zigzag symbol -> residual byte: 0, 1, 2, 3, 4, ... -> 0, -1, 1, -2, 2, ... (mod 256)
local UNZIG = buffer.create(256)
for z = 0, 255 do
	buffer.writeu8(UNZIG, z, if z % 2 == 0 then z // 2 else 255 - z // 2)
end

local function fail(message: string): never
	error("TexCodec: " .. message, 0)
end

local function unbase85(text: string): buffer
	local n = #text
	if n == 0 or n % 5 ~= 0 then
		fail("data length is not a multiple of 5")
	end
	local src = buffer.fromstring(text)
	local out = buffer.create(n // 5 * 4)
	local o = 0
	for i = 0, n - 1, 5 do
		local d0 = buffer.readu8(DIGIT, buffer.readu8(src, i))
		local d1 = buffer.readu8(DIGIT, buffer.readu8(src, i + 1))
		local d2 = buffer.readu8(DIGIT, buffer.readu8(src, i + 2))
		local d3 = buffer.readu8(DIGIT, buffer.readu8(src, i + 3))
		local d4 = buffer.readu8(DIGIT, buffer.readu8(src, i + 4))
		if d0 > 84 or d1 > 84 or d2 > 84 or d3 > 84 or d4 > 84 then
			fail("data has a character outside the alphabet")
		end
		local v = (((d0 * 85 + d1) * 85 + d2) * 85 + d3) * 85 + d4
		if v > 4294967295 then
			fail("data group out of range")
		end
		buffer.writeu32(out, o, v)
		o += 4
	end
	return out
end

local function reverseBits(code: number, bits: number): number
	local r = 0
	for _ = 1, bits do
		r = r * 2 + bit32.band(code, 1)
		code = bit32.rshift(code, 1)
	end
	return r
end

-- Decode table: 12 peeked bits -> value * 16 + code length. value < 256 is a residual byte, 256 + k a zero run.
local function buildTable(src: buffer, at: number, nlit: number, nrun: number): buffer
	local nsym = nlit + nrun
	local lengths = table.create(nsym, 0)
	local count = table.create(MAX_BITS, 0)
	for i = 0, nsym - 1 do
		local len = bit32.extract(buffer.readu8(src, at + bit32.rshift(i, 1)), bit32.band(i, 1) * 4, 4)
		if len > MAX_BITS then
			fail("bad code length")
		end
		lengths[i + 1] = len
		if len > 0 then
			count[len] += 1
		end
	end
	local nextCode = table.create(MAX_BITS, 0)
	local code = 0
	for bits = 1, MAX_BITS do
		code = (code + (if bits > 1 then count[bits - 1] else 0)) * 2
		nextCode[bits] = code
	end
	local tbl = buffer.create(TABLE_SIZE * 2)
	for i = 0, nsym - 1 do
		local len = lengths[i + 1]
		if len > 0 then
			local c = nextCode[len]
			nextCode[len] = c + 1
			if c >= bit32.lshift(1, len) then
				fail("bad code lengths")
			end
			local value = if i < nlit then buffer.readu8(UNZIG, i) else RUN_BASE + (i - nlit)
			local entry = value * 16 + len
			for j = reverseBits(c, len), TABLE_SIZE - 1, bit32.lshift(1, len) do
				buffer.writeu16(tbl, j * 2, entry)
			end
		end
	end
	return tbl
end

-- Huffman stream -> residual bytes of every plane (zero runs are skipped: buffers start zeroed).
local function inflate(src: buffer, bitPos: number, tbl: buffer, n: number): buffer
	local res = buffer.create(n)
	local o = 0
	local bp = bitPos
	while o < n do
		local e = buffer.readu16(tbl, bit32.extract(buffer.readu32(src, bit32.rshift(bp, 3)), bit32.band(bp, 7), MAX_BITS) * 2)
		local len = bit32.band(e, 15)
		if len == 0 then
			fail("corrupt bitstream")
		end
		bp += len
		local v = bit32.rshift(e, 4)
		if v < RUN_BASE then
			buffer.writeu8(res, o, v)
			o += 1
		else
			local k = v - RUN_BASE
			if k >= 2 then
				local eb = k - 1
				o += bit32.lshift(1, eb) + bit32.extract(buffer.readu32(src, bit32.rshift(bp, 3)), bit32.band(bp, 7), eb) + 2
				bp += eb
			else
				o += k + 2
			end
		end
	end
	if o ~= n then
		fail("corrupt bitstream (a run goes past the end)")
	end
	return res
end

-- Undo each row's predictor, writing the plane into channel `ch` of the RGBA output.
local function unfilter(src: buffer, flagsAt: number, res: buffer, out: buffer, w: number, h: number, plane: number, ch: number)
	local stride = w * 4
	local zeroRow = buffer.create(stride)
	for y = 0, h - 1 do
		local row = plane * h + y
		local f = bit32.extract(buffer.readu8(src, flagsAt + bit32.rshift(row, 2)), bit32.band(row, 3) * 2, 2)
		local r = row * w
		local q = y * stride + ch
		local up, u = out, q - stride
		if y == 0 then
			up, u = zeroRow, ch
		end
		if f == 0 then -- left
			local a = 0
			for x = r, r + w - 1 do
				a = bit32.band(a + buffer.readu8(res, x), 255)
				buffer.writeu8(out, q, a)
				q += 4
			end
		elseif f == 1 then -- up
			for x = r, r + w - 1 do
				buffer.writeu8(out, q, bit32.band(buffer.readu8(up, u) + buffer.readu8(res, x), 255))
				q += 4
				u += 4
			end
		elseif f == 2 then -- average of left and up
			local a = 0
			for x = r, r + w - 1 do
				a = bit32.band(bit32.rshift(a + buffer.readu8(up, u), 1) + buffer.readu8(res, x), 255)
				buffer.writeu8(out, q, a)
				q += 4
				u += 4
			end
		else -- gradient: left + up - up-left, clamped
			local a, c = 0, 0
			for x = r, r + w - 1 do
				local b = buffer.readu8(up, u)
				local p = a + b - c
				if p < 0 then
					p = 0
				elseif p > 255 then
					p = 255
				end
				a = bit32.band(p + buffer.readu8(res, x), 255)
				buffer.writeu8(out, q, a)
				c = b
				q += 4
				u += 4
			end
		end
	end
end

-- decode(data, w, h, fmt) -> buffer of w * h * 4 bytes (RGBA8). fmt is "RGBA" or "LA" (from the texture index).
function TexCodec.decode(data: string, w: number, h: number, fmt: string): buffer
	local channels = if fmt == "RGBA" then 4 elseif fmt == "LA" then 2 else fail("unknown format " .. tostring(fmt))
	local src = unbase85(data)
	if buffer.len(src) < 12 then
		fail("data too short")
	end
	if buffer.readu8(src, 0) ~= VERSION then
		fail("unsupported version " .. buffer.readu8(src, 0))
	end
	if buffer.readu8(src, 1) ~= channels or buffer.readu16(src, 2) ~= w or buffer.readu16(src, 4) ~= h then
		fail("data does not match its size or format")
	end
	local nlit = buffer.readu8(src, 6) + 1
	local nrun = buffer.readu8(src, 7)
	local flagsAt = 8
	local lengthsAt = flagsAt + (h * channels + 3) // 4
	local bitPos = (lengthsAt + (nlit + nrun + 1) // 2) * 8
	if bitPos // 8 + 4 > buffer.len(src) then
		fail("data too short")
	end
	local tbl = buildTable(src, lengthsAt, nlit, nrun)
	local res = inflate(src, bitPos, tbl, w * h * channels)
	local out = buffer.create(w * h * 4)
	if channels == 4 then
		unfilter(src, flagsAt, res, out, w, h, 0, 3)
		unfilter(src, flagsAt, res, out, w, h, 1, 0)
		unfilter(src, flagsAt, res, out, w, h, 2, 1)
		unfilter(src, flagsAt, res, out, w, h, 3, 2)
	else
		unfilter(src, flagsAt, res, out, w, h, 0, 3)
		unfilter(src, flagsAt, res, out, w, h, 1, 0)
		for i = 0, w * h * 4 - 1, 4 do
			local l = buffer.readu8(out, i)
			buffer.writeu8(out, i + 1, l)
			buffer.writeu8(out, i + 2, l)
		end
	end
	return out
end

-- Adler-32 of a buffer's bytes (the index stores it for the decoded RGBA8 pixels).
function TexCodec.checksum(buf: buffer): number
	local n = buffer.len(buf)
	local a, b = 1, 0
	local i = 0
	while i < n do
		local stop = math.min(n, i + 1048576) -- reduce every MiB so the sums stay exact
		for j = i, stop - 1 do
			a += buffer.readu8(buf, j)
			b += a
		end
		a %= 65521
		b %= 65521
		i = stop
	end
	return b * 65536 + a
end

return TexCodec
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Textures</string>
          <string name="Source"><![CDATA[-- Textures: art painted from texture specs by the harness (paint_texture), rebuilt at runtime as EditableImages.
--   Textures.apply(panel, "panel_skin")    ImageLabel / ImageButton (ImageContent, plus SliceCenter when the texture
--                                          has a 9-slice and the label's ScaleType is Slice); ParticleEmitter, Beam,
--                                          Trail, Decal, Texture, MeshPart (TextureContent). -> true when applied
--   local content = Textures.get("spark")   Content, decoded on first use and cached; nil if unavailable
--   Textures.preload({"panel_skin", "spark"})   decode ahead of time, spread over frames when the caller can yield
--   Textures.has(name); Textures.info(name) -> {w, h, size, fmt, slice: Rect?, loaded}; Textures.names()
--   Textures.release(name)                  destroy a texture's EditableImage once nothing shows it
-- LA textures are white/grey + alpha: colour them with ImageColor3, or the emitter's / beam's / trail's Color.
-- EditableImage memory is limited (about 70 MB on desktop, less on phones; a 256x256 texture uses 256 KB). When it
-- is spent, get/apply return nil/false, warn once, and creation is retried at most every few seconds. Nothing here
-- throws. Client-side: EditableImages made on the server are not replicated.
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TexCodec = require(script.Parent:WaitForChild("TexCodec"))

local Textures = {}

local RETRY_SECONDS = 3
local FRAME_BUDGET = 0.004 -- seconds of decoding per frame while preloading

type Entry = { pack: number | { number }, w: number, h: number, fmt: string, slice: { number }?, checksum: number? }
type Record = { image: any, content: any }

local index: { [string]: Entry }? = nil
local indexRetryAt = 0
local waitedForIndex = false
local folder: Instance? = nil
local packs: { [number]: { [string]: string } | false } = {}
local cache: { [string]: Record } = {}
local broken: { [string]: boolean } = {}
local createRetryAt = 0
local warned: { [string]: boolean } = {}

local function warnOnce(key: string, message: string)
	if not warned[key] then
		warned[key] = true
		warn("[Textures] " .. message)
	end
end

local function findIndex(): { [string]: Entry }?
	local now = os.clock()
	if now < indexRetryAt then
		return nil
	end
	indexRetryAt = now + RETRY_SECONDS
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local found = shared and shared:FindFirstChild("TexPacks")
	if not found and not waitedForIndex and coroutine.isyieldable() then
		waitedForIndex = true -- right after joining, give replication a moment (once)
		shared = shared or ReplicatedStorage:WaitForChild("Shared", 5)
		found = shared and shared:WaitForChild("TexPacks", 5)
	end
	local module = found and found:FindFirstChild("Index")
	if not module or not module:IsA("ModuleScript") then
		warnOnce("index", "no texture index at ReplicatedStorage.Shared.TexPacks.Index (no textures painted yet?)")
		return nil
	end
	local ok, result = pcall(require, module)
	if not ok or type(result) ~= "table" then
		warnOnce("index", "could not load the texture index: " .. tostring(result))
		return nil
	end
	folder = found
	index = result
	return result
end

local function loadIndex(): { [string]: Entry }?
	if index then
		return index
	end
	local ok, result = pcall(findIndex)
	if not ok then
		warnOnce("index", "could not load the texture index: " .. tostring(result))
		return nil
	end
	return result
end

local function packData(n: number): { [string]: string }?
	local p = packs[n]
	if p == nil then
		local module = folder and folder:FindFirstChild("Pack" .. tostring(n))
		local ok, result = false, nil
		if module and module:IsA("ModuleScript") then
			ok, result = pcall(require, module)
		end
		p = if ok and type(result) == "table" then result else false
		packs[n] = p
		if not p then
			warnOnce("pack" .. tostring(n), "texture pack Pack" .. tostring(n) .. " is missing or broken")
		end
	end
	return if p then p else nil
end

local function dataOf(name: string, entry: Entry): string?
	local pack = entry.pack
	if type(pack) == "number" then
		local p = packData(pack)
		local data = p and p[name]
		return if type(data) == "string" then data else nil
	elseif type(pack) == "table" then
		local parts = table.create(#pack)
		for i, n in pack do
			local p = packData(n)
			local part = p and p[name]
			if type(part) ~= "string" then
				return nil
			end
			parts[i] = part
		end
		return table.concat(parts)
	end
	return nil
end

local function build(name: string): Record?
	local idx = loadIndex()
	if cache[name] then -- another thread built it while the index loaded
		return cache[name]
	end
	local entry = idx and idx[name]
	if type(entry) ~= "table" then
		if idx then
			warnOnce("missing:" .. name, "no texture named " .. name)
		end
		return nil
	end
	if broken[name] or os.clock() < createRetryAt then
		return nil
	end
	local data = dataOf(name, entry)
	if not data then
		broken[name] = true
		warnOnce("data:" .. name, "no data for texture " .. name .. " in its pack")
		return nil
	end
	local ok, pixels = pcall(TexCodec.decode, data, entry.w, entry.h, entry.fmt)
	if not ok then
		broken[name] = true
		warnOnce("decode:" .. name, "could not decode texture " .. name .. ": " .. tostring(pixels))
		return nil
	end
	if entry.checksum and TexCodec.checksum(pixels) ~= entry.checksum then
		broken[name] = true
		warnOnce("checksum:" .. name, "texture " .. name .. " is corrupted (checksum mismatch)")
		return nil
	end
	local size = Vector2.new(entry.w, entry.h)
	local okImage, image = pcall(function()
		return AssetService:CreateEditableImage({ Size = size })
	end)
	if not okImage or image == nil then
		createRetryAt = os.clock() + RETRY_SECONDS
		warnOnce("memory", "could not create an EditableImage for " .. name .. " (" .. tostring(image)
			.. "): the image memory budget may be spent; Textures.release what is no longer shown")
		return nil
	end
	local okWrite, err = pcall(function()
		image:WritePixelsBuffer(Vector2.zero, size, pixels)
	end)
	local okContent, content = false, nil
	if okWrite then
		okContent, content = pcall(Content.fromObject, image)
	end
	if not okWrite or not okContent then
		pcall(image.Destroy, image)
		createRetryAt = os.clock() + RETRY_SECONDS
		warnOnce("write:" .. name, "could not fill the EditableImage for " .. name .. ": "
			.. tostring(if okWrite then content else err))
		return nil
	end
	local record = { image = image, content = content }
	cache[name] = record
	return record
end

function Textures.get(name: string): Content?
	local record = cache[name]
	if record then
		return record.content
	end
	local ok, result = pcall(build, name)
	if not ok then
		warnOnce("error:" .. tostring(name), "failed to build texture " .. tostring(name) .. ": " .. tostring(result))
		return nil
	end
	return if result then result.content else nil
end

function Textures.apply(inst: Instance, name: string): boolean
	if typeof(inst) ~= "Instance" then
		warnOnce("apply:notinstance", "Textures.apply needs an Instance, got " .. typeof(inst))
		return false
	end
	local content = Textures.get(name)
	if content == nil then
		return false
	end
	local ok, err = pcall(function()
		if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			local label = inst :: any
			label.ImageContent = content
			local entry = index and index[name]
			local s = entry and entry.slice
			if s and label.ScaleType == Enum.ScaleType.Slice then
				label.SliceCenter = Rect.new(s[1], s[2], s[3], s[4])
			end
		elseif inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("Decal")
			or inst:IsA("MeshPart") then
			(inst :: any).TextureContent = content
		else
			error("a " .. inst.ClassName .. " does not show textures", 0)
		end
	end)
	if not ok then
		warnOnce("apply:" .. inst.ClassName .. ":" .. name, "could not apply " .. name .. " to "
			.. inst:GetFullName() .. ": " .. tostring(err))
		return false
	end
	return true
end

-- Decodes textures ahead of time (all of them when names is nil). Returns how many are ready.
function Textures.preload(names: { string }?): number
	local list = names or Textures.names()
	local ready = 0
	local frameStart = os.clock()
	for _, name in list do
		if not cache[name] then
			Textures.get(name)
			if os.clock() - frameStart > FRAME_BUDGET and coroutine.isyieldable() then
				task.wait()
				frameStart = os.clock()
			end
		end
		if cache[name] then
			ready += 1
		end
	end
	return ready
end

function Textures.has(name: string): boolean
	local idx = loadIndex()
	return idx ~= nil and type(idx[name]) == "table"
end

function Textures.info(name: string): { [string]: any }?
	local idx = loadIndex()
	local e = idx and idx[name]
	if type(e) ~= "table" then
		return nil
	end
	local ok, info = pcall(function()
		local s = e.slice
		return {
			w = e.w,
			h = e.h,
			size = Vector2.new(e.w, e.h),
			fmt = e.fmt,
			slice = if s then Rect.new(s[1], s[2], s[3], s[4]) else nil,
			loaded = cache[name] ~= nil,
		}
	end)
	return if ok then info else nil
end

function Textures.names(): { string }
	local idx = loadIndex()
	local out = {}
	if idx then
		for name in idx do
			table.insert(out, name)
		end
		table.sort(out)
	end
	return out
end

-- Frees a texture's EditableImage (anything still showing it goes blank); the next get() rebuilds it.
function Textures.release(name: string)
	local record = cache[name]
	if record then
		cache[name] = nil
		pcall(record.image.Destroy, record.image)
		createRetryAt = 0
	end
end

return Textures
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">UIKit</string>
          <string name="Source"><![CDATA[--!nonstrict
-- UIKit: themed, animated game UI components on the 1920x1080 canvas (client).
--   UIKit.theme("arcade" | "cozy" | "tactical" | "fantasy" | "toon", overrides?) -> theme (becomes current)
--   local hp = UIKit.bar({label = "HEALTH", value = 80, max = 100}); hp:set(55)
--   UIKit.banner("GO!"):flash(1.2); UIKit.toast("Quest complete", {kind = "good"}); UIKit.damage(part, 42, {kind = "crit"})
-- Every component returns an object with :set(...), :show(), :hide(), :Destroy(), animates in/out and on change,
-- and looks finished with no images: panels are layered gradients, strokes and hard shadows. Optional `image`/`icon`
-- fields take an Assets name ("coin_icon"), an rbxassetid string or a number.
-- Slanted panels are stacks of horizontal strips: Roblox cannot clip rotated frames, so a skew is built, not rotated.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Kit = script.Parent
local Spring = require(Kit:WaitForChild("Spring"))
local Screen = require(Kit:WaitForChild("Screen"))
local Assets = require(Kit:WaitForChild("Assets"))

local Tokens
do
	local ok, result = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Shared", 5):WaitForChild("Tokens", 5))
	end)
	Tokens = ok and result or nil
end

local UIKit: any = {}
UIKit.onSound = nil -- function(name, component?) : "hover" | "click" | "pop" | "tick" | "banner" | "go" | "check" | "hit" | "kill" | "toast" | "type" | "reload" | "stamp" | "deny"

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local V2 = Vector2.new
local H = Color3.fromHex

-- ── helpers ──────────────────────────────────────────────────────────────────
local function mk(className: string, props: { [string]: any }?, parent: Instance?): any
	local inst: any = Instance.new(className)
	if className == "Frame" or className == "TextLabel" or className == "ImageLabel" or className == "TextButton" then
		inst.BorderSizePixel = 0
	end
	if props then
		for k, v in props do
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function lighten(c: Color3, a: number): Color3
	return c:Lerp(WHITE, a)
end
local function darken(c: Color3, a: number): Color3
	return c:Lerp(BLACK, a)
end
local function corner(parent, r)
	return mk("UICorner", { CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r or 0) }, parent)
end
local function stroke(parent, color, thickness, transparency, border)
	return mk("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		LineJoinMode = Enum.LineJoinMode.Round,
		ApplyStrokeMode = border and Enum.ApplyStrokeMode.Border or Enum.ApplyStrokeMode.Contextual,
	}, parent)
end
local function vgrad(parent, top, bottom)
	return mk("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90 }, parent)
end
local function tw(obj, goal, t, style, dir, delay)
	local tween = TweenService:Create(
		obj,
		TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out, 0, false, delay or 0),
		goal
	)
	tween:Play()
	return tween
end
local function commas(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (n < 0 and "-" or "") .. out
end
local function fmtNum(v, format)
	if type(format) == "function" then
		return format(v)
	elseif type(format) == "string" then
		return string.format(format, v)
	end
	return commas(v)
end
local function clockText(s: number, tenths: boolean?): string
	s = math.max(0, s)
	if tenths and s < 10 then
		return string.format("%.1f", s)
	end
	local m = math.floor(s / 60)
	return string.format("%d:%02d", m, math.floor(s - m * 60))
end
local function sfx(name, comp)
	local cb = UIKit.onSound
	if cb then
		task.spawn(cb, name, comp)
	end
end
local function resolveImage(img): string
	if img == nil or img == "" then
		return ""
	elseif type(img) == "number" then
		return "rbxassetid://" .. img
	elseif type(img) == "string" and (string.find(img, "://", 1, true) or string.find(img, "^%d+$")) then
		return string.find(img, "^%d+$") and ("rbxassetid://" .. img) or img
	elseif type(img) == "string" then
		return Assets.image(img, "")
	end
	return ""
end
local function rarityColor(t, rarity)
	if typeof(rarity) == "Color3" then
		return rarity
	end
	return t.rarity[rarity or "common"] or t.rarity.common
end

-- ── springs: one Heartbeat drives every live UI spring ───────────────────────
local driven = {}
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 1 / 20)
	for h in driven do
		local s = h.s
		local p = s:Step(dt)
		if not pcall(h.apply, p) then
			driven[h] = nil
			continue
		end
		if math.abs(s.Target - p) < 1e-3 and math.abs(s.Velocity) < 1e-3 then
			s:Snap(s.Target)
			h.apply(s.Target)
			driven[h] = nil
		end
	end
end)

local function springValue(initial: number, speed: number, damping: number, apply: (number) -> ()): any
	local h: any = { s = Spring.new(initial, speed, damping), apply = apply }
	function h.to(_, v)
		h.s.Target = v
		driven[h] = true
	end
	function h.snap(_, v)
		h.s:Snap(v)
		h.apply(v)
		driven[h] = nil
	end
	function h.kick(_, v)
		h.s:Impulse(v)
		driven[h] = true
	end
	function h.stop()
		driven[h] = nil
	end
	apply(initial)
	return h
end

-- ── fades without CanvasGroups (they clip shadows): scale every descendant's transparency ──
local bases = setmetatable({}, { __mode = "k" })
local function record(inst, force)
	local b = bases[inst]
	if b and not force then
		return b
	end
	if inst:IsA("GuiObject") then
		b = { bg = inst.BackgroundTransparency }
		if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
			b.tx = inst.TextTransparency
		end
		if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			b.im = inst.ImageTransparency
		end
	elseif inst:IsA("UIStroke") then
		b = { st = inst.Transparency }
	else
		return nil
	end
	bases[inst] = b
	return b
end
local function applyAlpha(root, a, rerecord)
	local function one(inst)
		if inst:GetAttribute("NoFade") then
			return
		end
		local b = record(inst, rerecord)
		if not b then
			return
		end
		if b.bg then
			inst.BackgroundTransparency = 1 - (1 - b.bg) * a
		end
		if b.tx then
			inst.TextTransparency = 1 - (1 - b.tx) * a
		end
		if b.im then
			inst.ImageTransparency = 1 - (1 - b.im) * a
		end
		if b.st then
			inst.Transparency = 1 - (1 - b.st) * a
		end
	end
	one(root)
	for _, d in root:GetDescendants() do
		one(d)
	end
end
local function noFade(inst)
	inst:SetAttribute("NoFade", true)
	for _, d in inst:GetDescendants() do
		d:SetAttribute("NoFade", true)
	end
	return inst
end

-- ── themes ───────────────────────────────────────────────────────────────────
local function fam(enum)
	return Font.fromEnum(enum).Family
end
local function F(enum, weight, italic)
	return Font.new(fam(enum), weight, italic and Enum.FontStyle.Italic or Enum.FontStyle.Normal)
end

local RARITY = {
	common = H("#b8c2cc"),
	uncommon = H("#5bd67a"),
	rare = H("#4fa8ff"),
	epic = H("#b46cff"),
	legendary = H("#ffb02e"),
	mythic = H("#ff4f8b"),
}

-- Shape language: skew = slant as a fraction of height (0 = upright), radius px, stroke = ink outline px,
-- rim = inner light edge px, shadow = hard drop-shadow px, gloss = top highlight 0..1, tilt = header rotation deg.
local PRESETS = {
	arcade = {
		skew = 0.24, radius = 0, stroke = 3, rim = 2, rimT = 0.1, shadow = 5, shadowT = 0.2, softShadow = false,
		gloss = 0.12, panelT = 0, caps = true, tilt = -4, textStroke = 3, textShadow = 5, corners = "none",
		spring = { speed = 26, damping = 0.5 }, punch = 0.28,
		font = {
			display = F(Enum.Font.GothamBlack, Enum.FontWeight.Heavy, true),
			heading = F(Enum.Font.GothamBlack, Enum.FontWeight.Bold, true),
			body = F(Enum.Font.GothamBlack, Enum.FontWeight.Bold, false),
			numeric = F(Enum.Font.GothamBlack, Enum.FontWeight.Heavy, true),
		},
		c = {
			ink = H("#061020"), panelTop = H("#11284a"), panelBottom = H("#081426"), raisedTop = H("#24508f"),
			raisedBottom = H("#12305c"), rim = H("#f2fbff"), text = H("#f2fbff"), textDim = H("#7fa4c8"),
			dispTop = H("#ffffff"), dispBottom = H("#c9f0ff"), textShadow = H("#ffd23c"), accent = H("#3cff9e"),
			accent2 = H("#2ae8c4"), good = H("#3cff9e"), warn = H("#ffd23c"), bad = H("#ff3d5a"), gold = H("#ffd86b"),
			track = H("#050d1a"), backdrop = H("#040a14"),
		},
	},
	cozy = {
		skew = 0, radius = 18, stroke = 3, rim = 0, rimT = 0, shadow = 6, shadowT = 0.72, softShadow = true,
		gloss = 0.35, panelT = 0, caps = false, tilt = 0, textStroke = 3, textShadow = 3, corners = "none",
		spring = { speed = 20, damping = 0.62 }, punch = 0.18,
		font = {
			display = F(Enum.Font.FredokaOne, Enum.FontWeight.Regular),
			heading = F(Enum.Font.FredokaOne, Enum.FontWeight.Regular),
			body = F(Enum.Font.Nunito, Enum.FontWeight.ExtraBold),
			numeric = F(Enum.Font.FredokaOne, Enum.FontWeight.Regular),
		},
		c = {
			ink = H("#5a3826"), panelTop = H("#fff6e6"), panelBottom = H("#f4dcb8"), raisedTop = H("#ffffff"),
			raisedBottom = H("#fbe8cc"), rim = H("#ffffff"), text = H("#5a3826"), textDim = H("#a07f63"),
			dispTop = H("#ffffff"), dispBottom = H("#ffe7c2"), textShadow = H("#5a3826"), accent = H("#ff8a5b"),
			accent2 = H("#6cc4a1"), good = H("#6cc16a"), warn = H("#f6b73c"), bad = H("#e5604d"), gold = H("#f6c453"),
			track = H("#e3c79f"), backdrop = H("#3b2418"),
		},
	},
	tactical = {
		skew = 0, radius = 2, stroke = 1, rim = 0, rimT = 0, shadow = 0, shadowT = 1, softShadow = false,
		gloss = 0, panelT = 0.3, caps = true, tilt = 0, textStroke = 0, textShadow = 2, corners = "brackets",
		spring = { speed = 34, damping = 0.9 }, punch = 0.08, outlineT = 0.65,
		font = {
			display = F(Enum.Font.TitilliumWeb, Enum.FontWeight.Bold),
			heading = F(Enum.Font.TitilliumWeb, Enum.FontWeight.SemiBold),
			body = F(Enum.Font.RobotoCondensed, Enum.FontWeight.Medium),
			numeric = F(Enum.Font.RobotoMono, Enum.FontWeight.Bold),
		},
		c = {
			ink = H("#c9d4dc"), panelTop = H("#18212b"), panelBottom = H("#0a0f14"), raisedTop = H("#2a3846"),
			raisedBottom = H("#18222c"), rim = H("#ffffff"), text = H("#e8eef2"), textDim = H("#8797a3"),
			dispTop = H("#ffffff"), dispBottom = H("#d7e2ea"), textShadow = H("#000000"), accent = H("#e8b33a"),
			accent2 = H("#5ad1ff"), good = H("#7be07b"), warn = H("#ffb02e"), bad = H("#ff4b3e"), gold = H("#e8b33a"),
			track = H("#05080b"), backdrop = H("#000000"), shade = H("#000000"), onAccent = H("#0a0f14"),
		},
	},
	fantasy = {
		skew = 0, radius = 6, stroke = 3, rim = 2, rimT = 0.15, shadow = 5, shadowT = 0.35, softShadow = false,
		gloss = 0.1, panelT = 0, caps = true, tilt = 0, textStroke = 2, textShadow = 3, corners = "gems",
		spring = { speed = 22, damping = 0.68 }, punch = 0.2,
		font = {
			display = F(Enum.Font.Merriweather, Enum.FontWeight.Heavy),
			heading = F(Enum.Font.Merriweather, Enum.FontWeight.Bold),
			body = F(Enum.Font.SourceSans, Enum.FontWeight.SemiBold),
			numeric = F(Enum.Font.Merriweather, Enum.FontWeight.Bold),
		},
		c = {
			ink = H("#140b06"), panelTop = H("#3d2b4d"), panelBottom = H("#1b1226"), raisedTop = H("#5a4170"),
			raisedBottom = H("#2c1f3c"), rim = H("#d6a94a"), text = H("#f4e9d0"), textDim = H("#b4a284"),
			dispTop = H("#fff4c9"), dispBottom = H("#e3a93c"), textShadow = H("#140b06"), accent = H("#e9b949"),
			accent2 = H("#8fd3ff"), good = H("#7fd66b"), warn = H("#f0a33c"), bad = H("#d9483b"), gold = H("#ffd773"),
			track = H("#0f0915"), backdrop = H("#0c0712"),
		},
	},
	toon = {
		skew = 0, radius = 22, stroke = 4, rim = 0, rimT = 0, shadow = 6, shadowT = 0, softShadow = false,
		gloss = 0.4, panelT = 0, caps = true, tilt = -3, textStroke = 4, textShadow = 5, corners = "none",
		spring = { speed = 19, damping = 0.4 }, punch = 0.34,
		font = {
			display = F(Enum.Font.LuckiestGuy, Enum.FontWeight.Regular),
			heading = F(Enum.Font.FredokaOne, Enum.FontWeight.Regular),
			body = F(Enum.Font.FredokaOne, Enum.FontWeight.Regular),
			numeric = F(Enum.Font.LuckiestGuy, Enum.FontWeight.Regular),
		},
		c = {
			ink = H("#1b1030"), panelTop = H("#5aa0ff"), panelBottom = H("#2c5ed8"), raisedTop = H("#ffe066"),
			raisedBottom = H("#ffb420"), rim = H("#ffffff"), text = H("#ffffff"), textDim = H("#d4e3ff"),
			dispTop = H("#ffffff"), dispBottom = H("#fff1a6"), textShadow = H("#1b1030"), accent = H("#ffcf3a"),
			accent2 = H("#ff5fa2"), good = H("#4be07a"), warn = H("#ff9f1c"), bad = H("#ff4b5c"), gold = H("#ffd93a"),
			track = H("#1b1030"), backdrop = H("#150c28"),
		},
	},
}
UIKit.presets = PRESETS

local function merge(dst, src)
	for k, v in src do
		if type(v) == "table" and type(dst[k]) == "table" then
			merge(dst[k], v)
		else
			dst[k] = v
		end
	end
	return dst
end
local function copy(t)
	local out = {}
	for k, v in t do
		out[k] = type(v) == "table" and copy(v) or v
	end
	return out
end

-- theme(name, overrides?): a preset layered over the game's Tokens. overrides.tokens = "accents" (default: Tokens'
-- primary/secondary/success/warning/danger drive accents), "all" (also panels, text, fonts) or "none".
function UIKit.theme(name, overrides)
	local preset = PRESETS[name or "arcade"] or PRESETS.arcade
	local t = copy(preset)
	t.name = PRESETS[name] and name or "arcade"
	t.rarity = copy(RARITY)
	t.font = preset.font -- Font values are immutable; share them
	overrides = overrides or {}
	local mode = overrides.tokens or "accents"
	local tc = Tokens and Tokens.color
	if tc and mode ~= "none" then
		t.c.accent = tc.primary or t.c.accent
		t.c.accent2 = tc.secondary or t.c.accent2
		t.c.good = tc.success or t.c.good
		t.c.warn = tc.warning or t.c.warn
		t.c.bad = tc.danger or t.c.bad
		if mode == "all" then
			t.c.panelTop, t.c.panelBottom = tc.surface_raised or t.c.panelTop, tc.surface or t.c.panelBottom
			t.c.text, t.c.textDim = tc.text or t.c.text, tc.text_muted or t.c.textDim
			if Tokens.font then
				t.font = { display = Tokens.font.display, heading = Tokens.font.heading, body = Tokens.font.body, numeric = Tokens.font.numeric }
			end
		end
	end
	local fontOverride = overrides.font
	local o = table.clone(overrides)
	o.font, o.tokens = nil, nil
	merge(t, o)
	if fontOverride then
		t.font = table.clone(t.font)
		for k, v in fontOverride do
			t.font[k] = v
		end
	end
	UIKit.current = t
	return t
end
UIKit.current = nil
UIKit.theme("arcade")

-- ── layer, layout helpers ────────────────────────────────────────────────────
local layers = {}
function UIKit.layer(name, displayOrder)
	name = name or "UIKit"
	local g = layers[name]
	if not g or not g.Parent then -- cached: Screen.gui connects a resize handler on every call
		g = Screen.gui(name, displayOrder or 20)
		layers[name] = g
	end
	return g
end
-- Canvas px to keep clear of the Roblox top bar (the kit's ScreenGuis ignore the inset).
function UIKit.safeTop()
	return Screen.topInset() / Screen.scale() + 12
end
function UIKit.compact()
	return Screen.isCompact()
end

local function caps(t, role, s)
	if t.caps and (role == "display" or role == "heading") then
		return string.upper(s)
	end
	return s
end

-- Text with the theme's chunky treatment: font role, ink outline, offset shadow, optional vertical gradient.
local function text(parent, t, o)
	local role = o.role or "body"
	local holder = mk("Frame", {
		Name = o.name or "Text",
		BackgroundTransparency = 1,
		Size = o.size or UDim2.fromScale(1, 1),
		Position = o.position or UDim2.new(),
		AnchorPoint = o.anchor or Vector2.zero,
		Rotation = o.rotation or 0,
	}, parent)
	local loud = role == "display" or role == "numeric" or role == "heading"
	local strokePx = o.stroke or (loud and t.textStroke or 0)
	local shadowPx = o.shadow or (loud and t.textShadow or (t.textShadow > 0 and 2 or 0))
	local base = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		FontFace = o.font or t.font[role],
		TextSize = o.textSize or 24,
		Text = caps(t, role, o.text or ""),
		TextXAlignment = o.x or Enum.TextXAlignment.Center,
		TextYAlignment = o.y or Enum.TextYAlignment.Center,
		TextWrapped = o.wrap or false,
		TextTruncate = o.truncate and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None,
	}
	local L = { holder = holder, role = role }
	if shadowPx > 0 then
		local sh = mk("TextLabel", base, holder)
		sh.Name = "Shadow"
		sh.Position = UDim2.fromOffset(o.shadowX or (role == "display" and math.floor(shadowPx * 0.6) or 0), shadowPx)
		sh.TextColor3 = o.shadowColor or (role == "display" and t.c.textShadow or t.c.shade or t.c.ink)
		sh.TextTransparency = (t.name == "tactical" or not loud) and 0.45 or 0
		if strokePx > 0 then
			stroke(sh, t.c.ink, strokePx)
		end
		L.shadow = sh
	end
	local lab = mk("TextLabel", base, holder)
	lab.Name = "Label"
	lab.TextColor3 = o.gradient and WHITE or (o.color or t.c.text)
	if strokePx > 0 then
		L.stroke = stroke(lab, o.strokeColor or t.c.ink, strokePx)
	end
	if o.gradient then
		L.grad = mk("UIGradient", { Color = o.gradient, Rotation = 90 }, lab)
	end
	L.label = lab
	function L.set(_, s)
		s = caps(t, role, tostring(s))
		lab.Text = s
		if L.shadow then
			L.shadow.Text = s
		end
	end
	function L.color(_, c)
		if L.grad then
			L.grad.Color = ColorSequence.new(lighten(c, 0.55), c)
		else
			lab.TextColor3 = c
		end
	end
	return L
end

local function measure(s: string, font: Font, size: number, cb: (number) -> ())
	cb(#s * size * 0.62)
	task.spawn(function()
		local ok, v = pcall(function()
			local p = Instance.new("GetTextBoundsParams")
			p.Text = s
			p.Font = font
			p.Size = size
			p.Width = 4000
			return TextService:GetTextBoundsAsync(p)
		end)
		if ok and v then
			cb(v.X)
		end
	end)
end

-- ── plates: the kit's panel (slanted strip stack or rounded frame) ──────────
local function shade(top, bottom, y, gloss)
	local c = top:Lerp(bottom, y)
	if gloss > 0 and y < 0.5 then
		c = c:Lerp(WHITE, gloss * (1 - y * 2) ^ 2)
	end
	return c
end

local function stack(parent, x, y, dw, dh, h, skewPx, top, bottom, gloss, transparency, grad)
	local box = mk("Frame", {
		Name = "Stack",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.new(1, dw, 1, dh),
	}, parent)
	local n = math.clamp(math.floor(h / 3), 6, 32)
	local strips = table.create(n)
	for i = 1, n do
		local yc = (i - 0.5) / n
		local s = mk("Frame", {
			BackgroundColor3 = shade(top, bottom, yc, gloss),
			BackgroundTransparency = transparency,
			Position = UDim2.new(0, skewPx * (1 - yc), (i - 1) / n, 0),
			Size = UDim2.new(1, -skewPx, 1 / n, transparency > 0 and 0 or 1),
		}, box)
		if grad then
			mk("UIGradient", { Color = grad }, s)
		end
		strips[i] = s
	end
	return box, strips
end

-- plate(parent, t, {size = Vector2, position, anchor, top, bottom | fill, grad = ColorSequence, outline, stroke,
--   skew, radius, shadow, rim, gloss, transparency, deco, image}) -> P {root, setColor(top, bottom), skewPx, k}
local function plate(parent, t, o)
	local w, h = o.size.X, o.size.Y
	local k = o.skew or t.skew
	local strokePx = o.stroke or t.stroke
	local fill = o.fill
	local top = o.top or (fill and lighten(fill, 0.12)) or t.c.panelTop
	local bottom = o.bottom or (fill and darken(fill, 0.22)) or t.c.panelBottom
	local gloss = o.gloss or t.gloss
	local alpha = o.transparency or t.panelT
	local shadowPx = o.shadow or t.shadow
	local rimPx = o.rim or t.rim
	local outline = o.outline or t.c.ink
	local outlineT = o.outlineT or t.outlineT or 0
	local root = mk("Frame", {
		Name = o.name or "Plate",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(w, h),
		Position = o.position or UDim2.new(),
		AnchorPoint = o.anchor or Vector2.zero,
	}, parent)
	local P: any = { root = root, k = k, skewPx = k * h, h = h }
	if k > 0 then
		local s = strokePx
		local rs = rimPx
		if shadowPx > 0 then
			stack(root, -s - k * s, -s + shadowPx, 2 * s + 2 * k * s, 2 * s, h + 2 * s, k * (h + 2 * s), outline, outline, 0, t.shadowT, nil)
		end
		if s > 0 then
			stack(root, -s - k * s, -s, 2 * s + 2 * k * s, 2 * s, h + 2 * s, k * (h + 2 * s), outline, outline, 0, outlineT, nil)
		end
		if rs > 0 and alpha < 0.5 then
			stack(root, 0, 0, 0, 0, h, k * h, t.c.rim, t.c.rim, 0, t.rimT, nil)
		end
		local inset = rs > 0 and alpha < 0.5 and rs or 0
		local _, strips = stack(root, inset + k * inset, inset, -2 * inset - 2 * k * inset, -2 * inset, h - 2 * inset,
			k * (h - 2 * inset), top, bottom, gloss, alpha, o.grad)
		P.strips = strips
		function P.setColor(_, a, b)
			b = b or darken(a, 0.22)
			local n = #strips
			for i, st in strips do
				st.BackgroundColor3 = shade(a, b, (i - 0.5) / n, gloss)
			end
		end
	else
		local r = o.radius or t.radius
		if shadowPx > 0 then
			if t.softShadow then
				for i, tr in { 0.82, 0.9, 0.95 } do
					local g = (i - 1) * 4
					local sh = mk("Frame", {
						Name = "Shadow",
						BackgroundColor3 = outline,
						BackgroundTransparency = tr,
						Position = UDim2.fromOffset(-g, shadowPx - g + 2),
						Size = UDim2.new(1, 2 * g, 1, 2 * g),
					}, root)
					corner(sh, r + g)
				end
			else
				local sh = mk("Frame", {
					Name = "Shadow",
					BackgroundColor3 = outline,
					BackgroundTransparency = t.shadowT,
					Position = UDim2.fromOffset(-strokePx, shadowPx - strokePx),
					Size = UDim2.new(1, 2 * strokePx, 1, 2 * strokePx),
				}, root)
				corner(sh, r + strokePx)
			end
		end
		local body = mk("Frame", {
			Name = "Fill",
			BackgroundColor3 = WHITE,
			BackgroundTransparency = alpha,
			Size = UDim2.fromScale(1, 1),
		}, root)
		corner(body, r)
		local g = mk("UIGradient", { Color = o.grad or ColorSequence.new(top, bottom), Rotation = o.grad and 0 or 90 }, body)
		if strokePx > 0 then
			stroke(body, outline, strokePx, outlineT, true)
		end
		if o.grad then -- vertical shade over a horizontal colour gradient
			local sh = mk("Frame", { Name = "Shade", BackgroundColor3 = BLACK, Size = UDim2.fromScale(1, 1) }, body)
			corner(sh, r)
			mk("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0.7) }, sh)
		end
		if gloss > 0 then
			local gl = mk("Frame", {
				Name = "Gloss",
				BackgroundColor3 = WHITE,
				Position = UDim2.fromOffset(3, 3),
				Size = UDim2.new(1, -6, 0.48, -3),
			}, body)
			corner(gl, math.max(0, r - 3))
			mk("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1 - gloss * 0.9, 1) }, gl)
		end
		if rimPx > 0 then
			local rim = mk("Frame", {
				Name = "Rim",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(rimPx + 1, rimPx + 1),
				Size = UDim2.new(1, -2 * rimPx - 2, 1, -2 * rimPx - 2),
			}, body)
			corner(rim, math.max(0, r - rimPx))
			stroke(rim, t.c.rim, rimPx, t.rimT, true)
		end
		P.body = body
		function P.setColor(_, a, b)
			if o.grad then
				return
			end
			g.Color = ColorSequence.new(a, b or darken(a, 0.22))
		end
	end
	if o.image and resolveImage(o.image) ~= "" then
		local img = mk("ImageLabel", {
			Name = "Art",
			BackgroundTransparency = 1,
			Image = resolveImage(o.image),
			Size = UDim2.fromScale(1, 1),
			ScaleType = Enum.ScaleType.Stretch,
		}, root)
		local slice = type(o.image) == "string" and Assets.slice(o.image)
		if slice then
			img.ScaleType = Enum.ScaleType.Slice
			img.SliceCenter = slice
		end
	end
	if o.deco and t.corners ~= "none" then
		local acc = t.corners == "gems" and t.c.rim or t.c.accent
		for _, cxy in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
			local cx, cy = cxy[1], cxy[2]
			if t.corners == "brackets" then
				local L = 16
				mk("Frame", {
					BackgroundColor3 = acc,
					AnchorPoint = V2(cx, cy),
					Position = UDim2.new(cx, cx == 0 and -4 or 4, cy, cy == 0 and -4 or 4),
					Size = UDim2.fromOffset(L, 2),
				}, root)
				mk("Frame", {
					BackgroundColor3 = acc,
					AnchorPoint = V2(cx, cy),
					Position = UDim2.new(cx, cx == 0 and -4 or 4, cy, cy == 0 and -4 or 4),
					Size = UDim2.fromOffset(2, L),
				}, root)
			else
				local gem = mk("Frame", {
					BackgroundColor3 = acc,
					AnchorPoint = V2(0.5, 0.5),
					Position = UDim2.fromScale(cx, cy),
					Size = UDim2.fromOffset(14, 14),
					Rotation = 45,
				}, root)
				stroke(gem, t.c.ink, 2, 0, true)
				vgrad(gem, WHITE, darken(WHITE, 0.35))
			end
		end
	end
	return P
end

-- A disc (or tactical square) icon: gradient, outline, gloss, then the image or a glyph.
local function iconDisc(parent, t, o)
	local size = o.size or 64
	local color = o.color or t.c.accent
	local root = mk("Frame", {
		Name = "Icon",
		BackgroundColor3 = WHITE,
		Size = UDim2.fromOffset(size, size),
		Position = o.position or UDim2.new(),
		AnchorPoint = o.anchor or Vector2.zero,
	}, parent)
	local r = t.name == "tactical" and UDim.new(0, 3) or UDim.new(1, 0)
	corner(root, r)
	vgrad(root, lighten(color, 0.3), darken(color, 0.25))
	if t.stroke > 0 then
		stroke(root, t.c.ink, math.max(2, t.stroke), t.outlineT or 0, true)
	end
	if t.gloss > 0 then
		local gl = mk("Frame", { BackgroundColor3 = WHITE, Position = UDim2.fromScale(0.15, 0.06), Size = UDim2.fromScale(0.7, 0.42) }, root)
		corner(gl, UDim.new(1, 0))
		mk("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.55, 1) }, gl)
	end
	local img = resolveImage(o.image)
	local I = { root = root }
	if img ~= "" then
		I.image = mk("ImageLabel", {
			BackgroundTransparency = 1,
			Image = img,
			AnchorPoint = V2(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(o.fill or 0.82, o.fill or 0.82),
			ScaleType = Enum.ScaleType.Fit,
		}, root)
	else
		I.glyph = text(root, t, {
			role = "heading",
			text = o.glyph or "?",
			textSize = math.floor(size * 0.52),
			color = WHITE,
			stroke = math.max(2, t.textStroke - 1),
			shadow = 2,
		})
	end
	return I
end

-- ── components: shared base ──────────────────────────────────────────────────
local live = {}
local Base: any = {}
Base.__index = Base
local function class()
	local c: any = setmetatable({}, { __index = Base })
	c.__index = c
	return c
end

local function newBase(o, w, h, pos, anchor, kind)
	o = o or {}
	local t = o.theme or UIKit.current
	local root = mk("Frame", {
		Name = o.name or kind or "UIKit",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(w, h),
		Position = o.position or pos,
		AnchorPoint = o.anchor or anchor,
	}, o.parent or UIKit.layer())
	local body = mk("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
	}, root)
	local scale = mk("UIScale", {}, body)
	local self: any = { t = t, o = o, root = root, body = body, conns = {}, springs = {}, _alpha = 1, _shown = true, _ver = 0 }
	self.scale = scale
	self._pop = springValue(1, t.spring.speed, t.spring.damping, function(v)
		scale.Scale = v
	end)
	self._slide = springValue(0, t.spring.speed * 0.8, 1, function(v)
		body.Position = UDim2.new(0.5, 0, 0.5, v)
	end)
	self.springs = { self._pop, self._slide }
	live[self] = true
	return self
end

function Base:spring(initial, speed, damping, apply)
	local s = springValue(initial, speed or self.t.spring.speed, damping or self.t.spring.damping, apply)
	table.insert(self.springs, s)
	return s
end
function Base:on(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self.conns, c)
	return c
end
function Base:later(seconds, fn)
	local ver = self._ver
	task.delay(seconds, function()
		if not self._dead and self._ver == ver then
			fn()
		end
	end)
end
function Base:_fade(target, dur, done)
	if self._fadeConn then
		self._fadeConn:Disconnect()
		self._fadeConn = nil
	end
	if target < self._alpha and self._alpha >= 0.999 then
		applyAlpha(self.root, 1, true)
	end
	local from, start = self._alpha, os.clock()
	if dur <= 0 or self.noFade then
		self._alpha = target
		if not self.noFade then
			applyAlpha(self.root, target)
		end
		if done then
			done()
		end
		return
	end
	self._fadeConn = RunService.Heartbeat:Connect(function()
		local a = math.clamp((os.clock() - start) / dur, 0, 1)
		self._alpha = from + (target - from) * a
		applyAlpha(self.root, self._alpha)
		if a >= 1 then
			self._fadeConn:Disconnect()
			self._fadeConn = nil
			if done then
				done()
			end
		end
	end)
end
function Base:show(instant)
	if self._dead then
		return self
	end
	self._shown = true
	self._hideTok = (self._hideTok or 0) + 1
	self.root.Visible = true
	if instant then
		self._pop:snap(1)
		self._slide:snap(0)
		self:_fade(1, 0)
		return self
	end
	if self._alpha < 0.05 then
		self._pop:snap(self.popFrom or 0.72)
		self._slide:snap(self.slideFrom or 26)
	end
	self._pop:to(1)
	self._slide:to(0)
	self:_fade(1, 0.18)
	if self.onShow then
		self:onShow()
	end
	return self
end
function Base:hide(instant)
	if self._dead then
		return self
	end
	self._shown = false
	self._hideTok = (self._hideTok or 0) + 1
	local tok = self._hideTok
	if instant then
		self:_fade(0, 0)
		self.root.Visible = false
		return self
	end
	self._pop:to(0.88)
	self._slide:to(14)
	self:_fade(0, 0.16, function()
		if self._hideTok == tok and not self._dead then
			self.root.Visible = false
		end
	end)
	return self
end
function Base:punch(amount)
	self._pop.s.Position = 1 + (amount or self.t.punch)
	self._pop:to(1)
	return self
end
function Base:setPosition(p)
	self.root.Position = p
	return self
end
function Base:Destroy()
	if self._dead then
		return
	end
	self._dead = true
	self._ver += 1
	for _, c in self.conns do
		c:Disconnect()
	end
	for _, s in self.springs do
		s:stop()
	end
	if self._fadeConn then
		self._fadeConn:Disconnect()
	end
	if self.onDestroy then
		self:onDestroy()
	end
	live[self] = nil
	self.root:Destroy()
end
Base.destroy = Base.Destroy
function Base:_enter()
	if self.o.hidden then
		self:hide(true)
	else
		self._alpha = 0
		if not self.noFade then
			applyAlpha(self.root, 0)
		end
		self:show()
	end
	return self
end

-- Destroys every live component (use when switching screens or themes).
function UIKit.clear()
	for c in live do
		c:Destroy()
	end
end

-- ── button: lip button with hover lift and press squish ─────────────────────
local Button = class()
function UIKit.button(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local w, h = (o.size and o.size.X) or 260, (o.size and o.size.Y) or 72
	local lip = math.max(4, math.floor(h * 0.1))
	local self = setmetatable(newBase(o, w, h + lip, UDim2.fromScale(0.5, 0.8), V2(0.5, 0.5), "Button"), Button)
	self.noFade = o.parent ~= nil and o.nested ~= false
	self.lip = lip
	self.enabled = o.enabled ~= false
	local function kindColor(kind)
		local c = t.c
		return ({ primary = c.accent, secondary = c.accent2, good = c.good, danger = c.bad, warn = c.warn, neutral = c.raisedTop })[kind or "primary"]
			or (typeof(kind) == "Color3" and kind)
			or c.accent
	end
	self.kindColor = kindColor
	self.color = o.color or kindColor(o.kind)
	local base = plate(self.body, t, {
		size = V2(w, h),
		position = UDim2.fromOffset(0, lip),
		fill = darken(self.color, 0.45),
		gloss = 0,
		shadow = t.shadow > 0 and t.shadow or 0,
		rim = 0,
	})
	self.base = base
	local faceHolder = mk("Frame", { Name = "Face", BackgroundTransparency = 1, Size = UDim2.fromOffset(w, h) }, self.body)
	self.faceHolder = faceHolder
	self.face = plate(faceHolder, t, { size = V2(w, h), fill = self.color, shadow = 0 })
	local tx = 0
	if o.icon or o.glyph then
		local s = math.floor(h * 0.62)
		iconDisc(faceHolder, t, {
			size = s,
			image = o.icon,
			glyph = o.glyph,
			color = lighten(self.color, 0.2),
			position = UDim2.new(0, 14 + base.skewPx * 0.5, 0.5, 0),
			anchor = V2(0, 0.5),
		})
		tx = s + 10
	end
	self.label = text(faceHolder, t, {
		role = "heading",
		text = o.text or "BUTTON",
		textSize = o.textSize or math.floor(h * 0.42),
		color = t.name == "cozy" and WHITE or t.c.text,
		position = UDim2.fromOffset(tx, 0),
		size = UDim2.new(1, -tx, 1, 0),
	})
	local lift = self:spring(0, 32, 0.55, function(v)
		faceHolder.Position = UDim2.fromOffset(0, v)
	end)
	self.lift = lift
	local hit = mk("TextButton", {
		Name = "Hit",
		Text = "",
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 5,
	}, self.body)
	self.hit = hit
	local hovering = false
	self:on(hit.MouseEnter, function()
		if not self.enabled then
			return
		end
		hovering = true
		lift:to(-3)
		self._pop:to(1.04)
		sfx("hover", self)
	end)
	self:on(hit.MouseLeave, function()
		hovering = false
		lift:to(0)
		self._pop:to(1)
	end)
	self:on(hit.MouseButton1Down, function()
		if not self.enabled then
			return
		end
		lift:to(lip - 1)
		self._pop:to(0.97)
	end)
	self:on(hit.MouseButton1Up, function()
		lift:to(hovering and -3 or 0)
		self._pop:to(hovering and 1.04 or 1)
	end)
	self:on(hit.Activated, function()
		if not self.enabled then
			sfx("deny", self)
			self:shake()
			return
		end
		lift.s.Position = lip
		lift:to(hovering and -3 or 0)
		sfx("click", self)
		if o.onClick then
			task.spawn(o.onClick, self)
		end
	end)
	if not self.enabled then
		self:set({ enabled = false })
	end
	return self:_enter()
end
function Button:shake()
	local s = self:spring(0, 40, 0.25, function(v)
		self.faceHolder.Position = UDim2.fromOffset(v, self.faceHolder.Position.Y.Offset)
	end)
	s:kick(260)
end
-- set({text, color, kind, enabled})
function Button:set(p)
	if type(p) == "string" then
		p = { text = p }
	end
	if p.text then
		self.label:set(p.text)
	end
	if p.enabled ~= nil then
		self.enabled = p.enabled
	end
	if p.color or p.kind then
		self.color = p.color or self.kindColor(p.kind)
	end
	local c = self.enabled and self.color or self.t.c.textDim:Lerp(self.t.c.panelBottom, 0.4)
	self.face:setColor(lighten(c, 0.12), darken(c, 0.22))
	self.base:setColor(darken(c, 0.45), darken(c, 0.55))
	return self
end

-- ── banner: big centre text with a slanted band, punch-in and a shine sweep ─
local Banner = class()
function UIKit.banner(textValue, o)
	o = o or {}
	local t = o.theme or UIKit.current
	local self = setmetatable(newBase(o, 1600, 360, UDim2.fromScale(0.5, 0.4), V2(0.5, 0.5), "Banner"), Banner)
	self.popFrom = 2.2
	self.slideFrom = 0
	local size = o.textSize or 150
	self.textSize = size
	local tilt = mk("Frame", { Name = "Tilt", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Rotation = o.tilt or t.tilt }, self.body)
	local bandH = math.floor(size * 1.05)
	self.color = o.color or t.c.accent
	local bandHolder = mk("Frame", {
		Name = "Band",
		BackgroundTransparency = 1,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(600, bandH),
	}, tilt)
	self.bandHolder = bandHolder
	local band = plate(bandHolder, t, {
		size = V2(600, bandH),
		top = t.name == "arcade" and t.c.panelTop or lighten(self.color, 0.1),
		bottom = t.name == "arcade" and t.c.panelBottom or darken(self.color, 0.3),
		deco = true,
	})
	band.root.Size = UDim2.fromScale(1, 1)
	self.band = band
	local textColor = t.name == "arcade" and self.color or nil
	self.text = text(tilt, t, {
		role = "display",
		text = textValue or "",
		textSize = size,
		gradient = ColorSequence.new(textColor and lighten(textColor, 0.35) or t.c.dispTop, textColor or t.c.dispBottom),
		position = UDim2.fromScale(0.5, 0.45),
		anchor = V2(0.5, 0.5),
		size = UDim2.new(1, 0, 0, size + 20),
	})
	local shine = mk("TextLabel", {
		Name = "Shine",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		FontFace = t.font.display,
		TextSize = size,
		Text = self.text.label.Text,
		TextColor3 = WHITE,
	}, self.text.holder)
	self.shineGrad = mk("UIGradient", {
		Rotation = 25,
		Offset = V2(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.42, 1),
			NumberSequenceKeypoint.new(0.5, 0.05),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, shine)
	noFade(shine)
	self.shine = shine
	self.sub = text(tilt, t, {
		role = "heading",
		text = o.sub or "",
		textSize = math.floor(size * 0.28),
		position = UDim2.new(0.5, 0, 0.45, bandH * 0.5 + 34),
		anchor = V2(0.5, 0.5),
		size = UDim2.new(1, 0, 0, 50),
	})
	self:_layout(textValue or "")
	return self:_enter()
end
function Banner:_layout(s)
	local t = self.t
	measure(caps(t, "display", s), t.font.display, self.textSize, function(wpx)
		if self._dead then
			return
		end
		local target = UDim2.fromOffset(math.min(1500, wpx + 170 + self.band.skewPx), self.bandHolder.Size.Y.Offset)
		local changed = self._bandTarget and self._bandTarget ~= target
		self._bandTarget = target
		if changed and self._shown and self.bandHolder.Size.X.Offset > 0 then
			tw(self.bandHolder, { Size = target }, 0.2)
		end
	end)
end
function Banner:onShow()
	local target = self._bandTarget or UDim2.fromOffset(700, self.bandHolder.Size.Y.Offset)
	self.bandHolder.Size = UDim2.fromOffset(0, target.Y.Offset)
	task.defer(function()
		if self._dead then
			return
		end
		tw(self.bandHolder, { Size = self._bandTarget or target }, 0.32, Enum.EasingStyle.Back)
	end)
	self.shineGrad.Offset = V2(-1, 0)
	tw(self.shineGrad, { Offset = V2(1, 0) }, 0.55, Enum.EasingStyle.Quad, nil, 0.18)
	sfx("banner", self)
end
-- set(text, {sub, color})
function Banner:set(s, p)
	p = p or {}
	self.text:set(s)
	self.shine.Text = self.text.label.Text
	if p.sub then
		self.sub:set(p.sub)
	end
	if p.color then
		self.color = p.color
		self.text:color(p.color)
	end
	self:_layout(s)
	if self._shown then
		self._pop.s.Position = 1.6
		self._pop:to(1)
		self:onShow()
	end
	return self
end
-- flash(seconds, text?): show, hold, hide.
function Banner:flash(seconds, s, p)
	if s then
		self:set(s, p)
	end
	self:show()
	local tok = (self._flashTok or 0) + 1
	self._flashTok = tok
	self:later(seconds or 1.4, function()
		if self._flashTok == tok then
			self:hide()
		end
	end)
	return self
end

-- ── countdown: 3-2-1-GO with punch and pulse ring ───────────────────────────
local Countdown = class()
function UIKit.countdown(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local self = setmetatable(newBase(o, 600, 400, UDim2.fromScale(0.5, 0.42), V2(0.5, 0.5), "Countdown"), Countdown)
	self.popFrom = 2
	self.slideFrom = 0
	local ring = mk("Frame", {
		Name = "Pulse",
		BackgroundTransparency = 1,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(260, 260),
	}, self.body)
	corner(ring, UDim.new(1, 0))
	self.ringStroke = stroke(ring, t.c.accent, 10, 1, true)
	self.ringScale = mk("UIScale", {}, ring)
	noFade(ring)
	self.num = text(self.body, t, {
		role = "display",
		text = "",
		textSize = o.textSize or 240,
		gradient = ColorSequence.new(t.c.dispTop, t.c.dispBottom),
		rotation = t.tilt,
	})
	self.goText = o.go or "GO!"
	return self:_enter()
end
function Countdown:set(v)
	local t = self.t
	local isGo = type(v) ~= "number"
	local c = isGo and t.c.good or (v <= 1 and t.c.warn or v == 2 and t.c.warn or t.c.bad)
	self.num:set(isGo and v or tostring(v))
	self.num:color(c)
	if not self._shown then
		self:show()
	end
	self._pop.s.Position = isGo and 2.4 or 1.9
	self._pop:to(1)
	self.ringStroke.Color = c
	self.ringStroke.Transparency = 0
	self.ringScale.Scale = 0.5
	tw(self.ringScale, { Scale = isGo and 2.2 or 1.5 }, 0.6, Enum.EasingStyle.Quart)
	tw(self.ringStroke, { Transparency = 1 }, 0.6, Enum.EasingStyle.Quad)
	sfx(isGo and "go" or "tick", self)
	return self
end
-- start(from = 3, onDone?, step = 1): counts down, shows GO, then hides.
function Countdown:start(from, onDone, step)
	self._ver += 1
	from, step = from or 3, step or 1
	local ver = self._ver
	task.spawn(function()
		for i = from, 1, -1 do
			if self._dead or self._ver ~= ver then
				return
			end
			self:set(i)
			task.wait(step)
		end
		if self._dead or self._ver ~= ver then
			return
		end
		self:set(self.goText)
		if onDone then
			task.spawn(onDone)
		end
		task.wait(step * 0.8)
		if not self._dead and self._ver == ver then
			self:hide()
		end
	end)
	return self
end

-- ── counter: icon + number that rolls and pops ──────────────────────────────
local Counter = class()
function UIKit.counter(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local w, h = o.width or 280, o.height or 64
	local self = setmetatable(newBase(o, w + 40, h + 30, UDim2.fromOffset(40, UIKit.safeTop() + 20), V2(0, 0), "Counter"), Counter)
	self.format = o.format
	self.value = o.value or 0
	self.color = o.color or t.c.gold
	plate(self.body, t, { size = V2(w, h), position = UDim2.fromOffset(40, 20) })
	local isz = math.floor(h * 1.3)
	self.icon = iconDisc(self.body, t, {
		size = isz,
		image = o.icon,
		glyph = o.glyph or (o.label and string.sub(o.label, 1, 1)) or "$",
		color = self.color,
		position = UDim2.fromOffset(isz * 0.5 + 6, 20 + h * 0.5),
		anchor = V2(0.5, 0.5),
	})
	self.iconRot = self:spring(0, 22, 0.3, function(v)
		self.icon.root.Rotation = v
	end)
	local tx = isz + 18
	if o.label then
		text(self.body, t, {
			role = "heading",
			text = o.label,
			textSize = 16,
			color = t.c.textDim,
			x = Enum.TextXAlignment.Left,
			position = UDim2.fromOffset(tx, 2),
			size = UDim2.fromOffset(w, 18),
			stroke = 0,
			shadow = 0,
		})
	end
	local numHolder = mk("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(tx, 20),
		Size = UDim2.fromOffset(w + 40 - tx - 16, h),
	}, self.body)
	self.numScale = mk("UIScale", {}, numHolder)
	self.numPop = self:spring(1, 30, 0.45, function(v)
		self.numScale.Scale = v
	end)
	self.num = text(numHolder, t, {
		role = "numeric",
		text = fmtNum(self.value, self.format),
		textSize = math.floor(h * 0.68),
		x = Enum.TextXAlignment.Left,
		color = t.c.text,
	})
	return self:_enter()
end
-- set(value, {silent}): rolls to value, pops, and floats the delta.
function Counter:set(v, p)
	p = p or {}
	local from = self.value
	self.value = v
	if self._roll then
		self._roll:Disconnect()
	end
	local start = os.clock()
	self._roll = self:on(RunService.Heartbeat, function()
		local a = math.clamp((os.clock() - start) / 0.5, 0, 1)
		local e = 1 - (1 - a) ^ 4
		self.num:set(fmtNum(math.floor(from + (v - from) * e + 0.5), self.format))
		if a >= 1 then
			self._roll:Disconnect()
		end
	end)
	if p.silent or v == from then
		return self
	end
	self.numPop.s.Position = 1 + self.t.punch
	self.numPop:to(1)
	self.iconRot:kick(v > from and -260 or 260)
	local d = v - from
	UIKit.popup((d > 0 and "+" or "") .. fmtNum(d, self.format), {
		at = self.root,
		offset = V2(self.root.Size.X.Offset * 0.55, 10),
		color = d > 0 and self.t.c.good or self.t.c.bad,
		theme = self.t,
		parent = self.root.Parent,
	})
	sfx("pop", self)
	return self
end

-- ── bar: health / stamina / progress with lag-trail chip ────────────────────
local Bar = class()
function UIKit.bar(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local w, h = o.width or 440, o.height or 34
	local labelH = o.label and 26 or 0
	local self = setmetatable(newBase(o, w + 30, h + labelH + 16, UDim2.new(0, 40, 1, -60), V2(0, 1), "Bar"), Bar)
	self.max = o.max or 100
	self.value = o.value or self.max
	self.color = o.color or t.c.good
	self.format = o.format
	self.showText = o.showText ~= false
	if o.label then
		text(self.body, t, {
			role = "heading",
			text = o.label,
			textSize = 20,
			x = Enum.TextXAlignment.Left,
			position = UDim2.fromOffset(t.skew * h + 6, 0),
			size = UDim2.fromOffset(w, 22),
			stroke = math.min(2, t.textStroke),
			shadow = 2,
		})
	end
	local shake = mk("Frame", {
		Name = "Shake",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, labelH),
		Size = UDim2.fromOffset(w, h),
	}, self.body)
	self.shakeFrame = shake
	local bg = plate(shake, t, { size = V2(w, h), top = t.c.track, bottom = lighten(t.c.track, 0.08), gloss = 0, rim = 0 })
	local k = t.skew
	local p = math.max(3, math.floor(h * 0.12))
	local cx = p + k * p
	local innerH = h - 2 * p
	local innerW = w - 2 * p - 2 * k * p
	self.inner = { x = cx, y = p, w = innerW, h = innerH, skew = k * innerH }
	local function fillPlate(color)
		local pl = plate(bg.root, t, {
			size = V2(innerW, innerH),
			position = UDim2.fromOffset(cx, p),
			fill = color,
			stroke = 0,
			shadow = 0,
			rim = 0,
			radius = math.max(0, t.radius - p),
			transparency = 0,
		})
		return pl
	end
	self.trail = fillPlate(WHITE)
	self.fill = fillPlate(self.color)
	if o.segments and o.segments > 1 then
		for i = 1, o.segments - 1 do
			mk("Frame", {
				BackgroundColor3 = t.c.track,
				BackgroundTransparency = 0.2,
				AnchorPoint = V2(0.5, 0),
				Position = UDim2.fromOffset(cx + self.inner.skew * 0.5 + (innerW - self.inner.skew) * i / o.segments, p),
				Size = UDim2.fromOffset(3, innerH),
				Rotation = math.deg(math.atan(k)),
			}, bg.root)
		end
	end
	self.txt = text(bg.root, t, {
		role = "numeric",
		text = "",
		textSize = math.floor(h * 0.6),
		x = Enum.TextXAlignment.Right,
		position = UDim2.fromOffset(-14 - k * h * 0.5, 0),
		stroke = 2,
		shadow = 0,
	})
	self.txt.holder.Visible = self.showText
	local function width(frac)
		frac = math.clamp(frac, 0, 1)
		local s = self.inner.skew
		return s + frac * (self.inner.w - s)
	end
	self.fillS = self:spring(self.value / self.max, 26, 1, function(v)
		self.fill.root.Size = UDim2.fromOffset(width(v), innerH)
		self.fill.root.Visible = v > 0.002
	end)
	self.trailS = self:spring(self.value / self.max, 7, 1, function(v)
		self.trail.root.Size = UDim2.fromOffset(width(v), innerH)
		self.trail.root.Visible = v > 0.002
	end)
	self.shakeS = self:spring(0, 45, 0.3, function(v)
		shake.Position = UDim2.fromOffset(v, labelH)
	end)
	self:_text()
	self.low = o.lowAt or 0.25
	self:on(RunService.Heartbeat, function()
		local frac = self.value / self.max
		if frac <= self.low and frac > 0 and o.pulseLow ~= false then
			local a = 0.5 + 0.5 * math.sin(os.clock() * 10)
			self.fill:setColor(lighten(self.color:Lerp(self.t.c.bad, 0.6), 0.12 + a * 0.3))
			self._pulsing = true
		elseif self._pulsing then
			self._pulsing = false
			self.fill:setColor(lighten(self.color, 0.12), darken(self.color, 0.22))
		end
	end)
	return self:_enter()
end
function Bar:_text()
	if self.showText then
		local f = self.format
		self.txt:set(f == "percent" and string.format("%d%%", math.floor(self.value / self.max * 100 + 0.5))
			or (fmtNum(self.value, f ~= "percent" and f or nil) .. " / " .. fmtNum(self.max, f ~= "percent" and f or nil)))
	end
end
-- set(value, max?): fill springs; losses leave a white chip that drains, gains lead with a good-coloured chip.
function Bar:set(v, max)
	local t = self.t
	self.max = max or self.max
	local old = self.fillS.s.Target
	self.value = math.clamp(v, 0, self.max)
	local frac = self.value / self.max
	self:_text()
	if frac < old then
		self.trail:setColor(WHITE, lighten(t.c.bad, 0.5))
		self.trailS:snap(math.max(self.trailS.s.Position, old))
		self.fillS:to(frac)
		self:later(0.35, function()
			self.trailS:to(self.value / self.max)
		end)
		if old - frac > 0.08 then
			self.shakeS:kick((math.random() < 0.5 and -1 or 1) * 220)
		end
	elseif frac > old then
		self.trail:setColor(lighten(t.c.good, 0.35), t.c.good)
		self.trailS:snap(frac)
		self.fillS.s.Speed = 8
		self.fillS:to(frac)
		self:later(0.6, function()
			self.fillS.s.Speed = 26
		end)
	end
	return self
end
function Bar:setColor(c)
	self.color = c
	self.fill:setColor(lighten(c, 0.12), darken(c, 0.22))
	return self
end

-- ── ring: radial progress (two clipped half-discs with hard-step gradients) ─
local Ring = class()
local HALF = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.5, 0),
	NumberSequenceKeypoint.new(0.501, 1),
	NumberSequenceKeypoint.new(1, 1),
})
function UIKit.ring(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local S = o.size or 128
	local th = o.thickness or math.floor(S * 0.13)
	local self = setmetatable(newBase(o, S, S, UDim2.fromScale(0.5, 0.5), V2(0.5, 0.5), "Ring"), Ring)
	self.color = o.color or t.c.accent
	self.value = o.value or 0
	local track = mk("Frame", { Name = "Track", BackgroundColor3 = t.c.track, Size = UDim2.fromScale(1, 1) }, self.body)
	corner(track, UDim.new(1, 0))
	if t.stroke > 0 then
		stroke(track, t.c.ink, t.stroke, t.outlineT or 0, true)
	end
	local grads = {}
	for i, side in { "Right", "Left" } do
		local clip = mk("Frame", {
			Name = side,
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Position = UDim2.fromScale(i == 1 and 0.5 or 0, 0),
			Size = UDim2.fromScale(0.5, 1),
		}, track)
		local disc = mk("Frame", {
			BackgroundColor3 = self.color,
			Position = UDim2.fromScale(i == 1 and -1 or 0, 0),
			Size = UDim2.fromScale(2, 1),
		}, clip)
		corner(disc, UDim.new(1, 0))
		grads[i] = mk("UIGradient", { Transparency = HALF }, disc)
		self["disc" .. i] = disc
	end
	self.grads = grads
	local inner = mk("Frame", {
		Name = "Inner",
		BackgroundColor3 = WHITE,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(S - 2 * th, S - 2 * th),
	}, track)
	corner(inner, UDim.new(1, 0))
	vgrad(inner, t.c.panelTop, t.c.panelBottom)
	if t.stroke > 0 then
		stroke(inner, t.c.ink, math.max(1, t.stroke - 1), t.outlineT or 0, true)
	end
	if o.icon or o.glyph then
		iconDisc(inner, t, {
			size = math.floor((S - 2 * th) * 0.62),
			image = o.icon,
			glyph = o.glyph,
			color = self.color,
			position = UDim2.fromScale(0.5, 0.5),
			anchor = V2(0.5, 0.5),
		})
	else
		self.txt = text(inner, t, { role = "numeric", text = "0%", textSize = math.floor(S * 0.24) })
	end
	if o.label then
		text(self.body, t, {
			role = "heading",
			text = o.label,
			textSize = 18,
			position = UDim2.new(0.5, 0, 1, 6),
			anchor = V2(0.5, 0),
			size = UDim2.fromOffset(S + 80, 22),
			stroke = math.min(2, t.textStroke),
		})
	end
	self.fmt = o.format
	self.valS = self:spring(self.value, 14, 1, function(v)
		local a = math.clamp(v, 0, 1) * 360
		grads[1].Rotation = math.min(a, 180)
		grads[2].Rotation = math.max(a, 180)
		if self.txt then
			self.txt:set(self.fmt and fmtNum(v, self.fmt) or (math.floor(v * 100 + 0.5) .. "%"))
		end
	end)
	return self:_enter()
end
-- set(fraction 0..1, {color})
function Ring:set(v, p)
	local prev = self.valS.s.Target
	self.valS:to(math.clamp(v, 0, 1))
	if p and p.color then
		self.disc1.BackgroundColor3 = p.color
		self.disc2.BackgroundColor3 = p.color
	end
	if v >= 1 and prev < 1 then
		self:punch()
		sfx("pop", self)
	end
	return self
end

-- ── dial: speedometer / gauge with lit segment band and sprung needle ───────
local Dial = class()
function UIKit.dial(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local S = o.size or 300
	local R = S / 2
	local self = setmetatable(newBase(o, S, S, UDim2.new(1, -40, 1, -40), V2(1, 1), "Dial"), Dial)
	self.max = o.max or 200
	self.red = o.redline or self.max * 0.8
	self.A0, self.SW = -135, 270
	local face = mk("Frame", { Name = "Face", BackgroundColor3 = WHITE, Size = UDim2.fromScale(1, 1) }, self.body)
	corner(face, UDim.new(1, 0))
	vgrad(face, t.c.panelTop, t.c.panelBottom)
	if t.stroke > 0 then
		stroke(face, t.c.ink, t.stroke + 1, t.outlineT or 0, true)
	end
	if t.shadow > 0 then
		local sh = mk("Frame", {
			Name = "Shadow",
			BackgroundColor3 = t.c.ink,
			BackgroundTransparency = t.shadowT,
			Position = UDim2.fromOffset(0, t.shadow),
			Size = UDim2.fromScale(1, 1),
			ZIndex = 0,
		}, self.body)
		corner(sh, UDim.new(1, 0))
		face.ZIndex = 1
	end
	local rimRing = mk("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(S - 16, S - 16),
	}, face)
	corner(rimRing, UDim.new(1, 0))
	stroke(rimRing, t.c.rim, 2, 0.75, true)
	local SEG = o.segments or 30
	self.segs = {}
	for j = 1, SEG do
		local frac = (j - 0.5) / SEG
		local a = self.A0 + self.SW * frac
		local holder = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Rotation = a }, face)
		local seg = mk("Frame", {
			BackgroundColor3 = t.c.track,
			AnchorPoint = V2(0.5, 0),
			Position = UDim2.fromOffset(R, 16),
			Size = UDim2.fromOffset(math.max(4, S * 0.022), S * 0.085),
		}, holder)
		corner(seg, 2)
		self.segs[j] = { f = seg, red = frac * self.max >= self.red }
	end
	local majors = o.majors or 5
	for j = 0, majors do
		local frac = j / majors
		local a = math.rad(self.A0 + self.SW * frac)
		local r2 = R * 0.6
		text(face, t, {
			role = "numeric",
			text = tostring(math.floor(self.max * frac + 0.5)),
			textSize = math.floor(S * 0.065),
			color = (frac * self.max >= self.red) and t.c.bad or t.c.textDim,
			position = UDim2.fromOffset(R + math.sin(a) * r2, R - math.cos(a) * r2),
			anchor = V2(0.5, 0.5),
			size = UDim2.fromOffset(60, 30),
			stroke = 0,
			shadow = 0,
		})
	end
	local needleHolder = mk("Frame", { Name = "Needle", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, face)
	local needle = mk("Frame", {
		BackgroundColor3 = WHITE,
		AnchorPoint = V2(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(math.max(6, S * 0.03), R * 0.74),
	}, needleHolder)
	corner(needle, 3)
	vgrad(needle, lighten(t.c.bad, 0.3), t.c.bad)
	stroke(needle, t.c.ink, 2, 0, true)
	local hub = mk("Frame", {
		BackgroundColor3 = WHITE,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(S * 0.13, S * 0.13),
	}, face)
	corner(hub, UDim.new(1, 0))
	vgrad(hub, t.c.raisedTop, t.c.raisedBottom)
	stroke(hub, t.c.ink, 2, 0, true)
	self.readout = text(face, t, {
		role = "numeric",
		text = "0",
		textSize = math.floor(S * 0.2),
		position = UDim2.fromScale(0.5, 0.74),
		anchor = V2(0.5, 0.5),
		size = UDim2.fromOffset(S * 0.6, S * 0.22),
	})
	text(face, t, {
		role = "heading",
		text = o.unit or "KM/H",
		textSize = math.floor(S * 0.055),
		color = t.c.textDim,
		position = UDim2.fromScale(0.5, 0.89),
		anchor = V2(0.5, 0.5),
		size = UDim2.fromOffset(S * 0.6, 20),
		stroke = 0,
		shadow = 0,
	})
	if o.label then
		text(face, t, {
			role = "heading",
			text = o.label,
			textSize = math.floor(S * 0.05),
			color = t.c.textDim,
			position = UDim2.fromScale(0.5, 0.3),
			anchor = V2(0.5, 0.5),
			size = UDim2.fromOffset(S * 0.6, 20),
			stroke = 0,
			shadow = 0,
		})
	end
	self.lit = -1
	self.valS = self:spring(o.value or 0, 12, 0.55, function(v)
		local frac = math.clamp(v / self.max, -0.02, 1.03)
		needleHolder.Rotation = self.A0 + self.SW * frac
		self.readout:set(tostring(math.max(0, math.floor(v + 0.5))))
		local lit = math.floor(math.clamp(frac, 0, 1) * SEG + 0.5)
		if lit ~= self.lit then
			self.lit = lit
			for j, sg in self.segs do
				sg.f.BackgroundColor3 = j <= lit and (sg.red and t.c.bad or t.c.accent) or t.c.track
			end
		end
	end)
	return self:_enter()
end
function Dial:set(v)
	self.valS:to(v)
	return self
end

-- ── timer: clock plate; countdown or stopwatch; warns and ticks near zero ───
local Timer = class()
function UIKit.timer(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local w, h = o.width or 230, o.height or 68
	local self = setmetatable(newBase(o, w, h, UDim2.new(0.5, 0, 0, UIKit.safeTop() + 16), V2(0.5, 0), "Timer"), Timer)
	self.countdown = o.countdown ~= false
	self.seconds = o.seconds or 60
	self.warnAt = o.warnAt or 10
	self.onDone = o.onDone
	plate(self.body, t, { size = V2(w, h), deco = true })
	local cs = h - 18
	local clock = mk("Frame", {
		BackgroundColor3 = WHITE,
		Position = UDim2.fromOffset(12 + t.skew * h * 0.5, 9),
		Size = UDim2.fromOffset(cs, cs),
	}, self.body)
	corner(clock, UDim.new(1, 0))
	vgrad(clock, lighten(t.c.accent, 0.3), t.c.accent)
	stroke(clock, t.c.ink, 2, t.outlineT or 0, true)
	for i, len in { 0.32, 0.22 } do
		local hand = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Rotation = i == 1 and 0 or 120 }, clock)
		mk("Frame", {
			BackgroundColor3 = t.c.ink,
			AnchorPoint = V2(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 4, len, 0),
		}, hand)
		if i == 1 then
			self.hand = hand
		end
	end
	self.txt = text(self.body, t, {
		role = "numeric",
		text = clockText(self.seconds),
		textSize = math.floor(h * 0.62),
		position = UDim2.fromOffset(cs + 18, 0),
		size = UDim2.new(1, -cs - 30, 1, 0),
	})
	self.lastWhole = math.ceil(self.seconds)
	self:on(RunService.Heartbeat, function(dt)
		if not self.running then
			return
		end
		self.seconds = self.countdown and math.max(0, self.seconds - dt) or self.seconds + dt
		self:_render()
		if self.countdown and self.seconds <= 0 then
			self.running = false
			self:punch(0.3)
			if self.onDone then
				task.spawn(self.onDone)
			end
		end
	end)
	if o.autoStart ~= false then
		self.running = true
	end
	return self:_enter()
end
function Timer:_render()
	local t = self.t
	local s = self.seconds
	self.txt:set(clockText(s, self.countdown))
	self.hand.Rotation = (s % 60) * 6
	local warn = self.countdown and s <= self.warnAt
	self.txt:color(warn and t.c.bad or t.c.text)
	local whole = math.ceil(s)
	if whole ~= self.lastWhole then
		self.lastWhole = whole
		if warn and s > 0 then
			self:punch(0.14)
			sfx("tick", self)
		end
	end
end
-- set(seconds) / start() / stop()
function Timer:set(s)
	self.seconds = s
	self.lastWhole = math.ceil(s)
	self:_render()
	return self
end
function Timer:start()
	self.running = true
	return self
end
function Timer:stop()
	self.running = false
	return self
end

-- ── objectiveTracker: checklist with check-off animation ────────────────────
local Tracker = class()
function UIKit.objectiveTracker(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local w = o.width or 400
	local self = setmetatable(newBase(o, w, 400, UDim2.new(0, 40, 0.3, 0), V2(0, 0), "Objectives"), Tracker)
	self.w, self.rowH, self.headH = w, 46, 44
	local head = plate(self.body, t, { size = V2(w * 0.72, self.headH), fill = t.c.accent })
	head.root.Rotation = t.tilt * 0.5
	text(head.root, t, {
		role = "heading",
		text = o.title or "OBJECTIVES",
		textSize = 24,
		x = Enum.TextXAlignment.Left,
		position = UDim2.fromOffset(16 + head.skewPx * 0.5, 0),
		size = UDim2.new(1, -20, 1, 0),
		color = t.c.onAccent or WHITE,
	})
	self.rows = {}
	self:set(o.items or {})
	return self:_enter()
end
function Tracker:_row(item, i)
	local t = self.t
	local y = self.headH + 10 + (i - 1) * (self.rowH + 6)
	local r = plate(self.body, t, {
		size = V2(self.w - 20, self.rowH),
		position = UDim2.fromOffset(10, y),
		shadow = 0,
		stroke = math.max(1, t.stroke - 1),
		transparency = math.max(t.panelT, 0.15),
		gloss = t.gloss * 0.5,
	})
	local row: any = { plate = r, item = item, done = false }
	local box = mk("Frame", {
		BackgroundColor3 = t.c.track,
		Position = UDim2.fromOffset(12 + r.skewPx * 0.5, (self.rowH - 26) / 2),
		Size = UDim2.fromOffset(26, 26),
	}, r.root)
	corner(box, t.name == "tactical" and 2 or 6)
	stroke(box, t.name == "tactical" and t.c.textDim or t.c.ink, 2, 0, true)
	row.box = box
	local check = mk("Frame", { Name = "Check", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Rotation = 45 }, box)
	mk("Frame", { BackgroundColor3 = WHITE, Position = UDim2.fromScale(0.52, 0.12), Size = UDim2.new(0, 5, 0.66, 0) }, check)
	mk("Frame", { BackgroundColor3 = WHITE, Position = UDim2.fromScale(0.26, 0.64), Size = UDim2.new(0.3, 0, 0, 5) }, check)
	row.checkScale = mk("UIScale", { Scale = 0 }, check)
	row.label = text(r.root, t, {
		role = "body",
		text = item.text or tostring(item),
		textSize = 20,
		x = Enum.TextXAlignment.Left,
		position = UDim2.fromOffset(50 + r.skewPx * 0.5, 0),
		size = UDim2.new(1, -120, 1, 0),
		truncate = true,
	})
	row.strike = mk("Frame", {
		BackgroundColor3 = t.c.textDim,
		AnchorPoint = V2(0, 0.5),
		Position = UDim2.new(0, 50 + r.skewPx * 0.5, 0.5, 0),
		Size = UDim2.fromOffset(0, 3),
	}, r.root)
	row.prog = text(r.root, t, {
		role = "numeric",
		text = item.max and string.format("%d/%d", item.progress or 0, item.max) or "",
		textSize = 20,
		x = Enum.TextXAlignment.Right,
		position = UDim2.fromOffset(-14 - r.skewPx * 0.5, 0),
		color = t.c.accent,
		stroke = math.min(2, t.textStroke),
		shadow = 0,
	})
	return row
end
-- set(items): items = { "text" | {id, text, progress, max, done} }
function Tracker:set(items)
	for _, row in self.rows do
		row.plate.root:Destroy()
	end
	self.rows = {}
	for i, item in items do
		if type(item) == "string" then
			item = { text = item }
		end
		self.rows[i] = self:_row(item, i)
		if item.done then
			self:check(i, true)
		end
	end
	self.root.Size = UDim2.fromOffset(self.w, self.headH + 16 + #items * (self.rowH + 6))
	return self
end
function Tracker:_find(key)
	if type(key) == "number" then
		return self.rows[key]
	end
	for _, row in self.rows do
		if row.item.id == key or row.item.text == key then
			return row
		end
	end
	return nil
end
-- check(index | id, instant?): ticks the box with a pop, strikes the text through, flashes the row.
function Tracker:check(key, instant)
	local row = self:_find(key)
	if not row or row.done then
		return self
	end
	local t = self.t
	row.done = true
	row.box.BackgroundColor3 = t.c.good
	row.label:color(t.c.textDim)
	local strikeW = math.min(self.w - 150, (#tostring(row.item.text or "") * 10) + 10)
	if instant then
		row.checkScale.Scale = 1
		row.strike.Size = UDim2.fromOffset(strikeW, 3)
		return self
	end
	local s = self:spring(0, 26, 0.4, function(v)
		row.checkScale.Scale = v
	end)
	s:to(1)
	tw(row.strike, { Size = UDim2.fromOffset(strikeW, 3) }, 0.35, Enum.EasingStyle.Quad, nil, 0.12)
	local flash = mk("Frame", { BackgroundColor3 = t.c.good, BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1) }, row.plate.root)
	corner(flash, math.max(t.radius, 0))
	noFade(flash)
	tw(flash, { BackgroundTransparency = 1 }, 0.6).Completed:Once(function()
		flash:Destroy()
	end)
	sfx("check", self)
	return self
end
function Tracker:progress(key, value, max)
	local row = self:_find(key)
	if row then
		row.item.progress, row.item.max = value, max or row.item.max
		row.prog:set(string.format("%d/%d", value, row.item.max or value))
		local s = mk("UIScale", {}, row.prog.holder)
		local sp = self:spring(1.4, 30, 0.4, function(v)
			s.Scale = v
		end)
		sp:to(1)
		if row.item.max and value >= row.item.max then
			self:check(key)
		end
	end
	return self
end

-- ── standings: leaderboard rows that spring to their new rank ───────────────
local Standings = class()
function UIKit.standings(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local w = o.width or 320
	local s = setmetatable(newBase(o, w, 420, UDim2.new(1, -40, 0, UIKit.safeTop() + 300), V2(1, 0), "Standings"), Standings)
	s.w, s.rowH, s.max = w, 44, o.max or 8
	s.headH = o.title and 38 or 0
	if o.title then
		local head = plate(s.body, t, { size = V2(w * 0.7, 32), fill = t.c.accent, shadow = 0, position = UDim2.fromOffset(w * 0.3, 0) })
		text(head.root, t, { role = "heading", text = o.title, textSize = 20, color = t.c.onAccent or WHITE })
	end
	s.rows = {}
	s.sortBy = o.sortBy
	s.format = o.format
	s:set(o.rows or {})
	return s:_enter()
end
function Standings:_make(r)
	local t = self.t
	local you = r.you
	local h = self.rowH
	local holder = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(self.w, h) }, self.body)
	local pl = plate(holder, t, {
		size = V2(self.w, h),
		top = you and lighten(t.c.accent, 0.1) or nil,
		bottom = you and darken(t.c.accent, 0.3) or nil,
		shadow = you and t.shadow or 0,
		stroke = math.max(1, t.stroke - 1),
	})
	local chip = mk("Frame", {
		BackgroundColor3 = WHITE,
		Position = UDim2.fromOffset(6 + pl.skewPx * 0.5, 5),
		Size = UDim2.fromOffset(h - 10, h - 10),
	}, pl.root)
	corner(chip, t.name == "tactical" and 2 or math.min(t.radius, 10))
	local grad = vgrad(chip, t.c.raisedTop, t.c.raisedBottom)
	local rank = text(chip, t, { role = "numeric", text = "1", textSize = 24 })
	mk("Frame", {
		BackgroundColor3 = r.color or t.c.accent2,
		Position = UDim2.fromOffset(h + 2 + pl.skewPx * 0.5, 8),
		Size = UDim2.fromOffset(5, h - 16),
	}, pl.root)
	local name = text(pl.root, t, {
		role = "heading",
		text = r.name,
		textSize = 20,
		x = Enum.TextXAlignment.Left,
		position = UDim2.fromOffset(h + 14 + pl.skewPx * 0.5, 0),
		size = UDim2.new(0.6, -h, 1, 0),
		color = you and WHITE or t.c.text,
		stroke = math.min(2, t.textStroke),
		shadow = 0,
		truncate = true,
	})
	local val = text(pl.root, t, {
		role = "numeric",
		text = "",
		textSize = 20,
		x = Enum.TextXAlignment.Right,
		position = UDim2.fromOffset(-12 - pl.skewPx * 0.5, 0),
		color = you and WHITE or t.c.textDim,
		stroke = math.min(2, t.textStroke),
		shadow = 0,
	})
	local row: any = { holder = holder, rank = rank, chipGrad = grad, name = name, val = val, you = you }
	row.yS = self:spring(0, 18, 0.75, function(v)
		holder.Position = UDim2.fromOffset(you and -14 or 0, v)
	end)
	return row
end
-- set(rows): rows = {{name, value, color?, you?}} in rank order (or opts.sortBy = "value" sorts descending).
function Standings:set(rows)
	local t = self.t
	rows = table.clone(rows)
	if self.sortBy then
		local key = self.sortBy
		table.sort(rows, function(a, b)
			return (a[key] or 0) > (b[key] or 0)
		end)
	end
	local seen = {}
	for i, r in rows do
		if i > self.max then
			break
		end
		seen[r.name] = true
		local row = self.rows[r.name]
		local y = self.headH + (i - 1) * (self.rowH + 6)
		if not row then
			row = self:_make(r)
			self.rows[r.name] = row
			row.yS:snap(y + 30)
			row.rankN = i
		end
		row.yS:to(y)
		row.rank:set(tostring(i))
		row.val:set(r.value ~= nil and (type(r.value) == "number" and fmtNum(r.value, self.format) or tostring(r.value)) or "")
		local medal = ({ t.c.gold, H("#d8e2ec"), H("#e09a5b") })[i]
		row.chipGrad.Color = medal and ColorSequence.new(lighten(medal, 0.3), darken(medal, 0.25)) or ColorSequence.new(t.c.raisedTop, t.c.raisedBottom)
		if row.rankN and row.rankN ~= i then
			local up = i < row.rankN
			local tag = text(row.holder, t, {
				role = "numeric",
				text = up and ("+" .. (row.rankN - i)) or ("-" .. (i - row.rankN)),
				textSize = 20,
				color = up and t.c.good or t.c.bad,
				position = UDim2.new(0, -10, 0.5, 0),
				anchor = V2(1, 0.5),
				size = UDim2.fromOffset(40, 24),
				stroke = 2,
			})
			noFade(tag.holder)
			task.delay(0.9, function()
				tag.holder:Destroy()
			end)
			if up and row.you then
				sfx("pop", self)
			end
		end
		row.rankN = i
	end
	for name, row in self.rows do
		if not seen[name] then
			row.holder:Destroy()
			row.yS:stop()
			self.rows[name] = nil
		end
	end
	self.root.Size = UDim2.fromOffset(self.w, self.headH + math.min(#rows, self.max) * (self.rowH + 6))
	return self
end

-- ── minimap: top-down view of given parts with tracked markers ──────────────
local Minimap = class()
local function collectParts(src, out)
	if typeof(src) == "Instance" then
		if src:IsA("BasePart") and not src:IsA("Terrain") then
			table.insert(out, src)
		else
			for _, d in src:GetDescendants() do
				if d:IsA("BasePart") and not d:IsA("Terrain") and d.Transparency < 0.95 and #out < 300 then
					table.insert(out, d)
				end
			end
		end
	elseif type(src) == "table" then
		for _, v in src do
			collectParts(v, out)
		end
	end
	return out
end
local function worldPos(at)
	if typeof(at) == "Vector3" then
		return at
	elseif typeof(at) == "CFrame" then
		return at.Position
	elseif typeof(at) == "Instance" then
		if at:IsA("BasePart") then
			return at.Position
		elseif at:IsA("Model") then
			return at:GetPivot().Position
		elseif at:IsA("Attachment") then
			return at.WorldPosition
		end
	end
	return nil
end
function UIKit.minimap(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local S = o.size or (UIKit.compact() and 200 or 250)
	local self = setmetatable(newBase(o, S, S + 24, UDim2.new(1, -40, 0, UIKit.safeTop() + 16), V2(1, 0), "Minimap"), Minimap)
	self.S, self.range = S, o.range or 300
	self.square = o.shape == "square"
	self.center = o.center
	self.follow = o.follow ~= false and o.center == nil
	local rad = self.square and UDim.new(0, math.max(t.radius, 4)) or UDim.new(1, 0)
	if t.shadow > 0 then
		local sh = mk("Frame", {
			BackgroundColor3 = t.c.ink,
			BackgroundTransparency = t.shadowT,
			Position = UDim2.fromOffset(0, t.shadow),
			Size = UDim2.fromOffset(S, S),
		}, self.body)
		corner(sh, rad)
	end
	local map = mk("Frame", { Name = "Map", BackgroundColor3 = WHITE, Size = UDim2.fromOffset(S, S), ClipsDescendants = true }, self.body)
	corner(map, rad)
	local mapColor = o.color or t.c.panelBottom:Lerp(t.c.accent2, 0.18)
	vgrad(map, lighten(mapColor, 0.08), darken(mapColor, 0.2))
	stroke(map, t.c.ink, math.max(2, t.stroke + 1), t.outlineT or 0, true)
	local ring = mk("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -10, 1, -10),
	}, map)
	corner(ring, rad)
	stroke(ring, t.c.rim, 2, 0.7, true)
	for i = 1, 3 do -- range rings / grid
		local g = mk("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = V2(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(i / 3, i / 3),
		}, map)
		corner(g, rad)
		stroke(g, t.c.text, 1, 0.88, true)
	end
	self.map = map
	self.geo = mk("Frame", { Name = "Geometry", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, map)
	self.markLayer = mk("Frame", { Name = "Markers", BackgroundTransparency = 1, Size = UDim2.fromOffset(S, S) }, self.body)
	self.parts = {}
	for _, p in collectParts(o.parts or {}, {}) do
		local f = mk("Frame", {
			BackgroundColor3 = (p.Color):Lerp(mapColor, 0.35),
			AnchorPoint = V2(0.5, 0.5),
		}, self.geo)
		stroke(f, darken(mapColor, 0.5), 1, 0.4, true)
		table.insert(self.parts, { part = p, f = f })
	end
	-- player arrow
	local me = mk("Frame", {
		Name = "Me",
		BackgroundTransparency = 1,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(30, 30),
	}, self.markLayer)
	local dot = mk("Frame", {
		BackgroundColor3 = WHITE,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
	}, me)
	corner(dot, UDim.new(1, 0))
	stroke(dot, t.c.ink, 3, 0, true)
	local nose = mk("Frame", {
		BackgroundColor3 = t.c.accent,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 2),
		Size = UDim2.fromOffset(12, 12),
		Rotation = 45,
	}, me)
	stroke(nose, t.c.ink, 2, 0, true)
	self.me = me
	text(self.body, t, {
		role = "heading",
		text = "N",
		textSize = 20,
		position = UDim2.new(0.5, 0, 0, -4),
		anchor = V2(0.5, 0.5),
		size = UDim2.fromOffset(30, 26),
		color = t.c.accent,
	})
	if o.label then
		text(self.body, t, {
			role = "heading",
			text = o.label,
			textSize = 16,
			color = t.c.textDim,
			position = UDim2.new(0.5, 0, 0, S + 4),
			anchor = V2(0.5, 0),
			size = UDim2.fromOffset(S, 20),
			stroke = 0,
		})
	end
	self.markers = {}
	local acc = 0
	self:on(RunService.Heartbeat, function(dt)
		acc += dt
		if acc < 1 / 20 then
			return
		end
		acc = 0
		self:_update()
	end)
	self:_update()
	return self:_enter()
end
function Minimap:_toMap(p: Vector3, c: Vector3)
	local s = (self.S * 0.5) / self.range
	return V2((p.X - c.X) * s, (p.Z - c.Z) * s)
end
function Minimap:_inside(v: Vector2, margin)
	local r = self.S * 0.5 - margin
	if self.square then
		return math.abs(v.X) <= r and math.abs(v.Y) <= r
	end
	return v.Magnitude <= r
end
function Minimap:_update()
	local char = Players.LocalPlayer and Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local c = (self.follow and hrp and hrp.Position) or self.center or Vector3.zero
	local half = self.S * 0.5
	local s = half / self.range
	for _, e in self.parts do
		local p = e.part
		if p.Parent then
			local v = self:_toMap(p.Position, c)
			local size = p.Size
			local inside = self:_inside(v, 0)
			e.f.Visible = inside
			if inside then
				local _, yaw = p.CFrame:ToOrientation()
				e.f.Position = UDim2.fromOffset(half + v.X, half + v.Y)
				e.f.Size = UDim2.fromOffset(math.max(2, size.X * s), math.max(2, size.Z * s))
				e.f.Rotation = -math.deg(yaw)
			end
		else
			e.f.Visible = false
		end
	end
	if hrp then
		local look = hrp.CFrame.LookVector
		local mv = self.follow and Vector2.zero or self:_toMap(hrp.Position, c)
		self.me.Position = UDim2.fromOffset(half + mv.X, half + mv.Y)
		self.me.Rotation = math.deg(math.atan2(look.X, -look.Z))
		self.me.Visible = self:_inside(mv, 6)
	end
	for _, m in self.markers do
		local wp = worldPos(m.at)
		if wp then
			local v = self:_toMap(wp, c)
			local edge = not self:_inside(v, 12)
			if edge then
				local r = half - 12
				v = self.square and V2(math.clamp(v.X, -r, r), math.clamp(v.Y, -r, r)) or v.Unit * r
			end
			m.f.Position = UDim2.fromOffset(half + v.X, half + v.Y)
			m.scale.Scale = (edge and 0.75 or 1) * (m.pulse and (1 + 0.15 * math.sin(os.clock() * 6)) or 1)
		end
	end
end
-- mark(id, {at = Vector3 | BasePart | Model, color, glyph, pulse}) / unmark(id)
function Minimap:mark(id, p)
	self:unmark(id)
	local t = self.t
	local f = mk("Frame", { BackgroundColor3 = WHITE, AnchorPoint = V2(0.5, 0.5), Size = UDim2.fromOffset(22, 22) }, self.markLayer)
	corner(f, t.name == "tactical" and UDim.new(0, 2) or UDim.new(1, 0))
	local c = p.color or t.c.bad
	vgrad(f, lighten(c, 0.3), c)
	stroke(f, t.c.ink, 2, 0, true)
	if p.glyph then
		text(f, t, { role = "heading", text = p.glyph, textSize = 14, color = WHITE, stroke = 1, shadow = 0 })
	end
	self.markers[id] = { at = p.at, f = f, scale = mk("UIScale", {}, f), pulse = p.pulse }
	return self
end
function Minimap:unmark(id)
	local m = self.markers[id]
	if m then
		m.f:Destroy()
		self.markers[id] = nil
	end
	return self
end
-- set({center, range, follow})
function Minimap:set(p)
	if p.center then
		self.center, self.follow = p.center, false
	end
	if p.follow ~= nil then
		self.follow = p.follow
	end
	self.range = p.range or self.range
	self:_update()
	return self
end

-- ── crosshair: dynamic spread, kick, hit markers ────────────────────────────
local Crosshair = class()
function UIKit.crosshair(o)
	o = o or {}
	local self = setmetatable(newBase(o, 240, 240, UDim2.fromScale(0.5, 0.5), V2(0.5, 0.5), "Crosshair"), Crosshair)
	self.style = o.style or "cross"
	self.gap0, self.maxSpread = o.gap or 8, o.spread or 40
	local len, th = o.length or 14, o.thickness or 3
	local color = o.color or WHITE
	self.arms = {}
	local function bar(parent, w, h)
		local f = mk("Frame", { BackgroundColor3 = color, AnchorPoint = V2(0.5, 0.5), Size = UDim2.fromOffset(w, h) }, parent)
		stroke(f, BLACK, 1, 0.35, true)
		return f
	end
	if self.style == "circle" then
		local c = mk("Frame", { BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) }, self.body)
		corner(c, UDim.new(1, 0))
		stroke(c, color, 2, 0, true)
		self.circle = c
	elseif self.style ~= "dot" then
		for i, d in { V2(0, -1), V2(1, 0), V2(0, 1), V2(-1, 0) } do
			if not (self.style == "tee" and i == 1) then
				local a = bar(self.body, d.X ~= 0 and len or th, d.Y ~= 0 and len or th)
				table.insert(self.arms, { f = a, d = d, len = len })
			end
		end
	end
	local dot = bar(self.body, 4, 4)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	corner(dot, UDim.new(1, 0))
	-- hit marker: an X of four short bars
	local hit = mk("Frame", {
		Name = "Hit",
		BackgroundTransparency = 1,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(60, 60),
		Rotation = 45,
		Visible = false,
	}, self.body)
	self.hitBars = {}
	for _, d in { V2(0, -1), V2(1, 0), V2(0, 1), V2(-1, 0) } do
		local b = mk("Frame", {
			BackgroundColor3 = WHITE,
			AnchorPoint = V2(0.5, 0.5),
			Position = UDim2.new(0.5, d.X * 16, 0.5, d.Y * 16),
			Size = UDim2.fromOffset(d.X ~= 0 and 12 or 3, d.Y ~= 0 and 12 or 3),
		}, hit)
		stroke(b, BLACK, 1, 0.3, true)
		table.insert(self.hitBars, b)
	end
	self.hitScale = mk("UIScale", {}, hit)
	noFade(hit)
	self.hitFrame = hit
	self.gapS = self:spring(self.gap0, 28, 0.8, function(g)
		for _, a in self.arms do
			local off = g + a.len * 0.5
			a.f.Position = UDim2.new(0.5, a.d.X * off, 0.5, a.d.Y * off)
		end
		if self.circle then
			self.circle.Size = UDim2.fromOffset(g * 2 + 12, g * 2 + 12)
		end
	end)
	return self:_enter()
end
-- set({spread = 0..1, color})
function Crosshair:set(p)
	if type(p) == "number" then
		p = { spread = p }
	end
	if p.spread then
		self.gapS:to(self.gap0 + p.spread * self.maxSpread)
	end
	if p.color then
		for _, a in self.arms do
			a.f.BackgroundColor3 = p.color
		end
	end
	return self
end
-- kick(amount = 1): momentary bloom when firing.
function Crosshair:kick(amount)
	self.gapS:kick(260 * (amount or 1))
	return self
end
-- hit("hit" | "kill" | "headshot")
function Crosshair:hit(kind)
	local t = self.t
	kind = kind or "hit"
	local c = kind == "kill" and t.c.bad or kind == "headshot" and t.c.warn or WHITE
	for _, b in self.hitBars do
		b.BackgroundColor3 = c
		b.BackgroundTransparency = 0
	end
	self.hitFrame.Visible = true
	self.hitScale.Scale = kind == "hit" and 1.5 or 2
	tw(self.hitScale, { Scale = kind == "hit" and 1 or 1.3 }, 0.12, Enum.EasingStyle.Back)
	local hold = kind == "hit" and 0.08 or 0.3
	for _, b in self.hitBars do
		tw(b, { BackgroundTransparency = 1 }, 0.22, Enum.EasingStyle.Quad, nil, hold)
	end
	sfx(kind == "hit" and "hit" or "kill", self)
	return self
end

-- ── ammo: magazine pips, reserve, reload state ──────────────────────────────
local Ammo = class()
function UIKit.ammo(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local w, h = 400, 150
	local self = setmetatable(newBase(o, w, h, UDim2.new(1, -40, 1, -40), V2(1, 1), "Ammo"), Ammo)
	self.magSize = o.magSize or 30
	self.mag = o.mag or self.magSize
	self.reserve = o.reserve or 90
	local panel = plate(self.body, t, { size = V2(w, 96), position = UDim2.fromOffset(0, 54), deco = true })
	local name = plate(self.body, t, { size = V2(220, 40), position = UDim2.fromOffset(w - 230, 6), fill = t.c.accent, shadow = 0 })
	name.root.Rotation = t.tilt * 0.5
	self.nameText = text(name.root, t, {
		role = "heading",
		text = o.weapon or "RIFLE",
		textSize = 22,
		color = t.c.onAccent or WHITE,
	})
	local holder = mk("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(w - 200, 54), Size = UDim2.fromOffset(120, 96) }, self.body)
	self.magScale = mk("UIScale", {}, holder)
	self.magPop = self:spring(1, 30, 0.45, function(v)
		self.magScale.Scale = v
	end)
	self.magText = text(holder, t, {
		role = "numeric",
		text = tostring(self.mag),
		textSize = 72,
		x = Enum.TextXAlignment.Right,
	})
	self.resText = text(panel.root, t, {
		role = "numeric",
		text = "/ " .. self.reserve,
		textSize = 30,
		color = t.c.textDim,
		x = Enum.TextXAlignment.Left,
		position = UDim2.fromOffset(w - 72, 16),
		size = UDim2.fromOffset(70, 60),
		stroke = math.min(2, t.textStroke),
		shadow = 0,
	})
	self.pips = {}
	local n = math.min(self.magSize, 30)
	self.pipN = n
	local pipArea = w - 230
	local pw = math.clamp(math.floor(pipArea / n) - 3, 3, 10)
	for i = 1, n do
		local p = mk("Frame", {
			BackgroundColor3 = t.c.text,
			AnchorPoint = V2(0, 1),
			Position = UDim2.fromOffset(18 + (i - 1) * (pw + 3), 76),
			Size = UDim2.fromOffset(pw, 36),
			Rotation = t.skew > 0 and 12 or 0,
		}, panel.root)
		corner(p, t.name == "tactical" and 0 or 2)
		stroke(p, t.c.ink, 1, t.outlineT or 0.2, true)
		self.pips[i] = p
	end
	self.reloadBar = UIKit.bar({
		parent = self.body,
		theme = t,
		width = pipArea - 10,
		height = 14,
		value = 0,
		max = 1,
		showText = false,
		color = t.c.accent2,
		pulseLow = false,
		position = UDim2.fromOffset(14, 150),
		anchor = V2(0, 0),
	})
	self.reloadBar:hide(true)
	self.status = text(self.body, t, {
		role = "heading",
		text = "",
		textSize = 22,
		color = t.c.bad,
		position = UDim2.fromOffset(0, 14),
		size = UDim2.fromOffset(w - 240, 30),
		x = Enum.TextXAlignment.Left,
	})
	self:on(RunService.Heartbeat, function()
		if self.mag == 0 and not self.reloading then
			self.status.holder.Visible = math.sin(os.clock() * 8) > -0.3
		end
	end)
	self:set(self.mag, self.reserve, true)
	return self:_enter()
end
-- set(mag, reserve?): spent pips flick out; low ammo warns, empty blinks RELOAD.
function Ammo:set(mag, reserve, silent)
	local t = self.t
	local prev = self.mag
	self.mag, self.reserve = mag, reserve or self.reserve
	self.magText:set(tostring(mag))
	self.resText:set("/ " .. tostring(self.reserve))
	local frac = mag / self.magSize
	self.magText:color(mag == 0 and t.c.bad or frac <= 0.3 and t.c.warn or t.c.text)
	local lit = math.ceil(frac * self.pipN)
	for i, p in self.pips do
		local on = i <= lit
		if not on and p:GetAttribute("On") ~= false and not silent then
			local ghost = p:Clone()
			ghost.Parent = p.Parent
			noFade(ghost)
			tw(ghost, { Position = p.Position + UDim2.fromOffset(6, -26), BackgroundTransparency = 1, Rotation = 40 }, 0.3)
			local gs = ghost:FindFirstChildOfClass("UIStroke")
			if gs then
				tw(gs, { Transparency = 1 }, 0.3)
			end
			task.delay(0.32, function()
				ghost:Destroy()
			end)
		end
		p:SetAttribute("On", on)
		p.BackgroundColor3 = on and (frac <= 0.3 and t.c.warn or t.c.text) or t.c.track
	end
	self.status:set(mag == 0 and "RELOAD" or (frac <= 0.3 and "LOW AMMO" or ""))
	self.status:color(mag == 0 and t.c.bad or t.c.warn)
	self.status.holder.Visible = true
	if not silent and mag ~= prev then
		self.magPop.s.Position = mag < prev and 1.12 or 1.3
		self.magPop:to(1)
	end
	return self
end
-- reload(seconds, onDone?): fills a reload bar; the game sets the new counts in onDone.
function Ammo:reload(seconds, onDone)
	seconds = seconds or 1.6
	self.reloading = true
	self.status:set("RELOADING")
	self.status:color(self.t.c.accent2)
	self.status.holder.Visible = true
	self.reloadBar:show()
	self.reloadBar.fillS:snap(0)
	self.reloadBar.trailS:snap(0)
	self.reloadBar.fillS.s.Speed = 6
	self.reloadBar.fillS:to(1)
	sfx("reload", self)
	self:later(seconds, function()
		self.reloading = false
		self.reloadBar:hide()
		if onDone then
			onDone()
		end
	end)
	return self
end

-- ── toasts: stacked notifications that slide in, push down, and time out ────
local Toasts = class()
function UIKit.toasts(o)
	o = o or {}
	local self = setmetatable(newBase(o, 420, 600, UDim2.new(1, -40, 0, UIKit.safeTop() + 330), V2(1, 0), "Toasts"), Toasts)
	self.items = {}
	self.max = o.max or 5
	return self:_enter()
end
function Toasts:_reflow()
	local y = 0
	for _, it in self.items do
		it.yS:to(y)
		y += it.h + 10
	end
end
-- push(text, {body, kind = "info"|"good"|"warn"|"bad"|"reward", icon, glyph, duration = 3}) -> toast {dismiss()}
function Toasts:push(s, p)
	p = p or {}
	local t = self.t
	local kind = p.kind or "info"
	local color = p.color or ({ info = t.c.accent2, good = t.c.good, warn = t.c.warn, bad = t.c.bad, reward = t.c.gold })[kind] or t.c.accent2
	local h = p.body and 84 or 64
	local holder = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(400, h) }, self.body)
	local pl = plate(holder, t, { size = V2(400, h) })
	local stripe = plate(pl.root, t, {
		size = V2(14 + pl.skewPx, h),
		fill = color,
		stroke = 0,
		shadow = 0,
		rim = 0,
		radius = t.radius,
	})
	stripe.root.Position = UDim2.fromOffset(0, 0)
	local isz = 44
	iconDisc(pl.root, t, {
		size = isz,
		image = p.icon,
		glyph = p.glyph or ({ info = "i", good = "+", warn = "!", bad = "!", reward = "*" })[kind] or "i",
		color = color,
		position = UDim2.new(0, 26 + pl.skewPx * 0.5, 0.5, 0),
		anchor = V2(0, 0.5),
	})
	local tx = 26 + isz + 12 + pl.skewPx * 0.5
	text(pl.root, t, {
		role = "heading",
		text = s,
		textSize = 22,
		x = Enum.TextXAlignment.Left,
		position = UDim2.fromOffset(tx, p.body and 10 or 0),
		size = UDim2.new(1, -tx - 14, 0, p.body and 30 or h),
		truncate = true,
		stroke = math.min(2, t.textStroke),
		shadow = 2,
	})
	if p.body then
		text(pl.root, t, {
			role = "body",
			text = p.body,
			textSize = 18,
			color = t.c.textDim,
			x = Enum.TextXAlignment.Left,
			position = UDim2.fromOffset(tx, 42),
			size = UDim2.new(1, -tx - 14, 0, 26),
			truncate = true,
		})
	end
	local timeBar = mk("Frame", {
		Name = "Time",
		BackgroundColor3 = color,
		Position = UDim2.new(0, 14 + pl.skewPx, 1, -6),
		Size = UDim2.new(1, -40 - pl.skewPx, 0, 3),
	}, pl.root)
	local it: any = { holder = holder, h = h }
	it.xS = self:spring(460, 24, 0.7, function(v)
		holder.Position = UDim2.fromOffset(v, holder.Position.Y.Offset)
	end)
	it.yS = self:spring(0, 22, 0.8, function(v)
		holder.Position = UDim2.fromOffset(holder.Position.X.Offset, v)
	end)
	table.insert(self.items, 1, it)
	it.yS:snap(0)
	it.xS:to(0)
	self:_reflow()
	local dur = p.duration or 3
	tw(timeBar, { Size = UDim2.new(0, 0, 0, 3) }, dur, Enum.EasingStyle.Linear)
	function it.dismiss()
		if it.gone then
			return
		end
		it.gone = true
		it.xS:to(480)
		task.delay(0.35, function()
			local idx = table.find(self.items, it)
			if idx then
				table.remove(self.items, idx)
			end
			holder:Destroy()
			if not self._dead then
				self:_reflow()
			end
		end)
	end
	task.delay(dur, it.dismiss)
	while #self.items > self.max do
		local last = self.items[#self.items]
		table.remove(self.items, #self.items)
		last.gone = true
		last.holder:Destroy()
	end
	sfx("toast", self)
	return it
end
Toasts.set = Toasts.push
local defaultToasts
-- UIKit.toast(text, opts): push onto a shared stack.
function UIKit.toast(s, p)
	if not defaultToasts or defaultToasts._dead then
		defaultToasts = UIKit.toasts({ theme = p and p.theme })
	end
	return defaultToasts:push(s, p)
end

-- ── dialog: speaker plate, portrait, typewriter text, choices ────────────────
local Dialog = class()
function UIKit.dialog(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local compact = UIKit.compact()
	local w = o.width or (compact and math.min(1100, Screen.canvas().X - 60) or 1100)
	local h = 220
	local self = setmetatable(newBase(o, w, h + 60, UDim2.new(0.5, 0, 1, -30), V2(0.5, 1), "Dialog"), Dialog)
	self.w, self.h = w, h
	local panel = plate(self.body, t, { size = V2(w, h), position = UDim2.fromOffset(0, 60), deco = true })
	self.panel = panel
	local ps = 170
	self.portraitHolder = mk("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(28, 0), Size = UDim2.fromOffset(ps, ps) }, self.body)
	self.namePlateHolder = mk("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(ps + 40, 26), Size = UDim2.fromOffset(320, 52) }, self.body)
	self.body_ = text(panel.root, t, {
		role = "body",
		text = "",
		textSize = 28,
		wrap = true,
		x = Enum.TextXAlignment.Left,
		y = Enum.TextYAlignment.Top,
		position = UDim2.fromOffset(ps + 50 + panel.skewPx * 0.3, 34),
		size = UDim2.new(1, -ps - 100, 1, -60),
		shadow = t.textShadow > 0 and 2 or 0,
	})
	local more = mk("Frame", {
		BackgroundColor3 = t.c.accent,
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.new(1, -40 - panel.skewPx * 0.2, 1, -30),
		Size = UDim2.fromOffset(16, 16),
		Rotation = 45,
	}, panel.root)
	stroke(more, t.c.ink, 2, 0, true)
	self.more = more
	local hit = mk("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), AutoButtonColor = false }, panel.root)
	self:on(hit.Activated, function()
		self:skip()
	end)
	self.choiceButtons = {}
	self:on(RunService.Heartbeat, function()
		more.Visible = not self.typing and self.text ~= nil and #self.choiceButtons == 0
		more.Position = UDim2.new(1, -40 - panel.skewPx * 0.2, 1, -30 + math.sin(os.clock() * 6) * 4)
	end)
	if o.speaker or o.text then
		self:say(o.speaker, o.text or "", o)
	end
	return self:_enter()
end
-- say(speaker, text, {choices = {"Yes", "No"}, onChoice(i, label), onNext(), portrait, color, speed = 45})
function Dialog:say(speaker, s, p)
	p = p or {}
	local t = self.t
	self._ver += 1
	for _, b in self.choiceButtons do
		b:Destroy()
	end
	self.choiceButtons = {}
	self.p = p
	local color = p.color or t.c.accent
	for _, c in self.portraitHolder:GetChildren() do
		c:Destroy()
	end
	for _, c in self.namePlateHolder:GetChildren() do
		c:Destroy()
	end
	local ps = self.portraitHolder.Size.X.Offset
	local frame = plate(self.portraitHolder, t, { size = V2(ps, ps), fill = color, skew = 0, radius = t.radius > 0 and math.max(t.radius, 14) or 0 })
	frame.root.Rotation = t.tilt * 0.6
	local img = resolveImage(p.portrait)
	if img ~= "" then
		mk("ImageLabel", {
			BackgroundTransparency = 1,
			Image = img,
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.new(1, -16, 1, -16),
			ScaleType = Enum.ScaleType.Crop,
		}, frame.root)
	else
		text(frame.root, t, { role = "display", text = string.sub(speaker or "?", 1, 1), textSize = 96, color = WHITE })
	end
	if speaker and speaker ~= "" then
		local np = plate(self.namePlateHolder, t, { size = V2(300, 50), fill = color })
		np.root.Rotation = t.tilt * 0.5
		text(np.root, t, { role = "heading", text = speaker, textSize = 28, color = WHITE })
		local s2 = mk("UIScale", { Scale = 0.6 }, np.root)
		tw(s2, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
	end
	self.text = s
	self.body_:set(s)
	local lab = self.body_.label
	local shadow = self.body_.shadow
	local n = utf8.len(s) or #s
	lab.MaxVisibleGraphemes = 0
	if shadow then
		shadow.MaxVisibleGraphemes = 0
	end
	self.typing = true
	local speed = p.speed or 45
	local ver = self._ver
	task.spawn(function()
		local shown = 0
		while shown < n and self._ver == ver and not self._dead do
			shown += 1
			lab.MaxVisibleGraphemes = shown
			if shadow then
				shadow.MaxVisibleGraphemes = shown
			end
			if shown % 3 == 0 then
				sfx("type", self)
			end
			local ch = string.sub(s, shown, shown)
			task.wait((ch == "." or ch == "!" or ch == "?" or ch == ",") and 6 / speed or 1 / speed)
		end
		if self._ver == ver and not self._dead then
			self:_finish()
		end
	end)
	return self
end
Dialog.set = Dialog.say
function Dialog:_finish()
	if not self.typing then
		return
	end
	self.typing = false
	self.body_.label.MaxVisibleGraphemes = -1
	if self.body_.shadow then
		self.body_.shadow.MaxVisibleGraphemes = -1
	end
	local p = self.p or {}
	if p.choices then
		local n = #p.choices
		for i, label in p.choices do
			local b = UIKit.button({
				parent = self.body,
				theme = self.t,
				text = label,
				kind = i == 1 and "primary" or "neutral",
				size = V2(340, 58),
				position = UDim2.new(1, -20, 0, 50 - (n - i + 1) * 74),
				anchor = V2(1, 0),
				onClick = function()
					if p.onChoice then
						p.onChoice(i, label)
					end
				end,
			})
			b._pop:snap(0.3)
			b._slide:snap(30)
			task.delay(0.06 * i, function()
				b._pop:to(1)
				b._slide:to(0)
			end)
			table.insert(self.choiceButtons, b)
		end
	end
end
-- skip(): finishes the line, or (when finished) calls onNext.
function Dialog:skip()
	if self.typing then
		self:_finish()
	elseif self.p and self.p.onNext and #self.choiceButtons == 0 then
		self.p.onNext()
	end
	return self
end
function Dialog:onDestroy()
	for _, b in self.choiceButtons do
		b:Destroy()
	end
end

-- ── prompt hint: key cap + label (screen or world-anchored) ─────────────────
local Prompt = class()
function UIKit.prompt(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local bb
	if o.adornee then
		bb = mk("BillboardGui", {
			Name = "UIKitPrompt",
			Adornee = o.adornee,
			AlwaysOnTop = true,
			LightInfluence = 0,
			ResetOnSpawn = false,
			Size = UDim2.fromOffset(420 * Screen.scale(), 110 * Screen.scale()),
			StudsOffset = o.offset or Vector3.new(0, 3, 0),
			MaxDistance = o.maxDistance or 40,
		}, Players.LocalPlayer:WaitForChild("PlayerGui"))
		mk("UIScale", { Scale = Screen.scale() }, bb)
		o.parent = bb
		o.position = o.position or UDim2.fromScale(0.5, 0.5)
	end
	local self = setmetatable(newBase(o, 420, 90, UDim2.fromScale(0.5, 0.7), V2(0.5, 0.5), "Prompt"), Prompt)
	self.billboard = bb
	local ks = 64
	local lip = 6
	local capHolder = mk("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 10), Size = UDim2.fromOffset(ks, ks + lip) }, self.body)
	plate(capHolder, t, { size = V2(ks, ks), position = UDim2.fromOffset(0, lip), fill = darken(t.c.raisedBottom, 0.45), skew = 0, gloss = 0, rim = 0 })
	local face = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(ks, ks) }, capHolder)
	plate(face, t, { size = V2(ks, ks), top = lighten(t.c.raisedTop, 0.25), bottom = t.c.raisedBottom, skew = 0, shadow = 0 })
	self.face = face
	self.key = text(face, t, { role = "heading", text = o.key or "E", textSize = 32 })
	self.capPress = self:spring(0, 34, 0.5, function(v)
		face.Position = UDim2.fromOffset(0, v)
	end)
	local lab = plate(self.body, t, { size = V2(300, 50), position = UDim2.fromOffset(ks + 4, 17), transparency = math.max(t.panelT, 0.1) })
	self.label = text(lab.root, t, {
		role = "heading",
		text = o.label or "Interact",
		textSize = 24,
		x = Enum.TextXAlignment.Left,
		position = UDim2.fromOffset(16 + lab.skewPx * 0.5, 0),
		size = UDim2.new(1, -24, 1, 0),
	})
	self.holdBar = mk("Frame", {
		BackgroundColor3 = t.c.accent,
		Position = UDim2.new(0, 10 + lab.skewPx * 0.5, 1, -7),
		Size = UDim2.fromOffset(0, 4),
	}, lab.root)
	self.holdW = 300 - 30 - lab.skewPx
	return self:_enter()
end
function Prompt:set(key, label)
	if key then
		self.key:set(key)
	end
	if label then
		self.label:set(label)
	end
	return self
end
-- progress(0..1) for hold-to-interact; press() squishes the key cap.
function Prompt:progress(p)
	self.holdBar.Size = UDim2.fromOffset(self.holdW * math.clamp(p, 0, 1), 4)
	return self
end
function Prompt:press()
	self.capPress.s.Position = 6
	self.capPress:to(0)
	sfx("click", self)
	return self
end
function Prompt:onDestroy()
	if self.billboard then
		self.billboard:Destroy()
	end
end

-- ── panel: menu screen with title plate, tabs, close X, backdrop ────────────
local Panel = class()
function UIKit.panel(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local size = o.size or V2(960, 620)
	local backdrop = o.backdrop ~= false
	local self
	if backdrop then
		self = setmetatable(newBase(o, 0, 0, UDim2.fromScale(0.5, 0.5), V2(0.5, 0.5), "Panel"), Panel)
		self.root.Size = UDim2.fromScale(1, 1)
		self.root.Position = UDim2.fromScale(0.5, 0.5)
		self.body.Size = UDim2.fromOffset(size.X, size.Y)
		local dim = mk("Frame", { Name = "Backdrop", BackgroundColor3 = t.c.backdrop, BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1), ZIndex = 0 }, self.root)
		mk("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.2, 0.55) }, dim)
		for i = -8, 30 do -- diagonal stripe pattern
			mk("Frame", {
				BackgroundColor3 = t.c.accent,
				BackgroundTransparency = 0.94,
				AnchorPoint = V2(0.5, 0.5),
				Position = UDim2.new(0, i * 90, 0.5, 0),
				Size = UDim2.new(0, 26, 2, 0),
				Rotation = 30,
				ZIndex = 0,
			}, dim)
		end
		self.body.ZIndex = 1
	else
		self = setmetatable(newBase(o, size.X, size.Y, UDim2.fromScale(0.5, 0.5), V2(0.5, 0.5), "Panel"), Panel)
	end
	self.popFrom = 0.85
	local P = plate(self.body, t, { size = size, skew = 0, deco = true, radius = t.radius > 0 and t.radius + 6 or 0 })
	P.root.Size = UDim2.fromScale(1, 1)
	local titleW = math.max(260, #(o.title or "MENU") * 26 + 80)
	local title = plate(self.body, t, { size = V2(titleW, 64), fill = t.c.accent, position = UDim2.fromOffset(-14, -30) })
	title.root.Rotation = t.tilt
	text(title.root, t, {
		role = "display",
		text = o.title or "MENU",
		textSize = 40,
		gradient = ColorSequence.new(WHITE, lighten(t.c.accent, 0.6)),
		position = UDim2.fromOffset(title.skewPx * 0.5, 0),
	})
	-- close X overlapping the corner
	if o.onClose ~= false then
		local close = UIKit.button({
			parent = self.body,
			theme = t,
			text = "",
			kind = "danger",
			size = V2(64, 58),
			position = UDim2.new(1, 18, 0, -22),
			anchor = V2(1, 0),
			onClick = function()
				if o.onClose then
					o.onClose(self)
				else
					self:hide()
				end
			end,
		})
		local x = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Rotation = 45 }, close.faceHolder)
		for _, sz in { UDim2.fromOffset(30, 8), UDim2.fromOffset(8, 30) } do
			local b = mk("Frame", { BackgroundColor3 = WHITE, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = sz }, x)
			stroke(b, t.c.ink, 2, 0, true)
		end
		self.close = close
	end
	local top = 52
	self.pages = {}
	self.tabs = {}
	if o.tabs and #o.tabs > 0 then
		local tw_ = math.min(220, (size.X - 80) / #o.tabs - 10)
		for i, name in o.tabs do
			local b = UIKit.button({
				parent = self.body,
				theme = t,
				text = name,
				kind = "neutral",
				size = V2(tw_, 50),
				textSize = 22,
				position = UDim2.fromOffset(40 + (i - 1) * (tw_ + 10), top),
				anchor = V2(0, 0),
				onClick = function()
					self:select(name)
				end,
			})
			self.tabs[name] = b
		end
		self.ind = mk("Frame", { BackgroundColor3 = t.c.accent, Size = UDim2.fromOffset(tw_ - 20, 5), Position = UDim2.fromOffset(50, top + 62) }, self.body)
		corner(self.ind, 3)
		self.indX = self:spring(50, 26, 0.75, function(v)
			self.ind.Position = UDim2.fromOffset(v, top + 62)
		end)
		self.tabW = tw_
		top += 80
	end
	self.content = mk("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(32, top + 8),
		Size = UDim2.new(1, -64, 1, -top - 36),
	}, self.body)
	for _, name in o.tabs or {} do
		self.pages[name] = mk("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, self.content)
	end
	self.onTab = o.onTab
	if o.tabs and o.tabs[1] then
		self:select(o.tab or o.tabs[1], true)
	end
	return self:_enter()
end
-- select(tab): raises the tab, slides the indicator, swaps the page.
function Panel:select(name, instant)
	local t = self.t
	if not self.pages[name] then
		return self
	end
	local idx = 0
	for i, n in self.o.tabs do
		if n == name then
			idx = i
		end
		self.tabs[n]:set({ color = n == name and t.c.accent or t.c.raisedTop })
		self.pages[n].Visible = n == name
	end
	local x = 40 + (idx - 1) * (self.tabW + 10) + 10
	if instant then
		self.indX:snap(x)
	else
		self.indX:to(x)
		local page = self.pages[name]
		page.Position = UDim2.fromOffset(24, 0)
		tw(page, { Position = UDim2.fromOffset(0, 0) }, 0.25)
		self.tabs[name]:punch(0.12)
	end
	self.tab = name
	if self.onTab and not instant then
		task.spawn(self.onTab, name)
	end
	return self
end
function Panel:set(p)
	if p.tab then
		self:select(p.tab)
	end
	return self
end

-- ── grid / hotbar: slots with rarity, counts, selection ─────────────────────
local Grid = class()
function UIKit.grid(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local cols = o.columns or 5
	local items = o.items or {}
	local rows = o.rows or math.max(1, math.ceil(math.max(#items, o.slots or 0) / cols))
	local slot = o.slot or (o.hotbar and (UIKit.compact() and 80 or 92) or 100)
	local gap = o.gap or 12
	local w, h = cols * slot + (cols - 1) * gap, rows * slot + (rows - 1) * gap
	local self = setmetatable(newBase(o, w + 20, h + 20, UDim2.fromScale(0.5, 0.5), V2(0.5, 0.5), o.hotbar and "Hotbar" or "Grid"), Grid)
	self.cols, self.rows, self.slotSize, self.gap = cols, rows, slot, gap
	self.slots = {}
	self.onSelect = o.onSelect
	self.hotbar = o.hotbar
	local sel = mk("Frame", { Name = "Selector", BackgroundTransparency = 1, Size = UDim2.fromOffset(slot + 14, slot + 14), AnchorPoint = V2(0.5, 0.5), ZIndex = 3 }, self.body)
	corner(sel, t.radius > 0 and t.radius + 6 or 0)
	stroke(sel, t.c.accent, 4, 0, true)
	local selGlow = stroke(mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 8, 1, 8), Position = UDim2.fromOffset(-4, -4) }, sel), t.c.accent, 3, 0.6, true)
	corner(selGlow.Parent, t.radius > 0 and t.radius + 10 or 0)
	sel.Visible = false
	self.sel = sel
	self.selX = self:spring(0, 30, 0.7, function(v)
		sel.Position = UDim2.fromOffset(v, sel.Position.Y.Offset)
	end)
	self.selY = self:spring(0, 30, 0.7, function(v)
		sel.Position = UDim2.fromOffset(sel.Position.X.Offset, v)
	end)
	for i = 1, cols * rows do
		self:_slot(i)
	end
	self:set(items)
	if o.hotbar and o.bindKeys ~= false then
		local keys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
			Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine }
		self:on(UserInputService.InputBegan, function(input, processed)
			if processed then
				return
			end
			local idx = table.find(keys, input.KeyCode)
			if idx and idx <= #self.slots then
				self:select(idx, true)
			end
		end)
	end
	if o.selected then
		self:select(o.selected)
	end
	return self:_enter()
end
function Grid:_slot(i)
	local s, gap = self.slotSize, self.gap
	local c, r = (i - 1) % self.cols, math.floor((i - 1) / self.cols)
	local cx, cy = 10 + c * (s + gap) + s / 2, 10 + r * (s + gap) + s / 2
	local holder = mk("Frame", { BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(s, s) }, self.body)
	local scale = mk("UIScale", {}, holder)
	local slot: any = { holder = holder, cx = cx, cy = cy }
	slot.pop = self:spring(1, 28, 0.5, function(v)
		scale.Scale = v
	end)
	local hit = mk("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), AutoButtonColor = false, ZIndex = 4 }, holder)
	self:on(hit.Activated, function()
		self:select(i, true)
	end)
	self:on(hit.MouseEnter, function()
		if self.selected ~= i then
			slot.pop:to(1.05)
		end
	end)
	self:on(hit.MouseLeave, function()
		if self.selected ~= i then
			slot.pop:to(1)
		end
	end)
	self.slots[i] = slot
	return slot
end
function Grid:_fill(i, item)
	local t = self.t
	local slot = self.slots[i]
	if not slot then
		return
	end
	if slot.content then
		slot.content:Destroy()
	end
	local s = self.slotSize
	local content = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, slot.holder)
	slot.content = content
	slot.item = item
	local rc = item and rarityColor(t, item.rarity) or nil
	plate(content, t, {
		size = V2(s, s),
		skew = 0,
		top = item and t.c.raisedTop:Lerp(rc, 0.25) or t.c.track,
		bottom = item and t.c.panelBottom:Lerp(rc, 0.55) or lighten(t.c.track, 0.06),
		outline = item and darken(rc, 0.55) or t.c.ink,
		shadow = item and t.shadow or 0,
		radius = t.radius > 0 and math.min(t.radius, 16) or 0,
		transparency = item and t.panelT or math.max(t.panelT, 0.25),
		gloss = item and t.gloss or 0,
	})
	if item then
		local strip = mk("Frame", { BackgroundColor3 = rc, AnchorPoint = V2(0.5, 1), Position = UDim2.new(0.5, 0, 1, -5), Size = UDim2.new(1, -14, 0, 5) }, content)
		corner(strip, 3)
		local img = resolveImage(item.icon)
		if img ~= "" then
			mk("ImageLabel", {
				BackgroundTransparency = 1,
				Image = img,
				AnchorPoint = V2(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.47),
				Size = UDim2.fromScale(0.72, 0.72),
				ScaleType = Enum.ScaleType.Fit,
			}, content)
		else
			text(content, t, {
				role = "display",
				text = item.glyph or string.sub(item.name or "?", 1, 2),
				textSize = math.floor(s * 0.36),
				color = WHITE,
				gradient = ColorSequence.new(WHITE, lighten(rc, 0.4)),
				position = UDim2.fromScale(0.5, 0.45),
				anchor = V2(0.5, 0.5),
				size = UDim2.fromScale(1, 0.6),
				stroke = math.max(2, t.textStroke - 1),
				shadow = 3,
			})
		end
		if item.count and item.count ~= 1 then
			slot.countText = text(content, t, {
				role = "numeric",
				text = "x" .. fmtNum(item.count),
				textSize = math.floor(s * 0.22),
				x = Enum.TextXAlignment.Right,
				y = Enum.TextYAlignment.Bottom,
				position = UDim2.fromOffset(-8, -10),
				size = UDim2.fromScale(1, 1),
				stroke = 2,
				shadow = 0,
			})
		end
	end
	if self.hotbar then
		text(content, t, {
			role = "numeric",
			text = tostring(i),
			textSize = math.floor(s * 0.2),
			color = t.c.textDim,
			x = Enum.TextXAlignment.Left,
			y = Enum.TextYAlignment.Top,
			position = UDim2.fromOffset(8, 6),
			size = UDim2.fromOffset(30, 24),
			stroke = 2,
			shadow = 0,
		})
	end
end
-- set(items): items = {{name, icon?, glyph?, count?, rarity = "common".."mythic" | Color3}}
function Grid:set(items)
	for i = 1, #self.slots do
		self:_fill(i, items[i])
	end
	return self
end
function Grid:setItem(i, item)
	self:_fill(i, item)
	local slot = self.slots[i]
	if slot then
		slot.pop.s.Position = 1.25
		slot.pop:to(self.selected == i and 1.1 or 1)
	end
	return self
end
-- select(index, fromInput?): selector springs over, slot lifts.
function Grid:select(i, fromInput)
	local slot = self.slots[i]
	if not slot then
		return self
	end
	local prev = self.slots[self.selected or 0]
	if prev and self.selected ~= i then
		prev.pop:to(1)
	end
	self.selected = i
	local first = not self.sel.Visible
	self.sel.Visible = true
	if first then
		self.selX:snap(slot.cx)
		self.selY:snap(slot.cy)
	else
		self.selX:to(slot.cx)
		self.selY:to(slot.cy)
	end
	slot.pop.s.Position = 1.2
	slot.pop:to(1.1)
	sfx("click", self)
	if fromInput and self.onSelect then
		task.spawn(self.onSelect, i, slot.item)
	end
	return self
end
function UIKit.hotbar(o)
	o = o or {}
	o.hotbar = true
	o.columns = o.columns or math.max(#(o.items or {}), o.slots or 6)
	o.rows = 1
	o.position = o.position or UDim2.new(0.5, 0, 1, -24)
	o.anchor = o.anchor or V2(0.5, 1)
	o.selected = o.selected or 1
	return UIKit.grid(o)
end

-- ── shop card: art window, rarity, ribbon badge, price button ───────────────
local Card = class()
function UIKit.shopCard(o)
	o = o or {}
	local t = o.theme or UIKit.current
	local w, h = 270, 380
	local self = setmetatable(newBase(o, w, h, UDim2.fromScale(0.5, 0.5), V2(0.5, 0.5), "ShopCard"), Card)
	local rc = rarityColor(t, o.rarity)
	self.rc = rc
	plate(self.body, t, { size = V2(w, h), skew = 0, top = t.c.raisedTop, bottom = t.c.panelBottom, radius = t.radius > 0 and t.radius + 4 or 0 })
	local art = plate(self.body, t, {
		size = V2(w - 24, 220),
		position = UDim2.fromOffset(12, 12),
		skew = 0,
		top = lighten(rc, 0.15),
		bottom = darken(rc, 0.45),
		shadow = 0,
		stroke = math.max(2, t.stroke - 1),
		radius = t.radius,
	})
	for i, tr in { 0.55, 0.72, 0.85 } do -- radial glow from stacked discs
		local g = mk("Frame", {
			BackgroundColor3 = lighten(rc, 0.6),
			BackgroundTransparency = tr,
			AnchorPoint = V2(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(70 + i * 45, 70 + i * 45),
		}, art.root)
		corner(g, UDim.new(1, 0))
	end
	local img = resolveImage(o.icon)
	local artHolder = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, art.root)
	self.artScale = mk("UIScale", {}, artHolder)
	if img ~= "" then
		mk("ImageLabel", {
			BackgroundTransparency = 1,
			Image = img,
			AnchorPoint = V2(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.52),
			Size = UDim2.fromScale(0.85, 0.85),
			ScaleType = Enum.ScaleType.Fit,
		}, artHolder)
	else
		text(artHolder, t, {
			role = "display",
			text = o.glyph or string.sub(o.name or "?", 1, 1),
			textSize = 120,
			gradient = ColorSequence.new(WHITE, lighten(rc, 0.5)),
			position = UDim2.fromScale(0.5, 0.52),
			anchor = V2(0.5, 0.5),
			size = UDim2.fromScale(1, 0.8),
		})
	end
	local rplate = plate(art.root, t, { size = V2(120, 28), fill = rc, shadow = 0, position = UDim2.fromOffset(10, 10), stroke = 2 })
	text(rplate.root, t, { role = "heading", text = o.rarity and tostring(o.rarity) or "common", textSize = 15, color = WHITE, stroke = 2, shadow = 0 })
	if o.badge then
		local b = plate(self.body, t, { size = V2(120, 40), fill = t.c.bad, position = UDim2.new(1, 22, 0, -12), anchor = V2(1, 0) })
		b.root.Rotation = 12
		text(b.root, t, { role = "heading", text = o.badge, textSize = 22, color = WHITE })
		self.badge = b
	end
	self.nameText = text(self.body, t, {
		role = "heading",
		text = o.name or "Item",
		textSize = 26,
		position = UDim2.fromOffset(0, 238),
		size = UDim2.new(1, 0, 0, 34),
		truncate = true,
	})
	self.onBuy = o.onBuy
	self.price = o.price or 100
	self.currency = o.currency or "$"
	self.buy = UIKit.button({
		parent = self.body,
		theme = t,
		text = self.currency .. " " .. fmtNum(self.price),
		kind = "good",
		size = V2(w - 40, 62),
		textSize = 26,
		position = UDim2.new(0.5, 0, 1, -14),
		anchor = V2(0.5, 1),
		onClick = function()
			if self.onBuy and not self.owned then
				self.onBuy(self)
			end
		end,
	})
	local hover = mk("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 280), AutoButtonColor = false }, self.body)
	self.tiltS = self:spring(0, 20, 0.5, function(v)
		self.body.Rotation = v
	end)
	self:on(hover.MouseEnter, function()
		self._slide:to(-8)
		self.tiltS:to(-1.5)
		self.artScale.Scale = 1.08
		sfx("hover", self)
	end)
	self:on(hover.MouseLeave, function()
		self._slide:to(0)
		self.tiltS:to(0)
		self.artScale.Scale = 1
	end)
	self:set({ owned = o.owned, affordable = o.affordable })
	return self:_enter()
end
-- set({price, owned, affordable})
function Card:set(p)
	if p.price then
		self.price = p.price
	end
	if p.owned ~= nil then
		self.owned = p.owned
	end
	if p.affordable ~= nil then
		self.affordable = p.affordable
	end
	if self.owned then
		self.buy:set({ text = "OWNED", kind = "neutral", enabled = false })
	else
		self.buy:set({ text = self.currency .. " " .. fmtNum(self.price), kind = "good", enabled = self.affordable ~= false })
	end
	return self
end

-- ── results: banner, staggered stat rows with count-up, rank stamp, rewards ─
local Results = class()
function UIKit.results(o)
	o = o or {}
	local self = setmetatable(newBase(o, 0, 0, UDim2.fromScale(0.5, 0.5), V2(0.5, 0.5), "Results"), Results)
	self.root.Size = UDim2.fromScale(1, 1)
	self.popFrom = 1
	self.slideFrom = 0
	self:set(o)
	return self:_enter()
end
-- set({title, sub, stats = {{label, value, format?}}, rank, rewards = {{glyph|icon, count, color}}, buttons = {{text, kind, onClick}}})
function Results:set(o)
	local t = self.t
	self._ver += 1
	for _, c in self.body:GetChildren() do
		if not c:IsA("UIScale") then
			c:Destroy()
		end
	end
	for _, b in self._buttons or {} do
		b:Destroy()
	end
	self._buttons = {}
	self.spec = o
	local dim = mk("Frame", { Name = "Backdrop", BackgroundColor3 = t.c.backdrop, BackgroundTransparency = 0.25, Size = UDim2.fromScale(1, 1) }, self.body)
	mk("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.1, 0.5) }, dim)
	for i = -8, 30 do
		mk("Frame", {
			BackgroundColor3 = o.color or t.c.accent,
			BackgroundTransparency = 0.93,
			AnchorPoint = V2(0.5, 0.5),
			Position = UDim2.new(0, i * 90, 0.5, 0),
			Size = UDim2.new(0, 26, 2, 0),
			Rotation = 30,
		}, dim)
	end
	local center = mk("Frame", { BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1100, 860) }, self.body)
	self.center = center
	local title = text(center, t, {
		role = "display",
		text = o.title or "VICTORY",
		textSize = 130,
		gradient = ColorSequence.new(t.c.dispTop, o.color or t.c.gold),
		position = UDim2.new(0.5, 0, 0, 90),
		anchor = V2(0.5, 0.5),
		size = UDim2.fromOffset(1100, 150),
		rotation = t.tilt,
	})
	self.titleScale = mk("UIScale", { Scale = 0 }, title.holder)
	if o.sub then
		text(center, t, { role = "heading", text = o.sub, textSize = 30, color = t.c.textDim, position = UDim2.new(0.5, 0, 0, 175), anchor = V2(0.5, 0.5), size = UDim2.fromOffset(900, 40) })
	end
	local stats = o.stats or {}
	local rowH = 64
	local panelH = #stats * (rowH + 10) + 30
	local panel = plate(center, t, { size = V2(640, panelH), position = UDim2.fromOffset(100, 220), deco = true })
	self.rows = {}
	for i, st in stats do
		local row = mk("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 15 + (i - 1) * (rowH + 10)), Size = UDim2.new(1, -60, 0, rowH), Visible = false }, panel.root)
		text(row, t, { role = "heading", text = st.label or st[1] or "", textSize = 28, x = Enum.TextXAlignment.Left, color = t.c.textDim, stroke = math.min(2, t.textStroke), shadow = 2 })
		local v = text(row, t, { role = "numeric", text = "0", textSize = 40, x = Enum.TextXAlignment.Right })
		mk("Frame", { BackgroundColor3 = t.c.text, BackgroundTransparency = 0.88, AnchorPoint = V2(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2) }, row)
		self.rows[i] = { row = row, v = v, st = st }
	end
	if o.rank then
		local stamp = mk("Frame", { BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromOffset(900, 220 + panelH * 0.45), Size = UDim2.fromOffset(240, 240), Rotation = -12, Visible = false }, center)
		local disc = iconDisc(stamp, t, { size = 230, glyph = "", color = o.rankColor or t.c.gold, position = UDim2.fromScale(0.5, 0.5), anchor = V2(0.5, 0.5) })
		text(disc.root, t, { role = "display", text = tostring(o.rank), textSize = #tostring(o.rank) > 1 and 96 or 150, gradient = ColorSequence.new(WHITE, lighten(o.rankColor or t.c.gold, 0.5)) })
		text(stamp, t, { role = "heading", text = o.rankLabel or "RANK", textSize = 26, position = UDim2.new(0.5, 0, 1, 10), anchor = V2(0.5, 0), size = UDim2.fromOffset(240, 30) })
		self.stamp = stamp
		self.stampScale = mk("UIScale", {}, stamp)
	end
	self.rewards = {}
	local rewards = o.rewards or {}
	local rw = 150
	local ry = 220 + panelH + 30
	for i, r in rewards do
		local chip = mk("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(100 + (i - 1) * (rw + 16), ry), Size = UDim2.fromOffset(rw, 70), Visible = false }, center)
		plate(chip, t, { size = V2(rw, 64), top = t.c.raisedTop, bottom = t.c.raisedBottom })
		iconDisc(chip, t, { size = 58, image = r.icon, glyph = r.glyph or "*", color = r.color or t.c.gold, position = UDim2.fromOffset(-8, 3) })
		text(chip, t, { role = "numeric", text = "+" .. fmtNum(r.count or 1), textSize = 30, position = UDim2.fromOffset(56, 0), size = UDim2.new(1, -60, 0, 64) })
		self.rewards[i] = { chip = chip, scale = mk("UIScale", {}, chip) }
	end
	self.buttonsY = ry + (#rewards > 0 and 100 or 10)
	return self
end
function Results:onShow()
	local t = self.t
	local o = self.spec or {}
	local ver = self._ver
	local function alive()
		return not self._dead and self._ver == ver and self._shown
	end
	self.titleScale.Scale = 2.4
	tw(self.titleScale, { Scale = 1 }, 0.45, Enum.EasingStyle.Back)
	sfx("banner", self)
	task.spawn(function()
		task.wait(0.4)
		for _, r in self.rows do
			if not alive() then
				return
			end
			r.row.Visible = true
			r.row.Position += UDim2.fromOffset(-40, 0)
			tw(r.row, { Position = r.row.Position + UDim2.fromOffset(40, 0) }, 0.3, Enum.EasingStyle.Back)
			local value = r.st.value or r.st[2] or 0
			if type(value) == "number" then
				local start = os.clock()
				local fmt = r.st.format
				while alive() do
					local a = math.clamp((os.clock() - start) / 0.5, 0, 1)
					r.v:set(fmtNum(math.floor(value * (1 - (1 - a) ^ 3) + 0.5), fmt))
					if a >= 1 then
						break
					end
					task.wait()
				end
			else
				r.v:set(tostring(value))
			end
			sfx("tick", self)
			task.wait(0.08)
		end
		if self.stamp and alive() then
			task.wait(0.15)
			self.stamp.Visible = true
			self.stampScale.Scale = 3
			tw(self.stampScale, { Scale = 1 }, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.wait(0.22)
			sfx("stamp", self)
			local s = self:spring(0, 40, 0.3, function(v)
				self.center.Position = UDim2.new(0.5, v, 0.5, v * 0.5)
			end)
			s:kick(300)
		end
		for _, r in self.rewards do
			if not alive() then
				return
			end
			r.chip.Visible = true
			r.scale.Scale = 0.2
			tw(r.scale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
			sfx("pop", self)
			task.wait(0.1)
		end
		if not alive() then
			return
		end
		for i, b in o.buttons or {} do
			local btn = UIKit.button({
				parent = self.center,
				theme = t,
				text = b.text or b[1],
				kind = b.kind or (i == 1 and "primary" or "neutral"),
				size = V2(300, 72),
				position = UDim2.fromOffset(100 + (i - 1) * 320, self.buttonsY),
				anchor = V2(0, 0),
				onClick = b.onClick,
			})
			table.insert(self._buttons, btn)
			task.wait(0.08)
		end
	end)
end
function Results:onDestroy()
	for _, b in self._buttons or {} do
		b:Destroy()
	end
end

-- ── world popups: damage numbers and floating "+1" ──────────────────────────
local function anchorFor(at)
	if typeof(at) == "Instance" then
		if at:IsA("BasePart") or at:IsA("Attachment") then
			return at, nil
		elseif at:IsA("Model") then
			local p = at.PrimaryPart or at:FindFirstChildWhichIsA("BasePart", true)
			if p then
				return p, nil
			end
		end
	end
	local pos = worldPos(at)
	if pos then
		local a = Instance.new("Attachment")
		a.Name = "UIKitAnchor"
		a.Parent = workspace.Terrain
		a.WorldPosition = pos
		return a, a
	end
	return nil, nil
end

local function worldText(at, s, o)
	local t = o.theme or UIKit.current
	local adornee, temp = anchorFor(at)
	if not adornee then
		return nil
	end
	local sc = Screen.scale()
	local big = o.big
	local bb = mk("BillboardGui", {
		Name = "UIKitPopup",
		Adornee = adornee,
		AlwaysOnTop = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Size = UDim2.fromOffset(320 * sc, 140 * sc),
		StudsOffset = Vector3.new(0, 1.5, 0),
		MaxDistance = 250,
	}, Players.LocalPlayer:WaitForChild("PlayerGui"))
	local holder = mk("Frame", { BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(320, 140) }, bb)
	local scale = mk("UIScale", { Scale = 0.2 * sc }, holder)
	local L = text(holder, t, {
		role = "numeric",
		text = s,
		textSize = o.textSize or (big and 72 or 46),
		gradient = ColorSequence.new(lighten(o.color, 0.55), o.color),
		rotation = big and (math.random() * 16 - 8) or 0,
		stroke = math.max(3, t.textStroke),
		shadow = 4,
	})
	if o.tag then
		text(holder, t, {
			role = "heading",
			text = o.tag,
			textSize = 26,
			color = WHITE,
			position = UDim2.new(0.5, 0, 0, 6),
			anchor = V2(0.5, 0),
			size = UDim2.fromOffset(200, 30),
			stroke = 3,
		})
	end
	tw(scale, { Scale = (big and 1.15 or 1) * sc }, 0.22, Enum.EasingStyle.Back)
	local dx = (math.random() - 0.5) * 2.2
	tw(bb, { StudsOffset = Vector3.new(dx, big and 3.4 or 2.8, 0) }, 0.9, Enum.EasingStyle.Quad)
	task.delay(0.55, function()
		for _, d in holder:GetDescendants() do
			if d:IsA("TextLabel") then
				tw(d, { TextTransparency = 1 }, 0.3)
			elseif d:IsA("UIStroke") then
				tw(d, { Transparency = 1 }, 0.3)
			end
		end
		tw(scale, { Scale = 0.6 * sc }, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	task.delay(0.95, function()
		bb:Destroy()
		if temp then
			temp:Destroy()
		end
	end)
	return L
end

-- damage(at = Vector3 | BasePart | Model, amount, {kind = "normal"|"crit"|"heal"|"block"|"miss", color})
function UIKit.damage(at, amount, o)
	o = o or {}
	local t = o.theme or UIKit.current
	local kind = o.kind or "normal"
	local color = o.color or ({ normal = WHITE, crit = t.c.warn, heal = t.c.good, block = t.c.textDim, miss = t.c.textDim })[kind] or WHITE
	local s = kind == "miss" and "MISS" or (kind == "heal" and "+" or "") .. fmtNum(amount or 0)
	return worldText(at, s, { theme = t, color = color, big = kind == "crit", tag = kind == "crit" and "CRIT!" or nil })
end

-- popup(text, {at = Vector3 | BasePart | GuiObject | UDim2, color, offset = Vector2, parent}): a floating "+1".
function UIKit.popup(s, o)
	o = o or {}
	local t = o.theme or UIKit.current
	local color = o.color or t.c.good
	local at = o.at
	if typeof(at) == "Vector3" or (typeof(at) == "Instance" and not at:IsA("GuiObject")) then
		return worldText(at, s, { theme = t, color = color, textSize = o.textSize or 40 })
	end
	local parent = o.parent or UIKit.layer()
	local pos = UDim2.fromScale(0.5, 0.5)
	if typeof(at) == "UDim2" then
		pos = at
	elseif typeof(at) == "Instance" and at:IsA("GuiObject") then
		local sc = Screen.scale()
		local base = parent:IsA("GuiObject") and parent.AbsolutePosition or Vector2.zero
		local p = (at.AbsolutePosition - base) / sc + (o.offset or Vector2.new(at.AbsoluteSize.X / sc * 0.5, 0))
		pos = UDim2.fromOffset(p.X, p.Y)
	end
	local holder = mk("Frame", { BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(240, 60), ZIndex = 10 }, parent)
	local scale = mk("UIScale", { Scale = 0.3 }, holder)
	text(holder, t, { role = "numeric", text = s, textSize = o.textSize or 34, gradient = ColorSequence.new(lighten(color, 0.55), color), stroke = math.max(2, t.textStroke) })
	tw(scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
	tw(holder, { Position = pos + UDim2.fromOffset(0, -70) }, 0.8, Enum.EasingStyle.Quad)
	task.delay(0.5, function()
		for _, d in holder:GetDescendants() do
			if d:IsA("TextLabel") then
				tw(d, { TextTransparency = 1 }, 0.3)
			elseif d:IsA("UIStroke") then
				tw(d, { Transparency = 1 }, 0.3)
			end
		end
	end)
	task.delay(0.85, function()
		holder:Destroy()
	end)
	return holder
end

return UIKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">VFX</string>
          <string name="Source"><![CDATA[-- VFX: declarative layered effects (client-first) and screen accents. A spec lists layers (particles, beam, light,
-- flash, ring, decal), each with its own delay, so one call plays anticipation -> impact -> dissipation. No look of
-- its own: every colour, size and timing comes from the spec (colours as Color3, "#RRGGBB" or "Tokens.color.<name>").
--   VFX.preset("hit", { layers = { { kind = "flash", ... }, { kind = "particles", count = 24, ... } } })
--   VFX.play("hit", result.Position, { normal = result.Normal, scale = 1.2, intensity = 0.8 })
--   local h = VFX.effect(spec, part, { follow = true }); h:stop()      (continuous layers run until stop())
--   VFX.flashLight(pos, color, 4, 16, 0.2)   VFX.hitstop(0.08)   VFX.screenFlash(color, 0.15, 0.4)
--   local v = VFX.vignette(color, 0.6)   local t = VFX.trail(rootPart, { lifetime = 0.25 }); t:burst(0.4)
--   VFX.validate(spec) -> { "layers[2].lifetime: ..." }  (the same rules as the harness's check_fx_spec tool)
-- Effects live on attachments on one anchored host part under workspace.KitVFX (flash, ring and decal parts are
-- pooled) and clean themselves up after their longest layer. Budgets per family (VFX.budget(name, {effects,
-- particles, lights})) drop the oldest effect when exceeded; VFX.maxLights caps lights across all effects. Particle
-- emitters slow down with CameraRig.slowmo unless timeScaled = false (tweens and delays run in real time). With
-- follow, emitters, beams and lights ride the part; flash, ring and decal parts stay where they spawned.
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FxMath = require(script.Parent:WaitForChild("FxMath"))

local VFX = {}
VFX.maxLights = 6
VFX.defaultBudget = { effects = 16, particles = 800, lights = 3 }

local IS_CLIENT = RunService:IsClient()
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local DIRS = { "up", "down", "forward", "back", "left", "right" }
local MATERIAL_CHOICES = { "neon", "forcefield", "glass", "smoothplastic", "plastic" }

------------------------------------------------------------------------------------------------ helpers
local warned, warnCount = {}, 0
local function caller()
	for level = 3, 10 do
		local src, line = debug.info(level, "sl")
		if src == nil then
			break
		end
		if src ~= "[C]" and not string.find(src, "^ReplicatedStorage%.Kit%.") then
			return " (" .. src .. ":" .. tostring(line) .. ")"
		end
	end
	return ""
end

local function warnOnce(key, msg)
	if warned[key] or warnCount > 500 then
		return
	end
	warned[key] = true
	warnCount += 1
	warn("[VFX] " .. msg .. caller())
end

-- A number or the default (validation already reported bad values), clamped.
local function n(v, default, lo, hi)
	if type(v) ~= "number" or v ~= v then
		return default
	end
	if lo and v < lo then
		return lo
	elseif hi and v > hi then
		return hi
	end
	return v
end

-- A number or the default, warning once when it is not one or is out of range.
local function num(v, default, lo, hi, name)
	if v ~= nil then
		if type(v) ~= "number" or v ~= v then
			warnOnce(name .. ":type", name .. " must be a number, got " .. typeof(v))
		elseif (lo and v < lo) or (hi and v > hi) then
			warnOnce(name .. ":range", name .. " must be in " .. tostring(lo) .. ".." .. tostring(hi) .. ", got "
				.. tostring(v))
		end
	end
	return n(v, default, lo, hi)
end

-- number | {a, b} -> a, b
local function pairOf(v, default)
	if type(v) == "table" then
		return n(v[1], default), n(v[2], n(v[1], default))
	end
	local x = n(v, default)
	return x, x
end

local function rangeMax(v, default)
	if typeof(v) == "NumberRange" then
		return v.Max
	end
	local a, b = pairOf(v, default)
	return math.max(a, b)
end

local function numberRange(v: any, default: number, mul: number, lo: number?, hi: number?)
	local a, b
	if typeof(v) == "NumberRange" then
		a, b = v.Min, v.Max
	else
		a, b = pairOf(v, default)
	end
	a, b = a * mul, b * mul
	if a > b then
		a, b = b, a
	end
	if lo then
		a, b = math.clamp(a, lo, hi), math.clamp(b, lo, hi)
	end
	return NumberRange.new(a, b)
end

local function normalize(tbl, keys, where)
	if type(tbl) ~= "table" then
		return {}
	end
	local out, unknown = FxMath.normalizeKeys(tbl, keys)
	for _, u in unknown do
		warnOnce(where .. ":" .. u.key, "unknown " .. where .. " option '" .. u.key .. "'"
			.. (if u.suggestion then " (did you mean '" .. u.suggestion .. "'?)" else ""))
	end
	return out
end

local function sibling(name)
	local ok, mod = pcall(function()
		return require(script.Parent:WaitForChild(name, 5))
	end)
	return if ok then mod else nil
end
local Debug = sibling("Debug")

-- Kit modules that may not exist (Textures, Assets, CameraRig): found lazily, retried at most every 2 s.
local found, retryAt = {}, {}
local function optional(parent, name)
	local key = parent.Name .. "." .. name
	local m = found[key]
	if m then
		return m
	end
	if os.clock() < (retryAt[key] or 0) then
		return nil
	end
	local inst = parent:FindFirstChild(name)
	if inst and inst:IsA("ModuleScript") then
		local ok, mod = pcall(require, inst)
		if ok and type(mod) == "table" then
			found[key] = mod
			return mod
		end
	end
	retryAt[key] = os.clock() + 2
	return nil
end

local function kit(name)
	return optional(script.Parent, name)
end

local function tokens()
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	return shared and optional(shared, "Tokens")
end

local function toColor(v)
	if typeof(v) == "Color3" then
		return v
	end
	local r, g, b = FxMath.hex(v)
	if r then
		return Color3.new(r, g, b)
	end
	local name = FxMath.tokenName(v)
	if name then
		local T = tokens()
		local c = T and type(T.color) == "table" and T.color[name]
		if typeof(c) == "Color3" then
			return c
		end
		warnOnce("token:" .. name, "Tokens.color." .. name .. " does not exist")
	end
	return nil
end

local function applyNamed(inst: any, prop: string, tex: string, painted: boolean)
	if painted then
		local Textures = kit("Textures")
		if Textures and type(Textures.apply) == "function" then
			local ok, result = pcall(Textures.apply, inst, tex)
			if ok and result == true then
				return
			end
		end
	end
	local Assets = kit("Assets")
	if Assets and type(Assets.has) == "function" and Assets.has(tex) then
		pcall(function()
			inst[prop] = Assets.image(tex)
		end)
		return
	end
	warnOnce("texture:" .. tex, "texture '" .. tex .. "' is not a content id, "
		.. (if painted then "a painted texture " else "") .. "or a generated image")
end

-- Sets a texture: a content id / asset id directly; a name through Kit.Textures (painted textures; not for meshes)
-- or Kit.Assets (generated images). A name resolves on its own thread, so a first decode never holds up the caller.
local function applyTexture(inst: any, prop: string, tex: any, painted: boolean?)
	if tex == nil then
		return
	end
	if type(tex) == "number" then
		inst[prop] = "rbxassetid://" .. tostring(math.floor(tex))
		return
	end
	if FxMath.isContentId(tex) then
		inst[prop] = tex
		return
	end
	if type(tex) ~= "string" then
		return
	end
	task.spawn(applyNamed, inst, prop, tex, painted ~= false)
end

local function numberSequence(spec, lo, hi, mul, default)
	if typeof(spec) == "NumberSequence" then
		if mul == 1 then
			return spec
		end
		local kps = {}
		for i, k in spec.Keypoints do
			kps[i] = NumberSequenceKeypoint.new(k.Time, k.Value * mul, k.Envelope * mul)
		end
		return NumberSequence.new(kps)
	end
	local list = if spec ~= nil then FxMath.keypoints(spec, FxMath.isNumber) else nil
	if not list then
		list = FxMath.keypoints(default, FxMath.isNumber)
	end
	FxMath.clampKeypoints(list, lo, hi)
	local kps = table.create(#list)
	for i, k in list do
		kps[i] = NumberSequenceKeypoint.new(k.t, k.v * mul, k.e * mul)
	end
	return NumberSequence.new(kps)
end

local function colorSequence(spec)
	if typeof(spec) == "ColorSequence" then
		return spec
	end
	local list = if spec ~= nil then FxMath.keypoints(spec, FxMath.isColor) else nil
	if not list then
		return ColorSequence.new(WHITE)
	end
	local kps = table.create(#list)
	for i, k in list do
		kps[i] = ColorSequenceKeypoint.new(k.t, toColor(k.v) or WHITE)
	end
	return ColorSequence.new(kps)
end

local function firstLast(seq)
	local kps = seq.Keypoints
	return kps[1].Value, kps[#kps].Value
end

local function enumItem(enumName, itemName)
	local ok, item = pcall(function()
		return (Enum :: any)[enumName][itemName]
	end)
	return if ok then item else nil
end

local function enumMap(enumName, items)
	local m = {}
	for key, itemName in items do
		m[key] = enumItem(enumName, itemName)
	end
	return m
end

local NORMAL = enumMap("NormalId", { up = "Top", down = "Bottom", forward = "Front", back = "Back", left = "Left",
	right = "Right" })
local ORIENT = enumMap("ParticleOrientation", { facing = "FacingCamera", facingUp = "FacingCameraWorldUp",
	parallel = "VelocityParallel", perpendicular = "VelocityPerpendicular" })
local FLIP_LAYOUT = enumMap("ParticleFlipbookLayout", { ["2x2"] = "Grid2x2", ["4x4"] = "Grid4x4", ["8x8"] = "Grid8x8" })
local FLIP_MODE = enumMap("ParticleFlipbookMode", { loop = "Loop", oneshot = "OneShot", pingpong = "PingPong",
	random = "Random" })
local SHAPE = enumMap("ParticleEmitterShape", { sphere = "Sphere", box = "Box", disc = "Disc", cylinder = "Cylinder" })
local SHAPE_STYLE = enumMap("ParticleEmitterShapeStyle", { volume = "Volume", surface = "Surface" })
local SHAPE_INOUT = enumMap("ParticleEmitterShapeInOut", { outward = "Outward", inward = "Inward", both = "InAndOut" })
local TEXTURE_MODE = enumMap("TextureMode", { stretch = "Stretch", wrap = "Wrap", static = "Static" })
local MATERIAL = enumMap("Material", { neon = "Neon", forcefield = "ForceField", glass = "Glass",
	smoothplastic = "SmoothPlastic", plastic = "Plastic" })

local function choice(v, choices, default)
	return FxMath.enumValue(v, choices) or default
end

local function setIf(inst, prop, value)
	if value ~= nil then
		inst[prop] = value
	end
end

local function tweenInfo(seconds, ease, defaultStyle, defaultDirection)
	local style, dir = FxMath.easeNames(ease, nil, defaultStyle, defaultDirection)
	return TweenInfo.new(seconds, enumItem("EasingStyle", style) or Enum.EasingStyle.Quint,
		enumItem("EasingDirection", dir) or Enum.EasingDirection.Out)
end

------------------------------------------------------------------------------------------------ pools
local folder, host = nil, nil
local partPool = {}

local function getHost()
	if host and host.Parent and folder and folder.Parent then
		return host
	end
	for _, p in partPool do
		pcall(function()
			p:Destroy()
		end)
	end
	table.clear(partPool)
	folder = workspace:FindFirstChild("KitVFX")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "KitVFX"
		folder.Parent = workspace
	end
	host = Instance.new("Part")
	host.Name = "Host"
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.CastShadow = false
	host.Transparency = 1
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.CFrame = CFrame.identity
	host.Parent = folder
	return host
end

-- A new attachment at cf, placed before it is parented so the engine never sees it anywhere else (an emitter bursting
-- in the same frame emits from the right place).
local function newAttachment(cf, parent)
	local holder = parent or getHost()
	local a = Instance.new("Attachment")
	a.Name = "KitVFX"
	a.CFrame = holder.CFrame:ToObjectSpace(cf)
	a.Parent = holder
	return a
end

local function makePart(cf)
	local p = Instance.new("Part")
	p.Name = "KitVFXPart"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = cf or CFrame.identity
	return p
end

local function takePart()
	getHost()
	local p = table.remove(partPool)
	if p and p.Parent ~= folder then
		p = nil -- its folder is gone
	end
	if not p then
		p = makePart()
		p.Parent = folder
	end
	p.Size = Vector3.one
	p.Transparency = 1
	p.Material = Enum.Material.SmoothPlastic
	p.Color = WHITE
	return p
end

local function releasePart(p)
	for _, c in p:GetChildren() do
		c:Destroy()
	end
	if #partPool < 32 and folder and folder.Parent and p.Parent == folder then
		p.Transparency = 1
		table.insert(partPool, p)
	else
		p:Destroy()
	end
end

------------------------------------------------------------------------------------------------ effects
local Effect = {}
Effect.__index = Effect

local live = {} -- id -> effect
local emitterFx = setmetatable({}, { __mode = "k" }) -- emitter -> effect (for time scale and hitstop)
local frozen = {} -- hitstop: object -> { restore, untilT, track }
local budgets = {} -- family -> FxMath budget
local budgetCaps = {} -- family -> caps set with VFX.budget
local plans = setmetatable({}, { __mode = "k" }) -- spec table -> prepared plan (validated once)
local lightOrder = {}
local spins = {}
local spinConn = nil
local tsConn = nil
local nextId = 0

local NULL = setmetatable({ alive = false, id = 0, endReason = "invalid", emitters = {} }, Effect)

local function rig()
	return if IS_CLIENT then kit("CameraRig") else nil
end

local function currentTimeScale()
	local r = found[script.Parent.Name .. ".CameraRig"]
	local ts = r and r.timeScale
	return if type(ts) == "number" then ts else 1
end

local function hookTimeScale()
	if tsConn then
		return
	end
	local r = rig()
	if r and type(r.onTimeScale) == "function" then
		tsConn = r.onTimeScale(function(ts)
			local now = os.clock()
			for _, fx in live do
				if fx.timeScaled then
					fx.lag += (now - fx.tsAt) * (1 - fx.ts)
					fx.ts, fx.tsAt = ts, now
					for _, e in fx.emitters do
						if e.Parent and not frozen[e] then
							e.TimeScale = (fx.baseTS[e] or 1) * ts
						end
					end
				end
			end
		end)
	end
end

local function schedule(fx, delay, fn)
	local thread = task.delay(delay, function()
		if fx.alive then
			fn()
		end
	end)
	table.insert(fx.threads, thread)
end

local function tween(fx, inst, info, goal)
	local tw = TweenService:Create(inst, info, goal)
	table.insert(fx.tweens, tw)
	tw:Play()
	return tw
end

local function stepSpins()
	local now = os.clock()
	local i = 1
	while i <= #spins do
		local s = spins[i]
		local u = (now - s.t0) / s.duration
		if not s.fx.alive or u >= 1 or not s.part.Parent then
			if s.fx.alive and s.part.Parent then
				s.part.CFrame = s.base * CFrame.Angles(0, s.radians, 0)
			end
			spins[i] = spins[#spins]
			spins[#spins] = nil
		else
			s.part.CFrame = s.base * CFrame.Angles(0, s.radians * s.ease(u), 0)
			i += 1
		end
	end
	if #spins == 0 and spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
end

local function addSpin(fx, part, degrees, duration, ease)
	if degrees == 0 or duration <= 0 then
		return
	end
	table.insert(spins, { fx = fx, part = part, base = part.CFrame, radians = math.rad(degrees), duration = duration,
		t0 = os.clock(), ease = ease })
	if not spinConn then
		spinConn = RunService.Heartbeat:Connect(stepSpins)
	end
end

local function registerLight(light)
	for i = #lightOrder, 1, -1 do
		if lightOrder[i].Parent == nil then
			table.remove(lightOrder, i)
		end
	end
	table.insert(lightOrder, light)
	while #lightOrder > math.max(VFX.maxLights, 0) do
		table.remove(lightOrder, 1):Destroy()
	end
end

-- The effect's frame now (effects that follow a part move with it).
local function frameNow(fx)
	local part = fx.followPart
	if part and part.Parent then
		return part.CFrame * fx.localCF
	end
	return fx.cf
end

local function attachmentAt(fx, cf)
	local parent = if fx.followPart and fx.followPart.Parent then fx.followPart else nil
	local a = newAttachment(cf, parent)
	table.insert(fx.attachments, a)
	return a
end

-- The layer's frame: the effect's frame moved by the layer's offset.
local function layerCF(fx, L)
	local cf = frameNow(fx)
	if typeof(L.offset) == "Vector3" then
		cf *= CFrame.new(L.offset * fx.scale)
	end
	return cf
end

-- The layer's frame and an attachment there (layers without an offset share one).
local function layerFrame(fx, L)
	local cf = layerCF(fx, L)
	if typeof(L.offset) == "Vector3" then
		return cf, attachmentAt(fx, cf)
	end
	if not fx.mainAttach or fx.mainAttach.Parent == nil then
		fx.mainAttach = attachmentAt(fx, cf)
	end
	return cf, fx.mainAttach
end

local function addEmitter(fx, e, baseScale)
	table.insert(fx.emitters, e)
	fx.baseTS[e] = baseScale
	emitterFx[e] = fx
	e.TimeScale = baseScale * (if fx.timeScaled then currentTimeScale() else 1)
end

local function spawnParticles(fx, L)
	local s = fx.scale
	local cf, attach = layerFrame(fx, L)
	local cache = if s == 1 then L.__seq else nil
	if not cache then
		cache = {
			size = numberSequence(L.size, 0, 1000, s, 1),
			transparency = numberSequence(L.transparency, 0, 1, 1, { 0, 1 }),
			color = colorSequence(L.color),
			squash = if L.squash ~= nil then numberSequence(L.squash, -3, 3, 1, 0) else nil,
		}
		if s == 1 then
			L.__seq = cache
		end
	end
	local e = Instance.new("ParticleEmitter")
	e.Name = "L" .. L.index
	e.Enabled = false
	e.Rate = 0
	e.Lifetime = numberRange(L.lifetime, 1, 1, 0, 20)
	e.Speed = numberRange(L.speed, 5, s)
	local sx, sy = pairOf(L.spread, 0)
	e.SpreadAngle = Vector2.new(sx, sy)
	e.Size = cache.size
	e.Transparency = cache.transparency
	e.Color = cache.color
	setIf(e, "Squash", cache.squash)
	setIf(e, "LightEmission", if L.lightEmission ~= nil then n(L.lightEmission, 0, 0, 1) else nil)
	setIf(e, "LightInfluence", if L.lightInfluence ~= nil then n(L.lightInfluence, 1, 0, 1) else nil)
	setIf(e, "Brightness", if L.brightness ~= nil then n(L.brightness, 1, 0, 1000) else nil)
	setIf(e, "Drag", if L.drag ~= nil then n(L.drag, 0, -100, 100) else nil)
	if typeof(L.acceleration) == "Vector3" then
		e.Acceleration = L.acceleration * s
	end
	if L.rotation ~= nil then
		e.Rotation = numberRange(L.rotation, 0, 1)
	end
	if L.rotSpeed ~= nil then
		e.RotSpeed = numberRange(L.rotSpeed, 0, 1)
	end
	setIf(e, "Orientation", ORIENT[choice(L.orientation, { "facing", "facingUp", "parallel", "perpendicular" }, "")])
	setIf(e, "ZOffset", if L.zoffset ~= nil then n(L.zoffset, 0) else nil)
	setIf(e, "EmissionDirection", NORMAL[choice(L.direction, DIRS, "up")])
	if L.lockedToPart ~= nil then
		e.LockedToPart = L.lockedToPart == true
	end
	if type(L.flipbook) == "table" then
		local fb = FxMath.normalizeKeys(L.flipbook, FxMath.NESTED_KEYS.flipbook)
		setIf(e, "FlipbookLayout", FLIP_LAYOUT[choice(fb.layout, { "2x2", "4x4", "8x8" }, "4x4")])
		setIf(e, "FlipbookMode", FLIP_MODE[choice(fb.mode, { "loop", "oneshot", "pingpong", "random" }, "loop")])
		if fb.fps ~= nil then
			e.FlipbookFramerate = numberRange(fb.fps, 30, 1)
		end
		if fb.random ~= nil then
			e.FlipbookStartRandom = fb.random == true
		end
	end
	applyTexture(e, "Texture", L.texture)
	if type(L.shape) == "table" then
		local sh = FxMath.normalizeKeys(L.shape, FxMath.NESTED_KEYS.shape)
		local p = makePart(cf)
		table.insert(fx.owned, p)
		if typeof(sh.size) == "Vector3" then
			p.Size = Vector3.new(math.max(sh.size.X * s, 0.01), math.max(sh.size.Y * s, 0.01), math.max(sh.size.Z * s, 0.01))
		else
			p.Size = Vector3.one * math.max(n(sh.size, 1, 0, 1000) * s, 0.01)
		end
		getHost()
		p.Parent = folder
		setIf(e, "Shape", SHAPE[choice(sh.kind, { "sphere", "box", "disc", "cylinder" }, "sphere")])
		setIf(e, "ShapeStyle", SHAPE_STYLE[choice(sh.style, { "volume", "surface" }, "volume")])
		setIf(e, "ShapeInOut", SHAPE_INOUT[choice(sh.inOut, { "outward", "inward", "both" }, "outward")])
		if sh.partial ~= nil then
			e.ShapePartial = n(sh.partial, 1, 0, 1)
		end
		e.Parent = p
	else
		e.Parent = attach
	end
	addEmitter(fx, e, n(L.timeScale, 1, 0, 1))
	if L.count ~= nil then
		local count = math.floor(n(L.count, 10, 0, 1000) * fx.intensity + 0.5)
		if count > 0 then
			e:Emit(count)
		end
	else
		e.Rate = n(L.rate, 10, 0, 1000) * fx.intensity
		e.Enabled = true
		table.insert(fx.continuous, e)
		local d = n(L.duration, 0, 0, 600)
		if d > 0 then
			schedule(fx, d, function()
				e.Enabled = false
			end)
		end
	end
end

-- A beam end: a Vector3 offset in the effect's frame, or a part / attachment / model to reach.
local function beamEnd(fx, v, cf, axisCF)
	if typeof(v) == "Instance" then
		if v:IsA("Attachment") then
			return v, false
		end
		local part = if v:IsA("BasePart") then v elseif v:IsA("Model") then (v.PrimaryPart
			or v:FindFirstChildWhichIsA("BasePart", true)) else nil
		if part then
			local a = Instance.new("Attachment")
			a.Name = "KitVFXBeamEnd"
			a.CFrame = part.CFrame:ToObjectSpace(CFrame.new(part.Position) * axisCF)
			a.Parent = part
			table.insert(fx.owned, a)
			return a, false
		end
	end
	local offset = if typeof(v) == "Vector3" then v * fx.scale else Vector3.zero
	local pos = cf:PointToWorldSpace(offset)
	return attachmentAt(fx, CFrame.new(pos) * axisCF), true
end

local function spawnBeam(fx, L)
	local s = fx.scale
	local cf = layerCF(fx, L)
	-- the attachments' X axis points at the effect's up, so curve bows the beam toward up
	local axisCF = CFrame.fromMatrix(Vector3.zero, cf.UpVector, cf.LookVector)
	local a0, own0 = beamEnd(fx, L.from, cf, axisCF)
	local a1 = beamEnd(fx, L.to, cf, axisCF)
	local b = Instance.new("Beam")
	b.Attachment0, b.Attachment1 = a0, a1
	local w0, w1 = pairOf(L.width, 1)
	b.Width0, b.Width1 = w0 * s, w1 * s
	b.Color = colorSequence(L.color)
	b.Transparency = numberSequence(L.transparency, 0, 1, 1, 0)
	applyTexture(b, "Texture", L.texture)
	setIf(b, "TextureSpeed", if L.textureSpeed ~= nil then n(L.textureSpeed, 1) else nil)
	setIf(b, "TextureLength", if L.textureLength ~= nil then n(L.textureLength, 1, 0.001) * s else nil)
	setIf(b, "TextureMode", TEXTURE_MODE[choice(L.textureMode, { "stretch", "wrap", "static" }, "")])
	setIf(b, "LightEmission", if L.lightEmission ~= nil then n(L.lightEmission, 0, 0, 1) else nil)
	setIf(b, "LightInfluence", if L.lightInfluence ~= nil then n(L.lightInfluence, 1, 0, 1) else nil)
	setIf(b, "Brightness", if L.brightness ~= nil then n(L.brightness, 1, 0, 1000) else nil)
	local c0, c1 = pairOf(L.curve, 0)
	b.CurveSize0, b.CurveSize1 = c0 * s, -c1 * s
	b.Segments = math.floor(n(L.segments, 10, 1, 1000))
	b.FaceCamera = L.faceCamera ~= false
	setIf(b, "ZOffset", if L.zoffset ~= nil then n(L.zoffset, 0) else nil)
	if own0 then
		b.Parent = a0
	else
		b.Parent = getHost()
		table.insert(fx.owned, b)
	end
	table.insert(fx.beams, b)
	local d = n(L.duration, 0.3, 0, 600)
	if d > 0 then
		local fade = n(L.fadeOut, math.min(0.15, d * 0.5), 0, 10)
		schedule(fx, d, function()
			if fade > 0 then
				tween(fx, b, TweenInfo.new(fade, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Width0 = 0, Width1 = 0 })
			else
				b.Enabled = false
			end
		end)
	end
end

local function spawnLight(fx, L)
	local _, attach = layerFrame(fx, L)
	local spot = if type(L.spot) == "table" then FxMath.normalizeKeys(L.spot, FxMath.NESTED_KEYS.spot) else nil
	local light = Instance.new(if spot then "SpotLight" else "PointLight")
	light.Color = toColor(L.color) or WHITE
	light.Range = math.min(n(L.range, 12, 0, 60) * fx.scale, 60)
	light.Shadows = L.shadows == true
	if spot then
		light.Angle = n(spot.angle, 45, 0, 180)
		setIf(light, "Face", NORMAL[choice(spot.face, DIRS, "forward")])
	end
	local peak = n(L.brightness, 2, 0, 1000) * fx.intensity
	local d = n(L.duration, 0.25, 0, 600)
	local attack = math.min(n(L.attack, 0, 0, 10), d)
	light.Brightness = if attack > 0 then 0 else peak
	light.Parent = attach
	table.insert(fx.lights, light)
	registerLight(light)
	if attack > 0 then
		tween(fx, light, TweenInfo.new(attack, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = peak })
	end
	if d > attack then
		schedule(fx, attack, function()
			if light.Parent then
				tween(fx, light, TweenInfo.new(d - attack, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Brightness = 0 })
			end
		end)
	end
end

local function toSize(v, default, s)
	if typeof(v) == "Vector3" then
		return v * s
	end
	return Vector3.one * (n(v, default, 0) * s)
end

local function flashPart(fx, cf, meshType)
	local p = takePart()
	table.insert(fx.parts, p)
	p.CFrame = cf
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = meshType
	mesh.Parent = p
	return p, mesh
end

local function spawnFlash(fx, L)
	local s = fx.scale
	local cf = layerCF(fx, L)
	local shape = choice(L.shape, { "sphere", "block", "mesh" }, "sphere")
	local meshType = if shape == "mesh" then Enum.MeshType.FileMesh elseif shape == "block" then Enum.MeshType.Brick
		else Enum.MeshType.Sphere
	local p, mesh = flashPart(fx, cf, meshType)
	if shape == "mesh" then
		if type(L.mesh) == "number" then
			mesh.MeshId = "rbxassetid://" .. tostring(math.floor(L.mesh))
		elseif FxMath.isContentId(L.mesh) then
			mesh.MeshId = L.mesh
		end
		applyTexture(mesh, "TextureId", L.meshTexture, false)
	end
	local from, to
	if type(L.size) == "table" then
		from, to = toSize(L.size[1], 2, s), toSize(L.size[2] or L.size[1], 2, s)
	else
		from = toSize(L.size, 2, s)
		to = from
	end
	mesh.Scale = from
	p.Material = MATERIAL[choice(L.material, MATERIAL_CHOICES, "neon")] or Enum.Material.Neon
	p.Color = toColor(L.color) or WHITE
	local t0, t1 = 0, 1
	if L.transparency ~= nil then
		t0, t1 = pairOf(L.transparency, 0)
	end
	p.Transparency = math.clamp(t0, 0, 1)
	local d = n(L.duration, 0.12, 0, 10)
	if d > 0 then
		local info = tweenInfo(d, L.ease, "quint", "out")
		tween(fx, mesh, info, { Scale = to })
		tween(fx, p, info, { Transparency = math.clamp(t1, 0, 1) })
		if L.spin ~= nil then
			addSpin(fx, p, n(L.spin, 0), d, (FxMath.easeFn(L.ease, nil, "quint", "out")))
		end
	end
end

local function spawnRing(fx, L)
	local s = fx.scale
	local d0, d1 = pairOf(L.size, 1)
	if L.size == nil then
		d0, d1 = 1, 8
	end
	d0, d1 = d0 * s, d1 * s
	local d = n(L.duration, 0.35, 0.01, 10)
	local flat = L.flat ~= false
	local transparency = numberSequence(L.transparency, 0, 1, 1, { 0, 1 })
	local color = colorSequence(L.color)
	if L.texture ~= nil then
		-- a single particle that grows along the ease: the textured, crisp ring
		local _, attach = layerFrame(fx, L)
		local e = Instance.new("ParticleEmitter")
		e.Name = "Ring" .. L.index
		e.Enabled = false
		e.Rate = 0
		e.Lifetime = NumberRange.new(d)
		e.Speed = NumberRange.new(if flat then 0.001 else 0)
		e.SpreadAngle = Vector2.zero
		e.Rotation = NumberRange.new(0)
		e.RotSpeed = NumberRange.new(0)
		setIf(e, "EmissionDirection", NORMAL.up)
		setIf(e, "Orientation", if flat then ORIENT.perpendicular else ORIENT.facing)
		local list = FxMath.easeKeypoints(d0, d1, L.ease, 8)
		local kps = table.create(#list)
		for i, k in list do
			kps[i] = NumberSequenceKeypoint.new(k.t, math.max(k.v, 0))
		end
		e.Size = NumberSequence.new(kps)
		e.Transparency = transparency
		e.Color = color
		setIf(e, "LightEmission", if L.lightEmission ~= nil then n(L.lightEmission, 0, 0, 1) else nil)
		setIf(e, "Brightness", if L.brightness ~= nil then n(L.brightness, 1, 0, 1000) else nil)
		e.LockedToPart = true
		applyTexture(e, "Texture", L.texture)
		e.Parent = attach
		addEmitter(fx, e, 1)
		e:Emit(1)
		return
	end
	-- no texture: a flattened sphere (forcefield by default: bright rim, clear middle) that grows and fades
	local p, mesh = flashPart(fx, layerCF(fx, L), Enum.MeshType.Sphere)
	local th = n(L.thickness, 0.2, 0.01, 100) * s
	mesh.Scale = Vector3.new(d0, th, d0)
	p.Material = MATERIAL[choice(L.material, MATERIAL_CHOICES, "forcefield")] or Enum.Material.ForceField
	local c0 = color.Keypoints[1].Value
	local c1 = color.Keypoints[#color.Keypoints].Value
	local t0, t1 = firstLast(transparency)
	p.Color = c0
	p.Transparency = t0
	local info = tweenInfo(d, L.ease, "quint", "out")
	tween(fx, mesh, info, { Scale = Vector3.new(d1, th, d1) })
	tween(fx, p, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = t1, Color = c1 })
end

local function spawnDecal(fx, L)
	local s = fx.scale
	local cf = layerCF(fx, L)
	local s0, s1 = pairOf(L.size, 4)
	s0, s1 = math.max(s0 * s, 0.05), math.max(s1 * s, 0.05)
	local lo, hi = pairOf(L.rotation, 0)
	local degrees = lo + (hi - lo) * math.random()
	local p = takePart()
	table.insert(fx.parts, p)
	p.Size = Vector3.new(s0, 0.05, s0)
	p.CFrame = cf * CFrame.new(0, 0.05, 0) * CFrame.Angles(0, math.rad(degrees), 0)
	local decal = Instance.new("Decal")
	decal.Face = Enum.NormalId.Top
	decal.Color3 = toColor(L.color) or WHITE
	local t0, t1 = 0, 0
	if L.transparency ~= nil then
		t0, t1 = pairOf(L.transparency, 0)
	end
	decal.Transparency = math.clamp(t0, 0, 1)
	applyTexture(decal, "Texture", L.texture)
	decal.Parent = p
	local grow = n(L.grow, 0.12, 0, 10)
	if s1 ~= s0 then
		tween(fx, p, TweenInfo.new(math.max(grow, 0.01), Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{ Size = Vector3.new(s1, 0.05, s1) })
	end
	local d = n(L.duration, 2, 0, 600)
	local fade = math.min(n(L.fade, math.min(0.5, d * 0.5), 0, 60), d)
	if d - fade > 0 and t1 ~= t0 then
		tween(fx, decal, TweenInfo.new(d - fade, Enum.EasingStyle.Linear), { Transparency = math.clamp(t1, 0, 1) })
	end
	schedule(fx, d - fade, function()
		tween(fx, decal, TweenInfo.new(math.max(fade, 0.01), Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Transparency = 1 })
	end)
end

local SPAWN = { particles = spawnParticles, beam = spawnBeam, light = spawnLight, flash = spawnFlash, ring = spawnRing,
	decal = spawnDecal }

-- How long a layer lives after its delay (math.huge: until stop()).
local function layerLife(L)
	local k = L.kind
	if k == "particles" then
		local life = math.clamp(rangeMax(L.lifetime, 1), 0, 20) / math.max(n(L.timeScale, 1, 0, 1), 0.05)
		if L.count ~= nil then
			return life
		end
		local d = n(L.duration, 0, 0, 600)
		return if d > 0 then d + life else math.huge
	elseif k == "beam" then
		local d = n(L.duration, 0.3, 0, 600)
		return if d > 0 then d + n(L.fadeOut, math.min(0.15, d * 0.5), 0, 10) else math.huge
	elseif k == "light" then
		local d = n(L.duration, 0.25, 0, 600)
		return if d > 0 then d else math.huge
	elseif k == "flash" then
		return n(L.duration, 0.12, 0, 10)
	elseif k == "ring" then
		return n(L.duration, 0.35, 0.01, 10)
	end
	return n(L.duration, 2, 0, 600)
end

-- Rough peak cost of a plan for the budget: particles alive at once, and lights.
local function planCost(plan)
	if plan.cost then
		return plan.cost
	end
	local particles, lights = 0, 0
	for _, L in plan.layers do
		if L.kind == "particles" then
			if L.count ~= nil then
				particles += n(L.count, 10, 0, 1000)
			else
				local life = math.clamp(rangeMax(L.lifetime, 1), 0, 20)
				local d = n(L.duration, 0, 0, 600)
				particles += n(L.rate, 10, 0, 1000) * (if d > 0 then math.min(d, life) else life)
			end
		elseif L.kind == "ring" and L.texture ~= nil then
			particles += 1
		elseif L.kind == "light" then
			lights += 1
		end
	end
	plan.cost = { particles = particles, lights = lights }
	return plan.cost
end

-- Validates a spec once (warning about each problem) and keeps a normalized copy of its layers.
local function prepare(spec, label)
	local plan = plans[spec]
	if plan ~= nil then
		return plan or nil
	end
	for _, p in FxMath.validateEffect(spec) do
		warnOnce("spec:" .. label .. ":" .. p, "effect '" .. label .. "': " .. p)
	end
	local root = spec
	if FxMath.findKey(spec, "layers") == nil and #spec > 0 then
		root = { layers = spec }
	end
	local top = FxMath.normalizeKeys(root, FxMath.EFFECT_KEYS)
	local layers = {}
	if type(top.layers) == "table" then
		for i, raw in ipairs(top.layers) do
			if type(raw) == "table" then
				local kind = FxMath.enumValue(FxMath.findKey(raw, "kind"), FxMath.KINDS)
				local keys = kind and FxMath.layerKeys(kind)
				if keys then
					local L = FxMath.normalizeKeys(raw, keys)
					L.kind = kind
					L.index = i
					L.delay = n(L.delay, 0, 0, 30)
					table.insert(layers, L)
				end
			end
		end
	end
	if #layers == 0 then
		plans[spec] = false
		return nil
	end
	plan = { layers = layers, family = if type(top.family) == "string" then top.family else nil,
		budget = if type(top.budget) == "table" then FxMath.normalizeKeys(top.budget, FxMath.NESTED_KEYS.budget) else nil }
	plans[spec] = plan
	return plan
end

local function budgetFor(family, plan)
	local b = budgets[family]
	if b then
		return b
	end
	local caps = table.clone(VFX.defaultBudget)
	local override = budgetCaps[family] or plan.budget
	if override then
		for _, k in { "effects", "particles", "lights" } do
			if FxMath.isNumber(override[k]) then
				caps[k] = override[k]
			end
		end
	end
	b = FxMath.budget(caps)
	budgets[family] = b
	return b
end

local function upFrame(pos, up, hint)
	local f = hint - up * hint:Dot(up)
	if f.Magnitude < 1e-4 then
		local other = if math.abs(up.Y) < 0.9 then Vector3.yAxis else Vector3.xAxis
		f = other - up * other:Dot(up)
	end
	f = f.Unit
	local back = -f
	return CFrame.fromMatrix(pos, up:Cross(back), up, back)
end

-- at (Vector3, CFrame, BasePart, Attachment or Model) -> the effect's frame, and the part to follow if any.
local function frameOf(at, o)
	local cf, follow = nil, nil
	local ty = typeof(at)
	if ty == "Vector3" then
		cf = CFrame.new(at)
	elseif ty == "CFrame" then
		cf = at
	elseif ty == "Instance" then
		if at:IsA("Attachment") then
			cf = at.WorldCFrame
			if o.follow ~= false and at.Parent and at.Parent:IsA("BasePart") then
				follow = at.Parent
			end
		elseif at:IsA("BasePart") then
			cf = at.CFrame
			if o.follow then
				follow = at
			end
		elseif at:IsA("Model") then
			cf = at:GetPivot()
			if o.follow then
				follow = at.PrimaryPart or at:FindFirstChildWhichIsA("BasePart", true)
			end
		end
	end
	if not cf then
		return nil, nil
	end
	local normal, direction = o.normal, o.direction
	if typeof(normal) == "Vector3" and normal.Magnitude > 1e-6 then
		cf = upFrame(cf.Position, normal.Unit, if typeof(direction) == "Vector3" then direction else cf.LookVector)
	elseif typeof(direction) == "Vector3" and direction.Magnitude > 1e-6 then
		local dir = direction.Unit
		cf = CFrame.lookAt(cf.Position, cf.Position + dir, if math.abs(dir.Y) > 0.999 then Vector3.zAxis else Vector3.yAxis)
	end
	return cf, follow
end

local function spawnLayer(fx, L)
	local ok, err = pcall(SPAWN[L.kind], fx, L)
	if not ok then
		warnOnce("spawn:" .. fx.label .. ":" .. L.index .. ":" .. tostring(err), "effect '" .. fx.label .. "': layer "
			.. L.index .. " (" .. L.kind .. ") failed: " .. tostring(err))
	end
end

local function finish(fx, tries)
	-- particles slowed by slow motion (or held by a hitstop) live longer in real time: wait out what they lost
	tries = tries or 0
	local now = os.clock()
	fx.lag += (now - fx.tsAt) * (1 - fx.ts)
	fx.tsAt = now
	if tries < 40 and #fx.emitters > 0 and fx.lag > 0.02 then
		local lost = fx.lag
		fx.lag = 0
		schedule(fx, lost, function()
			finish(fx, tries + 1)
		end)
		return
	end
	fx:destroy("done")
end

local debugLast = {}
local function debugEvent(name)
	if not Debug then
		return
	end
	local now = os.clock()
	if (debugLast[name] or -1) + 0.25 > now then
		return
	end
	debugLast[name] = now
	Debug.event("vfx", { name = name })
end

-- Plays an effect spec at `at` (Vector3, CFrame, BasePart, Attachment or Model) and returns a handle
-- (:stop(), :destroy(), :andThen(fn), .alive). opts: scale (sizes, speeds, ranges), intensity (counts, rates,
-- light brightness), normal (Vector3: the effect's up, e.g. a surface normal), direction (Vector3: its forward),
-- follow (move with the part; Attachments follow by default), timeScaled (default true), onDone(reason).
function VFX.effect(spec, at, opts, label)
	if type(spec) ~= "table" then
		warnOnce("effect:type:" .. typeof(spec), "effect needs a spec table (or use VFX.play with a preset name)")
		return NULL
	end
	label = if type(label) == "string" then label elseif type(spec.family) == "string" then spec.family else "effect"
	local plan = prepare(spec, label)
	if not plan then
		return NULL
	end
	local o = normalize(opts or {}, FxMath.EFFECT_OPTS, "effect")
	local cf, followPart = frameOf(at, o)
	if not cf then
		warnOnce("at:" .. label, "effect '" .. label .. "': at must be a Vector3, CFrame, BasePart, Attachment or Model, got "
			.. typeof(at))
		return NULL
	end
	getHost()
	if IS_CLIENT then
		hookTimeScale()
	end
	nextId += 1
	local fx = setmetatable({ id = nextId, label = label, family = plan.family or label, alive = true, stopped = false,
		cf = cf, followPart = followPart, localCF = if followPart then followPart.CFrame:ToObjectSpace(cf) else nil,
		scale = num(o.scale, 1, 0.01, 100, "effect scale"), intensity = num(o.intensity, 1, 0, 100, "effect intensity"),
		timeScaled = o.timeScaled ~= false, threads = {}, tweens = {}, attachments = {}, parts = {}, owned = {},
		emitters = {}, continuous = {}, lights = {}, beams = {}, baseTS = {}, waiters = {}, conns = {}, lag = 0,
		tsAt = os.clock(), ts = 1 }, Effect)
	if fx.timeScaled then
		fx.ts = currentTimeScale()
	end
	if followPart then
		table.insert(fx.conns, followPart.AncestryChanged:Connect(function()
			if not followPart:IsDescendantOf(game) then
				fx:stop()
			end
		end))
	end
	if type(o.onDone) == "function" then
		table.insert(fx.waiters, o.onDone)
	end
	live[fx.id] = fx
	local budget = budgetFor(fx.family, plan)
	fx.budget = budget
	local cost = planCost(plan)
	for _, id in budget:add(fx.id, { particles = cost.particles * fx.intensity, lights = cost.lights }) do
		local old = live[id]
		if old then
			old:destroy("evicted")
		end
	end
	local longest = 0
	for _, L in plan.layers do
		longest = math.max(longest, L.delay + layerLife(L))
		if L.delay > 0 then
			schedule(fx, L.delay, function()
				if not fx.stopped then
					spawnLayer(fx, L)
				end
			end)
		else
			spawnLayer(fx, L)
		end
	end
	if longest < math.huge then
		schedule(fx, longest + 0.05, function()
			finish(fx)
		end)
	end
	if label ~= "effect" then
		debugEvent(label)
	end
	return fx
end

-- Stops emitting (pending layers are skipped, lights and beams fade) and cleans up once live particles are gone.
function Effect:stop()
	if not self.alive or self.stopped then
		return self
	end
	self.stopped = true
	for _, th in self.threads do
		pcall(task.cancel, th)
	end
	table.clear(self.threads)
	for _, e in self.continuous do
		e.Enabled = false
	end
	local fadeInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, light in self.lights do
		if light.Parent then
			tween(self, light, fadeInfo, { Brightness = 0 })
		end
	end
	for _, b in self.beams do
		if b.Parent then
			tween(self, b, fadeInfo, { Width0 = 0, Width1 = 0 })
		end
	end
	local wait = 0.15
	for _, e in self.emitters do
		if e.Parent then
			local ts = math.max(e.TimeScale, 0.05)
			wait = math.max(wait, e.Lifetime.Max / ts)
		end
	end
	schedule(self, math.min(wait, 30) + 0.05, function()
		self:destroy("stopped")
	end)
	return self
end

-- Removes everything now. reason is passed to andThen callbacks ("destroyed" by default).
function Effect:destroy(reason)
	if not self.alive then
		return
	end
	self.alive = false
	self.endReason = if type(reason) == "string" then reason else "destroyed"
	live[self.id] = nil
	if self.budget then
		self.budget:remove(self.id)
	end
	for _, th in self.threads do
		if th ~= coroutine.running() then
			pcall(task.cancel, th)
		end
	end
	for _, tw in self.tweens do
		tw:Cancel()
	end
	for _, inst in self.owned do
		inst:Destroy()
	end
	for _, a in self.attachments do
		a:Destroy()
	end
	for _, p in self.parts do
		releasePart(p)
	end
	for _, e in self.emitters do
		emitterFx[e] = nil
	end
	for _, c in self.conns do
		c:Disconnect()
	end
	for _, fn in self.waiters do
		task.spawn(fn, self.endReason)
	end
	self.threads, self.tweens, self.owned, self.attachments, self.parts = {}, {}, {}, {}, {}
	self.emitters, self.continuous, self.lights, self.beams, self.waiters, self.conns = {}, {}, {}, {}, {}, {}
end
Effect.Destroy = Effect.destroy

-- Calls fn(reason) when the effect ends: "done", "stopped", "evicted", "destroyed" or "invalid".
function Effect:andThen(fn)
	if type(fn) ~= "function" then
		return self
	end
	if self.alive then
		table.insert(self.waiters, fn)
	else
		task.spawn(fn, self.endReason or "invalid")
	end
	return self
end

------------------------------------------------------------------------------------------------ presets
local presets = {}

-- Registers a named effect: a spec table (validated now) or a function(opts) -> spec for variants.
function VFX.preset(name, spec)
	if type(name) ~= "string" then
		warnOnce("preset:name", "preset needs a string name")
		return
	end
	if type(spec) ~= "table" and type(spec) ~= "function" then
		warnOnce("preset:" .. name, "preset '" .. name .. "' needs a spec table or a function returning one")
		return
	end
	presets[name] = spec
	if type(spec) == "table" then
		prepare(spec, name)
	end
end

function VFX.has(name)
	return presets[name] ~= nil
end

function VFX.names()
	local out = {}
	for name in presets do
		table.insert(out, name)
	end
	table.sort(out)
	return out
end

-- Plays a preset by name (see VFX.effect for at and opts).
function VFX.play(name, at, opts)
	local spec = presets[name]
	if spec == nil then
		local guess = if type(name) == "string" then FxMath.closest(name, VFX.names()) else nil
		warnOnce("play:" .. tostring(name), "no preset '" .. tostring(name) .. "'"
			.. (if guess then " (did you mean '" .. guess .. "'?)" else ""))
		return NULL
	end
	if type(spec) == "function" then
		local ok, built = pcall(spec, if type(opts) == "table" then opts else {})
		if not ok or type(built) ~= "table" then
			warnOnce("preset:fn:" .. name, "preset '" .. name .. "' function failed: " .. tostring(built))
			return NULL
		end
		-- the options may carry the variant's own keys: pass on only the effect options, without warnings
		return VFX.effect(built, at, if type(opts) == "table" then FxMath.normalizeKeys(opts, FxMath.EFFECT_OPTS) else nil,
			name)
	end
	return VFX.effect(spec, at, opts, name)
end

-- Caps for one effect family (a preset's name, or spec.family): { effects = n, particles = n, lights = n }.
function VFX.budget(family, caps)
	if type(family) ~= "string" or type(caps) ~= "table" then
		warnOnce("budget:args", "budget(family, { effects, particles, lights })")
		return
	end
	budgetCaps[family] = FxMath.normalizeKeys(caps, FxMath.NESTED_KEYS.budget)
	budgets[family] = nil
end

-- Every problem in a spec ("layers[2].lifetime: ..."); empty when valid.
function VFX.validate(spec)
	return FxMath.validateEffect(spec)
end

-- Ends every effect now (e.g. between rounds).
function VFX.clear()
	local all = {}
	for _, fx in live do
		table.insert(all, fx)
	end
	for _, fx in all do
		fx:destroy("destroyed")
	end
end

-- A short light pulse: brightness at once, fading out over seconds.
function VFX.flashLight(at, color, brightness, range, seconds)
	local d = num(seconds, 0.2, 0, 10, "flashLight seconds")
	return VFX.effect({ family = "flashLight", layers = { { kind = "light", color = color, brightness = brightness,
		range = range, duration = if d > 0 then d else 0.2 } } }, at, nil, "flashLight")
end

------------------------------------------------------------------------------------------------ hitstop
local function freeze(obj, isTrack, speed, untilT)
	local f = frozen[obj]
	if f then
		local fx = not f.track and emitterFx[obj]
		if fx and untilT > f.untilT then
			fx.lag += untilT - f.untilT
		end
		f.untilT = math.max(f.untilT, untilT)
		return
	end
	if isTrack then
		frozen[obj] = { restore = obj.Speed, untilT = untilT, track = true }
		obj:AdjustSpeed(speed)
	else
		frozen[obj] = { restore = obj.TimeScale, untilT = untilT, track = false }
		obj.TimeScale = 0
		local fx = emitterFx[obj]
		if fx then
			fx.lag += math.max(untilT - os.clock(), 0)
		end
	end
end

local releaseFrozen
releaseFrozen = function()
	local now = os.clock()
	local nextAt = math.huge
	for obj, f in frozen do
		if f.untilT > now + 1 / 60 then
			nextAt = math.min(nextAt, f.untilT)
		else
			frozen[obj] = nil
			pcall(function()
				if f.track then
					obj:AdjustSpeed(f.restore)
				else
					local fx = emitterFx[obj]
					obj.TimeScale = if fx and fx.alive and fx.timeScaled then (fx.baseTS[obj] or 1) * currentTimeScale()
						else f.restore
				end
			end)
		end
	end
	if nextAt < math.huge then
		task.delay(math.max(nextAt - os.clock(), 0) + 0.005, releaseFrozen)
	end
end

local function animatorOf(x)
	if typeof(x) ~= "Instance" then
		return nil
	end
	if x:IsA("Animator") then
		return x
	elseif x:IsA("Humanoid") or x:IsA("AnimationController") then
		return x:FindFirstChildOfClass("Animator")
	elseif x:IsA("Model") then
		local h = x:FindFirstChildOfClass("Humanoid") or x:FindFirstChildOfClass("AnimationController")
		return h and h:FindFirstChildOfClass("Animator")
	end
	return nil
end

-- Freezes the moment for `seconds` (40-120 ms reads as impact): the local character's playing animations (and any
-- animators / tracks / emitters / effects given) pause, and CameraRig.slowmo holds time. Physics is untouched.
-- opts: character (default true), animators, tracks, emitters (ParticleEmitters or effect handles), camera
-- (default true), timeScale (during the stop, default 0), speed (animation speed during the stop, default 0).
function VFX.hitstop(seconds, opts)
	if not IS_CLIENT then
		return
	end
	seconds = num(seconds, 0.08, 0, 1, "hitstop seconds")
	if seconds > 0.3 then
		warnOnce("hitstop:long", "hitstop of " .. seconds .. " s reads as lag; 0.04-0.12 s is the usual range")
	end
	if seconds <= 0 then
		return
	end
	local o = normalize(opts or {}, FxMath.HITSTOP_KEYS, "hitstop")
	local untilT = os.clock() + seconds
	local speed = n(o.speed, 0, 0, 1)
	local function freezeAnimator(animator)
		local ok, tracks = pcall(animator.GetPlayingAnimationTracks, animator)
		if ok then
			for _, t in tracks do
				freeze(t, true, speed, untilT)
			end
		end
	end
	if o.character ~= false then
		local player = Players.LocalPlayer
		local a = player and player.Character and animatorOf(player.Character)
		if a then
			freezeAnimator(a)
		end
	end
	if type(o.animators) == "table" then
		for _, x in o.animators do
			local a = animatorOf(x)
			if a then
				freezeAnimator(a)
			end
		end
	end
	if type(o.tracks) == "table" then
		for _, t in o.tracks do
			if typeof(t) == "Instance" and t:IsA("AnimationTrack") then
				freeze(t, true, speed, untilT)
			end
		end
	end
	if type(o.emitters) == "table" then
		for _, e in o.emitters do
			if typeof(e) == "Instance" and e:IsA("ParticleEmitter") then
				freeze(e, false, 0, untilT)
			elseif type(e) == "table" and getmetatable(e) == Effect then
				for _, em in e.emitters do
					if em.Parent then
						freeze(em, false, 0, untilT)
					end
				end
			end
		end
	end
	if o.camera ~= false then
		local r = rig()
		if r and type(r.slowmo) == "function" then
			r.slowmo(n(o.timeScale, 0, 0, 1), seconds, { rampIn = 0, rampOut = 0 })
		end
	end
	task.delay(seconds, releaseFrozen)
end

------------------------------------------------------------------------------------------------ screen accents
local overlay = nil
local function overlayGui()
	if overlay and overlay.gui.Parent then
		return overlay
	end
	local player = Players.LocalPlayer
	local pg = player and player:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "KitVFXOverlay"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 90
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None
	end)
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.BorderSizePixel = 0
	flash.BackgroundColor3 = WHITE
	flash.BackgroundTransparency = 1
	flash.Size = UDim2.fromScale(1, 1)
	flash.ZIndex = 10
	flash.Parent = gui
	gui.Parent = pg
	overlay = { gui = gui, flash = flash, tween = nil }
	return overlay
end

-- A full-screen flash of colour that fades out over seconds; strength is its peak opacity (0..1).
function VFX.screenFlash(color, seconds, strength)
	if not IS_CLIENT then
		return
	end
	local ov = overlayGui()
	if not ov then
		return
	end
	local c = toColor(color)
	if not c then
		warnOnce("screenFlash:color", "screenFlash color must be a Color3, \"#RRGGBB\" or \"Tokens.color.<name>\"")
		c = WHITE
	end
	seconds = num(seconds, 0.15, 0.01, 10, "screenFlash seconds")
	strength = num(strength, 0.5, 0, 1, "screenFlash strength")
	local f = ov.flash
	if ov.tween then
		ov.tween:Cancel()
	end
	f.BackgroundColor3 = c
	f.BackgroundTransparency = math.min(f.BackgroundTransparency, 1 - strength)
	ov.tween = TweenService:Create(f, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 })
	ov.tween:Play()
end

local Vignette = {}
Vignette.__index = Vignette
local NULL_VIGNETTE = setmetatable({ alive = false, parts = {}, tweens = {} }, Vignette)

local EDGE_FALLOFF = nil
local function edgeFalloff()
	if not EDGE_FALLOFF then
		local kps = {}
		for i = 0, 6 do
			local t = i / 6
			kps[i + 1] = NumberSequenceKeypoint.new(t, t * t * (3 - 2 * t))
		end
		EDGE_FALLOFF = NumberSequence.new(kps)
	end
	return EDGE_FALLOFF
end

function Vignette:_to(target, seconds)
	for _, tw in self.tweens do
		tw:Cancel()
	end
	table.clear(self.tweens)
	local info = TweenInfo.new(math.max(seconds, 0.01), Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	for _, part in self.parts do
		local tw = TweenService:Create(part.inst, info, { [part.prop] = target })
		table.insert(self.tweens, tw)
		tw:Play()
	end
end

-- Changes the vignette's strength (0..1) over seconds.
function Vignette:set(strength, seconds)
	if not self.alive then
		return self
	end
	self:_to(1 - n(strength, 0.6, 0, 1), n(seconds, 0.2, 0, 10))
	return self
end

-- Fades out over seconds and removes it.
function Vignette:stop(seconds)
	if not self.alive then
		return
	end
	self.alive = false
	local fade = n(seconds, 0.3, 0, 10)
	self:_to(1, fade)
	local holder = self.holder
	task.delay(fade + 0.05, function()
		holder:Destroy()
	end)
end
Vignette.Destroy = Vignette.stop

-- Edges darkened (or tinted) toward the centre: seconds = total time (nil: until :stop()). opts: strength (peak
-- opacity, 0.6), thickness (fraction of the screen, 0.3), fadeIn, fadeOut, texture (a painted vignette to use instead
-- of the gradient edges). Returns a handle with :set(strength, seconds) and :stop(seconds).
function VFX.vignette(color, seconds, opts)
	if not IS_CLIENT then
		return NULL_VIGNETTE
	end
	local ov = overlayGui()
	if not ov then
		return NULL_VIGNETTE
	end
	local o = normalize(opts or {}, FxMath.VIGNETTE_KEYS, "vignette")
	local c = toColor(color) or BLACK
	local strength = num(o.strength, 0.6, 0, 1, "vignette strength")
	local thickness = num(o.thickness, 0.3, 0.01, 1, "vignette thickness")
	local fadeIn = num(o.fadeIn, 0.08, 0, 10, "vignette fadeIn")
	local total = if seconds == nil or seconds == false then math.huge else num(seconds, 0.6, 0, 600, "vignette seconds")
	local fadeOut = num(o.fadeOut, if total < math.huge then math.min(0.4, total * 0.5) else 0.3, 0, 10, "vignette fadeOut")
	local holder = Instance.new("Frame")
	holder.Name = "Vignette"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = 5
	local parts = {}
	if o.texture ~= nil then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.ImageColor3 = c
		img.ImageTransparency = 1
		img.ScaleType = Enum.ScaleType.Stretch
		img.ZIndex = 5
		applyTexture(img, "Image", o.texture)
		img.Parent = holder
		table.insert(parts, { inst = img, prop = "ImageTransparency" })
	else
		local edges = {
			{ Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, thickness), 90 },
			{ Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, thickness), -90 },
			{ Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(thickness, 1), 0 },
			{ Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(thickness, 1), 180 },
		}
		for _, e in edges do
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = c
			f.BackgroundTransparency = 1
			f.AnchorPoint = e[1]
			f.Position = e[2]
			f.Size = e[3]
			f.ZIndex = 5
			local g = Instance.new("UIGradient")
			g.Rotation = e[4]
			g.Transparency = edgeFalloff()
			g.Parent = f
			f.Parent = holder
			table.insert(parts, { inst = f, prop = "BackgroundTransparency" })
		end
	end
	holder.Parent = ov.gui
	local h = setmetatable({ holder = holder, parts = parts, tweens = {}, alive = true }, Vignette)
	h:_to(1 - strength, fadeIn)
	if total < math.huge then
		task.delay(math.max(total - fadeOut, fadeIn), function()
			h:stop(fadeOut)
		end)
	end
	return h
end

------------------------------------------------------------------------------------------------ trails
local Trail = {}
Trail.__index = Trail
local NULL_TRAIL = setmetatable({ alive = false }, Trail)

-- Turns the trail on or off (an off trail's ribbon fades out over its lifetime).
function Trail:enable(on)
	if self.alive then
		self.token = (self.token or 0) + 1
		self.trail.Enabled = on ~= false
	end
	return self
end

-- On for `seconds`, then off (a dash or a swing).
function Trail:burst(seconds)
	if not self.alive then
		return self
	end
	self.token = (self.token or 0) + 1
	local token = self.token
	self.trail.Enabled = true
	task.delay(n(seconds, 0.3, 0, 60), function()
		if self.alive and self.token == token then
			self.trail.Enabled = false
		end
	end)
	return self
end

function Trail:clear()
	if self.alive then
		self.trail:Clear()
	end
	return self
end

function Trail:destroy()
	if not self.alive then
		return
	end
	self.alive = false
	self.trail:Destroy()
	self.a0:Destroy()
	self.a1:Destroy()
end
Trail.Destroy = Trail.destroy

-- A Trail on `part` between two attachments `width` studs apart along the part's axis ("up", "right" or "forward")
-- around `offset`. spec: width, offset, axis, lifetime, color, transparency, widthScale, texture, textureMode,
-- textureLength, lightEmission, lightInfluence, brightness, minLength, maxLength, faceCamera, enabled (default true).
-- Returns a handle: :enable(on), :burst(seconds), :clear(), :destroy().
function VFX.trail(part, spec)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		warnOnce("trail:part", "trail needs a BasePart to ride on, got " .. typeof(part))
		return NULL_TRAIL
	end
	spec = if type(spec) == "table" then spec else {}
	for _, p in FxMath.validateTrail(spec) do
		warnOnce("trail:" .. p, p)
	end
	local o = FxMath.normalizeKeys(spec, FxMath.NESTED_KEYS.trail)
	local width = n(o.width, 1, 0, 1000)
	local axis = choice(o.axis, { "up", "right", "forward" }, "up")
	local dir = if axis == "up" then Vector3.yAxis elseif axis == "right" then Vector3.xAxis else -Vector3.zAxis
	local center = if typeof(o.offset) == "Vector3" then o.offset else Vector3.zero
	local a0 = Instance.new("Attachment")
	a0.Name = "KitTrail0"
	a0.Position = center + dir * (width / 2)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Name = "KitTrail1"
	a1.Position = center - dir * (width / 2)
	a1.Parent = part
	local t = Instance.new("Trail")
	t.Attachment0, t.Attachment1 = a0, a1
	t.Lifetime = n(o.lifetime, 0.3, 0, 20)
	t.Color = colorSequence(o.color)
	t.Transparency = numberSequence(o.transparency, 0, 1, 1, { 0, 1 })
	if o.widthScale ~= nil then
		t.WidthScale = numberSequence(o.widthScale, 0, 1000, 1, 1)
	end
	applyTexture(t, "Texture", o.texture)
	setIf(t, "TextureMode", TEXTURE_MODE[choice(o.textureMode, { "stretch", "wrap", "static" }, "")])
	setIf(t, "TextureLength", if o.textureLength ~= nil then n(o.textureLength, 1, 0.001) else nil)
	setIf(t, "LightEmission", if o.lightEmission ~= nil then n(o.lightEmission, 0, 0, 1) else nil)
	setIf(t, "LightInfluence", if o.lightInfluence ~= nil then n(o.lightInfluence, 1, 0, 1) else nil)
	setIf(t, "Brightness", if o.brightness ~= nil then n(o.brightness, 1, 0, 1000) else nil)
	setIf(t, "MinLength", if o.minLength ~= nil then n(o.minLength, 0.1, 0) else nil)
	setIf(t, "MaxLength", if o.maxLength ~= nil then n(o.maxLength, 0, 0) else nil)
	if o.faceCamera ~= nil then
		t.FaceCamera = o.faceCamera == true
	end
	t.Enabled = o.enabled ~= false
	t.Parent = part
	return setmetatable({ trail = t, a0 = a0, a1 = a1, alive = true }, Trail)
end

------------------------------------------------------------------------------------------------ debug
if Debug and IS_CLIENT then
	Debug.register("__vfx", function(name, distance)
		if name == nil then
			return VFX.names()
		end
		local cam = workspace.CurrentCamera
		if not cam then
			return "no camera"
		end
		local pos = (cam.CFrame * CFrame.new(0, 0, -(tonumber(distance) or 12))).Position
		local h = VFX.play(tostring(name), pos)
		return if h.alive then "played " .. tostring(name) else "no preset " .. tostring(name)
	end, "play a VFX preset in front of the camera: name, distance (no arguments lists the presets)")
end

return VFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">WorldKit</string>
          <string name="Source"><![CDATA[--!nonstrict
-- WorldKit: tested building blocks for good-looking Roblox worlds, so a game composes its world instead of inventing
-- geometry code. Server or edit mode. Terrain islands and water (smooth, sculpted, never voxel), part-built props,
-- and lighting presets whose values were tuned to actually read as the mood (ClockTime 16.5 is NOT golden hour in
-- Roblox: the sun only warms near 17.5-18).
--
-- Live lesson that made this exist: a 27B builder asked to "build floating islands" wrote Mesh.new() (no such class),
-- then MeshParts with no mesh (invisible). Every capture showed the default baseplate.

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local WorldKit = {}

local function c3(v, fallback)
	if typeof(v) == "Color3" then
		return v
	end
	if type(v) == "string" then
		local ok, col = pcall(Color3.fromHex, v)
		if ok then
			return col
		end
	end
	return fallback
end

local function rng(seed)
	return Random.new(seed or 1)
end

function WorldKit.folder(name)
	local f = Workspace:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = Workspace
	end
	return f
end

local function part(props)
	local p = Instance.new(props.Shape and "Part" or (props.ClassName or "Part"))
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = props.CastShadow ~= false
	if props.Shape then
		p.Shape = props.Shape                     -- before Size: setting Shape later re-squares a Ball
	end
	for k, v in pairs(props) do
		if k ~= "ClassName" and k ~= "Parent" and k ~= "CastShadow" and k ~= "Shape" and k ~= "CFrame" then
			p[k] = v
		end
	end
	if props.CFrame then
		p.CFrame = props.CFrame
	end
	p.Parent = props.Parent
	return p
end

-- ---------------------------------------------------------------------------------------------------- lighting

local PRESETS = {
	golden_hour = {
		ClockTime = 17.55, GeographicLatitude = 30, Brightness = 2.4, ExposureCompensation = 0.15,
		Ambient = Color3.fromRGB(98, 74, 70), OutdoorAmbient = Color3.fromRGB(150, 118, 100),
		ColorShift_Top = Color3.fromRGB(255, 196, 140), ColorShift_Bottom = Color3.fromRGB(70, 40, 60),
		atmosphere = { Density = 0.2, Offset = 0.08, Color = Color3.fromRGB(255, 186, 140),
			Decay = Color3.fromRGB(196, 104, 92), Glare = 0.5, Haze = 1.1 },
		bloom = { Intensity = 0.65, Size = 30, Threshold = 1.5 },
		grade = { Brightness = 0.02, Contrast = 0.1, Saturation = 0.18, TintColor = Color3.fromRGB(255, 238, 220) },
		sunrays = { Intensity = 0.1, Spread = 0.55 },
		clouds = { Cover = 0.58, Density = 0.5, Color = Color3.fromRGB(255, 205, 178) },
	},
	dusk = {
		ClockTime = 18.15, GeographicLatitude = 30, Brightness = 1.8, ExposureCompensation = 0.25,
		Ambient = Color3.fromRGB(86, 70, 104), OutdoorAmbient = Color3.fromRGB(120, 96, 140),
		ColorShift_Top = Color3.fromRGB(255, 150, 140), ColorShift_Bottom = Color3.fromRGB(60, 40, 90),
		atmosphere = { Density = 0.24, Offset = 0.08, Color = Color3.fromRGB(232, 140, 150),
			Decay = Color3.fromRGB(96, 74, 150), Glare = 0.35, Haze = 1.4 },
		bloom = { Intensity = 0.8, Size = 32, Threshold = 1.3 },
		grade = { Brightness = 0.0, Contrast = 0.12, Saturation = 0.2, TintColor = Color3.fromRGB(250, 230, 245) },
		sunrays = { Intensity = 0.06, Spread = 0.5 },
		clouds = { Cover = 0.62, Density = 0.55, Color = Color3.fromRGB(230, 160, 180) },
	},
	night = {
		ClockTime = 0.3, GeographicLatitude = 30, Brightness = 0.9, ExposureCompensation = 0.4,
		Ambient = Color3.fromRGB(46, 50, 88), OutdoorAmbient = Color3.fromRGB(60, 70, 120),
		ColorShift_Top = Color3.fromRGB(120, 140, 255), ColorShift_Bottom = Color3.fromRGB(20, 20, 50),
		atmosphere = { Density = 0.22, Offset = 0.05, Color = Color3.fromRGB(70, 82, 150),
			Decay = Color3.fromRGB(22, 24, 60), Glare = 0, Haze = 1.4 },
		bloom = { Intensity = 1.0, Size = 36, Threshold = 1.0 },
		grade = { Brightness = 0.02, Contrast = 0.14, Saturation = 0.12, TintColor = Color3.fromRGB(225, 232, 255) },
		sunrays = { Intensity = 0, Spread = 0 },
		clouds = { Cover = 0.4, Density = 0.35, Color = Color3.fromRGB(90, 100, 160) },
	},
	noon = {
		ClockTime = 13.2, GeographicLatitude = 30, Brightness = 3, ExposureCompensation = 0,
		Ambient = Color3.fromRGB(110, 118, 130), OutdoorAmbient = Color3.fromRGB(140, 150, 165),
		ColorShift_Top = Color3.fromRGB(255, 248, 235), ColorShift_Bottom = Color3.fromRGB(90, 100, 120),
		atmosphere = { Density = 0.16, Offset = 0.05, Color = Color3.fromRGB(200, 222, 255),
			Decay = Color3.fromRGB(110, 134, 176), Glare = 0.15, Haze = 0.6 },
		bloom = { Intensity = 0.4, Size = 24, Threshold = 1.8 },
		grade = { Brightness = 0.02, Contrast = 0.08, Saturation = 0.15, TintColor = Color3.fromRGB(255, 252, 245) },
		sunrays = { Intensity = 0.05, Spread = 0.4 },
		clouds = { Cover = 0.5, Density = 0.4, Color = Color3.fromRGB(255, 255, 255) },
	},
	overcast = {
		ClockTime = 14, GeographicLatitude = 30, Brightness = 1.4, ExposureCompensation = 0.1,
		Ambient = Color3.fromRGB(110, 115, 125), OutdoorAmbient = Color3.fromRGB(130, 136, 146),
		ColorShift_Top = Color3.fromRGB(220, 225, 235), ColorShift_Bottom = Color3.fromRGB(80, 85, 95),
		atmosphere = { Density = 0.3, Offset = 0.04, Color = Color3.fromRGB(190, 196, 206),
			Decay = Color3.fromRGB(120, 126, 140), Glare = 0, Haze = 2.6 },
		bloom = { Intensity = 0.3, Size = 24, Threshold = 2 },
		grade = { Brightness = 0, Contrast = 0.06, Saturation = -0.05, TintColor = Color3.fromRGB(240, 244, 250) },
		sunrays = { Intensity = 0, Spread = 0 },
		clouds = { Cover = 0.85, Density = 0.7, Color = Color3.fromRGB(210, 214, 222) },
	},
}
WorldKit.moods = { "golden_hour", "dusk", "night", "noon", "overcast" }

local function ensure(parent, class, name)
	local inst = parent:FindFirstChild(name or class)
	if not inst or not inst:IsA(class) then
		inst = Instance.new(class)
		inst.Name = name or class
		inst.Parent = parent
	end
	return inst
end

-- WorldKit.lighting(mood, {sky=Color3|"#hex", haze=Color3, sun=Color3, strength=0..1}) applies a tuned preset; the
-- optional tints pull the atmosphere, haze and sun toward the game's palette by `strength` (default 0.35).
function WorldKit.lighting(mood, tint)
	local p = PRESETS[mood or "golden_hour"] or PRESETS.golden_hour
	tint = tint or {}
	local k = tint.strength or 0.35
	for _, prop in ipairs({ "ClockTime", "GeographicLatitude", "Brightness", "ExposureCompensation", "Ambient",
		"OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom" }) do
		pcall(function() Lighting[prop] = p[prop] end)
	end
	pcall(function()
		Lighting.EnvironmentDiffuseScale = 1
		Lighting.EnvironmentSpecularScale = 1
		Lighting.GlobalShadows = true
	end)
	local atm = ensure(Lighting, "Atmosphere")
	for prop, v in pairs(p.atmosphere) do
		atm[prop] = v
	end
	local sky = c3(tint.sky, nil)
	if sky then atm.Color = atm.Color:Lerp(sky, k) end
	local haze = c3(tint.haze, nil)
	if haze then atm.Decay = atm.Decay:Lerp(haze, k) end
	local bloom = ensure(Lighting, "BloomEffect", "KitBloom")
	for prop, v in pairs(p.bloom) do bloom[prop] = v end
	local grade = ensure(Lighting, "ColorCorrectionEffect", "KitGrade")
	for prop, v in pairs(p.grade) do grade[prop] = v end
	local sun = c3(tint.sun, nil)
	if sun then grade.TintColor = grade.TintColor:Lerp(sun, k * 0.5) end
	local rays = ensure(Lighting, "SunRaysEffect", "KitSunRays")
	for prop, v in pairs(p.sunrays) do rays[prop] = v end
	local terrain = Workspace.Terrain
	local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	for prop, v in pairs(p.clouds) do clouds[prop] = v end
	clouds.Parent = terrain
	-- Live: games call the preset and then write their style token's ClockTime 16.5 right after it, which renders as
	-- flat noon haze. For the first seconds after a preset, a "late afternoon" write is read as "golden" and kept
	-- golden; a day-cycle that moves the clock later is left alone.
	local want = p.ClockTime
	local guardUntil = os.clock() + 20
	local conn
	conn = Lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
		if os.clock() > guardUntil then
			conn:Disconnect()
			return
		end
		local t = Lighting.ClockTime
		if t >= 15.5 and t < 17.4 and math.abs(t - want) > 0.05 then
			Lighting.ClockTime = want
		end
	end)
	-- Other games' leftovers fight the preset: an old Sky with a fixed skybox, or a second Atmosphere.
	for _, ch in ipairs(Lighting:GetChildren()) do
		if ch:IsA("Atmosphere") and ch ~= atm then ch:Destroy() end
	end
	return atm
end

-- ---------------------------------------------------------------------------------------------------- terrain

-- WorldKit.water({level=0, size=2048, color, depth=24}): a Terrain sea under everything (hides the void, reflects
-- the sky). Call once.
function WorldKit.water(opts)
	opts = opts or {}
	local terrain = Workspace.Terrain
	local level, size, depth = opts.level or 0, opts.size or 2048, opts.depth or 24
	terrain:FillBlock(CFrame.new(0, level - depth / 2, 0), Vector3.new(size, depth, size), Enum.Material.Water)
	terrain.WaterColor = c3(opts.color, Color3.fromRGB(46, 118, 132))
	terrain.WaterTransparency = opts.transparency or 0.35
	terrain.WaterReflectance = opts.reflectance or 0.55
	terrain.WaterWaveSize = opts.waveSize or 0.12
	terrain.WaterWaveSpeed = opts.waveSpeed or 6
	return level
end

-- WorldKit.ground({center, size=Vector3(512,8,512), material=Grass}) a flat terrain ground slab.
function WorldKit.ground(opts)
	opts = opts or {}
	local center = opts.center or Vector3.new(0, 0, 0)
	local size = opts.size or Vector3.new(512, 8, 512)
	Workspace.Terrain:FillBlock(CFrame.new(center - Vector3.new(0, size.Y / 2, 0)), size,
		opts.material or Enum.Material.Grass)
	return center
end

-- WorldKit.island({position, radius=40, height=16, top=Grass, side=Rock, seed, floating=true}) -> info
-- A smooth sculpted island: a domed grass cap over a lumpy rock body that tapers to a point underneath when
-- floating (or into the water when not). info = {top = Vector3 (centre of the walkable top), radius, position}.
function WorldKit.island(opts)
	opts = opts or {}
	local terrain = Workspace.Terrain
	local pos = opts.position or Vector3.new(0, 30, 0)
	local r = opts.radius or 40
	local h = opts.height or 16
	local top = opts.top or Enum.Material.Grass
	local side = opts.side or Enum.Material.Rock
	local rand = rng(opts.seed or math.floor(pos.X * 7 + pos.Z * 13))
	-- rock body: stacked shrinking balls, jittered so the silhouette is organic
	local layers = opts.floating == false and 2 or 5
	for i = 0, layers do
		local t = i / math.max(1, layers)
		local lr = r * (1 - 0.75 * t)
		for _ = 1, 3 do
			local off = Vector3.new(rand:NextNumber(-0.25, 0.25) * lr, 0, rand:NextNumber(-0.25, 0.25) * lr)
			-- Keep every ball's top under the walkable cap (live: a wide flat island, radius 30 / height 8, grew a
			-- rock dome 15 studs over its own top and players spawned beside a boulder).
			local br = lr * rand:NextNumber(0.55, 0.75)
			terrain:FillBall(pos + off - Vector3.new(0, h * 0.3 + br * 0.85 + t * r * 0.6, 0), br, side)
		end
	end
	-- flat-ish walkable top: a wide low cylinder, then a soft grass cap so edges round over
	terrain:FillCylinder(CFrame.new(pos), h * 0.6, r, side)
	terrain:FillCylinder(CFrame.new(pos + Vector3.new(0, h * 0.3, 0)), h * 0.25, r * 0.97, top)
	for _ = 1, 5 do
		local a = rand:NextNumber(0, math.pi * 2)
		local d = rand:NextNumber(0.2, 0.7) * r
		terrain:FillBall(pos + Vector3.new(math.cos(a) * d, h * 0.25, math.sin(a) * d), r * rand:NextNumber(0.25, 0.4), top)
	end
	local info = { position = pos, radius = r, top = pos + Vector3.new(0, h * 0.42, 0) }
	-- Live: games built their islands away from the origin and players spawned on the template's pad in the void.
	-- The first island takes the spawn unless the game already moved it; spawn=true forces it.
	WorldKit.claimSpawn(info.top, opts.spawn == true)
	return info
end

-- WorldKit.claimSpawn(position, force): put the place's SpawnLocation (made if missing) on `position`. Without
-- force it only moves a spawn that is still the untouched template pad at the origin.
function WorldKit.claimSpawn(position, force)
	local spawn = Workspace:FindFirstChildOfClass("SpawnLocation")
	if spawn and not force and (spawn.Position.Magnitude > 4 or spawn:GetAttribute("KitSpawnClaimed")) then
		return spawn
	end
	if not spawn then
		spawn = Instance.new("SpawnLocation")
		spawn.Parent = Workspace
	end
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.Transparency = 1
	spawn.CanCollide = true
	spawn.Neutral = true
	-- The island's grass bumps rise above its nominal top (live: players spawned INSIDE the terrain, camera buried):
	-- stand on whatever is really there, found by a ray from well above.
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { spawn }
	local hit = Workspace:Raycast(position + Vector3.new(0, 400, 0), Vector3.new(0, -800, 0), params)
	if hit then
		position = hit.Position
	end
	local old = spawn.Position
	spawn.CFrame = CFrame.new(position + Vector3.new(0, 0.6, 0))
	spawn:SetAttribute("KitSpawnClaimed", true)
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	-- Characters spawn the moment play starts, before the world is built: move anyone still standing where the old
	-- spawn was (or falling into the void) onto the new one.
	local Players = game:GetService("Players")
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root and ((root.Position - old).Magnitude < 40 or root.Position.Y < position.Y - 60) then
			char:PivotTo(CFrame.new(position + Vector3.new(0, 4, 0)))
		end
	end
	return spawn
end

-- WorldKit.hill / WorldKit.rock: terrain bumps for variety
function WorldKit.hill(opts)
	opts = opts or {}
	Workspace.Terrain:FillBall(opts.position or Vector3.zero, opts.radius or 20, opts.material or Enum.Material.Grass)
end

function WorldKit.rock(opts)
	opts = opts or {}
	local rand = rng(opts.seed)
	local s = opts.size or 6
	local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(s * 1.3, s, s * 1.1),
		Material = Enum.Material.Slate, Color = c3(opts.color, Color3.fromRGB(122, 112, 104)),
		CFrame = CFrame.new(opts.position or Vector3.zero)
			* CFrame.Angles(rand:NextNumber(-0.4, 0.4), rand:NextNumber(0, 6.28), rand:NextNumber(-0.4, 0.4)),
		Parent = opts.parent or WorldKit.folder("WorldKit") })
	return p
end

-- ---------------------------------------------------------------------------------------------------- props

-- WorldKit.tree({position, height=16, style="blossom"|"round"|"pine", leaf=Color3, trunk=Color3, seed}) -> Model
function WorldKit.tree(opts)
	opts = opts or {}
	local rand = rng(opts.seed)
	local h = opts.height or 16
	local style = opts.style or "round"
	local leafDefault = style == "blossom" and Color3.fromRGB(255, 176, 198)
		or style == "pine" and Color3.fromRGB(58, 110, 74) or Color3.fromRGB(96, 160, 82)
	local leaf = c3(opts.leaf, leafDefault)
	local trunkCol = c3(opts.trunk, Color3.fromRGB(110, 76, 58))
	local base = opts.position or Vector3.zero
	local m = Instance.new("Model")
	m.Name = "Tree"
	local trunk = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(h * 0.7, h * 0.12, h * 0.12),
		CFrame = CFrame.new(base + Vector3.new(0, h * 0.35, 0)) * CFrame.Angles(0, 0, math.rad(90))
			* CFrame.Angles(rand:NextNumber(-0.06, 0.06), 0, 0),
		Material = Enum.Material.Wood, Color = trunkCol, Parent = m })
	m.PrimaryPart = trunk
	if style == "pine" then
		for i = 0, 3 do
			local w = h * (0.7 - i * 0.15)
			part({ ClassName = "WedgePart", Size = Vector3.new(w, h * 0.3, w), Material = Enum.Material.SmoothPlastic,
				Color = leaf:Lerp(Color3.new(1, 1, 1), i * 0.04),
				CFrame = CFrame.new(base + Vector3.new(0, h * (0.4 + i * 0.17), 0)) * CFrame.Angles(0, i * 0.8, 0),
				Parent = m })
		end
	else
		local n = style == "blossom" and 7 or 5
		for i = 1, n do
			local a = (i / n) * math.pi * 2 + rand:NextNumber(-0.4, 0.4)
			local d = i == 1 and 0 or h * rand:NextNumber(0.15, 0.3)
			local s = h * rand:NextNumber(0.38, 0.55)
			part({ Shape = Enum.PartType.Ball, Size = Vector3.new(s, s * 0.85, s),
				Material = style == "blossom" and Enum.Material.SmoothPlastic or Enum.Material.Grass,
				Color = leaf:Lerp(Color3.new(1, 1, 1), rand:NextNumber(0, 0.12)),
				CFrame = CFrame.new(base + Vector3.new(math.cos(a) * d, h * rand:NextNumber(0.72, 0.92), math.sin(a) * d)),
				Parent = m })
		end
	end
	m.Parent = opts.parent or WorldKit.folder("WorldKit")
	return m
end

-- WorldKit.lamp({position, color, height=9, brightness=2, range=18}) -> Model: a post with a glowing head
function WorldKit.lamp(opts)
	opts = opts or {}
	local base = opts.position or Vector3.zero
	local h = opts.height or 9
	local col = c3(opts.color, Color3.fromRGB(255, 196, 110))
	local m = Instance.new("Model")
	m.Name = "Lamp"
	part({ Size = Vector3.new(0.6, h, 0.6), CFrame = CFrame.new(base + Vector3.new(0, h / 2, 0)),
		Material = Enum.Material.Metal, Color = c3(opts.post, Color3.fromRGB(58, 46, 44)), Parent = m })
	local head = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 1.8, 1.8),
		CFrame = CFrame.new(base + Vector3.new(0, h + 0.6, 0)), Material = Enum.Material.Neon, Color = col,
		CastShadow = false, Parent = m })
	local light = Instance.new("PointLight")
	light.Color = col
	light.Brightness = opts.brightness or 2
	light.Range = opts.range or 18
	light.Shadows = false
	light.Parent = head
	m.PrimaryPart = head
	m.Parent = opts.parent or WorldKit.folder("WorldKit")
	return m
end

-- WorldKit.lantern({position, size=3, color, paper, glow=true}) -> Model: a paper lantern (glowing core, ribs, cap)
function WorldKit.lantern(opts)
	opts = opts or {}
	local s = opts.size or 3
	local pos = opts.position or Vector3.zero
	local col = c3(opts.color, Color3.fromRGB(255, 170, 80))
	local m = Instance.new("Model")
	m.Name = "Lantern"
	local body = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(s, s * 1.25, s), CFrame = CFrame.new(pos),
		Material = Enum.Material.Neon, Color = col, CastShadow = false, Transparency = 0.05, Parent = m })
	for _, y in ipairs({ -0.62, 0.62 }) do
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.12, s * 0.62, s * 0.62),
			CFrame = CFrame.new(pos + Vector3.new(0, y * s, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Wood, Color = c3(opts.cap, Color3.fromRGB(90, 40, 36)), Parent = m })
	end
	if opts.glow ~= false then
		local light = Instance.new("PointLight")
		light.Color = col
		light.Brightness = opts.brightness or 2.2
		light.Range = opts.range or s * 6
		light.Parent = body
	end
	m.PrimaryPart = body
	m.Parent = opts.parent or WorldKit.folder("WorldKit")
	return m
end

-- WorldKit.bridge({from, to, width=6, style="planks"|"glow", color}) -> Model: a plank bridge (or glowing tiles)
function WorldKit.bridge(opts)
	opts = opts or {}
	local a, b = opts.from or Vector3.zero, opts.to or Vector3.new(0, 0, 40)
	local w = opts.width or 6
	local dir = b - a
	local len = dir.Magnitude
	local n = math.max(2, math.floor(len / 2.2))
	local m = Instance.new("Model")
	m.Name = "Bridge"
	local cf = CFrame.lookAt(a, b)
	for i = 0, n - 1 do
		local t = (i + 0.5) / n
		local sag = math.sin(t * math.pi) * len * 0.04
		local glow = opts.style == "glow"
		part({ Size = Vector3.new(w, 0.6, len / n * 0.82),
			CFrame = cf * CFrame.new(0, -sag, -t * len) * CFrame.Angles(0, 0, (i % 2 == 0 and 0.015 or -0.015)),
			Material = glow and Enum.Material.Neon or Enum.Material.WoodPlanks,
			Color = c3(opts.color, glow and Color3.fromRGB(255, 200, 120) or Color3.fromRGB(150, 104, 72)),
			Parent = m })
	end
	for _, side in ipairs({ -1, 1 }) do
		local rope = part({ Size = Vector3.new(0.25, 0.25, len), CFrame = cf * CFrame.new(side * w / 2, 1.8, -len / 2),
			Material = Enum.Material.Fabric, Color = Color3.fromRGB(196, 168, 128), Parent = m })
		rope.CastShadow = false
	end
	m.Parent = opts.parent or WorldKit.folder("WorldKit")
	return m
end

-- WorldKit.scatter(island, {trees=6, rocks=3, lamps=2, style="blossom", leaf, seed}): dress an island's top
function WorldKit.scatter(island, opts)
	opts = opts or {}
	local rand = rng(opts.seed or math.floor(island.position.X + island.position.Z))
	local function spot(minF, maxF)
		local a = rand:NextNumber(0, math.pi * 2)
		local d = rand:NextNumber(minF, maxF) * island.radius
		return island.top + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
	end
	local made = {}
	for i = 1, opts.trees or 4 do
		table.insert(made, WorldKit.tree({ position = spot(0.25, 0.75), height = rand:NextNumber(12, 20),
			style = opts.style or "round", leaf = opts.leaf, seed = rand:NextInteger(1, 1e6), parent = opts.parent }))
	end
	for i = 1, opts.rocks or 2 do
		table.insert(made, WorldKit.rock({ position = spot(0.5, 0.85), size = rand:NextNumber(3, 7),
			seed = rand:NextInteger(1, 1e6), parent = opts.parent }))
	end
	for i = 1, opts.lamps or 0 do
		table.insert(made, WorldKit.lamp({ position = spot(0.55, 0.85), color = opts.lampColor, parent = opts.parent }))
	end
	return made
end

-- WorldKit.archipelago({count=6, center, spread=180, height=40, radius={24,48}, seed, style, water=true}) -> {islands}
-- One call for a whole floating-island world: water, islands at varied heights, dressing on each.
function WorldKit.archipelago(opts)
	opts = opts or {}
	local rand = rng(opts.seed or 7)
	local center = opts.center or Vector3.new(0, 0, 0)
	if opts.water ~= false then
		WorldKit.water({ level = center.Y, color = opts.waterColor })
	end
	local islands = {}
	local count = opts.count or 6
	for i = 1, count do
		local a = (i / count) * math.pi * 2 + rand:NextNumber(-0.3, 0.3)
		local d = i == 1 and 0 or (opts.spread or 180) * rand:NextNumber(0.55, 1)
		local r = i == 1 and (opts.radius and opts.radius[2] or 48) or rand:NextNumber(
			opts.radius and opts.radius[1] or 24, opts.radius and opts.radius[2] or 44)
		local pos = center + Vector3.new(math.cos(a) * d, (opts.height or 40) + rand:NextNumber(-12, 18), math.sin(a) * d)
		local isl = WorldKit.island({ position = pos, radius = r, height = r * 0.4, seed = i * 101 + (opts.seed or 7),
			top = opts.top, side = opts.side })
		WorldKit.scatter(isl, { trees = math.floor(r / 10), rocks = 2, lamps = opts.lamps or 1, style = opts.style,
			leaf = opts.leaf, lampColor = opts.lampColor, seed = i * 31 })
		table.insert(islands, isl)
	end
	return islands
end

return WorldKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">WorldKit2</string>
          <string name="Source"><![CDATA[--!nonstrict
-- WorldKit2: genre-general world builders on top of WorldKit (every WorldKit.* call still works through this module).
-- Biomes, course/obby/arena/room/town/dungeon builders, and a part-built prop library. Everything is palette-aware:
-- colours come from LookKit.palette (call LookKit.apply first) unless opts.palette / opts.color override them.
-- All geometry is anchored; tiny bits never cast shadows and decorative bits never collide. Server or edit mode.
--
-- Engine facts this file is written around:
--   * Part Shape=Cylinder lies along X: vertical cylinders are rotated 90 degrees about Z (vcyl below).
--   * Part Shape=Ball is always a sphere: flattened blobs (canopies, caps, bushes) use a block Part with a
--     SpecialMesh(MeshType=Sphere), which renders the part's full non-uniform size.
--   * No MeshParts and no mesh asset ids anywhere: an empty MeshPart is invisible.
-- Gameplay hooks are CollectionService tags (KitMover, KitSpinner, KitCrumble, KitBounce, KitCoin, KitGem, KitGoal,
-- KitCheckpoint, KitGate, KitSpawn, KitStation) plus attributes; WorldKit2.animate() drives the moving ones.

local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Kit = script.Parent
local WorldKit = require(Kit:WaitForChild("WorldKit"))
local LookKit = require(Kit:WaitForChild("LookKit"))

local WK2 = setmetatable({}, { __index = WorldKit })
WK2.WorldKit = WorldKit
WK2.LookKit = LookKit

local M = Enum.Material
local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local PI = math.pi
local rad = math.rad

local function c3(v, fallback)
	if typeof(v) == "Color3" then
		return v
	end
	if type(v) == "string" then
		local ok, col = pcall(Color3.fromHex, v)
		if ok then
			return col
		end
	end
	return fallback
end

local function toCF(v)
	if typeof(v) == "Vector3" then
		return CF(v)
	end
	return v
end

local function folder(name, parent)
	parent = parent or Workspace
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end
WK2.folder = function(name)
	return folder(name)
end

-- palette for one call: the look's palette, then opts.palette overrides
local function palOf(o)
	local pal = {}
	for k, v in pairs(LookKit.palette) do pal[k] = v end
	if o and o.palette then
		for k, v in pairs(o.palette) do pal[k] = c3(v, pal[k]) end
	end
	return pal
end

local function mat(role)
	return LookKit.mat(role)
end

local function shade(col, k)
	-- k < 0 darkens, k > 0 lightens
	if k < 0 then
		return col:Lerp(Color3.new(0, 0, 0), -k)
	end
	return col:Lerp(Color3.new(1, 1, 1), k)
end

local function jitter(col, r, amt)
	local h, s, v = col:ToHSV()
	return Color3.fromHSV((h + r:NextNumber(-amt, amt) * 0.15) % 1, math.clamp(s + r:NextNumber(-amt, amt), 0, 1),
		math.clamp(v + r:NextNumber(-amt, amt), 0, 1))
end

local function mk(m, size, cf, color, material, shape, class)
	local p = Instance.new(class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		(p :: any).Shape = shape -- before Size: a later Shape write re-squares the part
	end
	p.Size = size
	p.CFrame = toCF(cf)
	p.Color = color
	p.Material = material or mat("default")
	local big = math.max(size.X, size.Y, size.Z)
	p.CastShadow = big >= 1.6
	if big < 0.6 then
		p.CanCollide = false
	end
	p.Parent = m
	return p
end

local function box(m, size, cf, color, material)
	return mk(m, size, cf, color, material)
end
-- vertical cylinder centred at cf
local function vcyl(m, h, d, cf, color, material)
	return mk(m, V3(h, d, d), toCF(cf) * ANG(0, 0, PI / 2), color, material, Enum.PartType.Cylinder)
end
-- cylinder along cf's X axis
local function hcyl(m, len, d, cf, color, material)
	return mk(m, V3(len, d, d), cf, color, material, Enum.PartType.Cylinder)
end
local function ball(m, d, cf, color, material)
	return mk(m, V3(d, d, d), cf, color, material, Enum.PartType.Ball)
end
-- ellipsoid of any size (block part rendered through a SpecialMesh sphere; collides as its box)
local function blob(m, size, cf, color, material)
	local p = mk(m, size, cf, color, material)
	local sm = Instance.new("SpecialMesh")
	sm.MeshType = Enum.MeshType.Sphere
	sm.Parent = p
	return p
end
local function wedge(m, size, cf, color, material)
	return mk(m, size, cf, color, material, nil, "WedgePart")
end
local function light(parent, color, brightness, range, kind)
	local l = Instance.new(kind or "PointLight")
	l.Color = color
	l.Brightness = brightness or 1.5
	l.Range = range or 14
	l.Shadows = false
	l.Parent = parent
	return l
end
local function decor(m)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CastShadow = false
		end
	end
end
local function tag(inst, t, attrs)
	CollectionService:AddTag(inst, t)
	for k, v in pairs(attrs or {}) do
		inst:SetAttribute(k, v)
	end
	return inst
end
WK2._helpers = { box = box, vcyl = vcyl, hcyl = hcyl, ball = ball, blob = blob, wedge = wedge, light = light }

-- ---------------------------------------------------------------------------------------------------- props
-- Each builder makes the prop around the origin (ground at y=0, front facing -Z) and returns its main part.

local PROPS = {}

local function canopy(m, r, pal, h, size, leafA, leafB, material)
	local main = blob(m, V3(size, size * 0.82, size), V3(0, h, 0), leafA, material)
	local n = 4
	for i = 1, n do
		local a = i / n * PI * 2 + r:NextNumber(-0.4, 0.4)
		local d = size * r:NextNumber(0.28, 0.4)
		local s = size * r:NextNumber(0.5, 0.68)
		blob(m, V3(s, s * 0.8, s), V3(math.cos(a) * d, h + r:NextNumber(-0.15, 0.2) * size, math.sin(a) * d),
			i % 2 == 0 and leafB or leafA, material)
	end
	-- lit top highlight: reads as toon shading from any camera
	blob(m, V3(size * 0.6, size * 0.4, size * 0.6), V3(size * 0.08, h + size * 0.3, -size * 0.05),
		shade(leafB, 0.12), material)
	return main
end

PROPS.tree = function(m, o, r, pal)
	local style = o.style or "round"
	local h = o.height or r:NextNumber(12, 18)
	local wood, woodDark = c3(o.trunk, pal.wood), pal.woodDark
	local leafA = c3(o.color, style == "blossom" and pal.blossom or pal.leaf)
	local leafB = style == "blossom" and shade(leafA, 0.25) or pal.leafAlt
	local leafMat = mat("leaf")
	if style == "pine" then
		local trunk = vcyl(m, h * 0.3, h * 0.09, V3(0, h * 0.15, 0), woodDark, mat("wood"))
		local tiers = 4
		for i = 0, tiers - 1 do
			local t = i / tiers
			local d = h * (0.62 - t * 0.42)
			local y = h * (0.26 + t * 0.62)
			local col = leafA:Lerp(leafB, t * 0.6)
			vcyl(m, h * 0.13, d, V3(0, y, 0), col, leafMat)
			vcyl(m, h * 0.06, d * 0.78, V3(0, y + h * 0.09, 0), shade(col, -0.08), leafMat)
			if o.snow then
				vcyl(m, h * 0.03, d * 0.86, V3(0, y + h * 0.075, 0), pal.snow or Color3.new(1, 1, 1), mat("default"))
			end
		end
		ball(m, h * 0.12, V3(0, h * 0.9, 0), o.snow and (pal.snow or Color3.new(1, 1, 1)) or leafB, leafMat)
		return trunk
	elseif style == "palm" then
		local seg, lean = 6, r:NextNumber(0.08, 0.16)
		local pos, last = V3(0, 0, 0), nil
		for i = 1, seg do
			local up = CFrame.fromAxisAngle(V3(1, 0, 0), lean * i * 0.6)
			local step = up:VectorToWorldSpace(V3(0, h / seg, 0))
			local mid = pos + step / 2
			local p = vcyl(m, h / seg + 0.3, h * (0.085 - i * 0.006), CF(mid) * up,
				i % 2 == 0 and wood or shade(wood, -0.1), mat("wood"))
			last = last or p
			pos += step
		end
		for i = 1, 7 do
			local a = i / 7 * PI * 2 + r:NextNumber(-0.2, 0.2)
			local dir = V3(math.cos(a), 0, math.sin(a))
			local len = h * r:NextNumber(0.42, 0.55)
			local f1 = CFrame.lookAt(pos, pos + dir + V3(0, 0.35, 0))
			box(m, V3(h * 0.12, 0.35, len * 0.55), f1 * CF(0, 0, -len * 0.27), i % 2 == 0 and leafA or leafB, leafMat)
			local tip = f1 * CF(0, 0, -len * 0.55)
			local f2 = CFrame.lookAt(tip.Position, tip.Position + dir - V3(0, 0.9, 0))
			box(m, V3(h * 0.1, 0.3, len * 0.5), f2 * CF(0, 0, -len * 0.22), shade(leafA, -0.06), leafMat)
		end
		for i = 1, 3 do
			local a = i / 3 * PI * 2
			ball(m, h * 0.06, pos + V3(math.cos(a) * 0.7, -0.6, math.sin(a) * 0.7), pal.woodDark, mat("default"))
		end
		return last
	elseif style == "dead" then
		local trunk = vcyl(m, h * 0.75, h * 0.1, V3(0, h * 0.375, 0), shade(woodDark, -0.1), mat("wood"))
		for i = 1, 4 do
			local a = i / 4 * PI * 2 + r:NextNumber(-0.5, 0.5)
			local y = h * r:NextNumber(0.4, 0.72)
			local len = h * r:NextNumber(0.25, 0.4)
			local dir = V3(math.cos(a), r:NextNumber(0.5, 1.1), math.sin(a)).Unit
			local base = V3(0, y, 0)
			local cfb = CFrame.lookAt(base + dir * len / 2, base + dir * len)
			box(m, V3(h * 0.05, h * 0.05, len), cfb, shade(woodDark, -0.1), mat("wood"))
		end
		return trunk
	end
	-- round / blossom
	local trunk = vcyl(m, h * 0.6, h * 0.12, V3(0, h * 0.3, 0), wood, mat("wood"))
	vcyl(m, h * 0.1, h * 0.19, V3(0, h * 0.05, 0), shade(wood, -0.12), mat("wood"))
	canopy(m, r, pal, h * 0.72, h * 0.62, leafA, leafB, style == "blossom" and mat("default") or leafMat)
	if style == "blossom" then
		for _ = 1, 5 do
			local a = r:NextNumber(0, PI * 2)
			ball(m, 0.5, V3(math.cos(a) * h * 0.25, 0.25, math.sin(a) * h * 0.25), leafA, mat("default"))
		end
	end
	return trunk
end
for _, s in ipairs({ "round", "pine", "palm", "blossom", "dead" }) do
	PROPS[s == "dead" and "dead_tree" or (s == "round" and "round_tree" or s)] = function(m, o, r, pal)
		o.style = s
		return PROPS.tree(m, o, r, pal)
	end
end

PROPS.bush = function(m, o, r, pal)
	local s = o.size or r:NextNumber(3.5, 6)
	local a, b = c3(o.color, pal.leaf), pal.leafAlt
	local main = blob(m, V3(s, s * 0.7, s), V3(0, s * 0.3, 0), a, mat("leaf"))
	for i = 1, 3 do
		local ang = i / 3 * PI * 2 + r:NextNumber(-0.4, 0.4)
		local ss = s * r:NextNumber(0.55, 0.75)
		blob(m, V3(ss, ss * 0.75, ss), V3(math.cos(ang) * s * 0.35, ss * 0.32, math.sin(ang) * s * 0.35),
			i == 2 and b or a, mat("leaf"))
	end
	if o.berries or r:NextNumber() < 0.3 then
		for _ = 1, 4 do
			local ang = r:NextNumber(0, PI * 2)
			ball(m, 0.45, V3(math.cos(ang) * s * 0.45, s * r:NextNumber(0.3, 0.6), math.sin(ang) * s * 0.45),
				pal.flower, mat("default"))
		end
	end
	return main
end

PROPS.rock = function(m, o, r, pal)
	local s = o.size or r:NextNumber(3, 7)
	local col = c3(o.color, pal.rock)
	local main = box(m, V3(s * 1.2, s * 0.8, s), CF(0, s * 0.25, 0) * ANG(r:NextNumber(-0.3, 0.3),
		r:NextNumber(0, PI), r:NextNumber(-0.3, 0.3)), col, mat("stone"))
	box(m, V3(s * 0.7, s * 0.6, s * 0.65), CF(s * 0.5, s * 0.15, s * 0.2) * ANG(r:NextNumber(-0.5, 0.5),
		r:NextNumber(0, PI), r:NextNumber(-0.5, 0.5)), shade(col, -0.1), mat("stone"))
	if r:NextNumber() < 0.6 then
		box(m, V3(s * 0.45, s * 0.35, s * 0.4), CF(-s * 0.55, s * 0.08, -s * 0.3) * ANG(r:NextNumber(-0.5, 0.5),
			r:NextNumber(0, PI), 0), shade(col, 0.08), mat("stone"))
	end
	if o.moss then
		blob(m, V3(s * 0.9, s * 0.25, s * 0.8), V3(0, s * 0.62, 0), pal.leaf, mat("leaf"))
	end
	return main
end

PROPS.flowers = function(m, o, r, pal)
	local cols = { pal.flower, pal.blossom, pal.accent, pal.trim }
	local main
	for i = 1, o.count or 6 do
		local a, d = r:NextNumber(0, PI * 2), r:NextNumber(0, 1.6)
		local h = r:NextNumber(0.9, 1.6)
		local x, z = math.cos(a) * d, math.sin(a) * d
		local stem = box(m, V3(0.15, h, 0.15), V3(x, h / 2, z), pal.leaf, mat("default"))
		main = main or stem
		ball(m, 0.55, V3(x, h + 0.1, z), c3(o.color, cols[r:NextInteger(1, #cols)]), mat("default"))
		ball(m, 0.25, V3(x, h + 0.3, z), pal.gold, mat("default"))
	end
	decor(m)
	return main
end

PROPS.grass = function(m, o, r, pal)
	local main
	for i = 1, o.count or 7 do
		local a = r:NextNumber(0, PI * 2)
		local h = r:NextNumber(1, 2.2)
		local x, z = math.cos(a) * r:NextNumber(0, 0.9), math.sin(a) * r:NextNumber(0, 0.9)
		local bl = box(m, V3(0.25, h, 0.12), CF(x, h / 2 - 0.1, z) * ANG(r:NextNumber(-0.35, 0.35), a, r:NextNumber(-0.35, 0.35)),
			i % 2 == 0 and pal.leaf or pal.leafAlt, mat("default"))
		main = main or bl
	end
	decor(m)
	return main
end

PROPS.mushroom = function(m, o, r, pal)
	local h = o.height or r:NextNumber(2, 4)
	local stem = vcyl(m, h, h * 0.3, V3(0, h / 2, 0), pal.trim:Lerp(pal.sand, 0.3), mat("default"))
	local capCol = c3(o.color, pal.primary)
	blob(m, V3(h * 1.1, h * 0.55, h * 1.1), V3(0, h, 0), capCol, mat("default"))
	for i = 1, 5 do
		local a = i / 5 * PI * 2 + r:NextNumber(-0.3, 0.3)
		ball(m, h * 0.16, V3(math.cos(a) * h * 0.32, h + h * 0.17, math.sin(a) * h * 0.32), pal.trim, mat("default"))
	end
	return stem
end

PROPS.cactus = function(m, o, r, pal)
	local h = o.height or r:NextNumber(6, 10)
	local col = c3(o.color, pal.leaf)
	local d = h * 0.18
	local main = vcyl(m, h, d, V3(0, h / 2, 0), col, mat("leaf"))
	ball(m, d, V3(0, h, 0), shade(col, 0.08), mat("leaf"))
	for _, side in ipairs({ -1, 1 }) do
		if side == 1 or r:NextNumber() < 0.7 then
			local y = h * r:NextNumber(0.35, 0.55)
			local ad = d * 0.75
			hcyl(m, d * 1.3, ad, CF(side * d * 0.9, y, 0), col, mat("leaf"))
			local uh = h * r:NextNumber(0.25, 0.35)
			vcyl(m, uh, ad, V3(side * d * 1.5, y + uh / 2, 0), col, mat("leaf"))
			ball(m, ad, V3(side * d * 1.5, y + uh, 0), shade(col, 0.08), mat("leaf"))
		end
	end
	if r:NextNumber() < 0.5 then
		ball(m, d * 0.5, V3(0, h + d * 0.45, 0), pal.blossom, mat("default"))
	end
	return main
end

PROPS.crystal = function(m, o, r, pal)
	local h = o.height or r:NextNumber(4, 8)
	local col = c3(o.color, pal.glow)
	local main
	for i = 1, o.count or 4 do
		local hh = h * (i == 1 and 1 or r:NextNumber(0.4, 0.7))
		local w = hh * 0.28
		local a = i == 1 and 0 or r:NextNumber(0, PI * 2)
		local tilt = i == 1 and 0 or r:NextNumber(0.3, 0.6)
		local cfc = CF(math.cos(a) * w * 0.6, 0, math.sin(a) * w * 0.6) * ANG(0, a, 0) * ANG(tilt, 0, 0)
			* CF(0, hh / 2, 0) * ANG(0, PI / 4, 0)
		local p = box(m, V3(w, hh, w), cfc, i == 1 and col or shade(col, -0.15), M.Neon)
		p.Transparency = 0.15
		main = main or p
	end
	light(main, col, 1.6, h * 2.5)
	return main
end

PROPS.lollipop = function(m, o, r, pal)
	local h = o.height or r:NextNumber(8, 14)
	local stick = vcyl(m, h, h * 0.06, V3(0, h / 2, 0), pal.trim, mat("default"))
	local cols = pal.candy or { pal.primary, pal.secondary, pal.accent }
	local a, b = c3(o.color, cols[r:NextInteger(1, #cols)]), pal.trim
	local d = h * 0.55
	local face = CF(0, h + d * 0.35, 0) * ANG(0, r:NextNumber(0, PI), 0)
	for i = 0, 4 do
		hcyl(m, h * 0.08 + i * 0.12, d * (1 - i * 0.19), face, i % 2 == 0 and a or b, mat("default"))
	end
	return stick
end

PROPS.candy_cane = function(m, o, r, pal)
	local h = o.height or r:NextNumber(9, 14)
	local d = h * 0.11
	local a, b = c3(o.color, pal.primary), pal.trim
	local n = 8
	local main
	for i = 0, n - 1 do
		local p = vcyl(m, h / n, d, V3(0, (i + 0.5) * h / n, 0), i % 2 == 0 and a or b, mat("default"))
		main = main or p
	end
	local rr = h * 0.16
	for i = 0, 5 do
		local t = i / 5 * PI
		local pos = V3(rr - math.cos(t) * rr, h + math.sin(t) * rr, 0)
		ball(m, d, pos, i % 2 == 0 and b or a, mat("default"))
	end
	return main
end

PROPS.gumdrop = function(m, o, r, pal)
	local s = o.size or r:NextNumber(3, 6)
	local cols = pal.candy or { pal.primary, pal.secondary, pal.accent }
	local col = c3(o.color, cols[r:NextInteger(1, #cols)])
	local base = vcyl(m, s * 0.4, s, V3(0, s * 0.2, 0), col, mat("default"))
	blob(m, V3(s, s * 0.9, s), V3(0, s * 0.42, 0), col, mat("default"))
	for _ = 1, 6 do
		local a, y = r:NextNumber(0, PI * 2), r:NextNumber(0.3, 0.8)
		ball(m, s * 0.08, V3(math.cos(a) * s * 0.45 * (1.1 - y * 0.5), s * y, math.sin(a) * s * 0.45 * (1.1 - y * 0.5)),
			pal.trim, mat("default"))
	end
	return base
end

PROPS.asteroid = function(m, o, r, pal)
	local s = o.size or r:NextNumber(6, 16)
	local col = c3(o.color, pal.rock)
	local main = box(m, V3(s, s * 0.85, s * 0.9), CF(0, 0, 0) * ANG(r:NextNumber(0, PI), r:NextNumber(0, PI), 0), col,
		mat("stone"))
	for _ = 1, 3 do
		local off = V3(r:NextNumber(-1, 1), r:NextNumber(-1, 1), r:NextNumber(-1, 1)).Unit * s * 0.4
		box(m, V3(s, s, s) * r:NextNumber(0.45, 0.65), CF(off) * ANG(r:NextNumber(0, PI), r:NextNumber(0, PI), 0),
			shade(col, r:NextNumber(-0.15, 0.08)), mat("stone"))
	end
	if r:NextNumber() < 0.4 then
		local cr = box(m, V3(s * 0.15, s * 0.5, s * 0.15), CF(0, s * 0.5, 0) * ANG(0.3, 0, 0.2), pal.glow, M.Neon)
		light(cr, pal.glow, 1.2, s)
	end
	return main
end

PROPS.reeds = function(m, o, r, pal)
	local main
	for i = 1, o.count or 6 do
		local h = r:NextNumber(3, 6)
		local x, z = r:NextNumber(-1.2, 1.2), r:NextNumber(-1.2, 1.2)
		local st = box(m, V3(0.2, h, 0.2), CF(x, h / 2, z) * ANG(r:NextNumber(-0.15, 0.15), 0, r:NextNumber(-0.15, 0.15)),
			pal.leafAlt, mat("default"))
		main = main or st
		if i % 2 == 0 then
			vcyl(m, 0.9, 0.4, V3(x, h, z), pal.woodDark, mat("default"))
		end
	end
	decor(m)
	return main
end

PROPS.lily_pad = function(m, o, r, pal)
	local d = o.size or r:NextNumber(2.5, 4)
	local pad = vcyl(m, 0.15, d, V3(0, 0.1, 0), pal.leaf, mat("default"))
	if r:NextNumber() < 0.4 then
		ball(m, 0.6, V3(d * 0.15, 0.4, 0), pal.blossom, mat("default"))
	end
	decor(m)
	return pad
end

PROPS.log = function(m, o, r, pal)
	local len = o.length or r:NextNumber(6, 10)
	local d = len * 0.18
	local main = hcyl(m, len, d, CF(0, d / 2, 0) * ANG(0, r:NextNumber(0, PI), 0), pal.wood, mat("wood"))
	hcyl(m, 0.1, d * 0.8, main.CFrame * CF(len / 2, 0, 0), pal.sand, mat("default"))
	hcyl(m, 0.1, d * 0.8, main.CFrame * CF(-len / 2, 0, 0), pal.sand, mat("default"))
	return main
end

PROPS.snowman = function(m, o, r, pal)
	local s = o.size or 3
	local white = pal.snow or Color3.new(1, 1, 1)
	local base = ball(m, s * 1.4, V3(0, s * 0.65, 0), white, mat("default"))
	ball(m, s * 1.05, V3(0, s * 1.75, 0), white, mat("default"))
	ball(m, s * 0.75, V3(0, s * 2.55, 0), white, mat("default"))
	local nose = box(m, V3(0.25, 0.25, s * 0.45), V3(0, s * 2.55, -s * 0.5), pal.accent, mat("default"))
	nose.CanCollide = false
	for _, x in ipairs({ -0.15, 0.15 }) do
		ball(m, 0.25, V3(x * s, s * 2.7, -s * 0.33), pal.ink, mat("default"))
	end
	box(m, V3(s * 1.1, s * 0.22, s * 0.9), V3(0, s * 2.18, 0), pal.primary, mat("fabric"))
	return base
end

-- ---- structures

PROPS.fence = function(m, o, r, pal)
	local len = o.length or 12
	local col = c3(o.color, o.style == "picket" and pal.trim or pal.wood)
	local n = math.max(1, math.floor(len / 4 + 0.5))
	local main = box(m, V3(len, 0.4, 0.3), V3(0, 2.4, 0), col, mat("wood"))
	box(m, V3(len, 0.4, 0.3), V3(0, 1.2, 0), col, mat("wood"))
	for i = 0, n do
		local x = -len / 2 + i * len / n
		box(m, V3(0.6, 3.2, 0.6), V3(x, 1.6, 0), shade(col, -0.08), mat("wood"))
		box(m, V3(0.8, 0.25, 0.8), V3(x, 3.3, 0), shade(col, 0.1), mat("wood"))
	end
	return main
end

PROPS.lamp = function(m, o, r, pal)
	local h = o.height or 11
	local col = c3(o.color, pal.glow)
	local post = c3(o.post, pal.ink:Lerp(pal.metal, 0.3))
	local base = vcyl(m, 0.8, 1.6, V3(0, 0.4, 0), post, mat("metal"))
	vcyl(m, h, 0.5, V3(0, h / 2, 0), post, mat("metal"))
	if o.style == "street" then
		box(m, V3(0.4, 0.4, 3), V3(0, h, -1.3), post, mat("metal"))
		local head = box(m, V3(1.4, 0.5, 2), V3(0, h - 0.2, -2.6), post, mat("metal"))
		local bulb = box(m, V3(1, 0.2, 1.6), V3(0, h - 0.5, -2.6), col, M.Neon)
		light(bulb, col, 2, 24, "SpotLight").Face = Enum.NormalId.Bottom
		local _ = head
	else
		box(m, V3(1.6, 0.3, 1.6), V3(0, h + 0.15, 0), post, mat("metal"))
		local glow = box(m, V3(1.2, 1.6, 1.2), V3(0, h + 1.1, 0), col, M.Neon)
		glow.CastShadow = false
		box(m, V3(1.8, 0.4, 1.8), V3(0, h + 2.1, 0), post, mat("metal"))
		ball(m, 0.5, V3(0, h + 2.5, 0), post, mat("metal"))
		light(glow, col, 1.8, 20)
	end
	return base
end
PROPS.streetlight = function(m, o, r, pal)
	o.style = "street"
	return PROPS.lamp(m, o, r, pal)
end

PROPS.torch = function(m, o, r, pal)
	local h = o.height or 5
	local stick = vcyl(m, h, 0.4, V3(0, h / 2, 0), pal.woodDark, mat("wood"))
	vcyl(m, 0.5, 0.8, V3(0, h, 0), pal.metal, mat("metal"))
	local flame = ball(m, 0.9, V3(0, h + 0.5, 0), c3(o.color, Color3.fromRGB(255, 150, 60)), M.Neon)
	flame.CanCollide = false
	local f = Instance.new("Fire")
	f.Size = 2
	f.Heat = 4
	f.Color = Color3.fromRGB(255, 140, 50)
	f.SecondaryColor = Color3.fromRGB(255, 60, 20)
	f.Parent = flame
	light(flame, Color3.fromRGB(255, 160, 80), 2, 18)
	return stick
end

PROPS.crate = function(m, o, r, pal)
	local s = o.size or 4
	local col = c3(o.color, pal.wood)
	local main = box(m, V3(s, s, s), V3(0, s / 2, 0), col, mat("wood"))
	local trim = shade(col, -0.22)
	local e = s * 0.12
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			box(m, V3(e, s + 0.02, e), V3(x * (s / 2 - e / 2 + 0.02), s / 2, z * (s / 2 - e / 2 + 0.02)), trim, mat("wood"))
		end
	end
	box(m, V3(s + 0.06, e, s + 0.06), V3(0, s - e / 2, 0), trim, mat("wood"))
	box(m, V3(s + 0.06, e, s + 0.06), V3(0, e / 2, 0), trim, mat("wood"))
	box(m, V3(e * 0.8, s * 1.25, 0.15), CF(0, s / 2, -s / 2 - 0.05) * ANG(0, 0, PI / 4), trim, mat("wood"))
	return main
end

PROPS.barrel = function(m, o, r, pal)
	local h = o.height or 4.4
	local col = c3(o.color, pal.wood)
	local main = vcyl(m, h, h * 0.7, V3(0, h / 2, 0), col, mat("wood"))
	vcyl(m, h * 0.7, h * 0.76, V3(0, h / 2, 0), shade(col, 0.06), mat("wood"))
	for _, y in ipairs({ 0.15, 0.85 }) do
		vcyl(m, 0.3, h * 0.74, V3(0, h * y, 0), pal.metal:Lerp(pal.ink, 0.4), mat("metal"))
	end
	vcyl(m, 0.12, h * 0.62, V3(0, h + 0.03, 0), shade(col, -0.15), mat("wood"))
	return main
end

PROPS.bench = function(m, o, r, pal)
	local w = o.length or 7
	local col = c3(o.color, pal.wood)
	local frame = pal.ink:Lerp(pal.metal, 0.4)
	local seat = box(m, V3(w, 0.35, 2), V3(0, 2, 0), col, mat("wood"))
	box(m, V3(w, 0.9, 0.35), CF(0, 3.1, 1.05) * ANG(rad(12), 0, 0), col, mat("wood"))
	box(m, V3(w, 0.9, 0.35), CF(0, 4.2, 1.28) * ANG(rad(12), 0, 0), col, mat("wood"))
	for _, x in ipairs({ -w / 2 + 0.6, w / 2 - 0.6 }) do
		box(m, V3(0.4, 2, 2), V3(x, 1, 0), frame, mat("metal"))
		box(m, V3(0.4, 2.8, 0.4), CF(x, 3.3, 1.2) * ANG(rad(12), 0, 0), frame, mat("metal"))
	end
	return seat
end

PROPS.sign = function(m, o, r, pal)
	local w, h = o.width or 6, o.height or 6
	local col = c3(o.color, pal.wood)
	local post = vcyl(m, h, 0.5, V3(0, h / 2, 0), shade(col, -0.2), mat("wood"))
	local board = box(m, V3(w, w * 0.45, 0.4), V3(0, h - w * 0.15, -0.3), col, mat("wood"))
	box(m, V3(w + 0.3, 0.25, 0.5), V3(0, h - w * 0.15 + w * 0.235, -0.3), shade(col, -0.2), mat("wood"))
	if o.text then
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.Parent = board
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Text = o.text
		t.TextScaled = true
		t.Font = Enum.Font.FredokaOne
		t.TextColor3 = pal.trim
		t.Parent = gui
	end
	return post
end

PROPS.flag = function(m, o, r, pal)
	local h = o.height or 12
	local pole = vcyl(m, h, 0.4, V3(0, h / 2, 0), pal.trim, mat("metal"))
	ball(m, 0.8, V3(0, h + 0.3, 0), pal.gold, mat("metal"))
	local col = c3(o.color, pal.primary)
	local cloth = box(m, V3(4.5, 2.8, 0.15), V3(2.4, h - 1.6, 0), col, mat("fabric"))
	box(m, V3(4.5, 0.5, 0.18), V3(2.4, h - 1.6, 0), pal.trim, mat("fabric"))
	cloth.CanCollide = false
	vcyl(m, 0.5, 1.6, V3(0, 0.25, 0), pal.ink:Lerp(pal.metal, 0.4), mat("metal"))
	return pole
end

local function gableRoof(m, w, d, y, rh, col, overhang)
	overhang = overhang or 1
	local half = d / 2 + overhang
	-- two wedges back to back: each slope faces outward, tall faces meet at the ridge
	wedge(m, V3(w + overhang * 2, rh, half), CF(0, y + rh / 2, -half / 2), col, mat("roof"))
	wedge(m, V3(w + overhang * 2, rh, half), CF(0, y + rh / 2, half / 2) * ANG(0, PI, 0), col, mat("roof"))
	box(m, V3(w + overhang * 2 + 0.2, 0.5, 0.7), V3(0, y + rh + 0.1, 0), shade(col, -0.2), mat("roof"))
end

local function window(m, cf, w, h, pal, lit)
	box(m, V3(w + 0.5, h + 0.5, 0.25), cf * CF(0, 0, -0.1), pal.trim, mat("default"))
	local g = box(m, V3(w, h, 0.3), cf * CF(0, 0, -0.15), lit and pal.glow or pal.sky:Lerp(pal.ink, 0.35),
		lit and M.Neon or M.Glass)
	g.CastShadow = false
	box(m, V3(0.2, h, 0.35), cf * CF(0, 0, -0.2), pal.trim, mat("default"))
	box(m, V3(w, 0.2, 0.35), cf * CF(0, 0, -0.2), pal.trim, mat("default"))
	box(m, V3(w + 0.9, 0.3, 0.7), cf * CF(0, -h / 2 - 0.25, -0.3), pal.trim, mat("default"))
	return g
end

PROPS.house = function(m, o, r, pal)
	local w, d = o.width or r:NextNumber(14, 20), o.depth or r:NextNumber(12, 16)
	local floors = o.floors or 1
	local fh = 9
	local h = fh * floors
	local wallCol = c3(o.color, jitter(pal.wall, r, 0.05))
	local main = box(m, V3(w, h, d), V3(0, h / 2, 0), wallCol, mat("wall"))
	box(m, V3(w + 0.4, 1, d + 0.4), V3(0, 0.5, 0), shade(wallCol, -0.25), mat("stone"))
	gableRoof(m, w, d, h, math.min(w, d) * 0.45, c3(o.roof, pal.roof), 1.2)
	-- door + step
	box(m, V3(3.6, 6.4, 0.4), V3(0, 3.6, -d / 2 - 0.1), pal.woodDark, mat("wood"))
	box(m, V3(4.4, 0.4, 0.5), V3(0, 6.9, -d / 2 - 0.15), pal.trim, mat("default"))
	ball(m, 0.4, V3(1.2, 3.4, -d / 2 - 0.35), pal.gold, mat("metal"))
	box(m, V3(5, 0.5, 2), V3(0, 0.25, -d / 2 - 1), pal.path, mat("stone"))
	for f = 0, floors - 1 do
		for _, x in ipairs({ -w * 0.3, w * 0.3 }) do
			window(m, CF(x, fh * f + 5, -d / 2), 3, 3, pal, o.lit)
		end
		if f > 0 then
			window(m, CF(0, fh * f + 5, -d / 2), 3, 3, pal, o.lit)
		end
		for _, z in ipairs({ -d * 0.2, d * 0.2 }) do
			window(m, CF(w / 2, fh * f + 5, z) * ANG(0, -PI / 2, 0), 2.6, 3, pal, o.lit)
			window(m, CF(-w / 2, fh * f + 5, z) * ANG(0, PI / 2, 0), 2.6, 3, pal, o.lit)
		end
	end
	if o.chimney ~= false then
		box(m, V3(2.2, h * 0.6 + 4, 2.2), V3(w * 0.28, h + 2, d * 0.15), pal.rock:Lerp(pal.roof, 0.3), mat("stone"))
	end
	return main
end

PROPS.shop = function(m, o, r, pal)
	local w, d, h = o.width or 18, o.depth or 14, o.height or 11
	local wallCol = c3(o.color, jitter(pal.wall, r, 0.06))
	local main = box(m, V3(w, h, d), V3(0, h / 2, 0), wallCol, mat("wall"))
	box(m, V3(w + 1, 1.2, d + 1), V3(0, h + 0.6, 0), pal.trim, mat("default"))
	box(m, V3(w + 1.2, 2.5, 0.6), V3(0, h + 1.8, -d / 2 - 0.1), wallCol, mat("wall")) -- false front
	window(m, CF(-w * 0.22, 4.2, -d / 2), w * 0.36, 4.4, pal, o.lit)
	box(m, V3(3.8, 6.6, 0.4), V3(w * 0.27, 3.5, -d / 2 - 0.1), pal.woodDark, mat("wood"))
	-- striped awning
	local stripes = math.max(4, math.floor(w / 2.2))
	local sw = (w + 1) / stripes
	for i = 0, stripes - 1 do
		local x = -w / 2 - 0.5 + (i + 0.5) * sw
		box(m, V3(sw, 0.3, 3.4), CF(x, 7.8, -d / 2 - 1.5) * ANG(rad(-25), 0, 0),
			i % 2 == 0 and c3(o.accent, pal.primary) or pal.trim, mat("fabric"))
	end
	local sign = box(m, V3(w * 0.6, 2, 0.5), V3(0, h - 1.4, -d / 2 - 0.3), c3(o.accent, pal.secondary), mat("default"))
	if o.text then
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.Parent = sign
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.TextScaled = true
		t.Font = Enum.Font.FredokaOne
		t.Text = o.text
		t.TextColor3 = pal.trim
		t.Parent = gui
	end
	return main
end

PROPS.tower = function(m, o, r, pal)
	local style = o.style or "castle"
	local h = o.height or r:NextNumber(24, 36)
	if style == "skyscraper" or style == "neon" then
		local w = o.width or r:NextNumber(14, 22)
		local col = c3(o.color, style == "neon" and pal.wall or jitter(pal.wall, r, 0.05))
		local main = box(m, V3(w, h, w), V3(0, h / 2, 0), col, mat("wall"))
		local neon = pal.neon or { pal.primary, pal.secondary }
		local stripCol = neon[r:NextInteger(1, #neon)]
		local floors = math.floor(h / 6)
		for f = 1, floors - 1 do
			local y = f * 6
			local g = box(m, V3(w + 0.2, 2.4, w + 0.2), V3(0, y - 1.6, 0), style == "neon" and pal.ink:Lerp(stripCol, 0.15)
				or pal.sky:Lerp(pal.ink, 0.4), M.Glass)
			g.CastShadow = false
			if style == "neon" and f % 3 == 0 then
				local s = box(m, V3(w + 0.4, 0.3, w + 0.4), V3(0, y, 0), stripCol, M.Neon)
				s.CastShadow = false
			end
		end
		box(m, V3(w * 0.6, 3, w * 0.6), V3(0, h + 1.5, 0), shade(col, -0.15), mat("metal"))
		if style == "neon" then
			for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
				local e = box(m, V3(0.4, h, 0.4), V3(c[1] * (w / 2 + 0.1), h / 2, c[2] * (w / 2 + 0.1)), stripCol, M.Neon)
				e.CastShadow = false
			end
			light(main, stripCol, 2, 30)
		end
		return main
	elseif style == "watchtower" then
		local w = 8
		local main
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
			local p = box(m, V3(0.9, h, 0.9), V3(c[1] * w / 2, h / 2, c[2] * w / 2), pal.wood, mat("wood"))
			main = main or p
		end
		box(m, V3(w + 3, 0.8, w + 3), V3(0, h, 0), pal.wood, mat("wood"))
		for _, c in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
			box(m, c[1] == 0 and V3(w + 3, 2.5, 0.4) or V3(0.4, 2.5, w + 3), V3(c[1] * (w + 3) / 2, h + 1.6,
				c[2] * (w + 3) / 2), shade(pal.wood, -0.1), mat("wood"))
		end
		gableRoof(m, w + 2, w + 2, h + 6, 4, pal.roof, 0.5)
		for _, c in ipairs({ { -1, -1 }, { 1, 1 } }) do
			box(m, V3(0.5, 6, 0.5), V3(c[1] * (w / 2 + 1), h + 3, c[2] * (w / 2 + 1)), pal.wood, mat("wood"))
		end
		return main
	end
	-- castle: round tower, crenellations, stepped cone roof
	local d = o.width or 12
	local stone = c3(o.color, pal.rock:Lerp(pal.wall, 0.4))
	local main = vcyl(m, h, d, V3(0, h / 2, 0), stone, mat("stone"))
	vcyl(m, 2, d + 1.6, V3(0, 1, 0), shade(stone, -0.15), mat("stone"))
	vcyl(m, 1.4, d + 1.4, V3(0, h, 0), shade(stone, 0.06), mat("stone"))
	for i = 0, 9 do
		local a = i / 10 * PI * 2
		box(m, V3(1.6, 1.8, 1.2), CF(math.cos(a) * (d / 2 + 0.3), h + 1.6, math.sin(a) * (d / 2 + 0.3)) * ANG(0, PI / 2 - a, 0),
			stone, mat("stone"))
	end
	if o.roof ~= false then
		for i = 0, 5 do
			vcyl(m, 1.6, (d + 1) * (1 - i / 6.5), V3(0, h + 2.5 + i * 1.5, 0), i % 2 == 0 and pal.roof or shade(pal.roof, -0.1),
				mat("roof"))
		end
		vcyl(m, 3, 0.3, V3(0, h + 12, 0), pal.metal, mat("metal"))
		box(m, V3(2, 1.2, 0.1), V3(1, h + 13, 0), pal.primary, mat("fabric"))
	end
	for i = 1, math.floor(h / 10) do
		window(m, CF(0, i * 9, -d / 2 - 0.05), 1.4, 2.6, pal, o.lit)
	end
	return main
end
PROPS.skyscraper = function(m, o, r, pal)
	o.style = o.style or "skyscraper"
	return PROPS.tower(m, o, r, pal)
end

PROPS.bridge = function(m, o, r, pal)
	local len, w = o.length or 30, o.width or 8
	local col = c3(o.color, pal.wood)
	local n = math.floor(len / 2)
	local main
	for i = 0, n - 1 do
		local z = -len / 2 + (i + 0.5) * len / n
		local arch = math.sin((i + 0.5) / n * PI) * len * 0.06
		local p = box(m, V3(w, 0.6, len / n - 0.15), V3(0, arch + 0.3, z), i % 2 == 0 and col or shade(col, -0.07),
			mat("wood"))
		main = main or p
		if i % 3 == 0 then
			for _, x in ipairs({ -w / 2, w / 2 }) do
				box(m, V3(0.5, 3, 0.5), V3(x, arch + 1.8, z), shade(col, -0.2), mat("wood"))
			end
		end
	end
	for _, x in ipairs({ -w / 2, w / 2 }) do
		for i = 0, n - 1 do
			local z0 = -len / 2 + i * len / n
			local z1 = z0 + len / n
			local y0 = math.sin(i / n * PI) * len * 0.06 + 3.1
			local y1 = math.sin((i + 1) / n * PI) * len * 0.06 + 3.1
			local a, b = V3(x, y0, z0), V3(x, y1, z1)
			box(m, V3(0.4, 0.4, (b - a).Magnitude + 0.1), CFrame.lookAt((a + b) / 2, b), shade(col, -0.2), mat("wood"))
		end
	end
	return main
end

PROPS.ramp = function(m, o, r, pal)
	local w, h, len = o.width or 10, o.height or 5, o.length or 14
	local col = c3(o.color, pal.accent)
	local main = wedge(m, V3(w, h, len), CF(0, h / 2, 0), col, mat("default"))
	for _, x in ipairs({ -w / 2 - 0.3, w / 2 + 0.3 }) do
		wedge(m, V3(0.6, h + 0.3, len), CF(x, (h + 0.3) / 2, 0), pal.trim, mat("default"))
	end
	tag(main, "KitRamp")
	return main
end

PROPS.coin = function(m, o, r, pal)
	local d = o.size or 2.4
	local coin = hcyl(m, 0.35, d, CF(0, 0, 0) * ANG(0, PI / 2, 0), c3(o.color, pal.gold), M.SmoothPlastic)
	hcyl(m, 0.45, d * 0.62, CF(0, 0, 0) * ANG(0, PI / 2, 0), shade(c3(o.color, pal.gold), 0.25), M.SmoothPlastic)
	decor(m)
	coin.CanQuery = true
	coin.CanTouch = true
	tag(coin, "KitCoin", { Value = o.value or 1 })
	return coin
end

PROPS.gem = function(m, o, r, pal)
	local s = o.size or 2
	local col = c3(o.color, pal.secondary)
	local g = box(m, V3(s, s, s), CF(0, 0, 0) * ANG(PI / 4, 0, PI / 4), col, M.Neon)
	g.Transparency = 0.1
	box(m, V3(s * 0.55, s * 0.55, s * 0.55), CF(0, 0, 0) * ANG(PI / 4, PI / 4, 0), shade(col, 0.35), M.Neon)
	light(g, col, 1.2, 8)
	decor(m)
	g.CanTouch = true
	g.CanQuery = true
	tag(g, "KitGem", { Value = o.value or 5 })
	return g
end

PROPS.chest = function(m, o, r, pal)
	local w = o.size or 4
	local col = c3(o.color, pal.wood)
	local main = box(m, V3(w, w * 0.55, w * 0.62), V3(0, w * 0.275, 0), col, mat("wood"))
	hcyl(m, w, w * 0.62, CF(0, w * 0.55, 0), shade(col, 0.05), mat("wood"))
	for _, x in ipairs({ -w * 0.35, w * 0.35 }) do
		box(m, V3(w * 0.1, w * 0.58, w * 0.66), V3(x, w * 0.29, 0), pal.gold, mat("metal"))
		hcyl(m, w * 0.1, w * 0.66, CF(x, w * 0.55, 0), pal.gold, mat("metal"))
	end
	box(m, V3(w * 0.18, w * 0.22, 0.2), V3(0, w * 0.5, -w * 0.32), pal.gold, mat("metal"))
	return main
end

-- ---- kitchen / interior (character is ~5 studs tall; counters 3.4)

local function station(main, kind)
	tag(main, "KitStation", { Station = kind })
	return main
end

local function cabinet(m, w, pal, col, top)
	local body = box(m, V3(w, 3.2, 3), V3(0, 1.6, 0), col, mat("wood"))
	box(m, V3(w + 0.3, 0.35, 3.3), V3(0, 3.38, -0.1), top, mat("stone"))
	box(m, V3(w - 0.2, 0.3, 0.1), V3(0, 0.15, -1.52), shade(col, -0.3), mat("default"))
	local doors = math.max(1, math.floor(w / 2))
	for i = 0, doors - 1 do
		local x = -w / 2 + (i + 0.5) * w / doors
		box(m, V3(w / doors - 0.3, 2.4, 0.1), V3(x, 1.75, -1.53), shade(col, 0.06), mat("wood"))
		box(m, V3(0.15, 0.6, 0.2), V3(x + (w / doors) * 0.3, 2.2, -1.62), pal.metal, mat("metal"))
	end
	return body
end

PROPS.counter = function(m, o, r, pal)
	local w = o.width or 4
	return station(cabinet(m, w, pal, c3(o.color, pal.secondary), pal.trim:Lerp(pal.rock, 0.25)), "counter")
end

PROPS.stove = function(m, o, r, pal)
	local w = o.width or 4
	local body = box(m, V3(w, 3.3, 3), V3(0, 1.65, 0), c3(o.color, pal.metal), mat("metal"))
	box(m, V3(w + 0.1, 0.25, 3.1), V3(0, 3.42, 0), pal.ink:Lerp(pal.metal, 0.2), mat("metal"))
	for _, x in ipairs({ -w * 0.24, w * 0.24 }) do
		for _, z in ipairs({ -0.6, 0.6 }) do
			vcyl(m, 0.15, 1.3, V3(x, 3.6, z), pal.ink, mat("metal"))
			local hot = vcyl(m, 0.17, 0.6, V3(x, 3.61, z), o.on == false and pal.ink or Color3.fromRGB(255, 90, 40), M.Neon)
			hot.CastShadow = false
		end
	end
	local glass = box(m, V3(w * 0.7, 1.4, 0.12), V3(0, 1.6, -1.52), pal.ink:Lerp(pal.glow, 0.25), M.Glass)
	glass.CastShadow = false
	box(m, V3(w * 0.6, 0.2, 0.3), V3(0, 2.55, -1.65), pal.metal, mat("metal"))
	for i = 0, 3 do
		vcyl(m, 0.15, 0.35, CF(-w * 0.36 + i * w * 0.24, 3.05, -1.6) * ANG(PI / 2, 0, 0), pal.ink, mat("metal"))
	end
	box(m, V3(w, 1.6, 0.3), V3(0, 4.2, 1.4), pal.metal, mat("metal"))
	return station(body, "stove")
end

PROPS.sink = function(m, o, r, pal)
	local w = o.width or 4
	local body = cabinet(m, w, pal, c3(o.color, pal.secondary), pal.trim:Lerp(pal.rock, 0.25))
	local basin = box(m, V3(w * 0.6, 0.12, 1.8), V3(0, 3.6, -0.1), pal.metal:Lerp(pal.ink, 0.2), mat("metal"))
	basin.CastShadow = false
	box(m, V3(w * 0.66, 0.35, 0.15), V3(0, 3.7, -1.05), pal.metal, mat("metal"))
	box(m, V3(w * 0.66, 0.35, 0.15), V3(0, 3.7, 0.85), pal.metal, mat("metal"))
	vcyl(m, 1.4, 0.3, V3(0, 4.3, 1.1), pal.metal, mat("metal"))
	box(m, V3(0.25, 0.25, 1), V3(0, 5, 0.65), pal.metal, mat("metal"))
	local water = box(m, V3(w * 0.55, 0.05, 1.6), V3(0, 3.68, -0.1), pal.water, M.Glass)
	water.Transparency = 0.4
	return station(body, "sink")
end

PROPS.fridge = function(m, o, r, pal)
	local col = c3(o.color, pal.trim:Lerp(pal.secondary, 0.25))
	local body = box(m, V3(3.6, 8, 3.2), V3(0, 4, 0), col, mat("default"))
	box(m, V3(3.5, 0.12, 0.1), V3(0, 5.2, -1.62), shade(col, -0.3), mat("default"))
	box(m, V3(0.25, 1.6, 0.35), V3(1.4, 6.4, -1.75), pal.metal, mat("metal"))
	box(m, V3(0.25, 2.4, 0.35), V3(1.4, 3.6, -1.75), pal.metal, mat("metal"))
	for i = 1, 3 do
		vcyl(m, 0.1, 0.45, CF(-0.8 + i * 0.4, 6.8 - i * 0.3, -1.62) * ANG(PI / 2, 0, 0),
			({ pal.primary, pal.accent, pal.secondary })[i], mat("default"))
	end
	return station(body, "fridge")
end

PROPS.table = function(m, o, r, pal)
	local w, d = o.width or 6, o.depth or 4
	local col = c3(o.color, pal.wood)
	local top
	if o.round then
		top = vcyl(m, 0.4, w, V3(0, 3.2, 0), col, mat("wood"))
		vcyl(m, 3, 0.7, V3(0, 1.5, 0), shade(col, -0.15), mat("wood"))
		vcyl(m, 0.3, w * 0.45, V3(0, 0.15, 0), shade(col, -0.15), mat("wood"))
	else
		top = box(m, V3(w, 0.4, d), V3(0, 3.2, 0), col, mat("wood"))
		for _, x in ipairs({ -w / 2 + 0.4, w / 2 - 0.4 }) do
			for _, z in ipairs({ -d / 2 + 0.4, d / 2 - 0.4 }) do
				box(m, V3(0.5, 3, 0.5), V3(x, 1.5, z), shade(col, -0.15), mat("wood"))
			end
		end
	end
	if o.cloth then
		local c = box(m, V3((o.round and w * 0.7 or w * 0.5), 0.05, (o.round and w * 0.7 or d + 0.2)), V3(0, 3.42, 0),
			c3(o.cloth, pal.fabric), mat("fabric"))
		c.CanCollide = false
	end
	return station(top, "table")
end

PROPS.chair = function(m, o, r, pal)
	local col = c3(o.color, pal.wood)
	local seat = box(m, V3(2.2, 0.3, 2.2), V3(0, 2, 0), col, mat("wood"))
	box(m, V3(2.2, 2.4, 0.3), V3(0, 3.3, 0.95), col, mat("wood"))
	for _, x in ipairs({ -0.9, 0.9 }) do
		for _, z in ipairs({ -0.9, 0.9 }) do
			box(m, V3(0.3, 2, 0.3), V3(x, 1, z), shade(col, -0.15), mat("wood"))
		end
	end
	return seat
end

PROPS.plate = function(m, o, r, pal)
	local d = o.size or 1.6
	local plate = vcyl(m, 0.12, d, V3(0, 0.06, 0), pal.trim, mat("default"))
	vcyl(m, 0.13, d * 0.65, V3(0, 0.07, 0), shade(pal.trim, -0.06), mat("default"))
	if o.food then
		blob(m, V3(d * 0.5, d * 0.25, d * 0.5), V3(0, 0.2, 0), c3(o.food, pal.accent), mat("default"))
	end
	decor(m)
	plate.CanQuery = true
	tag(plate, "KitPlate")
	return plate
end

PROPS.pot = function(m, o, r, pal)
	local col = c3(o.color, pal.ink:Lerp(pal.metal, 0.5))
	local body = vcyl(m, 1.3, 1.8, V3(0, 0.65, 0), col, mat("metal"))
	vcyl(m, 0.12, 1.9, V3(0, 1.36, 0), shade(col, -0.2), mat("metal"))
	ball(m, 0.35, V3(0, 1.5, 0), pal.ink, mat("metal"))
	for _, x in ipairs({ -1.05, 1.05 }) do
		box(m, V3(0.4, 0.2, 0.5), V3(x, 1.1, 0), shade(col, -0.2), mat("metal"))
	end
	return body
end

PROPS.shelf = function(m, o, r, pal)
	local w, h = o.width or 6, o.height or 7
	local col = c3(o.color, pal.wood)
	local back = box(m, V3(w, h, 0.3), V3(0, h / 2, 0.85), shade(col, -0.12), mat("wood"))
	for _, x in ipairs({ -w / 2, w / 2 }) do
		box(m, V3(0.3, h, 2), V3(x, h / 2, 0), col, mat("wood"))
	end
	local shelves = math.max(1, math.floor(h / 2.2))
	for i = 0, shelves do
		local y = 0.2 + i * (h - 0.4) / shelves
		box(m, V3(w, 0.25, 2), V3(0, y, 0), col, mat("wood"))
		if i < shelves then
			local x = -w / 2 + 0.4
			while x < w / 2 - 0.6 do
				local bw = r:NextNumber(0.35, 0.7)
				local bh = r:NextNumber(1, 1.7)
				if o.jars then
					local j = vcyl(m, bh * 0.8, 0.6, V3(x + 0.3, y + bh * 0.4 + 0.12, -0.1), jitter(pal.accent, r, 0.3), M.Glass)
					j.Transparency = 0.2
					x += 0.9
				else
					box(m, V3(bw, bh, 1.5), V3(x + bw / 2, y + bh / 2 + 0.12, 0),
						jitter(({ pal.primary, pal.secondary, pal.accent, pal.fabric })[r:NextInteger(1, 4)], r, 0.1), mat("default"))
					x += bw + 0.05
				end
			end
		end
	end
	return back
end
PROPS.bookshelf = PROPS.shelf

PROPS.bed = function(m, o, r, pal)
	local col = c3(o.color, pal.wood)
	local frame = box(m, V3(5, 1.4, 8), V3(0, 0.9, 0), col, mat("wood"))
	box(m, V3(5.4, 4, 0.5), V3(0, 2, 4), col, mat("wood"))
	box(m, V3(4.6, 0.8, 7.4), V3(0, 1.9, -0.1), pal.trim, mat("fabric"))
	box(m, V3(4.8, 0.5, 4.8), V3(0, 2.3, -1.4), c3(o.blanket, pal.primary), mat("fabric"))
	blob(m, V3(3.4, 0.8, 1.4), V3(0, 2.6, 2.9), pal.trim, mat("fabric"))
	return frame
end

PROPS.desk = function(m, o, r, pal)
	local w = o.width or 6
	local col = c3(o.color, pal.wood)
	local top = box(m, V3(w, 0.35, 3), V3(0, 3.1, 0), col, mat("wood"))
	box(m, V3(1.8, 2.9, 2.8), V3(w / 2 - 1, 1.45, 0), shade(col, -0.1), mat("wood"))
	box(m, V3(0.35, 2.9, 2.8), V3(-w / 2 + 0.3, 1.45, 0), shade(col, -0.1), mat("wood"))
	if o.computer ~= false then
		box(m, V3(2.6, 1.6, 0.2), V3(-0.4, 4.4, 0.6), pal.ink, mat("default"))
		local scr = box(m, V3(2.3, 1.3, 0.05), V3(-0.4, 4.4, 0.48), pal.secondary:Lerp(pal.light, 0.4), M.Neon)
		scr.CastShadow = false
		box(m, V3(0.3, 0.8, 0.3), V3(-0.4, 3.6, 0.7), pal.ink, mat("default"))
		box(m, V3(2, 0.1, 0.7), V3(-0.4, 3.32, -0.5), pal.ink:Lerp(pal.metal, 0.3), mat("default"))
	end
	return station(top, "desk")
end

PROPS.rug = function(m, o, r, pal)
	local w, d = o.width or 10, o.depth or 7
	local col = c3(o.color, pal.fabric)
	local rug
	if o.round then
		rug = vcyl(m, 0.1, w, V3(0, 0.05, 0), col, mat("fabric"))
		vcyl(m, 0.11, w * 0.7, V3(0, 0.06, 0), shade(col, 0.2), mat("fabric"))
	else
		rug = box(m, V3(w, 0.1, d), V3(0, 0.05, 0), col, mat("fabric"))
		box(m, V3(w - 1.2, 0.11, d - 1.2), V3(0, 0.06, 0), shade(col, 0.2), mat("fabric"))
		box(m, V3(w - 2.2, 0.12, d - 2.2), V3(0, 0.07, 0), col, mat("fabric"))
	end
	decor(m)
	return rug
end

PROPS.fireplace = function(m, o, r, pal)
	local w = o.width or 8
	local stone = pal.rock:Lerp(pal.wall, 0.2)
	local body = box(m, V3(w, 7, 3), V3(0, 3.5, 0.5), stone, mat("stone"))
	box(m, V3(w * 0.55, 3.6, 0.4), V3(0, 1.8, -1.05), pal.ink, mat("default"))
	box(m, V3(w + 1, 0.6, 3.6), V3(0, 7.2, 0.3), pal.wood, mat("wood"))
	box(m, V3(w * 0.6, 10, 2.4), V3(0, 12, 0.8), stone, mat("stone"))
	local fire = blob(m, V3(w * 0.3, 1.6, 0.8), V3(0, 1, -0.9), Color3.fromRGB(255, 140, 50), M.Neon)
	fire.CanCollide = false
	fire.CastShadow = false
	local f = Instance.new("Fire")
	f.Size = 3
	f.Heat = 6
	f.Parent = fire
	light(fire, Color3.fromRGB(255, 160, 90), 2.5, 24)
	return body
end

PROPS.plant = function(m, o, r, pal)
	local pot = vcyl(m, 1.6, 1.8, V3(0, 0.8, 0), c3(o.color, pal.primary:Lerp(pal.dirt, 0.4)), mat("default"))
	vcyl(m, 0.3, 2, V3(0, 1.6, 0), shade(pal.primary:Lerp(pal.dirt, 0.4), -0.1), mat("default"))
	for i = 1, 5 do
		local a = i / 5 * PI * 2
		blob(m, V3(0.9, 2.6, 0.4), CF(math.cos(a) * 0.4, 2.8, math.sin(a) * 0.4) * ANG(0, -a, 0) * ANG(0, 0, 0.5),
			i % 2 == 0 and pal.leaf or pal.leafAlt, mat("leaf"))
	end
	return pot
end

PROPS.lab_bench = function(m, o, r, pal)
	local w = o.width or 6
	local body = cabinet(m, w, pal, c3(o.color, pal.trim:Lerp(pal.metal, 0.4)), pal.ink:Lerp(pal.metal, 0.3))
	local cols = { pal.secondary, pal.primary, pal.leafAlt, pal.accent }
	for i = 1, 4 do
		local x = -w / 2 + i * w / 5
		local col = cols[(i - 1) % #cols + 1]
		local v = vcyl(m, 1.2, 0.5, V3(x, 4.15, 0.4), col, M.Neon)
		v.Transparency = 0.25
		v.CastShadow = false
	end
	light(body, pal.secondary, 1, 10)
	return station(body, "lab_bench")
end

PROPS.weapon_rack = function(m, o, r, pal)
	local w = o.width or 6
	local col = c3(o.color, pal.ink:Lerp(pal.metal, 0.35))
	local back = box(m, V3(w, 5, 0.4), V3(0, 2.5, 0.6), col, mat("metal"))
	box(m, V3(w, 0.5, 1.4), V3(0, 0.25, 0), col, mat("metal"))
	box(m, V3(w, 0.3, 0.8), V3(0, 3.6, 0.2), shade(col, 0.1), mat("metal"))
	local gun = pal.ink:Lerp(pal.metal, 0.15)
	for i = 1, o.count or 4 do
		local x = -w / 2 + i * w / ((o.count or 4) + 1)
		box(m, V3(0.35, 3.6, 0.5), V3(x, 2.2, 0.1), gun, mat("metal"))
		box(m, V3(0.4, 1, 0.7), V3(x, 0.95, 0.05), pal.woodDark, mat("wood"))
		box(m, V3(0.3, 0.6, 0.5), V3(x, 2.4, -0.3), gun, mat("metal"))
	end
	return station(back, "weapon_rack")
end

PROPS.sandbags = function(m, o, r, pal)
	local len = o.length or 8
	local col = c3(o.color, pal.sand:Lerp(pal.dirt, 0.3))
	local main
	for row = 0, 2 do
		local n = math.floor(len / 2)
		for i = 0, n - 1 do
			local x = -len / 2 + (i + 0.5) * len / n + (row % 2) * 0.5
			local b = blob(m, V3(len / n + 0.3, 1.1, 1.8), V3(x, 0.5 + row * 0.95, 0), jitter(col, r, 0.04), mat("fabric"))
			main = main or b
		end
	end
	return main
end

PROPS.low_wall = function(m, o, r, pal)
	local len, h = o.length or 10, o.height or 4.5
	local col = c3(o.color, pal.wall:Lerp(pal.rock, 0.4))
	local wall = box(m, V3(len, h, 1.6), V3(0, h / 2, 0), col, mat("stone"))
	box(m, V3(len + 0.3, 0.4, 2), V3(0, h + 0.2, 0), shade(col, 0.12), mat("stone"))
	return wall
end

-- ---- vehicles / water

PROPS.car = function(m, o, r, pal)
	local col = c3(o.color, pal.primary)
	local body = box(m, V3(6, 1.8, 11), V3(0, 2.1, 0), col, mat("metal"))
	box(m, V3(5.4, 1.8, 5.5), V3(0, 3.9, 0.6), col, mat("metal"))
	local glass = box(m, V3(5.5, 1.3, 5.2), V3(0, 3.95, 0.6), pal.sky:Lerp(pal.ink, 0.55), M.Glass)
	glass.CastShadow = false
	box(m, V3(5.6, 0.25, 5.7), V3(0, 4.85, 0.6), col, mat("metal"))
	box(m, V3(6.2, 0.5, 0.6), V3(0, 1.4, -5.6), pal.metal, mat("metal"))
	box(m, V3(6.2, 0.5, 0.6), V3(0, 1.4, 5.6), pal.metal, mat("metal"))
	for _, x in ipairs({ -2, 2 }) do
		local hl = box(m, V3(1.2, 0.6, 0.2), V3(x, 2.4, -5.55), pal.light, M.Neon)
		hl.CastShadow = false
		local tl = box(m, V3(1.2, 0.5, 0.2), V3(x, 2.4, 5.55), pal.danger, M.Neon)
		tl.CastShadow = false
	end
	for _, x in ipairs({ -3, 3 }) do
		for _, z in ipairs({ -3.4, 3.4 }) do
			hcyl(m, 1.2, 2.6, CF(x, 1.3, z), pal.ink, mat("default"))
			hcyl(m, 1.25, 1.3, CF(x, 1.3, z), pal.metal, mat("metal"))
		end
	end
	return body
end

PROPS.boat = function(m, o, r, pal)
	local col = c3(o.color, pal.primary)
	local hull = box(m, V3(5, 1.6, 9), V3(0, 0.6, 1), col, mat("default"))
	box(m, V3(3.54, 1.6, 3.54), CF(0, 0.6, -3.5) * ANG(0, PI / 4, 0), col, mat("default")) -- pointed bow
	box(m, V3(5.2, 0.4, 9.2), V3(0, 1.5, 1), pal.trim, mat("default"))
	box(m, V3(4, 0.3, 7.5), V3(0, 1.3, 1.3), pal.wood, mat("wood"))
	box(m, V3(3, 1.4, 1.2), V3(0, 2.2, 0.5), pal.ink:Lerp(pal.metal, 0.3), mat("default"))
	box(m, V3(3.6, 1.4, 0.2), CF(0, 3, -0.6) * ANG(rad(-20), 0, 0), pal.sky:Lerp(pal.ink, 0.3), M.Glass)
	box(m, V3(1.4, 2.2, 1.4), V3(0, 1.4, 5.8), pal.ink, mat("metal"))
	return hull
end

PROPS.buoy = function(m, o, r, pal)
	local col = c3(o.color, pal.primary)
	local float = vcyl(m, 2, 3.2, V3(0, 0.6, 0), col, mat("default"))
	vcyl(m, 0.7, 3.3, V3(0, 1.1, 0), pal.trim, mat("default"))
	vcyl(m, 4, 0.4, V3(0, 3.5, 0), pal.ink:Lerp(pal.metal, 0.4), mat("metal"))
	for _, a in ipairs({ 0, PI / 2 }) do
		box(m, V3(1.4, 2.6, 0.2), CF(0, 4, 0) * ANG(0, a, 0), col, mat("default"))
	end
	local lamp = ball(m, 0.8, V3(0, 5.8, 0), pal.glow, M.Neon)
	light(lamp, pal.glow, 1, 12)
	return float
end

PROPS.umbrella = function(m, o, r, pal)
	local pole = vcyl(m, 7, 0.3, V3(0, 3.5, 0), pal.trim, mat("default"))
	local col = c3(o.color, pal.primary)
	for i = 0, 7 do
		local a = i / 8 * PI * 2
		wedge(m, V3(2.5, 1.2, 3.4), CF(0, 6.6, 0) * ANG(0, a, 0) * CF(0, 0, -1.7),
			i % 2 == 0 and col or pal.trim, mat("fabric"))
	end
	return pole
end

PROPS.platform = function(m, o, r, pal)
	local d = o.size or 10
	local th = o.thickness or 3
	local top = c3(o.color, pal.ground)
	local main = vcyl(m, 1.2, d, V3(0, -0.6, 0), top, mat("ground"))
	vcyl(m, th, d * 0.92, V3(0, -1.2 - th / 2, 0), pal.dirt, mat("stone"))
	vcyl(m, th * 0.6, d * 0.6, V3(0, -1.2 - th - th * 0.3, 0), shade(pal.dirt, -0.15), mat("stone"))
	vcyl(m, 0.3, d + 0.25, V3(0, -1.05, 0), shade(top, -0.15), mat("ground"))
	return main
end

PROPS.pillar = function(m, o, r, pal)
	local h = o.height or 14
	local col = c3(o.color, pal.wall:Lerp(pal.rock, 0.3))
	local main = box(m, V3(2.4, h, 2.4), V3(0, h / 2, 0), col, mat("stone"))
	box(m, V3(3.2, 1, 3.2), V3(0, 0.5, 0), shade(col, -0.12), mat("stone"))
	box(m, V3(3.2, 1, 3.2), V3(0, h - 0.5, 0), shade(col, -0.12), mat("stone"))
	return main
end

WK2.propKinds = {}
for k in pairs(PROPS) do
	table.insert(WK2.propKinds, k)
end
table.sort(WK2.propKinds)

-- WorldKit2.prop(kind, {position, rotation=deg, cframe?, scale=1, color, palette, seed, parent, ...kind opts}) -> Model
-- The model's pivot is its ground centre, so model:PivotTo(CFrame.new(groundPoint)) re-places it.
function WK2.prop(kind, o)
	o = o or {}
	local fn = PROPS[kind]
	if not fn then
		warn("[WorldKit2] unknown prop " .. tostring(kind) .. "; using crate")
		kind = "crate"
		fn = PROPS.crate
	end
	local m = Instance.new("Model")
	m.Name = o.name or kind
	local r = Random.new(o.seed or 1)
	local main = fn(m, o, r, palOf(o)) or m:FindFirstChildWhichIsA("BasePart")
	if not main then -- degenerate options (count=0 ...): keep an invisible anchor so callers still get a placeable Model
		main = box(m, V3(1, 1, 1), CF(0, 0.5, 0), Color3.new(1, 1, 1), M.SmoothPlastic)
		main.Transparency = 1
		main.CanCollide = false
	end
	m.PrimaryPart = main
	main.PivotOffset = main.CFrame:Inverse()
	m:SetAttribute("Prop", kind)
	if o.scale and o.scale ~= 1 then
		pcall(function() m:ScaleTo(o.scale) end)
	end
	local cf = o.cframe or (CF(o.position or Vector3.zero) * ANG(0, rad(o.rotation or 0), 0))
	m:PivotTo(cf)
	m.Parent = o.parent or folder("WorldKit2")
	return m
end

-- ---------------------------------------------------------------------------------------------------- placement

local function rayParams(include)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = include or { Workspace.Terrain }
	params.IgnoreWater = false
	return params
end

-- WorldKit2.groundAt(x, z, {top=500, bottom=-500, include={Workspace.Terrain}}) -> position?, material?
function WK2.groundAt(x, z, o)
	o = o or {}
	local top, bottom = o.top or 500, o.bottom or -500
	local res = Workspace:Raycast(V3(x, top, z), V3(0, bottom - top, 0), rayParams(o.include))
	if res then
		return res.Position, res.Material
	end
	return nil, nil
end

local function gauss(r)
	return math.sqrt(-2 * math.log(math.max(1e-6, r:NextNumber()))) * math.cos(2 * PI * r:NextNumber())
end

local GAP = { tree = 9, round_tree = 9, pine = 8, palm = 9, blossom = 9, dead_tree = 7, house = 22, shop = 22,
	tower = 18, skyscraper = 22, rock = 5, bush = 4, flowers = 2.5, grass = 2, mushroom = 3, cactus = 5,
	lollipop = 7, candy_cane = 6, gumdrop = 5, asteroid = 14, crystal = 4, log = 6, lily_pad = 3, reeds = 2.5,
	snowman = 5, buoy = 10, boat = 16, umbrella = 6 }

-- WorldKit2.populate({center, size=number|Vector2, kinds={{"tree", weight, {opts}}, ...}, count=40, clusters=6,
-- spread=0.1, clear=0, seed, parent, onWater=false, scale={0.8,1.25}, include={Workspace.Terrain}, float={min,max}})
-- -> {models}. Clustered scatter with negative space: props group around cluster centres (plus a few loners),
-- keep their footprint apart, sit on the ground found by raycast, and skip water unless onWater (then ONLY water).
function WK2.populate(o)
	local r = Random.new(o.seed or 5)
	local center = o.center or Vector3.zero
	local sx = typeof(o.size) == "Vector2" and o.size.X or (o.size or 128)
	local sz = typeof(o.size) == "Vector2" and o.size.Y or (o.size or 128)
	local kinds = o.kinds or { { "tree", 1 } }
	local total = 0
	for _, k in ipairs(kinds) do total += k[2] or 1 end
	local function pick()
		local x = r:NextNumber(0, total)
		for _, k in ipairs(kinds) do
			x -= k[2] or 1
			if x <= 0 then return k end
		end
		return kinds[1]
	end
	local clusters = {}
	for _ = 1, o.clusters or 6 do
		for _ = 1, 12 do
			local p = V3(r:NextNumber(-0.45, 0.45) * sx, 0, r:NextNumber(-0.45, 0.45) * sz)
			if p.Magnitude > (o.clear or 0) + 6 then
				table.insert(clusters, p)
				break
			end
		end
	end
	local placed, made = {}, {}
	local spread = (o.spread or 0.1) * math.max(sx, sz)
	local sc = o.scale or { 0.8, 1.25 }
	local include = o.include
	local want = math.min(o.count or 40, o.max or 400) -- cap: a huge region should not become 20k parts
	for _ = 1, want * 3 do
		if #made >= want then break end
		local k = pick()
		local off
		if #clusters > 0 and r:NextNumber() < 0.82 then
			local cc = clusters[r:NextInteger(1, #clusters)]
			off = cc + V3(gauss(r) * spread, 0, gauss(r) * spread)
		else
			off = V3(r:NextNumber(-0.5, 0.5) * sx, 0, r:NextNumber(-0.5, 0.5) * sz)
		end
		if math.abs(off.X) > sx / 2 or math.abs(off.Z) > sz / 2 or off.Magnitude < (o.clear or 0) then
			continue
		end
		local gap = (k[3] and k[3].gap) or GAP[k[1]] or 4
		local ok = true
		for _, q in ipairs(placed) do
			if (q[1] - off).Magnitude < (q[2] + gap) / 2 then
				ok = false
				break
			end
		end
		if not ok then continue end
		local pos
		if o.float then
			pos = center + off + V3(0, r:NextNumber(o.float[1], o.float[2]), 0)
		else
			local hit, material = WK2.groundAt(center.X + off.X, center.Z + off.Z,
				{ top = center.Y + 300, bottom = center.Y - 200, include = include })
			if not hit then continue end
			local isWater = material == M.Water
			if (o.onWater and not isWater) or (not o.onWater and isWater) then continue end
			pos = hit - V3(0, o.sink or 0.3, 0)
		end
		local opts = {}
		for kk, vv in pairs(k[3] or {}) do opts[kk] = vv end
		opts.position = pos
		opts.rotation = opts.rotation or r:NextNumber(0, 360)
		opts.scale = opts.scale or r:NextNumber(sc[1], sc[2])
		opts.seed = r:NextInteger(1, 1e6)
		opts.parent = o.parent
		opts.palette = opts.palette or o.palette
		table.insert(made, WK2.prop(k[1], opts))
		table.insert(placed, { off, gap })
	end
	return made
end

-- ---------------------------------------------------------------------------------------------------- biomes

local T = Workspace.Terrain

local function disc(center, y0, y1, radius, material)
	T:FillCylinder(CF(center.X, (y0 + y1) / 2, center.Z), y1 - y0, radius, material)
end

local BIOMES = {}

BIOMES.grassland = function(b)
	local c, S, r = b.center, b.size, b.r
	disc(c, c.Y - 14, c.Y - 3, S / 2, M.Ground)
	disc(c, c.Y - 3, c.Y, S / 2, M.Grass)
	for _ = 1, 5 do
		local a, d = r:NextNumber(0, PI * 2), r:NextNumber(0.25, 0.42) * S
		local R = r:NextNumber(0.08, 0.16) * S
		T:FillBall(c + V3(math.cos(a) * d, -R * 0.62, math.sin(a) * d), R, M.Grass)
	end
	for i = 0, 24 do -- a winding dirt path through the clearing
		local t = i / 24
		disc(c + V3((t - 0.5) * S * 0.9, 0, math.sin(t * PI * 2.2) * S * 0.08), c.Y - 1.6, c.Y + 0.1, 3.5, M.Ground)
	end
	b.pop({ kinds = { { "round_tree", 4 }, { "blossom", 1 }, { "bush", 4 }, { "flowers", 5 }, { "grass", 6 }, { "rock", 2 } },
		count = 80, clusters = 8, clear = S * 0.12 })
end

BIOMES.forest = function(b)
	local c, S, r = b.center, b.size, b.r
	disc(c, c.Y - 14, c.Y - 3, S / 2, M.Ground)
	disc(c, c.Y - 3, c.Y, S / 2, M.Grass)
	for _ = 1, 10 do
		local a, d = r:NextNumber(0, PI * 2), r:NextNumber(0.1, 0.45) * S
		disc(c + V3(math.cos(a) * d, 0, math.sin(a) * d), c.Y - 1.5, c.Y + 0.2, r:NextNumber(8, 20), M.LeafyGrass)
	end
	b.pop({ kinds = { { "pine", 5 }, { "round_tree", 3 }, { "bush", 4 }, { "mushroom", 2 }, { "log", 1 }, { "rock", 2, { moss = true } },
		{ "grass", 4 }, { "flowers", 1 } }, count = 120, clusters = 12, spread = 0.09, clear = S * 0.1 })
end

BIOMES.beach = function(b)
	local c, S = b.center, b.size
	local wl = c.Y - 4
	T:FillBlock(CF(c.X + S * 0.25, wl - 7, c.Z), V3(S * 0.5, 14, S), M.Water)
	T:FillBlock(CF(c.X + S * 0.25, wl - 18, c.Z), V3(S * 0.5, 8, S), M.Sand)
	T:FillBlock(CF(c.X - S * 0.25, c.Y - 8, c.Z), V3(S * 0.5, 16, S), M.Sand)
	local run, steps = S * 0.22, 8
	for i = 0, steps - 1 do -- stepped fills smooth into one gentle slope
		local top = c.Y - (i + 1) * (c.Y - (wl - 8)) / steps
		local x0 = c.X + i * run / steps
		T:FillBlock(CF(x0 + run / steps / 2, (top + wl - 14) / 2, c.Z), V3(run / steps + 1, top - (wl - 14), S), M.Sand)
	end
	T:FillBlock(CF(c.X - S * 0.38, c.Y - 1.5, c.Z), V3(S * 0.24, 3, S), M.Grass)
	b.pop({ center = c + V3(-S * 0.1, 0, 0), size = Vector2.new(S * 0.3, S),
		kinds = { { "palm", 5 }, { "rock", 2 }, { "umbrella", 1 }, { "grass", 1 } }, count = 26, clusters = 5 })
	b.pop({ center = c + V3(-S * 0.38, 0, 0), size = Vector2.new(S * 0.22, S),
		kinds = { { "round_tree", 3 }, { "bush", 3 }, { "flowers", 2 } }, count = 24, clusters = 4 })
	b.pop({ center = c + V3(S * 0.3, 0, 0), size = Vector2.new(S * 0.35, S), onWater = true, sink = 0.6,
		kinds = { { "buoy", 3 }, { "boat", 1, { scale = 1 } } }, count = 6, clusters = 0 })
	b.out.spawn = c + V3(-S * 0.08, 4, 0)
end

BIOMES.islands = function(b)
	local c, S, r = b.center, b.size, b.r
	T:FillBlock(CF(c.X, c.Y - 12, c.Z), V3(S, 24, S), M.Water)
	T:FillBlock(CF(c.X, c.Y - 28, c.Z), V3(S, 8, S), M.Sand)
	local tops = {}
	local n = 5
	for i = 1, n do
		local a = i / n * PI * 2 + r:NextNumber(-0.3, 0.3)
		local d = i == 1 and 0 or S * r:NextNumber(0.25, 0.34)
		local rad_ = i == 1 and S * 0.14 or S * r:NextNumber(0.07, 0.1)
		local pos = c + V3(math.cos(a) * d, 2, math.sin(a) * d)
		local isl = WorldKit.island({ position = pos, radius = rad_, height = rad_ * 0.35, floating = false,
			top = M.Grass, side = M.Sand, seed = b.seed + i })
		table.insert(tops, isl)
		b.pop({ center = isl.top, size = rad_ * 1.5, kinds = { { "palm", 3 }, { "round_tree", 2 }, { "bush", 3 },
			{ "rock", 1 }, { "flowers", 2 } }, count = math.floor(rad_ / 2.5), clusters = 2 })
	end
	for i = 2, #tops do
		local a, bb = tops[1], tops[i]
		local dir = (bb.top - a.top) * V3(1, 0, 1)
		if dir.Magnitude > 1 then
			local u = dir.Unit
			WorldKit.bridge({ from = a.top + u * a.radius * 0.8, to = bb.top - u * bb.radius * 0.8, width = 6,
				parent = b.folder })
		end
	end
	b.out.spawn = tops[1].top + V3(0, 4, 0)
	b.out.islands = tops
end

local function mesa(center, baseY, R, H, r)
	local layers = math.max(3, math.floor(H / 6))
	local lh = H / layers
	for k = 0, layers - 1 do
		local rr = R * (1 - k * 0.035) + r:NextNumber(-1, 1)
		disc(center, baseY + k * lh, baseY + (k + 1) * lh + 0.5, rr, k % 2 == 0 and M.Sandstone or M.Rock)
	end
	disc(center, baseY + H, baseY + H + 2, R * (1 - layers * 0.035) - 1, M.Sand)
end

BIOMES.desert = function(b)
	local c, S, r = b.center, b.size, b.r
	disc(c, c.Y - 14, c.Y, S / 2, M.Sand)
	for _ = 1, 6 do -- dunes
		local a, d = r:NextNumber(0, PI * 2), r:NextNumber(0.15, 0.45) * S
		local R = r:NextNumber(0.06, 0.12) * S
		T:FillBall(c + V3(math.cos(a) * d, -R * 0.75, math.sin(a) * d), R, M.Sand)
	end
	for i = 1, 5 do
		local a = i / 5 * PI * 2 + r:NextNumber(-0.3, 0.3)
		local d = r:NextNumber(0.3, 0.42) * S
		mesa(c + V3(math.cos(a) * d, 0, math.sin(a) * d), c.Y - 4, r:NextNumber(0.05, 0.09) * S, r:NextNumber(18, 42), r)
	end
	b.pop({ kinds = { { "cactus", 4 }, { "rock", 3 }, { "dead_tree", 1 }, { "bush", 1, { berries = false } } },
		count = 40, clusters = 6, clear = S * 0.12 })
end

BIOMES.canyon = function(b)
	local c, S, r = b.center, b.size, b.r
	disc(c, c.Y - 14, c.Y, S / 2, M.Sand)
	for _, side in ipairs({ -1, 1 }) do -- two banded walls with a dry river between
		for i = 0, 7 do
			local z = (i / 7 - 0.5) * S * 0.85
			mesa(c + V3(side * S * (0.24 + r:NextNumber(-0.03, 0.03)), 0, z), c.Y - 4, S * r:NextNumber(0.09, 0.12),
				r:NextNumber(26, 44), r)
		end
	end
	for i = 0, 20 do
		local t = i / 20
		disc(c + V3(math.sin(t * PI * 3) * S * 0.04, 0, (t - 0.5) * S), c.Y - 2, c.Y + 0.2, 5, M.Ground)
	end
	b.pop({ size = Vector2.new(S * 0.3, S), kinds = { { "cactus", 3 }, { "rock", 4 }, { "dead_tree", 1 } },
		count = 26, clusters = 5, clear = S * 0.08 })
end

BIOMES.snowy_mountains = function(b)
	local c, S, r = b.center, b.size, b.r
	disc(c, c.Y - 14, c.Y, S / 2, M.Snow)
	for i = 1, 4 do
		local a = i / 4 * PI * 2 + r:NextNumber(-0.4, 0.4)
		local d = r:NextNumber(0.3, 0.4) * S
		local base = c + V3(math.cos(a) * d, 0, math.sin(a) * d)
		local R = r:NextNumber(0.13, 0.18) * S
		for k = 0, 6 do
			local rr = R * (1 - k * 0.14)
			local p = base + V3(r:NextNumber(-2, 2), -R * 0.4 + k * R * 0.32, r:NextNumber(-2, 2))
			T:FillBall(p, rr, k >= 4 and M.Snow or M.Rock)
		end
		T:FillBall(base + V3(0, R * 1.55, 0), R * 0.2, M.Snow)
	end
	local lake = c + V3(S * 0.12, 0, -S * 0.1)
	disc(lake, c.Y - 1, c.Y + 0.3, S * 0.08, M.Ice)
	b.pop({ kinds = { { "pine", 6, { snow = true } }, { "rock", 3 }, { "dead_tree", 1 }, { "snowman", 0.4 } },
		count = 60, clusters = 8, clear = S * 0.14 })
end

BIOMES.swamp = function(b)
	local c, S, r = b.center, b.size, b.r
	disc(c, c.Y - 14, c.Y, S / 2, M.Mud)
	for _ = 1, 8 do
		local a, d = r:NextNumber(0, PI * 2), r:NextNumber(0.1, 0.42) * S
		disc(c + V3(math.cos(a) * d, 0, math.sin(a) * d), c.Y - 1.4, c.Y + 0.2, r:NextNumber(8, 16), M.LeafyGrass)
	end
	for _ = 1, 7 do
		local a, d = r:NextNumber(0, PI * 2), r:NextNumber(0.18, 0.42) * S
		local pr = r:NextNumber(10, 22)
		disc(c + V3(math.cos(a) * d, 0, math.sin(a) * d), c.Y - 4, c.Y - 0.6, pr, M.Water)
		disc(c + V3(math.cos(a) * d, 0, math.sin(a) * d), c.Y - 0.6, c.Y + 1, pr, M.Air)
	end
	b.pop({ kinds = { { "dead_tree", 3 }, { "round_tree", 1, { color = b.pal.leaf:Lerp(b.pal.dirt, 0.4) } },
		{ "reeds", 4 }, { "mushroom", 2 }, { "log", 1 }, { "grass", 3 } }, count = 60, clusters = 8, clear = S * 0.1 })
	b.pop({ kinds = { { "lily_pad", 5 }, { "reeds", 1 } }, count = 30, clusters = 6, onWater = true, sink = 0.05 })
end

BIOMES.volcanic = function(b)
	local c, S, r = b.center, b.size, b.r
	disc(c, c.Y - 14, c.Y, S / 2, M.Basalt)
	local vc = c + V3(S * 0.18, 0, S * 0.18)
	local R, H = S * 0.2, S * 0.28
	local tiers = 9
	for k = 0, tiers - 1 do
		disc(vc, c.Y + k * H / tiers - 1, c.Y + (k + 1) * H / tiers, R * (1 - k * 0.095), k % 3 == 2 and M.Rock or M.Basalt)
	end
	T:FillBall(vc + V3(0, H + R * 0.08, 0), R * 0.24, M.Air)
	disc(vc, c.Y + H - R * 0.2, c.Y + H - R * 0.1, R * 0.2, M.CrackedLava)
	for i = 0, 2 do -- lava rivers running from the cone
		local a = r:NextNumber(0, PI * 2)
		for j = 0, 14 do
			local d = R * 0.9 + j * S * 0.025
			local wob = math.sin(j * 0.7 + i) * 0.25
			local p = vc + V3(math.cos(a + wob) * d, 0, math.sin(a + wob) * d)
			if ((p - c) * V3(1, 0, 1)).Magnitude < S / 2 - 6 then
				disc(p, c.Y - 1.5, c.Y + 0.1, 3.2, M.CrackedLava)
			end
		end
	end
	local glow = box(b.folder, V3(1, 1, 1), CF(vc + V3(0, H + 6, 0)), Color3.fromRGB(255, 120, 40), M.Neon)
	glow.Transparency = 1
	glow.CanCollide = false
	light(glow, Color3.fromRGB(255, 120, 50), 4, 60)
	b.pop({ kinds = { { "rock", 4 }, { "crystal", 2, { color = Color3.fromRGB(255, 120, 50) } }, { "dead_tree", 2 } },
		count = 45, clusters = 7, clear = S * 0.1 })
end

BIOMES.candy = function(b)
	local c, S, r = b.center, b.size, b.r
	disc(c, c.Y - 14, c.Y, S / 2, M.Grass)
	for _ = 1, 6 do
		local a, d = r:NextNumber(0, PI * 2), r:NextNumber(0.25, 0.42) * S
		local R = r:NextNumber(0.07, 0.13) * S
		local p = c + V3(math.cos(a) * d, -R * 0.5, math.sin(a) * d)
		T:FillBall(p, R, M.Ground)
		T:FillBall(p + V3(0, R * 0.55, 0), R * 0.55, M.Snow) -- frosting cap
	end
	b.pop({ kinds = { { "lollipop", 3 }, { "candy_cane", 2 }, { "gumdrop", 4 }, { "mushroom", 2 },
		{ "blossom", 2 }, { "flowers", 3 } }, count = 60, clusters = 8, clear = S * 0.12 })
end

BIOMES.neon_city = function(b)
	local c, S = b.center, b.size
	T:FillBlock(CF(c.X, c.Y - 5.5, c.Z), V3(S, 9, S), M.Asphalt)
	local blocks = math.max(1, math.floor((S - 16) / 72))
	local town = WK2.town({ center = c, blocks = blocks, blockSize = 56, street = 16, style = "neon", seed = b.seed,
		parent = b.folder, palette = b.o.palette })
	b.out.spawn = town.spawn
	b.out.town = town
end

BIOMES.space_asteroids = function(b)
	local c, S, r = b.center, b.size, b.r
	local pad = vcyl(b.folder, 2, 40, c - V3(0, 1, 0), b.pal.metal, mat("metal"))
	vcyl(b.folder, 2.1, 30, c - V3(0, 1, 0), b.pal.ink:Lerp(b.pal.metal, 0.3), mat("metal"))
	local ring = vcyl(b.folder, 2.2, 32, c - V3(0, 1.05, 0), b.pal.glow, M.Neon)
	ring.CastShadow = false
	vcyl(b.folder, 2.3, 28, c - V3(0, 1, 0), b.pal.ink:Lerp(b.pal.metal, 0.3), mat("metal"))
	local _ = pad
	for _ = 1, 9 do
		local p = c + V3(r:NextNumber(-0.45, 0.45) * S, r:NextNumber(10, 70), r:NextNumber(-0.45, 0.45) * S)
		if (p - c).Magnitude > 40 then
			local R = r:NextNumber(8, 18)
			T:FillBall(p, R, M.Basalt)
			for _ = 1, 3 do
				T:FillBall(p + V3(r:NextNumber(-1, 1), r:NextNumber(-0.6, 0.6), r:NextNumber(-1, 1)) * R * 0.7,
					R * r:NextNumber(0.4, 0.7), r:NextNumber() < 0.5 and M.Rock or M.Basalt)
			end
			if r:NextNumber() < 0.5 then
				T:FillBall(p + V3(0, R * 0.6, 0), R * 0.3, M.Glacier)
			end
		end
	end
	b.pop({ kinds = { { "asteroid", 1 } }, count = 30, clusters = 5, spread = 0.12, clear = 30, float = { 6, 90 } })
	b.pop({ kinds = { { "crystal", 1 } }, count = 14, clusters = 6, clear = 24 })
	b.out.spawn = c + V3(0, 4, 0)
end

BIOMES.island = BIOMES.islands
BIOMES.mountains = BIOMES.snowy_mountains
BIOMES.snow = BIOMES.snowy_mountains
BIOMES.space = BIOMES.space_asteroids
BIOMES.city = BIOMES.neon_city
WK2.biomeKinds = { "grassland", "beach", "islands", "desert", "canyon", "snowy_mountains", "forest", "swamp", "volcanic",
	"neon_city", "candy", "space_asteroids" }

-- WorldKit2.biome(kind, {center=Vector3, size=256, seed, density=1, palette, parent}) ->
-- {folder, center, size, spawn=Vector3, props={Model}, ...}. Terrain + clustered dressing; centre kept clear.
function WK2.biome(kind, o)
	o = o or {}
	local fn = BIOMES[kind]
	if not fn then
		warn("[WorldKit2] unknown biome " .. tostring(kind) .. "; using grassland")
		kind = "grassland"
		fn = BIOMES.grassland
	end
	local center = o.center or Vector3.zero
	local size = o.size or 256
	local seed = o.seed or 1
	local f = folder(o.name or ("Biome_" .. kind), o.parent or folder("WorldKit2"))
	local out = { kind = kind, folder = f, center = center, size = size, spawn = center + V3(0, 4, 0), props = {} }
	local b = { center = center, size = size, seed = seed, r = Random.new(seed), pal = palOf(o), folder = f, out = out, o = o }
	local popN = 0
	b.pop = function(spec)
		popN += 1
		spec.center = spec.center or center
		spec.size = spec.size or size
		spec.seed = seed * 97 + popN
		spec.parent = f
		spec.palette = spec.palette or o.palette
		spec.count = math.max(1, math.floor((spec.count or 30) * (o.density or 1) * (size / 256) ^ 2 + 0.5))
		for _, m in ipairs(WK2.populate(spec)) do
			table.insert(out.props, m)
		end
	end
	fn(b)
	return out
end

-- ---------------------------------------------------------------------------------------------------- course

local function catmull(p0, p1, p2, p3, t)
	local t2, t3 = t * t, t * t * t
	return 0.5 * ((2 * p1) + (p2 - p0) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (3 * p1 - p0 - 3 * p2 + p3) * t3)
end

local function sampleSpline(points, closed, step)
	local n = #points
	local out = {}
	local segs = closed and n or n - 1
	for i = 1, segs do
		local p0 = points[closed and ((i - 2) % n + 1) or math.max(1, i - 1)]
		local p1 = points[i]
		local p2 = points[i % n + 1]
		local p3 = points[closed and ((i + 1) % n + 1) or math.min(n, i + 2)]
		local k = math.max(1, math.ceil((p2 - p1).Magnitude / step))
		for j = 0, k - 1 do
			table.insert(out, catmull(p0, p1, p2, p3, j / k))
		end
	end
	if closed then
		table.insert(out, points[1])
	else
		table.insert(out, points[n])
	end
	return out
end

local function gateArch(m, cf, w, pal, index, isStart, onWater)
	local postCol = isStart and pal.trim or pal.secondary
	for _, side in ipairs({ -1, 1 }) do
		local base = cf * CF(side * (w / 2 + 2), 0, 0)
		if onWater then
			vcyl(m, 2.5, 4.5, base * CF(0, 0.5, 0), pal.primary, mat("default"))
		end
		vcyl(m, 13, 1.4, base * CF(0, 6.5, 0), postCol, mat("metal"))
		ball(m, 2, base * CF(0, 13.2, 0), pal.accent, mat("default"))
	end
	local beam = box(m, V3(w + 4, 2.2, 1.2), cf * CF(0, 12, 0), isStart and pal.ink or pal.primary, mat("default"))
	if isStart then
		for i = 0, 9 do
			box(m, V3((w + 4) / 10, 1, 1.3), cf * CF(-(w + 4) / 2 + (i + 0.5) * (w + 4) / 10, 12 + ((i % 2) - 0.5),
				0), i % 2 == 0 and pal.trim or pal.ink, mat("default"))
		end
	end
	local strip = box(m, V3(w + 3, 0.35, 1.3), cf * CF(0, 10.7, 0), pal.glow, M.Neon)
	strip.CastShadow = false
	local trig = box(m, V3(w + 4, 14, 2), cf * CF(0, 7, 0), pal.glow, M.SmoothPlastic)
	trig.Transparency = 1
	trig.CanCollide = false
	trig.CanQuery = false
	trig.Name = "Gate" .. index
	tag(trig, "KitGate", { GateIndex = index, IsStart = isStart })
	local _ = beam
	return trig
end

-- WorldKit2.course(points={Vector3...}, {width=16, style="road"|"water"|"rail"|"platforms", gates=true|n|false,
-- closed=false, step=6, spacing=14, supports=true, palette, parent}) -> {model, samples={CFrame}, gates={Part}, length,
-- start=CFrame}. Catmull-Rom spline through the points. Gate triggers are invisible parts tagged KitGate
-- (attributes GateIndex, IsStart) for lap/checkpoint logic.
function WK2.course(points, o)
	o = o or {}
	local w = o.width or 16
	local style = o.style or "road"
	local pal = palOf(o)
	local m = Instance.new("Model")
	m.Name = o.name or ("Course_" .. style)
	m.Parent = o.parent or folder("WorldKit2")
	local s = sampleSpline(points, o.closed, o.step or 6)
	local samples, length = {}, 0
	for i = 1, #s - 1 do
		local a, b = s[i], s[i + 1]
		if (b - a).Magnitude > 0.05 then
			table.insert(samples, CFrame.lookAt(a, b))
			length += (b - a).Magnitude
		end
	end
	local roadCol = c3(o.color, pal.ink:Lerp(pal.metal, 0.3))
	local spacingK = math.max(1, math.floor((o.spacing or 14) / (o.step or 6) + 0.5))
	for i = 1, #s - 1 do
		local a, b = s[i], s[i + 1]
		local len = (b - a).Magnitude
		if len <= 0.05 then continue end
		local cf = CFrame.lookAt((a + b) / 2, b)
		if style == "road" then
			box(m, V3(w, 1, len + 0.6), cf * CF(0, -0.5, 0), roadCol, mat("road"))
			for _, side in ipairs({ -1, 1 }) do
				box(m, V3(1.6, 0.7, len + 0.6), cf * CF(side * (w / 2 + 0.8), -0.15, 0),
					i % 2 == 0 and pal.primary or pal.trim, mat("default"))
			end
			if i % 2 == 0 then
				local dash = box(m, V3(0.5, 0.05, len * 0.6), cf * CF(0, 0.02, 0), pal.trim, mat("default"))
				dash.CanCollide = false
			end
			if o.supports ~= false and i % 8 == 0 then
				local hit = WK2.groundAt(cf.Position.X, cf.Position.Z, { top = cf.Position.Y - 1.5, bottom = cf.Position.Y - 120 })
				local drop = hit and (cf.Position.Y - hit.Y) or 0
				if drop > 4 then
					vcyl(m, drop, 3, CF(cf.Position - V3(0, drop / 2 + 0.5, 0)), pal.wall:Lerp(pal.rock, 0.4), mat("stone"))
				end
			end
		elseif style == "water" then
			T:FillBlock(cf * CF(0, -2.5, 0), V3(w, 5, len + 1), M.Water)
			for _, side in ipairs({ -1, 1 }) do
				T:FillBlock(cf * CF(side * (w / 2 + 3), -2.5, 0), V3(6, 6, len + 1), M.Sand)
			end
			if i % (spacingK * 3) == 0 then
				for _, side in ipairs({ -1, 1 }) do
					WK2.prop("buoy", { cframe = cf * CF(side * (w / 2 - 1), -0.6, 0), parent = m, palette = o.palette,
						color = side < 0 and pal.primary or pal.leaf })
				end
			end
		elseif style == "rail" then
			box(m, V3(w * 0.6, 0.6, len + 0.4), cf * CF(0, -0.3, 0), pal.rock, mat("stone"))
			box(m, V3(w * 0.48, 0.4, 1.2), cf * CF(0, 0.15, 0), pal.woodDark, mat("wood"))
			for _, side in ipairs({ -1, 1 }) do
				box(m, V3(0.5, 0.6, len + 0.4), cf * CF(side * w * 0.16, 0.6, 0), pal.metal, mat("metal"))
			end
		elseif style == "platforms" then
			if i % spacingK == 1 or spacingK == 1 then
				WK2.prop("platform", { position = a, size = w * 0.7, parent = m, palette = o.palette })
			end
		end
	end
	local gates = {}
	local nG = o.gates == false and 0 or (type(o.gates) == "number" and o.gates or math.max(3, math.floor(length / 140)))
	for g = 1, nG do
		local idx = math.floor((g - 1) / nG * #samples) + 1
		local cf = samples[idx]
		if cf then
			table.insert(gates, gateArch(m, cf, w, pal, g, g == 1, style == "water"))
		end
	end
	return { model = m, samples = samples, gates = gates, length = length, start = samples[1] }
end

-- ---------------------------------------------------------------------------------------------------- obby

local THEMES = {
	grass = { top = "ground", side = "dirt", decor = { "flowers", "grass", "mushroom", "bush" } },
	candy = { top = "blossom", side = "trim", decor = { "gumdrop", "lollipop", "candy_cane" } },
	lava = { top = "rock", side = "woodDark", decor = { "crystal", "torch", "rock" } },
	ice = { top = "snow", side = "secondary", decor = { "crystal", "pine", "rock" } },
	sky = { top = "trim", side = "sky", decor = { "flowers", "bush" } },
	neon = { top = "ink", side = "wall", decor = { "crystal" } },
}

-- WorldKit2.platformingCourse({start=Vector3, length=14 platforms, difficulty=1..5, theme="grass"|"candy"|"lava"|"ice"|
-- "sky"|"neon", direction=Vector3, seed, coins=true, palette, parent}) -> {model, platforms={Model}, start=CFrame,
-- goal=Part, checkpoints={Part}}. N64-style floating discs with tuned jump gaps (edge-to-edge 3..11 studs, rises <= 4).
-- Hooks: KitMover (MoveOffset, MovePeriod), KitSpinner (SpinSpeed), KitCrumble, KitBounce (BouncePower), KitCoin,
-- KitCheckpoint (Index), KitGoal. Call WorldKit2.animate() once (server) to run movers/spinners/crumblers.
function WK2.platformingCourse(o)
	o = o or {}
	local r = Random.new(o.seed or 3)
	local diff = math.clamp(o.difficulty or 2, 1, 5)
	local pal = palOf(o)
	local th = THEMES[o.theme or "grass"] or THEMES.grass
	local topCol, sideCol = pal[th.top] or pal.ground, pal[th.side] or pal.dirt
	local m = Instance.new("Model")
	m.Name = o.name or "PlatformingCourse"
	m.Parent = o.parent or folder("WorldKit2")
	local dir = (o.direction or V3(0, 0, -1)) * V3(1, 0, 1)
	dir = dir.Magnitude > 0 and dir.Unit or V3(0, 0, -1)
	local baseDir, yaw = dir, 0
	local pos = o.start or V3(0, 30, 0)
	local platforms, checkpoints = {}, {}
	local prevR = 0
	local prevTop
	local count = o.length or 14
	local function disc_(p, d, kind)
		local pm = WK2.prop("platform", { position = p, size = d, color = topCol, parent = m, seed = r:NextInteger(1, 1e6),
			palette = { dirt = sideCol } })
		pm.Name = "Platform_" .. kind
		return pm
	end
	for i = 0, count do
		local d
		if i == 0 or i == count then
			d = 18
		else
			d = math.max(6, 14 - diff * 1.4 + r:NextNumber(-1.5, 1.5))
		end
		local kind = "static"
		if i > 0 and i < count then
			local roll = r:NextNumber()
			if i % 5 == 0 then
				kind = "checkpoint"
			elseif diff >= 2 and roll < 0.12 + diff * 0.04 then
				kind = "moving"
			elseif diff >= 3 and roll < 0.3 + diff * 0.03 then
				kind = "spinner"
			elseif diff >= 2 and roll < 0.42 then
				kind = "crumble"
			elseif roll < 0.5 then
				kind = "bounce"
			end
		end
		if i > 0 then
			local gap = math.min(11, r:NextNumber(3, 4 + diff * 1.4))
			local rise = math.min(4, r:NextNumber(-3, 1 + diff * 0.6))
			if platforms[#platforms] and platforms[#platforms]:GetAttribute("Kind") == "bounce" then
				rise = r:NextNumber(8, 13)
			end
			yaw = math.clamp(yaw + r:NextNumber(-0.35, 0.35), -0.9, 0.9) -- winds, but never doubles back
			dir = CFrame.Angles(0, yaw, 0):VectorToWorldSpace(baseDir).Unit
			pos = pos + dir * (prevR + gap + (kind == "spinner" and d * 0.9 or d / 2)) + V3(0, rise, 0)
		end
		local pm
		if kind == "spinner" then
			pm = Instance.new("Model")
			pm.Name = "Platform_spinner"
			local hub = vcyl(pm, 1.4, 5, CF(pos - V3(0, 0.7, 0)), pal.accent, mat("default"))
			box(pm, V3(d * 1.8, 1.2, 3.2), CF(pos - V3(0, 0.6, 0)), topCol, mat("default"))
			box(pm, V3(d * 1.8 + 0.3, 0.3, 3.5), CF(pos - V3(0, 1.3, 0)), sideCol, mat("default"))
			pm.PrimaryPart = hub
			hub.PivotOffset = hub.CFrame:Inverse() * CF(pos) -- upright pivot: spin about world Y, not the cylinder axis
			pm.Parent = m
			tag(pm, "KitSpinner", { SpinSpeed = 0.5 + diff * 0.22 })
		else
			pm = disc_(pos, d, kind)
		end
		pm:SetAttribute("Kind", kind)
		local top = pm.PrimaryPart
		if kind == "moving" then
			local right = dir:Cross(V3(0, 1, 0))
			tag(pm, "KitMover", { MoveOffset = right * (5 + diff * 1.5), MovePeriod = 4.2 - diff * 0.35 })
			local stripe = vcyl(pm, 0.32, d * 0.5, CF(pos + V3(0, 0.02, 0)), pal.secondary, mat("default"))
			stripe.CanCollide = false
		elseif kind == "crumble" then
			top.Color = topCol:Lerp(pal.danger, 0.25)
			for k = 1, 3 do
				local crack = box(pm, V3(d * 0.5, 0.05, 0.25), CF(pos + V3(0, 0.03, (k - 2) * d * 0.15)) * ANG(0, k * 0.7, 0),
					shade(topCol, -0.35), mat("default"))
				crack.CanCollide = false
			end
			tag(pm, "KitCrumble")
		elseif kind == "bounce" then
			local pad = vcyl(pm, 0.6, d * 0.55, CF(pos + V3(0, 0.25, 0)), pal.accent, M.Neon)
			pad.CastShadow = false
			pad.CanCollide = false
			tag(top, "KitBounce", { BouncePower = 85 + diff * 5 })
		elseif kind == "checkpoint" then
			local ring = vcyl(pm, 0.3, d * 0.75, CF(pos + V3(0, 0.05, 0)), pal.secondary, M.Neon)
			ring.CanCollide = false
			ring.CastShadow = false
			WK2.prop("flag", { position = pos + dir * (d * 0.35), parent = pm, color = pal.secondary, height = 8, palette = o.palette })
			tag(top, "KitCheckpoint", { Index = #checkpoints + 1 })
			table.insert(checkpoints, top)
		elseif kind == "static" and i > 0 and i < count and r:NextNumber() < 0.45 then
			local dk = th.decor[r:NextInteger(1, #th.decor)]
			local a = r:NextNumber(0, PI * 2)
			WK2.prop(dk, { position = pos + V3(math.cos(a), 0, math.sin(a)) * d * 0.32, parent = pm, scale = 0.6,
				seed = r:NextInteger(1, 1e6), palette = o.palette })
		end
		if o.coins ~= false and prevTop and kind ~= "spinner" then
			for k = 1, 3 do
				local t = k / 4
				local p = prevTop:Lerp(pos, t) + V3(0, 3 + 3.5 * math.sin(t * PI), 0)
				WK2.prop("coin", { position = p, parent = m, palette = o.palette })
			end
		end
		table.insert(platforms, pm)
		prevR = kind == "spinner" and d * 0.9 or d / 2
		prevTop = pos
	end
	local last = platforms[#platforms]
	WK2.prop("flag", { position = prevTop + V3(0, 0, 0), parent = m, color = pal.gold, height = 14, palette = o.palette })
	local goal = box(m, V3(14, 10, 14), CF(prevTop + V3(0, 5, 0)), pal.gold, M.SmoothPlastic)
	goal.Transparency = 1
	goal.CanCollide = false
	goal.CanQuery = false
	goal.Name = "Goal"
	tag(goal, "KitGoal")
	local _ = last
	local s0 = platforms[1].PrimaryPart.Position
	return { model = m, platforms = platforms, checkpoints = checkpoints, goal = goal,
		start = CF(s0 + V3(0, 3.5, 0), s0 + V3(0, 3.5, 0) + (o.direction or V3(0, 0, -1))) }
end

-- ---------------------------------------------------------------------------------------------------- arena

-- WorldKit2.arena({center, shape="square"|"circle", size=160, wallHeight=14, style="military"|"scifi"|"fantasy"|"toon",
-- cover=true, ramps=true, seed, palette, parent}) -> {model, spawns={CFrame}, center, size}. Cover is laid out in one
-- quadrant and mirrored four ways (fair sightlines); a raised centre platform with ramps holds the high ground.
-- Spawns are invisible parts tagged KitSpawn around the edge, each marked by a glowing pad.
function WK2.arena(o)
	o = o or {}
	local c = o.center or Vector3.zero
	local S = o.size or 160
	local H = o.wallHeight or 14
	local style = o.style or (LookKit.isToon and "toon" or "military")
	local r = Random.new(o.seed or 11)
	local pal = palOf(o)
	local m = Instance.new("Model")
	m.Name = o.name or "Arena"
	m.Parent = o.parent or folder("WorldKit2")
	local circle = o.shape == "circle"
	local floorCol = style == "toon" and pal.ground or (style == "scifi" and pal.floor or pal.path:Lerp(pal.rock, 0.5))
	local floorMat = style == "toon" and mat("ground") or (style == "military" and M.Concrete or mat("floor"))
	if circle then
		vcyl(m, 2, S, CF(c - V3(0, 1, 0)), floorCol, floorMat)
	else
		box(m, V3(S, 2, S), CF(c - V3(0, 1, 0)), floorCol, floorMat)
	end
	local lineCol = style == "scifi" and pal.glow or shade(floorCol, -0.12)
	local lineStep = style == "scifi" and 32 or 16
	for x = -S / 2 + lineStep, S / 2 - lineStep, lineStep do
		for _, axis in ipairs({ "x", "z" }) do
			local half = circle and math.sqrt(math.max(0, (S / 2) ^ 2 - x * x)) or S / 2
			local sz = axis == "x" and V3(0.4, 0.06, half * 2) or V3(half * 2, 0.06, 0.4)
			local p = axis == "x" and V3(x, 0.03, 0) or V3(0, 0.03, x)
			local ln = box(m, sz, CF(c + p), lineCol, style == "scifi" and M.Neon or floorMat)
			ln.CanCollide = false
			ln.CastShadow = false
		end
	end
	local wallCol = style == "toon" and pal.secondary or pal.wall:Lerp(pal.rock, 0.35)
	local capCol = style == "scifi" and pal.glow or (style == "toon" and pal.trim or shade(wallCol, 0.12))
	local function wallSeg(cf, len)
		box(m, V3(len, H, 3), cf * CF(0, H / 2, 0), wallCol, mat("wall"))
		local cap = box(m, V3(len + 0.2, 0.8, 3.6), cf * CF(0, H + 0.4, 0), capCol, style == "scifi" and M.Neon or mat("default"))
		cap.CastShadow = false
	end
	local pillars = {}
	if circle then
		local n = math.max(16, math.floor(PI * S / 14))
		local R = S / 2 + 1.5
		local segLen = 2 * R * math.tan(PI / n) + 0.4
		for i = 0, n - 1 do
			local a = i / n * PI * 2
			local p = c + V3(math.cos(a) * R, 0, math.sin(a) * R)
			wallSeg(CFrame.lookAt(p, c), segLen)
			if i % 4 == 0 then table.insert(pillars, p) end
		end
	else
		for _, sd in ipairs({ { 0, 1 }, { 0, -1 }, { 1, 0 }, { -1, 0 } }) do
			local p = c + V3(sd[1] * (S / 2 + 1.5), 0, sd[2] * (S / 2 + 1.5))
			wallSeg(CFrame.lookAt(p, c), S + 6)
			for k = -2, 2 do
				local along = V3(sd[2], 0, sd[1]) * (k * S / 4)
				table.insert(pillars, p + along)
			end
		end
	end
	for _, p in ipairs(pillars) do
		local pl = box(m, V3(4.5, H + 3, 4.5), CF(p + V3(0, (H + 3) / 2, 0)), shade(wallCol, -0.12), mat("stone"))
		if style == "scifi" or style == "fantasy" then
			local lamp = box(m, V3(2, 1.2, 2), CF(p + V3(0, H + 3.6, 0)), style == "scifi" and pal.glow
				or Color3.fromRGB(255, 150, 60), M.Neon)
			lamp.CastShadow = false
			light(lamp, lamp.Color, 1.6, 30)
		end
		local _ = pl
	end
	-- mirrored cover
	if o.cover ~= false then
		local items = {}
		local nItems = math.floor(S / 36) + 3
		local placed = {}
		for _ = 1, nItems * 6 do
			if #items >= nItems then break end
			local x, z = r:NextNumber(10, S / 2 - 12), r:NextNumber(10, S / 2 - 12)
			if circle and math.sqrt(x * x + z * z) > S / 2 - 12 then continue end
			if math.sqrt(x * x + z * z) < 22 then continue end
			local ok = true
			for _, q in ipairs(placed) do
				if (q - V3(x, 0, z)).Magnitude < 14 then
					ok = false
					break
				end
			end
			if not ok then continue end
			table.insert(placed, V3(x, 0, z))
			local kinds = style == "military" and { "crates", "low_wall", "sandbags", "barrels", "pillar" }
				or (style == "scifi" and { "crates", "low_wall", "pillar", "crates" }
				or { "crates", "low_wall", "barrels", "pillar", "rock" })
			table.insert(items, { kind = kinds[r:NextInteger(1, #kinds)], x = x, z = z, rot = r:NextInteger(0, 1) * 90,
				seed = r:NextInteger(1, 1e6) })
		end
		local crateCol = style == "scifi" and pal.metal or (style == "toon" and pal.accent or nil)
		for _, mir in ipairs({ { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } }) do
			for _, it in ipairs(items) do
				local p = c + V3(it.x * mir[1], 0, it.z * mir[2])
				local common = { parent = m, palette = o.palette, seed = it.seed, rotation = it.rot }
				local function put(kind, pos, extra)
					local opts = {}
					for k, v in pairs(common) do opts[k] = v end
					for k, v in pairs(extra or {}) do opts[k] = v end
					opts.position = pos
					return WK2.prop(kind, opts)
				end
				if it.kind == "crates" then
					put("crate", p, { color = crateCol })
					put("crate", p + V3(4.2, 0, 0), { color = crateCol })
					put("crate", p + V3(2.1, 4, 0), { color = crateCol, rotation = it.rot + 20 })
				elseif it.kind == "low_wall" then
					put("low_wall", p, { length = 12 })
				elseif it.kind == "sandbags" then
					put("sandbags", p, { length = 10 })
				elseif it.kind == "barrels" then
					put("barrel", p, {})
					put("barrel", p + V3(3.4, 0, 0.6), {})
					put("barrel", p + V3(1.4, 0, 3), {})
				elseif it.kind == "pillar" then
					put("pillar", p, { height = H })
				else
					put("rock", p, { size = 7 })
				end
			end
		end
	end
	-- centre high ground
	if o.ramps ~= false then
		local ph = 6
		box(m, V3(22, ph, 22), CF(c + V3(0, ph / 2, 0)), wallCol, mat("wall"))
		box(m, V3(22.6, 0.6, 22.6), CF(c + V3(0, ph + 0.3, 0)), capCol, style == "scifi" and M.Neon or mat("default"))
		for _, sgn in ipairs({ 1, -1 }) do
			WK2.prop("ramp", { position = c + V3(0, 0, sgn * (11 + 8)), rotation = sgn > 0 and 180 or 0, width = 10, height = ph,
				length = 16, parent = m, palette = o.palette, color = shade(wallCol, 0.1) })
		end
		WK2.prop("crate", { position = c + V3(6, ph + 0.6, 6), parent = m, palette = o.palette })
		WK2.prop("crate", { position = c + V3(-6, ph + 0.6, -6), parent = m, palette = o.palette })
	end
	local spawns = {}
	local n = o.spawns or 8
	for i = 0, n - 1 do
		local a = i / n * PI * 2 + PI / n
		local R = circle and S / 2 - 9 or (S / 2 - 9) / math.max(math.abs(math.cos(a)), math.abs(math.sin(a)))
		R = math.min(R, S / 2 - 9) * (circle and 1 or 1)
		local p = c + V3(math.cos(a) * R, 0, math.sin(a) * R)
		local cf = CFrame.lookAt(p + V3(0, 3, 0), c + V3(0, 3, 0))
		local padp = vcyl(m, 0.2, 6, CF(p + V3(0, 0.1, 0)), pal.glow, M.Neon)
		padp.CanCollide = false
		padp.CastShadow = false
		local sp = box(m, V3(4, 1, 4), cf, pal.glow, M.SmoothPlastic)
		sp.Transparency = 1
		sp.CanCollide = false
		sp.CanQuery = false
		sp.Name = "SpawnPoint" .. (i + 1)
		tag(sp, "KitSpawn", { Index = i + 1 })
		table.insert(spawns, cf)
	end
	return { model = m, spawns = spawns, center = c, size = S }
end

-- ---------------------------------------------------------------------------------------------------- room

local SIDES = {
	north = { n = V3(0, 0, 1), yaw = 0 }, south = { n = V3(0, 0, -1), yaw = 180 },
	east = { n = V3(1, 0, 0), yaw = 90 }, west = { n = V3(-1, 0, 0), yaw = -90 },
}

-- WorldKit2.room({center (floor centre), size=Vector3(40,14,32), theme="kitchen"|"tavern"|"office"|"lab"|"bedroom",
-- doors={"south"}, windows=true, ceiling=false, lights=true, seed, palette, parent}) -> {model, stations={{kind, part,
-- position}}, spawn, floorY, bounds}. Walls with door gaps, wainscot + trim, themed floor, furniture against the
-- walls facing in. Stations (stove, sink, counter, fridge, table, desk, ...) are tagged KitStation for prompts.
-- No ceiling by default so top-down / follow cameras see in.
function WK2.room(o)
	o = o or {}
	local c = o.center or Vector3.zero
	local size = o.size or V3(40, 14, 32)
	local W, H, D = size.X, size.Y, size.Z
	local theme = o.theme or "kitchen"
	local r = Random.new(o.seed or 21)
	local pal = palOf(o)
	local m = Instance.new("Model")
	m.Name = o.name or ("Room_" .. theme)
	m.Parent = o.parent or folder("WorldKit2")
	local doors = {}
	for _, d in ipairs(o.doors or { "south" }) do doors[d] = true end

	-- floor
	if theme == "kitchen" or theme == "lab" then
		local t = theme == "lab" and 8 or 4
		local a = pal.trim
		local b = theme == "lab" and shade(pal.trim, -0.08) or pal.secondary:Lerp(pal.trim, 0.45)
		for ix = 0, math.ceil(W / t) - 1 do
			for iz = 0, math.ceil(D / t) - 1 do
				local tw, td = math.min(t, W - ix * t), math.min(t, D - iz * t)
				box(m, V3(tw, 1, td), CF(c + V3(-W / 2 + ix * t + tw / 2, -0.5, -D / 2 + iz * t + td / 2)),
					(ix + iz) % 2 == 0 and a or b, mat("floor") == M.WoodPlanks and M.SmoothPlastic or mat("default"))
			end
		end
	elseif theme == "office" then
		box(m, V3(W, 1, D), CF(c - V3(0, 0.5, 0)), pal.secondary:Lerp(pal.ink, 0.45), M.Fabric)
	else
		local n = math.ceil(D / 2)
		for i = 0, n - 1 do
			box(m, V3(W, 1, 2), CF(c + V3(0, -0.5, -D / 2 + i * 2 + 1)), jitter(pal.floor, r, 0.04), mat("floor"))
		end
	end

	-- walls
	local wallCol = c3(o.wallColor, theme == "lab" and pal.trim or pal.wall)
	local lowCol = theme == "lab" and pal.secondary:Lerp(pal.trim, 0.5) or (theme == "office" and shade(wallCol, -0.1) or pal.wood)
	for name, sd in pairs(SIDES) do
		local L = (name == "north" or name == "south") and W + 2 or D
		local half = (name == "north" or name == "south") and D / 2 or W / 2
		local base = CF(c + sd.n * (half + 0.5)) * ANG(0, rad(sd.yaw), 0)
		local inward = -sd.n
		local segs
		if doors[name] then
			local dw = 6
			segs = { { -L / 4 - dw / 4, L / 2 - dw / 2 }, { L / 4 + dw / 4, L / 2 - dw / 2 } }
			box(m, V3(dw, H - 8, 1), base * CF(0, 8 + (H - 8) / 2, 0), wallCol, mat("wall"))
			for _, x in ipairs({ -dw / 2 - 0.3, dw / 2 + 0.3 }) do
				box(m, V3(0.6, 8.4, 1.4), base * CF(x, 4.2, 0), pal.trim, mat("default"))
			end
			box(m, V3(dw + 1.2, 0.6, 1.4), base * CF(0, 8.3, 0), pal.trim, mat("default"))
		else
			segs = { { 0, L } }
		end
		for _, sg in ipairs(segs) do
			local x, len = sg[1], sg[2]
			box(m, V3(len, H, 1), base * CF(x, H / 2, 0), wallCol, mat("wall"))
			local inner = base * CF(x, 0, 0) + inward * 0.6
			box(m, V3(len, 3.6, 0.25), inner + V3(0, 1.8, 0), lowCol, theme == "lab" and mat("default") or mat("wood"))
			box(m, V3(len, 0.3, 0.45), inner + V3(0, 3.7, 0), pal.trim, mat("default"))
			box(m, V3(len, 0.6, 0.4), inner + V3(0, 0.3, 0), shade(lowCol, -0.2), mat("default"))
			box(m, V3(len, 0.5, 0.5), inner + V3(0, H - 0.25, 0), pal.trim, mat("default"))
		end
		if not doors[name] and o.windows ~= false and name ~= "north" then
			for _, x in ipairs({ -L / 4, L / 4 }) do
				local wp = (base * CF(x, H * 0.55, 0)).Position + inward * 0.5
				window(m, CFrame.lookAt(wp, wp + inward), 4, 4, pal, false)
			end
		end
	end
	if o.ceiling then
		box(m, V3(W + 2, 1, D + 2), CF(c + V3(0, H + 0.5, 0)), shade(wallCol, 0.1), mat("default"))
	end

	-- furniture
	local function put(kind, x, z, rot, extra)
		local opts = { position = c + V3(x, 0, z), rotation = rot or 0, parent = m, palette = o.palette,
			seed = r:NextInteger(1, 1e6) }
		for k, v in pairs(extra or {}) do opts[k] = v end
		return WK2.prop(kind, opts)
	end
	local zN = D / 2 - 1.6
	local xE = W / 2 - 1.6
	if theme == "kitchen" then
		local run = { "counter", "stove", "counter", "sink", "counter", "stove", "counter" }
		local x = -W / 2 + 2.1
		for _, k in ipairs(run) do
			if x > W / 2 - 7 then break end
			put(k, x, zN, 0)
			if k == "stove" then put("pot", x - 0.9, zN - 0.6, 0, { position = c + V3(x - 0.9, 3.7, zN - 0.6) }) end
			if k == "counter" and r:NextNumber() < 0.6 then
				put("plate", x, zN - 0.3, 0, { position = c + V3(x, 3.56, zN - 0.3), food = pal.accent })
			end
			x += 4.05
		end
		put("fridge", W / 2 - 2.2, zN + 0.1, 0)
		put("shelf", -W / 2 + 1.2, 0, -90, { jars = true, width = 8, height = 7 })
		for i = 0, 2 do
			put("counter", xE, -2 + i * 4.05, 90, { width = 4 })
		end
		put("table", 0, -D * 0.12, 0, { width = 10, depth = 5, cloth = pal.primary })
		for _, x2 in ipairs({ -3, 0, 3 }) do
			put("chair", x2, -D * 0.12 - 3.4, 180)
			put("chair", x2, -D * 0.12 + 3.4, 0)
			put("plate", x2, -D * 0.12 - 1.4, 0, { position = c + V3(x2, 3.42, -D * 0.12 - 1.4) })
			put("plate", x2, -D * 0.12 + 1.4, 0, { position = c + V3(x2, 3.42, -D * 0.12 + 1.4) })
		end
		put("plant", -W / 2 + 2, -D / 2 + 2, 0)
		put("rug", 0, -D / 2 + 3, 0, { width = 8, depth = 3.5, color = pal.primary })
	elseif theme == "tavern" then
		for x = -W / 2 + 3, W / 2 - 4, 4.05 do
			put("counter", x, zN - 5, 0, { color = pal.wood })
		end
		for x = -W / 2 + 3, W / 2 - 3, 4 do
			put("barrel", x, zN, 0, { scale = 0.9 })
		end
		put("fireplace", -W / 2 + 2, 0, -90, { width = 9 })
		put("rug", -W / 2 + 8, 0, 90, { width = 10, depth = 7, color = pal.primary })
		for _, t in ipairs({ { 4, -4 }, { 10, 4 }, { 2, -D / 2 + 6 }, { -4, -D / 2 + 7 } }) do
			if math.abs(t[1]) < W / 2 - 5 then
				put("table", t[1], t[2], 0, { round = true, width = 5, cloth = r:NextNumber() < 0.5 and pal.fabric or nil })
				for k = 0, 3 do
					local a = k / 4 * PI * 2 + PI / 4
					put("chair", t[1] + math.cos(a) * 3.6, t[2] + math.sin(a) * 3.6, 90 - math.deg(a))
				end
			end
		end
		put("shelf", xE, 4, 90, { jars = true })
	elseif theme == "office" then
		for ix = -1, 1 do
			for iz = 0, 1 do
				local x, z = ix * (W / 3.2), -D * 0.18 + iz * 10
				put("desk", x, z, 0)
				put("chair", x - 0.4, z - 2.8, 180, { color = pal.ink:Lerp(pal.metal, 0.3) })
			end
		end
		put("bookshelf", -W / 4, zN - 0.3, 0, { width = 8, height = 8 })
		put("bookshelf", W / 4, zN - 0.3, 0, { width = 8, height = 8 })
		for _, cc in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			put("plant", cc[1] * (W / 2 - 2), cc[2] * (D / 2 - 2), 0)
		end
	elseif theme == "lab" then
		for x = -W / 2 + 4, W / 2 - 4, 6.2 do
			put("lab_bench", x, zN, 0, { width = 6 })
		end
		for z = -D / 2 + 5, D / 2 - 8, 6.2 do
			put("lab_bench", xE, z, 90, { width = 6 })
		end
		put("lab_bench", 0, -2, 0, { width = 8 })
		put("lab_bench", 0, 1.2, 180, { width = 8 })
		put("shelf", -W / 2 + 1.2, 0, -90, { jars = true, width = 10 })
		put("crystal", -W / 4, -D / 2 + 5, 0, { height = 3, color = pal.secondary })
	else -- bedroom
		put("bed", -W / 6, D / 2 - 4.2, 0)
		put("rug", -W / 6, -1, 0, { round = true, width = 10, color = pal.primary })
		put("desk", xE - 0.2, -D / 6, 90)
		put("chair", xE - 3.4, -D / 6, -90)
		put("bookshelf", -W / 2 + 1.2, -D / 6, -90, { width = 7, height = 8 })
		put("plant", W / 2 - 2, D / 2 - 2, 0)
		put("table", -W / 6 + 4.5, D / 2 - 2.2, 0, { width = 2.4, depth = 2.4 })
		put("chest", W / 6, D / 2 - 2.5, 0, { size = 3.6 })
	end

	-- lights: warm fill + sconces (or pendants when there is a ceiling)
	if o.lights ~= false then
		local warm = pal.glow:Lerp(Color3.new(1, 1, 1), 0.35)
		local fill = box(m, V3(1, 1, 1), CF(c + V3(0, H - 2, 0)), warm, M.SmoothPlastic)
		fill.Transparency = 1
		fill.CanCollide = false
		fill.CanQuery = false
		light(fill, warm, 0.9, math.max(W, D) * 0.9)
		for _, x in ipairs({ -W / 4, W / 4 }) do
			if o.ceiling then
				vcyl(m, 3, 0.15, CF(c + V3(x, H - 1.5, 0)), pal.ink, mat("default"))
				blob(m, V3(3, 1.6, 3), CF(c + V3(x, H - 3.3, 0)), pal.primary, mat("default"))
				local bulb = ball(m, 1, CF(c + V3(x, H - 4, 0)), warm, M.Neon)
				light(bulb, warm, 1.2, 22)
			else
				local wp = c + V3(x, H * 0.62, D / 2 - 0.4)
				box(m, V3(1.2, 1.6, 0.5), CF(wp), pal.metal, mat("metal"))
				local bulb = box(m, V3(1, 1, 0.6), CF(wp - V3(0, 0, 0.4)), warm, M.Neon)
				bulb.CastShadow = false
				light(bulb, warm, 1.2, 20)
			end
		end
	end

	local stations = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and CollectionService:HasTag(d, "KitStation") then
			table.insert(stations, { kind = d:GetAttribute("Station"), part = d, position = d.Position })
		end
	end
	return { model = m, stations = stations, spawn = c + V3(0, 3, -D / 2 + 4), floorY = c.Y,
		bounds = { center = c, size = size } }
end
WK2.interior = WK2.room

-- ---------------------------------------------------------------------------------------------------- town

-- WorldKit2.town({center, blocks=3 (n x n), blockSize=56, street=16, style="suburb"|"city"|"neon"|"medieval"|"western",
-- seed, palette, parent}) -> {model, blocks={Vector3}, intersections={Vector3}, spawn}. Street grid with sidewalks,
-- lane dashes and streetlights; each block holds four lots whose buildings face the street.
function WK2.town(o)
	o = o or {}
	local c = o.center or Vector3.zero
	local n = o.blocks or 3
	local B, St = o.blockSize or 56, o.street or 16
	local style = o.style or "suburb"
	local r = Random.new(o.seed or 31)
	local pal = palOf(o)
	local m = Instance.new("Model")
	m.Name = o.name or ("Town_" .. style)
	m.Parent = o.parent or folder("WorldKit2")
	local total = n * B + (n + 1) * St
	local x0, z0 = c.X - total / 2, c.Z - total / 2
	local roadCol, roadMat = pal.ink:Lerp(pal.metal, 0.25), mat("road")
	if style == "medieval" then
		roadCol, roadMat = pal.path:Lerp(pal.rock, 0.4), M.Cobblestone
	elseif style == "western" then
		roadCol, roadMat = pal.sand:Lerp(pal.dirt, 0.3), M.Sand
	end
	local intersections = {}
	for i = 0, n do
		local p = i * (B + St) + St / 2
		box(m, V3(St, 1, total), CF(x0 + p, c.Y - 0.5, c.Z), roadCol, roadMat)
		box(m, V3(total, 1, St), CF(c.X, c.Y - 0.5, z0 + p), roadCol, roadMat)
		for j = 0, n do
			table.insert(intersections, V3(x0 + p, c.Y, z0 + j * (B + St) + St / 2))
		end
		if style ~= "medieval" and style ~= "western" then
			for k = 0, math.floor(total / 10) - 1 do
				local q = -total / 2 + k * 10 + 5
				if (k % 2) == 0 then
					local d1 = box(m, V3(0.5, 0.05, 4), CF(x0 + p, c.Y + 0.02, c.Z + q), pal.accent, mat("default"))
					local d2 = box(m, V3(4, 0.05, 0.5), CF(c.X + q, c.Y + 0.02, z0 + p), pal.accent, mat("default"))
					d1.CanCollide = false
					d2.CanCollide = false
				end
			end
		end
	end
	local blocks = {}
	local walkCol = style == "western" and pal.wood or pal.path:Lerp(pal.trim, 0.3)
	for bi = 0, n - 1 do
		for bj = 0, n - 1 do
			local bc = V3(x0 + St + bi * (B + St) + B / 2, c.Y, z0 + St + bj * (B + St) + B / 2)
			table.insert(blocks, bc)
			box(m, V3(B, 1, B), CF(bc - V3(0, 0.25, 0)), walkCol, style == "western" and mat("wood") or M.Concrete)
			if style == "suburb" or style == "medieval" then
				box(m, V3(B - 5, 1, B - 5), CF(bc - V3(0, 0.15, 0)), pal.ground, mat("ground"))
			end
			if style == "suburb" then
				WK2.prop("round_tree", { position = bc + V3(0, 0.35, 0), parent = m, seed = r:NextInteger(1, 1e6),
					palette = o.palette, scale = 0.7 })
			end
			for _, lot in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
				local lp = bc + V3(lot[1] * B / 4, 0.35, lot[2] * B / 4)
				local facesX = r:NextNumber() < 0.5
				local rot = facesX and (lot[1] > 0 and -90 or 90) or (lot[2] > 0 and 180 or 0)
				local seed = r:NextInteger(1, 1e6)
				local common = { position = lp, rotation = rot, parent = m, palette = o.palette, seed = seed }
				local function put(kind, extra)
					local opts = {}
					for k, v in pairs(common) do opts[k] = v end
					for k, v in pairs(extra or {}) do opts[k] = v end
					return WK2.prop(kind, opts)
				end
				if style == "suburb" then
					put("house", { width = B * 0.26, depth = B * 0.22, floors = r:NextInteger(1, 2),
						roof = ({ pal.roof, pal.secondary, pal.primary })[r:NextInteger(1, 3)] })
				elseif style == "medieval" then
					put("house", { width = B * 0.3, depth = B * 0.24, floors = r:NextInteger(1, 2), lit = true,
						color = pal.wall:Lerp(pal.wood, r:NextNumber(0, 0.4)) })
				elseif style == "western" then
					put("shop", { width = B * 0.36, depth = B * 0.3, height = r:NextNumber(9, 13),
						color = pal.wood:Lerp(pal.wall, r:NextNumber(0.2, 0.7)), accent = pal.primary })
					WK2.prop("barrel", { position = lp + V3(lot[1] * 4, 0, -lot[2] * B * 0.2), parent = m, palette = o.palette })
				elseif style == "neon" then
					if r:NextNumber() < 0.75 then
						put("tower", { style = "neon", height = r:NextNumber(30, 80), width = B * 0.36 })
					else
						put("shop", { width = B * 0.36, depth = B * 0.3, lit = true, accent = pal.primary })
					end
				else -- city
					if r:NextNumber() < 0.55 then
						put("skyscraper", { height = r:NextNumber(30, 70), width = B * 0.36 })
					else
						put("shop", { width = B * 0.36, depth = B * 0.3, accent = ({ pal.primary, pal.secondary, pal.accent })[r:NextInteger(1, 3)] })
					end
				end
			end
		end
	end
	for _, ip in ipairs(intersections) do
		local corner = ip + V3(St / 2 + 1, 0.35, St / 2 + 1)
		if math.abs(corner.X - c.X) < total / 2 - 2 and math.abs(corner.Z - c.Z) < total / 2 - 2 then
			if style == "medieval" then
				WK2.prop("lamp", { position = corner, parent = m, palette = o.palette, height = 8 })
			elseif style ~= "western" then
				WK2.prop("streetlight", { position = corner, rotation = 45, parent = m, palette = o.palette,
					color = style == "neon" and pal.secondary or nil })
			end
		end
	end
	return { model = m, blocks = blocks, intersections = intersections, spawn = intersections[1] + V3(0, 4, 0) }
end

-- ---------------------------------------------------------------------------------------------------- dungeon

-- WorldKit2.dungeon({center, rooms=8, cell=8, roomCells={2,4}, height=12, torches=true, seed, palette, parent}) ->
-- {model, rooms={{center, size}}, start=Vector3, finish=Vector3}. Rooms on a grid joined by L corridors; floors per
-- room, walls only on open edges; pillars in big rooms, torches, crates/barrels; a chest + gem in the final room
-- (tagged KitGoal). Open-topped for third-person/top-down cameras.
function WK2.dungeon(o)
	o = o or {}
	local c = o.center or Vector3.zero
	local cell = o.cell or 8
	local H = o.height or 12
	local r = Random.new(o.seed or 41)
	local pal = palOf(o)
	local m = Instance.new("Model")
	m.Name = o.name or "Dungeon"
	m.Parent = o.parent or folder("WorldKit2")
	local rc = o.roomCells or { 2, 4 }
	local occ = {}
	local function key(x, z) return x .. "," .. z end
	local rooms = {}
	local function overlaps(x, z, w, h)
		for _, rm in ipairs(rooms) do
			if x - 1 < rm.x + rm.w and x + w + 1 > rm.x and z - 1 < rm.z + rm.h and z + h + 1 > rm.z then
				return true
			end
		end
		return false
	end
	local dirs = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
	for i = 1, o.rooms or 8 do
		local w, h = r:NextInteger(rc[1], rc[2]), r:NextInteger(rc[1], rc[2])
		if i == 1 then
			table.insert(rooms, { x = -math.floor(w / 2), z = -math.floor(h / 2), w = w, h = h })
		else
			local prev = rooms[#rooms]
			local placedRoom = false
			for _ = 1, 12 do
				local d = dirs[r:NextInteger(1, 4)]
				local gap = r:NextInteger(2, 4)
				local x = d[1] == 0 and prev.x + r:NextInteger(-1, 1) or (d[1] > 0 and prev.x + prev.w + gap or prev.x - gap - w)
				local z = d[2] == 0 and prev.z + r:NextInteger(-1, 1) or (d[2] > 0 and prev.z + prev.h + gap or prev.z - gap - h)
				if not overlaps(x, z, w, h) then
					table.insert(rooms, { x = x, z = z, w = w, h = h })
					placedRoom = true
					break
				end
			end
			if not placedRoom then break end
		end
	end
	for _, rm in ipairs(rooms) do
		for x = rm.x, rm.x + rm.w - 1 do
			for z = rm.z, rm.z + rm.h - 1 do
				occ[key(x, z)] = "room"
			end
		end
	end
	local corridorCells = {}
	for i = 2, #rooms do
		local a, b = rooms[i - 1], rooms[i]
		local ax, az = a.x + math.floor(a.w / 2), a.z + math.floor(a.h / 2)
		local bx, bz = b.x + math.floor(b.w / 2), b.z + math.floor(b.h / 2)
		local x, z = ax, az
		while x ~= bx do
			x += (bx > x) and 1 or -1
			if not occ[key(x, z)] then occ[key(x, z)] = "corr"; table.insert(corridorCells, { x, z }) end
		end
		while z ~= bz do
			z += (bz > z) and 1 or -1
			if not occ[key(x, z)] then occ[key(x, z)] = "corr"; table.insert(corridorCells, { x, z }) end
		end
	end
	local function world(gx, gz)
		return c + V3(gx * cell, 0, gz * cell)
	end
	local floorCol = pal.floor:Lerp(pal.rock, 0.5)
	local wallCol = pal.wall:Lerp(pal.rock, 0.3)
	local out = {}
	for _, rm in ipairs(rooms) do
		local ctr = world(rm.x + (rm.w - 1) / 2, rm.z + (rm.h - 1) / 2)
		box(m, V3(rm.w * cell, 1, rm.h * cell), CF(ctr - V3(0, 0.5, 0)), floorCol, mat("floor"))
		table.insert(out, { center = ctr, size = V3(rm.w * cell, H, rm.h * cell) })
	end
	for _, cc in ipairs(corridorCells) do
		box(m, V3(cell, 1, cell), CF(world(cc[1], cc[2]) - V3(0, 0.5, 0)), shade(floorCol, -0.08), mat("floor"))
	end
	local wallSegs = {}
	for k in pairs(occ) do
		local gx, gz = string.match(k, "(-?%d+),(-?%d+)")
		local x, z = tonumber(gx), tonumber(gz)
		for _, d in ipairs(dirs) do
			if not occ[key(x + d[1], z + d[2])] then
				local p = world(x, z) + V3(d[1], 0, d[2]) * (cell / 2 + 0.75)
				local sz = d[1] ~= 0 and V3(1.5, H, cell + 1.5) or V3(cell + 1.5, H, 1.5)
				box(m, sz, CF(p + V3(0, H / 2, 0)), jitter(wallCol, r, 0.03), mat("wall"))
				box(m, sz * V3(1, 0, 1) + V3(0.3, 0.6, 0.3), CF(p + V3(0, H + 0.3, 0)), shade(wallCol, -0.15), mat("stone"))
				table.insert(wallSegs, { p = p, inward = -V3(d[1], 0, d[2]) })
			end
		end
	end
	if o.torches ~= false then
		for i, ws in ipairs(wallSegs) do
			if i % 5 == 0 then
				local tp = ws.p + ws.inward * 1.6
				WK2.prop("torch", { position = tp, parent = m, height = 5, palette = o.palette })
			end
		end
	end
	for i, rm in ipairs(rooms) do
		local info = out[i]
		if rm.w >= 3 and rm.h >= 3 then
			for _, cc in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
				WK2.prop("pillar", { position = info.center + V3(cc[1] * (info.size.X / 2 - cell * 0.75), 0,
					cc[2] * (info.size.Z / 2 - cell * 0.75)), height = H, parent = m, palette = o.palette, color = wallCol })
			end
		end
		if i > 1 and i < #rooms then
			for _ = 1, r:NextInteger(1, 3) do
				local p = info.center + V3(r:NextNumber(-0.35, 0.35) * info.size.X, 0, r:NextNumber(-0.35, 0.35) * info.size.Z)
				WK2.prop(r:NextNumber() < 0.5 and "crate" or "barrel", { position = p, parent = m, palette = o.palette,
					seed = r:NextInteger(1, 1e6), rotation = r:NextNumber(0, 90) })
			end
			if info.size.X >= cell * 3 then
				WK2.prop("rug", { position = info.center, parent = m, width = info.size.X * 0.5, depth = info.size.Z * 0.4,
					palette = o.palette, color = pal.primary })
			end
		end
	end
	local finish = out[#out].center
	WK2.prop("chest", { position = finish, parent = m, palette = o.palette, size = 5 })
	local gem = WK2.prop("gem", { position = finish + V3(0, 6, 0), parent = m, palette = o.palette, size = 2.4 })
	tag(gem.PrimaryPart, "KitGoal")
	return { model = m, rooms = out, start = out[1].center + V3(0, 3, 0), finish = finish }
end

-- ---------------------------------------------------------------------------------------------------- animate

local animConns = {}
local function stopAnim()
	for _, cn in ipairs(animConns) do
		cn:Disconnect()
	end
	table.clear(animConns)
end
-- WorldKit2.animate({movers=true, spinners=true, crumble=true, bounce=true, coins=false}) runs the gameplay hooks:
-- KitMover models swing by MoveOffset over MovePeriod, KitSpinner models turn at SpinSpeed (rad/s) - both set
-- AssemblyLinearVelocity/AngularVelocity so standing players ride along; KitCrumble drops 0.6 s after a player lands
-- and returns after 3 s; KitBounce launches with BouncePower. Characters are client-owned: also call
-- WorldKit2.animate({movers=false, spinners=false, crumble=false}) from a LocalScript so bounce pads launch.
-- coins=true spins KitCoin/KitGem (do that on the client too, not the server). Call once per side; returns a stop fn.
function WK2.animate(o)
	o = o or {}
	stopAnim() -- calling animate again replaces every hook instead of stacking them
	local t0 = os.clock()
	local origins = {}
	local touched = {}
	local function originOf(inst)
		local cf = origins[inst]
		if not cf then
			cf = inst:IsA("Model") and inst:GetPivot() or inst.CFrame
			origins[inst] = cf
		end
		return cf
	end
	local function mainPart(inst)
		return inst:IsA("Model") and inst.PrimaryPart or inst
	end
	local function charOf(hit)
		local model = hit:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then
			return model
		end
		return nil
	end
	local function hook(tagName, fn)
		local function attach(inst)
			local parts = inst:IsA("BasePart") and { inst } or {}
			if inst:IsA("Model") then
				for _, d in ipairs(inst:GetDescendants()) do
					if d:IsA("BasePart") and d.CanCollide then table.insert(parts, d) end
				end
			end
			for _, p in ipairs(parts) do
				if not touched[p] then
					touched[p] = true
					table.insert(animConns, p.Touched:Connect(function(hit) fn(inst, hit) end))
				end
			end
		end
		for _, inst in ipairs(CollectionService:GetTagged(tagName)) do attach(inst) end
		table.insert(animConns, CollectionService:GetInstanceAddedSignal(tagName):Connect(attach))
	end
	if o.crumble ~= false then
		local busy = {}
		hook("KitCrumble", function(inst, hit)
			if busy[inst] or not charOf(hit) then return end
			busy[inst] = true
			task.delay(0.6, function()
				local saved = {}
				for _, d in ipairs(inst:GetDescendants()) do
					if d:IsA("BasePart") then
						saved[d] = { d.Transparency, d.CanCollide }
						d.Transparency = 0.85
						d.CanCollide = false
					end
				end
				task.wait(3)
				for d, s in pairs(saved) do
					d.Transparency = s[1]
					d.CanCollide = s[2]
				end
				busy[inst] = nil
			end)
		end)
	end
	if o.bounce ~= false then
		local cool = {}
		hook("KitBounce", function(inst, hit)
			local ch = charOf(hit)
			if not ch then return end
			if RunService:IsClient() then
				local lp = Players.LocalPlayer
				if not lp or lp.Character ~= ch then return end
			end
			local root = ch:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (cool[ch] or 0) < os.clock() then
				cool[ch] = os.clock() + 0.4
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = V3(v.X, inst:GetAttribute("BouncePower") or 90, v.Z)
			end
		end)
	end
	table.insert(animConns, RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if o.movers ~= false then
			for _, inst in ipairs(CollectionService:GetTagged("KitMover")) do
				if inst:IsDescendantOf(Workspace) then
					-- tolerate wrong attribute types (live: a string MoveOffset errored every frame and froze movers)
					local off = inst:GetAttribute("MoveOffset")
					if typeof(off) ~= "Vector3" then off = V3(0, 0, 10) end
					local per = tonumber(inst:GetAttribute("MovePeriod")) or 4
					local w = 2 * PI / per
					local cf = originOf(inst) + off * math.sin(t * w)
					if inst:IsA("Model") then inst:PivotTo(cf) else inst.CFrame = cf end
					local mp = mainPart(inst)
					if mp then mp.AssemblyLinearVelocity = off * w * math.cos(t * w) end
				end
			end
		end
		if o.spinners ~= false then
			for _, inst in ipairs(CollectionService:GetTagged("KitSpinner")) do
				if inst:IsDescendantOf(Workspace) then
					local sp = inst:GetAttribute("SpinSpeed") or 1
					local cf = originOf(inst) * ANG(0, t * sp, 0)
					if inst:IsA("Model") then
						inst:PivotTo(cf)
						for _, d in ipairs(inst:GetDescendants()) do
							if d:IsA("BasePart") then d.AssemblyAngularVelocity = V3(0, sp, 0) end
						end
					else
						inst.CFrame = cf
						inst.AssemblyAngularVelocity = V3(0, sp, 0)
					end
				end
			end
		end
		if o.coins then
			for _, tg in ipairs({ "KitCoin", "KitGem" }) do
				for _, p in ipairs(CollectionService:GetTagged(tg)) do
					local mdl = p:FindFirstAncestorOfClass("Model")
					if mdl and mdl.PrimaryPart == p then
						local base = originOf(mdl)
						mdl:PivotTo(base * CF(0, math.sin(t * 2) * 0.4, 0) * ANG(0, t * 2.5, 0))
					end
				end
			end
		end
	end))
	return stopAnim
end

-- WorldKit2.level(kind, opts) -> info: a whole dressed, tagged, playable level in one call (LevelKit.build: sky_islands,
-- meadow_course, arena, town). Required lazily: LevelKit itself is built on this module.
function WK2.level(kind, o)
	return require(Kit:WaitForChild("LevelKit")).build(kind, o)
end

return WK2
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="43">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">AssetMap</string>
          <string name="Source"><![CDATA[-- Generated by cybus-harness: generated art by name. Use Kit.Assets.image(name).
return {
	star_glyph = { id = "rbxasset://cybus/starbloom_starbloom_final/star_glyph.png" },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Config: single source of truth for gameplay numbers.
-- Every movement verb, reward cadence and grade threshold lives here so the
-- server (RunState) and client (Player) always agree. No magic numbers elsewhere.

local M = {}

-- Movement verbs (ControllerKit.platformer opts, verbatim)
M.runSpeed = 32
M.jumpHeight = 9.5
M.doubleJumpHeight = 7.5
M.doubleJumpCount = 1
M.longJumpSpeed = 64
M.longJumpHeight = 5
M.longJumpMinSpeed = 16
M.diveSpeed = 52
M.diveUp = 14
M.groundPoundHang = 0.14
M.groundPoundSpeed = 160
M.wallKick = false
M.coyote = 0.1
M.buffer = 0.13
M.fallGravity = 1.7
M.maxFall = 190

-- Run shape
M.coinTotal = 30
M.seedCount = 2
M.coinValue = 1
M.comboWindow = 2.5 -- seconds before a coin chain resets the arpeggio pitch
M.comboMaxPitch = 8 -- max coins in a chain before the arpeggio caps

-- Grades (time in seconds, coins collected)
M.gradeS_time = 75
M.gradeS_coins = 25
M.gradeA_time = 90

-- Signature moment: the Grand Bloom
M.grandBloom_scale = 0.3
M.grandBloom_duration = 6
M.miniBloom_delay = 2 -- deposit -> visible mini-bloom on the hub bed
M.miniBloom_duration = 2

-- Camera beats (client)
M.diveFovFrom = 70
M.diveFovTo = 80
M.groundPoundShake = 1.5 -- studs of camera push
M.groundPoundShakeTime = 0.3

-- DataStore
M.bestTimeKey = "StarbloomBestTime_v1"

return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">RunEvents</string>
          <string name="Source"><![CDATA[-- RunEvents: shared remote registry for the run loop.
-- The server (RunBoot) calls RunEvents.create() once; client and server then
-- use get/on/fire so nobody hand-wires a RemoteEvent.
--
-- API:
--   RunEvents.create()          (server only; idempotent)
--   RunEvents.get(name)         -> RemoteInstance?
--   RunEvents.on(name, fn)      -> connection (server: OnServerEvent, client: OnClientEvent)
--   RunEvents.fire(name, ...)   (server -> client; for ResetRun use .invokeServer)
--   RunEvents.invoke(name, ...) -> (server function) client -> server request/response

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = {
	"SeedDeposited",
	"CoinCollected",
	"RunComplete",
	"RunReset",
	"GrandBloomStart",
	"MiniBloom",
	"StateChanged",
}
local FUNCTIONS = {
	"ResetRun",
}

local M = {}

local function ensureFolder()
	local folder = ReplicatedStorage:FindFirstChild("RunRemotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "RunRemotes"
		folder.Parent = ReplicatedStorage
	end
	return folder
end

function M.create()
	local folder = ensureFolder()
	for _, name in EVENTS do
		local inst = folder:FindFirstChild(name)
		if not inst then
			inst = Instance.new("RemoteEvent")
			inst.Name = name
			inst.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		local inst = folder:FindFirstChild(name)
		if not inst then
			inst = Instance.new("RemoteFunction")
			inst.Name = name
			inst.Parent = folder
		end
	end
end

function M.get(name: string)
	local folder = ReplicatedStorage:FindFirstChild("RunRemotes")
	if not folder then
		return nil
	end
	return folder:FindFirstChild(name)
end

function M.on(name: string, fn: (...any) -> ())
	local inst = M.get(name)
	if not inst then
		return nil
	end
	if game:GetService("RunService"):IsServer() then
		return inst.OnServerEvent:Connect(fn)
	else
		return inst.OnClientEvent:Connect(fn)
	end
end

function M.fire(name: string, ...)
	local inst = M.get(name)
	if inst and inst:IsA("RemoteEvent") then
		inst:FireAllClients(...)
	end
end

function M.invoke(name: string, ...)
	local inst = M.get(name)
	if inst and inst:IsA("RemoteFunction") then
		return inst:InvokeServer(...)
	end
	return nil
end

return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Tokens</string>
          <string name="Source"><![CDATA[-- Generated by cybus-harness from the game's style guide. Edit the style guide, not this file.
local Tokens = {}

Tokens.canvas = Vector2.new(1920, 1080)

Tokens.color = {
	bg = Color3.fromHex("#86D4F5"),
	surface = Color3.fromHex("#FFF4DC"),
	surface_raised = Color3.fromHex("#FFFDF4"),
	text = Color3.fromHex("#2B2140"),
	text_muted = Color3.fromHex("#6E6584"),
	primary = Color3.fromHex("#E89400"),
	secondary = Color3.fromHex("#FF6B57"),
	success = Color3.fromHex("#2E9E44"),
	warning = Color3.fromHex("#FF9F1C"),
	danger = Color3.fromHex("#E23D55"),
	primary_soft = Color3.fromHex("#FFC531"),
	success_soft = Color3.fromHex("#55C25C"),
	star_bright = Color3.fromHex("#FFE066"),
	petal_pink = Color3.fromHex("#FFA6C9"),
	meadow = Color3.fromHex("#72C94C"),
	dirt = Color3.fromHex("#8A5A3B"),
	wood = Color3.fromHex("#C98A4B"),
	stone = Color3.fromHex("#D8CDB8"),
	ink = Color3.fromHex("#2B2140"),
	sky_deep = Color3.fromHex("#4FB3E8"),
}

local function font(name: string, weight: string): Font
	local ok, f = pcall(function() return Font.fromEnum((Enum.Font :: any)[name]) end)
	local w = (Enum.FontWeight :: any)[weight] or Enum.FontWeight.Regular
	if ok and f then return Font.new(f.Family, w) end
	if string.find(name, "rbxasset", 1, true) then return Font.new(name, w) end
	return Font.new("rbxasset://fonts/families/" .. name .. ".json", w)
end

Tokens.font = {
	display = font("LuckiestGuy", "Bold"),
	heading = font("Nunito", "ExtraBold"),
	body = font("Nunito", "Medium"),
	numeric = font("Nunito", "ExtraBold"),
}

Tokens.family = {
	display = Tokens.font.display.Family,
	heading = Tokens.font.heading.Family,
	body = Tokens.font.body.Family,
	numeric = Tokens.font.numeric.Family,
}

Tokens.size = {
	display = 96,
	h1 = 48,
	h2 = 32,
	body = 22,
	caption = 16,
	numeric = 40,
}

Tokens.space = { s1 = 4, s2 = 8, s3 = 12, s4 = 16, s5 = 24, s6 = 32, s7 = 48, s8 = 64 }

Tokens.radius = {
	small = UDim.new(0, 6),
	medium = UDim.new(0, 12),
	large = UDim.new(0, 20),
	panel = UDim.new(0, 24),
	card = UDim.new(0, 20),
	button = UDim.new(0, 16),
	icon = UDim.new(0, 12),
	pill = UDim.new(0, 200),
}
Tokens.stroke = 2

Tokens.motion = {
	fast = 0.12,
	base = 0.2,
	slow = 0.35,
	dramatic = 0.6,
	easeOut = Enum.EasingStyle.Quint,
	easeIn = Enum.EasingStyle.Quad,
}
function Tokens.tween(kind: string?, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): TweenInfo
	return TweenInfo.new(Tokens.motion[kind or "base"] or Tokens.motion.base, style or Tokens.motion.easeOut,
		direction or Enum.EasingDirection.Out)
end

Tokens.lighting = {
	ClockTime = 14.5,
	Brightness = 1.5,
	ExposureCompensation = 0.15,
	Ambient = Color3.fromHex("#9CC0F5"),
	OutdoorAmbient = Color3.fromHex("#BFE3FF"),
}

return Tokens
]]></string>
        </Properties>
      </Item>
