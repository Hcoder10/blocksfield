    <Item class="ModuleScript" referent="59">
      <Properties>
        <string name="Name">Hud</string>
        <string name="Source"><![CDATA[-- Hud: Starbloom Peaks HUD + camera direction + signature-moment cinematics.
-- ModuleScript required by Player.client, which calls Hud.init().
--
-- HUD (sticker cards, 5-layer depth recipe, 1920x1080 canvas):
--   * coin counter top-left at (232,76) -- rolls, pops, floats the +delta chip
--   * two star slots + stopwatch top-right
--   * one contextual hint chip bottom-center (max 1 line, auto-hides 4s)
--   * results screen with time/coins/grade stamp + prominent REPLAY (ResetRun)
-- Camera: CameraRig.follow shoulder preset (distance 22, height +6, chest
--   look-at, velocity lead, speedFov). If CameraRig is unavailable a local
--   spring follow camera takes over so the camera ALWAYS follows.
-- Signature moment: on GrandBloomStart -> 6s fixed low-angle orbit around the
--   hub flower bed (radius 14, height 3, FOV 60), time slows to 0.3x
--   (CameraRig.slowmo + replicated worldTimeScale), petals unfurl in 3 stages
--   (custom VFX.preset "grand_bloom"), chime cascade -> fanfare swell, HUD
--   stars flash in sequence, sky brightens one notch, then results.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local function req(path)
	local ok, mod = pcall(function()
		local node = ReplicatedStorage
		for _, seg in ipairs(path:split(".")) do
			node = node:WaitForChild(seg, 10)
			if not node then error("missing " .. seg) end
		end
		return require(node)
	end)
	return ok and mod or nil
end
-- (helper kept above; see UIKit usage notes below)

local Tokens = req("Shared.Tokens")
local UI = req("Kit.UIKit")
local Screen = req("Kit.Screen")
local CameraRig = req("Kit.CameraRig")
local VFX = req("Kit.VFX")
local FX = req("Kit.FXKit")
local Sound = req("Kit.Sound")
local Motion = req("Kit.Motion")
local RunEvents = req("Shared.RunEvents")
local Config = req("Shared.Config")
local Maid = req("Kit.Maid")

local M = {}

-- ---------------------------------------------------------------------------
-- Style constants (from Tokens where they exist; canvas dp otherwise)
-- ---------------------------------------------------------------------------
local C = (Tokens and Tokens.color) or {}
local MARIGOLD = C.primary or Color3.fromHex("#E89400")      -- 'act here' accent
local STAR_GOLD = C.star_bright or Color3.fromHex("#FFE066") -- glyph glow only
local INK = C.ink or Color3.fromHex("#2B2140")
local CREAM = C.surface or Color3.fromHex("#FFF4DC")
local CREAM_HI = C.surface_raised or Color3.fromHex("#FFFDF4")
local MEADOW = C.meadow or Color3.fromHex("#72C94C")
local PINK = C.petal_pink or Color3.fromHex("#FFA6C9")
local CORAL = C.secondary or Color3.fromHex("#FF6B57")
local MUTED = C.text_muted or Color3.fromHex("#6E6584")
local BG = C.bg or Color3.fromHex("#86D4F5")

local FONT = (Tokens and Tokens.font) or {}
local SIZE = (Tokens and Tokens.size) or {}
local STROKE = (Tokens and Tokens.stroke) or 2

local function fnt(role, fallback)
	return FONT[role] or fallback
end
local function size(role, fallback)
	local v = SIZE[role]
	return (v and v > 0) and v or fallback
end

local function canvas()
	if Screen and Screen.canvas then
		local ok, c = pcall(function() return Screen.canvas() end)
		if ok and c then return c end
	end
	return Vector2.new(1920, 1080)
end

local function safeTop()
	if Screen and Screen.topInset then
		local ok, t = pcall(function() return Screen.topInset() end)
		if ok and t then return t end
	end
	return 76
end

-- ---------------------------------------------------------------------------
-- State
-- ---------------------------------------------------------------------------
local player = nil
local char = nil
local root = nil
local rig = nil
local fallbackCam = false
local hudGui = nil
local hudVisible = true
local resultsShown = false
local cinematic = false
local bloomPos = nil
local lastCoin = 0
local combo = 0
local comboHideThread = nil
local hintHideThread = nil
local hintShown = false
local firstHintAt = 7.0
local resultsRoot = nil
local ambient = {}
local petalFx = nil
local skyTween = nil
local clockBase = Lighting.ClockTime
local runStartTime = nil
local timerConn = nil
local camConn = nil

local coinNum = nil
local coinPanel = nil
local timerNum = nil
local starSlots = {}
local hintChip = nil
local coinFloat = nil
local comboChip = nil

local maid = Maid and Maid.new() or nil
local function give(h)
	if maid and h then maid:Give(h) end
end

-- ---------------------------------------------------------------------------
-- Audio registration (full set)
-- ---------------------------------------------------------------------------
local function registerSounds()
	if not Sound then return end
	local function reg(name, ids, extra)
		local t = { ids = ids }
		if extra then for k, v in pairs(extra) do t[k] = v end end
		pcall(function() Sound.register(name, t) end)
	end
	reg("coin", { "rbxassetid://4612374495", "rbxassetid://4612374393", "rbxassetid://4612374209" },
		{ group = "SFX", volume = 0.55, pitch = 0.12 })
	reg("chime", { "rbxassetid://106443875576213", "rbxassetid://82484502884123" },
		{ group = "SFX", volume = 0.7 })
	reg("chime_cascade", { "rbxassetid://106443875576213" }, { group = "SFX", volume = 0.8 })
	reg("fanfare", { "rbxassetid://9041812129", "rbxassetid://1846902475" },
		{ group = "Music", volume = 0.9 })
	reg("jump", { "rbxassetid://2772396665", "rbxassetid://91101985831351" },
		{ group = "SFX", volume = 0.5 })
	reg("double_jump", { "rbxassetid://91101985831351", "rbxassetid://90963666250992" },
		{ group = "SFX", volume = 0.55 })
	reg("whoosh", { "rbxassetid://131023179990618", "rbxassetid://91738733131595" },
		{ group = "SFX", volume = 0.5 })
	reg("whoosh_high", { "rbxassetid://101839951602718", "rbxassetid://4491612181" },
		{ group = "SFX", volume = 0.55 })
	reg("shockwave", { "rbxassetid://2741718865" }, { group = "SFX", volume = 0.6 })
	reg("summer_loop", { "rbxassetid://1847058133", "rbxassetid://1843279222" },
		{ group = "Ambience", volume = 0.4, looped = true })
	reg("afternoon", { "rbxassetid://1843279222", "rbxassetid://1847058133" },
		{ group = "Music", volume = 0.5, looped = true })
end

local function play(name, opts)
	if not Sound then return end
	pcall(function() Sound.play(name, opts or {}) end)
end

local function playCoin(comboCount)
	if not Sound then return end
	local semis = math.clamp((comboCount or 1) - 1, 0, 7) -- +1 semitone per combo, cap +7
	local pitch = 1 + semis * 0.0595
	pcall(function()
		local s = Sound.play("coin", { pitch = pitch })
		if s then
			pcall(function() s.Pitch = pitch end)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- VFX preset (custom, for the signature moment)
-- ---------------------------------------------------------------------------
local function buildPresets()
	if not VFX then return end
	pcall(function()
		VFX.preset("grand_bloom", {
			budget = { effects = 12, particles = 500, lights = 4 },
			layers = {
				-- Stage 1: seed glow + first petal ring (0s)
				{ kind = "light", color = STAR_GOLD, brightness = 4, range = 40, duration = 2.5, attack = 0.1 },
				{ kind = "ring", color = PINK, size = { 2, 14 }, transparency = { 0.2, 1 }, duration = 0.8,
					flat = true, lightEmission = 0.6, brightness = 0.5 },
				{ kind = "particles", delay = 0.0, count = 24, lifetime = { 0.8, 1.4 }, speed = { 6, 14 },
					spread = 180, size = { { 0, 0.4 }, { 0.3, 1.0 }, { 1, 0 } },
					transparency = { { 0, 0 }, { 0.7, 0.3 }, { 1, 1 } },
					color = { PINK, CREAM, STAR_GOLD }, lightEmission = 0.8,
					acceleration = Vector3.new(0, 8, 0), texture = "petal" },
				-- Stage 2: mid unfurl (0.8s)
				{ kind = "ring", delay = 0.8, color = STAR_GOLD, size = { 1, 20 }, transparency = { 0.3, 1 },
					duration = 1.0, flat = true, lightEmission = 0.7, brightness = 0.6 },
				{ kind = "particles", delay = 0.8, count = 36, lifetime = { 1.0, 1.8 }, speed = { 10, 22 },
					spread = 180, size = { { 0, 0.5 }, { 0.25, 1.4 }, { 1, 0 } },
					transparency = { { 0, 0 }, { 0.6, 0.2 }, { 1, 1 } },
					color = { PINK, MEADOW, STAR_GOLD, CREAM }, lightEmission = 0.9,
					acceleration = Vector3.new(0, 14, 0), texture = "petal" },
				-- Stage 3: full bloom + confetti (1.8s)
				{ kind = "ring", delay = 1.8, color = MARIGOLD, size = { 2, 30 }, transparency = { 0.2, 1 },
					duration = 1.2, flat = true, lightEmission = 0.8, brightness = 0.7 },
				{ kind = "particles", delay = 1.8, count = 60, lifetime = { 1.2, 2.2 }, speed = { 16, 34 },
					spread = 180, size = { { 0, 0.6 }, { 0.2, 1.8 }, { 1, 0 } },
					transparency = { { 0, 0 }, { 0.5, 0.2 }, { 1, 1 } },
					color = { MARIGOLD, CORAL, PINK, STAR_GOLD, MEADOW }, lightEmission = 1.0,
					acceleration = Vector3.new(0, 20, 0), texture = "confetti" },
				-- light pillar
				{ kind = "beam", delay = 0.4, from = Vector3.new(0, 0, 0), to = Vector3.new(0, 40, 0),
					width = { 2.5, 0.5 }, color = STAR_GOLD, transparency = { { 0, 0.2 }, { 1, 0.9 } },
					lightEmission = 1.0, brightness = 1.5, duration = 4.0, fadeOut = true },
				{ kind = "light", delay = 0.4, color = STAR_GOLD, brightness = 6, range = 60, duration = 4.0 },
			},
		})
	end)
end

-- ---------------------------------------------------------------------------
-- Character helpers
-- ---------------------------------------------------------------------------
local function onChar(charModel)
	char = charModel
	root = charModel:FindFirstChild("HumanoidRootPart")
end

local function chestPos()
	if root and root.Parent then
		return root.Position + Vector3.new(0, 1.5, 0)
	end
	if char and char.PrimaryPart then
		return char.PrimaryPart.Position + Vector3.new(0, 1.5, 0)
	end
	return nil
end

-- ---------------------------------------------------------------------------
-- Camera: normal-play follow rig (composed shoulder shot)
-- ---------------------------------------------------------------------------
local function startCamera()
	if cinematic then return end
	fallbackCam = false
	if CameraRig then
		local ok, r = pcall(function()
			return CameraRig.follow({
				preset = "shoulder",
				distance = 22,
				height = 6,
				fov = 62,
				lookAhead = 6,
				offset = Vector3.new(0, 0, 0),
				speedFov = { from = 18, to = 44, fov = 10, pull = 2.5 },
				autoAlign = 1.2,
				collision = true,
				orbit = "free",
				sensitivity = 0.8,
			})
		end)
		if ok and r then
			rig = r
			return
		end
	end
	-- Fallback: a local spring follow camera so the camera ALWAYS follows.
	fallbackCam = true
	local cam = workspace.CurrentCamera
	if not cam then return end
	pcall(function()
		cam.CameraType = Enum.CameraType.Scriptable
	end)
	local focus = chestPos() or Vector3.new(0, 10, 0)
	local pos = focus + Vector3.new(0, 6, 22)
	local fov = 62
	if camConn then camConn:Disconnect() end
	camConn = RunService:BindToRenderStep("StarbloomFollowCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local target = chestPos()
		if not target then return end
		local vel = root and root.AssemblyLinearVelocity or Vector3.zero
		local lead = Vector3.new(vel.X, 0, vel.Z).Unit * math.min(vel.Magnitude * 0.12, 8)
		local desiredFocus = target + lead
		local a = 1 - math.exp(-8 * dt)
		focus = focus:Lerp(desiredFocus, a)
		local behind = (focus - pos).Unit
		local desiredPos = focus + behind * 22 + Vector3.new(0, 6, 0)
		pos = pos:Lerp(desiredPos, a)
		-- collision: pull in before geometry
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = { char }
		local hit = Workspace:Raycast(focus, (desiredPos - focus).Unit * (desiredPos - focus).Magnitude, params)
		if hit then
			pos = pos:Lerp(hit.Position - (hit.Position - focus).Unit * 3, 0.5)
		end
		-- speed FOV
		local speed = (root and root.AssemblyLinearVelocity.Magnitude) or 0
		local targetFov = 62 + math.clamp((speed - 18) / 26, 0, 1) * 10
		fov = fov + (targetFov - fov) * math.min(1, 4 * dt)
		cam.CFrame = CFrame.lookAt(pos, focus)
		cam.FieldOfView = fov
	end)
	give(camConn)
end

local function stopCamera()
	if camConn then
		camConn:Disconnect()
		camConn = nil
	end
	if rig then
		pcall(function() rig:stop() end)
		rig = nil
	end
end

-- ---------------------------------------------------------------------------
-- Sticker card helpers (5-layer depth recipe, hand-built so it ALWAYS renders)
-- ---------------------------------------------------------------------------
local function stickerCard(parent, name)
	local wrap = Instance.new("Frame")
	wrap.Name = name
	wrap.BackgroundTransparency = 1
	wrap.BorderSizePixel = 0
	wrap.Parent = parent

	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.Size = UDim2.new(1, 0, 1, 0)
	shadow.Position = UDim2.new(0, 0, 0, 4) -- hard offset 4dp down, 0 blur
	shadow.BackgroundColor3 = INK
	shadow.BackgroundTransparency = 0.78 -- ink @ 22%
	shadow.BorderSizePixel = 0
	shadow.Parent = wrap

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.Size = UDim2.new(1, 0, 1, 0)
	body.BackgroundColor3 = CREAM
	body.BorderSizePixel = 0
	body.Parent = wrap

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 24)
	corner.Parent = body

	local stroke = Instance.new("UIStroke")
	stroke.Color = INK
	stroke.Thickness = STROKE
	stroke.Parent = body

	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(CREAM_HI, CREAM)
	grad.Rotation = 90
	grad.Parent = body

	local rim = Instance.new("Frame")
	rim.Name = "Rim"
	rim.Size = UDim2.new(1, -6, 0, 1)
	rim.Position = UDim2.new(0, 3, 0, 3)
	rim.BackgroundColor3 = Color3.new(1, 1, 1)
	rim.BackgroundTransparency = 0.45 -- white @ 55%
	rim.BorderSizePixel = 0
	local rimCorner = Instance.new("UICorner")
	rimCorner.CornerRadius = UDim.new(0, 22)
	rimCorner.Parent = rim
	rim.Parent = body

	return wrap, body
end

local function starLabel(parent, name)
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.FontFace = fnt("display", Enum.Font.LuckiestGuy)
	l.Text = "★"
	l.TextScaled = true
	l.TextColor3 = MUTED
	l.TextStrokeColor3 = INK
	l.TextStrokeTransparency = 0.5
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.Parent = parent
	return l
end

-- ---------------------------------------------------------------------------
-- HUD build
-- ---------------------------------------------------------------------------
local function buildHud()
	if not player then return end

	hudGui = Instance.new("ScreenGui")
	hudGui.Name = "StarbloomHud"
	hudGui.DisplayOrder = 10
	hudGui.ResetOnSpawn = false
	hudGui.IgnoreGuiInset = false
	hudGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	hudGui.Parent = player:WaitForChild("PlayerGui")
	give(hudGui)

	local top = safeTop()

	-- ================= Coin counter: top-left at (232, 76) =================
	coinPanel = stickerCard(hudGui, "CoinPanel")
	coinPanel.Size = UDim2.new(0, 260, 0, 88)
	coinPanel.Position = UDim2.new(0, 232, 0, 76)
	local coinBody = coinPanel:FindFirstChild("Body")

	-- coin icon: chunky gold disc with ink rim + inner stroke
	local coinIcon = Instance.new("Frame")
	coinIcon.Name = "CoinIcon"
	coinIcon.Size = UDim2.new(0, 56, 0, 56)
	coinIcon.Position = UDim2.new(0, 16, 0.5, -28)
	coinIcon.BackgroundColor3 = STAR_GOLD
	coinIcon.BorderSizePixel = 0
	coinIcon.Parent = coinBody
	local coinCorner = Instance.new("UICorner")
	coinCorner.CornerRadius = UDim.new(1, 0)
	coinCorner.Parent = coinIcon
	local coinStroke = Instance.new("UIStroke")
	coinStroke.Color = INK
	coinStroke.Thickness = 2
	coinStroke.Parent = coinIcon
	local coinInner = Instance.new("Frame")
	coinInner.Name = "Inner"
	coinInner.Size = UDim2.new(1, -16, 1, -16)
	coinInner.Position = UDim2.new(0, 8, 0, 8)
	coinInner.BackgroundColor3 = MARIGOLD
	coinInner.BorderSizePixel = 0
	local coinInnerCorner = Instance.new("UICorner")
	coinInnerCorner.CornerRadius = UDim.new(1, 0)
	coinInnerCorner.Parent = coinInner
	coinInner.Parent = coinIcon
	local coinGlyph = Instance.new("TextLabel")
	coinGlyph.Name = "Glyph"
	coinGlyph.Size = UDim2.new(1, 0, 1, 0)
	coinGlyph.BackgroundTransparency = 1
	coinGlyph.FontFace = fnt("numeric", Enum.Font.GothamBold)
	coinGlyph.Text = "$"
	coinGlyph.TextScaled = true
	coinGlyph.TextColor3 = CREAM_HI
	coinGlyph.Parent = coinIcon

	-- label
	local coinLabel = Instance.new("TextLabel")
	coinLabel.Name = "Label"
	coinLabel.Size = UDim2.new(0, 120, 0, 20)
	coinLabel.Position = UDim2.new(0, 84, 0, 12)
	coinLabel.BackgroundTransparency = 1
	coinLabel.FontFace = fnt("heading", Enum.Font.GothamBold)
	coinLabel.Text = "COINS"
	coinLabel.TextSize = 16
	coinLabel.TextColor3 = MUTED
	coinLabel.TextXAlignment = Enum.TextXAlignment.Left
	coinLabel.TextYAlignment = Enum.TextYAlignment.Center
	coinLabel.Parent = coinBody

	-- number (Nunito:ExtraBold, near-tabular, marigold)
	coinNum = Instance.new("TextLabel")
	coinNum.Name = "Number"
	coinNum.Size = UDim2.new(0, 150, 0, 44)
	coinNum.Position = UDim2.new(0, 84, 0, 32)
	coinNum.BackgroundTransparency = 1
	coinNum.FontFace = fnt("numeric", Enum.Font.GothamBold)
	coinNum.Text = "0"
	coinNum.TextSize = size("numeric", 40)
	coinNum.TextColor3 = MARIGOLD
	coinNum.TextXAlignment = Enum.TextXAlignment.Left
	coinNum.TextYAlignment = Enum.TextYAlignment.Center
	coinNum.Parent = coinBody

	-- +delta float chip
	coinFloat = Instance.new("TextLabel")
	coinFloat.Name = "Float"
	coinFloat.Size = UDim2.new(0, 80, 0, 32)
	coinFloat.Position = UDim2.new(0, 150, 0, -6)
	coinFloat.BackgroundTransparency = 1
	coinFloat.FontFace = fnt("numeric", Enum.Font.GothamBold)
