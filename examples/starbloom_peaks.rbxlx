	-- ================= Star slots + timer: top-right =================
	local starPanel = stickerCard(hudGui, "StarPanel")
	starPanel.Size = UDim2.new(0, 380, 0, 88)
	starPanel.Position = UDim2.new(1, -404, 0, 76) -- 24 dp right margin
	local starBody = starPanel:FindFirstChild("Body")

	for i = 1, 2 do
		local slot = Instance.new("Frame")
		slot.Name = "Slot" .. i
		slot.Size = UDim2.new(0, 64, 0, 64)
		slot.Position = UDim2.new(0, 16 + (i - 1) * 76, 0.5, -32)
		slot.BackgroundColor3 = INK
		slot.BackgroundTransparency = 0.88
		slot.BorderSizePixel = 0
		slot.Parent = starBody
		local slotCorner = Instance.new("UICorner")
		slotCorner.CornerRadius = UDim.new(1, 0)
		slotCorner.Parent = slot
		local slotStroke = Instance.new("UIStroke")
		slotStroke.Color = INK
		slotStroke.Thickness = 2
		slotStroke.Parent = slot

		local glow = Instance.new("Frame")
		glow.Name = "Glow"
		glow.Size = UDim2.new(1, 16, 1, 16)
		glow.Position = UDim2.new(0.5, -8, 0.5, -8)
		glow.BackgroundColor3 = STAR_GOLD
		glow.BackgroundTransparency = 0.9
		glow.BorderSizePixel = 0
		local glowCorner = Instance.new("UICorner")
		glowCorner.CornerRadius = UDim.new(1, 0)
		glowCorner.Parent = glow
		glow.Visible = false
		glow.ZIndex = 0
		glow.Parent = slot

		local star = starLabel(slot, "Star")
		star.Size = UDim2.new(1, -10, 1, -10)
		star.Position = UDim2.new(0, 5, 0, 5)
		star.TextColor3 = Color3.new(0.55, 0.53, 0.6)
		star.ZIndex = 1

		starSlots[i] = { frame = slot, star = star, glow = glow }
	end

	-- timer cluster
	local timerLabel = Instance.new("TextLabel")
	timerLabel.Name = "TimerLabel"
	timerLabel.Size = UDim2.new(0, 120, 0, 20)
	timerLabel.Position = UDim2.new(0, 176, 0, 16)
	timerLabel.BackgroundTransparency = 1
	timerLabel.FontFace = fnt("heading", Enum.Font.GothamBold)
	timerLabel.Text = "TIME"
	timerLabel.TextSize = 16
	timerLabel.TextColor3 = MUTED
	timerLabel.TextXAlignment = Enum.TextXAlignment.Left
	timerLabel.Parent = starBody

	timerNum = Instance.new("TextLabel")
	timerNum.Name = "TimerNumber"
	timerNum.Size = UDim2.new(0, 180, 0, 44)
	timerNum.Position = UDim2.new(0, 176, 0, 34)
	timerNum.BackgroundTransparency = 1
	timerNum.FontFace = fnt("numeric", Enum.Font.GothamBold)
	timerNum.Text = "0:00.0"
	timerNum.TextSize = 32
	timerNum.TextColor3 = MARIGOLD
	timerNum.TextXAlignment = Enum.TextXAlignment.Left
	timerNum.Parent = starBody

	-- ================= Hint chip: bottom-center =================
	local hintWrap = stickerCard(hudGui, "HintChip")
	hintWrap.Size = UDim2.new(0, 460, 0, 56)
	hintWrap.Position = UDim2.new(0.5, -230, 1, -80)
	hintWrap.Visible = false
	hintChip = hintWrap
	local hintText = Instance.new("TextLabel")
	hintText.Name = "Text"
	hintText.Size = UDim2.new(1, -32, 1, 0)
	hintText.Position = UDim2.new(0, 16, 0, 0)
	hintText.BackgroundTransparency = 1
	hintText.FontFace = fnt("body", Enum.Font.Gotham)
	hintText.Text = ""
	hintText.TextSize = 22
	hintText.TextColor3 = INK
	hintText.TextXAlignment = Enum.TextXAlignment.Center
	hintText.TextYAlignment = Enum.TextYAlignment.Center
	hintText.TextTruncate = Enum.TextTruncate.AtEnd
	hintText.Parent = hintWrap:FindFirstChild("Body")
	hintChip.text = hintText
end

-- ---------------------------------------------------------------------------
-- HUD update functions
-- ---------------------------------------------------------------------------
local function bounceCoin()
	if not coinPanel then return end
	if Motion and Motion.punch then
		pcall(function() Motion.punch(coinPanel, 0.12) end)
	else
		local tw = TweenService:Create(coinPanel, TweenInfo.new(0.12, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{ Size = UDim2.new(0, 260 * 1.06, 0, 88 * 1.06) })
		tw:Play()
		task.delay(0.12, function()
			local tw2 = TweenService:Create(coinPanel, TweenInfo.new(0.1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
				{ Size = UDim2.new(0, 260, 0, 88) })
			tw2:Play()
		end)
	end
end

local function showCoinFloat(delta)
	if not coinFloat then return end
	coinFloat.Text = "+" .. tostring(delta)
	coinFloat.Visible = true
	coinFloat.Position = UDim2.new(0, 150, 0, 0)
	local t0 = tick()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = (tick() - t0) / 0.6
		if t >= 1 then
			coinFloat.Visible = false
			if conn then conn:Disconnect() end
			return
		end
		local ease = 1 - (1 - t) ^ 3
		coinFloat.Position = UDim2.new(0, 150, 0, -28 * ease)
		coinFloat.BackgroundTransparency = t
	end)
	give(conn)
end

local function showCombo(n)
	if not comboChip then return end
	local body = comboChip:FindFirstChild("Body")
	local txt = body and body:FindFirstChild("Text")
	if txt then txt.Text = "x" .. tostring(n) end
	comboChip.Visible = true
	if Motion and Motion.punch then
		pcall(function() Motion.punch(comboChip, 0.15) end)
	end
	if comboHideThread then task.cancel(comboHideThread) end
	comboHideThread = task.delay(2.0, function()
		if comboChip and comboChip.Parent then
			comboChip.Visible = false
		end
	end)
end

function M.setCoins(n)
	if not coinNum then return end
	local delta = n - lastCoin
	coinNum.Text = tostring(n)
	lastCoin = n
	if delta > 0 then
		bounceCoin()
		showCoinFloat(delta)
		playCoin(combo + 1)
		combo = combo + 1
		if combo >= 2 then
			showCombo(combo)
		end
		if comboHideThread then task.cancel(comboHideThread) end
		comboHideThread = task.delay(1.5, function()
			combo = 0
		end)
	else
		combo = 0
	end
end

function M.setSeed(i, lit)
	local slot = starSlots[i]
	if not slot then return end
	if lit then
		slot.star.TextColor3 = STAR_GOLD
		slot.star.TextStrokeColor3 = MARIGOLD
		slot.star.TextStrokeTransparency = 0.3
		slot.glow.Visible = true
		if Motion and Motion.punch then
			pcall(function() Motion.punch(slot.frame, 0.2) end)
		end
		-- glow pulse
		local t0 = tick()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local t = (tick() - t0) / 1.0
			if t >= 1 then
				slot.glow.BackgroundTransparency = 0.9
				if conn then conn:Disconnect() end
			else
				slot.glow.BackgroundTransparency = 0.9 - 0.5 * math.sin(t * math.pi)
			end
		end)
		give(conn)
	else
		slot.star.TextColor3 = Color3.new(0.55, 0.53, 0.6)
		slot.star.TextStrokeTransparency = 0.5
		slot.glow.Visible = false
	end
end

function M.setHint(text)
	if not hintChip then return end
	local body = hintChip:FindFirstChild("Body")
	local txt = body and body:FindFirstChild("Text")
	if txt then txt.Text = text end
	hintChip.Visible = true
	-- slide in
	local t0 = tick()
	local dur = 0.25
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = math.clamp((tick() - t0) / dur, 0, 1)
		local ease = 1 - (1 - t) ^ 3
		hintChip.Position = UDim2.new(0.5, -230, 1, -80 + (1 - ease) * 16)
		hintChip.BackgroundTransparency = 0
		if t >= 1 and conn then conn:Disconnect() end
	end)
	give(conn)
	-- auto-hide after 4s
	if hintHideThread then task.cancel(hintHideThread) end
	hintHideThread = task.delay(4.0, function()
		if hintChip and hintChip.Parent then
			hintChip.Visible = false
		end
	end)
end

function M.toggle()
	hudVisible = not hudVisible
	if hudGui then hudGui.Enabled = hudVisible end
end

-- ---------------------------------------------------------------------------
-- Results screen
-- ---------------------------------------------------------------------------
local function formatTime(t)
	local total = math.floor(t or 0)
	local m = math.floor(total / 60)
	local s = total % 60
	return string.format("%d:%02d", m, s)
end

local function buildResults(data)
	if not player then return end
	if resultsRoot then
		resultsRoot:Destroy()
		resultsRoot = nil
	end

	local timeStr = formatTime(data and data.time)
	local coins = (data and data.coins) or 0
	local grade = (data and data.grade) or "B"

	-- backdrop
	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.new(1, 0, 1, 0)
	backdrop.BackgroundColor3 = INK
	backdrop.BackgroundTransparency = 0.35
	backdrop.BorderSizePixel = 0
	backdrop.Parent = hudGui

	-- main card
	local card = stickerCard(hudGui, "ResultsCard")
	card.Size = UDim2.new(0, 900, 0, 620)
	card.Position = UDim2.new(0.5, -450, 0.5, -310)

	local body = card:FindFirstChild("Body")

	-- title
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, -48, 0, 80)
	title.Position = UDim2.new(0, 24, 0, 28)
	title.BackgroundTransparency = 1
	title.FontFace = fnt("display", Enum.Font.LuckiestGuy)
	title.Text = "GARDEN BLOOMED!"
	title.TextSize = size("display", 64)
	title.TextColor3 = MARIGOLD
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextStrokeColor3 = INK
	title.TextStrokeTransparency = 0.4
	title.Parent = body

	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.Size = UDim2.new(1, -48, 0, 32)
	sub.Position = UDim2.new(0, 24, 0, 104)
	sub.BackgroundTransparency = 1
	sub.FontFace = fnt("body", Enum.Font.Gotham)
	sub.Text = "The peaks flower because of you"
	sub.TextSize = 22
	sub.TextColor3 = MUTED
	sub.TextXAlignment = Enum.TextXAlignment.Center
	sub.Parent = body

	-- stats row
	local stats = {
		{ label = "TIME", value = timeStr },
		{ label = "COINS", value = tostring(coins) },
		{ label = "STARS", value = "2 / 2" },
	}
	for i, s in ipairs(stats) do
		local w = 240
		local x = 24 + (i - 1) * (w + 20)
		local chip = Instance.new("Frame")
		chip.Name = "Stat" .. i
		chip.Size = UDim2.new(0, w, 0, 96)
		chip.Position = UDim2.new(0, x, 0, 160)
		chip.BackgroundColor3 = CREAM_HI
		chip.BorderSizePixel = 0
		chip.Parent = body
		local chipCorner = Instance.new("UICorner")
		chipCorner.CornerRadius = UDim.new(0, 20)
		chipCorner.Parent = chip
		local chipStroke = Instance.new("UIStroke")
		chipStroke.Color = INK
		chipStroke.Thickness = 2
		chipStroke.Parent = chip

		local lbl = Instance.new("TextLabel")
		lbl.Name = "Label"
		lbl.Size = UDim2.new(1, 0, 0, 22)
		lbl.Position = UDim2.new(0, 0, 0, 10)
		lbl.BackgroundTransparency = 1
		lbl.FontFace = fnt("heading", Enum.Font.GothamBold)
		lbl.Text = s.label
		lbl.TextSize = 16
		lbl.TextColor3 = MUTED
		lbl.TextXAlignment = Enum.TextXAlignment.Center
		lbl.Parent = chip

		local val = Instance.new("TextLabel")
		val.Name = "Value"
		val.Size = UDim2.new(1, 0, 0, 48)
		val.Position = UDim2.new(0, 0, 0, 36)
		val.BackgroundTransparency = 1
		val.FontFace = fnt("numeric", Enum.Font.GothamBold)
		val.Text = s.value
		val.TextSize = 36
		val.TextColor3 = MARIGOLD
		val.TextXAlignment = Enum.TextXAlignment.Center
		val.Parent = chip
	end

	-- grade stamp (slanted plate, top-right of card)
	local stamp = Instance.new("Frame")
	stamp.Name = "GradeStamp"
	stamp.Size = UDim2.new(0, 120, 0, 120)
	stamp.Position = UDim2.new(1, -150, 0, 40)
	stamp.BackgroundColor3 = MARIGOLD
	stamp.BorderSizePixel = 0
	stamp.Rotation = -8
	stamp.Parent = body
	local stampCorner = Instance.new("UICorner")
	stampCorner.CornerRadius = UDim.new(0, 20)
	stampCorner.Parent = stamp
	local stampStroke = Instance.new("UIStroke")
	stampStroke.Color = INK
	stampStroke.Thickness = 3
	stampStroke.Parent = stamp
	local stampTxt = Instance.new("TextLabel")
	stampTxt.Name = "Text"
	stampTxt.Size = UDim2.new(1, 0, 1, 0)
	stampTxt.BackgroundTransparency = 1
	stampTxt.FontFace = fnt("display", Enum.Font.LuckiestGuy)
	stampTxt.Text = grade
	stampTxt.TextSize = 72
	stampTxt.TextColor3 = CREAM_HI
	stampTxt.TextXAlignment = Enum.TextXAlignment.Center
	stampTxt.TextYAlignment = Enum.TextYAlignment.Center
	stampTxt.Parent = stamp

	-- REPLAY button (UIKit, prominent marigold primary; hand-built plinth fallback)
	local function fireReset()
		local remote = nil
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		if remotes then
			remote = remotes:FindFirstChild("ResetRun")
		end
		if not remote then
			remote = ReplicatedStorage:FindFirstChild("ResetRun")
		end
		if remote then
			pcall(function() remote:InvokeServer() end)
		end
		if RunEvents then
			pcall(function() RunEvents.fire("ResetRun") end)
		end
	end

	local replayBtn = nil
	if UI and UI.button then
		local okB, b = pcall(function()
			return UI.button({
				text = "REPLAY",
				kind = "primary",
				color = MARIGOLD,
				position = UDim2.fromScale(0.5, 0.82),
				anchor = Vector2.new(0.5, 0.5),
				size = Vector2.new(320, 88),
				parent = body,
				onClick = fireReset,
			})
		end)
		if okB then replayBtn = b end
	end

	if not replayBtn then
		local btnWrap = Instance.new("Frame")
		btnWrap.Name = "ReplayWrap"
		btnWrap.Size = UDim2.new(0, 320, 0, 96)
		btnWrap.Position = UDim2.new(0.5, -160, 0, 440)
		btnWrap.BackgroundTransparency = 1
		btnWrap.Parent = body

		local plinth = Instance.new("Frame")
		plinth.Name = "Plinth"
		plinth.Size = UDim2.new(1, 0, 0, 72)
		plinth.Position = UDim2.new(0, 0, 0, 24)
		plinth.BackgroundColor3 = INK
		plinth.BackgroundTransparency = 0.65
		plinth.BorderSizePixel = 0
		local plinthCorner = Instance.new("UICorner")
		plinthCorner.CornerRadius = UDim.new(0, 16)
		plinthCorner.Parent = plinth
		plinth.Parent = btnWrap

		local btn = Instance.new("TextButton")
		btn.Name = "Replay"
		btn.Size = UDim2.new(1, 0, 0, 72)
		btn.Position = UDim2.new(0, 0, 0, 0)
		btn.BackgroundColor3 = MARIGOLD
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = true
		btn.Parent = btnWrap
		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 16)
		btnCorner.Parent = btn
		local btnStroke = Instance.new("UIStroke")
		btnStroke.Color = INK
		btnStroke.Thickness = 2
		btnStroke.Parent = btn
		local btnGrad = Instance.new("UIGradient")
		btnGrad.Color = ColorSequence.new(Color3.fromHex("#F5A623"), MARIGOLD)
		btnGrad.Rotation = 90
		btnGrad.Parent = btn
		local btnTxt = Instance.new("TextLabel")
		btnTxt.Name = "Text"
		btnTxt.Size = UDim2.new(1, 0, 1, 0)
		btnTxt.BackgroundTransparency = 1
		btnTxt.FontFace = fnt("display", Enum.Font.LuckiestGuy)
		btnTxt.Text = "REPLAY"
		btnTxt.TextSize = 40
		btnTxt.TextColor3 = CREAM_HI
		btnTxt.TextXAlignment = Enum.TextXAlignment.Center
		btnTxt.TextYAlignment = Enum.TextYAlignment.Center
		btnTxt.Parent = btn

		btn.MouseButton1Click:Connect(fireReset)
	end

	-- entrance animation: fade + slide
	backdrop.BackgroundTransparency = 1
	card.Position = UDim2.new(0.5, -450, 0.5, -310 + 24)
	local t0 = tick()
	local dur = 0.35
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = math.clamp((tick() - t0) / dur, 0, 1)
		local ease = 1 - (1 - t) ^ 3
		backdrop.BackgroundTransparency = 1 - 0.65 * ease
		card.Position = UDim2.new(0.5, -450, 0.5, -310 + 24 * (1 - ease))
		if t >= 1 and conn then conn:Disconnect() end
	end)
	give(conn)

	resultsRoot = backdrop
	resultsShown = true
end

function M.showResults(data)
	if not player then return end
	if resultsShown then return end
	buildResults(data)
	-- stop camera, restore
	stopCamera()
	if CameraRig then
		pcall(function() CameraRig.slowmo(1, 0) end)
	end
	pcall(function()
		Lighting.TimeScale = 1
	end)
	-- restore sky
	if skyTween then
		skyTween:Disconnect()
		skyTween = nil
	end
	pcall(function()
		Lighting.ClockTime = clockBase
	end)
	-- stop ambient petals
	if petalFx and petalFx.stop then
		pcall(function() petalFx:stop() end)
		petalFx = nil
	end
	-- show HUD
	if hudGui then hudGui.Enabled = true end
	hudVisible = true
end

function M.hideResults()
	if resultsRoot then
		resultsRoot:Destroy()
		resultsRoot = nil
	end
	-- also destroy the results card if it exists
	if hudGui then
		local card = hudGui:FindFirstChild("ResultsCard")
		if card then card:Destroy() end
		local backdrop = hudGui:FindFirstChild("Backdrop")
		if backdrop then backdrop:Destroy() end
	end
	resultsShown = false
end

-- ---------------------------------------------------------------------------
-- Grand Bloom cinematic (6s signature moment)
-- ---------------------------------------------------------------------------
local function findBloomBed()
	local tagged = CollectionService:GetAllParts("KitBloomBed")
	if tagged and #tagged > 0 then
		return tagged[#tagged]
	end
	-- fallback: find a part in workspace with "BloomBed" in name
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name:find("BloomBed", 1, true) then
			return obj
		end
	end
	return nil
end

local function getBloomPosition()
	if bloomPos then return bloomPos end
	local bed = findBloomBed()
	if bed then
		bloomPos = bed.Position
		return bloomPos
	end
	-- fallback: hub position from Config
	if Config and Config.hub then
		bloomPos = Vector3.new(Config.hub.X, Config.hub.Y + 2, Config.hub.Z)
		return bloomPos
	end
	-- default: near spawn
	return Vector3.new(0, 10, 0)
end

local function flashStarsInSequence()
	for i = 1, 2 do
		task.delay(i * 0.8, function()
			local slot = starSlots[i]
			if not slot then return end
			local t0 = tick()
			local dur = 0.6
			local conn
			conn = RunService.RenderStepped:Connect(function()
				local t = (tick() - t0) / dur
				if t >= 1 then
					if conn then conn:Disconnect() end
					return
				end
				local pulse = math.sin(t * math.pi)
				slot.glow.Visible = true
				slot.glow.BackgroundTransparency = 0.9 - 0.7 * pulse
				slot.star.TextColor3 = Color3:lerp(Color3.new(0.55, 0.53, 0.6), STAR_GOLD, pulse)
			end)
			give(conn)
		end)
	end
end

local function brightenSky()
	if not Lighting then return end
	clockBase = Lighting.ClockTime
	local target = 12.0 -- noon
	local t0 = tick()
	local dur = 2.0
	skyTween = RunService.RenderStepped:Connect(function()
		local t = math.clamp((tick() - t0) / dur, 0, 1)
		local ease = t * t * (3 - 2 * t) -- smoothstep
		Lighting.ClockTime = clockBase + (target - clockBase) * ease
		if t >= 1 then
			skyTween:Disconnect()
			skyTween = nil
		end
	end)
	give(skyTween)
end

local function grandBloom(pos)
	if cinematic then return end
	cinematic = true
	bloomPos = pos

	-- hide HUD during cinematic
	if hudGui then hudGui.Enabled = false end

	-- slow time to 0.3x
	pcall(function() CameraRig.slowmo(0.3, 6.0) end)
	pcall(function() Lighting.TimeScale = 0.3 end)

	-- start ambient petals if not already
	if FX and not petalFx then
		pcall(function()
			petalFx = FX.weather("falling_petals", { area = 80 })
		end)
	end

	-- play the grand_bloom VFX at the bloom bed
	if VFX then
		pcall(function()
			VFX.play("grand_bloom", pos, { scale = 1.5, intensity = 1.5 })
		end)
	end

	-- chime cascade
	play("chime_cascade")
	task.delay(0.5, function() play("chime") end)
	task.delay(1.0, function() play("chime") end)

	-- fanfare swell (duck the music)
	if Sound then
		pcall(function() Sound.duck(0.5, 4.0) end)
	end
	task.delay(1.5, function()
		play("fanfare")
	end)

	-- shockwave
	task.delay(2.0, function()
		play("shockwave")
		if VFX then
			pcall(function()
				VFX.screenFlash(Color3.new(1, 1, 1), 0.15, 0.3)
			end)
		end
	end)

	-- flash stars in sequence
	flashStarsInSequence()

	-- brighten sky
	brightenSky()

	-- camera: fixed low-angle orbit around the bloom bed
	local bed = findBloomBed()
	local target = pos
	if bed then
		target = bed.Position + Vector3.new(0, 2, 0)
	end

	local ok, handle = pcall(function()
		return CameraRig.shot({
			orbit = {
				target = target,
				radius = { 14, 13 },
				height = { 3, 2.5 },
				from = -30,
				to = 330,
			},
			duration = 6.0,
			hold = 0.5,
			ease = "Sine InOut",
			fov = 60,
			blendIn = 0.5,
			blendOut = 0.8,
			letterbox = { ratio = 2.39 },
			slowmo = { scale = 0.3, seconds = 5.0, rampIn = 0.3, rampOut = 0.5 },
			onStart = function()
				cinematic = true
			end,
		})
	end)

	if ok and handle then
		handle:andThen(function()
			cinematic = false
			-- restore time
			pcall(function() CameraRig.slowmo(1, 0) end)
			pcall(function() Lighting.TimeScale = 1 end)
			-- show HUD
			if hudGui then hudGui.Enabled = true end
			hudVisible = true
			-- restart follow camera
			startCamera()
			-- stop petals
			if petalFx and petalFx.stop then
				pcall(function() petalFx:stop() end)
				petalFx = nil
			end
		end)
	end
end

-- ---------------------------------------------------------------------------
-- Remote wiring
-- ---------------------------------------------------------------------------
local function wireRemotes()
	if not RunEvents then return end

	-- SeedDeposited: mini-bloom or grand bloom
	local ok1, seedConn = pcall(function()
		return RunEvents.on("SeedDeposited", function(p, which, pos)
			if p ~= player then return end
			M.setSeed(which, true)
			-- play star burst VFX
			if VFX and FX then
				pcall(function()
					FX.play("star_burst", pos, { scale = 1.2 })
				end)
			end
			play("chime")
			-- if which == 2, this is the grand bloom
			if which == 2 then
				grandBloom(pos)
			else
				-- mini-bloom: small VFX + camera beat
				if VFX then
					pcall(function()
						VFX.play("grand_bloom", pos, { scale = 0.5, intensity = 0.5 })
					end)
				end
				if CameraRig then
					pcall(function() CameraRig.kick(5, 0.3) end)
				end
			end
		end)
	end)
	if ok1 then give(seedConn) end

	-- CoinCollected
	local ok2, coinConn = pcall(function()
		return RunEvents.on("CoinCollected", function(p, pos, comboCount)
			if p ~= player then return end
			M.setCoins(lastCoin + 1)
			-- coin pop VFX
			if FX then
				pcall(function()
					FX.play("coin_collect", pos, { scale = 1 })
				end)
			end
		end)
	end)
	if ok2 then give(coinConn) end

	-- RunComplete
	local ok3, completeConn = pcall(function()
		return RunEvents.on("RunComplete", function(p, time, coins, grade)
			if p ~= player then return end
			M.showResults({ time = time, coins = coins, grade = grade })
		end)
	end)
	if ok3 then give(completeConn) end

	-- RunReset
	local ok4, resetConn = pcall(function()
		return RunEvents.on("RunReset", function(p)
			if p ~= player then return end
			M.hideResults()
			if coinNum then coinNum.Text = "0" end
			lastCoin = 0
			combo = 0
			for i = 1, 2 do
				M.setSeed(i, false)
			end
			if timerNum then timerNum.Text = "0:00.0" end
			-- reset camera
			stopCamera()
			startCamera()
			-- restore time
			pcall(function() Lighting.TimeScale = 1 end)
			if CameraRig then
				pcall(function() CameraRig.slowmo(1, 0) end)
			end
			-- restore sky
			if skyTween then
				skyTween:Disconnect()
				skyTween = nil
			end
			pcall(function() Lighting.ClockTime = clockBase end)
		end)
	end)
	if ok4 then give(resetConn) end

	-- GrandBloomStart
	local ok5, bloomConn = pcall(function()
		return RunEvents.on("GrandBloomStart", function(p, pos)
			if p ~= player then return end
			grandBloom(pos)
		end)
	end)
	if ok5 then give(bloomConn) end
end

-- ---------------------------------------------------------------------------
-- Ambient effects
-- ---------------------------------------------------------------------------
local function startAmbient()
	if not FX then return end
	-- falling petals on the hub
	pcall(function()
		petalFx = FX.weather("falling_petals", { area = 60 })
	end)
	-- dust motes for atmosphere
	pcall(function()
		ambient.motes = FX.weather("dust_motes", { area = 40 })
	end)
end

-- ---------------------------------------------------------------------------
-- Timer (stopwatch)
-- ---------------------------------------------------------------------------
local function startTimer()
	runStartTime = tick()
	if not timerNum then return end
	if timerConn then timerConn:Disconnect() end
	timerConn = RunService.RenderStepped:Connect(function()
		if not runStartTime then return end
		local elapsed = tick() - runStartTime
		local m = math.floor(elapsed / 60)
		local s = math.floor(elapsed % 60)
		local cs = math.floor((elapsed % 1) * 10)
		timerNum.Text = string.format("%d:%02d.%d", m, s, cs)
	end)
	give(timerConn)
end

-- ---------------------------------------------------------------------------
-- Init
-- ---------------------------------------------------------------------------
function M.init()
	player = Players.LocalPlayer
	if not player then
		warn("[Hud] no LocalPlayer")
		return
	end

	-- register sounds
	registerSounds()

	-- UIKit toon theme (used for the results screen + UI sounds)
	if UI and UI.theme then
		pcall(function()
			UI.theme("toon")
			UI.onSound = function(name)
				if Sound then pcall(function() Sound.play(name, {}) end) end
			end
		end)
	end

	-- build VFX presets
	buildPresets()

	-- build HUD
	buildHud()

	-- wire remotes
	wireRemotes()

	-- character tracking
	local function onCharacter(model)
		onChar(model)
		startCamera()
		startTimer()
		-- start ambient after a short delay
		task.delay(1.0, function()
			startAmbient()
		end)
		-- first hint
		task.delay(firstHintAt, function()
			if not hintShown then
				hintShown = true
				M.setHint("Space - Jump, press again in air!")
			end
		end)
	end

	if player.Character then
		onCharacter(player.Character)
	else
		local conn = player.CharacterAdded:Connect(onCharacter)
		give(conn)
	end

	-- start afternoon music
	task.delay(2.0, function()
		if Sound then
			pcall(function() Sound.music("afternoon", 2.0) end)
		end
	end)

	-- Debug command
	local Debug = req("Kit.Debug")
	if Debug and Debug.register then
		pcall(function()
			Debug.register("showHud", function()
				M.toggle()
			end, "Toggle HUD visibility")
			Debug.register("triggerGrandBloom", function()
				local pos = getBloomPosition()
				grandBloom(pos)
			end, "Trigger the Grand Bloom cinematic")
			Debug.register("showResults", function()
				M.showResults({ time = 42.5, coins = 128, grade = "A" })
			end, "Show the results screen")
		end)
	end
end

return M
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPack" referent="60">
    <Properties>
      <string name="Name">StarterPack</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="61">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterCharacterScripts" referent="62">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
    </Item>
    <Item class="StarterPlayerScripts" referent="63">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="64">
        <Properties>
          <string name="Name">KitBoot</string>
          <string name="Source"><![CDATA[-- Generated by cybus-harness: connects this client to the Studio-only debug relay, and starts the client half of
-- the kits that need one (GameplayKit: collectible animation, knockback, carry keys; FXKit: server-sent effects).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Kit = ReplicatedStorage:WaitForChild("Kit")
require(Kit:WaitForChild("Debug")).initClient()
for _, name in ipairs({"GameplayKit", "FXKit"}) do
	local m = Kit:FindFirstChild(name)
	if m then
		task.spawn(function()
			local ok, mod = pcall(require, m)
			if ok and type(mod) == "table" and type(mod.startClient) == "function" then
				pcall(mod.startClient)
			end
		end)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="65">
        <Properties>
          <string name="Name">Player</string>
          <string name="Source"><![CDATA[-- Player.client: client entry script.
-- Builds the CK.platformer controller with the exact verb set from Config,
-- wires every verb event to its VFX/sound/camera beat, and subscribes to
-- RunEvents to drive the HUD and bloom VFX. Owns the local coin combo for
-- the arpeggio pitch.
--
-- Robustness: the controller is (re)built on every character with a retry
-- loop so a respawn never leaves the player standing still; the HUD is
-- initialised with a retry so a late-loaded Hud module still comes up.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Kit = ReplicatedStorage:WaitForChild("Kit", 10)
local CK = require(Kit:WaitForChild("ControllerKit", 10))
local FX = require(Kit:WaitForChild("FXKit", 10))
local Sound = require(Kit:WaitForChild("Sound", 10))
local CameraRig = require(Kit:WaitForChild("CameraRig", 10))
local VFX = require(Kit:WaitForChild("VFX", 10))
local Shake = require(Kit:WaitForChild("Shake", 10))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config", 10))
local RunEvents = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RunEvents", 10))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- HUD (owned by another item; lives in StarterGui). script.Parent is
-- StarterPlayerScripts, so walk up to StarterPlayer then over to StarterGui.
local Hud
do
	local ok, mod = pcall(function()
		local starterGui = game:GetService("StarterGui")
		return require(starterGui:WaitForChild("Hud", 10))
	end)
	if ok then
		Hud = mod
	end
end

-- ---------------------------------------------------------------- sounds

local function registerSounds()
	pcall(function()
		Sound.register("jump_whoosh", {
			ids = { "rbxassetid://114737980722682" },
			group = "SFX",
			volume = 0.4,
			pitch = 0.15,
		})
		Sound.register("double_jump", {
			ids = { "rbxassetid://110271067334499" },
			group = "SFX",
			volume = 0.45,
			pitch = 0.1,
		})
		Sound.register("land_thud", {
			ids = { "rbxassetid://96069171001073" },
			group = "SFX",
			volume = 0.5,
			pitch = 0.1,
		})
		Sound.register("coin_pop", {
			ids = { "rbxassetid://75021469134609" },
			group = "SFX",
			volume = 0.45,
			pitch = 0.3,
		})
		Sound.register("seed_chime", {
			ids = { "rbxassetid://106443875576213" },
			group = "SFX",
			volume = 0.6,
		})
		Sound.register("bloom_burst", {
			ids = { "rbxassetid://135385970610304" },
			group = "SFX",
			volume = 0.55,
		})
		Sound.register("grand_fanfare", {
			ids = { "rbxassetid://3454671965" },
			group = "SFX",
			volume = 0.7,
		})
		Sound.register("ground_pound", {
			ids = { "rbxassetid://138106864622900" },
			group = "SFX",
			volume = 0.6,
		})
		Sound.register("ui_click", {
			ids = { "rbxassetid://18378595145" },
			group = "UI",
			volume = 0.35,
		})
	end)
end

registerSounds()
pcall(function()
	FX.setStyle("toon")
end)

-- ---------------------------------------------------------------- helpers

local function charRoot()
	local char = player.Character
	if not char then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart")
end

local function charPos()
	local root = charRoot()
	return root and root.Position or camera.CFrame.Position
end

-- Shake helper (shared client camera shaker)
local function shakeKick(amount)
	pcall(function()
		Shake.kick(math.clamp(amount, 0, 1))
	end)
end

-- 360-degree spin on the character (client-side flourish for the double jump)
local function spin360(root, duration)
	if not root then
		return
	end
	local start = root.CFrame
	local t = 0
	local thread = task.spawn(function()
		while t < duration do
			t = t + RunService.DeltaTime
			local f = math.min(1, t / duration)
			local angle = math.rad(360 * f)
			root.CFrame = start * CFrame.Angles(0, angle, 0)
			task.wait()
		end
		if root and root.Parent then
			root.CFrame = start
		end
	end)
	task.delay(duration, function()
		task.cancel(thread)
	end)
end

-- Arpeggio pitch from the server's authoritative combo (CoinCollected
-- carries it). Rising-pitch: +1 semitone per coin in the chain, capped.
local function comboPitch(combo)
	local step = math.min(combo or 1, Config.comboMaxPitch)
	return 1 + step * 0.06
end

-- ---------------------------------------------------------------- HUD sync

local function syncHud()
	if not Hud or not Hud.init then
		return
	end
	local coins = player:GetAttribute("RunCoins") or 0
	local s1 = player:GetAttribute("RunSeed1") or false
	local s2 = player:GetAttribute("RunSeed2") or false
	pcall(Hud.setCoins, coins)
	pcall(Hud.setSeed, 1, s1)
	pcall(Hud.setSeed, 2, s2)
end

-- Initialise the HUD once, with a retry (the module may load late).
local hudReady = false
local function ensureHud()
	if hudReady or not Hud or not Hud.init then
		return
	end
	local ok = pcall(Hud.init)
	if ok then
		hudReady = true
		syncHud()
	end
end

-- ---------------------------------------------------------------- bloom VFX

local bloomHandles = {}

local function stopBlooms()
	for _, h in bloomHandles do
		pcall(function()
			h:stop()
		end)
	end
	table.clear(bloomHandles)
end

local function playMiniBloom(pos)
	stopBlooms()
	pcall(Sound.play, "bloom_burst")
	local h1 = FX.play("confetti_burst", pos, { scale = 1.4, color = "#FFA6C9" })
	local h2 = FX.play("star_burst", pos, { scale = 1.2, color = "#FFE066" })
	local h3 = FX.play("sparkles", pos, { area = 14, duration = Config.miniBloom_duration })
	table.insert(bloomHandles, h1)
	table.insert(bloomHandles, h2)
	table.insert(bloomHandles, h3)
	task.delay(Config.miniBloom_duration, stopBlooms)
end

local function playGrandBloom(pos)
	stopBlooms()
	-- Time slows to 0.3x for the whole cinematic (VFX + camera only; the
	-- server slows hazards via its own worldTimeScale).
	pcall(CameraRig.slowmo, Config.grandBloom_scale, Config.grandBloom_duration)

	-- Fixed low-angle orbit around the last flower bed.
	local target = CFrame.new(pos + Vector3.new(0, 4, 0))
	local shot
	local okShot, errShot = pcall(function()
		return CameraRig.shot({
			from = camera.CFrame,
			orbit = {
				target = target,
				radius = 26,
				height = 6,
				from = 0,
				to = 360,
			},
			duration = Config.grandBloom_duration,
			hold = 0.5,
			ease = "Sine InOut",
			fov = 42,
			letterbox = true,
			blendIn = 0.4,
			blendOut = 0.6,
		})
	end)
	if okShot then
		shot = errShot
	end

	-- 3-stage petal unfurl: staggered bursts up the bed.
	local stages = 3
	for i = 1, stages do
		task.delay(i * 0.8, function()
			local at = pos + Vector3.new(0, i * 2.5, 0)
			local h = FX.play("confetti_burst", at, { scale = 1 + i * 0.3, color = "#FFA6C9" })
			table.insert(bloomHandles, h)
			pcall(Sound.play, "seed_chime")
		end)
	end

	-- Light pillar + confetti at the end of the unfurl.
	task.delay(2.4, function()
		pcall(VFX.flashLight, pos + Vector3.new(0, 8, 0), "#FFE066", 3, 60, 2.5)
		local h = FX.play("firework", pos + Vector3.new(0, 10, 0), { scale = 1.5 })
		table.insert(bloomHandles, h)
		pcall(VFX.screenFlash, "#FFE066", 1.2, 0.5)
	end)

	-- Chime cascade -> fanfare swell.
	pcall(Sound.play, "seed_chime")
	task.delay(2.6, function()
		pcall(Sound.play, "grand_fanfare")
		pcall(Sound.duck, 0.4, 3)
	end)

	-- HUD stars flash in sequence.
	if Hud and Hud.setSeed then
		for i = 1, 2 do
			task.delay(0.3 * i, function()
				pcall(Hud.setSeed, i, true)
			end)
		end
	end

	if shot and shot.andThen then
		shot:andThen(function()
			task.delay(0.4, function()
				stopBlooms()
			end)
		end)
	end
end

-- ---------------------------------------------------------------- remote wiring

RunEvents.on("CoinCollected", function(plr, pos, combo)
	if plr ~= player then
		return
	end
	local pitch = comboPitch(combo)
	-- Rising-pitch arpeggio: the server's authoritative combo sets the step.
	local snd = Sound.play("coin_pop")
	if snd then
		pcall(function()
			snd.Pitch = pitch
		end)
	end
	FX.play("coin_collect", pos, { scale = 1 + math.min(combo, 8) * 0.05 })
	if Hud and Hud.setCoins then
		local coins = player:GetAttribute("RunCoins") or 0
		pcall(Hud.setCoins, coins)
	end
end)

RunEvents.on("SeedDeposited", function(plr, which, pos)
	if plr ~= player then
		return
	end
	pcall(Sound.play, "seed_chime")
	if Hud and Hud.setSeed then
		pcall(Hud.setSeed, which, true)
	end
	-- Star slot punch
	if Hud and Hud.punch then
		pcall(Hud.punch)
	end
end)

RunEvents.on("MiniBloom", function(plr, pos)
	if plr ~= player then
		return
	end
	playMiniBloom(pos)
end)

RunEvents.on("GrandBloomStart", function(plr, pos)
	if plr ~= player then
		return
	end
	playGrandBloom(pos)
end)

RunEvents.on("RunComplete", function(plr, time, coins, grade)
	if plr ~= player then
		return
	end
	if Hud and Hud.showResults then
		pcall(Hud.showResults, { time = time, coins = coins, grade = grade })
	end
end)

RunEvents.on("RunReset", function(plr)
	if plr ~= player then
		return
	end
	stopBlooms()
	if Hud and Hud.hideResults then
		pcall(Hud.hideResults)
	end
	syncHud()
	-- Snap the camera back to the hub follow.
end)

RunEvents.on("StateChanged", function(plr, state)
	if plr ~= player then
		return
	end
	if state == "Running" then
		syncHud()
	end
end)

-- ---------------------------------------------------------------- controller

local activeCtl = nil

local function buildController()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end

	local ok, ctl = pcall(function()
		return CK.platformer(player, {
			runSpeed = Config.runSpeed,
			jumpHeight = Config.jumpHeight,
			doubleJump = { height = Config.doubleJumpHeight },
			longJump = { speed = Config.longJumpSpeed },
			dive = { speed = Config.diveSpeed },
			groundPound = { hang = Config.groundPoundHang },
			wallKick = false,
			camera = {
				preset = "shoulder",
				distance = 14,
				fov = 55,
				speedFov = { from = 20, to = 40, fov = 8, pull = 6 },
				collision = true,
			},
		})
	end)
	if not ok then
		warn("[Player.client] platformer failed: " .. tostring(ctl))
		return nil
	end

	-- ---- verb beats ----

	ctl.Jumped:Connect(function(kind)
		local pos = charPos()
		local normal = Vector3.new(0, 1, 0)
		if kind == "jump" then
			FX.play("jump_puff", pos, { normal = normal })
			pcall(Sound.play, "jump_whoosh")
			-- squash: a small camera punch reads as the body compressing
			shakeKick(0.12)
		elseif kind == "long" then
			-- long jump: speed lines + streak
			local dir = root.CFrame.LookVector
			FX.play("dash_streak", pos, { direction = dir })
			pcall(FX.speedLines, 0.6)
			pcall(CameraRig.kick, 10, 0.2)
		end
	end)

	ctl.DoubleJumped:Connect(function(n)
		local pos = charPos()
		FX.play("double_jump_ring", pos)
		pcall(Sound.play, "double_jump")
		-- 360 spin
		spin360(root, 0.35)
		-- camera pop
		pcall(CameraRig.kick, 6, 0.15)
	end)

	ctl.Landed:Connect(function(impact)
		local pos = charPos()
		local impactFrac = math.clamp(impact / Config.maxFall, 0, 1)
		FX.play("land_dust", pos, { impact = impactFrac })
		pcall(Sound.play, "land_thud")
		if impactFrac > 0.6 then
			shakeKick(impactFrac * 0.5)
		end
	end)

	ctl.Dashed:Connect(function(kind)
		if kind == "dive" then
			local pos = charPos()
			local dir = root.CFrame.LookVector
			FX.play("dash_streak", pos, { direction = dir })
			-- FOV kick 70 -> 80
			pcall(CameraRig.kick, 12, 0.25)
			pcall(FX.speedLines, 0.8)
		end
	end)

	ctl.GroundPound:Connect(function(pos)
		-- shockwave ring + shake + rebound
		local normal = Vector3.new(0, 1, 0)
		FX.play("impact_concrete", pos, { normal = normal })
		FX.play("double_jump_ring", pos, { scale = 2.2 })
		pcall(Sound.play, "ground_pound")
		shakeKick(0.8)
		-- rebound: small upward impulse feel via camera punch
		pcall(CameraRig.punch, Vector3.new(0, 1, 0), Config.groundPoundShake)
	end)

	activeCtl = ctl
	return ctl
end

-- Build (or rebuild) the controller for the current character, retrying a
-- few times so a respawn never leaves the player standing still.
local function onCharacterAdded(char)
	task.spawn(function()
		for attempt = 1, 8 do
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then
				local ctl = buildController()
				if ctl then
					return
				end
			end
			task.wait(0.25)
		end
		warn("[Player.client] could not build controller after retries")
	end)
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
	task.spawn(onCharacterAdded, player.Character)
end

-- Initial HUD sync + retry (module may load late).
task.spawn(function()
	for _ = 1, 20 do
		ensureHud()
		if hudReady then
			break
		end
		task.wait(0.5)
	end
end)

print("[Player.client] ready")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
