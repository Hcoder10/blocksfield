	-- combo chip above the counter
	local comboWrap, comboBody = stickerCard(hudGui, "ComboChip")
	comboWrap.Size = UDim2.new(0, 110, 0, 44)
	comboWrap.Position = UDim2.new(0, 232, 0, 24)
