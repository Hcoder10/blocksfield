  <Item class="ServerScriptService" referent="48">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="49">
      <Properties>
        <string name="Name">KitBoot</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Generated by cybus-harness: starts the Studio-only debug relay.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
require(ReplicatedStorage:WaitForChild("Kit"):WaitForChild("Debug")).initServer()
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="50">
      <Properties>
        <string name="Name">RunBoot</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- RunBoot: the single server entry script for the run loop.
-- Requires RunState, wires World handles + RunEvents remotes, PlayerAdded,
-- and registers debug commands (startRun, grantSeed, triggerGrandBloom,
-- resetRun, runState, playLoop).
--
-- Robustness contract: this script MUST survive a missing or still-building
-- world. Debug commands are registered first, then the world is built inside
-- a pcall and retried in the background. Nothing here may throw at top level.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Kit = ReplicatedStorage:WaitForChild("Kit", 10)
local Debug = require(Kit:WaitForChild("Debug", 10))
local RunEvents = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RunEvents", 10))
local RunState = require(script.Parent:WaitForChild("RunState", 10))

local function firstPlayer()
	local p = Players:GetPlayers()
	return p[1]
end

-- ---------------------------------------------------------------- world
-- Build handles best-effort. World.build is idempotent (finds or builds), but
-- if the Studio world is not present yet it may fail -- that must not kill
-- this script. We retry in the background so a late world still wires up.

local handles
do
	local ok, h = pcall(function()
		local world = script.Parent:FindFirstChild("World")
		if not world then
			world = script.Parent:WaitForChild("World", 3)
		end
		return require(world).build()
	end)
	if ok and h then
		handles = h
	else
		warn("[RunBoot] world build failed at boot, will retry: " .. tostring(h))
	end
end

-- Init RunState with whatever we have (it never throws).
RunState.init(handles, RunEvents)

-- Background retry: if the world appears later, rebuild handles and re-wire
-- seed zones / checkpoints so the loop works even if the world was late.
task.spawn(function()
	for attempt = 1, 30 do
		task.wait(2)
		local ok, h = pcall(function()
			local world = script.Parent:FindFirstChild("World")
			if not world then
				world = script.Parent:WaitForChild("World", 1)
			end
			return require(world).build()
		end)
		if ok and h then
			RunState.init(h, RunEvents) -- idempotent; re-wires zones
			print("[RunBoot] world handles ready (attempt " .. attempt .. ")")
			break
		end
	end
end)

-- ---------------------------------------------------------------- players
-- Wire every player already in the server (Studio play-solo joins fast).
for _, player in ipairs(Players:GetPlayers()) do
	pcall(RunState.onPlayerAdded, player)
end
Players.PlayerAdded:Connect(function(player)
	pcall(RunState.onPlayerAdded, player)
end)

-- ---------------------------------------------------------------- remotes
-- ResetRun is a RemoteFunction handled inside RunState (returns bool).
-- All other remotes are server->client, fired by RunState.

-- ---------------------------------------------------------------- debug
-- Registered LAST in the old version -- and never reached when the world
-- build threw. They are registered now, before anything else that can fail.

Debug.register("startRun", function()
	local p = firstPlayer()
	if not p then
		return "no player"
	end
	return RunState.startRun(p) and "run started" or "already running"
end, "Start a fresh run (timer + coins + seeds) for the first player")

Debug.register("grantSeed", function(which)
	local p = firstPlayer()
	if not p then
		return "no player"
	end
	local n = tonumber(which) or 1
	if RunState.grantSeed(p, n) then
		return ("seed %d granted (teleported on top)"):format(n)
	end
	return "could not grant seed"
end, "Teleport the player onto Star Seed 1 or 2 to fire the deposit")

Debug.register("triggerGrandBloom", function()
	local p = firstPlayer()
	if not p then
		return "no player"
	end
	if RunState.triggerGrandBloom(p) then
		return "grand bloom firing"
	end
	return "run not active"
end, "Fire the Grand Bloom cinematic + results for the first player")

Debug.register("resetRun", function()
	local p = firstPlayer()
	if not p then
		return "no player"
	end
	local t0 = os.clock()
	local ok = RunState.reset(p)
	return ("reset %s in %.0f ms"):format(ok and "ok" or "failed", (os.clock() - t0) * 1000)
end, "Server-authoritative run reset (<1s): coins, seeds, timer, blooms")

Debug.register("runState", function()
	local p = firstPlayer()
	if not p then
		return "no player"
	end
	local g = RunState.grade(p)
	return ("state=%s time=%.1fs coins=%d grade=%s"):format(
		RunState.state(p), g.time, g.coins, g.grade
	)
end, "Show the first player's run state, time, coins and grade")

-- Full loop for the playtest: start the run, teleport the player onto Seed 1
-- (validated deposit + mini-bloom), then onto Seed 2 (Grand Bloom + results),
-- then reset. This drives READ->CHAIN->COLLECT->DEPOSIT->RETURN end to end.
Debug.register("playLoop", function()
	local p = firstPlayer()
	if not p then
		return "no player"
	end
	local msgs = {}
	table.insert(msgs, RunState.startRun(p) and "run started" or "run already running")
	RunState.grantSeed(p, 1)
	table.insert(msgs, "seed 1 deposited (mini-bloom in 2s)")
	task.wait(2.5)
	RunState.grantSeed(p, 2)
	table.insert(msgs, "seed 2 deposited (grand bloom + results)")
	task.wait(7)
	table.insert(msgs, RunState.reset(p) and "run reset" or "reset failed")
	return table.concat(msgs, " | ")
end, "Drive the full loop: run -> Seed 1 -> mini-bloom -> Seed 2 -> Grand Bloom -> reset")

print("[RunBoot] run loop ready")
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="51">
      <Properties>
        <string name="Name">RunState</string>
        <string name="Source"><![CDATA[-- RunState: server-authoritative run state machine per player.
-- States: Idle -> Running -> Complete (reset returns to Running).
-- Owns: GK.Timer stopwatch, GK.Collectibles (30 coins, combo tracked server-side
-- for the arpeggio pitch), the 2 Star Seed deposit zones (touch = deposit,
-- server-validated), GK.Checkpoints from World handles, grade calc, best time
-- to DataStore, and the <1s server-authoritative reset behind ResetRun.
--
-- Robustness contract: init() NEVER throws. Every World/GK dependency is
-- pcalled and retried, so RunBoot always reaches its Debug.register calls
-- even if the world is still building.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local CollectionService = game:GetService("CollectionService")

local Kit = ReplicatedStorage:WaitForChild("Kit", 10)
local GK = require(Kit:WaitForChild("GameplayKit", 10))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config", 10))
local RunEvents = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RunEvents", 10))

-- World is optional at init time: find it without blocking, retry later.
local WorldMod
do
	local ok, w = pcall(function()
		local world = script.Parent:FindFirstChild("World")
		if not world then
			world = script.Parent:WaitForChild("World", 3)
		end
		return require(world)
	end)
	if ok then
		WorldMod = w
	end
end

local M = {}

local bestStore
do
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore("StarbloomPeaks")
	end)
	if ok then
		bestStore = s
	end
end

-- per-player state
local players = {} -- [Player] = state table
local initialized = false
local seedTouched = false -- seed touch zones wired once
local comboConn = nil

local EMPTY_HANDLES = {
	coins = {},
	checkpoints = {},
	hub = Vector3.zero,
	summit = Vector3.zero,
}

local function newState(player)
	return {
		state = "Idle",
		timer = nil,
		collectibles = nil,
		coinCount = 0,
		combo = 0,
		comboExpire = 0,
		seeds = { [1] = false, [2] = false },
		results = nil,
	}
end

local function setState(ps, player, state)
	if ps.state == state then
		return
	end
	ps.state = state
	player:SetAttribute("RunState", state)
	pcall(RunEvents.fire, "StateChanged", player, state)
end

-- ---------------------------------------------------------------- handles

local function buildHandles()
	if not WorldMod then
		return nil
	end
	local ok, handles = pcall(WorldMod.build)
	if ok and handles and type(handles) == "table" then
		return handles
	end
	return nil
end

local function getHandles()
	if M._handles then
		return M._handles
	end
	local h = buildHandles()
	if h then
		M._handles = h
		return h
	end
	return EMPTY_HANDLES
end

-- ---------------------------------------------------------------- seeds

local function seedPart(which)
	for _, inst in CollectionService:GetTagged("KitStarSeed") do
		local part = inst
		if inst:IsA("Model") then
			part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
		end
		if part and part:IsA("BasePart") and (part:GetAttribute("SeedIndex") or 0) == which then
			return part
		end
	end
	return nil
end

local function hubBedPos()
	local cps = CollectionService:GetTagged("KitCheckpoint")
	for _, inst in ipairs(cps) do
		local part = inst
		if inst:IsA("Model") then
			part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
		end
		if part and part:IsA("BasePart") and (part:GetAttribute("Index") or 0) == 1 then
			return part.Position + Vector3.new(0, 2, 6)
		end
	end
	local handles = getHandles()
	return (handles.hub or Vector3.zero) + Vector3.new(0, 2, 6)
end

local function saveBestTime(player, time)
	if not bestStore then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			local key = Config.bestTimeKey .. "_" .. player.UserId
			local best = bestStore:GetAsync(key)
			if not best or time < best then
				bestStore:UpdateAsync(key, function(old)
					return (old and old > time) and old or time
				end)
			end
		end)
		if not ok then
			warn(("[RunState] best time save failed: %s"):format(tostring(err)))
		end
	end)
end

-- ---------------------------------------------------------------- grade

function M.grade(player)
	local ps = players[player]
	local time = 0
	local coins = 0
	if ps then
		coins = ps.coinCount
		if ps.timer then
			local ok, t = pcall(function()
				return ps.timer.elapsed()
			end)
			if ok and t then
				time = t
			end
		end
	end
	local grade = "B"
	if time < Config.gradeS_time and coins >= Config.gradeS_coins then
		grade = "S"
	elseif time < Config.gradeA_time then
		grade = "A"
	end
	return { time = time, coins = coins, grade = grade }
end

-- ---------------------------------------------------------------- seed zones

local function wireSeedZones()
	if seedTouched then
		return
	end
	for which = 1, Config.seedCount do
		local part = seedPart(which)
		if not part then
			continue
		end
		part.Touched:Connect(function(hit)
			local char = hit:FindFirstAncestorOfClass("Model")
			if not char then
				return
			end
			local plr = Players:GetPlayerFromCharacter(char)
			if not plr then
				return
			end
			M.depositSeed(plr, part)
		end)
	end
	seedTouched = true
end

-- ---------------------------------------------------------------- init

-- Never throws. Safe to call once; later calls are no-ops.
function M.init(handles, remotes)
	if initialized then
		return
	end
	initialized = true
	RunEvents.create()
	if handles and type(handles) == "table" then
		M._handles = handles
	end

	-- Checkpoints from World handles (hub + base of peak)
	local cps = (M._handles and M._handles.checkpoints) or {}
	if #cps > 0 then
		local ok, cp = pcall(function()
			return GK.Checkpoints.new({
				parts = cps,
				fallY = -40,
				forwardOnly = true,
			})
		end)
		if ok then
			M._checkpoints = cp
		else
			warn("[RunState] Checkpoints failed: " .. tostring(cp))
		end
	end

	-- ResetRun remote (server-authoritative, <1s)
	pcall(RunEvents.on, "ResetRun", function(player)
		return M.reset(player)
	end)

	-- Seed deposit touch zones (server-validated)
	pcall(wireSeedZones)

	-- Combo expiry heartbeat: the server owns the chain so the arpeggio pitch
	-- resets fairly after the window, no matter what the client does.
	comboConn = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for plr, ps in players do
			if ps.state == "Running" and ps.combo > 0 and now > ps.comboExpire then
				ps.combo = 0
			end
		end
	end)

	print("[RunState] initialized")
end

-- ---------------------------------------------------------------- per player

function M.onPlayerAdded(player)
	local ps = newState(player)
	players[player] = ps

	local function makeCollectibles()
		local handles = getHandles()
		local coinParts = handles.coins or {}
		if #coinParts == 0 then
			return nil
		end
		local ok, collect = pcall(function()
			return GK.Collectibles.new({
				points = coinParts,
				value = Config.coinValue,
				stat = "Coins",
				magnet = 0,
				onCollect = function(plr, value, total, item)
					local p = players[plr]
					if not p or p.state ~= "Running" then
						return
					end
					p.coinCount = p.coinCount + value
					local now = os.clock()
					if now <= p.comboExpire then
						p.combo = p.combo + 1
					else
						p.combo = 1
					end
					p.comboExpire = now + Config.comboWindow
					plr:SetAttribute("RunCoins", p.coinCount)
					local pos = item and item.Position or Vector3.zero
					pcall(RunEvents.fire, "CoinCollected", plr, pos, p.combo)
				end,
			})
		end)
		if ok then
			return collect
		end
		warn("[RunState] Collectibles failed: " .. tostring(collect))
		return nil
	end

	local function startRun()
		if ps.state ~= "Idle" then
			return
		end
		-- Make sure collectibles exist (world may have finished building late).
		if not ps.collectibles then
			ps.collectibles = makeCollectibles()
		end
		local ok, timer = pcall(function()
			return GK.Timer.new({ duration = nil })
		end)
		if not ok then
			warn("[RunState] Timer failed: " .. tostring(timer))
			return
		end
		ps.timer = timer
		ps.coinCount = 0
		ps.combo = 0
		ps.seeds = { [1] = false, [2] = false }
		ps.results = nil
		timer:start()
		setState(ps, player, "Running")
		player:SetAttribute("RunCoins", 0)
		player:SetAttribute("RunSeed1", false)
		player:SetAttribute("RunSeed2", false)
		print(("[RunState] %s run started"):format(player.Name))
	end

	local function onCharacter()
		-- Small delay so the character is on the ground before the run starts.
		task.delay(0.4, startRun)
	end

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.defer(onCharacter)
	end

	player.PlayerRemoving:Connect(function()
		local p = players[player]
		if p and p.timer then
			pcall(function()
				p.timer:stop()
			end)
		end
		players[player] = nil
	end)
end

-- ---------------------------------------------------------------- deposit

function M.depositSeed(player, seedPart)
	local ps = players[player]
	if not ps or ps.state ~= "Running" then
		return false
	end
	local which = seedPart:GetAttribute("SeedIndex") or 0
	if which ~= 1 and which ~= 2 then
		return false
	end
	if ps.seeds[which] then
		return false -- already banked
	end
	ps.seeds[which] = true
	seedPart:SetAttribute("Deposited", true) -- idempotency guard for the touch zone
	player:SetAttribute("RunSeed" .. which, true)
	ps.combo = 0

	-- Hide the seed so it can't be re-deposited
	seedPart.CanTouch = false
	seedPart.Transparency = 1
	seedPart.CanCollide = false
	if seedPart:IsA("BasePart") then
		seedPart.Color = Color3.new(1, 1, 1)
		seedPart.MaterialTransparency = 1
	end

	local pos = seedPart.Position
	pcall(RunEvents.fire, "SeedDeposited", player, which, pos)

	if which == 2 then
		-- THE GRAND BLOOM: cinematic on the client, then results.
		if ps.timer then
			ps.timer:stop()
		end
		local results = M.grade(player)
		ps.results = results
		setState(ps, player, "Complete")
		saveBestTime(player, results.time)
		pcall(RunEvents.fire, "GrandBloomStart", player, hubBedPos())
		task.delay(Config.grandBloom_duration, function()
			pcall(RunEvents.fire, "RunComplete", player, results.time, results.coins, results.grade)
		end)
	else
		-- Seed 1: the hub flower bed does a visible mini-bloom 2s later,
		-- watchable from the moving-platform ride home.
		task.delay(Config.miniBloom_delay, function()
			pcall(RunEvents.fire, "MiniBloom", player, hubBedPos())
		end)
	end
	print(("[RunState] %s deposited Seed %d"):format(player.Name, which))
	return true
end

-- ---------------------------------------------------------------- reset

-- Server-authoritative reset: coins respawn, seeds reset, timer reset,
-- bloom state cleared. Must complete in <1s (no reload).
function M.reset(player)
	local ps = players[player]
	if not ps then
		return false
	end
	local started = os.clock()

	-- Stop the timer
	if ps.timer then
		pcall(function()
			ps.timer:stop()
		end)
		pcall(function()
			ps.timer:reset()
		end)
	end

	-- Respawn coins
	if ps.collectibles then
		pcall(function()
			ps.collectibles:reset()
		end)
	end

	-- Reset seeds (restore parts)
	ps.seeds = { [1] = false, [2] = false }
	for which = 1, Config.seedCount do
		local part = seedPart(which)
		if part then
			part.CanTouch = true
			part.Transparency = 0
			part.CanCollide = true
			part:SetAttribute("Deposited", false)
			if part:IsA("BasePart") then
				part.MaterialTransparency = 0
			end
		end
		player:SetAttribute("RunSeed" .. which, false)
	end

	-- Fresh stopwatch
	local ok, timer = pcall(function()
		return GK.Timer.new({ duration = nil })
	end)
	if ok then
		ps.timer = timer
		timer:start()
	end
	ps.coinCount = 0
	ps.combo = 0
	ps.results = nil
	player:SetAttribute("RunCoins", 0)

	-- Respawn the character at the last checkpoint (hub or base of peak)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if char and M._checkpoints then
		pcall(function()
			M._checkpoints:respawn(player)
		end)
	elseif char and not root then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = 0
		end
	end

	setState(ps, player, "Running")
	pcall(RunEvents.fire, "RunReset", player)
	print(("[RunState] %s reset in %.0f ms"):format(player.Name, (os.clock() - started) * 1000))
	return true
end

-- ---------------------------------------------------------------- debug helpers

function M.startRun(player)
	local ps = players[player]
	if not ps then
		return false
	end
	if ps.state ~= "Idle" then
		return false
	end
	if not ps.collectibles then
		ps.collectibles = (function()
			local handles = getHandles()
			local coinParts = handles.coins or {}
			if #coinParts == 0 then
				return nil
			end
			local ok, collect = pcall(function()
				return GK.Collectibles.new({
					points = coinParts,
					value = Config.coinValue,
					stat = "Coins",
					magnet = 0,
					onCollect = function(plr, value, total, item)
						local p = players[plr]
						if not p or p.state ~= "Running" then
							return
						end
						p.coinCount = p.coinCount + value
						local now = os.clock()
						if now <= p.comboExpire then
							p.combo = p.combo + 1
						else
							p.combo = 1
						end
						p.comboExpire = now + Config.comboWindow
						plr:SetAttribute("RunCoins", p.coinCount)
						local pos = item and item.Position or Vector3.zero
						pcall(RunEvents.fire, "CoinCollected", plr, pos, p.combo)
					end,
				})
			end)
			return ok and collect or nil
		end)()
	end
	local ok, timer = pcall(function()
		return GK.Timer.new({ duration = nil })
	end)
	if not ok then
		return false
	end
	ps.timer = timer
	ps.coinCount = 0
	ps.combo = 0
	ps.seeds = { [1] = false, [2] = false }
	ps.results = nil
	timer:start()
	setState(ps, player, "Running")
	return true
end

function M.grantSeed(player, which)
	local ps = players[player]
	if not ps or ps.state ~= "Running" then
		return false
	end
	local part = seedPart(which)
	if not part then
		return false
	end
	-- Teleport the player onto the seed so the touch zone fires the
	-- validated deposit path (same code as a real touch).
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
	end
	return true
end

function M.triggerGrandBloom(player)
	local ps = players[player]
	if not ps or ps.state ~= "Running" then
		return false
	end
	ps.seeds[2] = true
	if ps.timer then
		ps.timer:stop()
	end
	local results = M.grade(player)
	ps.results = results
	setState(ps, player, "Complete")
	saveBestTime(player, results.time)
	pcall(RunEvents.fire, "GrandBloomStart", player, hubBedPos())
	task.delay(Config.grandBloom_duration, function()
		pcall(RunEvents.fire, "RunComplete", player, results.time, results.coins, results.grade)
	end)
	return true
end

function M.state(player)
	local ps = players[player]
	return ps and ps.state or "Unknown"
end

return M
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="52">
      <Properties>
        <string name="Name">StudioRestore</string>
        <string name="Source"><![CDATA[-- Restores what rojo cannot carry from the Studio-built world (generated by blocksfield.export_place):
-- the terrain (a TerrainRegion; rojo cannot write voxels) and CollectionService tags (kept in a __Tags attribute).
-- Idempotent; required first thing by World.luau so gameplay lookups see the restored world.
local done = false
return function()
	if done then return end
	done = true
	local region = game:GetService("ServerStorage"):FindFirstChild("StudioTerrain")
	if region then
		workspace.Terrain:PasteRegion(region, Vector3int16.new(-32000, -32000, -32000), true)
	end
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(150, 240, 190)) end)
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(130, 230, 176)) end)
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(255, 172, 202)) end)
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.Mud, Color3.fromRGB(150, 92, 70)) end)
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(255, 230, 180)) end)
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.Snow, Color3.fromRGB(255, 255, 255)) end)
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(200, 156, 255)) end)
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.Sandstone, Color3.fromRGB(255, 190, 150)) end)
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.Ice, Color3.fromRGB(190, 240, 255)) end)
	pcall(function() workspace.Terrain:SetMaterialColor(Enum.Material.Glacier, Color3.fromRGB(170, 230, 255)) end)
	local CS = game:GetService("CollectionService")
	for _, root in ipairs({ workspace, game:GetService("Lighting") }) do
		for _, d in ipairs(root:GetDescendants()) do
			local t = d:GetAttribute("__Tags")
			if type(t) == "string" then
				for _, tag in ipairs(string.split(t, ",")) do CS:AddTag(d, tag) end
			end
		end
	end
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="53">
      <Properties>
        <string name="Name">World</string>
        <string name="Source"><![CDATA[pcall(function() require(game:GetService("ServerScriptService"):WaitForChild("StudioRestore", 10))() end)  -- operator: restore the exported Studio world first (OPERATOR_NOTES.md)
-- World handle finder + runtime motion starter.
-- Finds the Studio-built place by CollectionService tags (KitSpawn, KitCheckpoint, KitCoin,
-- KitGoal, KitMover, KitCrumble, KitHazard, KitStarSeed) and returns handles;
-- starts WorldKit2.animate() for movers/crumble and the moving return-ride platforms.
-- No geometry is built here.
--
-- API:
--   M.build() -> {spawn=Vector3, checkpoints={Part}, coins={Part}, seeds={Part},
--                 movers={Part}, hazards={Part}, hub=Vector3, summit=Vector3}
--   M.reset() (clears coin/seed respawn state)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = workspace

local M = {}

local TAGS = {
	Spawn = "KitSpawn",
	Checkpoint = "KitCheckpoint",
	Coin = "KitCoin",
	Goal = "KitGoal",
	Mover = "KitMover",
	Crumble = "KitCrumble",
	Hazard = "KitHazard",
	StarSeed = "KitStarSeed",
}

local _handles = nil
local _moversStarted = false

local function tagToParts(tag: string): {BasePart}
	local parts: {BasePart} = {}
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsA("BasePart") then
			table.insert(parts, inst)
		elseif inst:IsA("Model") then
			local pp = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
			if pp then
				table.insert(parts, pp)
			end
		end
	end
	table.sort(parts, function(a, b)
		return a:GetFullName() < b:GetFullName()
	end)
	return parts
end

local function findSpawn(): Vector3?
	local parts = tagToParts(TAGS.Spawn)
	if parts[1] then
		return parts[1].Position
	end
	-- Fallback: first checkpoint (hub)
	local cps = tagToParts(TAGS.Checkpoint)
	if cps[1] then
		return cps[1].Position
	end
	return nil
end

local function findHub(): Vector3?
	local cps = tagToParts(TAGS.Checkpoint)
	for _, p in ipairs(cps) do
		if p:GetAttribute("Index") == 1 then
			return p.Position
		end
	end
	if cps[1] then
		return cps[1].Position
	end
	return nil
end

local function findSummit(): Vector3?
	local seeds = tagToParts(TAGS.StarSeed)
	for _, p in ipairs(seeds) do
		if p:GetAttribute("SeedIndex") == 2 then
			return p.Position
		end
	end
	if seeds[#seeds] then
		return seeds[#seeds].Position
	end
	return nil
end

function M.build()
	if _handles then
		return _handles
	end

	local spawn = findSpawn()
	local hub = findHub()
	local summit = findSummit()

	local checkpoints = tagToParts(TAGS.Checkpoint)
	local coins = tagToParts(TAGS.Coin)
	local seeds = tagToParts(TAGS.StarSeed)
	local movers = tagToParts(TAGS.Mover)
	local hazards = tagToParts(TAGS.Hazard)
	local goals = tagToParts(TAGS.Goal)

	-- Sort checkpoints by Index attribute
	table.sort(checkpoints, function(a, b)
		local ia = a:GetAttribute("Index") or 0
		local ib = b:GetAttribute("Index") or 0
		return ia < ib
	end)

	-- Sort coins by Y then X for deterministic order
	table.sort(coins, function(a, b)
		if a.Position.Y ~= b.Position.Y then
			return a.Position.Y < b.Position.Y
		end
		return a.Position.X < b.Position.X
	end)

	-- Sort seeds by SeedIndex
	table.sort(seeds, function(a, b)
		local sa = a:GetAttribute("SeedIndex") or 0
		local sb = b:GetAttribute("SeedIndex") or 0
		return sa < sb
	end)

	-- Start WorldKit2.animate() for movers/crumble (server-side, once)
	if not _moversStarted then
		_moversStarted = true
		local ok, err = pcall(function()
			local W = require(ReplicatedStorage.Kit.WorldKit2)
			W.animate()
		end)
		if not ok then
			warn("[World] WorldKit2.animate() failed: " .. tostring(err))
		end
	end

	_handles = {
		spawn = spawn or Vector3.new(0, 70, 0),
		hub = hub or Vector3.new(0, 70, 0),
		summit = summit or Vector3.new(0, 140, 0),
		checkpoints = checkpoints,
		coins = coins,
		seeds = seeds,
		movers = movers,
		hazards = hazards,
		goals = goals,
	}

	print(("[World] build: spawn=%s hub=%s summit=%s | %d checkpoints, %d coins, %d seeds, %d movers, %d hazards, %d goals")
		:format(
			tostring(_handles.spawn),
			tostring(_handles.hub),
			tostring(_handles.summit),
			#checkpoints, #coins, #seeds, #movers, #hazards, #goals
		))

	return _handles
end

function M.reset()
	if not _handles then
		return
	end
	-- Clear coin/seed respawn state: re-enable all coins and seeds
	for _, coin in ipairs(_handles.coins) do
		coin.Transparency = 0
		coin.CanQuery = true
		coin.CanTouch = true
		coin:SetAttribute("Collected", false)
	end
	for _, seed in ipairs(_handles.seeds) do
		seed.Transparency = 0
		seed.CanQuery = true
		seed.CanTouch = true
		seed:SetAttribute("Deposited", false)
	end
end

return M
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="54">
      <Properties>
        <string name="Name">WorldBoot</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- WorldBoot: the single server entry script for the world item.
-- The geometry itself is Studio-built (LevelKit "sky_islands", candy look) and
-- saved in the place; this script only starts the runtime half:
--   * require the World handle finder
--   * World.build()  -> finds every Studio-built piece by CollectionService tag
--                       (KitStarSeed, KitCoin, KitCheckpoint, KitMover, KitGoal,
--                        KitHazard) and returns handles
--   * World.reset()  -> clears coin/seed respawn state before the first run
-- World.build() also starts WorldKit2.animate() so the KitMover return-ride
-- platforms move at runtime.
--
-- Fail-soft: the world is built in Studio, so a missing tag or a broken
-- module must never crash the server -- we log and continue.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local function log(msg: string)
	print("[WorldBoot] " .. msg)
end

-- Wait for the World module (it is a sibling ModuleScript, so this is local
-- and instant; the timeout guard is just belt-and-braces).
local worldModule = script.Parent:WaitForChild("World", 10)
if not worldModule or not worldModule:IsA("ModuleScript") then
	warn("[WorldBoot] World module not found at ServerScriptService.World; world runtime not started")
	return
end

local World
ok, err = pcall(function()
	World = require(worldModule)
end)
if not ok or type(World) ~= "table" then
	warn("[WorldBoot] require(World) failed: " .. tostring(err))
	return
end

-- Build must run after the world has replicated into the server's workspace
-- (it is Studio-built, so it is present at server start; the pcall + retry
-- keeps a slow first load from failing the whole boot).
local function tryBuild(attempt: number): boolean
	local ok2, handles = pcall(function()
		return World.build()
	end)
	if ok2 and type(handles) == "table" then
		log(string.format(
			"world handles: coins=%d seeds=%d checkpoints=%d movers=%d hazards=%d",
			#(handles.coins or {}),
			#(handles.seeds or {}),
			#(handles.checkpoints or {}),
			#(handles.movers or {}),
			#(handles.hazards or {})))
		return true
	end
	warn(string.format("[WorldBoot] World.build() attempt %d failed: %s", attempt, tostring(handles)))
	return false
end

if not tryBuild(1) then
	-- One retry on the next frame (covers a slow first replication).
	task.defer(function()
		task.wait(1)
		if not tryBuild(2) then
			warn("[WorldBoot] giving up on World.build(); gameplay will run without world handles")
		end
	end)
end

-- Clear any coin/seed respawn state from a previous run (idempotent).
pcall(function()
	World.reset()
	log("world reset state cleared")
end)

log("world runtime started")
]]></string>
      </Properties>
    </Item>
