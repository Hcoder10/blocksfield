        <Properties>
          <string name="Name">Anim</string>
          <string name="Source"><![CDATA[--!native
-- Anim: keyframe animation clips (authored as data with author_clip) on any Motor6D rig, plus procedural layers.
--   local Anim = require(ReplicatedStorage.Kit.Anim)
--   local rig = Anim.load(character)                     -- one player per rig (cached); R15, R6 or custom Motor6Ds
--   local track = rig:play("slash", { fade = 0.1 })      -- options: fade, speed, weight, priority, looped, hold, restart
--   track.Marker("hit"):Connect(function() Sound.play("hit") end)   -- sync sound / VFX to the contact frame
--   track.Ended:Connect(fn); track:stop(0.2); track:adjustSpeed(speed / 16); rig:stopAll(0.2)
--   rig:takeOver(true)     -- pause the rig's own AnimationTracks (the default Animate script) while clips play
--   rig:lean(1); rig:lookAt(target.Position); rig:breathe(true); rig:recoil("RightShoulder", { -30, 0, 0 }, 0.3)
-- Clips come from Anim.register(clip) or the generated ReplicatedStorage.Shared.ClipPack (loaded on first use).
-- Per joint, a higher priority (action > movement > idle > core) overrides lower ones; the same priority blends by
-- weight; fades are smooth. play() of a looped clip that is already playing returns that track (call it every
-- frame from a state machine if you like); play() of a one-shot restarts it, crossfading from the old one.
-- A one-shot holds its last pose while it fades out (fadeOut, default fade), or until stop() with hold = true.
--
-- With Roblox's Animator: Anim writes Motor6D.Transform in RunService.PreSimulation, which runs after the
-- Animator has posed the rig for the frame, and blends over that pose. Joints no clip poses keep the Animator's
-- animation (a clip keying only the arms plays over the default walk), and fades blend from and back to it.
-- takeOver(true) pauses the rig's own tracks instead (weight 0, speed 0) while clips play, and restores them after.
-- Motor6D.Transform does not replicate: play clips on every client that should see them (e.g. the server fires a
-- RemoteEvent with the clip name and each client plays it on that character). On the server it only moves the
-- server's copy of the rig (useful for hitboxes that follow a swing).
-- Bad data never errors: bad clips, unknown names and wrong arguments warn once and do nothing.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnimCore = require(script.Parent:WaitForChild("AnimCore"))
local Spring = require(script.Parent:WaitForChild("Spring"))

local euler, mul, slerp, fromMatrix = AnimCore.euler, AnimCore.mul, AnimCore.slerp, AnimCore.fromMatrix
local rotateVector = AnimCore.rotate
local abs, clamp, sqrt, atan2, deg = math.abs, math.clamp, math.sqrt, math.atan2, math.deg

local Anim = {}
Anim.Core = AnimCore

local warned = {}
local function warnOnce(key, message)
	if warned[key] then
		return
	end
	warned[key] = true
	warn("[Anim] " .. message)
end

local function finite(x)
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function num(x, default)
	x = tonumber(x)
	if finite(x) then
		return x
	end
	return default
end

-- Signal -------------------------------------------------------------------------------------------------
-- Handlers run deferred (after the animation step), so they may play / stop tracks freely and an error in one
-- does not stop the others.
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	local connection
	connection = {
		Connected = true,
		Disconnect = function()
			connection.Connected = false
			handlers[connection] = nil
		end,
	}
	handlers[connection] = fn
	return connection
end

function Signal:Once(fn)
	local connection
	connection = self:Connect(function(...)
		connection.Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:Fire(...)
	for _, fn in self._handlers do
		task.defer(fn, ...)
	end
end

-- Tracks -------------------------------------------------------------------------------------------------
-- A track is AnimCore's track state (time, speed, weight, looped, ...) with methods and signals:
--   track.name, track.length, track.looped, track.time, track.speed, track.weight, track.isPlaying
--   track:stop(fade), track:adjustSpeed(x), track:adjustWeight(w, fade), track:setTime(t)
--   track.Marker(name) -> signal (also track:Marker(name), track:GetMarkerReachedSignal(name))
--   track.MarkerReached (name), track.Stopped (starts fading out), track.Ended / track.ended (gone)
local Track = {}
Track.__index = Track

local function wrapTrack(core)
	local track = setmetatable(core, Track)
	track.Ended = Signal.new()
	track.Stopped = Signal.new()
	track.MarkerReached = Signal.new()
	track.ended = track.Ended
	track.stopped = track.Stopped
	local markers = {}
	track._markers = markers
	track.Marker = function(a, b)
		local name = tostring(if a == track then b else a)
		local signal = markers[name]
		if signal == nil then
			signal = Signal.new()
			markers[name] = signal
		end
		return signal
	end
	return track
end

function Track:GetMarkerReachedSignal(name)
	return self.Marker(name)
end

function Track:stop(fade)
	if AnimCore.stop(self, fade) then
		self.Stopped:Fire()
		local player = self._player
		if player then
			player:_wake()
		end
	end
end
Track.Stop = Track.stop

function Track:adjustSpeed(speed)
	speed = num(speed, nil)
	if speed ~= nil then
		self.speed = clamp(speed, -100, 100)
	end
end
Track.AdjustSpeed = Track.adjustSpeed

function Track:adjustWeight(weight, fade)
	AnimCore.setWeight(self, weight, fade)
end
Track.AdjustWeight = Track.adjustWeight

-- Jumps to time t (seconds) without firing the markers in between.
function Track:setTime(t)
	t = num(t, nil)
	if t == nil or self.state == "ended" then
		return
	end
	local length = self.clip.length
	if self.looped then
		t -= math.floor(t / length) * length
	else
		t = clamp(t, 0, length)
	end
	self.time = t
end

local function onTrackEvent(track, kind, name)
	if kind == "marker" then
		track.MarkerReached:Fire(name)
		local signal = track._markers[name]
		if signal then
			signal:Fire(name)
		end
	elseif kind == "stopped" then
		track.Stopped:Fire()
	elseif kind == "ended" then
		track.Ended:Fire()
	end
end

local NULL_CLIP = {
	_compiled = true, name = "", length = 1, looped = false, priority = 1, priorityName = "core",
	channels = {}, index = {}, joints = {}, count = 0, markers = {},
}

-- A track that is already over: returned when there is nothing to play, so calling code never errors.
local function nullTrack(name)
	local core = AnimCore.newTrack(NULL_CLIP)
	core.state = "ended"
	core.isPlaying = false
	core.w = 0
	core.name = name or ""
	return wrapTrack(core)
end

-- Clips --------------------------------------------------------------------------------------------------
local registry = {} -- name -> compiled clip
local compiledFor = setmetatable({}, { __mode = "k" }) -- clip table -> compiled clip, or false if it is bad
local pack = { loaded = false, tried = -math.huge }

local function labelOf(data)
	if type(data) == "table" and type(data.name) == "string" then
		return "'" .. data.name .. "'"
	end
	return "(unnamed)"
end

local function compile(data)
	local ok, clip, problems = pcall(AnimCore.compile, data)
	if not ok then
		warnOnce("bad:" .. labelOf(data), "clip " .. labelOf(data) .. " could not be read: " .. tostring(clip))
		return nil
	end
	if clip == nil then
		local shown = table.concat(problems, "; ", 1, math.min(#problems, 5))
		warnOnce("bad:" .. labelOf(data), "clip " .. labelOf(data) .. " rejected: " .. shown
			.. (if #problems > 5 then " ..." else ""))
		return nil
	end
	return clip
end

-- Validates and registers a clip table under its name. Returns the compiled clip, or nil (warned once).
function Anim.register(data)
	local clip = compile(data)
	if clip ~= nil then
		registry[clip.name] = clip
		if type(data) == "table" then
			compiledFor[data] = clip
		end
	end
	return clip
end

-- ReplicatedStorage.Shared.ClipPack: required on first need, looked up again at most once a second until it
-- exists (it may replicate after the first play). Clips registered from code win over the pack's.
local function loadPack()
	if pack.loaded then
		return
	end
	local now = os.clock()
	if now - pack.tried < 1 then
		return
	end
	pack.tried = now
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local module = shared and shared:FindFirstChild("ClipPack")
	if module == nil or not module:IsA("ModuleScript") then
		return
	end
	pack.loaded = true
	local ok, clips = pcall(require, module)
	if not ok or type(clips) ~= "table" then
		warnOnce("pack", "ReplicatedStorage.Shared.ClipPack failed to load: " .. tostring(clips))
		return
	end
	for name, data in clips do
		if type(data) == "table" and registry[name] == nil then
			if data.name == nil then
				data.name = name
			end
			Anim.register(data)
		end
	end
end

-- The compiled clip registered (or packed) under name, or nil.
function Anim.clip(name)
	local clip = registry[name]
	if clip == nil and type(name) == "string" then
		loadPack()
		clip = registry[name]
	end
	return clip
end

-- Names of every known clip (registered and packed), sorted.
function Anim.clips()
	loadPack()
	local names = {}
	for name in registry do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

local function resolve(clipOrName)
	if type(clipOrName) == "string" then
		local clip = Anim.clip(clipOrName)
		if clip == nil then
			warnOnce("missing:" .. clipOrName, "no clip named '" .. clipOrName
				.. "': author it with author_clip (ReplicatedStorage.Shared.ClipPack) or Anim.register it")
		end
		return clip
	elseif type(clipOrName) == "table" then
		if clipOrName._compiled == true then
			return clipOrName
		end
		local clip = compiledFor[clipOrName]
		if clip == nil then
			clip = compile(clipOrName) or false
			compiledFor[clipOrName] = clip
		end
		return clip or nil
	end
	warnOnce("arg:" .. typeof(clipOrName), "play() needs a clip name or a clip table, got " .. typeof(clipOrName))
	return nil
end

-- Math helpers -------------------------------------------------------------------------------------------
local IDENTITY = CFrame.identity

local function quatOf(cf)
	local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return fromMatrix(r00, r01, r02, r10, r11, r12, r20, r21, r22)
end

local function sameCFrame(a, b)
	if a == b then
		return true
	end
	local ax, ay, az, a00, a01, a02, a10, a11, a12, a20, a21, a22 = a:GetComponents()
	local bx, by, bz, b00, b01, b02, b10, b11, b12, b20, b21, b22 = b:GetComponents()
	return abs(ax - bx) + abs(ay - by) + abs(az - bz) < 1e-4
		and abs(a00 - b00) + abs(a01 - b01) + abs(a02 - b02) + abs(a10 - b10) + abs(a11 - b11) + abs(a12 - b12)
				+ abs(a20 - b20) + abs(a21 - b21) + abs(a22 - b22)
			< 1e-4
end

-- At rest at 0: within eps (degrees for the rotation springs, where 0.01 is invisible) and barely moving.
local function settled(spring, eps)
	eps = eps or 1e-3
	return spring.Target == 0 and abs(spring.Position) < eps and abs(spring.Velocity) < eps * 5
end
local DEG_EPS = 0.01

-- A rotation given as { rx, ry, rz }, { rx = .., ry = .., rz = .. } or a Vector3 (degrees) -> rx, ry, rz.
local function rotationOf(value)
	if typeof(value) == "Vector3" then
		return value.X, value.Y, value.Z
	elseif type(value) == "table" then
		return num(value[1] or value.rx, 0), num(value[2] or value.ry, 0), num(value[3] or value.rz, 0)
	end
	return nil
end

local function targetPosition(target)
	local kind = typeof(target)
	if kind == "Vector3" then
		return target
	elseif kind == "Instance" then
		if target:IsA("BasePart") then
			return target.Position
		elseif target:IsA("Attachment") then
			return target.WorldPosition
		elseif target:IsA("Model") then
			return target:GetPivot().Position
		end
	end
	return nil
end

-- Players ------------------------------------------------------------------------------------------------
local Player = {}
Player.__index = Player

local players = setmetatable({}, { __mode = "k" }) -- rig -> player
local active = {} -- players with work to do this frame
local stepConnection = nil
local nextId = 0

local function newPlayer(rig)
	nextId += 1
	local self = setmetatable({
		id = nextId,
		rig = rig,
		tracks = {},
		nTracks = 0,
		slots = 0,
		motors = {},
		names = {},
		slotOf = {},
		axis = {},
		last = {},
		maps = {},
		mixer = AnimCore.newMixer(0),
		dirty = true,
		active = false,
		destroyed = false,
		connections = {},
		-- procedural layers
		leanAmount = 0,
		leanRoll = Spring.new(0, 9, 0.9),
		leanPitch = Spring.new(0, 9, 0.9),
		prevYaw = nil,
		look = nil,
		lookNeckYaw = Spring.new(0, 12, 1),
		lookNeckPitch = Spring.new(0, 12, 1),
		lookWaistYaw = Spring.new(0, 10, 1),
		lookWaistPitch = Spring.new(0, 10, 1),
		breath = false,
		breathRate = 0.25,
		breathDepth = 1,
		breathPhase = 0,
		breathWeight = Spring.new(0, 3, 1),
		recoils = {},
		squashState = nil,
		addX = {},
		addY = {},
		addZ = {},
		addW = {},
		addOn = {},
		takeover = false,
		suppressed = nil,
		animatorConnection = nil,
	}, Player)
	self.lookSprings = { self.lookNeckYaw, self.lookNeckPitch, self.lookWaistYaw, self.lookWaistPitch }
	if rig ~= nil then
		local function changed(d)
			if d:IsA("Motor6D") then
				self.dirty = true
			end
		end
		table.insert(self.connections, rig.DescendantAdded:Connect(changed))
		table.insert(self.connections, rig.DescendantRemoving:Connect(changed))
		table.insert(self.connections, rig.Destroying:Connect(function()
			self:destroy()
		end))
	end
	return self
end

-- The player for a rig (a character or any Model whose joints are Motor6Ds; a Humanoid means its character).
-- Always returns a player; for something that is not a rig it does nothing (warned once).
function Anim.load(rig)
	if typeof(rig) == "Instance" and rig:IsA("Humanoid") then
		rig = rig.Parent
	end
	if typeof(rig) ~= "Instance" then
		warnOnce("load:" .. typeof(rig), "Anim.load needs a character or rig Model, got " .. typeof(rig))
		return newPlayer(nil)
	end
	local player = players[rig]
	if player ~= nil and not player.destroyed then
		return player
	end
	player = newPlayer(rig)
	players[rig] = player
	return player
end

-- The rig's player if Anim.load made one, else nil.
function Anim.get(rig)
	local player = players[rig]
	if player ~= nil and not player.destroyed then
		return player
	end
	return nil
end

function Player:_rebuild()
	self.dirty = false
	local rig = self.rig
	if rig == nil then
		return
	end
	local lastByMotor = {}
	for s, cf in self.last do
		if self.motors[s] then
			lastByMotor[self.motors[s]] = cf
		end
	end
	local motors, names, slotOf = {}, {}, {}
	local incomplete, otherJoints = false, false
	for _, d in rig:GetDescendants() do
		if d:IsA("Motor6D") then
			if d.Part0 ~= nil and d.Part1 ~= nil then
				if slotOf[d.Name] == nil then
					table.insert(motors, d)
					table.insert(names, d.Name)
					slotOf[d.Name] = #motors
				else
					warnOnce("dup:" .. rig:GetFullName() .. ":" .. d.Name,
						rig:GetFullName() .. " has two joints named " .. d.Name .. "; Anim drives the first")
				end
			else
				incomplete = true
			end
		elseif d:IsA("AnimationConstraint") or d:IsA("Bone") then
			otherJoints = true
		end
	end
	self.motors, self.names, self.slotOf, self.slots = motors, names, slotOf, #motors
	self.last = {}
	for s, motor in motors do
		self.last[s] = lastByMotor[motor]
	end
	self.mixer = AnimCore.newMixer(#motors)
	self.addX, self.addY, self.addZ, self.addW, self.addOn = {}, {}, {}, {}, {}
	self.maps = {}
	for i = 1, self.nTracks do
		self.tracks[i].map = self:_mapFor(self.tracks[i].clip)
	end
	self:_restFrames()
	if #motors == 0 then
		if otherJoints then
			warnOnce("bones:" .. rig:GetFullName(), rig:GetFullName()
				.. " is jointed with AnimationConstraints or Bones, not Motor6Ds; Anim skips it")
		elseif not incomplete then
			warnOnce("nojoints:" .. rig:GetFullName(), rig:GetFullName() .. " has no Motor6D joints (yet)")
		end
	end
	self.rescanAt = if incomplete then os.clock() + 1 else nil
end

-- Each joint's axis frame: the character's axes at rest, carried into the joint (rest orientation of Part0 times
-- C0's rotation, relative to the character frame: the root part for humanoids, the model's pivot otherwise). Pose
-- rotations are given in these axes and conjugated into C0 space; on R15 every axis frame is the identity.
function Player:_restFrames()
	local rig = self.rig
	local motors = self.motors
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	local root = humanoid and humanoid.RootPart or nil
	if root == nil and rig:IsA("Model") then
		root = rig.PrimaryPart
	end
	local isChild = {}
	for _, m in motors do
		isChild[m.Part1] = true
	end
	if root == nil then
		for _, m in motors do
			if not isChild[m.Part0] then
				root = m.Part0
				break
			end
		end
	end
	if root == nil and motors[1] ~= nil then
		root = motors[1].Part0
	end
	self.root = root
	local rest = {}
	if root ~= nil then
		if humanoid ~= nil or not rig:IsA("Model") then
			rest[root] = { 0, 0, 0, 1 }
		else
			local px, py, pz, pw = quatOf(rig:GetPivot())
			rest[root] = { mul(-px, -py, -pz, pw, quatOf(root.CFrame)) }
		end
		local changed, passes = true, 0
		while changed and passes < 64 do
			changed, passes = false, passes + 1
			for _, m in motors do
				local r0 = rest[m.Part0]
				if r0 ~= nil and rest[m.Part1] == nil then
					local cx, cy, cz, cw = quatOf(m.C0)
					local x, y, z, w = mul(r0[1], r0[2], r0[3], r0[4], cx, cy, cz, cw)
					local dx, dy, dz, dw = quatOf(m.C1)
					rest[m.Part1] = { mul(x, y, z, w, -dx, -dy, -dz, dw) }
					changed = true
				end
			end
		end
	end
	for s, m in motors do
		local r0 = rest[m.Part0]
		local x, y, z, w = 0, 0, 0, 1
		if r0 ~= nil then
			x, y, z, w = mul(r0[1], r0[2], r0[3], r0[4], quatOf(m.C0))
		elseif root ~= nil then -- not linked to the root through joints: use how it sits now
			local rx, ry, rz, rw = quatOf(root.CFrame)
			local px, py, pz, pw = quatOf(m.Part0.CFrame)
			local ax, ay, az, aw = mul(px, py, pz, pw, quatOf(m.C0))
			x, y, z, w = mul(-rx, -ry, -rz, rw, ax, ay, az, aw)
		end
		if w < 0 then
			x, y, z, w = -x, -y, -z, -w
		end
		self.axis[s] = if w > 0.999999 then false else { x, y, z, w }
	end
	for s = #motors + 1, #self.axis do
		self.axis[s] = nil
	end
end

function Player:_mapFor(clip)
	local map = self.maps[clip]
	if map == nil then
		map = table.create(clip.count, 0)
		local missing = nil
		for i, ch in clip.channels do
			local s = self.slotOf[ch.joint]
			if s ~= nil then
				map[i] = s
			else
				missing = missing or {}
				table.insert(missing, ch.joint)
			end
		end
		if missing ~= nil and self.slots > 0 then
			warnOnce("miss:" .. self.id .. ":" .. clip.name, "clip '" .. clip.name .. "' poses joints "
				.. self.rig.Name .. " does not have: " .. table.concat(missing, ", "))
		end
		self.maps[clip] = map
	end
	return map
end

local function stepAll(dt)
	local i = 1
	while i <= #active do
		local p = active[i]
		local keep = false
		if not p.destroyed then
			local ok, result = pcall(p._step, p, dt)
			if ok then
				keep = result
			else
				warnOnce("step:" .. p.id, "animating " .. (if p.rig then p.rig:GetFullName() else "?") .. " failed: "
					.. tostring(result))
				keep = true
			end
		end
		if keep then
			i += 1
		else
			p.active = false
			active[i] = active[#active]
			active[#active] = nil
		end
	end
end

function Player:_wake()
	if self.active or self.destroyed or self.rig == nil then
		return
	end
	self.active = true
	table.insert(active, self)
	if stepConnection == nil then
		local ok, signal = pcall(function()
			return RunService.PreSimulation
		end)
		if ok and signal ~= nil then
			stepConnection = signal:Connect(stepAll)
		else
			stepConnection = RunService.Stepped:Connect(function(_, dt)
				stepAll(dt)
			end)
		end
	end
end

-- Plays a clip (a name or a clip table) and returns its track. See the header for the options.
function Player:play(clipOrName, opts)
	local clip = resolve(clipOrName)
	if clip == nil or self.destroyed or self.rig == nil then
		return nullTrack(if type(clipOrName) == "string" then clipOrName else nil)
	end
	if self.dirty then
		self:_rebuild()
	end
	opts = if type(opts) == "table" then opts else {}
	local looped = if opts.looped == nil then clip.looped else opts.looped == true
	local tracks = self.tracks
	for i = 1, self.nTracks do
		local tr = tracks[i]
		if tr.clip == clip and tr.state == "playing" then
			if looped and not opts.restart then
				if opts.speed ~= nil then
					tr:adjustSpeed(opts.speed)
				end
				if opts.weight ~= nil then
					tr:adjustWeight(opts.weight, opts.fade)
				end
				return tr
			end
			tr:stop(opts.fade)
		end
	end
	local track = wrapTrack(AnimCore.newTrack(clip, opts))
	track._player = self
	track.map = self:_mapFor(clip)
	-- keep tracks sorted by priority; a new track goes after the others of its priority
	local at = self.nTracks + 1
	while at > 1 and tracks[at - 1].prio > track.prio do
		tracks[at] = tracks[at - 1]
		at -= 1
	end
	tracks[at] = track
	self.nTracks += 1
	self:_wake()
	return track
end
Player.Play = Player.play

-- The playing track of a clip (by name), or nil.
function Player:getTrack(name)
	for i = 1, self.nTracks do
		local tr = self.tracks[i]
		if tr.name == name and tr.state == "playing" then
			return tr
		end
	end
	return nil
end

function Player:isPlaying(name)
	return self:getTrack(name) ~= nil
end

function Player:stopAll(fade)
	for i = self.nTracks, 1, -1 do
		self.tracks[i]:stop(fade)
	end
end
Player.StopAll = Player.stopAll

-- Procedural layers ----------------------------------------------------------------------------------------

-- Lean into turns (roll) and forward with speed, from the root part's motion. amount: 0 off, 1 normal, up to 3.
function Player:lean(amount)
	self.leanAmount = clamp(num(amount, 0), 0, 3)
	self:_wake()
end

-- Turn the head (and a little of the chest) toward a Vector3, BasePart, Attachment or Model; nil lets go.
function Player:lookAt(target)
	if target ~= nil and targetPosition(target) == nil then
		warnOnce("look:" .. typeof(target), "lookAt needs a Vector3, BasePart, Attachment or Model (or nil), got "
			.. typeof(target))
		target = nil
	end
	self.look = target
	self:_wake()
end

-- A slow breath in the chest, shoulders and neck. opts: rate (breaths per second, 0.25), depth (1).
function Player:breathe(on, opts)
	self.breath = on ~= false
	if type(opts) == "table" then
		self.breathRate = clamp(num(opts.rate, self.breathRate), 0.05, 2)
		self.breathDepth = clamp(num(opts.depth, self.breathDepth), 0, 4)
	end
	self:_wake()
end

-- A kick on one joint that springs back: rotation { rx, ry, rz } degrees (or a Vector3), peaking quickly and
-- settling within recoverSeconds (default 0.25) with a little overshoot.
function Player:recoil(jointName, rotation, recoverSeconds)
	local rx, ry, rz = rotationOf(rotation)
	if type(jointName) ~= "string" or rx == nil then
		warnOnce("recoil:args", "recoil(jointName, { rx, ry, rz }, recoverSeconds) got bad arguments")
		return
	end
	if self.dirty then
		self:_rebuild()
	end
	if self.slotOf[jointName] == nil then
		warnOnce("recoil:" .. jointName, "recoil: this rig has no joint named " .. jointName)
		return
	end
	local speed = 5 / clamp(num(recoverSeconds, 0.25), 0.05, 3)
	local state = self.recoils[jointName]
	if state == nil then
		state = { Spring.new(0, speed, 0.6), Spring.new(0, speed, 0.6), Spring.new(0, speed, 0.6) }
		self.recoils[jointName] = state
	end
	for k, v in { rx, ry, rz } do
		local s = state[k]
		s.Speed = speed
		s.Damping = 0.6
		s:Impulse(v * speed * 2) -- an impulse of 2 * speed * v peaks near v at this damping
	end
	self:_wake()
end

-- Squash (amount > 0, e.g. 0.3) or stretch (< 0) a part's SpecialMesh, volume-preserving, springing back with a
-- wobble. For blobby non-humanoid rigs; partName defaults to the rig's root part.
function Player:squash(amount, partName)
	amount = clamp(num(amount, 0), -0.8, 0.8)
	if self.dirty then
		self:_rebuild()
	end
	local part = if type(partName) == "string" and self.rig ~= nil then self.rig:FindFirstChild(partName, true)
		else self.root
	local mesh = part and part:FindFirstChildWhichIsA("SpecialMesh")
	if mesh == nil then
		warnOnce("squash:" .. tostring(partName), "squash needs a SpecialMesh in the part ("
			.. (if part then part:GetFullName() else tostring(partName)) .. ")")
		return
	end
	local state = self.squashState
	if state == nil or state.mesh ~= mesh then
		if state ~= nil then
			state.mesh.Scale, state.mesh.Offset = state.scale, state.offset
		end
		state = { mesh = mesh, scale = mesh.Scale, offset = mesh.Offset, half = part.Size.Y * 0.5,
			spring = Spring.new(0, 16, 0.4) }
		self.squashState = state
	end
	state.spring.Position = amount
	state.spring.Velocity = 0
	self:_wake()
end

local function addRotation(self, slot, x, y, z, w)
	if slot == nil then
		return
	end
	if self.addOn[slot] then
		x, y, z, w = mul(x, y, z, w, self.addX[slot], self.addY[slot], self.addZ[slot], self.addW[slot])
	end
	self.addX[slot], self.addY[slot], self.addZ[slot], self.addW[slot] = x, y, z, w
	self.addOn[slot] = true
end

local function addEuler(self, slot, rx, ry, rz)
	if slot ~= nil then
		addRotation(self, slot, euler(rx, ry, rz))
	end
end

-- Additive rotations (in character axes) from the procedural layers. Returns true while any layer is active.
function Player:_procedural(dt)
	local addOn = self.addOn
	for s in addOn do
		addOn[s] = nil
	end
	local busy = false
	local slotOf = self.slotOf
	local root = self.root
	local waist = slotOf.Waist
	local rootJoint = slotOf.Root or slotOf.RootJoint
	if rootJoint == nil and root ~= nil then
		for s, m in self.motors do
			if m.Part0 == root then
				rootJoint = s
				break
			end
		end
	end

	-- lean: bank into turns (from the yaw rate) and lean forward with speed
	if root ~= nil and (self.leanAmount > 0 or not settled(self.leanRoll, DEG_EPS) or not settled(self.leanPitch, DEG_EPS)) then
		local _, _, _, _, _, r02, _, _, _, _, _, r22 = root.CFrame:GetComponents()
		local lx, lz = -r02, -r22
		local flat = sqrt(lx * lx + lz * lz)
		local yaw = atan2(-lx, -lz)
		local yawRate = 0
		if self.prevYaw ~= nil and dt > 0 then
			local d = yaw - self.prevYaw
			if d > math.pi then
				d -= 2 * math.pi
			elseif d < -math.pi then
				d += 2 * math.pi
			end
			yawRate = d / dt
		end
		self.prevYaw = yaw
		local v = root.AssemblyLinearVelocity
		local speed = sqrt(v.X * v.X + v.Z * v.Z)
		local forward = if flat > 1e-6 then (v.X * lx + v.Z * lz) / flat else 0
		local amount = self.leanAmount
		self.leanRoll.Target = clamp(0.25 * speed * yawRate, -14, 14) * amount
		self.leanPitch.Target = -clamp(forward / 16, -1, 1.5) * 4 * amount
		local roll, pitch = self.leanRoll:Step(dt), self.leanPitch:Step(dt)
		if amount == 0 and settled(self.leanRoll, DEG_EPS) and settled(self.leanPitch, DEG_EPS) then
			self.leanRoll:Snap(0)
			self.leanPitch:Snap(0)
			self.prevYaw = nil
		else
			addEuler(self, rootJoint, 0, 0, roll * 0.5)
			addEuler(self, waist or rootJoint, pitch, 0, roll * 0.5)
			busy = true
		end
	end

	-- lookAt: yaw / pitch toward the target in the root's frame, shared between the neck and the waist
	local neck = slotOf.Neck
	local lookSprings = self.lookSprings
	local looking = self.look ~= nil
	if not looking then
		for _, s in lookSprings do
			if not settled(s, DEG_EPS) then
				looking = true
				break
			end
		end
	end
	if looking and root ~= nil and (neck ~= nil or waist ~= nil) then
		local yawT, pitchT = 0, 0
		local target = if self.look ~= nil then targetPosition(self.look) else nil
		if target ~= nil then
			local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = root.CFrame:GetComponents()
			local head = if neck ~= nil then self.motors[neck].Part1 else nil
			local ox, oy, oz = x, y + 1.5, z
			if head ~= nil then
				local hp = head.Position
				ox, oy, oz = hp.X, hp.Y, hp.Z
			end
			local dx, dy, dz = target.X - ox, target.Y - oy, target.Z - oz
			local lx = r00 * dx + r10 * dy + r20 * dz
			local ly = r01 * dx + r11 * dy + r21 * dz
			local lz = r02 * dx + r12 * dy + r22 * dz
			yawT = clamp(deg(atan2(-lx, -lz)), -110, 110)
			pitchT = clamp(deg(atan2(ly, sqrt(lx * lx + lz * lz))), -60, 60)
		end
		local waistYaw = if waist ~= nil then clamp(yawT * 0.35, -35, 35) else 0
		self.lookWaistYaw.Target = waistYaw
		self.lookNeckYaw.Target = clamp(yawT - waistYaw, -75, 75)
		self.lookNeckPitch.Target = clamp(pitchT * (if waist ~= nil then 0.75 else 1), -45, 45)
		self.lookWaistPitch.Target = if waist ~= nil then clamp(pitchT * 0.25, -15, 15) else 0
		local ny, np = self.lookNeckYaw:Step(dt), self.lookNeckPitch:Step(dt)
		local wy, wp = self.lookWaistYaw:Step(dt), self.lookWaistPitch:Step(dt)
		if self.look == nil and settled(self.lookNeckYaw, DEG_EPS) and settled(self.lookNeckPitch, DEG_EPS)
			and settled(self.lookWaistYaw, DEG_EPS) and settled(self.lookWaistPitch, DEG_EPS) then
			for _, s in lookSprings do
				s:Snap(0)
			end
		else
			-- yaw about the parent's up axis, then pitch about the turned head's own right axis
			local ax, ay, az, aw = euler(0, ny, 0)
			addRotation(self, neck, mul(ax, ay, az, aw, euler(np, 0, 0)))
			ax, ay, az, aw = euler(0, wy, 0)
			addRotation(self, waist, mul(ax, ay, az, aw, euler(wp, 0, 0)))
			busy = true
		end
	end

	-- breathe: chest lifts, head stays level, arms float out a touch
	if self.breath or not settled(self.breathWeight) then
		self.breathWeight.Target = if self.breath then 1 else 0
		local w = self.breathWeight:Step(dt)
		if not self.breath and settled(self.breathWeight) then
			self.breathWeight:Snap(0)
			self.breathPhase = 0
		else
			self.breathPhase = (self.breathPhase + dt * self.breathRate) % 1
			local s = math.sin(self.breathPhase * 2 * math.pi) * w * self.breathDepth
			addEuler(self, waist or rootJoint, 1.4 * s, 0, 0)
			addEuler(self, neck, -1.1 * s, 0, 0)
			addEuler(self, slotOf.RightShoulder, 0, 0, 1.2 * s)
			addEuler(self, slotOf.LeftShoulder, 0, 0, -1.2 * s)
			busy = true
		end
	end

	-- recoil springs
	for name, state in self.recoils do
		local x, y, z = state[1]:Step(dt), state[2]:Step(dt), state[3]:Step(dt)
		if settled(state[1], DEG_EPS) and settled(state[2], DEG_EPS) and settled(state[3], DEG_EPS) then
			self.recoils[name] = nil
		else
			addEuler(self, slotOf[name], x, y, z)
			busy = true
		end
	end

	-- squash
	local sq = self.squashState
	if sq ~= nil then
		local s = sq.spring:Step(dt)
		if settled(sq.spring) or sq.mesh.Parent == nil then
			sq.mesh.Scale, sq.mesh.Offset = sq.scale, sq.offset
			self.squashState = nil
		else
			local sy = math.max(0.2, 1 - s)
			local sxz = 1 / sqrt(sy)
			sq.mesh.Scale = Vector3.new(sq.scale.X * sxz, sq.scale.Y * sy, sq.scale.Z * sxz)
			sq.mesh.Offset = sq.offset + Vector3.new(0, (sy - 1) * sq.half, 0)
			busy = true
		end
	end
	return busy
end

-- takeOver --------------------------------------------------------------------------------------------------

-- On: while any clip plays, the rig's own AnimationTracks (e.g. the default Animate script's) are held at weight
-- 0 and speed 0, and restored when the clips stop. Off: clips blend over them (the default).
function Player:takeOver(on)
	self.takeover = on ~= false
	if not self.takeover then
		self:_release()
	end
	self:_wake()
end

function Player:_suppress()
	self.suppressed = {}
	local animator = self.rig:FindFirstChildWhichIsA("Animator", true)
	if animator == nil then
		return
	end
	local function hold(track)
		local saved = self.suppressed
		if saved == nil then
			return
		end
		pcall(function()
			if saved[track] == nil then
				saved[track] = { weight = track.WeightTarget, speed = track.Speed }
			end
			track:AdjustWeight(0, 0.1)
			track:AdjustSpeed(0)
		end)
	end
	local ok, playing = pcall(function()
		return animator:GetPlayingAnimationTracks()
	end)
	if ok and type(playing) == "table" then
		for _, track in playing do
			hold(track)
		end
	end
	self.animatorConnection = animator.AnimationPlayed:Connect(hold)
end

function Player:_release(fade)
	local saved = self.suppressed
	self.suppressed = nil
	if self.animatorConnection ~= nil then
		self.animatorConnection:Disconnect()
		self.animatorConnection = nil
	end
	if saved == nil then
		return
	end
	for track, was in saved do
		pcall(function()
			if track.IsPlaying then
				track:AdjustWeight(if was.weight > 0 then was.weight else 1, fade or 0.2)
				track:AdjustSpeed(was.speed)
			end
		end)
	end
end

-- Frame step ------------------------------------------------------------------------------------------------

function Player:_write()
	local mixer = self.mixer
	local cover, mqx, mqy, mqz, mqw = mixer.c, mixer.qx, mixer.qy, mixer.qz, mixer.qw
	local mpx, mpy, mpz = mixer.px, mixer.py, mixer.pz
	local motors, axis, last, addOn = self.motors, self.axis, self.last, self.addOn
	for s = 1, self.slots do
		local c = cover[s]
		local add = addOn[s] == true
		local motor = motors[s]
		if c > 0 or add then
			local qx, qy, qz, qw = mqx[s], mqy[s], mqz[s], mqw[s]
			local px, py, pz = mpx[s], mpy[s], mpz[s]
			local a = axis[s]
			if a and c > 0 then -- character axes -> this joint's C0 axes: a^-1 * q * a
				local ax, ay, az, aw = a[1], a[2], a[3], a[4]
				qx, qy, qz, qw = mul(-ax, -ay, -az, aw, qx, qy, qz, qw)
				qx, qy, qz, qw = mul(qx, qy, qz, qw, ax, ay, az, aw)
				px, py, pz = rotateVector(-ax, -ay, -az, aw, px, py, pz)
			end
			if c < 1 then
				-- blend over the base: the Animator's pose if it wrote this joint this frame, else the rest pose
				local bx, by, bz, bw, bpx, bpy, bpz = 0, 0, 0, 1, 0, 0, 0
				local seen = motor.Transform
				local prev = last[s]
				if prev == nil or not sameCFrame(seen, prev) then
					local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = seen:GetComponents()
					bx, by, bz, bw = fromMatrix(r00, r01, r02, r10, r11, r12, r20, r21, r22)
					bpx, bpy, bpz = x, y, z
				end
				qx, qy, qz, qw = slerp(bx, by, bz, bw, qx, qy, qz, qw, c)
				px, py, pz = bpx + (px - bpx) * c, bpy + (py - bpy) * c, bpz + (pz - bpz) * c
			end
			if add then
				local x, y, z, w = self.addX[s], self.addY[s], self.addZ[s], self.addW[s]
				if a then
					x, y, z, w = mul(-a[1], -a[2], -a[3], a[4], x, y, z, w)
					x, y, z, w = mul(x, y, z, w, a[1], a[2], a[3], a[4])
				end
				qx, qy, qz, qw = mul(x, y, z, w, qx, qy, qz, qw)
			end
			local cf = CFrame.new(px, py, pz, qx, qy, qz, qw)
			motor.Transform = cf
			last[s] = cf
		elseif last[s] ~= nil then
			-- ours last frame, nobody's now: hand it back at rest unless the Animator already wrote it
			if sameCFrame(motor.Transform, last[s]) then
				motor.Transform = IDENTITY
			end
			last[s] = nil
		end
	end
end

-- One frame for this rig; returns whether it still has work (tracks, layers, joints to hand back).
function Player:_step(dt)
	if self.dirty or (self.rescanAt ~= nil and os.clock() >= self.rescanAt) then
		self:_rebuild()
	end
	local tracks, n = self.tracks, self.nTracks
	local k = 0
	for i = 1, n do
		local tr = tracks[i]
		if not AnimCore.advance(tr, dt, onTrackEvent) then
			k += 1
			tracks[k] = tr
		end
	end
	for i = k + 1, n do
		tracks[i] = nil
	end
	self.nTracks = k
	if self.slots == 0 then
		return k > 0 or self.rescanAt ~= nil
	end
	self.mixer:mix(tracks, k)
	local busy = self:_procedural(dt)
	if self.takeover and k > 0 then
		if self.suppressed == nil then
			self:_suppress()
		end
	elseif self.suppressed ~= nil then
		self:_release()
	end
	self:_write()
	return k > 0 or busy or next(self.last) ~= nil or self.suppressed ~= nil
end

-- Stops everything, restores the rig's own tracks and joints, and forgets the rig (automatic when it is destroyed).
function Player:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	for _, connection in self.connections do
		connection:Disconnect()
	end
	self.connections = {}
	self:_release(0)
	for i = 1, self.nTracks do
		local tr = self.tracks[i]
		if tr.state ~= "ended" then
			tr.state, tr.isPlaying, tr.w = "ended", false, 0
			tr.Ended:Fire()
		end
	end
	self.tracks, self.nTracks = {}, 0
	for s, cf in self.last do
		local motor = self.motors[s]
		if motor ~= nil and motor.Parent ~= nil and sameCFrame(motor.Transform, cf) then
			motor.Transform = IDENTITY
		end
	end
	self.last = {}
	local sq = self.squashState
	if sq ~= nil then
		sq.mesh.Scale, sq.mesh.Offset = sq.scale, sq.offset
		self.squashState = nil
	end
	if self.rig ~= nil and players[self.rig] == self then
		players[self.rig] = nil
	end
end
Player.Destroy = Player.destroy

return Anim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">AnimCore</string>
          <string name="Source"><![CDATA[--!native
-- AnimCore: the pure-Luau core of Kit.Anim. It uses no Roblox APIs, so the harness tests it under the standalone
-- Luau runtime. It validates and compiles clip data, samples clips (key search, easing, quaternion slerp), blends
-- weighted, prioritized tracks per joint, and runs track time (loops, fades, markers). Kit.Anim binds it to Motor6Ds.
--   local clip, problems = AnimCore.compile(data)     -- nil plus a list of problems for bad data; never errors
--   local qx, qy, qz, qw, px, py, pz = AnimCore.sampleChannel(clip.channels[i], t, clip.looped, clip.length)
--   local mixer = AnimCore.newMixer(jointCount); mixer:mix(tracks, trackCount)   -- results per joint slot
--   local track = AnimCore.newTrack(clip, { fade = 0.15 }); AnimCore.advance(track, dt, onEvent)
--
-- Conventions (shared with harness/tools/anim.py and harness/playbooks/animation_spec.md):
--   A pose value is { rx, ry, rz } or { rx, ry, rz, px, py, pz } (or { rx = .., py = .. }): degrees and studs,
--   relative to the joint's rest frame, about the CHARACTER's axes at rest (X right, Y up, Z back; the character
--   faces -Z). The rotation is CFrame.Angles(rx, ry, rz) = Rx * Ry * Rz, held as a quaternion.
--   Each joint's curve runs through the keys that pose it: quaternion slerp (always the short way round), eased by
--   the ease of the key it moves INTO. Looped clips wrap every curve around the loop, so joints keyed at offset
--   times (overlap) still loop seamlessly. In a one-shot, a joint not posed at t = 0 starts from rest at t = 0, and
--   every joint holds its last key to the end.
--   Blending: tracks of the same priority mix by weight; each priority is laid over the ones below it with its
--   total weight (capped at 1), so a full-weight action overrides idle on the joints it poses.
local AnimCore = {}

local sin, cos, sqrt, acos, floor = math.sin, math.cos, math.sqrt, math.acos, math.floor
local HUGE = math.huge
local HALF_RAD = math.pi / 360 -- degrees -> half-angle radians

AnimCore.PRIORITY = { core = 1, idle = 2, movement = 3, action = 4 }
AnimCore.PRIORITY_NAMES = { "core", "idle", "movement", "action" }
AnimCore.EASES = {
	"linear",
	"sine", "sineIn", "sineOut",
	"quad", "quadIn", "quadOut",
	"cubic", "cubicIn", "cubicOut",
	"back", "backIn", "backOut",
	"expo", "expoIn", "expoOut",
}
AnimCore.DEFAULT_EASE = "sine"
AnimCore.MIN_LENGTH = 0.05
AnimCore.MAX_LENGTH = 60

local EASE_ID = {}
for i, name in AnimCore.EASES do
	EASE_ID[name] = i
end
AnimCore.EASE_ID = EASE_ID

-- Easing curves (Penner). "<style>" eases both ends, "<style>In" accelerates into the key, "<style>Out"
-- decelerates into it (the same meaning as Enum.EasingDirection). back overshoots; the slerp extrapolates.
local B1 = 1.70158
local B2 = B1 * 1.525
local B3 = B1 + 1
local PI, HALF_PI = math.pi, math.pi / 2

local EASE_FN = {
	function(a) -- linear
		return a
	end,
	function(a) -- sine
		return -(cos(PI * a) - 1) / 2
	end,
	function(a) -- sineIn
		return 1 - cos(a * HALF_PI)
	end,
	function(a) -- sineOut
		return sin(a * HALF_PI)
	end,
	function(a) -- quad
		if a < 0.5 then
			return 2 * a * a
		end
		local b = -2 * a + 2
		return 1 - b * b / 2
	end,
	function(a) -- quadIn
		return a * a
	end,
	function(a) -- quadOut
		local b = 1 - a
		return 1 - b * b
	end,
	function(a) -- cubic
		if a < 0.5 then
			return 4 * a * a * a
		end
		local b = -2 * a + 2
		return 1 - b * b * b / 2
	end,
	function(a) -- cubicIn
		return a * a * a
	end,
	function(a) -- cubicOut
		local b = 1 - a
		return 1 - b * b * b
	end,
	function(a) -- back
		if a < 0.5 then
			local b = 2 * a
			return b * b * ((B2 + 1) * b - B2) / 2
		end
		local b = 2 * a - 2
		return (b * b * ((B2 + 1) * b + B2) + 2) / 2
	end,
	function(a) -- backIn
		return B3 * a * a * a - B1 * a * a
	end,
	function(a) -- backOut
		local b = a - 1
		return 1 + B3 * b * b * b + B1 * b * b
	end,
	function(a) -- expo
		if a <= 0 then
			return 0
		elseif a >= 1 then
			return 1
		elseif a < 0.5 then
			return 2 ^ (20 * a - 10) / 2
		end
		return (2 - 2 ^ (-20 * a + 10)) / 2
	end,
	function(a) -- expoIn
		if a <= 0 then
			return 0
		end
		return 2 ^ (10 * a - 10)
	end,
	function(a) -- expoOut
		if a >= 1 then
			return 1
		end
		return 1 - 2 ^ (-10 * a)
	end,
}

function AnimCore.ease(name, a)
	local id = if type(name) == "number" then name else EASE_ID[name]
	return EASE_FN[id or EASE_ID[AnimCore.DEFAULT_EASE]](a)
end

-- Quaternions (x, y, z, w) -------------------------------------------------------------------------------

-- CFrame.Angles(rx, ry, rz) in degrees (= Rx * Ry * Rz) as a quaternion.
function AnimCore.euler(rx, ry, rz)
	local hx, hy, hz = rx * HALF_RAD, ry * HALF_RAD, rz * HALF_RAD
	local sx, cx = sin(hx), cos(hx)
	local sy, cy = sin(hy), cos(hy)
	local sz, cz = sin(hz), cos(hz)
	return sx * cy * cz + cx * sy * sz, cx * sy * cz - sx * cy * sz, cx * cy * sz + sx * sy * cz, cx * cy * cz - sx * sy * sz
end

-- a * b (apply b first, then a).
local function mul(ax, ay, az, aw, bx, by, bz, bw)
	return aw * bx + ax * bw + ay * bz - az * by,
		aw * by - ax * bz + ay * bw + az * bx,
		aw * bz + ax * by - ay * bx + az * bw,
		aw * bw - ax * bx - ay * by - az * bz
end
AnimCore.mul = mul

-- Rotates the vector (vx, vy, vz) by the unit quaternion q.
function AnimCore.rotate(qx, qy, qz, qw, vx, vy, vz)
	local tx = 2 * (qy * vz - qz * vy)
	local ty = 2 * (qz * vx - qx * vz)
	local tz = 2 * (qx * vy - qy * vx)
	return vx + qw * tx + (qy * tz - qz * ty), vy + qw * ty + (qz * tx - qx * tz), vz + qw * tz + (qx * ty - qy * tx)
end

-- Rotation matrix (rows, as CFrame:GetComponents() gives them) -> unit quaternion.
function AnimCore.fromMatrix(r00, r01, r02, r10, r11, r12, r20, r21, r22)
	local x, y, z, w
	local trace = r00 + r11 + r22
	if trace > 0 then
		local s = sqrt(trace + 1) * 2
		x, y, z, w = (r21 - r12) / s, (r02 - r20) / s, (r10 - r01) / s, 0.25 * s
	elseif r00 > r11 and r00 > r22 then
		local s = sqrt(1 + r00 - r11 - r22) * 2
		x, y, z, w = 0.25 * s, (r01 + r10) / s, (r02 + r20) / s, (r21 - r12) / s
	elseif r11 > r22 then
		local s = sqrt(1 + r11 - r00 - r22) * 2
		x, y, z, w = (r01 + r10) / s, 0.25 * s, (r12 + r21) / s, (r02 - r20) / s
	else
		local s = sqrt(1 + r22 - r00 - r11) * 2
		x, y, z, w = (r02 + r20) / s, (r12 + r21) / s, 0.25 * s, (r10 - r01) / s
	end
	local n = sqrt(x * x + y * y + z * z + w * w)
	return x / n, y / n, z / n, w / n
end

-- Spherical interpolation from a to b, the short way round. t outside 0..1 extrapolates along the same arc
-- (back easing overshoots); nearly equal rotations fall back to a normalized lerp.
local function slerp(
	ax: number,
	ay: number,
	az: number,
	aw: number,
	bx: number,
	by: number,
	bz: number,
	bw: number,
	t: number
): (number, number, number, number)
	local d = ax * bx + ay * by + az * bz + aw * bw
	if d < 0 then
		d, bx, by, bz, bw = -d, -bx, -by, -bz, -bw
	end
	local k0, k1
	if d > 0.9995 then
		k0, k1 = 1 - t, t
	else
		local th = acos(d)
		local s = sin(th)
		k0, k1 = sin((1 - t) * th) / s, sin(t * th) / s
	end
	local x, y, z, w = ax * k0 + bx * k1, ay * k0 + by * k1, az * k0 + bz * k1, aw * k0 + bw * k1
	local n = sqrt(x * x + y * y + z * z + w * w)
	if n < 1e-12 then
		return 0, 0, 0, 1
	end
	return x / n, y / n, z / n, w / n
end
AnimCore.slerp = slerp

-- Validation ---------------------------------------------------------------------------------------------

local function finite(x)
	return type(x) == "number" and x == x and x ~= HUGE and x ~= -HUGE
end

local POSE_FIELDS = { rx = true, ry = true, rz = true, px = true, py = true, pz = true }

-- A pose value -> rx, ry, rz, px, py, pz; nil when it is not { rx, ry, rz [, px, py, pz] } or { rx = .., .. }.
local function poseValue(v)
	if type(v) ~= "table" then
		return nil
	end
	local n = #v
	if n > 0 then
		if n ~= 3 and n ~= 6 then
			return nil
		end
		for i = 1, n do
			if not finite(v[i]) then
				return nil
			end
		end
		return v[1], v[2], v[3], v[4] or 0, v[5] or 0, v[6] or 0
	end
	local any = false
	for k, x in v do
		if not POSE_FIELDS[k] or not finite(x) then
			return nil
		end
		any = true
	end
	if not any then
		return nil
	end
	return v.rx or 0, v.ry or 0, v.rz or 0, v.px or 0, v.py or 0, v.pz or 0
end
AnimCore.poseValue = poseValue

local function near(a, b)
	return math.abs(a - b) <= 1e-6
end

-- Every structural problem in a clip table, as a list of strings (empty when the clip is usable).
-- harness/tools/anim.py validates authored clips more strictly (joint names, anatomical limits, loop seams);
-- this is the runtime's guard so bad data warns instead of erroring.
function AnimCore.check(clip)
	local problems = {}
	local function bad(message)
		if #problems < 24 then
			table.insert(problems, message)
		end
	end
	if type(clip) ~= "table" then
		return { "a clip must be a table" }
	end
	if type(clip.name) ~= "string" or clip.name == "" then
		bad("name must be a non-empty string")
	end
	local length = clip.length
	if not finite(length) or length < AnimCore.MIN_LENGTH or length > AnimCore.MAX_LENGTH then
		bad(`length must be seconds between {AnimCore.MIN_LENGTH} and {AnimCore.MAX_LENGTH}, got {tostring(length)}`)
		length = nil
	end
	if clip.looped ~= nil and type(clip.looped) ~= "boolean" then
		bad("looped must be true or false")
	end
	if clip.priority ~= nil and AnimCore.PRIORITY[clip.priority] == nil then
		bad(`priority must be core, idle, movement or action, got {tostring(clip.priority)}`)
	end
	local keys = clip.keys
	if type(keys) ~= "table" or #keys == 0 then
		bad("keys must be a non-empty list of { t = seconds, pose = { [joint] = { rx, ry, rz } } }")
		return problems
	end
	local last = -HUGE
	for i, key in ipairs(keys) do
		local where = `keys[{i}]`
		if type(key) ~= "table" then
			bad(where .. " must be a table")
			continue
		end
		local t = key.t
		if not finite(t) then
			bad(where .. ".t must be a number of seconds")
		else
			if t < 0 or (length ~= nil and t > length + 1e-6) then
				bad(`{where}.t = {t} is outside 0..length`)
			end
			if t <= last then
				bad(`{where}.t = {t} is not after the previous key (keys must be in time order)`)
			end
			last = t
		end
		if key.ease ~= nil and EASE_ID[key.ease] == nil then
			bad(`{where}.ease {tostring(key.ease)} is not one of {table.concat(AnimCore.EASES, ", ")}`)
		end
		local pose = key.pose
		if type(pose) ~= "table" then
			bad(where .. ".pose must be a table { [joint] = { rx, ry, rz } }")
			continue
		end
		for joint, v in pose do
			if type(joint) ~= "string" or joint == "" then
				bad(where .. ".pose has a joint name that is not a string")
			elseif poseValue(v) == nil then
				bad(`{where}.pose.{joint} must be \{ rx, ry, rz } or \{ rx, ry, rz, px, py, pz } (finite numbers)`)
			end
		end
	end
	local first = keys[1]
	local final = keys[#keys]
	if type(first) == "table" and finite(first.t) and not near(first.t, 0) then
		bad("the first key must be at t = 0")
	end
	if clip.looped == true and length ~= nil and type(final) == "table" and finite(final.t) and not near(final.t, length) then
		bad("a looped clip needs its last key at t = length (the same pose as t = 0)")
	end
	if clip.markers ~= nil then
		if type(clip.markers) ~= "table" then
			bad("markers must be a list of { t = seconds, name = string }")
		else
			for i, m in ipairs(clip.markers) do
				if type(m) ~= "table" or type(m.name) ~= "string" or m.name == "" then
					bad(`markers[{i}] needs a name`)
				elseif not finite(m.t) or m.t < 0 or (length ~= nil and m.t > length + 1e-6) then
					bad(`markers[{i}] ({m.name}).t must be within 0..length`)
				end
			end
		end
	end
	return problems
end

-- Compile ------------------------------------------------------------------------------------------------

-- Validates and precomputes a clip: one channel per joint (the keys that pose it) with quaternions.
-- Returns compiled, {} or nil, problems. An already compiled clip is returned as is.
function AnimCore.compile(clip)
	if type(clip) == "table" and clip._compiled == true then
		return clip, {}
	end
	local problems = AnimCore.check(clip)
	if #problems > 0 then
		return nil, problems
	end
	local byJoint, joints = {}, {}
	for _, key in ipairs(clip.keys) do
		local ease = EASE_ID[key.ease or AnimCore.DEFAULT_EASE]
		for joint, v in key.pose do
			local ch = byJoint[joint]
			if ch == nil then
				ch = { joint = joint, n = 0, t = {}, qx = {}, qy = {}, qz = {}, qw = {}, px = {}, py = {}, pz = {}, ease = {} }
				byJoint[joint] = ch
				table.insert(joints, joint)
			end
			local rx, ry, rz, px, py, pz = poseValue(v)
			local n = ch.n + 1
			ch.n = n
			ch.t[n] = key.t
			ch.qx[n], ch.qy[n], ch.qz[n], ch.qw[n] = AnimCore.euler(rx, ry, rz)
			ch.px[n], ch.py[n], ch.pz[n] = px, py, pz
			ch.ease[n] = ease
		end
	end
	table.sort(joints)
	local looped = clip.looped == true
	local channels, index = {}, {}
	for i, joint in joints do
		local ch = byJoint[joint]
		if not looped and ch.t[1] > 0 then
			-- a one-shot starts every joint it moves from rest unless the joint is posed at t = 0
			table.insert(ch.t, 1, 0)
			table.insert(ch.qx, 1, 0)
			table.insert(ch.qy, 1, 0)
			table.insert(ch.qz, 1, 0)
			table.insert(ch.qw, 1, 1)
			table.insert(ch.px, 1, 0)
			table.insert(ch.py, 1, 0)
			table.insert(ch.pz, 1, 0)
			table.insert(ch.ease, 1, EASE_ID[AnimCore.DEFAULT_EASE])
			ch.n += 1
		end
		channels[i] = ch
		index[joint] = i
	end
	local markers = {}
	if type(clip.markers) == "table" then
		for _, m in ipairs(clip.markers) do
			local t = m.t
			if looped and t >= clip.length - 1e-6 then
				t = 0 -- the end of a loop is its start
			end
			table.insert(markers, { t = t, name = m.name })
		end
		table.sort(markers, function(a, b)
			return a.t < b.t
		end)
	end
	local priorityName = clip.priority or (if looped then "idle" else "action")
	return {
		_compiled = true,
		name = clip.name,
		length = clip.length,
		looped = looped,
		priority = AnimCore.PRIORITY[priorityName],
		priorityName = priorityName,
		channels = channels,
		index = index,
		joints = joints,
		count = #channels,
		markers = markers,
		source = clip,
	}, {}
end

-- Sampling -----------------------------------------------------------------------------------------------

-- One joint at time t -> qx, qy, qz, qw, px, py, pz. Looped: t wraps, and so does the curve (from the joint's
-- last key round to its first). Not looped: holds the first / last key outside the keyed range.
local function sampleChannel(ch, t, looped, length)
	local n = ch.n
	local times = ch.t
	if n == 1 then
		return ch.qx[1], ch.qy[1], ch.qz[1], ch.qw[1], ch.px[1], ch.py[1], ch.pz[1]
	end
	local i, j, a = 0, 0, 0
	local wrapped = false
	if looped then
		t -= floor(t / length) * length
		if t >= length then
			t = 0
		end
		local tLast = times[n]
		if t < times[1] or t >= tLast then
			local span = times[1] + length - tLast
			local u = if t >= tLast then t - tLast else t + length - tLast
			i, j, a = n, 1, if span > 0 then u / span else 0
			wrapped = true
		end
	else
		if t <= times[1] then
			return ch.qx[1], ch.qy[1], ch.qz[1], ch.qw[1], ch.px[1], ch.py[1], ch.pz[1]
		elseif t >= times[n] then
			return ch.qx[n], ch.qy[n], ch.qz[n], ch.qw[n], ch.px[n], ch.py[n], ch.pz[n]
		end
	end
	if not wrapped then
		local lo, hi = 1, n -- times[lo] <= t < times[hi]
		while hi - lo > 1 do
			local mid = (lo + hi) // 2
			if times[mid] <= t then
				lo = mid
			else
				hi = mid
			end
		end
		i, j = lo, lo + 1
		a = (t - times[i]) / (times[j] - times[i])
	end
	local k = EASE_FN[ch.ease[j]](a)
	local qx, qy, qz, qw = slerp(ch.qx[i], ch.qy[i], ch.qz[i], ch.qw[i], ch.qx[j], ch.qy[j], ch.qz[j], ch.qw[j], k)
	local px, py, pz = ch.px[i], ch.py[i], ch.pz[i]
	return qx, qy, qz, qw, px + (ch.px[j] - px) * k, py + (ch.py[j] - py) * k, pz + (ch.pz[j] - pz) * k
end
AnimCore.sampleChannel = sampleChannel

-- Every joint of a compiled clip at time t -> { [joint] = { qx, qy, qz, qw, px, py, pz } } (allocates; for tools).
function AnimCore.samplePose(clip, t, looped)
	if looped == nil then
		looped = clip.looped
	end
	local out = {}
	for _, ch in clip.channels do
		out[ch.joint] = { sampleChannel(ch, t, looped, clip.length) }
	end
	return out
end

-- Mixer --------------------------------------------------------------------------------------------------
-- Blends tracks into per-joint results without allocating. A track (see newTrack) needs: clip (compiled), time,
-- looped, w (effective weight), prio, and map (clip channel index -> joint slot, 0 when the rig lacks the joint).
-- tracks[1..count] must be sorted by prio, lowest first. After mix(), for each slot s:
--   c[s]   coverage 0..1: how much of this joint the tracks own (0 = untouched)
--   qx/qy/qz/qw[s], px/py/pz[s]   the blended pose (unit quaternion; identity where c is 0)
-- The final joint pose is slerp(base, blended, c): base is the rest pose, or the Animator's pose under it.
local Mixer = {}
Mixer.__index = Mixer

local FIELDS = { "c", "qx", "qy", "qz", "qw", "px", "py", "pz", "lw", "lx", "ly", "lz", "lq", "lpx", "lpy", "lpz" }

function AnimCore.newMixer(slots)
	local m = setmetatable({ n = slots }, Mixer)
	for _, f in FIELDS do
		m[f] = table.create(slots, 0)
	end
	return m
end

function Mixer:mix(tracks, count)
	local n = self.n
	local c, qx, qy, qz, qw, px, py, pz = self.c, self.qx, self.qy, self.qz, self.qw, self.px, self.py, self.pz
	local lw, lx, ly, lz, lq, lpx, lpy, lpz = self.lw, self.lx, self.ly, self.lz, self.lq, self.lpx, self.lpy, self.lpz
	for s = 1, n do
		c[s], qx[s], qy[s], qz[s], qw[s], px[s], py[s], pz[s] = 0, 0, 0, 0, 0, 0, 0, 0
	end
	local i = 1
	while i <= count do
		local prio = tracks[i].prio
		for s = 1, n do
			lw[s], lx[s], ly[s], lz[s], lq[s], lpx[s], lpy[s], lpz[s] = 0, 0, 0, 0, 0, 0, 0, 0
		end
		local any = false
		-- one priority layer: weighted sum of its tracks per joint (quaternions kept in one hemisphere)
		while i <= count do
			local tr = tracks[i]
			if tr.prio ~= prio then
				break
			end
			i += 1
			local w = tr.w
			local map = tr.map
			if w > 0 and map ~= nil then
				local clip = tr.clip
				local channels = clip.channels
				local looped, length, time = tr.looped, clip.length, tr.time
				for ci = 1, clip.count do
					local s = map[ci]
					if s ~= nil and s > 0 then
						local x, y, z, ww, ox, oy, oz = sampleChannel(channels[ci], time, looped, length)
						local acc = lw[s]
						if acc > 0 and lx[s] * x + ly[s] * y + lz[s] * z + lq[s] * ww < 0 then
							x, y, z, ww = -x, -y, -z, -ww
						end
						lx[s] += w * x
						ly[s] += w * y
						lz[s] += w * z
						lq[s] += w * ww
						lpx[s] += w * ox
						lpy[s] += w * oy
						lpz[s] += w * oz
						lw[s] = acc + w
						any = true
					end
				end
			end
		end
		if any then
			-- lay the layer over what is below it with alpha = min(1, total weight)
			for s = 1, n do
				local wsum = lw[s]
				if wsum > 0 then
					local alpha = if wsum < 1 then wsum else 1
					local x, y, z, ww = lx[s], ly[s], lz[s], lq[s]
					local len = sqrt(x * x + y * y + z * z + ww * ww)
					if len > 1e-12 then
						x, y, z, ww = x / len, y / len, z / len, ww / len
					else
						x, y, z, ww = 0, 0, 0, 1
					end
					if c[s] > 0 and qx[s] * x + qy[s] * y + qz[s] * z + qw[s] * ww < 0 then
						x, y, z, ww = -x, -y, -z, -ww
					end
					local keep = 1 - alpha
					qx[s] = qx[s] * keep + x * alpha
					qy[s] = qy[s] * keep + y * alpha
					qz[s] = qz[s] * keep + z * alpha
					qw[s] = qw[s] * keep + ww * alpha
					px[s] = px[s] * keep + lpx[s] / wsum * alpha
					py[s] = py[s] * keep + lpy[s] / wsum * alpha
					pz[s] = pz[s] * keep + lpz[s] / wsum * alpha
					c[s] = c[s] * keep + alpha
				end
			end
		end
	end
	for s = 1, n do
		local cs = c[s]
		if cs > 0 then
			local x, y, z, w = qx[s], qy[s], qz[s], qw[s]
			local len = sqrt(x * x + y * y + z * z + w * w)
			if len > 1e-12 then
				qx[s], qy[s], qz[s], qw[s] = x / len, y / len, z / len, w / len
			else
				qx[s], qy[s], qz[s], qw[s] = 0, 0, 0, 1
			end
			px[s] /= cs
			py[s] /= cs
			pz[s] /= cs
		else
			qw[s] = 1
		end
	end
end

-- Tracks -------------------------------------------------------------------------------------------------

local function number(x, default)
	if finite(x) then
		return x
	end
	return default
end

local function clampNumber(x, default, lo, hi)
	return math.clamp(number(x, default), lo, hi)
end

-- A playing instance of a compiled clip. opts: fade (seconds in, default 0.15), speed (1; negative plays
-- backwards), weight (1), priority (name; default the clip's), looped (default the clip's), hold (a one-shot keeps
-- its last pose until stopped), fadeOut (seconds out when a one-shot ends; default fade).
function AnimCore.newTrack(clip, opts)
	opts = if type(opts) == "table" then opts else {}
	local speed = clampNumber(opts.speed, 1, -100, 100)
	local weight = clampNumber(opts.weight, 1, 0, 10)
	local fade = clampNumber(opts.fade, 0.15, 0, 10)
	local looped = if opts.looped == nil then clip.looped else opts.looped == true
	return {
		clip = clip,
		name = clip.name,
		length = clip.length,
		looped = looped,
		prio = AnimCore.PRIORITY[opts.priority] or clip.priority,
		time = if speed < 0 and not looped then clip.length else 0,
		speed = speed,
		weight = weight,
		w = if fade > 0 then 0 else weight,
		wFrom = 0,
		wTo = weight,
		fadeT = fade,
		fadeE = 0,
		fadeOut = clampNumber(opts.fadeOut, fade, 0, 10),
		hold = opts.hold == true,
		state = "playing", -- playing -> stopping (fading out) -> ended
		isPlaying = true,
	}
end

-- Calls onEvent(track, "marker", name) for markers with lo < t < hi (inclusive ends when asked).
local function fire(tr, lo, hi, loIn, hiIn, onEvent)
	local markers = tr.clip.markers
	for i = 1, #markers do
		local m = markers[i]
		local t = m.t
		if (t > lo or (loIn and t == lo)) and (t < hi or (hiIn and t == hi)) then
			onEvent(tr, "marker", m.name)
		end
	end
end

-- Advances time and fades by dt seconds. Events go to onEvent(track, kind, name): "marker" (only while playing),
-- "stopped" (a one-shot reached its end and starts fading out) and "ended" (faded out; drop the track).
-- Returns true once the track has ended.
function AnimCore.advance(tr, dt, onEvent)
	if tr.state == "ended" then
		return true
	end
	local length = tr.clip.length
	local d = dt * tr.speed
	local firing = onEvent ~= nil and tr.state == "playing" and #tr.clip.markers > 0
	if d ~= 0 then
		local t0 = tr.time
		local t1 = t0 + d
		if tr.looped then
			if d > 0 then
				if t1 >= length then
					if firing then
						fire(tr, t0, length, true, false, onEvent) -- [t0, length)
					end
					t1 -= floor(t1 / length) * length
					if firing then
						fire(tr, 0, t1, true, false, onEvent) -- [0, t1)
					end
				elseif firing then
					fire(tr, t0, t1, true, false, onEvent) -- [t0, t1)
				end
			elseif t1 < 0 then
				if firing then
					fire(tr, 0, t0, true, true, onEvent) -- [0, t0]
				end
				t1 -= floor(t1 / length) * length
				if firing then
					fire(tr, t1, length, false, false, onEvent) -- (t1, length)
				end
			elseif firing then
				fire(tr, t1, t0, false, true, onEvent) -- (t1, t0]
			end
			if t1 >= length then
				t1 = 0
			end
			tr.time = t1
		elseif (d > 0 and t0 < length) or (d < 0 and t0 > 0) then
			local done = false
			if d > 0 then
				if t1 >= length then
					t1, done = length, true
				end
				if firing then
					fire(tr, t0, t1, true, done, onEvent) -- [t0, t1), or [t0, length] at the end
				end
			else
				if t1 <= 0 then
					t1, done = 0, true
				end
				if firing then
					fire(tr, t1, t0, done, true, onEvent) -- (t1, t0], or [0, t0] at the start
				end
			end
			tr.time = t1
			if done and tr.state == "playing" and not tr.hold then
				tr.state = "stopping"
				tr.isPlaying = false
				tr.wFrom, tr.wTo, tr.fadeT, tr.fadeE = tr.w, 0, tr.fadeOut, 0
				if onEvent ~= nil then
					onEvent(tr, "stopped")
				end
			end
		end
	end
	if tr.fadeE < tr.fadeT then
		local e = tr.fadeE + dt
		if e >= tr.fadeT then
			tr.fadeE = tr.fadeT
			tr.w = tr.wTo
		else
			tr.fadeE = e
			local a = e / tr.fadeT
			tr.w = tr.wFrom + (tr.wTo - tr.wFrom) * (a * a * (3 - 2 * a))
		end
	else
		tr.w = tr.wTo
	end
	if tr.state == "stopping" and tr.w <= 0 then
		tr.state = "ended"
		tr.isPlaying = false
		tr.w = 0
		if onEvent ~= nil then
			onEvent(tr, "ended")
		end
		return true
	end
	return false
end

-- Starts fading a playing track out (fade seconds; default its fadeOut). Returns true if it was playing.
function AnimCore.stop(tr, fade)
	if tr.state ~= "playing" then
		return false
	end
	tr.state = "stopping"
	tr.isPlaying = false
	tr.wFrom, tr.wTo, tr.fadeT, tr.fadeE = tr.w, 0, clampNumber(fade, tr.fadeOut, 0, 10), 0
	return true
end

-- Fades a playing track's weight to `weight` over `fade` seconds (default 0.1, like AnimationTrack:AdjustWeight).
function AnimCore.setWeight(tr, weight, fade)
	if tr.state ~= "playing" then
		return false
	end
	tr.weight = clampNumber(weight, tr.weight, 0, 10)
	tr.wFrom, tr.wTo, tr.fadeT, tr.fadeE = tr.w, tr.weight, clampNumber(fade, 0.1, 0, 10), 0
	return true
end

return AnimCore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Assets</string>
          <string name="Source"><![CDATA[-- Assets: generated art by name. The harness writes ReplicatedStorage.Shared.AssetMap (name -> content id)
-- whenever generate_image produces an image, so code refers to art by name, never by raw id.
--   icon.Image = Assets.image("coin_icon")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Assets = {}
local map = {}
do
	local ok, result = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Shared", 5):WaitForChild("AssetMap", 5))
	end)
	if ok and type(result) == "table" then
		map = result
	end
end

function Assets.image(name, fallback)
	local entry = map[name]
	if type(entry) == "table" then
		return entry.id or fallback or ""
	end
	return entry or fallback or ""
end

-- Slice metadata for 9-slice textures generated with a known border, if the generator recorded one.
function Assets.slice(name)
	local entry = map[name]
	if type(entry) == "table" and entry.slice then
		local s = entry.slice
		return Rect.new(s[1], s[2], s[3], s[4])
	end
	return nil
end

function Assets.has(name)
	return map[name] ~= nil
end

return Assets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">CameraRig</string>
          <string name="Source"><![CDATA[--!native
-- CameraRig: the gameplay camera, authored shots and camera feel (client only). No look of its own: distances,
-- heights, FOVs, speeds and timings come from the caller (the game's style tokens); presets are starting points.
--   local rig = CameraRig.follow({ preset = "shoulder", distance = 9, fov = 70 })    follow + orbit + collision
--   rig:set({ distance = 14 }); rig:switchShoulder(); rig:setAngles(yawDeg, pitchDeg); rig:stop()
--   CameraRig.shot({ from = cfA, to = cfB, duration = 1.2, hold = 0.4, blendOut = 0.6 }):andThen(fn)
--   CameraRig.sequence({ shot1, shot2, shot3 }, { letterbox = true, skipInput = true })   -> handle:skip()
--   CameraRig.kick(8, 0.3)         FOV kick (degrees, seconds)
--   CameraRig.punch(dir, 0.5)      spring kick of the camera along dir (peak displacement in studs)
--   CameraRig.shake(0.4)           trauma through Kit.Shake's shared shaker
--   CameraRig.slowmo(0.25, 0.8)    time-scale beat: CameraRig.timeScale, LocalPlayer attribute "KitTimeScale"
-- Kit.Shake.reduceMotion scales kicks, punches, handheld noise and speed-FOV by CameraRig.reducedMotionScale.
-- Runs in one render step bound just after Enum.RenderPriority.Camera; the camera is Scriptable only while a follow
-- or a shot owns it, and is handed back (type and FOV restored) when they end.
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local FxMath = require(script.Parent:WaitForChild("FxMath"))

local function sibling(name)
	local ok, mod = pcall(function()
		return require(script.Parent:WaitForChild(name, 5))
	end)
	return if ok then mod else nil
end
local Shake = sibling("Shake")
local Debug = sibling("Debug")

local CameraRig = {}
CameraRig.timeScale = 1 -- read by other modules (VFX slows its emitters); 1 = normal speed
CameraRig.reducedMotionScale = 0 -- kicks / punches / handheld / speed-FOV multiplier when Shake.reduceMotion is on
CameraRig.punchSpeed = 16 -- punch spring (angular frequency) and damping ratio
CameraRig.punchDamping = 0.45
CameraRig.punchTilt = math.rad(2) -- rig-owned camera: radians of tilt per stud of punch

local IS_CLIENT = RunService:IsClient()
local STEP_NAME = "KitCameraRig"
local PRIORITY = Enum.RenderPriority.Camera.Value + 1
local MOUSE_RATE = 0.0045 -- radians per pixel at sensitivity 1
local TOUCH_RATE = 0.0085
local STICK_YAW, STICK_PITCH = 3.8, 2.8 -- radians per second at full tilt
local STICK_DEADZONE = 0.15
local TELEPORT = 60 -- the subject moved this far in one frame: snap instead of flying across the map
local SKIP_BLEND = 0.3
local KICK_SLOTS, SLOW_SLOTS = 8, 4
local SCRIPTABLE = Enum.CameraType.Scriptable
local BLEND = FxMath.easeFn("Sine InOut") -- every blend in and out of shots and follows

------------------------------------------------------------------------------------------------ helpers
local warned, warnCount = {}, 0
local function caller()
	for level = 3, 10 do
		local src, line = debug.info(level, "sl")
		if src == nil then
			break
		end
		if src ~= "[C]" and not string.find(src, "^ReplicatedStorage%.Kit%.") then
			return " (" .. src .. ":" .. tostring(line) .. ")"
		end
	end
	return ""
end

local function warnOnce(key, msg)
	if warned[key] or warnCount >= 300 then
		return
	end
	warned[key] = true
	warnCount += 1
	warn("[CameraRig] " .. msg .. caller())
end

local function finite(x)
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local function num(v, default, lo, hi, name)
	if v == nil then
		return default
	end
	if type(v) ~= "number" or v ~= v then
		warnOnce(name .. ":type", name .. " must be a number, got " .. typeof(v))
		return default
	end
	if (lo and v < lo) or (hi and v > hi) then
		warnOnce(name .. ":range", name .. " must be in " .. tostring(lo) .. ".." .. tostring(hi) .. ", got " .. tostring(v))
		return math.clamp(v, lo or v, hi or v)
	end
	return v
end

local function pair(v, default, lo, hi, name)
	if type(v) == "table" then
		return num(v[1], default, lo, hi, name), num(v[2], default, lo, hi, name)
	end
	local x = num(v, default, lo, hi, name)
	return x, x
end

-- Canonical keys (case-insensitive) with a warning, once, for each key CameraRig does not know.
local function normalize(tbl, keys, where)
	if type(tbl) ~= "table" then
		if tbl ~= nil then
			warnOnce(where .. ":type", where .. " options must be a table, got " .. typeof(tbl))
		end
		return {}
	end
	local out, unknown = FxMath.normalizeKeys(tbl, keys)
	for _, u in unknown do
		warnOnce(where .. ":" .. u.key, "unknown " .. where .. " option '" .. u.key .. "'"
			.. (if u.suggestion then " (did you mean '" .. u.suggestion .. "'?)" else ""))
	end
	return out
end

local function toColor(v, default)
	if v == nil then
		return default
	elseif typeof(v) == "Color3" then
		return v
	end
	local r, g, b = FxMath.hex(v)
	if r then
		return Color3.new(r, g, b)
	end
	local name = FxMath.tokenName(v)
	if name then
		local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
		local module = shared and shared:FindFirstChild("Tokens")
		local ok, tokens = false, nil
		if module then
			ok, tokens = pcall(require, module)
		end
		local c = ok and type(tokens) == "table" and type(tokens.color) == "table" and tokens.color[name]
		if typeof(c) == "Color3" then
			return c
		end
	end
	warnOnce("color:" .. tostring(v), "colour must be a Color3, \"#RRGGBB\" or \"Tokens.color.<name>\", got " .. tostring(v))
	return default
end

local function motionScale()
	if Shake and Shake.reduceMotion then
		return CameraRig.reducedMotionScale
	end
	return 1
end

local function safeLookAt(pos, target)
	local d = target - pos
	if d.Magnitude < 1e-4 then
		return CFrame.new(pos)
	end
	if math.abs(d.Unit.Y) > 0.999 then
		return CFrame.lookAt(pos, target, Vector3.zAxis * -1)
	end
	return CFrame.lookAt(pos, target)
end

-- Where a target is right now: Vector3, CFrame, BasePart, Attachment, Humanoid, Model or a function -> Vector3.
local function targetPosition(t)
	local ty = typeof(t)
	if ty == "Vector3" then
		return t
	elseif ty == "CFrame" then
		return t.Position
	elseif ty == "Instance" then
		if t:IsA("BasePart") then
			return t.Position
		elseif t:IsA("Attachment") then
			return t.WorldPosition
		elseif t:IsA("Humanoid") then
			local root = t.RootPart
			return root and root.Position
		elseif t:IsA("Model") then
			local p = t.PrimaryPart
			if p then
				return p.Position
			end
			return t:GetPivot().Position
		end
	elseif ty == "function" then
		local ok, v = pcall(t)
		if ok and typeof(v) == "Vector3" then
			return v
		end
	end
	return nil
end

local function targetFrame(t)
	local ty = typeof(t)
	if ty == "CFrame" then
		return t
	elseif ty == "Vector3" then
		return CFrame.new(t)
	elseif ty == "Instance" then
		if t:IsA("BasePart") then
			return t.CFrame
		elseif t:IsA("Attachment") then
			return t.WorldCFrame
		elseif t:IsA("Humanoid") then
			local root = t.RootPart
			return root and root.CFrame
		elseif t:IsA("Model") then
			return t:GetPivot()
		end
	end
	return nil
end

local userSettings
do
	local ok, s = pcall(function()
		return UserSettings():GetService("UserGameSettings")
	end)
	userSettings = if ok then s else nil
end

-- The player's invert-Y setting (Roblox's settings menu), read at most once a second. (The player's camera
-- sensitivity is already applied by the engine to mouse deltas, so the rig does not scale by it again.)
local invertValue, invertReadAt = false, -math.huge
local function userInvertedY()
	local now = os.clock()
	if now - invertReadAt < 1 then
		return invertValue
	end
	invertReadAt = now
	local ok, v = pcall(function()
		return userSettings:GetCameraYInvertValue()
	end)
	invertValue = ok and v == -1
	return invertValue
end

local function deadzone(x)
	local a = math.abs(x)
	if a < STICK_DEADZONE then
		return 0
	end
	local t = (a - STICK_DEADZONE) / (1 - STICK_DEADZONE)
	return math.sign(x) * t * t
end

------------------------------------------------------------------------------------------------ module state
local F = nil -- the active follow
local S = nil -- the active sequence
local saved = nil -- camera state before the rig took it: { cameraType, fov, cf }
local lastPoseCF, lastPoseFov = nil, nil -- the rig's pose before kicks / punches (where shots start from)
local wroteCF, wroteBaseCF = nil, nil -- effects layered over someone else's camera: what we wrote and its base
local wroteFov, wroteBaseFov = nil, nil
local punchPos, punchVel = Vector3.zero, Vector3.zero
local kickAmount = table.create(KICK_SLOTS, 0)
local kickLen = table.create(KICK_SLOTS, 0)
local kickT = table.create(KICK_SLOTS, 0)
local slowScale = table.create(SLOW_SLOTS, 1)
local slowLen = table.create(SLOW_SLOTS, 0)
local slowT = table.create(SLOW_SLOTS, 0)
local slowIn = table.create(SLOW_SLOTS, 0)
local slowOut = table.create(SLOW_SLOTS, 0)
local slowId = table.create(SLOW_SLOTS, 0)
local nextBeat = 0
local listeners = {}
local bound = false
local step -- forward declaration

-- Runs just before Roblox's camera scripts: if the camera still holds exactly what the rig layered on last frame,
-- put back the pose underneath, so camera scripts that build on the camera's last orientation never see the rig's
-- offsets or blends (no drift, and a blend back to the default camera ends where that camera would be).
local function preStep()
	local cam = workspace.CurrentCamera
	if cam and wroteCF ~= nil and cam.CFrame == wroteCF then
		cam.CFrame = wroteBaseCF
	end
end

local function ensureBound()
	if bound or not IS_CLIENT then
		return
	end
	bound = true
	RunService:BindToRenderStep(STEP_NAME .. "Pre", Enum.RenderPriority.Camera.Value - 1, preStep)
	RunService:BindToRenderStep(STEP_NAME, PRIORITY, step)
end

local function unbind()
	if bound then
		bound = false
		RunService:UnbindFromRenderStep(STEP_NAME)
		RunService:UnbindFromRenderStep(STEP_NAME .. "Pre")
	end
end

-- Someone else's camera: what is there now, unless it is exactly what we wrote last frame (then our base).
local function idleBase(cam)
	local cf = cam.CFrame
	if wroteCF ~= nil and cf == wroteCF then
		cf = wroteBaseCF
	end
	local fov = cam.FieldOfView
	if wroteFov ~= nil and math.abs(fov - wroteFov) < 1e-3 then
		fov = wroteBaseFov
	end
	return cf, fov
end

-- Remembers the camera as the game had it (without any kick the rig layered on) before the rig takes it over.
local function takeCamera(cam)
	if not saved and cam then
		local cf, fov = idleBase(cam)
		saved = { cameraType = cam.CameraType, fov = fov, cf = cf }
	end
end

-- Gives the camera back to Roblox's camera scripts while a blend back is still running: they resume from the view the
-- player had before the rig took over (the pre-step shows them that pose), and the blend eases into their result.
local handBackBase = nil -- the pose the game's camera resumes from, until the step's next write records it
local function handBack()
	local cam = workspace.CurrentCamera
	if not (saved and cam and cam.CameraType == SCRIPTABLE and saved.cameraType ~= SCRIPTABLE) then
		return
	end
	cam.CameraType = saved.cameraType
	local current = cam.CFrame
	wroteCF = current
	wroteBaseCF = CFrame.new(current.Position) * saved.cf.Rotation
	handBackBase = wroteBaseCF
end

local function releaseCamera()
	local cam = workspace.CurrentCamera
	if saved and cam then
		if cam.CameraType == SCRIPTABLE and saved.cameraType ~= SCRIPTABLE then
			cam.CameraType = saved.cameraType
		end
		cam.FieldOfView = saved.fov
	end
	saved = nil
	lastPoseCF, lastPoseFov = nil, nil
end

------------------------------------------------------------------------------------------------ time scale
local function setTimeScale(ts)
	if ts == CameraRig.timeScale then
		return
	end
	CameraRig.timeScale = ts
	local player = Players.LocalPlayer
	if player then
		player:SetAttribute("KitTimeScale", ts)
	end
	for _, fn in listeners do
		local ok, err = pcall(fn, ts)
		if not ok then
			warnOnce("listener:" .. tostring(fn), "time-scale listener failed: " .. tostring(err))
		end
	end
end

-- Calls fn(timeScale) whenever CameraRig.timeScale changes. Returns an object with :Disconnect().
function CameraRig.onTimeScale(fn)
	if type(fn) ~= "function" then
		warnOnce("onTimeScale", "onTimeScale needs a function")
		return { Disconnect = function() end }
	end
	table.insert(listeners, fn)
	return {
		Disconnect = function()
			local i = table.find(listeners, fn)
			if i then
				table.remove(listeners, i)
			end
		end,
	}
end

-- A slow-motion beat: time scale eases to `scale`, holds, and eases back to 1 by `seconds` (real time).
-- opts: { rampIn = s, rampOut = s }. Overlapping beats take the slowest. Returns the beat's id; slowmo(1) clears
-- every beat. Nothing physical changes: other modules read CameraRig.timeScale (or the "KitTimeScale" attribute).
function CameraRig.slowmo(scale, seconds, opts)
	if not IS_CLIENT then
		return nil
	end
	scale = num(scale, 1, 0, 1, "slowmo scale")
	seconds = num(seconds, 0, 0, 60, "slowmo seconds")
	if scale >= 1 or seconds <= 0 then
		for i = 1, SLOW_SLOTS do
			slowLen[i] = 0
		end
		setTimeScale(1)
		return nil
	end
	opts = normalize(opts, FxMath.CAMERA_NESTED_KEYS.slowmo, "slowmo")
	local slot, most = 1, -1
	for i = 1, SLOW_SLOTS do
		if slowLen[i] == 0 then
			slot = i
			break
		end
		local progress = slowT[i] / slowLen[i]
		if progress > most then
			most, slot = progress, i
		end
	end
	nextBeat += 1
	slowId[slot] = nextBeat
	slowScale[slot] = scale
	slowLen[slot] = seconds
	slowT[slot] = 0
	slowIn[slot] = num(opts.rampIn, math.min(0.08, seconds * 0.2), 0, 60, "slowmo rampIn")
	slowOut[slot] = num(opts.rampOut, math.min(0.25, seconds * 0.4), 0, 60, "slowmo rampOut")
	if slowIn[slot] <= 0 then
		setTimeScale(math.min(CameraRig.timeScale, scale))
	end
	ensureBound()
	return nextBeat
end

-- Ends the beats a shot started (not the game's own, such as a hitstop's).
local function stopBeats(ids)
	for _, id in ids do
		for i = 1, SLOW_SLOTS do
			if slowId[i] == id and slowLen[i] > 0 then
				slowLen[i] = 0
				ensureBound() -- the next step recomputes the time scale
			end
		end
	end
end

local function stepSlowmo(dt)
	local ts, active = 1, false
	for i = 1, SLOW_SLOTS do
		local len = slowLen[i]
		if len > 0 then
			if slowT[i] >= len then
				slowLen[i] = 0
			else
				active = true
				ts = math.min(ts, FxMath.slowmoScale(slowT[i], slowScale[i], len, slowIn[i], slowOut[i]))
				slowT[i] += dt
			end
		end
	end
	setTimeScale(ts)
	return active
end

------------------------------------------------------------------------------------------------ kicks, punches, shake
-- FOV kick: adds fovDelta degrees with a quick rise and a smooth return over `seconds`. Kicks add up.
function CameraRig.kick(fovDelta, seconds)
	if not IS_CLIENT then
		return
	end
	if not finite(fovDelta) then
		warnOnce("kick", "kick(fovDelta, seconds) needs a number of degrees")
		return
	end
	seconds = num(seconds, 0.25, 0.02, 5, "kick seconds")
	local slot, most = 1, -1
	for i = 1, KICK_SLOTS do
		if kickLen[i] == 0 then
			slot = i
			break
		end
		local progress = kickT[i] / kickLen[i]
		if progress > most then
			most, slot = progress, i
		end
	end
	if math.abs(fovDelta) > 60 then
		warnOnce("kick:range", "kick fovDelta is limited to +-60 degrees, got " .. tostring(fovDelta))
	end
	kickAmount[slot] = math.clamp(fovDelta, -60, 60)
	kickLen[slot] = seconds
	kickT[slot] = 0
	ensureBound()
end

local function stepKicks(dt)
	local sum, active = 0, false
	for i = 1, KICK_SLOTS do
		local len = kickLen[i]
		if len > 0 then
			local t = kickT[i]
			if t >= len then
				kickLen[i] = 0
			else
				active = true
				sum += kickAmount[i] * FxMath.kickEnvelope(t, len)
				kickT[i] = t + dt
			end
		end
	end
	return sum, active
end

local function punchSpeed()
	local v = CameraRig.punchSpeed
	return if finite(v) then math.clamp(v, 1, 100) else 16
end

local function punchDamping()
	local v = CameraRig.punchDamping
	return if finite(v) then math.clamp(v, 0.05, 4) else 0.45
end

-- Positional kick along `direction` (world space), springing back; strength = peak displacement in studs.
function CameraRig.punch(direction, strength)
	if not IS_CLIENT then
		return
	end
	if typeof(direction) ~= "Vector3" then
		warnOnce("punch", "punch(direction, strength) needs a Vector3 direction")
		return
	end
	if not (direction.Magnitude > 1e-6 and direction.Magnitude < math.huge) then
		return
	end
	local peak = num(strength, 0.5, 0, 50, "punch strength")
	punchVel += direction.Unit * FxMath.impulseForPeak(peak, punchSpeed(), punchDamping())
	ensureBound()
end

local function stepPunch(dt)
	if punchPos == Vector3.zero and punchVel == Vector3.zero then
		return false
	end
	punchPos, punchVel = FxMath.springStep(punchPos, punchVel, Vector3.zero, punchSpeed(), punchDamping(), dt)
	if punchPos.Magnitude < 1e-3 and punchVel.Magnitude < 1e-2 then
		punchPos, punchVel = Vector3.zero, Vector3.zero
	end
	return true
end

local function applyPunch(cf, ms, rotate)
	if ms == 0 or punchPos == Vector3.zero then
		return cf
	end
	local offset = punchPos * ms
	local out = cf + offset
	if rotate then
		local tilt = CameraRig.punchTilt
		out = out * CFrame.Angles(cf.UpVector:Dot(offset) * tilt, -cf.RightVector:Dot(offset) * tilt, 0)
	end
	return out
end

-- Trauma shake (0..1) through Kit.Shake's shared shaker, which already honours Shake.reduceMotion.
function CameraRig.shake(trauma)
	if not finite(trauma) then
		warnOnce("shake", "shake(trauma) needs a number from 0 to 1")
		return
	end
	if trauma < 0 or trauma > 1 then
		warnOnce("shake:range", "shake trauma is 0..1, got " .. tostring(trauma))
	end
	if Shake then
		Shake.kick(math.clamp(trauma, 0, 1))
	end
end

------------------------------------------------------------------------------------------------ follow
-- Starting points per genre; every value can be overridden, and set({preset = ...}) switches between them.
local PRESETS = {
	shoulder = { distance = 7, height = 1.6, offset = Vector3.new(2, 0.4, 0), fov = 70, pitch = -6, pitchMin = -70,
		pitchMax = 70, orbit = "free", rotSpeed = 0, collision = true, lookAhead = 0 },
	overTheTop = { distance = 16, height = 2, offset = Vector3.new(0, 1, 0), fov = 70, pitch = -30, pitchMin = -75,
		pitchMax = 10, orbit = "drag", rotSpeed = 0, collision = true, lookAhead = 2 },
	sideScroller = { distance = 30, height = 2, offset = Vector3.new(0, 1, 0), fov = 45, yaw = 0, pitch = -4,
		orbit = "locked", rotSpeed = 6, collision = false, lookAhead = 6, fadeSubject = false },
	topDown = { distance = 48, height = 0, offset = Vector3.zero, fov = 40, yaw = 0, pitch = -70, orbit = "locked",
		rotSpeed = 6, collision = false, lookAhead = 4, fadeSubject = false },
}
local PRESET_ALIAS = { shoulder = "shoulder", overshoulder = "shoulder", overtheshoulder = "shoulder",
	overthetop = "overTheTop", chase = "overTheTop", third = "overTheTop", thirdperson = "overTheTop",
	sidescroller = "sideScroller", side = "sideScroller", topdown = "topDown", top = "topDown" }
local DEFAULTS = { distance = 12, height = 2, offset = Vector3.zero, fov = 70, pitch = -15, pitchMin = -75,
	pitchMax = 60, orbit = "drag", invertY = false, speed = 14, damping = 1, rotSpeed = 0, zoomSpeed = 8,
	lookAhead = 0, lookAheadSpeed = 24, lookAheadRate = 3, collision = true, collisionRadius = 0.6, minDistance = 1,
	returnSpeed = 5, shoulder = 1, fadeSubject = 3, blend = 0.35, input = true }

local function presetName(p)
	if type(p) ~= "string" then
		return nil
	end
	return PRESET_ALIAS[string.lower((string.gsub(p, "[^%a]", "")))]
end

local function resolveConfig(user)
	local raw = table.clone(DEFAULTS)
	if user.preset ~= nil then
		local name = presetName(user.preset)
		if name then
			for k, v in PRESETS[name] do
				raw[k] = v
			end
		else
			warnOnce("preset:" .. tostring(user.preset), "unknown camera preset '" .. tostring(user.preset)
				.. "' (shoulder, overTheTop, sideScroller, topDown)")
		end
	end
	for k, v in user do
		raw[k] = v
	end
	local c = {}
	c.subject = raw.subject
	c.distance = num(raw.distance, 12, 0, 2000, "distance")
	c.height = num(raw.height, 2, -1000, 1000, "height")
	if typeof(raw.offset) == "Vector3" then
		c.offset = raw.offset
	elseif type(raw.offset) == "number" then
		c.offset = Vector3.new(raw.offset, 0, 0)
	else
		if raw.offset ~= nil then
			warnOnce("offset", "offset must be a Vector3 (right, up, 0) or a number (right)")
		end
		c.offset = Vector3.zero
	end
	c.fov = num(raw.fov, 70, 1, 120, "fov")
	c.pitchMin = num(raw.pitchMin, -75, -89, 89, "pitchMin")
	c.pitchMax = num(raw.pitchMax, 60, -89, 89, "pitchMax")
	if c.pitchMin > c.pitchMax then
		c.pitchMin, c.pitchMax = c.pitchMax, c.pitchMin
	end
	c.pitch = math.clamp(num(raw.pitch, -15, -89, 89, "pitch"), c.pitchMin, c.pitchMax)
	c.yaw = if raw.yaw ~= nil then num(raw.yaw, 0, -100000, 100000, "yaw") else nil
	c.orbit = FxMath.enumValue(raw.orbit, { "free", "drag", "locked" })
	if not c.orbit then
		warnOnce("orbit:" .. tostring(raw.orbit), "orbit must be \"free\", \"drag\" or \"locked\"")
		c.orbit = "drag"
	end
	local sens = raw.sensitivity
	if type(sens) == "table" then
		sens = normalize(sens, FxMath.CAMERA_NESTED_KEYS.sensitivity, "sensitivity")
		c.sens = { mouse = num(sens.mouse, 1, 0, 20, "sensitivity.mouse"), touch = num(sens.touch, 1, 0, 20,
			"sensitivity.touch"), gamepad = num(sens.gamepad, 1, 0, 20, "sensitivity.gamepad") }
	else
		local k = num(sens, 1, 0, 20, "sensitivity")
		c.sens = { mouse = k, touch = k, gamepad = k }
	end
	c.invertY = raw.invertY == true
	c.speed = num(raw.speed, 14, 0.01, 200, "speed")
	c.damping = num(raw.damping, 1, 0.05, 10, "damping")
	c.verticalSpeed = num(raw.verticalSpeed, c.speed, 0.01, 200, "verticalSpeed")
	c.verticalLag = raw.verticalSpeed ~= nil and c.verticalSpeed < c.speed
	c.rotSpeed = num(raw.rotSpeed, 0, 0, 200, "rotSpeed")
	c.zoomSpeed = num(raw.zoomSpeed, 8, 0.01, 200, "zoomSpeed")
	c.lookAhead = num(raw.lookAhead, 0, 0, 200, "lookAhead")
	c.lookAheadSpeed = num(raw.lookAheadSpeed, 24, 0.01, 10000, "lookAheadSpeed")
	c.lookAheadRate = num(raw.lookAheadRate, 3, 0.01, 100, "lookAheadRate")
	c.collision = raw.collision ~= false
	c.collisionRadius = num(raw.collisionRadius, 0.6, 0, 20, "collisionRadius")
	c.minDistance = num(raw.minDistance, 1, 0, 1000, "minDistance")
	c.returnSpeed = num(raw.returnSpeed, 5, 0.01, 200, "returnSpeed")
	c.shoulder = if num(raw.shoulder, 1, -1, 1, "shoulder") < 0 then -1 else 1
	c.shoulderKey = if typeof(raw.shoulderKey) == "EnumItem" then raw.shoulderKey else nil
	c.input = raw.input ~= false
	c.blend = num(raw.blend, 0.35, 0, 30, "blend")
	c.fadeSubject = if raw.fadeSubject == false then nil else num(if raw.fadeSubject == true then 3 else raw.fadeSubject,
		3, 0, 100, "fadeSubject")
	c.ignore = {}
	if type(raw.ignore) == "table" then
		for _, x in raw.ignore do
			if typeof(x) == "Instance" then
				table.insert(c.ignore, x)
			end
		end
	end
	if type(raw.speedFov) == "table" then
		local s = normalize(raw.speedFov, FxMath.CAMERA_NESTED_KEYS.speedFov, "speedFov")
		c.speedFov = { from = num(s.from, 16, 0, 10000, "speedFov.from"), to = num(s.to, 48, 0, 10000, "speedFov.to"),
			fov = num(s.fov, 0, -60, 60, "speedFov.fov"), pull = num(s.pull, 0, -1000, 1000, "speedFov.pull") }
	end
	if raw.autoAlign ~= nil and raw.autoAlign ~= false then
		if type(raw.autoAlign) == "table" then
			local a = normalize(raw.autoAlign, FxMath.CAMERA_NESTED_KEYS.autoAlign, "autoAlign")
			c.autoAlign = { delay = num(a.delay, 1.2, 0, 60, "autoAlign.delay"), speed = num(a.speed, 2.5, 0.01, 50,
				"autoAlign.speed") }
		else
			c.autoAlign = { delay = num(if raw.autoAlign == true then 1.2 else raw.autoAlign, 1.2, 0, 60, "autoAlign"),
				speed = 2.5 }
		end
	end
	if type(raw.zoom) == "table" then
		local z = normalize(raw.zoom, FxMath.CAMERA_NESTED_KEYS.zoom, "zoom")
		local lo = num(z.min, c.distance * 0.5, 0, 2000, "zoom.min")
		local hi = num(z.max, c.distance * 2, 0, 2000, "zoom.max")
		c.zoom = { min = math.min(lo, hi), max = math.max(lo, hi), step = num(z.step, 2, 0, 1000, "zoom.step") }
	end
	return c
end

local inp = { dx = 0, dy = 0, tdx = 0, tdy = 0, stickX = 0, stickY = 0, rmb = false, touch = nil, zoom = 0, last = 0 }
local inputConns = {}
local mouseOwned = nil -- the MouseBehavior the rig last set (nil = the rig does not own the mouse)

local function setMouse(behavior)
	if UserInputService.MouseBehavior ~= behavior then
		UserInputService.MouseBehavior = behavior
	end
	mouseOwned = behavior
end

local function releaseMouse()
	if mouseOwned ~= nil then
		if UserInputService.MouseBehavior == mouseOwned then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		mouseOwned = nil
	end
end

local THUMBSTICKS = { "DynamicThumbstickFrame", "ThumbstickFrame" }
local function inThumbstickArea(pos)
	local player = Players.LocalPlayer
	local pg = player and player:FindFirstChildOfClass("PlayerGui")
	local touchGui = pg and pg:FindFirstChild("TouchGui")
	local frame = touchGui and touchGui:FindFirstChild("TouchControlFrame")
	if not frame then
		return false
	end
	for _, name in THUMBSTICKS do
		local stick = frame:FindFirstChild(name)
		if stick and stick:IsA("GuiObject") and stick.Visible then
			local p0, size = stick.AbsolutePosition, stick.AbsoluteSize
			if pos.X >= p0.X and pos.Y >= p0.Y and pos.X <= p0.X + size.X and pos.Y <= p0.Y + size.Y then
				return true
			end
		end
	end
	return false
end

local FollowHandle = {}
FollowHandle.__index = FollowHandle

local function connectInput()
	if #inputConns > 0 then
		return
	end
	table.insert(inputConns, UserInputService.InputBegan:Connect(function(io, processed)
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton2 and not processed then
			inp.rmb = true
		elseif t == Enum.UserInputType.Touch and not processed and inp.touch == nil
			and not inThumbstickArea(io.Position) then
			inp.touch = io
		elseif F and F.cfg.shoulderKey and io.KeyCode == F.cfg.shoulderKey and not processed then
			F.handle:switchShoulder()
		end
	end))
	table.insert(inputConns, UserInputService.InputChanged:Connect(function(io, processed)
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseMovement then
			if F and (F.cfg.orbit == "free" or inp.rmb) then
				inp.dx += io.Delta.X
				inp.dy += io.Delta.Y
			end
		elseif t == Enum.UserInputType.Touch then
			if io == inp.touch then
				inp.tdx += io.Delta.X
				inp.tdy += io.Delta.Y
			end
		elseif t == Enum.UserInputType.MouseWheel then
			if not processed then
				inp.zoom -= io.Position.Z
			end
		elseif io.KeyCode == Enum.KeyCode.Thumbstick2 then
			inp.stickX, inp.stickY = io.Position.X, io.Position.Y
		end
	end))
	table.insert(inputConns, UserInputService.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton2 then
			inp.rmb = false
		elseif io == inp.touch then
			inp.touch = nil
		elseif io.KeyCode == Enum.KeyCode.Thumbstick2 then
			inp.stickX, inp.stickY = 0, 0
		end
	end))
end

local function disconnectInput()
	for _, c in inputConns do
		c:Disconnect()
	end
	table.clear(inputConns)
	inp.dx, inp.dy, inp.tdx, inp.tdy, inp.zoom = 0, 0, 0, 0, 0
	inp.stickX, inp.stickY, inp.rmb, inp.touch = 0, 0, false, nil
	releaseMouse()
end

local function setFade(f, value)
	f.fade = value
	if not f.fadeParts then
		f.fadeParts = {}
		if f.character then
			for _, d in f.character:GetDescendants() do
				if d:IsA("BasePart") or d:IsA("Decal") then
					table.insert(f.fadeParts, d)
				end
			end
		end
	end
	for _, p in f.fadeParts do
		p.LocalTransparencyModifier = value
	end
end

local function resolveSubject(f)
	local s = f.cfg.subject
	if f.fade ~= 0 then
		setFade(f, 0)
	end
	f.part, f.attach, f.fn, f.vec, f.character, f.localCharacter = nil, nil, nil, nil, nil, false
	f.fadeParts = nil
	if s == nil or s == false then
		f.localCharacter = true
		local player = Players.LocalPlayer
		local ch = player and player.Character
		if ch then
			local hum = ch:FindFirstChildOfClass("Humanoid")
			f.part = (hum and hum.RootPart) or ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
			f.character = ch
		end
	elseif type(s) == "function" then
		f.fn = s
	elseif typeof(s) == "Vector3" then
		f.vec = s
	elseif typeof(s) == "Instance" then
		if s:IsA("Humanoid") then
			f.part, f.character = s.RootPart, s.Parent
		elseif s:IsA("BasePart") then
			f.part = s
			local model = s:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then
				f.character = model
			end
		elseif s:IsA("Model") then
			local hum = s:FindFirstChildOfClass("Humanoid")
			f.part = (hum and hum.RootPart) or s.PrimaryPart or s:FindFirstChildWhichIsA("BasePart", true)
			f.character = s
		elseif s:IsA("Attachment") then
			f.attach = s
		else
			warnOnce("subject:" .. s.ClassName, "subject must be a Humanoid, BasePart, Model, Attachment, Vector3 or function")
		end
	else
		warnOnce("subject:" .. typeof(s), "subject must be a Humanoid, BasePart, Model, Attachment, Vector3 or function")
	end
	local filter = {}
	if f.character then
		table.insert(filter, f.character)
	elseif f.part then
		table.insert(filter, f.part)
	elseif f.attach then
		local holder = f.attach.Parent
		local model = holder and holder:FindFirstAncestorOfClass("Model")
		if model or holder then
			table.insert(filter, model or holder) -- what the attachment rides on (a vehicle) never blocks the view
		end
	end
	for _, x in f.cfg.ignore do
		table.insert(filter, x)
	end
	f.params.FilterDescendantsInstances = filter
	f.fade = -1 -- write the subject's transparency once (first person may have left it hidden)
end

local function needsResolve(f)
	if f.fn or f.vec then
		return false
	elseif f.attach then
		return f.attach.Parent == nil
	elseif f.part == nil or f.part.Parent == nil then
		return true
	elseif f.localCharacter then
		local player = Players.LocalPlayer
		return player ~= nil and player.Character ~= f.character
	end
	return false
end

local function finiteVector(v)
	return typeof(v) == "Vector3" and finite(v.X) and finite(v.Y) and finite(v.Z)
end

local function subjectPosition(f)
	if f.fn then
		local ok, p = pcall(f.fn)
		if ok and finiteVector(p) then
			return p, nil
		end
		warnOnce("subjectfn", "a subject function must return a finite Vector3")
		return nil, nil
	elseif f.vec then
		return f.vec, Vector3.zero
	elseif f.attach then
		local p = f.attach.WorldPosition
		return if finiteVector(p) then p else nil, nil
	end
	local part = f.part
	if part and part.Parent then
		local p = part.Position
		if not finiteVector(p) then
			return nil, nil
		end
		if part.Anchored then
			return p, nil
		end
		local v = part.AssemblyLinearVelocity
		return p, if finiteVector(v) then v else nil
	end
	return nil, nil
end

local hasSpherecast = nil
local function cast(origin, direction, radius, params)
	if hasSpherecast == nil then
		hasSpherecast = pcall(function()
			return workspace.Spherecast
		end)
	end
	local length = direction.Magnitude
	if length > 1000 then -- shape casts travel at most 1024 studs
		direction = direction * (1000 / length)
	end
	if hasSpherecast and radius > 0 then
		local ok, result = pcall(workspace.Spherecast, workspace, origin, math.min(radius, 256), direction, params)
		if ok then
			return result, true
		end
	end
	return workspace:Raycast(origin, direction, params), false
end

local function snapFollow(f, pos)
	local cfg = f.cfg
	local goal = pos + Vector3.new(0, cfg.height, 0)
	f.focusXZ, f.velXZ = Vector3.new(goal.X, 0, goal.Z), Vector3.zero
	f.focusY, f.velY = goal.Y, 0
	f.goalXZ, f.goalY = f.focusXZ, f.focusY
	f.look, f.lookVel = Vector3.zero, Vector3.zero
	f.dist, f.distVel = cfg.distance + f.zoomOffset, 0
	f.collDist = f.dist
	f.fov, f.fovVel = cfg.fov, 0
	f.side, f.sideVel = cfg.shoulder, 0
	f.vel = Vector3.zero
end

local function stepFollow(f, dt, cam, allowInput)
	local cfg = f.cfg
	local fresh = f.freshSubject == true
	f.freshSubject = false
	if needsResolve(f) and os.clock() >= (f.nextResolve or 0) then
		resolveSubject(f)
		fresh = true
		f.nextResolve = os.clock() + 0.2
	end
	local pos, measured = subjectPosition(f)
	if not pos then
		releaseMouse()
		return f.cf, f.outFov, f.focus
	end
	if not f.started or (f.lastPos and (pos - f.lastPos).Magnitude > TELEPORT) then
		-- first frame, or a respawn / teleport far away: cut instead of flying across the map
		snapFollow(f, pos)
		f.started = true
	elseif measured == nil and f.lastPos and dt > 0 and not fresh then
		f.vel += ((pos - f.lastPos) / dt - f.vel) * FxMath.alpha(12, dt)
	end
	if measured ~= nil then
		f.vel = measured
	elseif fresh then
		f.vel = Vector3.zero
	end
	local vel = f.vel
	f.lastPos = pos

	-- orbit input
	local useInput = allowInput and cfg.input and cfg.orbit ~= "locked"
	if useInput then
		if cfg.orbit == "free" then
			setMouse(Enum.MouseBehavior.LockCenter)
		elseif inp.rmb then
			setMouse(Enum.MouseBehavior.LockCurrentPosition)
		else
			releaseMouse()
		end
		local mouseK = MOUSE_RATE * cfg.sens.mouse
		local touchK = TOUCH_RATE * cfg.sens.touch
		local yawIn = -(inp.dx * mouseK + inp.tdx * touchK) - deadzone(inp.stickX) * STICK_YAW * cfg.sens.gamepad * dt
		local pitchIn = -(inp.dy * mouseK + inp.tdy * touchK) + deadzone(inp.stickY) * STICK_PITCH * cfg.sens.gamepad * dt
		if cfg.invertY ~= userInvertedY() then
			pitchIn = -pitchIn
		end
		if yawIn ~= 0 or pitchIn ~= 0 then
			inp.last = os.clock()
		end
		f.yawGoal += yawIn
		f.pitchGoal += pitchIn
		if cfg.zoom and inp.zoom ~= 0 then
			f.zoomOffset = math.clamp(f.zoomOffset + inp.zoom * cfg.zoom.step, cfg.zoom.min - cfg.distance,
				cfg.zoom.max - cfg.distance)
		end
	else
		releaseMouse()
	end
	inp.dx, inp.dy, inp.tdx, inp.tdy, inp.zoom = 0, 0, 0, 0, 0
	if cfg.orbit == "locked" then
		f.yawGoal = if cfg.yaw then math.rad(cfg.yaw) else f.lockedYaw
		f.pitchGoal = math.rad(cfg.pitch)
	end
	f.pitchGoal = math.clamp(f.pitchGoal, math.rad(cfg.pitchMin), math.rad(cfg.pitchMax))
	local hv = Vector3.new(vel.X, 0, vel.Z)
	local hs = hv.Magnitude
	if cfg.autoAlign and cfg.orbit ~= "locked" and hs > 2 and os.clock() - inp.last > cfg.autoAlign.delay then
		local moveYaw = math.atan2(-hv.X, -hv.Z)
		f.yawGoal = FxMath.dampAngle(f.yawGoal, moveYaw, cfg.autoAlign.speed * math.min(hs / 16, 1), dt)
	end
	if cfg.rotSpeed > 0 then
		f.yaw = FxMath.dampAngle(f.yaw, f.yawGoal, cfg.rotSpeed, dt)
		f.pitch = FxMath.damp(f.pitch, f.pitchGoal, cfg.rotSpeed, dt)
	else
		f.yaw, f.pitch = f.yawGoal, f.pitchGoal
	end
	local rot = CFrame.fromEulerAnglesYXZ(f.pitch, f.yaw, 0)

	-- look-ahead: lead room in the direction of travel, on the screen plane
	local lookGoal = Vector3.zero
	if cfg.lookAhead > 0 and hs > 0.5 then
		local lv = rot.LookVector
		local dir = hv / hs
		dir -= lv * dir:Dot(lv)
		lookGoal = dir * (cfg.lookAhead * math.min(hs / cfg.lookAheadSpeed, 1))
	end
	f.look, f.lookVel = FxMath.springStep(f.look, f.lookVel, lookGoal, cfg.lookAheadRate, 1, dt)

	-- focus: springs in the frame moving with the subject. Each step starts from where the goal was and moves with the
	-- subject's velocity, so constant speed never lags; only motion the velocity does not explain (starts, stops,
	-- turns, jumps in the goal) is smoothed. A softer verticalSpeed also drops the vertical velocity, so jumps lag.
	local goal = pos + Vector3.new(0, cfg.height, 0) + f.look
	local a, b, c, d = FxMath.springCoefficients(cfg.speed, cfg.damping, dt)
	local gxz = Vector3.new(goal.X, 0, goal.Z)
	local vxz = Vector3.new(vel.X, 0, vel.Z)
	local exz, rxz = f.focusXZ - f.goalXZ, f.velXZ - vxz
	f.focusXZ = f.goalXZ + vxz * dt + exz * a + rxz * b
	f.velXZ = vxz + exz * c + rxz * d
	f.goalXZ = gxz
	local vy = if cfg.verticalLag then 0 else vel.Y
	if cfg.verticalSpeed ~= cfg.speed then
		a, b, c, d = FxMath.springCoefficients(cfg.verticalSpeed, cfg.damping, dt)
	end
	local ey, ry = f.focusY - f.goalY, f.velY - vy
	f.focusY = f.goalY + vy * dt + ey * a + ry * b
	f.velY = vy + ey * c + ry * d
	f.goalY = goal.Y
	local focus = Vector3.new(f.focusXZ.X, f.focusY, f.focusXZ.Z)

	-- distance, FOV and shoulder side ease together; speed widens the FOV and pulls back
	local k = 0
	if cfg.speedFov then
		k = FxMath.smoothstep(cfg.speedFov.from, cfg.speedFov.to, hs) * motionScale()
	end
	local distGoal = cfg.distance + f.zoomOffset + (if cfg.speedFov then cfg.speedFov.pull * k else 0)
	local fovGoal = cfg.fov + (if cfg.speedFov then cfg.speedFov.fov * k else 0)
	a, b, c, d = FxMath.springCoefficients(cfg.zoomSpeed, 1, dt)
	local e = f.dist - distGoal
	f.dist, f.distVel = distGoal + e * a + f.distVel * b, e * c + f.distVel * d
	e = f.fov - fovGoal
	f.fov, f.fovVel = fovGoal + e * a + f.fovVel * b, e * c + f.fovVel * d
	e = f.side - cfg.shoulder
	f.side, f.sideVel = cfg.shoulder + e * a + f.sideVel * b, e * c + f.sideVel * d

	-- pivot beside the subject (shoulder), then back along the view; pull in before geometry
	local off = cfg.offset
	local pivot = focus + rot:VectorToWorldSpace(Vector3.new(off.X * f.side, off.Y, 0))
	local back = -rot.LookVector
	local want = math.max(f.dist, 0)
	local camDist = want
	if cfg.collision then
		local side = pivot - focus
		local sideLen = side.Magnitude
		if sideLen > 1e-3 then
			local hit, sphere = cast(focus, side, cfg.collisionRadius, f.params)
			if hit then
				local allowed = if sphere then hit.Distance else hit.Distance - cfg.collisionRadius
				pivot = focus + side * (math.clamp(allowed, 0, sideLen) / sideLen)
			end
		end
		local allowed = want
		if want > 1e-3 then
			local hit, sphere = cast(pivot, back * want, cfg.collisionRadius, f.params)
			if hit then
				allowed = math.clamp(if sphere then hit.Distance else hit.Distance - cfg.collisionRadius, cfg.minDistance, want)
			end
		end
		f.collDist = FxMath.collisionDistance(f.collDist, allowed, cfg.returnSpeed, dt)
		camDist = math.min(want, f.collDist)
	else
		f.collDist = want
	end
	local cf = CFrame.new(pivot + back * camDist) * rot
	local fov = f.fov
	if f.blendDur > 0 and f.blendT < f.blendDur then
		f.blendT += dt
		local w = BLEND(f.blendT / f.blendDur)
		cf = f.blendFrom:Lerp(cf, w)
		fov = f.blendFromFov + (fov - f.blendFromFov) * w
	end
	if f.character and (cfg.fadeSubject or f.fade < 0) then
		-- see-through when the camera is pulled in close; never during shots (their camera is elsewhere)
		local fadeGoal = 0
		if cfg.fadeSubject and S == nil then
			fadeGoal = math.clamp((cfg.fadeSubject - camDist) / math.max(cfg.fadeSubject * 0.5, 0.01), 0, 1)
		end
		if math.abs(fadeGoal - f.fade) > 0.02 or (fadeGoal ~= f.fade and (fadeGoal == 0 or fadeGoal == 1)) then
			setFade(f, fadeGoal)
		end
	end
	f.cf, f.outFov, f.focus = cf, fov, focus
	return cf, fov, focus
end

local function stopFollow(f, release)
	if F ~= f then
		return
	end
	F = nil
	if f.fade ~= 0 then
		setFade(f, 0)
	end
	disconnectInput()
	if S ~= nil and S.phase == "out" then
		handBack() -- a shot was blending back to this follow: blend into the game's camera instead
	elseif release and S == nil then
		releaseCamera()
	end
end

-- Starts following the local character (or opts.subject) and returns a handle. Options (all optional):
-- preset ("shoulder" | "overTheTop" | "sideScroller" | "topDown"), subject, distance, height, offset (Vector3: right,
-- up), fov, yaw, pitch, pitchMin, pitchMax (degrees), orbit ("free" mouse-lock | "drag" hold right mouse / touch |
-- "locked"), sensitivity (number or {mouse, touch, gamepad}), invertY, speed, damping, verticalSpeed, rotSpeed,
-- zoomSpeed, lookAhead (studs), lookAheadSpeed, lookAheadRate, collision, collisionRadius, minDistance, returnSpeed,
-- speedFov ({from, to, fov, pull}), autoAlign (seconds or {delay, speed}), shoulder (1 | -1), shoulderKey,
-- zoom ({min, max, step}), ignore ({Instance}), fadeSubject (studs or false), blend (seconds), input (bool).
function CameraRig.follow(opts)
	if not IS_CLIENT then
		warnOnce("follow:server", "follow runs on the client only")
		return setmetatable({ _dead = true }, FollowHandle)
	end
	local user = normalize(opts or {}, FxMath.FOLLOW_KEYS, "follow")
	if F then
		stopFollow(F, false)
	end
	local cam = workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true
	end)
	local handle = setmetatable({}, FollowHandle)
	local f = { handle = handle, user = user, cfg = resolveConfig(user), params = params, zoomOffset = 0, fade = 0,
		vel = Vector3.zero, started = false, blendT = 0, blendDur = 0 }
	handle._state = f
	local lv = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
	local camYaw = FxMath.yawPitch(lv.X, lv.Y, lv.Z)
	f.yaw = if f.cfg.yaw then math.rad(f.cfg.yaw) else camYaw
	f.pitch = math.rad(f.cfg.pitch)
	f.yawGoal, f.pitchGoal, f.lockedYaw = f.yaw, f.pitch, f.yaw
	if cam and f.cfg.blend > 0 and S == nil then
		f.blendFrom, f.blendFromFov, f.blendDur = lastPoseCF or cam.CFrame, lastPoseFov or cam.FieldOfView, f.cfg.blend
	end
	resolveSubject(f)
	F = f
	connectInput()
	ensureBound()
	if Debug then
		Debug.event("camera_follow", { preset = tostring(user.preset or "custom"), distance = f.cfg.distance,
			fov = f.cfg.fov })
	end
	return handle
end

-- Changes options while following. Setting preset starts from that preset again (keeping subject, ignore, input,
-- sensitivity, invertY and shoulderKey); other options merge into the current ones and ease in.
function FollowHandle:set(opts)
	local f = self._state
	if not f or F ~= f then
		return self
	end
	local changes = normalize(opts or {}, FxMath.FOLLOW_KEYS, "follow")
	if changes.preset ~= nil then
		local u = f.user
		f.user = { subject = u.subject, ignore = u.ignore, input = u.input, sensitivity = u.sensitivity,
			invertY = u.invertY, shoulderKey = u.shoulderKey }
	end
	for k, v in changes do
		f.user[k] = v
	end
	local oldSubject = f.cfg.subject
	f.cfg = resolveConfig(f.user)
	if f.cfg.subject ~= oldSubject or changes.ignore ~= nil then
		resolveSubject(f)
		f.freshSubject = true
	end
	if changes.yaw ~= nil or changes.preset ~= nil then
		if f.cfg.yaw then
			f.yawGoal = math.rad(f.cfg.yaw)
			f.lockedYaw = f.yawGoal
		end
	end
	if changes.pitch ~= nil or changes.preset ~= nil then
		f.pitchGoal = math.rad(f.cfg.pitch)
	end
	return self
end

-- Points the camera (degrees); instant = true skips the smoothing.
function FollowHandle:setAngles(yawDeg, pitchDeg, instant)
	local f = self._state
	if not f or F ~= f then
		return self
	end
	if finite(yawDeg) then
		f.yawGoal = math.rad(yawDeg)
		f.lockedYaw = f.yawGoal
		if instant then
			f.yaw = f.yawGoal
		end
	end
	if finite(pitchDeg) then
		f.pitchGoal = math.rad(pitchDeg)
		if instant then
			f.pitch = math.clamp(f.pitchGoal, math.rad(f.cfg.pitchMin), math.rad(f.cfg.pitchMax))
		end
	end
	return self
end

-- Moves the camera to the other shoulder (or to `side`: 1 right, -1 left), easing across.
function FollowHandle:switchShoulder(side)
	local f = self._state
	if not f or F ~= f then
		return self
	end
	local s = if type(side) == "number" then (if side < 0 then -1 else 1) else -f.cfg.shoulder
	f.user.shoulder = s
	f.cfg.shoulder = s
	return self
end

-- The rig's current numbers (for debugging and tests).
function FollowHandle:state()
	local f = self._state
	if not f then
		return nil
	end
	return { active = F == f, cframe = f.cf, fov = f.outFov, focus = f.focus, distance = f.dist,
		yaw = math.deg(f.yaw or 0), pitch = math.deg(f.pitch or 0), speed = f.vel and f.vel.Magnitude or 0 }
end

-- Stops following and hands the camera back (type and FOV as they were), unless a shot is playing.
function FollowHandle:stop()
	local f = self._state
	if f then
		stopFollow(f, true)
	end
end
FollowHandle.Destroy = FollowHandle.stop

-- The active follow handle, if any.
function CameraRig.current()
	return F and F.handle or nil
end

------------------------------------------------------------------------------------------------ shots
local ShotHandle = {}
ShotHandle.__index = ShotHandle

local function newShotHandle()
	return setmetatable({ status = "playing", done = false, _waiters = {}, _threads = {} }, ShotHandle)
end

-- Callbacks and awaiting threads run deferred, after the rig's own state is settled (a callback may start the
-- next shot).
local function settle(h, status)
	if h.done then
		return
	end
	h.done = true
	h.status = status
	for _, fn in h._waiters do
		task.defer(fn, status)
	end
	for _, co in h._threads do
		task.defer(function()
			if coroutine.status(co) == "suspended" then
				task.spawn(co, status)
			end
		end)
	end
	h._waiters, h._threads = {}, {}
end

-- Calls fn(status) when the shot or sequence ends: "done", "skipped", "cancelled" or "interrupted".
function ShotHandle:andThen(fn)
	if type(fn) ~= "function" then
		return self
	end
	if self.done then
		task.defer(fn, self.status)
	else
		table.insert(self._waiters, fn)
	end
	return self
end

-- Yields until the shot or sequence ends; returns its status.
function ShotHandle:await()
	if self.done then
		return self.status
	end
	table.insert(self._threads, coroutine.running())
	return coroutine.yield()
end

local finishSequence, beginOut -- forward declarations

-- Jumps to the end and blends back to the gameplay camera.
function ShotHandle:skip()
	local s = S
	if s and s.handle == self and s.phase == "shot" then
		s.skipped = true
		stopBeats(s.beats)
		local last = s.shots[#s.shots]
		beginOut(s, s.lastCF or lastPoseCF, s.lastFov or lastPoseFov, math.min(last.blendOut, SKIP_BLEND))
	end
	return self
end

-- Stops now and snaps back.
function ShotHandle:cancel()
	local s = S
	if s and s.handle == self then
		finishSequence(s, "cancelled")
	end
	return self
end
ShotHandle.Destroy = ShotHandle.cancel

local bars = nil
local function letterboxBars()
	if bars and bars.gui.Parent then
		return bars
	end
	local player = Players.LocalPlayer
	local pg = player and player:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "KitLetterbox"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 95
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None
	end)
	local function bar(y)
		local f = Instance.new("Frame")
		f.Name = if y == 0 then "Top" else "Bottom"
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.AnchorPoint = Vector2.new(0, y)
		f.Position = UDim2.fromScale(0, y)
		f.Size = UDim2.fromScale(1, 0)
		f.Parent = gui
		return f
	end
	bars = { gui = gui, top = bar(0), bottom = bar(1) }
	gui.Parent = pg
	return bars
end

-- Letterbox bars: spec true or { ratio = 2.39, color = Color3, seconds = 0.45, displayOrder = 95, maxFraction = 0.25 }.
local function setLetterbox(on, spec)
	local b = letterboxBars()
	if not b then
		return
	end
	local o = normalize(if type(spec) == "table" then spec else {}, FxMath.CAMERA_NESTED_KEYS.letterbox, "letterbox")
	local seconds = num(o.seconds, 0.45, 0, 10, "letterbox.seconds")
	local frac = 0
	if on then
		local vp = workspace.CurrentCamera.ViewportSize
		frac = FxMath.letterbox(vp.X, vp.Y, num(o.ratio, 2.39, 1, 10, "letterbox.ratio"),
			num(o.maxFraction, 0.25, 0, 0.5, "letterbox.maxFraction"))
		local color = toColor(o.color, Color3.new(0, 0, 0))
		b.top.BackgroundColor3, b.bottom.BackgroundColor3 = color, color
		b.gui.DisplayOrder = num(o.displayOrder, 95, -1000, 100000, "letterbox.displayOrder")
	end
	local info = TweenInfo.new(seconds, Enum.EasingStyle.Quint,
		if on then Enum.EasingDirection.Out else Enum.EasingDirection.InOut)
	TweenService:Create(b.top, info, { Size = UDim2.fromScale(1, frac) }):Play()
	TweenService:Create(b.bottom, info, { Size = UDim2.fromScale(1, frac) }):Play()
end

local function controls()
	local player = Players.LocalPlayer
	local ps = player and player:FindFirstChildOfClass("PlayerScripts")
	local pm = ps and ps:FindFirstChild("PlayerModule")
	if not pm then
		return nil
	end
	local ok, mod = pcall(require, pm)
	if not ok or type(mod) ~= "table" or type(mod.GetControls) ~= "function" then
		return nil
	end
	local ok2, c = pcall(mod.GetControls, mod)
	return if ok2 then c else nil
end

local function lockControls(on)
	local c = controls()
	if c then
		pcall(function()
			if on then
				c:Disable()
			else
				c:Enable()
			end
		end)
	end
end

local SKIP_INPUTS = { [Enum.KeyCode.Space] = true, [Enum.KeyCode.Return] = true, [Enum.KeyCode.ButtonA] = true,
	[Enum.KeyCode.ButtonStart] = true }

local function prepareShot(spec, index)
	local s = normalize(spec, FxMath.SHOT_KEYS, "shot")
	local shot = { spec = s, index = index }
	shot.move = num(s.duration, 1, 0, 600, "shot duration")
	shot.hold = num(s.hold, 0, 0, 600, "shot hold")
	shot.blendIn = num(s.blendIn, 0, 0, 60, "shot blendIn")
	shot.blendOut = num(s.blendOut, 0.6, 0, 60, "shot blendOut")
	local fn, problem = FxMath.easeFn(s.ease, nil, "sine", "inout")
	if problem then
		warnOnce("ease:" .. problem, "shot ease: " .. problem)
	end
	shot.ease = fn
	shot.timeScaled = s.timeScaled == true
	shot.track = s.track == true
	shot.lookOffset = if typeof(s.lookOffset) == "Vector3" then s.lookOffset else Vector3.zero
	if s.orbit ~= nil then
		shot.mode = "orbit"
		local o = normalize(s.orbit, FxMath.CAMERA_NESTED_KEYS.orbit, "shot orbit")
		shot.orbitTarget = o.target
		shot.r0, shot.r1 = pair(o.radius, 12, 0, 10000, "orbit radius")
		shot.h0, shot.h1 = pair(o.height, 3, -10000, 10000, "orbit height")
		shot.a0 = num(o.from, 0, -100000, 100000, "orbit from")
		shot.a1 = num(o.to, shot.a0 + 90, -100000, 100000, "orbit to")
		if targetPosition(o.target) == nil then
			warnOnce("orbit:target", "shot orbit needs target (a part, model, attachment or Vector3)")
		end
	elseif s.path ~= nil or typeof(s.from) == "Vector3" or typeof(s.to) == "Vector3" then
		shot.mode = "path"
	else
		shot.mode = "frames"
		if s.from ~= nil and s.from ~= "current" and typeof(s.from) ~= "CFrame" then
			warnOnce("from:type", "shot from must be a CFrame, a Vector3 or \"current\"")
		end
		if s.to ~= nil and typeof(s.to) ~= "CFrame" then
			warnOnce("to:type", "shot to must be a CFrame or a Vector3")
		end
	end
	if type(s.handheld) == "number" then
		shot.handAmount = num(s.handheld, 0, 0, 50, "handheld")
		shot.handRot, shot.handFreq = shot.handAmount * 4, 0.9
	elseif type(s.handheld) == "table" then
		local h = normalize(s.handheld, FxMath.CAMERA_NESTED_KEYS.handheld, "handheld")
		shot.handAmount = num(h.amount, 0.15, 0, 50, "handheld.amount")
		shot.handRot = num(h.rotation, 0.4, 0, 45, "handheld.rotation")
		shot.handFreq = num(h.frequency, 0.9, 0.01, 30, "handheld.frequency")
	else
		shot.handAmount, shot.handRot, shot.handFreq = 0, 0, 1
	end
	shot.seed = index * 7.31
	return shot
end

local function sampleShot(shot, tau)
	local u = if shot.move > 0 then math.clamp(tau / shot.move, 0, 1) else 1
	local e = shot.ease(u)
	local anchor = shot.anchor
	if shot.track and shot.anchorTarget then
		anchor = targetFrame(shot.anchorTarget) or anchor
	end
	local cf
	if shot.mode == "frames" then
		cf = shot.from:Lerp(shot.to, e)
		if anchor then
			cf = anchor * cf
		end
	elseif shot.mode == "path" then
		local p = FxMath.pathAt(shot.path, e)
		local ahead = FxMath.pathAt(shot.path, math.min(e + 0.02, 1))
		local behind = FxMath.pathAt(shot.path, math.max(e - 0.02, 0))
		if anchor then
			p = anchor:PointToWorldSpace(p)
			ahead = anchor:PointToWorldSpace(ahead)
			behind = anchor:PointToWorldSpace(behind)
		end
		local look = nil
		local la = shot.spec.lookAt
		if type(la) == "table" and typeof(la[1]) == "Vector3" and typeof(la[2]) == "Vector3" then
			look = la[1]:Lerp(la[2], e)
			if anchor then
				look = anchor:PointToWorldSpace(look)
			end
		elseif typeof(la) == "Vector3" and anchor then
			look = anchor:PointToWorldSpace(la)
		elseif la ~= nil then
			look = targetPosition(la)
		end
		if look then
			look += shot.lookOffset
			shot.lastLook = look
		elseif la ~= nil then
			look = shot.lastLook
		end
		if not look then
			local dir = ahead - behind
			look = p + (if dir.Magnitude > 1e-4 then dir.Unit else Vector3.new(0, 0, -1))
		end
		cf = safeLookAt(p, look)
	else
		local center = targetPosition(shot.orbitTarget) or shot.orbitCenter or Vector3.zero
		shot.orbitCenter = center
		local ox, oy, oz = FxMath.orbitOffset(shot.r0 + (shot.r1 - shot.r0) * e, shot.h0 + (shot.h1 - shot.h0) * e,
			shot.a0 + (shot.a1 - shot.a0) * e)
		cf = safeLookAt(center + shot.orbitFrame:VectorToWorldSpace(Vector3.new(ox, oy, oz)), center + shot.lookOffset)
	end
	local roll = shot.roll0 + (shot.roll1 - shot.roll0) * e
	if roll ~= 0 then
		cf *= CFrame.Angles(0, 0, math.rad(roll))
	end
	if shot.handAmount > 0 or shot.handRot > 0 then
		local ms = motionScale()
		if ms > 0 then
			local nx, ny, nz = FxMath.handheld(shot.clock, shot.handFreq, shot.seed)
			local a, r = shot.handAmount * ms, math.rad(shot.handRot) * ms
			cf *= CFrame.new(nx * a, ny * a, 0) * CFrame.Angles(ny * r, nx * r, nz * r * 0.5)
		end
	end
	return cf, shot.fov0 + (shot.fov1 - shot.fov0) * e
end

local function beginShot(s, i, fromCF, fromFov)
	local shot = s.shots[i]
	local spec = shot.spec
	s.i, s.t = i, 0
	shot.clock = 0
	shot.startCF, shot.startFov = fromCF, fromFov
	shot.anchor, shot.anchorTarget = nil, nil
	if spec.relativeTo ~= nil then
		shot.anchor = targetFrame(spec.relativeTo)
		shot.anchorTarget = spec.relativeTo
		if not shot.anchor then
			warnOnce("relativeTo", "shot relativeTo must be a part, model, attachment, humanoid or CFrame")
		end
	end
	local anchor = shot.anchor
	if shot.mode == "frames" then
		local from = spec.from
		if typeof(from) == "CFrame" then
			shot.from = from
		else
			shot.from = if anchor then anchor:ToObjectSpace(fromCF) else fromCF
		end
		shot.to = if typeof(spec.to) == "CFrame" then spec.to else shot.from
	elseif shot.mode == "path" then
		local points = {}
		if type(spec.path) == "table" then
			for _, p in spec.path do
				if typeof(p) == "Vector3" then
					table.insert(points, p)
				end
			end
		else
			local here = if anchor then anchor:PointToObjectSpace(fromCF.Position) else fromCF.Position
			table.insert(points, if typeof(spec.from) == "Vector3" then spec.from else here)
			if typeof(spec.to) == "Vector3" then
				table.insert(points, spec.to)
			end
		end
		if #points == 0 then
			warnOnce("path:empty", "shot path needs Vector3 points")
			table.insert(points, if anchor then anchor:PointToObjectSpace(fromCF.Position) else fromCF.Position)
		end
		shot.path = FxMath.path(points)
		shot.lastLook = nil
	else
		local tf = targetFrame(shot.orbitTarget)
		if tf and typeof(shot.orbitTarget) ~= "Vector3" then
			local lv = tf.LookVector
			shot.orbitFrame = CFrame.fromEulerAnglesYXZ(0, math.atan2(-lv.X, -lv.Z), 0)
		else
			shot.orbitFrame = CFrame.identity
		end
		shot.orbitCenter = nil
	end
	if type(spec.fov) == "table" then
		shot.fov0, shot.fov1 = pair(spec.fov, fromFov, 1, 120, "shot fov")
	else
		local fov = num(spec.fov, fromFov, 1, 120, "shot fov")
		shot.fov0, shot.fov1 = fov, fov
	end
	shot.roll0, shot.roll1 = pair(spec.roll, 0, -180, 180, "shot roll")
	local lb = spec.letterbox
	if lb == nil then
		lb = s.letterbox
	end
	if lb and lb ~= false then
		if not s.letterboxOn then
			setLetterbox(true, lb)
			s.letterboxOn, s.letterboxSpec = true, lb
		end
	elseif s.letterboxOn then
		setLetterbox(false, s.letterboxSpec)
		s.letterboxOn = false
	end
	if spec.slowmo ~= nil and shot.move + shot.hold > 0 then
		local sm = spec.slowmo
		local id = nil
		if type(sm) == "number" then
			id = CameraRig.slowmo(sm, shot.move + shot.hold)
		elseif type(sm) == "table" then
			local o = normalize(sm, FxMath.CAMERA_NESTED_KEYS.slowmo, "shot slowmo")
			id = CameraRig.slowmo(num(o.scale, 0.3, 0, 1, "slowmo.scale"), num(o.seconds, shot.move + shot.hold, 0.01, 60,
				"slowmo.seconds"), { rampIn = o.rampIn, rampOut = o.rampOut })
		else
			warnOnce("shot slowmo:type", "shot slowmo must be a scale (number) or { scale, seconds, rampIn, rampOut }")
		end
		if id then
			table.insert(s.beats, id)
		end
	end
	if type(spec.onStart) == "function" then
		task.spawn(spec.onStart, i)
	end
	if Debug then
		Debug.event("camera_shot", { sequence = s.name, shot = spec.name or i, index = i, count = #s.shots,
			seconds = shot.move + shot.hold })
	end
end

beginOut = function(s, cf, fov, duration)
	s.phase = "out"
	s.outCF, s.outFov = cf, fov
	s.outT, s.outDur = 0, duration
	if s.letterboxOn then
		setLetterbox(false, s.letterboxSpec)
		s.letterboxOn = false
	end
	if s.controlsLocked then
		lockControls(false)
		s.controlsLocked = false
	end
	if s.skipConn then
		s.skipConn:Disconnect()
		s.skipConn = nil
	end
	-- no follow to return to: hand the camera back now so the default camera can be blended into
	if F == nil then
		handBack()
	end
end

finishSequence = function(s, status)
	if S == s then
		S = nil
	end
	if s.letterboxOn then
		setLetterbox(false, s.letterboxSpec)
		s.letterboxOn = false
	end
	if s.controlsLocked then
		lockControls(false)
		s.controlsLocked = false
	end
	if s.skipConn then
		s.skipConn:Disconnect()
		s.skipConn = nil
	end
	if status ~= "done" then
		stopBeats(s.beats)
	end
	local player = Players.LocalPlayer
	if status ~= "interrupted" then
		if player and S == nil then
			player:SetAttribute("KitCinematic", nil)
		end
		if S == nil and F == nil then
			releaseCamera()
		end
	end
	if type(s.onDone) == "function" then
		task.defer(s.onDone, status)
	end
	settle(s.handle, status)
	if Debug then
		Debug.event("camera_sequence_done", { sequence = s.name, status = status })
	end
end

local function stepSequence(s, dt, baseCF, baseFov)
	if s.phase == "shot" then
		local shot = s.shots[s.i]
		s.t += dt * (if shot.timeScaled then CameraRig.timeScale else 1)
		shot.clock += dt
		while s.t >= shot.move + shot.hold do
			local over = s.t - (shot.move + shot.hold)
			local endCF, endFov = sampleShot(shot, shot.move + shot.hold)
			if s.i < #s.shots then
				beginShot(s, s.i + 1, endCF, endFov)
				shot = s.shots[s.i]
				s.t = over
			else
				beginOut(s, endCF, endFov, shot.blendOut)
				break
			end
		end
	end
	if s.phase == "shot" then
		local shot = s.shots[s.i]
		local cf, fov = sampleShot(shot, s.t)
		if shot.blendIn > 0 and s.t < shot.blendIn then
			local w = BLEND(s.t / shot.blendIn)
			cf = shot.startCF:Lerp(cf, w)
			fov = shot.startFov + (fov - shot.startFov) * w
		end
		s.lastCF, s.lastFov = cf, fov
		return cf, fov
	end
	s.outT += dt
	local w = if s.outDur > 0 then BLEND(s.outT / s.outDur) else 1
	local cf = s.outCF:Lerp(baseCF, w)
	local fov = s.outFov + (baseFov - s.outFov) * w
	if s.outT >= s.outDur then
		finishSequence(s, if s.skipped then "skipped" else "done")
	end
	return cf, fov
end

local function resolvedHandle(status)
	local h = newShotHandle()
	settle(h, status)
	return h
end

-- Plays authored shots back to back and returns a promise-like handle (:andThen(fn), :await(), :skip(), :cancel()).
-- Each shot is one of:
--   frames: { from = CFrame | "current", to = CFrame }
--   path:   { path = {Vector3...} or from = Vector3, to = Vector3, lookAt = target | {Vector3, Vector3} }
--   orbit:  { orbit = { target =, radius = n | {a, b}, height = n | {a, b}, from = deg, to = deg } }  0 = behind
-- plus duration, hold, ease ("Sine InOut"), fov (n | {from, to}), roll (deg | {a, b}), handheld (studs or
-- {amount, rotation, frequency}), relativeTo (part / model / CFrame: positions are in its space), track, lookOffset,
-- blendIn (0 = cut), blendOut (last shot: back to the gameplay camera), letterbox, slowmo (scale or {scale,
-- seconds, rampIn, rampOut}), timeScaled, onStart(i).
-- opts: letterbox (true | {ratio, color, seconds}), skipInput, lockControls, onDone(status), blendOut, name.
function CameraRig.sequence(shots, opts)
	if not IS_CLIENT then
		warnOnce("sequence:server", "shots run on the client only")
		return resolvedHandle("cancelled")
	end
	if type(shots) ~= "table" or #shots == 0 then
		warnOnce("sequence:empty", "sequence needs a list of shots")
		return resolvedHandle("cancelled")
	end
	local o = normalize(opts or {}, FxMath.SEQUENCE_KEYS, "sequence")
	local prepared = {}
	for i, spec in ipairs(shots) do
		if type(spec) == "table" then
			table.insert(prepared, prepareShot(spec, i))
		else
			warnOnce("shot:type", "every shot must be a table")
		end
	end
	if #prepared == 0 then
		return resolvedHandle("cancelled")
	end
	if o.blendOut ~= nil then
		prepared[#prepared].blendOut = num(o.blendOut, 0.6, 0, 60, "sequence blendOut")
	end
	local barsOn, barsSpec = false, nil
	if S then
		barsOn, barsSpec = S.letterboxOn, S.letterboxSpec
		S.letterboxOn = false -- the new sequence takes the bars over
		finishSequence(S, "interrupted")
	end
	local cam = workspace.CurrentCamera
	takeCamera(cam)
	local h = newShotHandle()
	local s = { shots = prepared, handle = h, phase = "shot", i = 1, t = 0, letterbox = o.letterbox,
		onDone = o.onDone, name = o.name, started = os.clock(), letterboxOn = barsOn, letterboxSpec = barsSpec,
		beats = {} }
	S = s
	local fromCF = lastPoseCF or (cam and cam.CFrame) or CFrame.identity
	local fromFov = lastPoseFov or (cam and cam.FieldOfView) or 70
	beginShot(s, 1, fromCF, fromFov)
	s.lastCF, s.lastFov = fromCF, fromFov
	if o.lockControls then
		lockControls(true)
		s.controlsLocked = true
	end
	if o.skipInput then
		s.skipConn = UserInputService.InputBegan:Connect(function(io, processed)
			if processed or os.clock() - s.started < 0.3 then
				return
			end
			if SKIP_INPUTS[io.KeyCode] or io.UserInputType == Enum.UserInputType.Touch
				or io.UserInputType == Enum.UserInputType.MouseButton1 then
				h:skip()
			end
		end)
	end
	local player = Players.LocalPlayer
	if player then
		player:SetAttribute("KitCinematic", true)
	end
	ensureBound()
	return h
end

-- One authored shot (see sequence); the shot's own letterbox / skipInput / lockControls / onDone apply.
function CameraRig.shot(spec)
	if type(spec) ~= "table" then
		warnOnce("shot:type", "shot needs a table")
		return resolvedHandle("cancelled")
	end
	local s = normalize(spec, FxMath.SHOT_KEYS, "shot")
	return CameraRig.sequence({ spec }, { skipInput = s.skipInput, lockControls = s.lockControls, onDone = s.onDone,
		name = s.name })
end

-- True while a shot or sequence runs (the LocalPlayer attribute "KitCinematic" says the same, for HUD scripts).
function CameraRig.isCinematic()
	return S ~= nil
end

-- The rig's last camera pose and FOV (before kicks and punches), or nil when idle.
function CameraRig.pose()
	return lastPoseCF, lastPoseFov
end

------------------------------------------------------------------------------------------------ the render step
-- The pose the camera goes back to without the rig: the game's camera as it is now, or where a scriptable game
-- camera was when the rig took over; and the FOV it had then.
local function restoreBase(cam)
	local cf, fov = idleBase(cam)
	if saved then
		fov = saved.fov
		if saved.cameraType == SCRIPTABLE then
			cf = saved.cf
		end
	end
	return cf, fov
end

local function owning()
	return F ~= nil or (S ~= nil and S.phase == "shot")
end

step = function(dt)
	dt = if finite(dt) then math.clamp(dt, 0, 0.1) else 0
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local slowing = stepSlowmo(dt)
	local ms = motionScale()
	local kick, kicking = stepKicks(dt)
	kick *= ms
	local punching = stepPunch(dt)
	if owning() then
		takeCamera(cam)
		if cam.CameraType ~= SCRIPTABLE then
			cam.CameraType = SCRIPTABLE
		end
	end
	-- the base pose: the follow rig's, else the camera the game has (what shots start from and blend back to)
	local cf, fov, focus = nil, nil, nil
	if F then
		cf, fov, focus = stepFollow(F, dt, cam, S == nil)
		cf = cf or lastPoseCF or cam.CFrame -- no subject yet: hold still
		fov = fov or lastPoseFov or cam.FieldOfView
	elseif S ~= nil or kicking or punching then
		cf, fov = restoreBase(cam)
	end
	if cf == nil then
		-- idle: take back what we added last frame (if nobody replaced it), hand the camera back, stop stepping
		if wroteCF ~= nil then
			if cam.CFrame == wroteCF then
				cam.CFrame = wroteBaseCF
			end
			wroteCF = nil
		end
		if wroteFov ~= nil then
			if math.abs(cam.FieldOfView - wroteFov) < 1e-3 then
				cam.FieldOfView = wroteBaseFov
			end
			wroteFov = nil
		end
		if saved then
			releaseCamera()
		end
		lastPoseCF, lastPoseFov = nil, nil
		if not slowing and CameraRig.timeScale == 1 then
			unbind()
		end
		return
	end
	local baseCF, baseFov = cf, fov
	if S then
		cf, fov = stepSequence(S, dt, cf, fov) -- may finish the sequence (and hand the camera back)
		focus = nil
	end
	local p = cf.Position
	if not (finite(p.X) and finite(p.Y) and finite(p.Z) and finite(fov)) then
		-- a bad value got in somewhere (a NaN target, a broken spring): never hand it to the camera; reset and retry
		warnOnce("nan", "the camera pose became invalid (NaN); reset")
		punchPos, punchVel = Vector3.zero, Vector3.zero
		if F then
			F.started = false
		end
		return
	end
	if owning() then
		lastPoseCF, lastPoseFov = cf, fov
		wroteCF, wroteFov = nil, nil
		cam.CFrame = applyPunch(cf, ms, true)
		cam.Focus = CFrame.new(focus or (cf.Position + cf.LookVector * 12))
		cam.FieldOfView = math.clamp(fov + kick, 1, 120)
	else
		-- someone else's camera (blending out of a shot, or kicks over the default camera): translation only, so
		-- camera scripts that read the camera's orientation back never drift; remember what we wrote to undo it
		if S then
			lastPoseCF, lastPoseFov = cf, fov
		else
			lastPoseCF, lastPoseFov = nil, nil
		end
		local out = applyPunch(cf, ms, false)
		cam.CFrame = out
		wroteCF, wroteBaseCF = out, handBackBase or baseCF -- right after a hand-back, the pose to resume from
		handBackBase = nil
		local outFov = math.clamp(fov + kick, 1, 120)
		cam.FieldOfView = outFov
		wroteFov, wroteBaseFov = outFov, baseFov
	end
end

if Debug then
	Debug.register("__camera_rig", function()
		local f = F
		return { follow = f ~= nil, preset = f and tostring(f.user.preset or "custom") or nil,
			distance = f and f.dist or nil, fov = f and f.outFov or nil, cinematic = S ~= nil,
			timeScale = CameraRig.timeScale }
	end, "the camera rig's state (follow, cinematic, time scale)")
end

return CameraRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ControllerKit</string>
          <string name="Source"><![CDATA[--!nonstrict
-- ControllerKit: tuned player controllers ("feel profiles") that make a genre feel good when merely configured.
-- Pick a profile, override any number in its opts table, connect its events. Every profile works with no opts.
--
--   local ctl = ControllerKit.platformer()                         -- 3D platformer on the default Humanoid (client)
--   local ctl = ControllerKit.topDown({ view = "isometric" })        -- cozy / action / management (client)
--   local ctl = ControllerKit.shooter({ view = "fps", weapon = "rifle" })      -- FPS / TPS (client)
--   ControllerKit.shooterServer({ onDamage = function(attacker, humanoid, dmg, info) end })   -- validation (server)
--   local car = ControllerKit.vehicle(nil, { kind = "kart" })        -- kart | car | hover | boat (client or server)
--   ctl.Landed:Connect(function(impactSpeed) end); ctl:setEnabled(false); ctl:Destroy()
--
-- Client / server:
--   platformer, topDown, shooter: LocalScripts (StarterPlayerScripts / StarterCharacterScripts). They move the local
--     character, which the client already owns, so movement replicates with no server code.
--   shooterServer: a Script. It creates ReplicatedStorage.KitShooterRemote, owns ammo, re-checks every shot and
--     applies damage. Without it the client shooter still works locally (offline / single-player prototypes).
--   vehicle: on the SERVER, ControllerKit.vehicle(model|nil, opts) spawns (or adopts) the vehicle with a Seat and
--     gives network ownership of its root to whoever sits in it; on the CLIENT, ControllerKit.vehicle(model, opts)
--     drives that model while the local player sits in it. ControllerKit.vehicle(nil, opts) on the client builds a
--     client-only vehicle and drives it right away (single-player prototypes, demos).
-- Input: keyboard/mouse, gamepad and touch through ContextActionService; touch buttons are created only when
--   UserInputService.TouchEnabled. All motion is dt-scaled (vehicles run a fixed 120 Hz step, interpolated).
-- Cameras use Kit.CameraRig (one follow at a time); pass camera = false to keep your own, or camera = {...} to tune.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local TweenService = game:GetService("TweenService")

local Common = require((script.Parent :: Instance):WaitForChild("ControllerKit_Common"))
local Maid = require((script.Parent :: Instance):WaitForChild("Maid"))

local IS_CLIENT = RunService:IsClient()
local CameraRig = if IS_CLIENT then Common.sibling("CameraRig") else nil
local Debug = Common.sibling("Debug")

local merge, flat = Common.merge, Common.flat
local K = Enum.KeyCode
local INPUT_PRIORITY = Enum.RenderPriority.Input.Value + 1 -- just after the default controls

local ControllerKit = {}
ControllerKit.Common = Common

local function event(name, data)
	if Debug and Debug.event then
		pcall(Debug.event, name, data)
	end
end

local function startCamera(opts, defaults)
	if opts == false or not CameraRig then
		return nil
	end
	local cfg = merge(defaults, if type(opts) == "table" then opts else nil)
	local ok, rig = pcall(CameraRig.follow, cfg)
	return if ok then rig else nil
end

local function saveHumanoid(h)
	return { WalkSpeed = h.WalkSpeed, JumpHeight = h.JumpHeight, JumpPower = h.JumpPower, AutoRotate = h.AutoRotate,
		AutoJumpEnabled = h.AutoJumpEnabled }
end

local function restoreHumanoid(h, saved)
	if h and h.Parent and saved then
		for k, v in saved do
			pcall(function()
				h[k] = v
			end)
		end
	end
end

local function grounded(h)
	return h.FloorMaterial ~= Enum.Material.Air
end

local function cameraPunch(dir, studs)
	if CameraRig and studs > 0 then
		pcall(CameraRig.punch, dir, studs)
	end
end

local function cameraShake(trauma)
	if CameraRig and trauma > 0 then
		pcall(CameraRig.shake, trauma)
	end
end

------------------------------------------------------------------------------------------------ platformer
-- Options (all optional; speeds in studs/s, times in seconds, heights in studs):
--   runSpeed=32, accel=110, decel=150, turn=280 (skid rate when reversing), airControl=0.6 (accel multiplier in air)
--   jumpHeight=9.5, coyote=0.1, buffer=0.13, jumpCut=0.45 (vertical speed kept on early release),
--   fallGravity=1.7 (gravity multiplier falling), riseGravity=1, maxFall=190
--   doubleJump = {height=7.5, count=1} | false
--   longJump   = {speed=64, height=5, minSpeed=16} | false     (crouch + jump while running)
--   dive       = {speed=52, up=14} | false                     (dash in the air)
--   dash       = {speed=72, time=0.16, cooldown=0.6} | false   (dash on the ground)
--   groundPound= {hang=0.14, speed=160} | false                (crouch in the air)
--   wallKick   = {out=34, height=9.5, reach=2.4, grace=0.16} | false (off by default; jump into a wall in the air)
--   onLand = function(impactSpeed, ctl) end   landing squash / dust hook (default: small camera dip on hard landings)
--   camera = {CameraRig.follow opts} | false  (default overTheTop, lagging vertically so jumps read)
--   keys = {jump={...}, crouch={...}, dash={...}}  (KeyCode lists; touch buttons are added automatically)
-- Events: Jumped(kind: "jump"|"long"|"wall"), DoubleJumped(n), Landed(impactSpeed), GroundPound(position),
--   Dashed(kind: "dash"|"dive"). Methods: setEnabled(bool), set(opts), state() -> table, Destroy().
local PLATFORMER = {
	runSpeed = 32, accel = 110, decel = 150, turn = 280, airControl = 0.6,
	jumpHeight = 9.5, coyote = 0.1, buffer = 0.13, jumpCut = 0.45, fallGravity = 1.7, riseGravity = 1, maxFall = 190,
	doubleJump = { height = 7.5, count = 1 },
	longJump = { speed = 64, height = 5, minSpeed = 16 },
	dive = { speed = 52, up = 14 },
	dash = { speed = 72, time = 0.16, cooldown = 0.6 },
	groundPound = { hang = 0.14, speed = 160 },
	wallKick = false,
	onLand = nil,
	camera = nil,
	keys = {
		jump = { K.Space, K.ButtonA },
		crouch = { K.LeftControl, K.C, K.ButtonL2, K.ButtonB },
		dash = { K.LeftShift, K.ButtonX },
	},
}
local PLAT_CAMERA = { preset = "overTheTop", distance = 20, height = 2.5, pitch = -18, lookAhead = 3, verticalSpeed = 6,
	autoAlign = { delay = 1.6, speed = 1.4 }, zoom = { min = 10, max = 34 } }
local WALLKICK = { out = 34, height = 9.5, reach = 2.4, grace = 0.16 }

local Platformer = {}
Platformer.__index = Platformer

local function featureOpts(v, defaults)
	if v == false or v == nil then
		return nil
	elseif v == true then
		return table.clone(defaults)
	end
	return merge(defaults, v)
end

function ControllerKit.platformer(who, opts)
	if not IS_CLIENT then
		Common.warnOnce("platformer:server", "platformer runs on the client (a LocalScript)")
		return nil
	end
	if type(who) == "table" and opts == nil then
		who, opts = nil, who
	end
	local self = setmetatable({ maid = Maid.new(), enabled = true, s = nil }, Platformer)
	Common.signals(self, { "Jumped", "DoubleJumped", "Landed", "GroundPound", "Dashed" })
	self:set(opts)
	local input = Common.Input.new(self.maid, "KitPlat")
	self.input = input
	self.held = { jump = false, crouch = false }
	local keys = self.o.keys
	input:bind("Jump", keys.jump, function(began)
		self.held.jump = began
		if began then
			self.jumpQueued = os.clock()
		end
	end)
	input:bind("Crouch", keys.crouch, function(began)
		self.held.crouch = began
		if began then
			self.crouchQueued = os.clock()
		end
	end, { touch = "Crouch", slot = 2 })
	input:bind("Dash", keys.dash, function(began)
		if began then
			self.dashQueued = os.clock()
		end
	end, { touch = "Dash", slot = 1 })
	self.camera = startCamera(self.o.camera, PLAT_CAMERA)
	self.maid:Give(Common.eachCharacter(who, function(character, humanoid, root)
		self:_attach(character, humanoid, root)
	end))
	self.maid:Give(Common.renderStep("KitPlatformer", INPUT_PRIORITY, function(dt)
		self:_step(math.min(dt, 0.1))
	end))
	self.maid:Give(function()
		self:_detach()
		if self.camera then
			self.camera:stop()
		end
	end)
	event("controller", { profile = "platformer" })
	return self
end

function Platformer:set(opts)
	local o = merge(PLATFORMER, opts)
	o.doubleJump = featureOpts(o.doubleJump, PLATFORMER.doubleJump)
	o.longJump = featureOpts(o.longJump, PLATFORMER.longJump)
	o.dive = featureOpts(o.dive, PLATFORMER.dive)
	o.dash = featureOpts(o.dash, PLATFORMER.dash)
	o.groundPound = featureOpts(o.groundPound, PLATFORMER.groundPound)
	o.wallKick = featureOpts(o.wallKick, WALLKICK)
	self.o = o
	return self
end

function Platformer:_detach()
	local s = self.s
	if s then
		s.conn:Disconnect()
		restoreHumanoid(s.humanoid, s.saved)
		self.s = nil
	end
end

function Platformer:_attach(character, humanoid, root)
	self:_detach()
	local saved = saveHumanoid(humanoid)
	local s = { character = character, humanoid = humanoid, root = root, saved = saved,
		mover = Common.Mover.new(humanoid, root), lastGround = os.clock(), lastJump = -1, airJumps = 0,
		wasGrounded = true, minVy = 0, cutArmed = false, pound = nil, dashUntil = 0, dashReady = 0, wallAt = -1,
		wallNormal = nil, airDashed = false }
	-- the controller owns jumping (Space / A are sunk before the default controls see them); the touch jump button
	-- still sets Humanoid.Jump, which is turned into a buffered press here (touch jumps are always full height)
	s.conn = humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
		if self.enabled and humanoid.Jump and not self.held.jump then
			self.jumpQueued = os.clock()
			self.touchQueued = true
		end
	end)
	self.s = s
	if self.enabled then
		self:_own(s)
	end
end

function Platformer:_own(s)
	local h = s.humanoid
	h.UseJumpPower = false
	h.JumpHeight = self.o.jumpHeight
	h.AutoJumpEnabled = false
	h.AutoRotate = true
end

function Platformer:setEnabled(on)
	on = on ~= false
	if on == self.enabled then
		return self
	end
	self.enabled = on
	self.input:setEnabled(on)
	local s = self.s
	if s then
		if on then
			self:_own(s)
		else
			restoreHumanoid(s.humanoid, s.saved)
		end
	end
	if self.camera then
		if on then
			self.camera = startCamera(self.o.camera, PLAT_CAMERA)
		else
			self.camera:stop()
		end
	end
	return self
end

local function jumpVelocity(height)
	return math.sqrt(2 * workspace.Gravity * math.max(height, 0))
end

function Platformer:_jump(s, vy, kind)
	local root, h = s.root, s.humanoid
	-- the Humanoid's own jump impulse and the velocity we write agree, so whichever lands first gives the same arc
	h.JumpHeight = vy * vy / (2 * workspace.Gravity)
	h:ChangeState(Enum.HumanoidStateType.Jumping)
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
	s.lastJump = os.clock()
	s.cutArmed = not self.touchQueued
	s.wasGrounded = false
	self.jumpQueued = nil
	self.touchQueued = false
	if kind then
		self.Jumped:Fire(kind)
	end
end

-- A press just before touching down should become a ground jump (buffer), not burn the air jump.
function Platformer:_landingSoon(s, vel)
	if vel.Y >= 0 then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { s.character }
	local stand = if s.humanoid.RigType == Enum.HumanoidRigType.R6 then 3 else s.humanoid.HipHeight + s.root.Size.Y / 2
	local reach = stand + -vel.Y * self.o.buffer + 0.5
	local hit = workspace:Raycast(s.root.Position, Vector3.new(0, -reach, 0), params)
	return hit ~= nil
end

function Platformer:_step(dt)
	local s = self.s
	if not s or not self.enabled or not s.root.Parent or s.humanoid.Health <= 0 then
		return
	end
	local o, h, root, now = self.o, s.humanoid, s.root, os.clock()
	local state = h:GetState()
	if state == Enum.HumanoidStateType.Seated or state == Enum.HumanoidStateType.Swimming
		or state == Enum.HumanoidStateType.Climbing then
		s.mover.vel = flat(root.AssemblyLinearVelocity)
		h.WalkSpeed = o.runSpeed
		return
	end
	local vel = root.AssemblyLinearVelocity
	local onGround = grounded(h) and now - s.lastJump > 0.1 and vel.Y < 12
	local facing = flat(root.CFrame.LookVector)
	facing = if facing.Magnitude > 0.01 then facing.Unit else Vector3.new(0, 0, -1)
	local g = workspace.Gravity

	-- landing
	if onGround and not s.wasGrounded then
		local impact = math.max(0, -s.minVy)
		s.airJumps, s.airDashed = 0, false
		if s.pound then
			s.pound = nil
			self.GroundPound:Fire(root.Position)
			cameraShake(0.35)
			cameraPunch(Vector3.new(0, -1, 0), 0.6)
		end
		self.Landed:Fire(impact)
		if o.onLand then
			task.spawn(o.onLand, impact, self)
		elseif impact > 70 then
			cameraPunch(Vector3.new(0, -1, 0), math.clamp((impact - 70) / 220, 0, 0.45))
		end
		s.minVy = 0
	end
	if onGround then
		s.lastGround = now
		s.minVy = 0
		if now - s.lastJump > 0.2 then
			h.JumpHeight = o.jumpHeight
		end
	else
		s.minVy = math.min(s.minVy, vel.Y)
	end
	s.wasGrounded = onGround

	-- wall contact (for wall kicks)
	if o.wallKick and not onGround then
		local dir = flat(vel)
		dir = if dir.Magnitude > 2 then dir.Unit else facing
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { s.character }
		local hit = workspace:Raycast(root.Position, dir * o.wallKick.reach, params)
		if hit and math.abs(hit.Normal.Y) < 0.35 then
			s.wallAt, s.wallNormal = now, flat(hit.Normal).Unit
		end
	end

	local buffered = self.jumpQueued and now - self.jumpQueued <= o.buffer
	local crouchPressed = self.crouchQueued and now - self.crouchQueued <= o.buffer
	local dashPressed = self.dashQueued and now - self.dashQueued <= o.buffer

	-- ground pound: hang, then slam
	if s.pound then
		if now < s.pound.untilT then
			s.mover:set(Vector3.zero)
			root.AssemblyLinearVelocity = Vector3.zero
			return
		end
		root.AssemblyLinearVelocity = Vector3.new(0, -o.groundPound.speed, 0)
		s.mover:set(Vector3.zero)
		return
	end
	if crouchPressed and not onGround and o.groundPound and now - s.lastGround > 0.12 then
		self.crouchQueued = nil
		s.pound = { untilT = now + o.groundPound.hang }
		cameraPunch(Vector3.new(0, 1, 0), 0.15)
		return
	end

	-- dash (ground) / dive (air)
	if dashPressed then
		self.dashQueued = nil
		if onGround and o.dash and now >= s.dashReady then
			s.dashUntil = now + o.dash.time
			s.dashReady = now + o.dash.cooldown
			s.mover:set(facing * o.dash.speed)
			self.Dashed:Fire("dash")
			cameraPunch(-facing, 0.25)
		elseif not onGround and o.dive and not s.airDashed then
			s.airDashed = true
			local speed = math.max(o.dive.speed, flat(vel).Magnitude)
			s.mover:set(facing * speed)
			root.AssemblyLinearVelocity = Vector3.new(facing.X * speed, math.max(vel.Y, 0) + o.dive.up, facing.Z * speed)
			s.cutArmed = false
			self.Dashed:Fire("dive")
		end
	end

	-- jumps: buffered presses, coyote time, long jump, wall kick, air jumps
	if buffered then
		local coyote = now - s.lastGround <= o.coyote and now - s.lastJump > o.coyote + 0.05
		if onGround or coyote then
			local speed = s.mover.vel.Magnitude
			if o.longJump and self.held.crouch and speed >= o.longJump.minSpeed then
				s.mover:set(facing * math.max(o.longJump.speed, speed))
				self:_jump(s, jumpVelocity(o.longJump.height), "long")
				s.cutArmed = false
			else
				self:_jump(s, jumpVelocity(o.jumpHeight), "jump")
			end
		elseif o.wallKick and s.wallNormal and now - s.wallAt <= o.wallKick.grace then
			local n = s.wallNormal
			s.mover:set(n * o.wallKick.out)
			root.CFrame = CFrame.lookAt(root.Position, root.Position + n)
			self:_jump(s, jumpVelocity(o.wallKick.height), "wall")
			s.wallNormal = nil
		elseif o.doubleJump and s.airJumps < (o.doubleJump.count or 1) and not self:_landingSoon(s, vel) then
			s.airJumps += 1
			self:_jump(s, jumpVelocity(o.doubleJump.height), nil)
			self.DoubleJumped:Fire(s.airJumps)
		end
	end

	-- variable jump height, heavier falls, terminal speed
	vel = root.AssemblyLinearVelocity
	local vy = vel.Y
	if s.cutArmed and vy > 0 and not self.held.jump then
		vy *= o.jumpCut
		s.cutArmed = false
	elseif vy <= 0 then
		s.cutArmed = false
	end
	if not onGround then
		local mult = if vy < 0 then o.fallGravity else o.riseGravity
		vy -= (mult - 1) * g * dt
		vy = math.max(vy, -o.maxFall)
	end
	if vy ~= vel.Y then
		root.AssemblyLinearVelocity = Vector3.new(vel.X, vy, vel.Z)
	end

	-- horizontal: accelerate toward the stick, skid when reversing, keep dash speed until the dash ends
	if now < s.dashUntil then
		s.mover:apply()
	else
		local intent = Common.moveIntent(h)
		s.mover:step(dt, intent, { speed = o.runSpeed, accel = o.accel, decel = o.decel, turn = o.turn,
			air = o.airControl }, onGround)
	end
end

function Platformer:state()
	local s = self.s
	if not s then
		return { attached = false }
	end
	return { attached = true, grounded = s.wasGrounded, speed = s.mover.vel.Magnitude, airJumps = s.airJumps,
		pounding = s.pound ~= nil, velocity = s.root.AssemblyLinearVelocity }
end

function Platformer:Destroy()
	self.maid:Clean()
	for _, n in { "Jumped", "DoubleJumped", "Landed", "GroundPound", "Dashed" } do
		self[n]:Destroy()
	end
end

------------------------------------------------------------------------------------------------ topDown
-- Options:
--   speed=22, accel=95, decel=120, turn=220, turnRate=14 (smooth facing, 1/s)
--   view = "isometric" (45 deg, telephoto) | "topDown"; camera = {CameraRig.follow opts} | false
--   clickToMove = true (mouse click / touch tap on the ground; WASD or stick cancels), pathfind = true, arrive = 3
--   marker = true (a ring where you clicked), markerColor
--   interact = {radius=10, tag="Interactable", keys={E, ButtonX}, highlight=true, prompt="E", filter=fn(inst)->bool,
--     candidates=fn()->{Instance}} | false   nearest tagged BasePart / Model inside radius becomes the focus
-- Events: FocusChanged(inst|nil), Interacted(inst), MoveTargetSet(position), Arrived(position).
-- Methods: moveTo(position), stop(), setEnabled(bool), set(opts), focus() -> inst?, Destroy().
local TOPDOWN = {
	speed = 22, accel = 95, decel = 120, turn = 220, turnRate = 14,
	view = "isometric", camera = nil,
	clickToMove = true, pathfind = true, arrive = 3, marker = true, markerColor = "#7CE0FF",
	interact = { radius = 10, tag = "Interactable", keys = { K.E, K.ButtonX }, highlight = true, prompt = "E" },
}
local VIEWS = {
	isometric = { preset = "topDown", yaw = 45, pitch = -38, distance = 70, fov = 32, speed = 7, lookAhead = 3 },
	topdown = { preset = "topDown", distance = 52, fov = 40, pitch = -68, speed = 7, lookAhead = 4 },
}

local TopDown = {}
TopDown.__index = TopDown

function ControllerKit.topDown(who, opts)
	if not IS_CLIENT then
		Common.warnOnce("topdown:server", "topDown runs on the client (a LocalScript)")
		return nil
	end
	if type(who) == "table" and opts == nil then
		who, opts = nil, who
	end
	local self = setmetatable({ maid = Maid.new(), enabled = true, s = nil, target = nil, path = nil }, TopDown)
	Common.signals(self, { "FocusChanged", "Interacted", "MoveTargetSet", "Arrived" })
	self:set(opts)
	self.input = Common.Input.new(self.maid, "KitTop")
	local io = self.o.interact
	if io then
		self.input:bind("Interact", io.keys or TOPDOWN.interact.keys, function(began)
			if began and self.focused then
				self.Interacted:Fire(self.focused)
				event("interact", { name = self.focused.Name })
			end
		end, { touch = "Use", slot = 1 })
	end
	local view = VIEWS[string.lower(tostring(self.o.view))] or VIEWS.isometric
	self.camera = startCamera(self.o.camera, view)
	self.maid:Give(Common.eachCharacter(who, function(character, humanoid, root)
		self:_attach(character, humanoid, root)
	end))
	self.maid:Give(UserInputService.InputBegan:Connect(function(inp, processed)
		if processed or not self.enabled or not self.o.clickToMove then
			return
		end
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			local p = UserInputService:GetMouseLocation()
			self:_click(workspace.CurrentCamera:ViewportPointToRay(p.X, p.Y))
		end
	end))
	self.maid:Give(UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or not self.enabled or not self.o.clickToMove or #positions == 0 then
			return
		end
		local p = positions[1]
		self:_click(workspace.CurrentCamera:ScreenPointToRay(p.X, p.Y))
	end))
	self.maid:Give(Common.renderStep("KitTopDown", INPUT_PRIORITY, function(dt)
		self:_step(math.min(dt, 0.1))
	end))
	self.maid:Give(function()
		self:_setFocus(nil)
		self:_detach()
		if self.camera then
			self.camera:stop()
		end
	end)
	event("controller", { profile = "topDown" })
	return self
end

function TopDown:set(opts)
	local o = merge(TOPDOWN, opts)
	o.interact = featureOpts(o.interact, TOPDOWN.interact)
	self.o = o
	return self
end

function TopDown:_attach(character, humanoid, root)
	self:_detach()
	self.s = { character = character, humanoid = humanoid, root = root, saved = saveHumanoid(humanoid),
		mover = Common.Mover.new(humanoid, root), scan = 0 }
	if self.enabled then
		humanoid.AutoRotate = false
	end
end

function TopDown:_detach()
	if self.s then
		restoreHumanoid(self.s.humanoid, self.s.saved)
		self.s = nil
	end
end

function TopDown:setEnabled(on)
	on = on ~= false
	self.enabled = on
	self.input:setEnabled(on)
	if self.s then
		if on then
			self.s.humanoid.AutoRotate = false
		else
			restoreHumanoid(self.s.humanoid, self.s.saved)
		end
	end
	if not on then
		self:stop()
		self:_setFocus(nil)
	end
	return self
end

function TopDown:_click(ray)
	local s = self.s
	if not s then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { s.character }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
	if hit and hit.Normal.Y > 0.5 then
		self:moveTo(hit.Position)
	end
end

function TopDown:_marker(pos)
	if not self.o.marker then
		return
	end
	local ring = Instance.new("Part")
	ring.Name = "KitMoveMarker"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch, ring.CastShadow = true, false, false, false, false
	ring.Material = Enum.Material.Neon
	ring.Color = Common.color(self.o.markerColor, Color3.fromRGB(124, 224, 255))
	ring.Size = Vector3.new(0.12, 1, 1)
	ring.CFrame = CFrame.new(pos + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Transparency = 0.15
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.12, 4.5, 4.5), Transparency = 1 }):Play()
	task.delay(0.5, ring.Destroy, ring)
end

-- Walks to a point (pathfinding around obstacles when pathfind is on). WASD / stick input cancels it.
function TopDown:moveTo(pos)
	local s = self.s
	if not s then
		return
	end
	self.target = pos
	self.path = nil
	self:_marker(pos)
	self.MoveTargetSet:Fire(pos)
	if self.o.pathfind then
		local token = {}
		self.pathToken = token
		task.spawn(function()
			local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
			local ok = pcall(path.ComputeAsync, path, s.root.Position, pos)
			if ok and self.pathToken == token and path.Status == Enum.PathStatus.Success then
				local pts = {}
				for i, wp in path:GetWaypoints() do
					if i > 1 then
						table.insert(pts, wp)
					end
				end
				self.path = pts
			end
		end)
	end
end

function TopDown:stop()
	self.target, self.path, self.pathToken = nil, nil, nil
end

local function instPosition(inst)
	if inst:IsA("BasePart") then
		return inst.Position
	elseif inst:IsA("Model") then
		return inst:GetPivot().Position
	elseif inst:IsA("Attachment") then
		return inst.WorldPosition
	end
	return nil
end

function TopDown:_setFocus(inst)
	if inst == self.focused then
		return
	end
	if self.focusFx then
		self.focusFx:Destroy()
		self.focusFx = nil
	end
	self.focused = inst
	local io = self.o.interact
	if inst and io then
		local folder = Instance.new("Folder")
		folder.Name = "KitFocus"
		if io.highlight and (inst:IsA("BasePart") or inst:IsA("Model")) then
			local hl = Instance.new("Highlight")
			hl.FillTransparency = 0.85
			hl.OutlineColor = Color3.new(1, 1, 1)
			hl.DepthMode = Enum.HighlightDepthMode.Occluded
			hl.Adornee = inst
			hl.Parent = folder
		end
		if io.prompt and not UserInputService.TouchEnabled then
			local bb = Instance.new("BillboardGui")
			bb.Size = UDim2.fromOffset(44, 44)
			bb.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
			bb.AlwaysOnTop = true
			bb.Adornee = if inst:IsA("Model") then inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
				else inst
			local key = Instance.new("TextLabel")
			key.Size = UDim2.fromScale(1, 1)
			key.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
			key.BackgroundTransparency = 0.2
			key.Text = tostring(io.prompt)
			key.TextColor3 = Color3.new(1, 1, 1)
			key.Font = Enum.Font.GothamBold
			key.TextScaled = true
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.3, 0)
			c.Parent = key
			key.Parent = bb
			bb.Parent = folder
		end
		folder.Parent = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui") or workspace
		self.focusFx = folder
	end
	self.FocusChanged:Fire(inst)
end

function TopDown:_scan(s)
	local io = self.o.interact
	if not io then
		return
	end
	local list = if io.candidates then io.candidates() else CollectionService:GetTagged(io.tag or "Interactable")
	local best, bestD = nil, io.radius
	local here = s.root.Position
	for _, inst in list or {} do
		if typeof(inst) == "Instance" and inst:IsDescendantOf(workspace) and (not io.filter or io.filter(inst)) then
			local p = instPosition(inst)
			if p then
				local d = (p - here).Magnitude
				if d < bestD then
					best, bestD = inst, d
				end
			end
		end
	end
	self:_setFocus(best)
end

function TopDown:focus()
	return self.focused
end

function TopDown:_step(dt)
	local s = self.s
	if not s or not self.enabled or not s.root.Parent or s.humanoid.Health <= 0 then
		return
	end
	local o, h, root = self.o, s.humanoid, s.root
	local intent = Common.moveIntent(h)
	if intent.Magnitude > 0.1 then
		self:stop()
	elseif self.target then
		local goal = self.target
		local wp = self.path and self.path[1]
		if wp then
			goal = wp.Position
			if wp.Action == Enum.PathWaypointAction.Jump then
				h.Jump = true
			end
		end
		local to = flat(goal - root.Position)
		local d = to.Magnitude
		if wp and d < 2 then
			table.remove(self.path, 1)
		elseif not wp and d < 0.6 then
			local at = self.target
			self:stop()
			self.Arrived:Fire(at)
		else
			-- ease in over the last few studs so arrivals settle instead of overshooting
			local slow = if wp then 1 else math.clamp(d / o.arrive, 0.25, 1)
			intent = to.Unit * slow
		end
	end
	s.mover:step(dt, intent, { speed = o.speed, accel = o.accel, decel = o.decel, turn = o.turn, air = 0.8 }, grounded(h))
	-- smooth facing toward travel
	local v = s.mover.vel
	if v.Magnitude > 1 then
		local yaw = Common.yawOf(root.CFrame.LookVector)
		local goalYaw = Common.yawOf(v)
		yaw = Common.dampAngle(yaw, goalYaw, o.turnRate, dt)
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
	end
	s.scan += dt
	if s.scan >= 0.1 then
		s.scan = 0
		self:_scan(s)
	end
end

function TopDown:Destroy()
	self.maid:Clean()
	for _, n in { "FocusChanged", "Interacted", "MoveTargetSet", "Arrived" } do
		self[n]:Destroy()
	end
end

------------------------------------------------------------------------------------------------ shooter / vehicle
local function sub(name)
	local mod = require((script.Parent :: Instance):WaitForChild(name))
	return mod
end

-- See ControllerKit_Shooter for the opts tables.
function ControllerKit.shooter(opts)
	return sub("ControllerKit_Shooter").client(opts)
end

function ControllerKit.shooterServer(opts)
	return sub("ControllerKit_Shooter").server(opts)
end

-- Weapon presets shared by client and server (rifle, smg, pistol, shotgun, sniper, launcher).
function ControllerKit.weapons()
	return sub("ControllerKit_Shooter").WEAPONS
end

-- See ControllerKit_Vehicle for the opts table.
function ControllerKit.vehicle(model, opts)
	return sub("ControllerKit_Vehicle").new(model, opts)
end

-- The tuned defaults of each profile (read-only reference for games and for the builder).
ControllerKit.defaults = { platformer = PLATFORMER, topDown = TOPDOWN }

return ControllerKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ControllerKit_Common</string>
          <string name="Source"><![CDATA[--!nonstrict
-- ControllerKit_Common: shared plumbing for ControllerKit's profiles (you rarely need it directly).
--   Signal      tiny event: s:Connect(fn) -> conn (conn:Disconnect()); s:Once(fn); s:Fire(...); s:Wait()
--   Input       one ContextActionService front end for keyboard/mouse, gamepad and touch (touch buttons are built only
--               when UserInputService.TouchEnabled); every binding is undone by the owning Maid
--   Mover       tuned acceleration / deceleration for a Humanoid, applied through WalkSpeed + Humanoid:Move
--   merge, controls, moveIntent, flat, character helpers
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Common = {}

------------------------------------------------------------------------------------------------ helpers
local warned = {}
function Common.warnOnce(key, msg)
	if warned[key] then
		return
	end
	warned[key] = true
	warn("[ControllerKit] " .. msg)
end

local function isPlain(v)
	return type(v) == "table" and getmetatable(v) == nil
end

-- Deep-merges `over` onto a copy of `base` (plain tables only; arrays and instances are replaced, not merged).
function Common.merge(base, over)
	local out = {}
	for k, v in base do
		out[k] = if isPlain(v) then Common.merge(v, {}) else v
	end
	if type(over) == "table" then
		for k, v in over do
			if isPlain(v) and isPlain(out[k]) and #v == 0 then
				out[k] = Common.merge(out[k], v)
			else
				out[k] = v
			end
		end
	end
	return out
end

function Common.flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

function Common.clampMagnitude(v, max)
	local m = v.Magnitude
	if m > max and m > 0 then
		return v * (max / m)
	end
	return v
end

function Common.alpha(rate, dt)
	if rate <= 0 or dt <= 0 then
		return 0
	end
	return 1 - math.exp(-rate * dt)
end

function Common.damp(a, b, rate, dt)
	return a + (b - a) * Common.alpha(rate, dt)
end

function Common.wrap(a)
	return (a + math.pi) % (2 * math.pi) - math.pi
end

function Common.dampAngle(a, b, rate, dt)
	return a + Common.wrap(b - a) * Common.alpha(rate, dt)
end

function Common.smoothstep(e0, e1, x)
	if e1 == e0 then
		return if x >= e1 then 1 else 0
	end
	local t = math.clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end

-- Yaw (radians) of a look vector, matching CFrame.fromEulerAnglesYXZ(0, yaw, 0).
function Common.yawOf(v)
	return math.atan2(-v.X, -v.Z)
end

function Common.lookOfYaw(yaw)
	return Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
end

function Common.color(v, default)
	if typeof(v) == "Color3" then
		return v
	elseif type(v) == "string" then
		local ok, c = pcall(Color3.fromHex, v)
		if ok then
			return c
		end
	end
	return default
end

function Common.sibling(name)
	local ok, mod = pcall(function()
		return require((script.Parent :: Instance):WaitForChild(name, 5))
	end)
	return if ok then mod else nil
end

-- The default PlayerModule controls (nil when a game replaced them).
function Common.controls()
	local player = Players.LocalPlayer
	local ps = player and player:FindFirstChildOfClass("PlayerScripts")
	local pm = ps and ps:FindFirstChild("PlayerModule")
	if not pm then
		return nil
	end
	local ok, mod = pcall(require, pm)
	if not ok or type(mod) ~= "table" or type(mod.GetControls) ~= "function" then
		return nil
	end
	local ok2, c = pcall(mod.GetControls, mod)
	return if ok2 then c else nil
end

-- Raw move input (keyboard WASD/arrows, gamepad left stick, touch thumbstick): Vector3 with X = right, Z = back
-- (so forward is -Z), magnitude 0..1. Read through the default controls so every device works the same.
local cachedControls, controlsAt = nil, -1
function Common.rawMove(humanoid)
	if cachedControls == nil and os.clock() - controlsAt > 2 then
		controlsAt = os.clock()
		cachedControls = Common.controls()
	end
	if cachedControls then
		local ok, v = pcall(cachedControls.GetMoveVector, cachedControls)
		if ok and typeof(v) == "Vector3" then
			return v
		end
	end
	-- fallback: world MoveDirection expressed in camera space
	if humanoid then
		local cam = workspace.CurrentCamera
		local md = humanoid.MoveDirection
		if cam and md.Magnitude > 0 then
			local yaw = Common.yawOf(cam.CFrame.LookVector)
			return CFrame.Angles(0, yaw, 0):VectorToObjectSpace(md)
		end
	end
	return Vector3.zero
end

-- Camera-relative move intent in world space (flat, magnitude 0..1).
function Common.moveIntent(humanoid)
	local raw = Common.rawMove(humanoid)
	if raw.Magnitude < 0.05 then
		return Vector3.zero
	end
	local cam = workspace.CurrentCamera
	local yaw = if cam then Common.yawOf(cam.CFrame.LookVector) else 0
	local w = CFrame.Angles(0, yaw, 0):VectorToWorldSpace(Vector3.new(raw.X, 0, raw.Z))
	return Common.clampMagnitude(w, 1)
end

-- Resolves player | character | nil (local player) to (player, character, humanoid, root); waits for a character.
function Common.resolveCharacter(who)
	local player, character
	if typeof(who) == "Instance" and who:IsA("Player") then
		player = who
	elseif typeof(who) == "Instance" and who:IsA("Model") then
		character = who
		player = Players:GetPlayerFromCharacter(who)
	else
		player = Players.LocalPlayer
	end
	if not character and player then
		character = player.Character or player.CharacterAdded:Wait()
	end
	local humanoid = character and character:WaitForChild("Humanoid", 10)
	local root = humanoid and (humanoid.RootPart or character:WaitForChild("HumanoidRootPart", 10))
	return player, character, humanoid, root
end

-- Calls fn(character, humanoid, root) for the current and every future character of `player` (or once for a
-- bare character). Returns a cleanup function.
function Common.eachCharacter(who, fn)
	local conns = {}
	local function run(character)
		task.spawn(function()
			local humanoid = character:WaitForChild("Humanoid", 10)
			local root = humanoid and (humanoid.RootPart or character:WaitForChild("HumanoidRootPart", 10))
			if humanoid and root then
				fn(character, humanoid, root)
			end
		end)
	end
	local player = if typeof(who) == "Instance" and who:IsA("Player") then who else nil
	if typeof(who) == "Instance" and who:IsA("Model") then
		run(who)
		player = nil
	elseif who == nil then
		player = Players.LocalPlayer
	end
	if player then
		if player.Character then
			run(player.Character)
		end
		table.insert(conns, player.CharacterAdded:Connect(run))
	end
	return function()
		for _, c in conns do
			c:Disconnect()
		end
	end
end

------------------------------------------------------------------------------------------------ Signal
local Signal = {}
Signal.__index = Signal
Common.Signal = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	local entry = { fn = fn }
	table.insert(handlers, entry)
	return {
		Connected = true,
		Disconnect = function(conn)
			conn.Connected = false
			local i = table.find(handlers, entry)
			if i then
				table.remove(handlers, i)
			end
		end,
	}
end

function Signal:Once(fn)
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal:Fire(...)
	for _, entry in table.clone(self._handlers) do
		task.spawn(entry.fn, ...)
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:Destroy()
	table.clear(self._handlers)
end

-- Creates one Signal per name on `obj`.
function Common.signals(obj, names)
	for _, n in names do
		obj[n] = Signal.new()
	end
end

------------------------------------------------------------------------------------------------ Input
-- Input.new(maid, prefix) -> input
--   input:bind(name, {keys}, fn(began: boolean, inputObject), {touch = "Label", slot = 1..6, sink = true})
--   input:axis() etc. are profile-specific; Input only owns bindings, the touch pad and their cleanup.
local Input = {}
Input.__index = Input
Common.Input = Input

local PRIORITY = Enum.ContextActionPriority.High.Value + 50
local counter = 0

-- Touch button slots (scale positions, right side of the screen, around the default jump button).
local SLOTS = {
	{ 0.80, 0.56 }, -- 1: above the jump button
	{ 0.68, 0.70 }, -- 2: left of the jump button
	{ 0.68, 0.56 }, -- 3
	{ 0.92, 0.44 }, -- 4
	{ 0.80, 0.42 }, -- 5
	{ 0.56, 0.70 }, -- 6
	{ 0.90, 0.72 }, -- 7: where the jump button sits (used when the profile owns jumping)
}

function Input.new(maid, prefix)
	counter += 1
	local self = setmetatable({ maid = maid, prefix = (prefix or "Kit") .. counter .. "_", names = {}, gui = nil,
		buttons = {}, enabled = true }, Input)
	maid:Give(function()
		self:unbindAll()
	end)
	return self
end

function Input:_pad()
	if self.gui then
		return self.gui
	end
	local player = Players.LocalPlayer
	local pg = player and player:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "KitControls"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	gui.Parent = pg
	self.gui = gui
	self.maid:Give(gui)
	return gui
end

local function makeTouchButton(gui, label, slot)
	local pos = SLOTS[math.clamp(slot or 1, 1, #SLOTS)]
	local b = Instance.new("TextButton")
	b.Name = label
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Position = UDim2.fromScale(pos[1], pos[2])
	b.Size = UDim2.fromOffset(74, 74)
	b.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
	b.BackgroundTransparency = 0.35
	b.Text = label
	b.TextColor3 = Color3.new(1, 1, 1)
	b.TextScaled = true
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Transparency = 0.55
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.18, 0)
	pad.PaddingRight = UDim.new(0.18, 0)
	pad.PaddingTop = UDim.new(0.3, 0)
	pad.PaddingBottom = UDim.new(0.3, 0)
	pad.Parent = b
	b.Parent = gui
	return b
end

-- Binds an action. fn(began, inputObject) runs on press (true) and release (false).
function Input:bind(name, keys, fn, opts)
	opts = opts or {}
	local action = self.prefix .. name
	local sink = opts.sink ~= false
	local function handler(_, state, obj)
		if not self.enabled then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			fn(true, obj)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			fn(false, obj)
		end
		return if sink then Enum.ContextActionResult.Sink else Enum.ContextActionResult.Pass
	end
	if #keys > 0 then
		ContextActionService:BindActionAtPriority(action, handler, false, opts.priority or PRIORITY, table.unpack(keys))
		table.insert(self.names, action)
	end
	if opts.touch and UserInputService.TouchEnabled then
		local gui = self:_pad()
		if gui then
			local b = makeTouchButton(gui, opts.touch, opts.slot)
			self.buttons[name] = b
			b.InputBegan:Connect(function(io)
				if self.enabled and (io.UserInputType == Enum.UserInputType.Touch
					or io.UserInputType == Enum.UserInputType.MouseButton1) then
					b.BackgroundTransparency = 0.1
					fn(true, io)
				end
			end)
			b.InputEnded:Connect(function(io)
				if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
					b.BackgroundTransparency = 0.35
					fn(false, io)
				end
			end)
		end
	end
end

function Input:setEnabled(on)
	self.enabled = on
	if self.gui then
		self.gui.Enabled = on
	end
end

function Input:unbindAll()
	for _, action in self.names do
		ContextActionService:UnbindAction(action)
	end
	table.clear(self.names)
end

------------------------------------------------------------------------------------------------ Mover
-- Humanoid movement with real acceleration: keeps its own horizontal velocity and feeds it to the Humanoid
-- (WalkSpeed = |velocity|, Move(direction)), after the default controls each render step, so it wins.
local Mover = {}
Mover.__index = Mover
Common.Mover = Mover

function Mover.new(humanoid, root)
	return setmetatable({ humanoid = humanoid, root = root, vel = Vector3.zero }, Mover)
end

-- intent: flat world vector (magnitude 0..1). p: {speed, accel, decel, turn, air (0..1 multiplier)}.
function Mover:step(dt, intent, p, grounded)
	local target = intent * p.speed
	local vel = self.vel
	-- in the air, speed above the run speed (long jumps, dives, dashes) is kept while you steer along it
	local cur = vel.Magnitude
	if not grounded and cur > p.speed and intent:Dot(vel) > 0 then
		target = intent.Unit * cur
	end
	local rate
	if intent.Magnitude > 0.05 then
		rate = if vel:Dot(target) < 0 then p.turn else p.accel
	else
		rate = p.decel
	end
	if not grounded then
		rate *= p.air
	end
	vel += Common.clampMagnitude(target - vel, rate * dt)
	-- blocked (walls, slopes): let the real velocity pull ours back so speed is not stored up against a wall
	local actual = Common.flat(self.root.AssemblyLinearVelocity)
	local speed = vel.Magnitude
	if speed > 1 and grounded and actual:Dot(vel / speed) < speed * 0.5 then
		vel = Common.damp(vel, actual, 6, dt)
	end
	self.vel = vel
	self:apply()
end

function Mover:apply()
	local speed = self.vel.Magnitude
	self.humanoid.WalkSpeed = speed
	self.humanoid:Move(if speed > 0.05 then self.vel / speed else Vector3.zero, false)
end

-- Sets the horizontal velocity now (dashes, long jumps, wall kicks), on the body too.
function Mover:set(v)
	v = Common.flat(v)
	self.vel = v
	local cur = self.root.AssemblyLinearVelocity
	self.root.AssemblyLinearVelocity = Vector3.new(v.X, cur.Y, v.Z)
	self:apply()
end

------------------------------------------------------------------------------------------------ render steps
-- Binds fn(dt) to a render step; returns the unbind function.
function Common.renderStep(prefix, priority, fn)
	counter += 1
	local name = prefix .. counter
	RunService:BindToRenderStep(name, priority, fn)
	return function()
		RunService:UnbindFromRenderStep(name)
	end
end

return Common
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ControllerKit_Shooter</string>
          <string name="Source"><![CDATA[--!nonstrict
-- ControllerKit_Shooter: FPS / over-the-shoulder TPS controller (client) and its server half. Use through
-- ControllerKit.shooter(opts) / ControllerKit.shooterServer(opts) / ControllerKit.weapons().
--
-- Networking (client prediction, server authority), one RemoteEvent ReplicatedStorage.KitShooterRemote:
--   client -> server  ("fire", {id, w = weaponName, o = origin, d = {unit dirs, one per pellet}, c = {claimed part|false}})
--                     ("hit", {id, p = position, part = Instance?})      projectile impact (projectile weapons)
--                     ("reload", weaponName)
--   server -> shooter ("confirm", {damage, killed, head})                 hit marker
--                     ("ammo", weaponName, ammo, reserve)                 correction after a rejected shot or a reload
--   server -> others  ("fx", shooter, {w, o, e = {end points}} | {w, o, d, projectile = true})   tracers / projectiles
-- The client draws its own tracers, impacts and hit markers the instant it fires and predicts its own ammo. The server
-- owns ammo and fire rate, checks the origin is at the shooter, re-casts every ray, accepts a claimed hit only within
-- hitTolerance studs of its ray with nothing solid in between (lag tolerance), applies falloff and headshots, and
-- calls onDamage. Weapon stats come from the SERVER's table: pass the same `weapons` overrides to both halves.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Common = require((script.Parent :: Instance):WaitForChild("ControllerKit_Common"))
local Maid = require((script.Parent :: Instance):WaitForChild("Maid"))
local Spring = require((script.Parent :: Instance):WaitForChild("Spring"))

local IS_CLIENT = RunService:IsClient()
local CameraRig = if IS_CLIENT then Common.sibling("CameraRig") else nil
local merge, flat = Common.merge, Common.flat
local K = Enum.KeyCode
local UT = Enum.UserInputType
local REMOTE_NAME = "KitShooterRemote"

local Shooter = {}

-- Weapon presets. Degrees for spread / recoil, studs for distances, rounds per minute for rate.
--   damage, headshot (multiplier), rpm, auto, pellets, magazine, reserve, reload (s), range, adsFov,
--   spread = {hip, ads, move (added at full speed), crouch (multiplier), bloom (per shot), bloomMax, recover (1/s)}
--   falloff = {start, finish, min} | false, recoil = {pitch, yaw, kick (view kick deg), recover (1/s), back (studs)}
--   mode = "hitscan" | "projectile", projectile = {speed, gravity (x workspace.Gravity), splash = {radius, damage, min}}
--   tracer = Color3 | "#hex"
Shooter.WEAPONS = {
	rifle = { damage = 24, headshot = 1.8, rpm = 600, auto = true, pellets = 1, magazine = 30, reserve = 180, reload = 2.0,
		range = 700, adsFov = 50, mode = "hitscan", tracer = "#FFE6A8",
		spread = { hip = 2.2, ads = 0.3, move = 1.8, crouch = 0.7, bloom = 0.35, bloomMax = 3, recover = 6 },
		falloff = { start = 120, finish = 420, min = 0.55 },
		recoil = { pitch = 1.0, yaw = 0.45, kick = 1.6, recover = 6, back = 0.12 } },
	smg = { damage = 15, headshot = 1.5, rpm = 900, auto = true, pellets = 1, magazine = 35, reserve = 210, reload = 1.7,
		range = 400, adsFov = 58, mode = "hitscan", tracer = "#FFE6A8",
		spread = { hip = 3.0, ads = 0.9, move = 1.2, crouch = 0.75, bloom = 0.25, bloomMax = 2.5, recover = 8 },
		falloff = { start = 50, finish = 180, min = 0.45 },
		recoil = { pitch = 0.55, yaw = 0.5, kick = 1.1, recover = 9, back = 0.08 } },
	pistol = { damage = 30, headshot = 2.0, rpm = 380, auto = false, pellets = 1, magazine = 12, reserve = 72, reload = 1.4,
		range = 500, adsFov = 60, mode = "hitscan", tracer = "#FFF2D0",
		spread = { hip = 1.4, ads = 0.2, move = 1.0, crouch = 0.8, bloom = 0.6, bloomMax = 2.5, recover = 7 },
		falloff = { start = 60, finish = 220, min = 0.5 },
		recoil = { pitch = 2.2, yaw = 0.6, kick = 2.4, recover = 8, back = 0.16 } },
	shotgun = { damage = 11, headshot = 1.3, rpm = 80, auto = false, pellets = 9, magazine = 6, reserve = 36, reload = 2.6,
		range = 160, adsFov = 62, mode = "hitscan", tracer = "#FFD9A0",
		spread = { hip = 5.5, ads = 4.0, move = 0.8, crouch = 0.9, bloom = 0, bloomMax = 0, recover = 6 },
		falloff = { start = 20, finish = 80, min = 0.2 },
		recoil = { pitch = 4.5, yaw = 1.0, kick = 5, recover = 5, back = 0.3 } },
	sniper = { damage = 95, headshot = 2.5, rpm = 45, auto = false, pellets = 1, magazine = 5, reserve = 25, reload = 2.8,
		range = 2000, adsFov = 22, mode = "hitscan", tracer = "#BFE8FF",
		spread = { hip = 6, ads = 0, move = 3, crouch = 0.6, bloom = 0, bloomMax = 0, recover = 4 },
		falloff = false,
		recoil = { pitch = 5, yaw = 0.8, kick = 6, recover = 4, back = 0.35 } },
	launcher = { damage = 30, headshot = 1, rpm = 50, auto = false, pellets = 1, magazine = 1, reserve = 12, reload = 2.4,
		range = 900, adsFov = 55, mode = "projectile", tracer = "#FF9A4A",
		projectile = { speed = 220, gravity = 0.25, splash = { radius = 12, damage = 90, min = 0.2 } },
		spread = { hip = 1.2, ads = 0.2, move = 1, crouch = 0.8, bloom = 0, bloomMax = 0, recover = 4 },
		falloff = false,
		recoil = { pitch = 3.5, yaw = 0.6, kick = 4, recover = 5, back = 0.3 } },
}

local function weaponByName(name, overrides)
	local base = Shooter.WEAPONS[name]
	local over = overrides and overrides[name]
	if base == nil and over == nil then
		return nil
	end
	local w = merge(base or Shooter.WEAPONS.rifle, over)
	w.name = name
	return w
end

local function resolveWeapon(spec, overrides)
	if type(spec) == "table" then
		local name = spec.name or "custom"
		local w = merge(weaponByName(spec.base or name, overrides) or Shooter.WEAPONS.rifle, spec)
		w.name = name
		return w
	end
	return weaponByName(tostring(spec or "rifle"), overrides) or weaponByName("rifle")
end

local function falloffMult(w, dist)
	local f = w.falloff
	if not f then
		return 1
	end
	return 1 + (f.min - 1) * Common.smoothstep(f.start, f.finish, dist)
end

local function humanoidOf(part)
	if typeof(part) ~= "Instance" then
		return nil
	end
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local h = model:FindFirstChildOfClass("Humanoid")
		if h then
			return h, model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

------------------------------------------------------------------------------------------------ local FX
local fxFolder
local function fx()
	if not fxFolder or not fxFolder.Parent then
		fxFolder = Instance.new("Folder")
		fxFolder.Name = "KitShooterFX"
		fxFolder.Parent = workspace
	end
	return fxFolder
end

local function fxPart(size, cf, color, shape)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = size
	if shape then
		p.Shape = shape
	end
	p.CFrame = cf
	p.Parent = fx()
	return p
end

local function fade(p, seconds, goal)
	goal = goal or {}
	goal.Transparency = 1
	TweenService:Create(p, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
	task.delay(seconds + 0.05, p.Destroy, p)
end

function Shooter.tracer(a, b, color)
	local len = (b - a).Magnitude
	if len < 0.5 then
		return
	end
	local p = fxPart(Vector3.new(0.07, 0.07, len), CFrame.lookAt((a + b) / 2, b), color)
	p.Transparency = 0.1
	fade(p, 0.09, { Size = Vector3.new(0.02, 0.02, len) })
end

function Shooter.impact(pos, normal, color, flesh)
	local c = if flesh then Color3.fromRGB(255, 70, 70) else color
	local p = fxPart(Vector3.one * 0.45, CFrame.new(pos), c, Enum.PartType.Ball)
	fade(p, 0.18, { Size = Vector3.one * 1.3 })
	if not flesh and normal then
		for i = 1, 3 do
			local dir = (normal + Vector3.new(math.sin(i * 2.1), math.cos(i * 1.7), math.sin(i * 3.3)) * 0.7).Unit
			local s = fxPart(Vector3.new(0.08, 0.08, 0.5), CFrame.lookAt(pos, pos + dir), c)
			fade(s, 0.16, { CFrame = CFrame.lookAt(pos + dir * 1.6, pos + dir * 3) })
		end
	end
end

function Shooter.flash(at, color)
	local p = fxPart(Vector3.new(0.5, 0.5, 0.9), at * CFrame.Angles(0, 0, math.random() * 6.28), color)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 6
	light.Range = 12
	light.Parent = p
	p.Transparency = 0.15
	fade(p, 0.05)
end

function Shooter.explosion(pos, radius, color)
	local p = fxPart(Vector3.one * 2, CFrame.new(pos), color, Enum.PartType.Ball)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 8
	light.Range = radius * 2.5
	light.Parent = p
	fade(p, 0.35, { Size = Vector3.one * radius * 2 })
	if CameraRig then
		local cam = workspace.CurrentCamera
		local d = cam and (cam.CFrame.Position - pos).Magnitude or 999
		if d < radius * 4 then
			pcall(CameraRig.shake, math.clamp(0.6 * (1 - d / (radius * 4)), 0, 0.6))
		end
	end
end

------------------------------------------------------------------------------------------------ viewmodel
local function buildViewmodel(color, accent)
	local model = Instance.new("Model")
	model.Name = "KitViewmodel"
	local metal = color or Color3.fromRGB(42, 44, 52)
	local accentC = accent or Color3.fromRGB(255, 176, 64)
	local skin = Color3.fromRGB(234, 184, 146)
	local function part(name, size, cf, col, mat, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Size = size
		p.Color = col
		p.Material = mat or Enum.Material.SmoothPlastic
		if shape then
			p.Shape = shape
		end
		p.CFrame = cf
		p.Parent = model
		return p
	end
	local body = part("Body", Vector3.new(0.32, 0.42, 1.5), CFrame.identity, metal, Enum.Material.Metal)
	part("Barrel", Vector3.new(0.9, 0.14, 0.14), CFrame.new(0, 0.08, -1.15) * CFrame.Angles(0, math.rad(90), 0), metal,
		Enum.Material.Metal, Enum.PartType.Cylinder)
	part("Grip", Vector3.new(0.2, 0.5, 0.26), CFrame.new(0, -0.38, 0.35) * CFrame.Angles(math.rad(-15), 0, 0), metal)
	part("Mag", Vector3.new(0.2, 0.55, 0.3), CFrame.new(0, -0.42, -0.3) * CFrame.Angles(math.rad(8), 0, 0), accentC)
	part("Sight", Vector3.new(0.08, 0.12, 0.25), CFrame.new(0, 0.27, 0.1), accentC, Enum.Material.Neon)
	part("Stock", Vector3.new(0.24, 0.34, 0.5), CFrame.new(0, -0.03, 0.95), metal)
	part("RightHand", Vector3.new(0.3, 0.3, 0.5), CFrame.new(0.05, -0.45, 0.45), skin)
	part("LeftHand", Vector3.new(0.28, 0.26, 0.5), CFrame.new(-0.02, -0.14, -0.72), skin)
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = Vector3.new(0, 0.08, -1.62)
	muzzle.Parent = body
	model.PrimaryPart = body
	return model
end

------------------------------------------------------------------------------------------------ client
-- ControllerKit.shooter(opts). Options:
--   view = "fps" | "tps", weapon = "rifle"|"smg"|"pistol"|"shotgun"|"sniper"|"launcher" | {name, base, ...overrides},
--   weapons = {name = overrides} (same table you give shooterServer)
--   walkSpeed=18, sprintSpeed=28, crouchSpeed=10, adsSpeed=11, accel=120, decel=150
--   fov = 78 (fps) / 70 (tps), sensitivity=1, adsSensitivity=0.6, adsTime=0.16, aimToggle=false
--   viewmodel = true | Model (PrimaryPart + Attachment "Muzzle") | false (fps only), hip = CFrame, ads = CFrame (offsets)
--   crosshair = true, hud = true, camera = {CameraRig.follow overrides} | false
--   keys = {fire, aim, reload, sprint, crouch} (KeyCode / UserInputType lists; touch buttons added automatically)
-- Events: Fired(info), Hit(result), HitConfirmed({damage, killed, head}), ReloadStarted(seconds), Reloaded(),
--   AmmoChanged(ammo, reserve), Aimed(bool), StateChanged(state: "ready"|"reloading"|"empty"|"sprinting")
-- Methods: setEnabled(bool), equip(weapon), reload(), ammo() -> (ammo, reserve), weapon() -> table, state(), Destroy()
local CLIENT = {
	view = "fps", weapon = "rifle", weapons = nil,
	walkSpeed = 18, sprintSpeed = 28, crouchSpeed = 10, adsSpeed = 11, accel = 120, decel = 150,
	fov = nil, sensitivity = 1, adsSensitivity = 0.6, adsTime = 0.16, aimToggle = false,
	viewmodel = true, hip = CFrame.new(0.75, -0.72, -1.55), ads = CFrame.new(0, -0.33, -1.25),
	crosshair = true, hud = true, camera = nil,
	keys = {
		fire = { UT.MouseButton1, K.ButtonR2 },
		aim = { UT.MouseButton2, K.ButtonL2 },
		reload = { K.R, K.ButtonX },
		sprint = { K.LeftShift, K.ButtonL3 },
		crouch = { K.C, K.LeftControl, K.ButtonB },
	},
}
local EVENTS = { "Fired", "Hit", "HitConfirmed", "ReloadStarted", "Reloaded", "AmmoChanged", "Aimed", "StateChanged" }

local Client = {}
Client.__index = Client

function Shooter.client(opts)
	if not IS_CLIENT then
		Common.warnOnce("shooter:server", "shooter runs on the client; use shooterServer on the server")
		return nil
	end
	local o = merge(CLIENT, opts)
	o.fps = string.lower(tostring(o.view)) ~= "tps"
	o.fov = o.fov or (if o.fps then 78 else 70)
	local self = setmetatable({ o = o, maid = Maid.new(), enabled = true, s = nil, held = {}, aiming = false,
		adsAlpha = 0, sprintAlpha = 0, bloom = 0, nextFire = 0, shotId = 0, mags = {}, projectiles = {},
		rng = Random.new(7), recoilPitch = 0, lastShot = -1, stateName = "ready", bobT = 0 }, Client)
	Common.signals(self, EVENTS)
	self.camKick = Spring.new(Vector3.zero, 20, 0.5)
	self.gunKick = Spring.new(Vector3.zero, 24, 0.55)
	self.sway = Spring.new(Vector3.zero, 13, 0.6)

	-- remote (optional: without shooterServer the controller runs offline)
	task.spawn(function()
		local remote = ReplicatedStorage:WaitForChild(REMOTE_NAME, 8)
		if remote and remote:IsA("RemoteEvent") and self.maid then
			self.remote = remote
			self.maid:Give(remote.OnClientEvent:Connect(function(kind, a, b, c)
				self:_onServer(kind, a, b, c)
			end))
		end
	end)

	self:equip(o.weapon)
	local input = Common.Input.new(self.maid, "KitShoot")
	self.input = input
	local keys = o.keys
	input:bind("Fire", keys.fire, function(began)
		self.held.fire = began
		if began then
			self.firePressed = true
		end
	end, { touch = "Fire", slot = 2, sink = false })
	input:bind("Aim", keys.aim, function(began)
		if o.aimToggle or UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			if began then
				self:_setAim(not self.aiming)
			end
		else
			self:_setAim(began)
		end
	end, { touch = "Aim", slot = 1, sink = false })
	input:bind("Reload", keys.reload, function(began)
		if began then
			self:reload()
		end
	end, { touch = "R", slot = 4 })
	input:bind("Sprint", keys.sprint, function(began)
		self.held.sprint = began
	end, { touch = "Run", slot = 6 })
	input:bind("Crouch", keys.crouch, function(began)
		if began then
			self.crouched = not self.crouched
			self:_cameraHeight()
		end
	end, { touch = "Duck", slot = 3 })

	self.baseCam = merge(if o.fps
		then { preset = "shoulder", distance = 0, height = 1.6, offset = Vector3.zero, fov = o.fov, pitch = 0,
			pitchMin = -80, pitchMax = 80, orbit = "free", collision = false, fadeSubject = 4, speed = 60,
			sensitivity = o.sensitivity }
		else { preset = "shoulder", distance = 8, height = 1.6, offset = Vector3.new(2.3, 0.5, 0), fov = o.fov,
			orbit = "free", sensitivity = o.sensitivity }, o.camera)
	if o.camera ~= false and CameraRig then
		self.camera = CameraRig.follow(self.baseCam)
	end
	if o.fps and o.viewmodel then
		local vm = if typeof(o.viewmodel) == "Instance" then o.viewmodel:Clone() else buildViewmodel()
		vm.Parent = workspace.CurrentCamera
		self.viewmodel = vm
		self.maid:Give(vm)
	end
	self:_buildHud()

	self.maid:Give(Common.eachCharacter(nil, function(character, humanoid, root)
		self:_attach(character, humanoid, root)
	end))
	self.maid:Give(Common.renderStep("KitShooter", Enum.RenderPriority.Input.Value + 1, function(dt)
		self:_step(math.min(dt, 0.1))
	end))
	self.maid:Give(Common.renderStep("KitShooterView", Enum.RenderPriority.Camera.Value + 3, function(dt)
		self:_view(math.min(dt, 0.1))
	end))
	self.maid:Give(function()
		self:_detach()
		if self.camera then
			self.camera:stop()
		end
	end)
	return self
end

function Client:_attach(character, humanoid, root)
	self:_detach()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, fx(), workspace.CurrentCamera }
	self.s = { character = character, humanoid = humanoid, root = root, saved = { AutoRotate = humanoid.AutoRotate,
		WalkSpeed = humanoid.WalkSpeed }, mover = Common.Mover.new(humanoid, root), params = params }
	humanoid.AutoRotate = false
end

function Client:_detach()
	local s = self.s
	if s and s.humanoid.Parent then
		s.humanoid.AutoRotate = s.saved.AutoRotate
		s.humanoid.WalkSpeed = s.saved.WalkSpeed
	end
	self.s = nil
end

function Client:equip(spec)
	local w = resolveWeapon(spec, self.o.weapons)
	self.w = w
	local mag = self.mags[w.name]
	if not mag then
		mag = { ammo = w.magazine, reserve = w.reserve }
		self.mags[w.name] = mag
	end
	self.mag = mag
	self.reloading = nil
	self.bloom = 0
	self.AmmoChanged:Fire(mag.ammo, mag.reserve)
	return self
end

function Client:weapon()
	return self.w
end

function Client:ammo()
	return self.mag.ammo, self.mag.reserve
end

function Client:reload()
	local w, mag = self.w, self.mag
	if self.reloading or mag.ammo >= w.magazine or mag.reserve <= 0 then
		return false
	end
	self.reloading = os.clock() + w.reload
	self:_setAim(false)
	self.ReloadStarted:Fire(w.reload)
	if self.remote then
		self.remote:FireServer("reload", w.name)
	end
	return true
end

function Client:_setAim(on)
	on = on == true
	if on and (self.reloading or self.sprinting) then
		on = false
	end
	if on == self.aiming then
		return
	end
	self.aiming = on
	if self.camera then
		local o = self.o
		self.camera:set({ fov = if on then self.w.adsFov else o.fov,
			sensitivity = o.sensitivity * (if on then o.adsSensitivity else 1),
			distance = if o.fps then 0 else (if on then 4.5 else self.baseCam.distance),
			zoomSpeed = 1 / math.max(o.adsTime, 0.02) * 2.2 })
	end
	self.Aimed:Fire(on)
end

function Client:_cameraHeight()
	if self.camera then
		self.camera:set({ height = self.baseCam.height - (if self.crouched then 1.3 else 0) })
	end
end

function Client:setEnabled(on)
	on = on ~= false
	self.enabled = on
	self.input:setEnabled(on)
	self.held = {}
	self:_setAim(false)
	if self.hud then
		self.hud.Enabled = on
	end
	if self.viewmodel then
		self.viewmodel.Parent = if on then workspace.CurrentCamera else nil
	end
	if self.s then
		self.s.humanoid.AutoRotate = not on
	end
	if self.camera and not on then
		self.camera:stop()
		self.camera = nil
	elseif on and not self.camera and self.o.camera ~= false and CameraRig then
		self.camera = CameraRig.follow(self.baseCam)
	end
	return self
end

function Client:_setState(name)
	if name ~= self.stateName then
		self.stateName = name
		self.StateChanged:Fire(name)
	end
end

function Client:state()
	return { state = self.stateName, aiming = self.aiming, sprinting = self.sprinting == true, crouched = self.crouched == true,
		ammo = self.mag.ammo, reserve = self.mag.reserve, weapon = self.w.name, spread = self:_spread() }
end

function Client:_spread()
	local sp = self.w.spread
	local base = sp.hip + (sp.ads - sp.hip) * self.adsAlpha
	local s = self.s
	local speedFrac = if s then math.clamp(s.mover.vel.Magnitude / self.o.walkSpeed, 0, 1.5) else 0
	base += sp.move * speedFrac * (1 - 0.7 * self.adsAlpha)
	if self.crouched then
		base *= sp.crouch
	end
	return base + self.bloom
end

-- Muzzle world position for tracers.
function Client:_muzzle(cam)
	local vm = self.viewmodel
	if vm and vm.Parent then
		local m = vm:FindFirstChild("Muzzle", true)
		if m and m:IsA("Attachment") then
			return m.WorldPosition
		end
	end
	local s = self.s
	if s then
		return (s.root.CFrame * CFrame.new(1.1, 1.0, -1.4)).Position
	end
	return cam.CFrame.Position
end

function Client:_fire(cam)
	local o, w, s, mag = self.o, self.w, self.s, self.mag
	local camCF = cam.CFrame
	local origin = camCF.Position
	local aimDir = camCF.LookVector
	if not o.fps then
		-- TPS: find what the crosshair is on, then shoot at it from the head (never from behind the character)
		local hit = workspace:Raycast(origin, aimDir * w.range, s.params)
		local aimPoint = if hit then hit.Position else origin + aimDir * w.range
		local head = s.character:FindFirstChild("Head")
		origin = if head then head.Position else s.root.Position + Vector3.new(0, 1.5, 0)
		aimDir = (aimPoint - origin).Unit
	end
	local spreadRad = math.rad(self:_spread())
	local dirs, claims, ends = {}, {}, {}
	local muzzle = self:_muzzle(cam)
	local color = Common.color(w.tracer, Color3.fromRGB(255, 230, 168))
	self.shotId += 1
	local id = self.shotId
	local look = CFrame.lookAt(Vector3.zero, aimDir)
	for i = 1, math.max(1, w.pellets) do
		local a = self.rng:NextNumber() * math.pi * 2
		local r = spreadRad * math.sqrt(self.rng:NextNumber())
		local dir = (look * CFrame.Angles(0, 0, a) * CFrame.Angles(r, 0, 0)).LookVector
		dirs[i] = dir
		if w.mode == "projectile" then
			claims[i] = false
		else
			local hit = workspace:Raycast(origin, dir * w.range, s.params)
			local endPos = if hit then hit.Position else origin + dir * w.range
			ends[i] = endPos
			claims[i] = if hit then hit.Instance else false
			Shooter.tracer(muzzle, endPos, color)
			if hit then
				local hum = humanoidOf(hit.Instance)
				Shooter.impact(hit.Position, hit.Normal, color, hum ~= nil)
				self.Hit:Fire({ part = hit.Instance, position = hit.Position, normal = hit.Normal,
					distance = (hit.Position - origin).Magnitude, humanoid = hum,
					damage = w.damage * falloffMult(w, (hit.Position - origin).Magnitude)
						* (if hit.Instance.Name == "Head" then w.headshot else 1) })
			end
		end
	end
	if w.mode == "projectile" then
		self:_launch(id, muzzle, dirs[1], w, true, color)
	end
	Shooter.flash(CFrame.lookAt(muzzle, muzzle + aimDir), color)
	mag.ammo -= 1
	self.AmmoChanged:Fire(mag.ammo, mag.reserve)
	self.bloom = math.min(self.bloom + w.spread.bloom, w.spread.bloomMax)
	if self.remote then
		self.remote:FireServer("fire", { id = id, w = w.name, o = origin, d = dirs, c = claims })
	end
	-- recoil: a permanent climb the player pulls down (recovered when they stop), and a springy view kick on top
	local rc = w.recoil
	local adsK = 1 - 0.45 * self.adsAlpha
	local yawK = (self.rng:NextNumber() * 2 - 1) * rc.yaw * adsK
	if self.camera then
		local st = self.camera:state()
		if st then
			self.camera:setAngles(st.yaw + yawK, st.pitch + rc.pitch * adsK, true)
			self.recoilPitch += rc.pitch * adsK
		end
	end
	self.camKick:Impulse(Vector3.new(math.rad(rc.kick) * 14 * adsK, math.rad(yawK) * 6, math.rad(yawK) * 10))
	self.gunKick:Impulse(Vector3.new(0, math.rad(rc.kick) * 10, rc.back * 30))
	self.lastShot = os.clock()
	self.Fired:Fire({ weapon = w.name, origin = origin, directions = dirs, ends = ends, id = id })
end

function Client:_launch(id, from, dir, w, own, color)
	local pr = w.projectile or {}
	local ball = fxPart(Vector3.one * 0.6, CFrame.new(from), color, Enum.PartType.Ball)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Brightness = 3
	light.Parent = ball
	table.insert(self.projectiles, { id = id, pos = from, vel = dir * (pr.speed or 200), t = 0, own = own, part = ball,
		w = w, color = color })
end

function Client:_stepProjectiles(dt)
	local list = self.projectiles
	local params = self.s and self.s.params
	for i = #list, 1, -1 do
		local p = list[i]
		local pr = p.w.projectile or {}
		p.vel -= Vector3.new(0, workspace.Gravity * (pr.gravity or 0) * dt, 0)
		local step = p.vel * dt
		local hit = workspace:Raycast(p.pos, step, params)
		p.t += dt
		if hit or p.t > 8 then
			local at = if hit then hit.Position else p.pos
			table.remove(list, i)
			p.part:Destroy()
			local splash = pr.splash
			Shooter.explosion(at, if splash then splash.radius else 3, p.color)
			if p.own then
				if self.remote then
					self.remote:FireServer("hit", { id = p.id, p = at, part = hit and hit.Instance })
				end
				self.Hit:Fire({ part = hit and hit.Instance, position = at, normal = hit and hit.Normal,
					humanoid = hit and humanoidOf(hit.Instance), projectile = true })
			end
		else
			p.pos += step
			p.part.CFrame = CFrame.new(p.pos)
		end
	end
end

function Client:_onServer(kind, a, b, c)
	if kind == "confirm" and type(a) == "table" then
		self.HitConfirmed:Fire(a)
		self:_hitmarker(a.killed, a.head)
	elseif kind == "ammo" then
		local mag = self.mags[a]
		if mag and type(b) == "number" and type(c) == "number" then
			mag.ammo, mag.reserve = b, c
			if mag == self.mag then
				self.AmmoChanged:Fire(b, c)
			end
		end
	elseif kind == "fx" and typeof(a) == "Instance" and a ~= Players.LocalPlayer and type(b) == "table" then
		local w = resolveWeapon(b.w, self.o.weapons)
		local color = Common.color(w.tracer, Color3.new(1, 0.9, 0.7))
		if b.projectile and typeof(b.o) == "Vector3" and typeof(b.d) == "Vector3" then
			self:_launch(-1, b.o, b.d.Unit, w, false, color)
		elseif typeof(b.o) == "Vector3" and type(b.e) == "table" then
			for _, e in b.e do
				if typeof(e) == "Vector3" then
					Shooter.tracer(b.o, e, color)
				end
			end
		end
	end
end

------------------------------------------------------------------------------------------------ HUD
function Client:_buildHud()
	local o = self.o
	if not o.crosshair and not o.hud then
		return
	end
	local pg = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "KitShooterHud"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 4
	gui.Parent = pg
	self.hud = gui
	self.maid:Give(gui)
	local center = Instance.new("Frame")
	center.AnchorPoint = Vector2.new(0.5, 0.5)
	center.Position = UDim2.fromScale(0.5, 0.5)
	center.Size = UDim2.fromOffset(0, 0)
	center.BackgroundTransparency = 1
	center.Parent = gui
	self.bars = {}
	if o.crosshair then
		for i, d in { Vector2.new(1, 0), Vector2.new(-1, 0), Vector2.new(0, 1), Vector2.new(0, -1) } do
			local bar = Instance.new("Frame")
			bar.AnchorPoint = Vector2.new(0.5, 0.5)
			bar.Size = if d.X ~= 0 then UDim2.fromOffset(10, 2) else UDim2.fromOffset(2, 10)
			bar.BackgroundColor3 = Color3.new(1, 1, 1)
			bar.BorderSizePixel = 0
			local stroke = Instance.new("UIStroke")
			stroke.Transparency = 0.5
			stroke.Parent = bar
			bar.Parent = center
			self.bars[i] = { frame = bar, dir = d }
		end
		local marker = Instance.new("Frame")
		marker.AnchorPoint = Vector2.new(0.5, 0.5)
		marker.Size = UDim2.fromOffset(26, 26)
		marker.BackgroundTransparency = 1
		marker.Rotation = 45
		marker.Visible = false
		marker.Parent = center
		for _, d in { Vector2.new(1, 0), Vector2.new(-1, 0), Vector2.new(0, 1), Vector2.new(0, -1) } do
			local tick = Instance.new("Frame")
			tick.AnchorPoint = Vector2.new(0.5, 0.5)
			tick.Position = UDim2.new(0.5, d.X * 9, 0.5, d.Y * 9)
			tick.Size = if d.X ~= 0 then UDim2.fromOffset(8, 2) else UDim2.fromOffset(2, 8)
			tick.BorderSizePixel = 0
			tick.BackgroundColor3 = Color3.new(1, 1, 1)
			tick.Parent = marker
		end
		self.marker = marker
	end
	if o.hud then
		local ammo = Instance.new("TextLabel")
		ammo.AnchorPoint = Vector2.new(1, 1)
		ammo.Position = UDim2.new(1, -40, 1, -36)
		ammo.Size = UDim2.fromOffset(260, 56)
		ammo.BackgroundTransparency = 1
		ammo.Font = Enum.Font.GothamBlack
		ammo.TextSize = 44
		ammo.TextXAlignment = Enum.TextXAlignment.Right
		ammo.TextColor3 = Color3.new(1, 1, 1)
		ammo.RichText = true
		local stroke = Instance.new("UIStroke")
		stroke.Transparency = 0.6
		stroke.Thickness = 2
		stroke.Parent = ammo
		ammo.Parent = gui
		self.ammoLabel = ammo
		local function refresh(a, r)
			local col = if a <= math.ceil(self.w.magazine * 0.25) then "#FF6A5A" else "#FFFFFF"
			ammo.Text = string.format('<font color="%s">%d</font><font size="26" transparency="0.4">  /  %d</font>', col,
				a, r)
		end
		self.maid:Give(self.AmmoChanged:Connect(refresh))
		self.maid:Give(self.ReloadStarted:Connect(function()
			ammo.Text = '<font size="26">RELOADING</font>'
		end))
		refresh(self.mag.ammo, self.mag.reserve)
	end
end

function Client:_hitmarker(killed, head)
	local m = self.marker
	if not m then
		return
	end
	m.Visible = true
	local col = if killed then Color3.fromRGB(255, 70, 70) elseif head then Color3.fromRGB(255, 210, 80)
		else Color3.new(1, 1, 1)
	for _, t in m:GetChildren() do
		if t:IsA("Frame") then
			t.BackgroundColor3 = col
		end
	end
	m.Size = UDim2.fromOffset(34, 34)
	TweenService:Create(m, TweenInfo.new(0.12), { Size = UDim2.fromOffset(24, 24) }):Play()
	local token = {}
	self.markerToken = token
	task.delay(if killed then 0.35 else 0.15, function()
		if self.markerToken == token then
			m.Visible = false
		end
	end)
end

------------------------------------------------------------------------------------------------ per-frame
function Client:_step(dt)
	local s, o, w = self.s, self.o, self.w
	local now = os.clock()
	self:_stepProjectiles(dt)
	if not s or not self.enabled or not s.root.Parent or s.humanoid.Health <= 0 then
		return
	end
	local cam = workspace.CurrentCamera
	local h, root, mag = s.humanoid, s.root, self.mag

	-- reload state machine
	if self.reloading and now >= self.reloading then
		local need = w.magazine - mag.ammo
		local take = math.min(need, mag.reserve)
		mag.ammo += take
		mag.reserve -= take
		self.reloading = nil
		self.Reloaded:Fire()
		self.AmmoChanged:Fire(mag.ammo, mag.reserve)
	end

	-- movement: sprint only forward, never while aiming; crouch and ADS slow you down
	local raw = Common.rawMove(h)
	local wantSprint = self.held.sprint and raw.Z < -0.5 and not self.aiming and not self.crouched
	if wantSprint and not self.sprinting then
		self.sprinting = true
	elseif not wantSprint and self.sprinting then
		self.sprinting = false
		self.sprintEnd = now
	end
	local speed = if self.sprinting then o.sprintSpeed elseif self.crouched then o.crouchSpeed
		elseif self.aiming then o.adsSpeed else o.walkSpeed
	s.mover:step(dt, Common.moveIntent(h), { speed = speed, accel = o.accel, decel = o.decel, turn = o.accel * 1.5,
		air = 0.35 }, h.FloorMaterial ~= Enum.Material.Air)
	-- body faces where the camera looks
	local yaw = Common.yawOf(cam.CFrame.LookVector)
	root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)

	-- ADS / sprint blends, bloom recovery
	self.adsAlpha = Common.damp(self.adsAlpha, if self.aiming then 1 else 0, 1 / math.max(o.adsTime, 0.02) * 2.5, dt)
	self.sprintAlpha = Common.damp(self.sprintAlpha, if self.sprinting then 1 else 0, 10, dt)
	self.bloom = Common.damp(self.bloom, 0, w.spread.recover, dt)

	-- fire
	local canFire = not self.reloading and not self.sprinting and now - (self.sprintEnd or -1) > 0.12
	local trigger = if w.auto then self.held.fire else self.firePressed
	self.firePressed = false
	if trigger and canFire then
		if mag.ammo <= 0 then
			if not self:reload() and self.held.fire then
				self.held.fire = w.auto -- dry: hold for autos, click again for semis
			end
		else
			local interval = 60 / w.rpm
			if now >= self.nextFire then
				local shots = 0
				while now >= self.nextFire and mag.ammo > 0 and shots < 3 do
					self:_fire(cam)
					shots += 1
					self.nextFire = math.max(self.nextFire + interval, now - interval)
					if not w.auto then
						self.nextFire = now + interval
						break
					end
				end
			end
		end
	end
	-- recoil recovery once the trigger is released
	if self.camera and self.recoilPitch > 0 and now - self.lastShot > 0.08 then
		local st = self.camera:state()
		if st then
			local rec = self.recoilPitch * Common.alpha(w.recoil.recover, dt)
			self.recoilPitch -= rec
			self.camera:setAngles(st.yaw, st.pitch - rec, true)
		end
	end
	self:_setState(if self.reloading then "reloading" elseif mag.ammo <= 0 then "empty"
		elseif self.sprinting then "sprinting" else "ready")
end

-- After the camera: view kick, viewmodel (bob, sway, ADS, sprint pose, recoil), crosshair spread.
function Client:_view(dt)
	local cam = workspace.CurrentCamera
	if not cam or not self.enabled then
		return
	end
	local kick = self.camKick:Step(dt)
	cam.CFrame = cam.CFrame * CFrame.Angles(kick.X, kick.Y, kick.Z)
	local look = cam.CFrame.LookVector
	local yaw, pitch = Common.yawOf(look), math.asin(math.clamp(look.Y, -1, 1))
	if self.lastYaw then
		local dyaw, dpitch = Common.wrap(yaw - self.lastYaw), pitch - self.lastPitch
		self.sway:Impulse(Vector3.new(math.clamp(dyaw, -0.2, 0.2), math.clamp(dpitch, -0.2, 0.2), 0) * 1.6)
	end
	self.lastYaw, self.lastPitch = yaw, pitch
	local sway = self.sway:Step(dt)
	local gk = self.gunKick:Step(dt)
	local vm = self.viewmodel
	if vm and vm.Parent and vm.PrimaryPart then
		local s = self.s
		local speedFrac = if s then math.clamp(flat(s.root.AssemblyLinearVelocity).Magnitude / self.o.walkSpeed, 0, 1.6)
			else 0
		local grounded = s and s.humanoid.FloorMaterial ~= Enum.Material.Air
		if not grounded then
			speedFrac *= 0.2
		end
		self.bobT += dt * (6 + 5 * speedFrac)
		local bobK = speedFrac * (1 - 0.85 * self.adsAlpha)
		local bob = CFrame.new(math.sin(self.bobT) * 0.045 * bobK, -math.abs(math.cos(self.bobT)) * 0.05 * bobK, 0)
			* CFrame.Angles(0, 0, math.sin(self.bobT) * 0.02 * bobK)
		local swayK = 1 - 0.7 * self.adsAlpha
		local swayCF = CFrame.Angles(sway.Y * 0.6 * swayK, sway.X * 0.8 * swayK, sway.X * 0.9 * swayK)
		local base = self.o.hip:Lerp(self.o.ads, self.adsAlpha)
		local sprintPose = CFrame.new(-0.1, -0.15, 0.1) * CFrame.Angles(math.rad(-18), math.rad(38), math.rad(12))
		local pose = CFrame.identity:Lerp(sprintPose, self.sprintAlpha)
		local dip = CFrame.identity
		if self.reloading then
			local w = self.w
			local t = 1 - math.clamp((self.reloading - os.clock()) / w.reload, 0, 1)
			local k = math.sin(t * math.pi)
			dip = CFrame.new(0, -0.35 * k, 0) * CFrame.Angles(math.rad(-25) * k, 0, math.rad(20) * k)
		end
		local recoil = CFrame.new(0, 0, gk.Z * 0.1) * CFrame.Angles(gk.Y * 0.1, 0, 0)
		vm:PivotTo(cam.CFrame * swayCF * base * bob * pose * dip * recoil)
	end
	-- crosshair
	if self.bars and #self.bars > 0 then
		local vp = cam.ViewportSize
		local gap = math.tan(math.rad(self:_spread())) / math.tan(math.rad(cam.FieldOfView / 2)) * (vp.Y / 2) + 4
		local show = self.adsAlpha < 0.5 and not self.sprinting
		for _, b in self.bars do
			b.frame.Visible = show
			b.frame.Position = UDim2.fromOffset(b.dir.X * (gap + 5), b.dir.Y * (gap + 5))
		end
	end
end

function Client:Destroy()
	self.maid:Clean()
	for _, p in self.projectiles do
		p.part:Destroy()
	end
	table.clear(self.projectiles)
	for _, n in EVENTS do
		self[n]:Destroy()
	end
end

------------------------------------------------------------------------------------------------ server
-- ControllerKit.shooterServer(opts). Options:
--   weapons = {name = overrides}, hitTolerance = 7 (studs a claimed hit may sit off the server ray),
--   maxOriginError = 9 (studs between the claimed origin and the shooter's head), friendlyFire = false,
--   onDamage = function(attacker: Player, humanoid, damage, info) -> false to cancel (default: humanoid:TakeDamage),
--   onKill = function(attacker, humanoid, info)
-- info = {weapon, part, position, distance, head, splash}. Returns server with :Destroy().
local SERVER = { weapons = nil, hitTolerance = 7, maxOriginError = 9, friendlyFire = false, onDamage = nil,
	onKill = nil }

function Shooter.server(opts)
	if IS_CLIENT then
		Common.warnOnce("shooterServer:client", "shooterServer runs on the server (a Script)")
		return nil
	end
	local o = merge(SERVER, opts)
	local maid = Maid.new()
	local remote = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = REMOTE_NAME
		remote.Parent = ReplicatedStorage
		maid:Give(remote)
	end
	local players = {} -- player -> {mags = {name -> {ammo, reserve, reloadUntil}}, tokens, last, shots = {id -> shot}}
	local function stateOf(player)
		local st = players[player]
		if not st then
			st = { mags = {}, tokens = 2, last = os.clock(), shots = {} }
			players[player] = st
		end
		return st
	end
	local function magOf(st, w)
		local m = st.mags[w.name]
		if not m then
			m = { ammo = w.magazine, reserve = w.reserve, reloadUntil = 0 }
			st.mags[w.name] = m
		end
		if m.pending and os.clock() >= m.reloadUntil then
			local take = math.min(w.magazine - m.ammo, m.reserve)
			m.ammo += take
			m.reserve -= take
			m.pending = false
		end
		return m
	end
	local function teammates(a, b)
		if o.friendlyFire or not a or not b or a == b then
			return false
		end
		return a.Team ~= nil and a.Team == b.Team and not a.Neutral
	end
	local function damage(attacker, hum, amount, info)
		if not hum or hum.Health <= 0 or amount <= 0 then
			return nil
		end
		local victim = Players:GetPlayerFromCharacter(hum.Parent)
		if teammates(attacker, victim) or hum.Parent == attacker.Character then
			return nil
		end
		if o.onDamage then
			local ok, res = pcall(o.onDamage, attacker, hum, amount, info)
			if ok and res == false then
				return nil
			end
		else
			hum:TakeDamage(amount)
		end
		local killed = hum.Health <= 0
		if killed and o.onKill then
			task.spawn(o.onKill, attacker, hum, info)
		end
		return killed
	end
	local function broadcast(shooter, payload)
		for _, p in Players:GetPlayers() do
			if p ~= shooter then
				remote:FireClient(p, "fx", shooter, payload)
			end
		end
	end
	local function lineDistance(origin, dir, point)
		local t = math.max((point - origin):Dot(dir), 0)
		return (origin + dir * t - point).Magnitude, t
	end

	maid:Give(remote.OnServerEvent:Connect(function(player, kind, data)
		local character = player.Character
		local myHum = character and character:FindFirstChildOfClass("Humanoid")
		local head = character and character:FindFirstChild("Head")
		if not myHum or myHum.Health <= 0 or not head then
			return
		end
		local st = stateOf(player)
		if kind == "reload" then
			local w = weaponByName(tostring(data), o.weapons)
			if w then
				local m = magOf(st, w)
				if m.ammo < w.magazine and m.reserve > 0 and not m.pending then
					m.pending = true
					m.reloadUntil = os.clock() + w.reload * 0.85
				end
			end
			return
		end
		if type(data) ~= "table" then
			return
		end
		if kind == "fire" then
			local w = weaponByName(tostring(data.w), o.weapons)
			if not w then
				Common.warnOnce("weapon:" .. tostring(data.w), "unknown weapon '" .. tostring(data.w)
					.. "' fired; pass the same weapons table to shooterServer")
				return
			end
			local m = magOf(st, w)
			local now = os.clock()
			local interval = 60 / w.rpm
			st.tokens = math.min(st.tokens + (now - st.last) / interval, 2)
			st.last = now
			local origin, dirs = data.o, data.d
			if m.ammo <= 0 or now < m.reloadUntil or st.tokens < 0.8 or typeof(origin) ~= "Vector3"
				or type(dirs) ~= "table" or #dirs < 1 or #dirs > math.max(1, w.pellets) then
				remote:FireClient(player, "ammo", w.name, m.ammo, m.reserve)
				return
			end
			local root = character:FindFirstChild("HumanoidRootPart")
			local slack = o.maxOriginError + (if root then root.AssemblyLinearVelocity.Magnitude * 0.25 else 0)
			if (origin - head.Position).Magnitude > slack then
				remote:FireClient(player, "ammo", w.name, m.ammo, m.reserve)
				return
			end
			st.tokens -= 1
			m.ammo -= 1
			if w.mode == "projectile" then
				local d = dirs[1]
				if typeof(d) ~= "Vector3" or d.Magnitude < 0.5 then
					return
				end
				st.shots[data.id] = { origin = origin, dir = d.Unit, t = now, w = w }
				broadcast(player, { w = w.name, o = origin, d = d.Unit, projectile = true })
				return
			end
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { character }
			local claims = if type(data.c) == "table" then data.c else {}
			local ends = {}
			local total, anyKill, anyHead = 0, false, false
			local perHum, infos = {}, {}
			for i, d in dirs do
				if typeof(d) ~= "Vector3" or d.Magnitude < 0.5 then
					continue
				end
				d = d.Unit
				local hit = workspace:Raycast(origin, d * w.range, params)
				local part, pos = hit and hit.Instance, hit and hit.Position
				local hum = part and humanoidOf(part)
				local claim = claims[i]
				if not hum and typeof(claim) == "Instance" and claim:IsA("BasePart") and claim:IsDescendantOf(workspace) then
					-- lag tolerance: the client saw a hit the server ray just missed; accept it if it sits close to the
					-- ray, in range, with nothing solid between the shooter and it
					local chum, cmodel = humanoidOf(claim)
					local off, along = lineDistance(origin, d, claim.Position)
					if chum and off <= o.hitTolerance and along <= w.range then
						local los = RaycastParams.new()
						los.FilterType = Enum.RaycastFilterType.Exclude
						los.FilterDescendantsInstances = { character, cmodel }
						if not workspace:Raycast(origin, claim.Position - origin, los) then
							part, pos, hum = claim, claim.Position, chum
						end
					end
				end
				ends[i] = pos or origin + d * w.range
				if hum and pos then
					local dist = (pos - origin).Magnitude
					local isHead = part.Name == "Head"
					local amount = w.damage * falloffMult(w, dist) * (if isHead then w.headshot else 1)
					perHum[hum] = (perHum[hum] or 0) + amount
					anyHead = anyHead or isHead
					infos[hum] = infos[hum] or { weapon = w.name, part = part, position = pos, distance = dist, head = isHead }
				end
			end
			for hum, amount in perHum do
				local killed = damage(player, hum, amount, infos[hum])
				if killed ~= nil then
					total += amount
					anyKill = anyKill or killed
				end
			end
			if total > 0 then
				remote:FireClient(player, "confirm", { damage = total, killed = anyKill, head = anyHead })
			end
			broadcast(player, { w = w.name, o = origin, e = ends })
		elseif kind == "hit" then
			local shot = st.shots[data.id]
			local pos = data.p
			if not shot or typeof(pos) ~= "Vector3" then
				return
			end
			st.shots[data.id] = nil
			local w = shot.w
			local pr = w.projectile or {}
			local elapsed = os.clock() - shot.t
			local dist = (pos - shot.origin).Magnitude
			if dist > (pr.speed or 200) * (elapsed + 0.5) + 10 or dist > w.range + 10 then
				return
			end
			local total, anyKill = 0, false
			local direct = data.part
			local dhum = typeof(direct) == "Instance" and direct:IsA("BasePart") and (direct.Position - pos).Magnitude < 8
				and humanoidOf(direct)
			if dhum then
				local killed = damage(player, dhum, w.damage, { weapon = w.name, part = direct, position = pos,
					distance = dist, head = false })
				if killed ~= nil then
					total += w.damage
					anyKill = anyKill or killed
				end
			end
			local splash = pr.splash
			if splash then
				local seen = {}
				for _, part in workspace:GetPartBoundsInRadius(pos, splash.radius) do
					local hum, model = humanoidOf(part)
					if hum and not seen[hum] and model then
						seen[hum] = true
						local pivot = model:GetPivot().Position
						local k = 1 - math.clamp((pivot - pos).Magnitude / splash.radius, 0, 1)
						local amount = splash.damage * ((splash.min or 0) + (1 - (splash.min or 0)) * k)
						local killed = damage(player, hum, amount, { weapon = w.name, part = part, position = pos,
							distance = dist, head = false, splash = true })
						if killed ~= nil then
							total += amount
							anyKill = anyKill or killed
						end
					end
				end
			end
			if total > 0 then
				remote:FireClient(player, "confirm", { damage = total, killed = anyKill, head = false })
			end
		end
	end))
	maid:Give(Players.PlayerRemoving:Connect(function(p)
		players[p] = nil
	end))
	-- forget projectile shots that never reported an impact
	maid:Give(task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for _, st in players do
				for id, shot in st.shots do
					if now - shot.t > 10 then
						st.shots[id] = nil
					end
				end
			end
		end
	end))
	-- refill on respawn
	maid:Give(Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			players[p] = nil
		end)
	end))
	for _, p in Players:GetPlayers() do
		maid:Give(p.CharacterAdded:Connect(function()
			players[p] = nil
		end))
	end
	return { remote = remote, Destroy = function()
		maid:Clean()
	end }
end

return Shooter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">ControllerKit_Vehicle</string>
          <string name="Source"><![CDATA[--!nonstrict
-- ControllerKit_Vehicle: arcade vehicles (kart, car, hover, boat). Use through ControllerKit.vehicle(model, opts).
--
--   SERVER  ControllerKit.vehicle(nil | model, opts) -> handle   spawns the default chassis (or adopts your model) with a
--           Seat. Whoever sits gets network ownership of the root; the root is anchored while nobody drives.
--   CLIENT  ControllerKit.vehicle(model | "seated", opts) -> handle   drives `model` (or any KitVehicle) while the local
--           player sits in it. Pass the same opts as the server (kind + overrides).
--   CLIENT  ControllerKit.vehicle(nil, opts) -> handle   builds a client-only vehicle at opts.spawn and drives it now.
--
-- Simulation (client, the driver): a deterministic fixed 120 Hz step, rendered interpolated. Raycast suspension per
-- wheel / probe (stiffness as a natural frequency in Hz + damping ratio, so ride height never depends on mass), lateral
-- grip, drift with boost tiers, airborne / landing, wall slide via sphere casts, buoyancy on Terrain water or a height
-- function, hover over ground and water. Visual body squat / lean / bob and wheel travel are local Motor6D transforms.
-- A custom model needs a PrimaryPart (the root; its -Z is forward); optional: a Seat, Motor6D "Body" (root -> visible
-- body), Motor6Ds named "Wheel1".."WheelN" (root -> wheel); probe points default to the wheel joints or box corners.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Common = require((script.Parent :: Instance):WaitForChild("ControllerKit_Common"))
local Maid = require((script.Parent :: Instance):WaitForChild("Maid"))

local IS_CLIENT = RunService:IsClient()
local CameraRig = if IS_CLIENT then Common.sibling("CameraRig") else nil
local merge, flat, smoothstep, alpha = Common.merge, Common.flat, Common.smoothstep, Common.alpha
local K = Enum.KeyCode
local STEP = 1 / 120
local MAX_STEPS = 8
local YAXIS = Vector3.yAxis

local Vehicle = {}

-- Kind presets. Speeds studs/s, accelerations studs/s^2, rates 1/s, angles radians, times seconds.
--   size (root box), probes {Vector3} (root-local, at chassis centre height), wheelRadius, rest (suspension travel),
--   freq (Hz), ratio (damping), water = false | true (Terrain water + waterLevel / waterHeight), maxSpeed, accel,
--   brake, reverse (max), reverseAccel, drag, coast, grip, driftGrip, steer, steerHigh, steerFull (speed for full
--   steering), steerResponse, airSteer, align (how much velocity turns with the heading), hop, airGravity,
--   drift = {minSpeed, steerMin, steerMax, rate, tiers = {charge seconds}, boosts = {boost seconds}, colors} | false,
--   boost = {speed (max speed multiplier), accel, fov, shake}, squat, lean, wallBounce, wallScrape,
--   camera = {distance, height, pitch, fov, rotSpeed, speedFov, lookAtVelocity}, color, accent
local KINDS = {
	kart = {
		size = Vector3.new(4.4, 1.1, 6.2), wheelRadius = 0.85, rest = 0.9, freq = 3.4, ratio = 0.65, water = false,
		probes = { Vector3.new(-1.95, 0, -2.25), Vector3.new(1.95, 0, -2.25), Vector3.new(-1.95, 0, 2.25),
			Vector3.new(1.95, 0, 2.25) },
		maxSpeed = 88, accel = 75, brake = 150, reverse = 30, reverseAccel = 45, drag = 0.15, coast = 0.6,
		grip = 10, driftGrip = 2.2, steer = 2.7, steerHigh = 1.7, steerFull = 14, steerResponse = 12, airSteer = 0.35,
		align = 0.85, hop = 22, airGravity = 1.45,
		drift = { minSpeed = 30, steerMin = 0.35, steerMax = 1.25, rate = 2.4, tiers = { 0.6, 1.3, 2.2 },
			boosts = { 0.55, 1.0, 1.6 }, colors = { "#6FD3FF", "#FF9A3C", "#D07CFF" } },
		boost = { speed = 1.35, accel = 170, fov = 10, shake = 0.18 },
		squat = 0.0012, lean = 0.0011, wallBounce = 0.25, wallScrape = 0.25,
		camera = { distance = 14, height = 3, pitch = -12, fov = 70, rotSpeed = 5, lookAtVelocity = 0.35 },
		color = "#E8453C", accent = "#FFD23F",
	},
	car = {
		size = Vector3.new(5.2, 1.6, 9.6), wheelRadius = 1.1, rest = 1.2, freq = 2.5, ratio = 0.5, water = false,
		probes = { Vector3.new(-2.35, 0, -3.3), Vector3.new(2.35, 0, -3.3), Vector3.new(-2.35, 0, 3.3),
			Vector3.new(2.35, 0, 3.3) },
		maxSpeed = 120, accel = 62, brake = 140, reverse = 40, reverseAccel = 40, drag = 0.12, coast = 0.4,
		grip = 8, driftGrip = 2.6, steer = 2.1, steerHigh = 0.95, steerFull = 18, steerResponse = 9, airSteer = 0.2,
		align = 0.8, hop = 0, airGravity = 1.3,
		drift = { minSpeed = 40, steerMin = 0.3, steerMax = 1.2, rate = 2.0, tiers = { 0.8, 1.7, 2.8 },
			boosts = { 0.5, 0.9, 1.4 }, colors = { "#6FD3FF", "#FF9A3C", "#D07CFF" } },
		boost = { speed = 1.3, accel = 150, fov = 12, shake = 0.2 },
		squat = 0.0016, lean = 0.0014, wallBounce = 0.2, wallScrape = 0.3,
		camera = { distance = 19, height = 4, pitch = -11, fov = 70, rotSpeed = 4.5, lookAtVelocity = 0.3 },
		color = "#2F6FE4", accent = "#F2F4F8",
	},
	hover = {
		size = Vector3.new(4.6, 1.2, 7.2), wheelRadius = 0, rest = 3.8, freq = 2.0, ratio = 0.32, water = true,
		probes = { Vector3.new(-1.9, 0, -2.8), Vector3.new(1.9, 0, -2.8), Vector3.new(-1.9, 0, 2.8),
			Vector3.new(1.9, 0, 2.8) },
		maxSpeed = 105, accel = 58, brake = 90, reverse = 35, reverseAccel = 40, drag = 0.1, coast = 0.25,
		grip = 3.2, driftGrip = 1.1, steer = 2.4, steerHigh = 1.6, steerFull = 8, steerResponse = 7, airSteer = 0.6,
		align = 0.6, hop = 26, airGravity = 1.15,
		drift = { minSpeed = 30, steerMin = 0.4, steerMax = 1.3, rate = 2.6, tiers = { 0.7, 1.5, 2.4 },
			boosts = { 0.6, 1.0, 1.5 }, colors = { "#6FFFE9", "#FF6FD8", "#FFFFFF" } },
		boost = { speed = 1.35, accel = 150, fov = 12, shake = 0.15 },
		squat = 0.0016, lean = 0.0018, wallBounce = 0.45, wallScrape = 0.15,
		camera = { distance = 16, height = 3.5, pitch = -12, fov = 72, rotSpeed = 4, lookAtVelocity = 0.45 },
		color = "#7B5CF6", accent = "#6FFFE9",
	},
	boat = {
		size = Vector3.new(4.6, 1.6, 9.2), wheelRadius = 0, rest = 1.7, freq = 2.2, ratio = 0.3, water = true,
		probes = { Vector3.new(0, 0, -3.8), Vector3.new(-1.8, 0, -1.3), Vector3.new(1.8, 0, -1.3),
			Vector3.new(-1.9, 0, 2.4), Vector3.new(1.9, 0, 2.4), Vector3.new(0, 0, 3.9) },
		maxSpeed = 78, accel = 46, brake = 60, reverse = 22, reverseAccel = 30, drag = 0.25, coast = 0.5,
		grip = 2.4, driftGrip = 0.9, steer = 1.8, steerHigh = 1.25, steerFull = 10, steerResponse = 5, airSteer = 0.3,
		align = 0.55, hop = 0, airGravity = 1.25,
		drift = { minSpeed = 28, steerMin = 0.4, steerMax = 1.3, rate = 2.0, tiers = { 0.8, 1.7, 2.6 },
			boosts = { 0.6, 1.0, 1.5 }, colors = { "#BFF4FF", "#FFE08A", "#FF8AD8" } },
		boost = { speed = 1.3, accel = 120, fov = 10, shake = 0.15 },
		squat = 0.0035, lean = 0.0022, wallBounce = 0.35, wallScrape = 0.2, landDrag = 3.5, bob = 1,
		camera = { distance = 18, height = 4, pitch = -11, fov = 70, rotSpeed = 3.5, lookAtVelocity = 0.25 },
		color = "#F5F1E6", accent = "#1FA2B8",
	},
}
Vehicle.KINDS = KINDS

local ALL_OPTS = { kind = "kart", spawn = nil, seat = true, camera = nil, input = nil, waterLevel = nil,
	waterHeight = nil, gravity = 1, keys = { drift = { K.Space, K.LeftShift, K.ButtonR1, K.ButtonL1 },
	reset = { K.R, K.ButtonY }, exit = { K.F, K.ButtonB } } }

local function config(opts, model)
	opts = opts or {}
	local kind = opts.kind or (model and model:GetAttribute("KitVehicle")) or "kart"
	kind = string.lower(tostring(kind))
	local base = KINDS[kind]
	if not base then
		Common.warnOnce("kind:" .. kind, "unknown vehicle kind '" .. kind .. "' (kart, car, hover, boat)")
		kind, base = "kart", KINDS.kart
	end
	local cfg = merge(merge(ALL_OPTS, base), opts)
	cfg.kind = kind
	if cfg.drift == true then
		cfg.drift = merge(base.drift or KINDS.kart.drift, {})
	end
	return cfg
end

------------------------------------------------------------------------------------------------ build
local function newPart(model, name, size, cf, color, material, class)
	local p = Instance.new(class or "Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = a, b
	w.Parent = b
	return w
end

-- Builds the default chassis for a kind at CFrame `at`. Returns the model (PrimaryPart = Root).
function Vehicle.build(cfg, at)
	at = at or CFrame.new(0, 10, 0)
	local model = Instance.new("Model")
	model.Name = "Kit" .. cfg.kind:sub(1, 1):upper() .. cfg.kind:sub(2)
	local color = Common.color(cfg.color, Color3.new(0.9, 0.3, 0.25))
	local accent = Common.color(cfg.accent, Color3.new(1, 0.85, 0.3))
	local dark = Color3.fromRGB(32, 34, 40)
	local size = cfg.size
	local root = newPart(model, "Root", size, at, color)
	root.Transparency = 1
	root.Massless = false
	root.CanTouch = true
	root.CanCollide = true -- holds it up during the hand-off to the driver; the sim keeps it clear of the ground
	root.RootPriority = 127
	local body = newPart(model, "Body", Vector3.new(size.X * 0.9, size.Y * 0.55, size.Z * 0.92), at, color)
	local motor = Instance.new("Motor6D")
	motor.Name = "Body"
	motor.Part0, motor.Part1 = root, body
	motor.Parent = root
	local function attach(name, sz, offset, col, mat, class)
		local p = newPart(model, name, sz, at * offset, col, mat, class)
		weld(body, p)
		return p
	end
	local seatOffset
	if cfg.kind == "kart" then
		attach("Bumper", Vector3.new(size.X * 0.75, 0.45, 0.6), CFrame.new(0, -0.05, -size.Z * 0.5), dark)
		attach("PodL", Vector3.new(0.7, 0.6, size.Z * 0.55), CFrame.new(-size.X * 0.42, 0.05, 0.2), accent)
		attach("PodR", Vector3.new(0.7, 0.6, size.Z * 0.55), CFrame.new(size.X * 0.42, 0.05, 0.2), accent)
		attach("SeatBack", Vector3.new(1.6, 1.4, 0.35), CFrame.new(0, 0.85, 1.15) * CFrame.Angles(math.rad(-12), 0, 0), dark)
		attach("Column", Vector3.new(0.25, 0.25, 1.4), CFrame.new(0, 0.55, -0.9) * CFrame.Angles(math.rad(35), 0, 0), dark)
		attach("SteeringWheel", Vector3.new(0.15, 1.0, 1.0), CFrame.new(0, 0.95, -1.35) * CFrame.Angles(math.rad(-55), 0, 0)
			* CFrame.Angles(0, 0, math.rad(90)), dark, nil, "Part").Shape = Enum.PartType.Cylinder
		attach("Spoiler", Vector3.new(size.X * 0.8, 0.18, 0.7), CFrame.new(0, 1.05, size.Z * 0.48), accent)
		seatOffset = CFrame.new(0, 0.3, 0.55)
	elseif cfg.kind == "car" then
		attach("Cabin", Vector3.new(size.X * 0.8, size.Y * 0.55, size.Z * 0.42), CFrame.new(0, size.Y * 0.5, 0.6),
			Color3.fromRGB(40, 48, 62), Enum.Material.Glass).Transparency = 0.25
		attach("Roof", Vector3.new(size.X * 0.78, 0.15, size.Z * 0.36), CFrame.new(0, size.Y * 0.8, 0.7), color)
		for _, x in { -1, 1 } do
			attach("Head", Vector3.new(0.9, 0.3, 0.12), CFrame.new(x * size.X * 0.3, 0.05, -size.Z * 0.46),
				Color3.fromRGB(255, 248, 220), Enum.Material.Neon)
			attach("Tail", Vector3.new(0.9, 0.25, 0.12), CFrame.new(x * size.X * 0.3, 0.1, size.Z * 0.46),
				Color3.fromRGB(255, 50, 60), Enum.Material.Neon)
		end
		attach("Stripe", Vector3.new(0.7, 0.05, size.Z * 0.93), CFrame.new(0, size.Y * 0.28, 0), accent)
		attach("Spoiler", Vector3.new(size.X * 0.85, 0.15, 0.8), CFrame.new(0, size.Y * 0.62, size.Z * 0.43), dark)
		seatOffset = CFrame.new(-size.X * 0.2, 0.15, 0.4)
	elseif cfg.kind == "hover" then
		attach("Nose", Vector3.new(size.X * 0.9, size.Y * 0.55, 2.2), CFrame.new(0, 0, -size.Z * 0.46 - 1.1), color,
			nil, "WedgePart")
		attach("Glow", Vector3.new(size.X * 0.95, 0.12, size.Z * 0.9), CFrame.new(0, -size.Y * 0.3, 0), accent,
			Enum.Material.Neon)
		attach("Fin", Vector3.new(0.25, 1.4, 1.6), CFrame.new(0, 0.9, size.Z * 0.4), accent)
		for i, p in cfg.probes do
			local pod = attach("Pod" .. i, Vector3.new(0.9, 0.5, 0.9), CFrame.new(p.X, -size.Y * 0.35, p.Z), accent,
				Enum.Material.Neon)
			local light = Instance.new("PointLight")
			light.Color = accent
			light.Range = 9
			light.Brightness = 1.5
			light.Parent = pod
		end
		seatOffset = CFrame.new(0, 0.35, 0.6)
	else -- boat
		-- the hull sits a little lower than the root so it rides in the water, not on it
		motor.C0 = CFrame.new(0, -0.5, size.Z * 0.12)
		body.Size = Vector3.new(size.X * 0.92, size.Y * 0.7, size.Z * 0.72)
		body.CFrame = at * motor.C0
		local function hull(offset)
			return CFrame.new(0, -0.5, 0) * offset
		end
		attach("Bow", Vector3.new(size.X * 0.92, size.Y * 0.7, size.Z * 0.3), hull(CFrame.new(0, 0, -size.Z * 0.39)
			* CFrame.Angles(0, 0, math.rad(180))), color, nil, "WedgePart")
		attach("Stripe", Vector3.new(size.X * 0.94, 0.25, size.Z * 0.7), hull(CFrame.new(0, -size.Y * 0.1, size.Z * 0.12)),
			accent)
		attach("Deck", Vector3.new(size.X * 0.8, 0.12, size.Z * 0.6), hull(CFrame.new(0, size.Y * 0.36, size.Z * 0.14)),
			Color3.fromRGB(186, 140, 96), Enum.Material.WoodPlanks)
		attach("Screen", Vector3.new(size.X * 0.7, 1.0, 0.12), hull(CFrame.new(0, size.Y * 0.75, -size.Z * 0.12)
			* CFrame.Angles(math.rad(-25), 0, 0)), Color3.fromRGB(150, 200, 230), Enum.Material.Glass).Transparency = 0.4
		seatOffset = hull(CFrame.new(0, size.Y * 0.4, size.Z * 0.12))
	end
	-- wheels (Motor6D so suspension travel and spin are local transforms)
	if cfg.wheelRadius > 0 then
		for i, p in cfg.probes do
			local wheel = newPart(model, "Wheel" .. i, Vector3.new(0.9, cfg.wheelRadius * 2, cfg.wheelRadius * 2),
				at * CFrame.new(p), dark)
			wheel.Shape = Enum.PartType.Cylinder
			local hub = newPart(model, "Hub" .. i, Vector3.new(0.95, cfg.wheelRadius * 0.9, cfg.wheelRadius * 0.9),
				at * CFrame.new(p), accent)
			hub.Shape = Enum.PartType.Cylinder
			weld(wheel, hub)
			local m = Instance.new("Motor6D")
			m.Name = "Wheel" .. i
			m.Part0, m.Part1 = root, wheel
			m.C0 = CFrame.new(p)
			m.Parent = root
		end
	end
	-- drift sparks / boost flames at the rear
	local rearZ = size.Z * 0.5
	for _, x in { -1, 1 } do
		local a = Instance.new("Attachment")
		a.Name = "Spark"
		a.Position = Vector3.new(x * size.X * 0.42, -size.Y * 0.4, rearZ)
		a.Parent = root
		local e = Instance.new("ParticleEmitter")
		e.Name = "Sparks"
		e.Enabled = false
		e.Rate = 70
		e.Lifetime = NumberRange.new(0.12, 0.28)
		e.Speed = NumberRange.new(10, 18)
		e.SpreadAngle = Vector2.new(35, 35)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
		e.LightEmission = 1
		e.Acceleration = Vector3.new(0, -60, 0)
		e.EmissionDirection = Enum.NormalId.Back
		e.Parent = a
		local f = Instance.new("ParticleEmitter")
		f.Name = "Flame"
		f.Enabled = false
		f.Rate = 90
		f.Lifetime = NumberRange.new(0.1, 0.2)
		f.Speed = NumberRange.new(14, 22)
		f.SpreadAngle = Vector2.new(8, 8)
		f.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0.1) })
		f.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 80, 40))
		f.LightEmission = 1
		f.EmissionDirection = Enum.NormalId.Back
		f.Parent = a
	end
	if cfg.seat ~= false then
		local seat = newPart(model, "Seat", Vector3.new(2, 0.4, 2), at * seatOffset, dark, nil, "Seat")
		seat.Transparency = 0.6
		weld(body, seat)
	end
	model.PrimaryPart = root
	model:SetAttribute("KitVehicle", cfg.kind)
	model:SetAttribute("KitBuilt", true)
	return model
end

------------------------------------------------------------------------------------------------ server
local function serverVehicle(model, opts)
	local cfg = config(opts, model)
	local maid = Maid.new()
	if model == nil then
		model = Vehicle.build(cfg, if typeof(cfg.spawn) == "CFrame" then cfg.spawn
			elseif typeof(cfg.spawn) == "Vector3" then CFrame.new(cfg.spawn) else CFrame.new(0, 12, 0))
		model.Parent = workspace
		maid:Give(model)
	end
	model:SetAttribute("KitVehicle", cfg.kind)
	local root = model.PrimaryPart
	if not root then
		Common.warnOnce("vehicle:noroot", "vehicle model '" .. model.Name .. "' needs a PrimaryPart (its root)")
		return nil
	end
	root.Anchored = true
	local seat = model:FindFirstChildWhichIsA("Seat", true) or model:FindFirstChildWhichIsA("VehicleSeat", true)
	local handle = { model = model, root = root, seat = seat, driver = nil, Entered = Common.Signal.new(),
		Exited = Common.Signal.new() }
	if seat then
		maid:Give(seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			local hum = seat.Occupant
			local player = hum and Players:GetPlayerFromCharacter(hum.Parent)
			if player then
				root.Anchored = false
				local ok = pcall(root.SetNetworkOwner, root, player)
				if not ok then
					Common.warnOnce("netowner", "could not give the vehicle to its driver (is a part anchored?)")
				end
				handle.driver = player
				model:SetAttribute("KitDriver", player.UserId)
				handle.Entered:Fire(player)
			else
				local was = handle.driver
				handle.driver = nil
				model:SetAttribute("KitDriver", nil)
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				root.Anchored = true
				if was then
					handle.Exited:Fire(was)
				end
			end
		end))
	end
	function handle:Destroy()
		maid:Clean()
	end
	return handle
end

------------------------------------------------------------------------------------------------ simulation
local Sim = {}
Sim.__index = Sim

local function basis(pos, yaw, up)
	local look = Common.lookOfYaw(yaw)
	local fwd = look - up * look:Dot(up)
	fwd = if fwd.Magnitude > 1e-3 then fwd.Unit else look
	local right = fwd:Cross(up).Unit
	return CFrame.fromMatrix(pos, right, up, -fwd), fwd, right
end

function Sim.new(cfg, model, root)
	local self = setmetatable({ cfg = cfg, model = model, root = root }, Sim)
	local cf = root.CFrame
	self.pos = cf.Position
	self.yaw = Common.yawOf(cf.LookVector)
	self.up = YAXIS
	self.vel = Vector3.zero
	self.yawRate = 0
	self.comp = {}
	self.dist = {}
	self.probes = cfg.probes
	for i = 1, #self.probes do
		self.comp[i] = 0
		self.dist[i] = cfg.rest + cfg.wheelRadius
	end
	local n = #self.probes
	local g = workspace.Gravity * cfg.gravity
	local L = cfg.rest + cfg.wheelRadius
	-- stiffness from a natural frequency, raised if the vehicle would bottom out at rest
	local omega = 2 * math.pi * cfg.freq
	if g / (omega * omega) > cfg.rest * 0.75 then
		omega = math.sqrt(g / (cfg.rest * 0.75))
	end
	self.k = omega * omega / n
	self.c = 2 * cfg.ratio * omega / n
	self.g = g
	self.L = L
	self.rideHeight = L - g / (omega * omega)
	self.grounded, self.airTime, self.traction = false, 0, 0
	self.drifting, self.driftDir, self.charge, self.tier = false, 0, 0, 0
	self.boostT, self.onWater = 0, false
	self.prevCF, self.curCF = cf, cf
	self.accF, self.lastVF = 0, 0
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { model }
	params.IgnoreWater = not cfg.water
	self.params = params
	local half = math.min(cfg.size.X * 0.5 * 0.9, 2.6)
	self.wallR = half
	self.wallZ = math.max(cfg.size.Z * 0.5 - half, 0)
	self.wallLift = half + 0.45 - self.rideHeight
	return self
end

function Sim:addIgnore(inst)
	local list = self.params.FilterDescendantsInstances
	table.insert(list, inst)
	self.params.FilterDescendantsInstances = list
end

function Sim:waterAt(x, z)
	local cfg = self.cfg
	if cfg.waterHeight then
		local ok, y = pcall(cfg.waterHeight, x, z)
		return if ok and type(y) == "number" then y else nil
	end
	return cfg.waterLevel
end

-- One fixed step. input = {throttle -1..1, steer -1..1, drift bool}. Returns events {name, value} for the caller.
function Sim:step(h, input, events)
	local cfg = self.cfg
	local up = self.up
	local cf, fwd, right = basis(self.pos, self.yaw, up)
	local n = #self.probes
	local hits, normalSum, accelUp, water = 0, Vector3.zero, 0, false
	local L = self.L
	-- cast from above the probe so a probe that sank under the surface (hard landings, water) still finds it
	local lift = if cfg.water then L else 0.6
	local floor = if cfg.wheelRadius > 0 then cfg.wheelRadius * 0.4 else -0.5
	for i, p in self.probes do
		local o = cf:PointToWorldSpace(p)
		local d, normal = L, nil
		local hit = workspace:Raycast(o + up * lift, -up * (L + lift), self.params)
		if hit then
			d, normal = hit.Distance - lift, hit.Normal
			if hit.Material == Enum.Material.Water then
				water = true
			end
		end
		if cfg.water then
			local wy = self:waterAt(o.X, o.Z)
			if wy then
				local dw = (o.Y - wy) / math.max(up.Y, 0.3)
				if dw < d then
					d, normal, water = math.max(dw, -L), YAXIS, true
				end
			end
		end
		local comp = L - d
		if comp > 0 and normal then
			local compVel = (comp - self.comp[i]) / h
			local f = self.k * comp + self.c * compVel
			accelUp += math.max(f, 0)
			hits += 1
			normalSum += normal
			-- hard stop: never let the body sink through the surface
			if d < floor then
				self.pos += up * ((floor - d) / n)
			end
			self.comp[i] = comp
		else
			self.comp[i] = 0
		end
		self.dist[i] = math.clamp(d, -L, L)
	end
	local wasGrounded = self.grounded
	local grounded = hits > 0
	self.grounded, self.traction, self.onWater = grounded, hits / n, water
	local vel = self.vel

	-- landing / take-off
	if grounded and not wasGrounded then
		local nrm = normalSum.Unit
		local impact = math.max(0, -vel:Dot(nrm))
		if self.airTime > 0.12 then
			table.insert(events, { "Landed", impact })
		end
		self.airTime = 0
	elseif not grounded then
		self.airTime += h
		if wasGrounded then
			table.insert(events, { "Airborne", 0 })
		end
	end

	vel += up * (accelUp * h)
	vel += Vector3.new(0, -self.g * (if grounded then 1 else cfg.airGravity), 0) * h
	local hard = 0
	for i = 1, n do
		if self.dist[i] < floor then
			hard += 1
		end
	end
	if hard > 0 then
		local vu = vel:Dot(up)
		if vu < 0 then
			vel -= up * vu
		end
	end

	-- attitude: follow the ground normal; level out slowly in the air
	local targetUp = if grounded then normalSum.Unit else YAXIS
	if targetUp.Y < 0.2 then
		targetUp = YAXIS
	end
	up = (up + (targetUp - up) * alpha(if grounded then 12 else 2.2, h)).Unit
	self.up = up
	cf, fwd, right = basis(self.pos, self.yaw, up)

	-- drive
	local throttle = math.clamp(input.throttle or 0, -1, 1)
	local steer = math.clamp(input.steer or 0, -1, 1)
	local vF, vR, vU = vel:Dot(fwd), vel:Dot(right), vel:Dot(up)
	local t = self.traction
	local boosting = self.boostT > 0
	local maxS = cfg.maxSpeed * (if boosting then cfg.boost.speed else 1)
	local drag = cfg.drag + (if cfg.landDrag and grounded and not water then cfg.landDrag else 0)
	if t > 0 then
		local dv = 0
		if throttle > 0.05 then
			if vF < -1 then
				dv += cfg.brake * throttle
			else
				local frac = math.clamp(vF / maxS, 0, 1)
				dv += cfg.accel * (1 - frac * frac) * throttle
			end
		elseif throttle < -0.05 then
			if vF > 1 then
				dv -= cfg.brake * -throttle
			elseif vF > -cfg.reverse then
				dv -= cfg.reverseAccel * -throttle
			end
		else
			dv -= vF * cfg.coast
		end
		if boosting and vF < maxS then
			dv += cfg.boost.accel
		end
		vF += dv * t * h
		vF -= vF * drag * h
		if vF > maxS then
			vF += (maxS - vF) * alpha(1.5, h)
		end
		local grip = if self.drifting then cfg.driftGrip else cfg.grip
		vR *= math.exp(-grip * t * h)
	else
		vF -= vF * 0.05 * h
		vR -= vR * 0.05 * h
	end
	self.accF = (vF - self.lastVF) / h
	self.lastVF = vF

	-- drift: press while turning at speed (karts hop first); charge tiers; release to boost
	local drift = cfg.drift
	if drift then
		local pressed = input.drift and not self.driftHeld
		self.driftHeld = input.drift
		if pressed and grounded and cfg.hop > 0 then
			vU += cfg.hop
		end
		if not self.drifting and input.drift and math.abs(steer) > 0.3 and vF > drift.minSpeed
			and (grounded or self.airTime < 0.4) then
			self.drifting, self.driftDir, self.charge, self.tier = true, if steer > 0 then 1 else -1, 0, 0
			table.insert(events, { "DriftStarted", self.driftDir })
		elseif self.drifting then
			if grounded then
				local k = (steer * self.driftDir + 1) / 2
				self.charge += h * (0.6 + 0.8 * k)
				local tier = 0
				for i, need in drift.tiers do
					if self.charge >= need then
						tier = i
					end
				end
				if tier > self.tier then
					self.tier = tier
					table.insert(events, { "DriftTier", tier })
				end
			end
			if not input.drift or vF < drift.minSpeed * 0.5 or self.airTime > 0.6 then
				local tier = self.tier
				self.drifting, self.tier, self.charge = false, 0, 0
				table.insert(events, { "DriftEnded", tier })
				if tier > 0 then
					self:boost(drift.boosts[tier] or 0.5)
					table.insert(events, { "Boosted", tier })
				end
			end
		end
	end

	-- steering: yaw-rate model, full lock at low speed tapering at the top end, reversed when reversing
	local speedAbs = math.abs(vF)
	local sf = smoothstep(0, cfg.steerFull, speedAbs)
	local hs = smoothstep(cfg.maxSpeed * 0.3, cfg.maxSpeed, speedAbs)
	local rate = (cfg.steer + (cfg.steerHigh - cfg.steer) * hs) * sf
	local s = steer
	if self.drifting and drift then
		local k = (steer * self.driftDir + 1) / 2
		s = self.driftDir * (drift.steerMin + (drift.steerMax - drift.steerMin) * k)
		rate = drift.rate * sf
	end
	local sign = if vF >= -0.5 then 1 else -1
	local target = -s * rate * sign * (if grounded then 1 else cfg.airSteer)
	self.yawRate += (target - self.yawRate) * alpha(cfg.steerResponse, h)
	local dyaw = self.yawRate * h
	self.yaw = Common.wrap(self.yaw + dyaw)

	vel = fwd * vF + right * vR + up * vU
	if t > 0 then
		local align = cfg.align * (if self.drifting then 0.55 else 1) * t
		vel = CFrame.fromAxisAngle(up, dyaw * align):VectorToWorldSpace(vel)
	end

	-- move, sliding along walls (two sphere casts: nose and tail)
	local disp = vel * h
	local planar = disp - up * disp:Dot(up)
	local plen = planar.Magnitude
	if plen > 1e-4 then
		local best = nil
		for _, z in { -self.wallZ, self.wallZ } do
			local from = self.pos + up * self.wallLift + fwd * -z
			local hit = workspace:Spherecast(from, self.wallR, planar, self.params)
			if hit and math.abs(hit.Normal:Dot(up)) < 0.6 and (not best or hit.Distance < best.Distance) then
				best = hit
			end
		end
		if best then
			local nrm = best.Normal
			local vn = vel:Dot(nrm)
			if vn < 0 then
				local speed = vel.Magnitude
				vel -= nrm * vn * (1 + cfg.wallBounce)
				vel *= 1 - cfg.wallScrape * math.clamp(-vn / math.max(speed, 1), 0, 1)
				if -vn > 12 then
					table.insert(events, { "Bumped", -vn })
				end
			end
			planar = planar.Unit * math.max(best.Distance - 0.05, 0)
		end
	end
	self.pos += planar + up * disp:Dot(up)
	self.vel = vel
	if self.boostT > 0 then
		self.boostT = math.max(self.boostT - h, 0)
	end
	-- fell out of the world: put it back where it was a while ago
	if self.pos.Y < workspace.FallenPartsDestroyHeight + 50 then
		table.insert(events, { "Fell", 0 })
	end
	self.prevCF = self.curCF
	self.curCF = basis(self.pos, self.yaw, up)
end

function Sim:boost(seconds)
	self.boostT = math.max(self.boostT, seconds)
end

function Sim:reset(cf)
	cf = cf or CFrame.new(self.pos + Vector3.new(0, 4, 0)) * CFrame.Angles(0, self.yaw, 0)
	self.pos = cf.Position
	self.yaw = Common.yawOf(cf.LookVector)
	self.up, self.vel, self.yawRate = YAXIS, Vector3.zero, 0
	self.drifting, self.boostT, self.airTime = false, 0, 0
	self.prevCF, self.curCF = basis(self.pos, self.yaw, YAXIS), basis(self.pos, self.yaw, YAXIS)
end

------------------------------------------------------------------------------------------------ client driver
-- Options (client; every kind preset value above can be overridden too):
--   kind = "kart"|"car"|"hover"|"boat", spawn = CFrame|Vector3 (built vehicles), seat = true (sit the local character)
--   waterLevel = number | waterHeight = function(x, z) -> y   (boats / hovers; Terrain water is found by raycast)
--   input = function() -> (throttle, steer, drift)   replaces player input (AI, replays, tests)
--   camera = {distance, height, pitch, fov, rotSpeed, lookAtVelocity, speedFov, ...CameraRig.follow} | false
--   keys = {drift = {...}, reset = {...}, exit = {...}}
-- Events: Entered(), Exited(), Landed(impactSpeed), Airborne(), DriftStarted(dir), DriftTier(tier),
--   DriftEnded(tier), Boosted(tierOrSource), Bumped(impactSpeed), Fell()
-- Methods: boost(seconds) (boost pads), reset(cframe?), setEnabled(bool), exit(), state() -> {speed, forwardSpeed,
--   grounded, airTime, drifting, tier, boosting, onWater, throttle, steer}, model, Destroy().
local EVENTS = { "Entered", "Exited", "Landed", "Airborne", "DriftStarted", "DriftTier", "DriftEnded", "Boosted",
	"Bumped", "Fell" }

local Driver = {}
Driver.__index = Driver

local function probesFromModel(cfg, model, root)
	local pts = {}
	for i = 1, 12 do
		local m = root:FindFirstChild("Wheel" .. i)
		if m and m:IsA("Motor6D") then
			local p = m.C0.Position
			table.insert(pts, Vector3.new(p.X, 0, p.Z))
		end
	end
	if #pts >= 3 then
		return pts
	end
	local _, size = model:GetBoundingBox()
	local hx, hz = size.X * 0.4, size.Z * 0.4
	return { Vector3.new(-hx, 0, -hz), Vector3.new(hx, 0, -hz), Vector3.new(-hx, 0, hz), Vector3.new(hx, 0, hz) }
end

function Driver.new(model, opts)
	local cfg = config(opts, if typeof(model) == "Instance" then model else nil)
	local self = setmetatable({ cfg = cfg, maid = Maid.new(), enabled = true, session = nil, held = {},
		userProbes = type(opts) == "table" and opts.probes ~= nil }, Driver)
	Common.signals(self, EVENTS)
	local localOnly = model == nil
	if localOnly then
		local player = Players.LocalPlayer
		local character = player and player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		local at = if typeof(cfg.spawn) == "CFrame" then cfg.spawn
			elseif typeof(cfg.spawn) == "Vector3" then CFrame.new(cfg.spawn)
			elseif hrp then hrp.CFrame * CFrame.new(0, 2, -12)
			else CFrame.new(0, 12, 0)
		model = Vehicle.build(cfg, at)
		model.PrimaryPart.Anchored = true
		model.Parent = workspace
		self.maid:Give(model)
	end
	self.model = if typeof(model) == "Instance" then model else nil

	local input = Common.Input.new(self.maid, "KitVehicle")
	self.input = input
	input:bind("Drift", cfg.keys.drift, function(began)
		self.held.drift = began
	end, { touch = "Drift", slot = 2 })
	input:bind("Reset", cfg.keys.reset, function(began)
		if began and self.session then
			self:reset()
		end
	end, { touch = "Reset", slot = 4 })
	input:bind("Exit", cfg.keys.exit, function(began)
		if began then
			self:exit()
		end
	end, { touch = "Exit", slot = 5 })
	input:bind("Throttle", { K.ButtonR2 }, function(began, io)
		self.held.rt = if began then math.max(io.Position.Z, 0.5) else 0
	end, { sink = false })
	input:bind("Brake", { K.ButtonL2 }, function(began, io)
		self.held.lt = if began then math.max(io.Position.Z, 0.5) else 0
	end, { sink = false })
	input:setEnabled(false)

	if localOnly then
		self:_start(self.model, true)
	else
		-- drive whichever matching vehicle the local character sits in
		self.maid:Give(Common.eachCharacter(nil, function(_, humanoid)
			local function check(active, seatPart)
				if active and seatPart then
					local m = seatPart:FindFirstAncestorOfClass("Model")
					while m and m:GetAttribute("KitVehicle") == nil do
						m = m:FindFirstAncestorOfClass("Model")
					end
					if m and (self.model == nil or m == self.model) and m.PrimaryPart then
						self:_start(m, false)
					end
				elseif self.session then
					self:_stop()
				end
			end
			self.maid:Give(humanoid.Seated:Connect(check))
			if humanoid.SeatPart then
				check(true, humanoid.SeatPart)
			end
		end))
	end
	self.maid:Give(function()
		self:_stop()
	end)
	return self
end

function Driver:_start(model, localOnly)
	if self.session then
		self:_stop()
	end
	local cfg = self.cfg
	local root = model.PrimaryPart
	if not model:GetAttribute("KitBuilt") then
		-- your own model: probes from its wheel joints (or its box corners) unless opts.probes was given
		if not self.userProbes then
			cfg.probes = probesFromModel(cfg, model, root)
		end
		local _, size = model:GetBoundingBox()
		cfg.size = Vector3.new(math.max(size.X, 2), math.max(size.Y, 1), math.max(size.Z, 2))
	end
	local sm = Maid.new()
	local session = { model = model, root = root, maid = sm, localOnly = localOnly, wheels = {}, spin = 0,
		pitchV = 0, rollV = 0, pitchVel = 0, rollVel = 0, t = 0, acc = 0, tierShown = 0 }
	self.session = session
	-- client vehicles of other players' servers: wait until the server hands the root to us
	if not localOnly then
		local t0 = os.clock()
		while root.Anchored and os.clock() - t0 < 2 do
			task.wait()
		end
		if self.session ~= session then
			return
		end
	end
	local sim = Sim.new(cfg, model, root)
	session.sim = sim
	session.spawnCF = root.CFrame + Vector3.new(0, 3, 0)
	local player = Players.LocalPlayer
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if character then
		sim:addIgnore(character)
	end
	if humanoid then
		session.humanoid = humanoid
		session.saved = { WalkSpeed = humanoid.WalkSpeed }
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		if localOnly then
			humanoid.WalkSpeed = 0
			local seat = model:FindFirstChildWhichIsA("Seat", true)
			if seat and cfg.seat ~= false then
				pcall(seat.Sit, seat, humanoid)
			end
		end
	end
	session.bodyMotor = root:FindFirstChild("Body")
	for i = 1, #cfg.probes do
		local m = root:FindFirstChild("Wheel" .. i)
		if m and m:IsA("Motor6D") then
			session.wheels[i] = m
		end
	end
	session.sparks, session.flames = {}, {}
	for _, a in root:GetChildren() do
		if a:IsA("Attachment") and a.Name == "Spark" then
			local sp, fl = a:FindFirstChild("Sparks"), a:FindFirstChild("Flame")
			if sp then
				table.insert(session.sparks, sp)
			end
			if fl then
				table.insert(session.flames, fl)
			end
		end
	end
	-- chase camera: CameraRig follows the root, we steer its yaw to the heading (leaning toward the slide)
	local cc = cfg.camera
	if cc ~= false and CameraRig then
		local camOpts = merge({ preset = "overTheTop", subject = root, orbit = "locked", distance = cc.distance,
			height = cc.height, pitch = cc.pitch, fov = cc.fov, rotSpeed = cc.rotSpeed, speed = 20, lookAhead = 0,
			collision = true, fadeSubject = false, ignore = { model, character },
			speedFov = { from = cfg.maxSpeed * 0.3, to = cfg.maxSpeed * 1.25, fov = 14, pull = 3 } }, cc)
		camOpts.lookAtVelocity = nil
		local ok, rig = pcall(CameraRig.follow, camOpts)
		if ok and rig then
			session.camera = rig
			rig:setAngles(math.deg(sim.yaw), cc.pitch, true)
		end
	end
	self.input:setEnabled(self.enabled)
	sm:Give(Common.renderStep("KitVehicleSim", Enum.RenderPriority.Camera.Value - 1, function(dt)
		self:_frame(session, math.min(dt, 0.25))
	end))
	self.Entered:Fire()
end

function Driver:_stop()
	local session = self.session
	if not session then
		return
	end
	self.session = nil
	session.maid:Clean()
	if session.camera then
		session.camera:stop()
	end
	local h = session.humanoid
	if h and h.Parent then
		h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		if session.saved then
			h.WalkSpeed = session.saved.WalkSpeed
		end
	end
	for _, e in session.sparks or {} do
		e.Enabled = false
	end
	for _, e in session.flames or {} do
		e.Enabled = false
	end
	self.input:setEnabled(false)
	self.Exited:Fire()
end

function Driver:_readInput()
	if self.cfg.input then
		local ok, th, st, dr = pcall(self.cfg.input)
		if ok then
			return { throttle = th or 0, steer = st or 0, drift = dr == true }
		end
	end
	if not self.enabled then
		return { throttle = 0, steer = 0, drift = false }
	end
	local raw = Common.rawMove(self.session and self.session.humanoid)
	local throttle = -raw.Z
	local rt, lt = self.held.rt or 0, self.held.lt or 0
	if rt > 0 or lt > 0 then
		throttle = rt - lt
	end
	return { throttle = throttle, steer = raw.X, drift = self.held.drift == true }
end

local TIER_DEFAULT = { "#6FD3FF", "#FF9A3C", "#D07CFF" }

function Driver:_frame(session, dt)
	local sim, cfg, root = session.sim, self.cfg, session.root
	if not sim or not root.Parent then
		return
	end
	local inp = self:_readInput()
	session.input = inp
	session.acc += dt
	local steps = 0
	local events = {}
	while session.acc >= STEP and steps < MAX_STEPS do
		sim:step(STEP, inp, events)
		session.acc -= STEP
		steps += 1
	end
	if steps == MAX_STEPS then
		session.acc = 0
	end
	local a = math.clamp(session.acc / STEP, 0, 1)
	local cf = sim.prevCF:Lerp(sim.curCF, a)
	if root.Anchored then
		root.CFrame = cf
	else
		root.CFrame = cf
		root.AssemblyLinearVelocity = sim.vel
		root.AssemblyAngularVelocity = sim.up * sim.yawRate
	end
	for _, ev in events do
		self:_event(session, ev[1], ev[2])
	end

	-- visuals: body squat (accel), lean (cornering), boat bob; wheel travel and spin
	session.t += dt
	local vF = sim.vel:Dot(cf.LookVector)
	local pitchGoal = math.clamp(sim.accF * cfg.squat, -0.12, 0.12)
	local rollGoal = math.clamp(-vF * sim.yawRate * cfg.lean, -0.16, 0.16)
	if sim.drifting then
		rollGoal += sim.driftDir * 0.05
	end
	if cfg.bob and sim.onWater then
		local speedFrac = math.clamp(math.abs(vF) / cfg.maxSpeed, 0, 1)
		pitchGoal += speedFrac * 0.09 + math.sin(session.t * 1.9) * 0.025 * cfg.bob
		rollGoal += math.sin(session.t * 1.3 + 0.7) * 0.03 * cfg.bob
	end
	if not sim.grounded then
		pitchGoal, rollGoal = pitchGoal * 0.3, rollGoal * 0.3
	end
	local k, d = 90, 2 * 0.55 * math.sqrt(90)
	session.pitchVel += ((pitchGoal - session.pitchV) * k - session.pitchVel * d) * dt
	session.pitchV += session.pitchVel * dt
	session.rollVel += ((rollGoal - session.rollV) * k - session.rollVel * d) * dt
	session.rollV += session.rollVel * dt
	local bm = session.bodyMotor
	if bm and bm:IsA("Motor6D") then
		local hoverBob = if cfg.wheelRadius == 0 and not cfg.bob then math.sin(session.t * 2.4) * 0.12 else 0
		bm.Transform = CFrame.new(0, hoverBob, 0) * CFrame.Angles(session.pitchV, 0, session.rollV)
	end
	session.spin -= vF / math.max(cfg.wheelRadius, 0.3) * dt
	for i, m in session.wheels do
		local drop = math.max(sim.dist[i], cfg.wheelRadius * 0.3) - cfg.wheelRadius
		local steerA = 0
		if cfg.probes[i].Z < 0 then
			steerA = -(inp.steer or 0) * 0.45
		end
		m.Transform = CFrame.new(0, -drop, 0) * CFrame.Angles(0, steerA, 0) * CFrame.Angles(session.spin, 0, 0)
	end
	-- drift sparks by tier, boost flames
	local tier = if sim.drifting then sim.tier else 0
	if tier ~= session.tierShown then
		session.tierShown = tier
		local colors = (cfg.drift and cfg.drift.colors) or TIER_DEFAULT
		for _, e in session.sparks do
			e.Enabled = tier > 0 and sim.grounded
			if tier > 0 then
				e.Color = ColorSequence.new(Common.color(colors[tier], Color3.new(1, 1, 1)))
			end
		end
	end
	local boosting = sim.boostT > 0
	if boosting ~= session.flameOn then
		session.flameOn = boosting
		for _, e in session.flames do
			e.Enabled = boosting
		end
	end
	-- camera heading: behind the vehicle, leaning into the slide; does not flip when reversing
	local rig = session.camera
	if rig then
		local camYaw = sim.yaw
		local hv = flat(sim.vel)
		if hv.Magnitude > 8 and vF > 0 then
			camYaw += Common.wrap(Common.yawOf(hv) - sim.yaw) * (cfg.camera.lookAtVelocity or 0.3)
		end
		rig:setAngles(math.deg(camYaw), cfg.camera.pitch)
	end
end

function Driver:_event(session, name, value)
	local cfg = self.cfg
	if name == "Landed" then
		if CameraRig and value > 30 then
			pcall(CameraRig.shake, math.clamp(value / 260, 0, 0.5))
			pcall(CameraRig.punch, Vector3.new(0, -1, 0), math.clamp(value / 300, 0, 0.6))
		end
		self.Landed:Fire(value)
	elseif name == "Boosted" then
		if CameraRig then
			pcall(CameraRig.kick, cfg.boost.fov, 0.45)
			pcall(CameraRig.shake, cfg.boost.shake)
		end
		self.Boosted:Fire(value)
	elseif name == "Bumped" then
		if CameraRig then
			pcall(CameraRig.shake, math.clamp(value / 200, 0.05, 0.4))
		end
		self.Bumped:Fire(value)
	elseif name == "Fell" then
		self.Fell:Fire()
		self:reset(session.lastSafe or session.spawnCF)
	elseif self[name] then
		self[name]:Fire(value)
	end
	if name == "Landed" or (name == "DriftEnded" and session.sim.grounded) then
		session.lastSafe = session.sim.curCF + Vector3.new(0, 4, 0)
	end
end

-- Boost pads / pickups: adds `seconds` of boost (FOV kick + shake + flames).
function Driver:boost(seconds)
	local s = self.session
	if s and s.sim then
		s.sim:boost(seconds or 1)
		self:_event(s, "Boosted", "pad")
	end
end

-- Puts the vehicle upright (at cframe, or a little above where it is), zero speed.
function Driver:reset(cframe)
	local s = self.session
	if s and s.sim then
		s.sim:reset(cframe)
		s.root.CFrame = s.sim.curCF
	end
end

function Driver:exit()
	local s = self.session
	if not s then
		return
	end
	local h = s.humanoid
	if s.localOnly then
		self:_stop()
		if h then
			h.Sit = false
		end
	elseif h then
		h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		h.Sit = false
		h.Jump = true
	end
end

function Driver:setEnabled(on)
	self.enabled = on ~= false
	self.input:setEnabled(self.enabled and self.session ~= nil)
	return self
end

function Driver:state()
	local s = self.session
	local sim = s and s.sim
	if not sim then
		return { driving = false }
	end
	local inp = s.input or {}
	return { driving = true, speed = sim.vel.Magnitude, forwardSpeed = sim.vel:Dot(sim.curCF.LookVector),
		grounded = sim.grounded, airTime = sim.airTime, drifting = sim.drifting, tier = sim.tier,
		boosting = sim.boostT > 0, onWater = sim.onWater, throttle = inp.throttle or 0, steer = inp.steer or 0,
		cframe = sim.curCF }
end

function Driver:Destroy()
	self.maid:Clean()
	for _, n in EVENTS do
		self[n]:Destroy()
	end
end

------------------------------------------------------------------------------------------------ entry
function Vehicle.new(model, opts)
	if type(model) == "table" and opts == nil then
		model, opts = nil, model
	end
	if model == "seated" or model == "auto" then
		model = nil
		if IS_CLIENT then
			-- watch for any KitVehicle the local player sits in
			local d = Driver.new(false, opts)
			return d
		end
	end
	if IS_CLIENT then
		return Driver.new(model, opts)
	end
	return serverVehicle(model, opts)
end

Vehicle.Sim = Sim
return Vehicle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Debug</string>
          <string name="Source"><![CDATA[-- Debug: named commands the test harness runs in a live play session (Studio only), plus event and log capture.
--   Debug.register("show_shop", function() Shop.open() end, "opens the shop screen")   (client or server)
--   Debug.event("round_started", { round = 3 })       timestamped gameplay event for playtest checks
-- In Studio, the game server long-polls the harness on localhost (HttpService) for commands, runs server commands
-- itself and relays client commands to every client. None of this exists outside Studio: the relay remote and the
-- poll loop are only created when RunService:IsStudio() and the harness has set its port on ServerStorage.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LogService = game:GetService("LogService")

local Debug = {}
local commands = {}
local events = {}
local logs = {}
local MAX_EVENTS, MAX_LOGS = 600, 800
local REMOTE = "KitDebugRelay"
local pending = {}

local function push(list, item, max)
	table.insert(list, item)
	if #list > max then
		table.remove(list, 1)
	end
end

local function side()
	return RunService:IsServer() and "server" or "client"
end

function Debug.register(name, fn, description)
	commands[name] = { fn = fn, description = description or "" }
end

function Debug.event(name, data)
	push(events, { t = os.clock(), name = name, side = side(), data = data }, MAX_EVENTS)
	if RunService:IsClient() and RunService:IsStudio() then
		local remote = ReplicatedStorage:FindFirstChild(REMOTE)
		if remote then
			remote:FireServer("event", name, data)
		end
	end
end

function Debug.events()
	return events
end

function Debug.list()
	local out = {}
	for name, c in commands do
		out[name] = c.description
	end
	return out
end

function Debug.run(name, ...)
	local c = commands[name]
	if not c then
		return false, "unknown command " .. tostring(name)
	end
	return pcall(c.fn, ...)
end

local function encode(v)
	if type(v) == "table" then
		local ok, s = pcall(HttpService.JSONEncode, HttpService, v)
		return ok and s or tostring(v)
	end
	return tostring(v)
end

-- Run a server command, or relay it to every client and wait for their replies.
function Debug.call(name, ...)
	if commands[name] then
		local ok, result = Debug.run(name, ...)
		return { side = "server", ok = ok, result = encode(result) }
	end
	local remote = ReplicatedStorage:FindFirstChild(REMOTE)
	if not remote then
		return { ok = false, result = "no relay (not in a Studio play session)" }
	end
	local id = HttpService:GenerateGUID(false)
	pending[id] = {}
	remote:FireAllClients("run", id, name, ...)
	local deadline = os.clock() + 5
	while os.clock() < deadline and #pending[id] < math.max(1, #Players:GetPlayers()) do
		task.wait(0.05)
	end
	local replies = pending[id]
	pending[id] = nil
	local ok = #replies > 0
	for _, r in replies do
		ok = ok and r.ok
	end
	return { side = "client", ok = ok, replies = replies }
end

local function captureLogs(tag)
	local KINDS = { [Enum.MessageType.MessageError] = "error", [Enum.MessageType.MessageWarning] = "warning",
		[Enum.MessageType.MessageOutput] = "output", [Enum.MessageType.MessageInfo] = "info" }
	-- Errors thrown before this connects (an entry script failing in its first frame) are only in the history:
	-- replay it, or the judge and fixer never hear why the game is empty.
	task.spawn(function()
		pcall(function()
			local history = LogService:GetLogHistory()
			for i = math.max(1, #history - 200), #history do
				local h = history[i]
				if h and (h.messageType == Enum.MessageType.MessageError or h.messageType == Enum.MessageType.MessageWarning) then
					push(logs, { t = os.clock(), kind = KINDS[h.messageType], text = string.sub(tostring(h.message), 1, 800),
						side = tag }, MAX_LOGS)
				end
			end
		end)
	end)
	LogService.MessageOut:Connect(function(message, kind)
		if KINDS[kind] then
			local entry = { t = os.clock(), kind = KINDS[kind], text = string.sub(message, 1, 800), side = tag }
			push(logs, entry, MAX_LOGS)
			if RunService:IsClient() then
				local remote = ReplicatedStorage:FindFirstChild(REMOTE)
				if remote then
					remote:FireServer("log", entry)
				end
			end
		end
	end)
end

local function builtinsServer()
	Debug.register("__list", function()
		return Debug.list()
	end, "server commands")
	Debug.register("__events", function()
		return events
	end, "gameplay events from server and clients")
	Debug.register("__log", function()
		return logs
	end, "errors and warnings from server and clients")
	Debug.register("__players", function()
		local out = {}
		for _, p in Players:GetPlayers() do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			table.insert(out, { name = p.Name, position = root and tostring(root.Position) or "none" })
		end
		return out
	end, "players and their positions")
end

local function builtinsClient()
	Debug.register("__client_list", function()
		return Debug.list()
	end, "client commands")
	local marker
	Debug.register("__marker", function(on)
		if on then
			local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
			marker = Instance.new("ScreenGui")
			marker.Name = "KitViewportMarker"
			marker.IgnoreGuiInset = true
			marker.DisplayOrder = 2147483647
			pcall(function()
				marker.ScreenInsets = Enum.ScreenInsets.None
			end)
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = Color3.fromRGB(255, 0, 255)
			f.Size = UDim2.fromScale(1, 1)
			f.Parent = marker
			marker.Parent = pg
		elseif marker then
			marker:Destroy()
			marker = nil
		end
		local cam = workspace.CurrentCamera
		return { viewport = { cam.ViewportSize.X, cam.ViewportSize.Y } }
	end, "full-screen magenta frame for locating the viewport in screenshots")
	Debug.register("__camera", function(x, y, z, lx, ly, lz, fov)
		-- Held every frame after every other camera writer (CameraRig / ControllerKit rewrite it each frame).
		local cam = workspace.CurrentCamera
		pcall(RunService.UnbindFromRenderStep, RunService, "__DebugCam")
		if x == nil then
			cam.CameraType = Enum.CameraType.Custom
			return "camera reset"
		end
		local cf = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(lx, ly, lz))
		local function hold()
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = cf
			if fov then
				cam.FieldOfView = fov
			end
		end
		hold()
		RunService:BindToRenderStep("__DebugCam", Enum.RenderPriority.Last.Value + 50, hold)
		return "camera set"
	end, "place the camera: x,y,z, lookX,lookY,lookZ, fov; no args resets")
	Debug.register("__bounds", function()
		-- Extent of the built world (parts and terrain props), for framing survey views.
		local root = workspace:FindFirstChild("StudioWorld")
		if not root or #root:GetChildren() == 0 then
			root = workspace
		end
		local chars = {}
		for _, p in Players:GetPlayers() do
			if p.Character then
				chars[p.Character] = true
			end
		end
		-- Percentile bounds: stray far-off parts (cloud puffs, a sea slab) must not stretch the survey framing
		-- (live: the overview showed one tiny island and empty sky).
		local xs, ys, zs = {}, {}, {}
		for _, d in root:GetDescendants() do
			if d:IsA("BasePart") and d.Transparency < 1 and d.Size.Magnitude < 600 and d.Name ~= "Baseplate" then
				local m = d:FindFirstAncestorOfClass("Model")
				if not (m and chars[m]) then
					local p = d.Position
					table.insert(xs, p.X)
					table.insert(ys, p.Y)
					table.insert(zs, p.Z)
				end
			end
		end
		if #xs == 0 then
			return { min = { -60, 0, -60 }, max = { 60, 40, 60 } }
		end
		local function q(t, f)
			table.sort(t)
			return t[math.clamp(math.floor(#t * f + 0.5), 1, #t)]
		end
		return { min = { q(xs, 0.05), q(ys, 0.05), q(zs, 0.05) }, max = { q(xs, 0.95), q(ys, 0.95), q(zs, 0.95) } }
	end, "bounding box of the built world (StudioWorld, else workspace)")
	Debug.register("__move", function(x, z, seconds)
		-- walk the local character: x/z relative to the camera (0, -1 = forward), for `seconds`
		local player = Players.LocalPlayer
		local deadline = os.clock() + math.clamp(tonumber(seconds) or 1, 0, 10)
		task.spawn(function()
			while os.clock() < deadline do
				player:Move(Vector3.new(tonumber(x) or 0, 0, tonumber(z) or -1), true)
				RunService.RenderStepped:Wait()
			end
			player:Move(Vector3.zero, true)
		end)
		return "moving"
	end, "walk the character relative to the camera: x z seconds (0 -1 2 = forward for 2 s)")
	Debug.register("__jump", function()
		local hum = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Jump = true
			return "jumped"
		end
		return "no humanoid"
	end, "make the character jump")
	Debug.register("__sound_manifest", function()
		local ok, Sound = pcall(function()
			return require(ReplicatedStorage:WaitForChild("Kit"):WaitForChild("Sound"))
		end)
		return ok and Sound.manifest() or "no Sound module"
	end, "every registered sound with its load state")
	Debug.register("__stats", function()
		local frames, t0 = 0, os.clock()
		local conn = RunService.RenderStepped:Connect(function()
			frames += 1
		end)
		task.wait(1)
		conn:Disconnect()
		local Stats = game:GetService("Stats")
		return { fps = frames / (os.clock() - t0), memory_mb = Stats:GetTotalMemoryUsageMb(),
			instances = #game:GetDescendants(), viewport = tostring(workspace.CurrentCamera.ViewportSize) }
	end, "frame rate, memory and instance count on this client")
	Debug.register("__ui", function()
		local out = {}
		for _, g in Players.LocalPlayer:WaitForChild("PlayerGui"):GetChildren() do
			if g:IsA("ScreenGui") then
				table.insert(out, { name = g.Name, enabled = g.Enabled, order = g.DisplayOrder })
			end
		end
		return out
	end, "ScreenGuis on this client")
end

local function pollHarness(port, token)
	local base = "http://127.0.0.1:" .. tostring(port) .. "/cybus/"
	local session = HttpService:GenerateGUID(false)
	local function post(route, body)
		body.token = token
		body.session = session
		return pcall(HttpService.PostAsync, HttpService, base .. route, HttpService:JSONEncode(body),
			Enum.HttpContentType.ApplicationJson)
	end
	post("hello", { place = game.PlaceId, t = os.clock() })
	local failures = 0
	while true do
		local ok, body = pcall(HttpService.GetAsync, HttpService, base .. "next?token=" .. token .. "&session=" .. session, true)
		if not ok then
			failures += 1
			task.wait(math.min(5, failures))
			if failures % 5 == 0 then
				post("hello", { place = game.PlaceId, t = os.clock() })
			end
			continue
		end
		failures = 0
		local decoded, cmd = pcall(HttpService.JSONDecode, HttpService, body)
		if decoded and type(cmd) == "table" and cmd.id then
			task.spawn(function()
				local result = Debug.call(cmd.name, table.unpack(cmd.args or {}))
				post("result", { id = cmd.id, result = result })
			end)
		end
	end
end

function Debug.initServer()
	if not RunService:IsStudio() or ReplicatedStorage:FindFirstChild(REMOTE) then
		return
	end
	local remote = Instance.new("RemoteEvent")
	remote.Name = REMOTE
	remote.Parent = ReplicatedStorage
	remote.OnServerEvent:Connect(function(player, kind, a, b, c)
		if kind == "reply" and pending[a] then
			table.insert(pending[a], { player = player.Name, ok = b, result = c })
		elseif kind == "event" then
			push(events, { t = os.clock(), name = tostring(a), side = "client:" .. player.Name, data = b }, MAX_EVENTS)
		elseif kind == "log" and type(a) == "table" then
			a.side = "client:" .. player.Name
			push(logs, a, MAX_LOGS)
		end
	end)
	captureLogs("server")
	builtinsServer()
	local storage = game:GetService("ServerStorage")
	-- For a person play-testing in Studio: with the view on Server, run in the command bar
	--   print(game:GetService("HttpService"):JSONEncode(game.ServerStorage.CybusDebug:Invoke("<command>")))
	-- A BindableFunction reaches this module's commands however the command bar's require is cached.
	local door = Instance.new("BindableFunction")
	door.Name = "CybusDebug"
	door.OnInvoke = function(name, ...)
		return Debug.call(name, ...)
	end
	door.Parent = storage
	local port, token = storage:GetAttribute("CybusHarnessPort"), storage:GetAttribute("CybusHarnessToken")
	if port and token then
		task.spawn(pollHarness, port, token)
	end
end

function Debug.initClient()
	if not RunService:IsStudio() then
		return
	end
	captureLogs("client")
	builtinsClient()
	local remote = ReplicatedStorage:WaitForChild(REMOTE, 15)
	if not remote then
		return
	end
	remote.OnClientEvent:Connect(function(kind, id, name, ...)
		if kind == "run" then
			local ok, result = Debug.run(name, ...)
			remote:FireServer("reply", id, ok, encode(result))
		end
	end)
end

return Debug
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">FXKit</string>
          <string name="Source"><![CDATA[-- FXKit: a library of ready-made, tuned effects built on Kit.VFX, so games compose good effects instead of
-- hand-authoring them. Every preset has four looks (FXKit.setStyle or opts.style): "toon" (flat, opaque, chunky:
-- N64 / cel-shaded), "realistic" (soft smoke, lit, muted), "cozy" (pastel, warm, slow) and "neon" (additive, glowing).
--   FXKit.play("explosion", pos, { variant = "large" })        one-shots clean themselves up
--   local h = FXKit.play("boost_flame", exhaustPart)            continuous presets follow a part until h:stop()
--   h:set(0.4)                                                  continuous rate (e.g. by speed), 0..n
--   FXKit.playAll("level_up", character)                        from the server: every client plays it
--   FXKit.speedLines(speed / maxSpeed)   FXKit.weather("rain")   FXKit.tracer(muzzle, hitPos, { impact = "metal" })
--   FXKit.hitstop(0.6)   FXKit.punch(0.5)   FXKit.flash("#FFFFFF")   FXKit.slowmo(0.3, 0.8)
--   FXKit.texture("flame", "rbxassetid://123", { layout = "4x4", fps = 24 })   swap in generated sprites / flipbooks
-- opts: style, variant, color (the main colour: Color3 or "#RRGGBB"), scale, intensity, impact (0..1: land_dust),
-- normal (surface normal), direction (forward), follow, to (tracer / lightning / bolt end), area (weather size).
-- Names may carry the variant: "explosion_large", "muzzle_flash_shotgun", "fire_torch", "drift_sparks_3".
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Kit = script.Parent
local VFX = require(Kit:WaitForChild("VFX"))
local FxMath = require(Kit:WaitForChild("FxMath"))

-- (typed any: presets reference helpers defined further down)
local FXKit: any = {}
FXKit.STYLES = { "toon", "realistic", "cozy", "neon" }

local IS_CLIENT = RunService:IsClient()
local IS_SERVER = RunService:IsServer()
local REMOTE_NAME = "KitFXKit"
local currentStyle = "toon"

------------------------------------------------------------------------------------------------ helpers
local warned = {}
local function warnOnce(key, msg)
	if not warned[key] then
		warned[key] = true
		warn("[FXKit] " .. msg)
	end
end

local function optional(name)
	local inst = Kit:FindFirstChild(name)
	if inst and inst:IsA("ModuleScript") then
		local ok, mod = pcall(require, inst)
		if ok and type(mod) == "table" then
			return mod
		end
	end
	return nil
end

local function clamp01(x)
	return math.clamp(if type(x) == "number" and x == x then x else 0, 0, 1)
end

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

------------------------------------------------------------------------------------------------ textures
-- Built-in Roblox content (present in every client install). FXKit.texture(slot, id) replaces any slot.
local TEX = {
	soft = "rbxasset://textures/particles/explosion01_implosion_main.dds", -- soft round glow
	circle = "rbxasset://textures/whiteCircle.png", -- hard disc (toon puffs, droplets)
	smoke = "rbxasset://textures/particles/smoke_main.dds", -- soft cloud
	puff = "rbxasset://textures/explosion.png", -- cloud puff
	star = "rbxasset://textures/particles/sparkles_main.dds", -- 4-point star
	glint = "rbxasset://textures/sparkle.png", -- small cross glint
	glow = "rbxasset://textures/glow.png", -- starburst glow
	ring = "rbxasset://textures/particles/explosion01_shockwave_main.dds", -- shockwave ring
	fireball = "rbxasset://textures/particles/explosion01_core_main.dds", -- fiery burst
	square = "rbxasset://textures/particles/SquareParticle.png",
	shard = "rbxasset://textures/triangle.png",
	vortex = "rbxasset://textures/particles/forcefield_vortex_main.dds", -- swirl ring
}
-- Semantic slots and the base texture they use unless overridden.
local ALIAS = { dust = "smoke", spark = "soft", flame = "soft", ember = "soft", drop = "soft", mist = "smoke",
	debris = "square", confetti = "square", leaf = "shard", petal = "circle", bubble = "ring", scorch = "smoke",
	streak = "soft", snow = "soft", magic = "soft" }
FXKit.SLOTS = {}
for k in TEX do
	table.insert(FXKit.SLOTS, k)
end
for k in ALIAS do
	table.insert(FXKit.SLOTS, k)
end
table.sort(FXKit.SLOTS)

local overrides = {} -- slot -> { id, flipbook }
local specCache = {} -- key -> spec

------------------------------------------------------------------------------------------------ styles
local STYLES = {
	toon = { name = "toon", emit = 0.1, influence = 0, fade = 0, life = 0.9, size = 1.15, count = 0.8, sat = 1.15,
		val = 1.04, warm = 0, light = 1, sparkGlow = 0.6, ringGlow = 0.5, bright = 1, opaque = true,
		slots = { dust = "circle", mist = "circle", spark = "circle", drop = "circle", streak = "circle", snow = "circle" },
		lines = { color = "#FFFFFF", thick = 5, alpha = 0.9 } },
	realistic = { name = "realistic", emit = 0, influence = 1, fade = 0.3, life = 1.1, size = 1, count = 1.2, sat = 0.8,
		val = 0.94, warm = 0, light = 1, sparkGlow = 1, ringGlow = 0.6, bright = 1, opaque = false,
		slots = {}, lines = { color = "#FFFFFF", thick = 2, alpha = 0.35 } },
	cozy = { name = "cozy", emit = 0.15, influence = 0.5, fade = 0.15, life = 1.25, size = 1.1, count = 0.9, sat = 0.72,
		val = 1.06, warm = 0.16, light = 0.75, sparkGlow = 0.8, ringGlow = 0.6, bright = 1, opaque = false,
		slots = { dust = "puff", spark = "soft" }, lines = { color = "#FFF1DC", thick = 3, alpha = 0.5 } },
	neon = { name = "neon", emit = 1, influence = 0, fade = 0.1, life = 0.9, size = 1, count = 1, sat = 1.3, val = 1.15,
		warm = 0, light = 1.5, sparkGlow = 1, ringGlow = 1, bright = 1.6, opaque = false, neutral = "#7FF3FF",
		slots = { dust = "soft", mist = "soft" }, lines = { color = "#7FF6FF", thick = 3, alpha = 0.8 } },
}

local function texOf(st, slot)
	local o = overrides[slot]
	if o then
		return o.id, o.flipbook
	end
	local base = st.slots[slot] or ALIAS[slot] or slot
	o = overrides[base]
	if o then
		return o.id, o.flipbook
	end
	return TEX[base] or TEX.soft, nil
end

------------------------------------------------------------------------------------------------ colour
local function toHSV(r, g, b)
	local mx, mn = math.max(r, g, b), math.min(r, g, b)
	local d = mx - mn
	local h = 0
	if d > 1e-6 then
		if mx == r then
			h = ((g - b) / d) % 6
		elseif mx == g then
			h = (b - r) / d + 2
		else
			h = (r - g) / d + 4
		end
		h /= 6
	end
	return h, if mx > 0 then d / mx else 0, mx
end

local function fromHSV(h, s, v)
	local i = math.floor(h * 6)
	local f = h * 6 - i
	local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
	i %= 6
	if i == 0 then
		return v, t, p
	elseif i == 1 then
		return q, v, p
	elseif i == 2 then
		return p, v, t
	elseif i == 3 then
		return p, q, v
	elseif i == 4 then
		return t, p, v
	end
	return v, p, q
end

local function hexOf(r, g, b)
	return string.format("#%02X%02X%02X", math.floor(math.clamp(r, 0, 1) * 255 + 0.5),
		math.floor(math.clamp(g, 0, 1) * 255 + 0.5), math.floor(math.clamp(b, 0, 1) * 255 + 0.5))
end

-- A colour (Color3 / "#hex") as "#RRGGBB", or nil.
local function asHex(c)
	if typeof(c) == "Color3" then
		return hexOf(c.R, c.G, c.B)
	end
	local r, g, b = FxMath.hex(c)
	if r then
		return hexOf(r, g :: number, b :: number)
	end
	return nil
end

-- Mixes a hex colour toward white (amount > 0) or black (amount < 0).
local function shade(hex, amount)
	local r, g, b = FxMath.hex(hex)
	if not r then
		return hex
	end
	local t = if amount > 0 then 1 else 0
	local a = math.abs(amount)
	return hexOf(r + (t - r) * a, (g :: number) + (t - (g :: number)) * a, (b :: number) + (t - (b :: number)) * a)
end

-- The style's take on a designed colour (saturation, value, warmth; neon recolours neutrals to its accent).
local function tone(st, hex)
	local r, g, b = FxMath.hex(hex)
	if not r then
		return hex
	end
	local h, s, v = toHSV(r, g :: number, b :: number)
	if st.neutral and s < 0.18 then
		local nr, ng, nb = FxMath.hex(st.neutral)
		local nh, ns = toHSV(nr :: number, ng :: number, nb :: number)
		h, s = nh, math.max(s, ns * 0.6)
	end
	s = math.clamp(s * st.sat, 0, 1)
	v = math.clamp(v * st.val, 0, 1)
	local rr, gg, bb = fromHSV(h, s, v)
	if st.warm > 0 then
		local w = st.warm
		rr, gg, bb = rr + (1 - rr) * w * 0.5, gg + (0.93 - gg) * w * 0.5, bb + (0.8 - bb) * w * 0.5
	end
	return hexOf(rr, gg, bb)
end

-- A colour or colour sequence through the style ("#hex", {"#a", "#b"} or {{t, "#a"}, ...}).
local function col(st, spec)
	if type(spec) == "string" then
		return tone(st, spec)
	elseif type(spec) == "table" then
		local out = {}
		for i, k in spec do
			if type(k) == "table" then
				out[i] = { k[1], tone(st, k[2]) }
			else
				out[i] = tone(st, k)
			end
		end
		return out
	end
	return spec
end

------------------------------------------------------------------------------------------------ layer builders
-- Particles with the style's texture, light response, counts and lifetimes applied.
local function particles(st, slot, t)
	t.kind = "particles"
	local id, flip = texOf(st, slot)
	t.texture = id
	if flip then
		t.flipbook = flip
	end
	if t.lightInfluence == nil then
		t.lightInfluence = st.influence
	end
	if t.count then
		t.count = math.max(1, math.floor(t.count * st.count + 0.5))
	end
	if t.rate then
		t.rate = t.rate * st.count
	end
	if type(t.lifetime) == "table" then
		t.lifetime = { t.lifetime[1] * st.life, t.lifetime[2] * st.life }
	end
	return t
end

-- Dust, steam and smoke puffs. Toon: opaque discs that pop and shrink; otherwise soft clouds that grow and fade.
-- t: count | rate (+duration), size, life, speed, spread, direction, color, drag, rise (up accel), alpha (extra fade),
-- slot ("dust"|"smoke"|"mist"), wind (Vector3), delay, offset, shape, fadeIn.
local function puff(st, t)
	local s = (t.size or 1) * st.size
	local toon = st.opaque
	local a = math.clamp(st.fade + (t.alpha or 0), 0, 0.95)
	local tr
	if toon then
		tr = if t.fadeIn then { { 0, 1 }, { 0.12, a }, { 0.8, a }, { 1, 1 } } else { { 0, a }, { 0.8, a }, { 1, 1 } }
	else
		tr = if t.fadeIn then { { 0, 1 }, { 0.15, a }, { 1, 1 } } else { { 0, math.min(a + 0.1, 0.95) }, { 0.3, a }, { 1, 1 } }
	end
	local accel = V(0, t.rise or 1.5, 0)
	if typeof(t.wind) == "Vector3" then
		accel += t.wind
	end
	return particles(st, t.slot or "dust", {
		delay = t.delay, offset = t.offset, count = t.count, rate = t.rate, duration = t.duration, shape = t.shape,
		lifetime = t.life or { 0.4, 0.7 }, speed = t.speed or { 4, 8 }, spread = t.spread or { 180, 8 },
		direction = t.direction or "forward",
		size = if toon then { { 0, s * 0.6 }, { 0.2, s }, { 1, s * (t.grow or 0.15) } } else { { 0, s * 0.5 }, { 1, s * (t.grow or 1.8) } },
		transparency = tr, color = col(st, t.color or "#E9E0D0"), lightEmission = if toon then 0 else st.emit * 0.4,
		drag = t.drag or 5, acceleration = accel, rotation = { 0, 360 }, rotSpeed = { -50, 50 }, zoffset = t.zoffset,
	})
end

-- Hot streaks that stretch along their velocity. t: count | rate, colors, size, life, speed, spread, direction,
-- gravity, drag, stretch, delay, offset, shape.
local function sparks(st, t)
	local s = t.size or 0.22
	return particles(st, t.slot or "spark", {
		delay = t.delay, offset = t.offset, count = t.count, rate = t.rate, duration = t.duration, shape = t.shape,
		lifetime = t.life or { 0.2, 0.45 }, speed = t.speed or { 18, 34 }, spread = t.spread or { 55, 55 },
		direction = t.direction or "up", size = { { 0, s }, { 1, 0 } },
		squash = { { 0, t.stretch or 2.2 }, { 1, 0.6 } }, orientation = "parallel",
		lightEmission = st.sparkGlow, lightInfluence = 0, brightness = st.bright,
		color = if t.exact then t.colors else col(st, t.colors or { "#FFF6C8", "#FFB23E" }),
		drag = t.drag or 3, acceleration = V(0, -(t.gravity or 40), 0), zoffset = t.zoffset or 0.5,
	})
end

-- Stars / glints that pop in, spin and shrink. t: count | rate, color, size, life, speed, spread, direction,
-- gravity, slot ("star"|"glint"|"glow"), delay, offset, shape.
local function glints(st, t)
	local s = (t.size or 0.8) * (if st.opaque then 1.15 else 1)
	return particles(st, t.slot or "star", {
		delay = t.delay, offset = t.offset, count = t.count, rate = t.rate, duration = t.duration, shape = t.shape,
		lifetime = t.life or { 0.35, 0.6 }, speed = t.speed or { 0, 0 }, spread = t.spread or { 180, 180 },
		direction = t.direction or "up", size = { { 0, 0 }, { 0.15, s }, { 1, 0 } },
		transparency = { { 0, 0 }, { 0.7, 0.1 }, { 1, 1 } }, rotation = { 0, 360 }, rotSpeed = t.rotSpeed or { -120, 120 },
		lightEmission = if st.opaque then 0.6 else 1, lightInfluence = 0, brightness = st.bright,
		color = if t.exact then t.color else col(st, t.color or { "#FFFFFF", "#FFE07A" }),
		drag = t.drag or 2, acceleration = V(0, -(t.gravity or 0), 0), zoffset = 0.6,
	})
end

local function flash(st, t)
	return { kind = "flash", delay = t.delay, offset = t.offset, color = if t.exact then t.color else tone(st, t.color or "#FFF6D6"),
		size = t.size or { 0.4, 2.5 }, transparency = t.transparency or { 0.05, 1 }, duration = t.duration or 0.1,
		ease = t.ease or "Quad Out", material = t.material, shape = t.shape }
end

local function ring(st, t)
	local id = texOf(st, "ring")
	return { kind = "ring", delay = t.delay, offset = t.offset, texture = id, size = t.size or { 1, 8 },
		duration = t.duration or 0.35, color = if t.exact then t.color else col(st, t.color or "#FFFFFF"),
		transparency = { { 0, t.alpha or 0.1 }, { 0.6, math.min((t.alpha or 0.1) + 0.3, 0.9) }, { 1, 1 } },
		lightEmission = st.ringGlow, brightness = st.bright, flat = t.flat ~= false, ease = t.ease or "Quint Out" }
end

local function light(st, t)
	return { kind = "light", delay = t.delay, offset = t.offset, color = if t.exact then t.color else tone(st, t.color or "#FFC266"),
		brightness = (t.brightness or 3) * st.light, range = t.range or 12, duration = t.duration, attack = t.attack }
end

-- Paper confetti in one colour: tumbling (squash flutter) squares or shards.
local FLUTTER = { { 0, 0 }, { 0.1, 0.9 }, { 0.2, -0.8 }, { 0.3, 0.9 }, { 0.4, -0.8 }, { 0.5, 0.9 }, { 0.6, -0.8 },
	{ 0.7, 0.9 }, { 0.8, -0.8 }, { 0.9, 0.9 }, { 1, 0 } }
local function confetti(st, t)
	local s = (t.size or 0.4) * st.size
	return particles(st, t.slot or "confetti", {
		delay = t.delay, offset = t.offset, count = t.count, rate = t.rate, duration = t.duration, shape = t.shape,
		lifetime = t.life or { 1.4, 2.2 }, speed = t.speed or { 18, 30 }, spread = t.spread or { 40, 40 },
		direction = t.direction or "up", size = { { 0, s }, { 0.85, s }, { 1, 0 } }, squash = FLUTTER,
		transparency = { { 0, 0 }, { 0.85, 0 }, { 1, 1 } }, color = col(st, t.color), lightEmission = if st.name == "neon" then 0.8 else 0,
		drag = t.drag or 2.4, acceleration = t.accel or V(0.5, -14, 0), rotation = { 0, 360 }, rotSpeed = { -360, 360 },
	})
end

------------------------------------------------------------------------------------------------ presets
-- Each preset: group, build(st, v, c, o) -> spec (cached per style / variant / colour), and optionally variants,
-- default variant, adapt(at, opts, v) (effect options), extra(at, opts, st, v, handle) (camera, debris...),
-- continuous (runs until :stop()), flicker (continuous lights flicker), weather (no `at`: follows the camera).
local P = {}
local ORDER = {}
local function def(name, meta)
	P[name] = meta
	table.insert(ORDER, name)
end

local PALETTE = { "#FF4D6D", "#FFD93D", "#4DD4FF", "#7CFF6B", "#B47CFF" }

-------------------------------------------------- movement
def("jump_puff", { group = "movement", build = function(st, _, c)
	return { layers = {
		puff(st, { count = 7, size = 1, life = { 0.3, 0.5 }, speed = { 7, 10 }, spread = { 180, 6 }, drag = 7, rise = 2, color = c }),
		puff(st, { count = 3, size = 0.7, life = { 0.3, 0.45 }, speed = { 3, 5 }, direction = "up", spread = { 25, 25 },
			color = shade(c or "#E9E0D0", 0.5), delay = 0.02 }),
	} }
end })

def("land_dust", { group = "movement",
	adapt = function(_, o)
		local i = clamp01(if o.impact == nil then 0.5 else o.impact)
		o.scale = (o.scale or 1) * (0.7 + i * 0.9)
		o.intensity = (o.intensity or 1) * (0.6 + i * 0.8)
	end,
	extra = function(at, o)
		local i = clamp01(if o.impact == nil then 0.5 else o.impact)
		if i > 0.6 then
			FXKit.shakeAt(at, (i - 0.6) * 0.8, 40)
		end
	end,
	build = function(st, _, c)
		return { layers = {
			puff(st, { count = 10, size = 1.3, life = { 0.45, 0.8 }, speed = { 10, 15 }, spread = { 180, 5 }, drag = 6, rise = 1.2, color = c }),
			puff(st, { count = 4, size = 1.6, life = { 0.6, 0.9 }, speed = { 2, 4 }, direction = "up", spread = { 40, 40 },
				color = c, delay = 0.03 }),
			particles(st, "debris", { count = 6, lifetime = { 0.45, 0.75 }, speed = { 8, 14 }, direction = "up", spread = { 50, 50 },
				size = { { 0, 0.22 }, { 0.8, 0.18 }, { 1, 0 } }, color = col(st, "#8C7A62"), acceleration = V(0, -55, 0),
				rotation = { 0, 360 }, rotSpeed = { -400, 400 }, drag = 0.5 }),
			ring(st, { size = { 1, 6 }, duration = 0.3, alpha = 0.55, color = c or "#F2E9DA" }),
		} }
	end })

def("double_jump_ring", { group = "movement", build = function(st, _, c)
	local main = c or tone(st, "#BFEFFF")
	return { layers = {
		flash(st, { size = { 0.5, 2.5 }, transparency = { 0.4, 1 }, duration = 0.12, color = "#FFFFFF" }),
		ring(st, { size = { 1.2, 7 }, duration = 0.35, color = { "#FFFFFF", main }, exact = c ~= nil, alpha = 0.05 }),
		ring(st, { delay = 0.06, size = { 0.8, 4.5 }, duration = 0.3, color = main, exact = true, alpha = 0.2 }),
		glints(st, { count = 6, direction = "forward", spread = { 180, 30 }, speed = { 6, 10 }, size = 0.6, life = { 0.25, 0.4 },
			color = { "#FFFFFF", main }, exact = c ~= nil }),
		puff(st, { count = 4, size = 0.8, life = { 0.3, 0.45 }, direction = "down", spread = { 35, 35 }, speed = { 4, 8 },
			color = "#FFFFFF", rise = 0 }),
	} }
end })

def("dash_streak", { group = "movement",
	adapt = function(_, o)
		if typeof(o.direction) == "Vector3" and o.direction.Magnitude > 1e-3 then
			o.normal = o.direction -- the effect's up is the dash direction: rings stand across it, "down" is behind
			o.direction = nil
		end
	end,
	build = function(st, _, c)
		local main = c or tone(st, "#DFF6FF")
		return { layers = {
			flash(st, { size = { 0.4, 2 }, transparency = { 0.3, 1 }, duration = 0.08, color = "#FFFFFF" }),
			ring(st, { size = { 1.5, 6.5 }, duration = 0.25, color = main, exact = true, alpha = 0.1 }),
			particles(st, "streak", { count = 10, direction = "down", spread = { 12, 12 }, speed = { 30, 48 },
				lifetime = { 0.16, 0.28 }, orientation = "parallel", size = { { 0, 0.35 }, { 1, 0.05 } },
				squash = { { 0, 2.8 }, { 1, 1.5 } }, color = { "#FFFFFF", main }, lightEmission = st.sparkGlow,
				lightInfluence = 0, drag = 4, transparency = { { 0, 0 }, { 1, 1 } } }),
			puff(st, { count = 5, size = 1.2, life = { 0.3, 0.5 }, direction = "down", spread = { 30, 30 }, speed = { 5, 9 }, rise = 0 }),
		} }
	end })

def("speed_lines", { group = "movement", screen = true })

def("boost_flame", { group = "movement", continuous = true, flicker = true, build = function(st, _, c)
	local hot = c or tone(st, if st.name == "neon" then "#3AF2FF" else "#FFC23A")
	local deep = shade(hot, -0.45)
	return { layers = {
		particles(st, "flame", { rate = 70, lifetime = { 0.1, 0.18 }, speed = { 14, 20 }, direction = "back", spread = { 6, 6 },
			size = { { 0, 1.1 }, { 1, 0.15 } }, transparency = { { 0, 0.05 }, { 1, 1 } },
			color = { { 0, "#FFFFFF" }, { 0.3, hot }, { 1, deep } }, lightEmission = 1, lightInfluence = 0, zoffset = 0.5 }),
		particles(st, "flame", { rate = 40, lifetime = { 0.16, 0.28 }, speed = { 10, 15 }, direction = "back", spread = { 12, 12 },
			size = { { 0, 1.7 }, { 1, 0.4 } }, transparency = { { 0, 0.4 }, { 1, 1 } }, color = { hot, deep },
			lightEmission = if st.opaque then 0.5 else 1, lightInfluence = 0, rotation = { 0, 360 } }),
		sparks(st, { rate = 18, direction = "back", speed = { 16, 28 }, spread = { 15, 15 }, gravity = 8, size = 0.18,
			colors = { "#FFFFFF", hot }, exact = true, life = { 0.2, 0.35 } }),
		light(st, { color = hot, exact = true, brightness = 3, range = 10, duration = 0 }),
	} }
end })

local DRIFT = { "#59B8FF", "#FF9A2E", "#C46BFF" }
def("drift_sparks", { group = "movement", continuous = true, variants = { "1", "2", "3" }, default = "1",
	build = function(st, v, c)
		local tier = math.clamp(tonumber(v) or 1, 1, 3)
		local hot = c or DRIFT[tier]
		local layers = {
			sparks(st, { rate = 30 + tier * 18, direction = "back", spread = { 35, 45 }, speed = { 10, 18 }, gravity = 50,
				size = 0.2 + tier * 0.03, colors = { "#FFFFFF", hot }, exact = true, life = { 0.15, 0.3 } }),
			particles(st, "spark", { rate = 22, lifetime = { 0.06, 0.1 }, speed = { 0, 0 }, size = { { 0, 0.6 + tier * 0.25 }, { 1, 0.2 } },
				transparency = { { 0, 0.1 }, { 1, 1 } }, color = { "#FFFFFF", hot }, lightEmission = 1, lightInfluence = 0,
				zoffset = 0.4 }),
			light(st, { color = hot, exact = true, brightness = 1.5 + tier * 0.5, range = 6, duration = 0 }),
		}
		if tier >= 3 then
			table.insert(layers, glints(st, { rate = 10, size = 0.7, life = { 0.2, 0.3 }, speed = { 3, 6 }, color = { "#FFFFFF", hot }, exact = true }))
		end
		return { layers = layers }
	end })

def("water_splash", { group = "movement", build = function(st, _, c)
	local water = c or tone(st, "#BFE9FF")
	return { layers = {
		flash(st, { shape = "sphere", size = { V(1, 0.2, 1), V(5, 0.3, 5) }, transparency = { 0.15, 1 }, duration = 0.3,
			color = "#FFFFFF", material = "smoothplastic" }),
		particles(st, "drop", { count = 22, direction = "up", spread = { 28, 28 }, speed = { 14, 24 }, lifetime = { 0.5, 0.85 },
			size = { { 0, 0.45 }, { 1, 0.2 } }, transparency = { { 0, 0 }, { 0.8, 0.15 }, { 1, 1 } }, color = { "#FFFFFF", water },
			acceleration = V(0, -55, 0), drag = 0.6, orientation = if st.opaque then nil else "parallel",
			squash = if st.opaque then nil else { { 0, 0.8 }, { 1, 0 } } }),
		puff(st, { count = 8, size = 1.4, life = { 0.5, 0.9 }, direction = "up", spread = { 60, 60 }, speed = { 6, 10 },
			rise = 0, drag = 3, color = "#EAF8FF", slot = "mist", alpha = 0.2 }),
		ring(st, { size = { 1.5, 8 }, duration = 0.6, color = "#FFFFFF", alpha = 0.2 }),
		ring(st, { delay = 0.15, size = { 1, 5 }, duration = 0.5, color = water, exact = true, alpha = 0.35 }),
	} }
end })

def("wake_spray", { group = "movement", continuous = true, build = function(st, _, c)
	local water = c or tone(st, "#D6F2FF")
	local function side(x, dir)
		return particles(st, "drop", { offset = V(x, 0, 1.2), rate = 35, direction = dir, spread = { 25, 30 }, speed = { 6, 11 },
			lifetime = { 0.4, 0.7 }, size = { { 0, 0.5 }, { 1, 0.15 } }, transparency = { { 0, 0.05 }, { 0.8, 0.2 }, { 1, 1 } },
			color = { "#FFFFFF", water }, acceleration = V(0, -30, 0), drag = 0.8 })
	end
	local function up(x)
		return particles(st, "drop", { offset = V(x, 0, 1.6), rate = 25, direction = "up", spread = { 30, 30 }, speed = { 8, 13 },
			lifetime = { 0.45, 0.7 }, size = { { 0, 0.35 }, { 1, 0.1 } }, transparency = { { 0, 0 }, { 0.8, 0.2 }, { 1, 1 } },
			color = "#FFFFFF", acceleration = V(0, -40, 0), drag = 0.6 })
	end
	return { layers = {
		side(-1.4, "left"), side(1.4, "right"), up(-1.2), up(1.2),
		puff(st, { offset = V(0, 0, 2.4), rate = 25, size = 1.6, life = { 0.6, 1 }, direction = "back", spread = { 25, 10 },
			speed = { 2, 4 }, rise = 0, color = "#FFFFFF", slot = "mist", alpha = 0.1 }),
	} }
end })

def("footstep_dust", { group = "movement", build = function(st, _, c)
	return { layers = {
		puff(st, { count = 4, size = 0.6, life = { 0.25, 0.4 }, speed = { 2.5, 4.5 }, spread = { 180, 8 }, drag = 6, rise = 1, color = c }),
		puff(st, { count = 2, size = 0.5, life = { 0.3, 0.45 }, speed = { 1, 2 }, direction = "up", spread = { 30, 30 },
			color = shade(c or "#E9E0D0", 0.5) }),
	} }
end })

def("skid_marks", { group = "movement", trail = true })

-------------------------------------------------- combat
local MUZZLE = { pistol = 0.7, rifle = 1, shotgun = 1.25 }
def("muzzle_flash", { group = "combat", variants = { "rifle", "pistol", "shotgun" }, default = "rifle",
	build = function(st, v, c)
		local k = MUZZLE[v] or 1
		local wide = v == "shotgun"
		local hot = c or tone(st, "#FFC24A")
		return { layers = {
			flash(st, { offset = V(0, 0, -0.7 * k), size = { V(0.5, 0.5, 1.4) * k, V(0.9, 0.9, 2.8) * k }, transparency = { 0, 1 },
				duration = 0.05, color = "#FFF4C2", material = "neon" }),
			particles(st, "star", { count = 1, lifetime = { 0.04, 0.06 }, speed = { 0, 0 }, size = { { 0, 2.4 * k }, { 1, 1.2 * k } },
				transparency = { { 0, 0 }, { 1, 0.8 } }, rotation = { 0, 360 }, color = { "#FFFFFF", hot }, lightEmission = 1,
				lightInfluence = 0, zoffset = 1 }),
			particles(st, "flame", { count = if wide then 7 else 4, direction = "forward", spread = if wide then { 22, 22 } else { 10, 10 },
				speed = { 12 * k, 22 * k }, lifetime = { 0.04, 0.08 }, size = { { 0, 0.8 * k }, { 1, 0.2 } }, orientation = "parallel",
				squash = { { 0, 1.5 }, { 1, 1 } }, color = { { 0, "#FFFFFF" }, { 0.4, hot }, { 1, shade(hot, -0.4) } },
				lightEmission = 1, lightInfluence = 0 }),
			sparks(st, { count = if wide then 10 else 3, direction = "forward", spread = if wide then { 25, 25 } else { 10, 10 },
				speed = { 40, 70 }, life = { 0.08, 0.15 }, size = 0.12, gravity = 20, colors = { "#FFFFFF", hot }, exact = true }),
			puff(st, { delay = 0.03, count = if wide then 4 else 2, size = 0.8 * k, life = { 0.5, 0.9 }, direction = "forward",
				spread = { 15, 15 }, speed = { 2, 4 }, rise = 2, color = "#BDB8B2", slot = "smoke", alpha = 0.45 }),
			light(st, { color = hot, exact = true, brightness = 4, range = 10 * k, duration = 0.06 }),
		} }
	end })

def("bullet_tracer", { group = "combat", dynamic = true })

local function scorchLayer(st, size, duration)
	return { kind = "decal", texture = (texOf(st, "scorch")), size = size, color = "#151210", transparency = { 0.2, 0.2 },
		duration = duration, fade = duration * 0.4, rotation = { 0, 360 } }
end

local IMPACT = {
	concrete = function(st, c)
		local dust = c or tone(st, "#B9B3AA")
		return {
			flash(st, { size = { 0.2, 1.2 }, duration = 0.05 }),
			puff(st, { count = 6, size = 1, life = { 0.4, 0.8 }, direction = "up", spread = { 45, 45 }, speed = { 4, 9 }, color = dust }),
			particles(st, "debris", { count = 8, direction = "up", spread = { 50, 50 }, speed = { 10, 18 }, lifetime = { 0.4, 0.7 },
				size = { { 0, 0.22 }, { 0.8, 0.16 }, { 1, 0 } }, color = col(st, "#8D8A84"), acceleration = V(0, -55, 0),
				rotation = { 0, 360 }, rotSpeed = { -500, 500 } }),
			sparks(st, { count = 3, speed = { 14, 22 }, size = 0.12, life = { 0.08, 0.16 } }),
			scorchLayer(st, { 0.5, 0.7 }, 5),
		}
	end,
	metal = function(st, c)
		local hot = c or "#FFB23E"
		return {
			flash(st, { size = { 0.2, 1.4 }, duration = 0.05, color = "#FFFBEA" }),
			particles(st, "star", { count = 1, lifetime = { 0.05, 0.07 }, speed = { 0, 0 }, size = { { 0, 1.6 }, { 1, 0.8 } },
				transparency = { { 0, 0 }, { 1, 0.6 } }, rotation = { 0, 360 }, color = "#FFFFFF", lightEmission = 1, lightInfluence = 0 }),
			sparks(st, { count = 14, speed = { 18, 34 }, spread = { 50, 50 }, gravity = 60, size = 0.16, life = { 0.2, 0.45 },
				colors = { "#FFFFFF", hot }, exact = c ~= nil }),
			puff(st, { count = 2, size = 0.6, life = { 0.4, 0.7 }, direction = "up", spread = { 30, 30 }, speed = { 2, 4 },
				color = "#9A9590", slot = "smoke", alpha = 0.4 }),
			light(st, { color = hot, brightness = 2, range = 6, duration = 0.08 }),
			scorchLayer(st, { 0.4, 0.5 }, 5),
		}
	end,
	wood = function(st, c)
		local wood = c or tone(st, "#A7774A")
		return {
			flash(st, { size = { 0.2, 1 }, duration = 0.05 }),
			particles(st, "shard", { count = 8, direction = "up", spread = { 45, 45 }, speed = { 8, 16 }, lifetime = { 0.5, 0.8 },
				size = { { 0, 0.32 }, { 0.8, 0.28 }, { 1, 0 } }, squash = { { 0, 1.2 }, { 1, 1.2 } }, color = wood,
				acceleration = V(0, -45, 0), rotation = { 0, 360 }, rotSpeed = { -600, 600 } }),
			puff(st, { count = 4, size = 0.8, life = { 0.35, 0.6 }, direction = "up", spread = { 40, 40 }, speed = { 3, 6 },
				color = shade(wood, 0.45) }),
			scorchLayer(st, { 0.4, 0.5 }, 5),
		}
	end,
	flesh = function(st, c) -- a cartoon hit: a soft coloured puff and a white hit star, no gore
		local hit = c or tone(st, "#E8707A")
		return {
			particles(st, "star", { count = 1, lifetime = { 0.08, 0.1 }, speed = { 0, 0 }, size = { { 0, 0.6 }, { 0.3, 1.8 }, { 1, 1.2 } },
				transparency = { { 0, 0 }, { 1, 1 } }, rotation = { 0, 360 }, color = "#FFFFFF", lightEmission = 0.6, lightInfluence = 0,
				zoffset = 1 }),
			puff(st, { count = 6, size = 0.7, life = { 0.25, 0.45 }, direction = "up", spread = { 60, 60 }, speed = { 4, 8 }, rise = 0,
				color = hit, slot = "mist" }),
			ring(st, { size = { 0.3, 2.2 }, duration = 0.15, color = "#FFFFFF", alpha = 0.1, flat = false }),
		}
	end,
	water = function(st, c)
		local water = c or tone(st, "#BFE9FF")
		return {
			particles(st, "drop", { count = 10, direction = "up", spread = { 20, 20 }, speed = { 8, 14 }, lifetime = { 0.35, 0.6 },
				size = { { 0, 0.3 }, { 1, 0.12 } }, transparency = { { 0, 0 }, { 0.8, 0.2 }, { 1, 1 } }, color = { "#FFFFFF", water },
				acceleration = V(0, -50, 0), drag = 0.5 }),
			ring(st, { size = { 0.5, 3 }, duration = 0.4, color = "#FFFFFF", alpha = 0.25 }),
			puff(st, { count = 3, size = 0.8, life = { 0.3, 0.6 }, direction = "up", spread = { 40, 40 }, speed = { 3, 5 }, rise = 0,
				color = "#EAF8FF", slot = "mist", alpha = 0.3 }),
		}
	end,
}
for _, kind in { "concrete", "metal", "wood", "flesh", "water" } do
	def("impact_" .. kind, { group = "combat", build = function(st, _, c)
		return { layers = IMPACT[kind](st, c) }
	end })
end

def("explosion", { group = "combat", variants = { "small", "large" }, default = "small",
	adapt = function(_, o, v)
		if v == "large" then
			o.scale = (o.scale or 1) * 2.2
			o.intensity = (o.intensity or 1) * 1.5
		end
	end,
	extra = function(at, o, st, v)
		local s = (o.scale or 1)
		FXKit.shakeAt(at, if v == "large" then 0.75 else 0.4, 30 * s)
		FXKit.flashAt(at, "#FFE6B0", if v == "large" then 0.35 else 0.18, 25 * s)
		FXKit.debris(at, { count = math.floor((if v == "large" then 9 else 4) * (o.intensity or 1)), size = 0.5 * math.sqrt(s),
			speed = 32 * math.sqrt(s), color = tone(st, "#3B3633") })
		FXKit.scorch(at, 3 * s, 6)
	end,
	build = function(st)
		local fire = { { 0, "#FFF3B0" }, { 0.2, "#FFB13A" }, { 0.55, "#D9481C" }, { 1, "#3A2A26" } }
		return { layers = {
			flash(st, { size = { 1.5, 6 }, transparency = { 0, 1 }, duration = 0.12, color = "#FFF6D6" }),
			light(st, { color = "#FF9A3A", brightness = 6, range = 24, duration = 0.5 }),
			particles(st, "fireball", { count = 12, direction = "up", spread = { 180, 180 }, speed = { 5, 10 }, drag = 5,
				lifetime = { 0.5, 0.9 }, size = { { 0, 2 }, { 0.2, 3.8 }, { 1, 4.6 } }, transparency = { { 0, 0 }, { 0.5, 0.1 }, { 1, 1 } },
				color = col(st, fire), lightEmission = if st.opaque then 0.3 else 0.8, lightInfluence = 0, rotation = { 0, 360 },
				rotSpeed = { -60, 60 }, zoffset = 1 }),
			ring(st, { delay = 0.02, size = { 2, 16 }, duration = 0.45, color = "#FFE6B0", alpha = 0.15 }),
			sparks(st, { count = 22, spread = { 180, 180 }, speed = { 25, 45 }, gravity = 35, size = 0.25, life = { 0.35, 0.8 },
				colors = { "#FFF6C8", "#FF8A2A" } }),
			particles(st, "debris", { count = 10, direction = "up", spread = { 70, 70 }, speed = { 20, 34 }, lifetime = { 0.8, 1.3 },
				size = { { 0, 0.45 }, { 0.85, 0.35 }, { 1, 0 } }, color = col(st, "#3B3633"), acceleration = V(0, -70, 0),
				rotation = { 0, 360 }, rotSpeed = { -500, 500 } }),
			ring(st, { delay = 0.06, size = { 1, 10 }, duration = 0.5, color = "#FFFFFF", alpha = 0.2, flat = false }),
			puff(st, { delay = 0.12, count = 12, size = 4, life = { 1.4, 2 }, direction = "up", spread = { 22, 22 }, speed = { 8, 14 },
				drag = 1.5, rise = 4, color = if st.opaque then "#6B6366" else "#4A4442", slot = "smoke", alpha = 0.2, grow = 2.2 }),
		} }
	end })

