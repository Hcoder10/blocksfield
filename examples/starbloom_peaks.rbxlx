	comboTxt.Text = "x2"
	comboTxt.TextSize = 26
	comboTxt.TextColor3 = CORAL
	comboTxt.TextXAlignment = Enum.TextXAlignment.Center
	comboTxt.TextYAlignment = Enum.TextYAlignment.Center
