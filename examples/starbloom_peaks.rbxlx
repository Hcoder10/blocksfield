FXKit.PRESETS = ORDER

------------------------------------------------------------------------------------------------ resolve & build
local function styleOf(o)
	local s = o and o.style
	if type(s) == "string" and STYLES[s] then
		return STYLES[s]
	end
	return STYLES[currentStyle]
end

-- name (maybe "explosion_large") -> preset name, meta, variant
local function resolve(name, o)
	if type(name) ~= "string" then
		return nil, nil, nil
	end
	local meta = P[name]
	local variant = o and (o.variant or o.tier or o.kind)
	if not meta then
		local base, suffix = string.match(name, "^(.-)_([%w]+)$")
		if base and P[base] then
			name, meta, variant = base, P[base], variant or suffix
		end
	end
	if not meta then
		return nil, nil, nil
	end
	variant = if variant ~= nil then tostring(variant) else meta.default
	if meta.variants and variant and not table.find(meta.variants, variant) then
		warnOnce("variant:" .. name .. variant, "'" .. name .. "' has no variant '" .. variant .. "' (" .. table.concat(meta.variants,
			", ") .. ")")
		variant = meta.default
	end
	return name, meta, variant
end

-- Readability pass (from a Studio review at 20-40 studs): presets are authored at "small" scale, then sizes, counts,
-- lifetimes, opacity and light are pushed up here so effects read big, punchy and held. Change FXKit.tuning, then
-- call FXKit.retune() to rebuild.
FXKit.tuning = { size = 2.3, count = 1.7, life = 1.5, light = 2.6, flash = 2.2, opacity = 0.7, ambient = 0.55 }

local function scaleSeq(seq, k)
	if type(seq) == "number" then
		return seq * k
	elseif type(seq) == "table" then
		local out = {}
		for i, kp in seq do
			if type(kp) == "table" then
				out[i] = { kp[1], kp[2] * k, if kp[3] then kp[3] * k else nil }
			elseif type(kp) == "number" then
				out[i] = kp * k
			else
				out[i] = kp
			end
		end
		return out
	end
	return seq
end

-- transparency keypoints pulled toward opaque (the last keypoint, the fade-out, is kept)
local function opaqueSeq(seq, k)
	if type(seq) ~= "table" then
		return seq
	end
	local out = {}
	for i, kp in seq do
		if type(kp) == "table" and i < #seq then
			out[i] = { kp[1], kp[2] * k }
		else
			out[i] = kp
		end
	end
	return out
end

local function pairScale(v, k)
	if type(v) == "table" then
		local a, b = v[1], v[2]
		return { if typeof(a) == "Vector3" or type(a) == "number" then a * k else a,
			if typeof(b) == "Vector3" or type(b) == "number" then b * k else b }
	elseif type(v) == "number" or typeof(v) == "Vector3" then
		return v * k
	end
	return v
end

local function punchUp(spec, meta)
	local T = FXKit.tuning
	-- ambient fields and weather grow less (many small things, not one event)
	local a = if meta.weather then T.ambient elseif meta.group == "ambient" then 0.75 else 1
	local function lerpK(k)
		return 1 + (k - 1) * a
	end
	local size, count, life = lerpK(T.size), lerpK(T.count), lerpK(T.life)
	for _, L in spec.layers do
		local k = L.kind
		if k == "particles" then
			L.size = scaleSeq(L.size, size)
			if type(L.shape) == "table" and meta.group ~= "ambient" then
				L.shape = table.clone(L.shape)
				L.shape.size = pairScale(L.shape.size, math.sqrt(size))
			end
			if L.count then
				L.count = math.min(math.floor(L.count * count + 0.5), 400)
			end
			if L.rate and not meta.weather then
				L.rate = math.min(L.rate * count * 0.85, 400)
			end
			if type(L.lifetime) == "table" and not meta.weather then
				L.lifetime = { math.min(math.max(L.lifetime[1] * life, 0.14), 2.4), math.min(math.max(L.lifetime[2] * life, 0.24), 3) }
			end
			if L.duration then
				L.duration *= life
			end
			if not meta.weather then
				L.transparency = opaqueSeq(L.transparency, T.opacity)
				if (L.lightEmission or 0) >= 0.5 then
					L.brightness = math.min((L.brightness or 1) * 1.8, 4)
				end
			end
			-- bursts open up with their size
			if L.count and type(L.speed) == "table" then
				L.speed = { L.speed[1] * math.sqrt(size), L.speed[2] * math.sqrt(size) }
			end
		elseif k == "flash" then
			L.size = pairScale(L.size, T.flash)
			L.duration = math.clamp((L.duration or 0.1) * 2.2, 0.15, 0.4)
		elseif k == "ring" then
			L.size = pairScale(L.size, size * 0.9)
			L.duration = math.clamp((L.duration or 0.35) * 1.6, 0.4, 1.2)
			L.transparency = opaqueSeq(L.transparency, 0.5)
			L.brightness = math.min((L.brightness or 1) * 2, 6)
			L.lightEmission = math.max(L.lightEmission or 0, 0.6)
		elseif k == "beam" then
			L.width = pairScale(L.width, 1.8)
			L.duration = (L.duration or 0.3) * 1.8
			L.fadeOut = math.min((L.fadeOut or 0.15) * 1.6, 1)
		elseif k == "light" then
			L.brightness = math.min((L.brightness or 2) * T.light, 10)
			L.range = math.min((L.range or 12) * 1.6, 60)
			if L.duration and L.duration > 0 then
				L.duration = math.max(L.duration * 2, 0.35)
			end
		elseif k == "decal" then
			L.size = pairScale(L.size, 1.6)
		end
	end
	return spec
end

function FXKit.retune()
	table.clear(specCache)
end

local function build(name, meta, st, variant, o)
	local c = asHex(o and o.color)
	local area = if meta.weather or name == "lava_embers" then tostring(math.floor(tonumber(o and o.area) or 60)) else ""
	local key = name .. "|" .. st.name .. "|" .. tostring(variant) .. "|" .. tostring(c) .. "|" .. area
	local spec = specCache[key]
	if spec then
		return spec
	end
	local ok, result = pcall(meta.build, st, variant, c, o or {})
	if not ok or type(result) ~= "table" then
		warnOnce("build:" .. key, "preset '" .. name .. "' failed to build: " .. tostring(result))
		return nil
	end
	result.family = result.family or name
	punchUp(result, meta)
	for _, problem in VFX.validate(result) do
		warnOnce("spec:" .. key .. problem, "preset '" .. name .. "' (" .. st.name .. "): " .. problem)
	end
	specCache[key] = result
	return result
end

-- The spec a preset builds for a style (nil for screen / dynamic / controller presets); for tools and tests.
function FXKit.spec(name, opts)
	local o = if type(opts) == "table" then opts else {}
	local n, meta, variant = resolve(name, o)
	if not meta or not meta.build then
		return nil
	end
	return build(n, meta, styleOf(o), variant, o)
end

------------------------------------------------------------------------------------------------ handles
local Handle = {}
Handle.__index = Handle

local function newHandle(fx, cleanup)
	return setmetatable({ fx = fx, cleanup = cleanup or {}, alive = true, base = nil }, Handle)
end

-- Continuous emission rate as a multiple of the preset's own (0 pauses, 1 = as tuned; e.g. by speed).
function Handle:set(k)
	local fx = self.fx
	if not fx or not fx.alive or type(k) ~= "number" then
		return self
	end
	if not self.base then
		self.base = {}
		for _, e in fx.continuous do
			self.base[e] = e.Rate
		end
	end
	for e, rate in self.base do
		if e.Parent then
			e.Rate = rate * math.max(k, 0)
			e.Enabled = k > 0
		end
	end
	return self
end

function Handle:stop()
	if not self.alive then
		return self
	end
	self.alive = false
	if self.fx then
		self.fx:stop()
	end
	for _, fn in self.cleanup do
		task.spawn(fn)
	end
	table.clear(self.cleanup)
	return self
end
Handle.Destroy = Handle.stop
Handle.destroy = Handle.stop

function Handle:andThen(fn)
	if self.fx then
		self.fx:andThen(fn)
	end
	return self
end

local NULL = setmetatable({ alive = false, cleanup = {} }, Handle)

------------------------------------------------------------------------------------------------ juice helpers
local function cameraRig()
	return if IS_CLIENT then optional("CameraRig") else nil
end

local function positionOf(at)
	local ty = typeof(at)
	if ty == "Vector3" then
		return at
	elseif ty == "CFrame" then
		return at.Position
	elseif ty == "Instance" then
		if at:IsA("Attachment") then
			return at.WorldPosition
		elseif at:IsA("BasePart") then
			return at.Position
		elseif at:IsA("Model") then
			return at:GetPivot().Position
		end
	end
	return nil
end

local function cameraFalloff(at, radius)
	local pos = positionOf(at)
	local cam = workspace.CurrentCamera
	if not pos or not cam then
		return 1
	end
	return math.clamp(1 - (cam.CFrame.Position - pos).Magnitude / math.max(radius, 1), 0, 1)
end

-- Camera shake (trauma 0..1), fading to nothing `radius` studs from the camera.
function FXKit.shakeAt(at, trauma, radius)
	if not IS_CLIENT then
		return
	end
	local t = trauma * cameraFalloff(at, radius or 60)
	if t <= 0.01 then
		return
	end
	local rig = cameraRig()
	if rig and type(rig.shake) == "function" then
		rig.shake(math.clamp(t, 0, 1))
		return
	end
	local Shake = optional("Shake")
	if Shake and type(Shake.kick) == "function" then
		Shake.kick(math.clamp(t, 0, 1))
	end
end

function FXKit.flashAt(at, color, strength, radius)
	local k = cameraFalloff(at, radius or 60)
	if k > 0.05 then
		FXKit.flash(color, strength * k)
	end
end

-- Freeze-frame: intensity 0..1 -> 30..120 ms.
function FXKit.hitstop(intensity)
	VFX.hitstop(0.03 + 0.09 * clamp01(intensity or 0.5))
end

-- Camera punch: an FOV snap, a shake and (with a direction) a positional kick. intensity 0..1.
function FXKit.punch(intensity, direction)
	if not IS_CLIENT then
		return
	end
	local i = clamp01(intensity or 0.5)
	local rig = cameraRig()
	if rig then
		if type(rig.kick) == "function" then
			rig.kick(-(2 + 6 * i), 0.2 + 0.15 * i)
		end
		if type(rig.shake) == "function" then
			rig.shake(0.15 + 0.45 * i)
		end
		if typeof(direction) == "Vector3" and type(rig.punch) == "function" then
			rig.punch(direction, 0.15 + 0.5 * i)
		end
		return
	end
	local Shake = optional("Shake")
	if Shake and type(Shake.kick) == "function" then
		Shake.kick(0.15 + 0.45 * i)
	end
end

function FXKit.flash(color, strength, seconds)
	VFX.screenFlash(color or "#FFFFFF", seconds or 0.15, strength or 0.35)
end

-- Slow motion for things that read CameraRig.timeScale (VFX particles, camera moves); physics is untouched.
function FXKit.slowmo(scale, seconds)
	local rig = cameraRig()
	if rig and type(rig.slowmo) == "function" then
		rig.slowmo(scale, seconds)
	end
end

------------------------------------------------------------------------------------------------ world helpers
local function fxFolder(name)
	local f = workspace:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = workspace
	end
	return f
end

local function rayParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	for _, n in { "KitVFX", "KitFXDebris", "KitFXWorld" } do
		local f = workspace:FindFirstChild(n)
		if f then
			table.insert(ignore, f)
		end
	end
	for _, plr in Players:GetPlayers() do
		if plr.Character then
			table.insert(ignore, plr.Character)
		end
	end
	params.FilterDescendantsInstances = ignore
	return params
end

-- A scorch mark on the ground below `at` (when there is ground within reach).
function FXKit.scorch(at, size, seconds)
	local pos = positionOf(at)
	if not pos then
		return
	end
	local hit = workspace:Raycast(pos + Vector3.new(0, 1, 0), Vector3.new(0, -(size + 3), 0), rayParams())
	if hit then
		local st = STYLES[currentStyle]
		VFX.effect({ family = "scorch", layers = { scorchLayer(st, { size * 0.6, size }, seconds or 6) } }, hit.Position,
			{ normal = hit.Normal }, "scorch")
	end
end

-- Physical chunks flung from `at` that bounce, fade and disappear (client-side, ignored by queries and touches).
function FXKit.debris(at, opts)
	local pos = positionOf(at)
	if not pos then
		return
	end
	opts = opts or {}
	local folder = fxFolder("KitFXDebris")
	local count = math.clamp(opts.count or 5, 0, 24)
	local color = asHex(opts.color) or "#3B3633"
	local r, g, b = FxMath.hex(color)
	for _ = 1, count do
		local p = Instance.new("Part")
		p.Name = "Debris"
		local s = (opts.size or 0.5) * (0.6 + math.random() * 0.8)
		p.Size = Vector3.new(s, s * (0.6 + math.random() * 0.6), s)
		p.Color = Color3.new(r :: number, g :: number, b :: number)
		p.Material = Enum.Material.Slate
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.CFrame = CFrame.new(pos + Vector3.new(math.random() - 0.5, 0.5, math.random() - 0.5))
			* CFrame.Angles(math.random() * 6.28, math.random() * 6.28, 0)
		p.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0.5, 0.3)
		p.Parent = folder
		local dir = Vector3.new(math.random() - 0.5, 0.9 + math.random() * 0.6, math.random() - 0.5).Unit
		p.AssemblyLinearVelocity = dir * (opts.speed or 30) * (0.6 + math.random() * 0.6)
		p.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 30
		task.delay(1.6 + math.random() * 0.6, function()
			if p.Parent then
				TweenService:Create(p, TweenInfo.new(0.5), { Transparency = 1, Size = p.Size * 0.3 }):Play()
				task.delay(0.55, function()
					p:Destroy()
				end)
			end
		end)
	end
end

------------------------------------------------------------------------------------------------ dynamic presets
local function lookFrame(from, to)
	local d = to - from
	if d.Magnitude < 1e-3 then
		return CFrame.new(from), 0
	end
	local up = if math.abs(d.Unit.Y) > 0.99 then Vector3.zAxis else Vector3.yAxis
	return CFrame.lookAt(from, to, up), d.Magnitude
end

-- A bullet tracer from `from` to `to` (Vector3s / parts / attachments). opts: color, width, impact = "concrete" |
-- "metal" | "wood" | "flesh" | "water" (plays that impact at the end, facing opts.normal), style.
function FXKit.tracer(from, to, opts)
	opts = opts or {}
	local a, b = positionOf(from), positionOf(to)
	if not a or not b then
		warnOnce("tracer:args", "tracer(from, to) needs two positions")
		return NULL
	end
	local st = styleOf(opts)
	local cf, dist = lookFrame(a, b)
	local hot = asHex(opts.color) or tone(st, "#FFC04D")
	local w = tonumber(opts.width) or 0.22
	local life = math.clamp(dist / 600, 0.06, 0.16)
	local fx = VFX.effect({ family = "bullet_tracer", layers = {
		{ kind = "beam", from = V(0, 0, 0), to = V(0, 0, -dist), width = { w * 0.4, w }, color = { hot, "#FFF7D6" },
			transparency = { { 0, 0.8 }, { 1, 0 } }, lightEmission = 1, lightInfluence = 0, duration = 0.08, fadeOut = 0.12 },
		{ kind = "beam", from = V(0, 0, 0), to = V(0, 0, -dist), width = { w * 1.2, w * 2.5 }, color = hot,
			transparency = { { 0, 0.95 }, { 1, 0.6 } }, lightEmission = 1, lightInfluence = 0, duration = 0.06, fadeOut = 0.1 },
		{ kind = "particles", texture = (texOf(st, "streak")), count = 1, direction = "forward", spread = 0,
			speed = math.min(dist / life, 1000), lifetime = life, orientation = "parallel", size = { { 0, w * 3 }, { 1, w * 2 } },
			squash = { { 0, 3 }, { 1, 3 } }, color = "#FFFFFF", lightEmission = 1, lightInfluence = 0, transparency = { { 0, 0 }, { 1, 0.4 } } },
	} }, cf, nil, "bullet_tracer")
	if type(opts.impact) == "string" then
		local delay = life
		task.delay(delay, function()
			FXKit.play("impact_" .. opts.impact, b, { normal = opts.normal or (a - b), style = opts.style })
		end)
	end
	return newHandle(fx)
end

-- A forked lightning strike from `from` to `to`. opts: color, width, segments, style.
function FXKit.lightning(from, to, opts)
	opts = opts or {}
	local a, b = positionOf(from), positionOf(to)
	if not a or not b then
		warnOnce("lightning:args", "lightning(from, to) needs two positions")
		return NULL
	end
	local st = styleOf(opts)
	local cf, dist = lookFrame(a, b)
	local hue = asHex(opts.color) or tone(st, "#9CC8FF")
	local n = math.clamp(math.floor(tonumber(opts.segments) or dist / 3), 4, 14)
	local w = tonumber(opts.width) or 0.6
	local layers = {}
	local function bolt(delay, width, jitter, alpha)
		local prev = V(0, 0, 0)
		for i = 1, n do
			local z = -dist * i / n
			local p = if i == n then V(0, 0, -dist) else V((math.random() - 0.5) * jitter, (math.random() - 0.5) * jitter, z)
			table.insert(layers, { kind = "beam", delay = delay, from = prev, to = p, width = { width, width * 0.8 },
				color = { "#FFFFFF", hue }, transparency = alpha, lightEmission = 1, lightInfluence = 0, duration = 0.1, fadeOut = 0.12,
				faceCamera = true })
			prev = p
		end
	end
	local jitter = math.clamp(dist * 0.12, 0.5, 6)
	bolt(0, w, jitter, 0)
	bolt(0, w * 3, jitter * 0.2, 0.75)
	bolt(0.08, w * 0.7, jitter, 0.1)
	bolt(0.16, w * 0.9, jitter, 0.05)
	table.insert(layers, flash(st, { offset = V(0, 0, -dist), size = { 1.5, 7 }, duration = 0.2, color = "#FFFFFF" }))
	table.insert(layers, ring(st, { offset = V(0, 0, -dist), size = { 2, 14 }, duration = 0.5, color = hue, exact = true, alpha = 0 }))
	table.insert(layers, light(st, { offset = V(0, 0, -dist), color = hue, exact = true, brightness = 12, range = 40, duration = 0.5 }))
	table.insert(layers, sparks(st, { offset = V(0, 0, -dist), count = 24, direction = "back", spread = { 70, 70 }, speed = { 20, 40 },
		size = 0.45, gravity = 30, colors = { "#FFFFFF", hue }, exact = true, life = { 0.3, 0.6 } }))
	local fx = VFX.effect({ family = "lightning", layers = layers }, cf, nil, "lightning")
	FXKit.flashAt(b, shade(hue, 0.6), 0.15, 50)
	FXKit.shakeAt(b, 0.2, 50)
	return newHandle(fx)
end

-- A magic projectile from `from` to `to`: a glowing bolt flies (opts.speed studs/s, default 60), then plays
-- magic_impact. opts: color, speed, arc (studs of rise mid-flight), style, onHit(position).
function FXKit.bolt(from, to, opts)
	opts = opts or {}
	local a, b = positionOf(from), positionOf(to)
	if not a or not b then
		warnOnce("bolt:args", "bolt(from, to) needs two positions")
		return NULL
	end
	local carrier = Instance.new("Part")
	carrier.Name = "KitBolt"
	carrier.Anchored = true
	carrier.CanCollide = false
	carrier.CanQuery = false
	carrier.CanTouch = false
	carrier.Transparency = 1
	carrier.Size = Vector3.new(0.2, 0.2, 0.2)
	carrier.CFrame = CFrame.new(a)
	carrier.Parent = fxFolder("KitFXWorld")
	local fx = VFX.play("magic_bolt", carrier, { follow = true, style = opts.style, color = opts.color })
	local h = newHandle(fx)
	local dist = (b - a).Magnitude
	local duration = dist / math.max(tonumber(opts.speed) or 60, 1)
	local arc = tonumber(opts.arc) or 0
	local t = 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		t += dt
		local u = math.min(t / math.max(duration, 1e-3), 1)
		carrier.CFrame = CFrame.new(a:Lerp(b, u) + Vector3.new(0, arc * 4 * u * (1 - u), 0))
		if u >= 1 then
			conn:Disconnect()
			if fx.alive then
				fx:stop()
			end
			fx:andThen(function()
				carrier:Destroy()
			end)
			FXKit.play("magic_impact", b, { style = opts.style, color = opts.color })
			if type(opts.onHit) == "function" then
				task.spawn(opts.onHit, b)
			end
		end
	end)
	table.insert(h.cleanup, function()
		conn:Disconnect()
		task.delay(1, function()
			carrier:Destroy()
		end)
	end)
	return h
end

-- Skid marks: a dark ribbon trail on `part` (attach it to the chassis or a non-spinning part at the wheel, not to
-- a spinning wheel). opts: width, lifetime, color, offset (Vector3 in part space; default: the part's underside).
function FXKit.skid(part, opts)
	opts = opts or {}
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		warnOnce("skid:part", "skid needs a BasePart")
		return VFX.trail(part, {})
	end
	return VFX.trail(part, { width = opts.width or 0.7, axis = "right", lifetime = opts.lifetime or 4,
		color = asHex(opts.color) or "#1E1E1E", transparency = { { 0, 0.35 }, { 0.8, 0.6 }, { 1, 1 } }, faceCamera = false,
		offset = if typeof(opts.offset) == "Vector3" then opts.offset else Vector3.new(0, -part.Size.Y / 2 + 0.05, 0),
		minLength = 0.2, enabled = opts.enabled })
end

-- A flickering neon sign or lamp: a BasePart (its own light is added) or a position (a small glowing bulb is
-- made). opts: color, brightness, range, rate (dropouts per second). Returns a handle; :stop() restores the part.
function FXKit.flicker(target, opts)
	opts = opts or {}
	local made = nil
	local part = if typeof(target) == "Instance" and target:IsA("BasePart") then target else nil
	if not part then
		local pos = positionOf(target)
		if not pos then
			warnOnce("flicker:args", "flicker needs a BasePart or a position")
			return NULL
		end
		made = Instance.new("Part")
		made.Name = "KitNeon"
		made.Anchored = true
		made.CanCollide = false
		made.CanQuery = false
		made.CanTouch = false
		made.Material = Enum.Material.Neon
		made.Shape = Enum.PartType.Ball
		made.Size = Vector3.new(0.6, 0.6, 0.6)
		made.CFrame = CFrame.new(pos)
		local hex = asHex(opts.color) or tone(styleOf(opts), "#FF4FD8")
		local r, g, b = FxMath.hex(hex)
		made.Color = Color3.new(r :: number, g :: number, b :: number)
		made.Parent = fxFolder("KitFXWorld")
		part = made
	end
	local p = part :: BasePart
	local lightInst = Instance.new("PointLight")
	lightInst.Color = p.Color
	lightInst.Range = tonumber(opts.range) or 12
	local peak = tonumber(opts.brightness) or 2
	lightInst.Brightness = peak
	lightInst.Parent = p
	local baseT = p.Transparency
	local rate = tonumber(opts.rate) or 0.6
	local offUntil, nextDrop, burst = 0, os.clock() + math.random() / rate, 0
	local conn = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now >= nextDrop then
			burst = math.random(1, 3)
			nextDrop = now + 0.06
			offUntil = now + 0.03 + math.random() * 0.06
		end
		local on = now >= offUntil
		if on and burst > 0 and now >= nextDrop - 0.0001 then
			burst -= 1
			if burst <= 0 then
				nextDrop = now + (0.5 + math.random()) / rate
			end
		end
		p.Transparency = if on then baseT else math.max(baseT, 0.65)
		lightInst.Brightness = if on then peak * (0.92 + math.random() * 0.08) else peak * 0.1
	end)
	return newHandle(nil, { function()
		conn:Disconnect()
		lightInst:Destroy()
		if made then
			made:Destroy()
		elseif p.Parent then
			p.Transparency = baseT
		end
	end })
end

------------------------------------------------------------------------------------------------ speed lines
local lines = nil
local LINE_COUNT = 34

local function lineState(i, fresh)
	local a = math.random() * math.pi * 2
	return { a = a, r = if fresh then 0.35 + math.random() * 0.75 else 0.45 + math.random() * 0.25, v = 0.9 + math.random() * 0.9,
		len = 0.08 + math.random() * 0.16, w = 0.6 + math.random() * 0.8, i = i }
end

local function stepLines(dt)
	local L = lines
	if not L then
		return
	end
	L.level += (L.target - L.level) * math.min(dt * 8, 1)
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1920, 1080)
	local half = math.sqrt(vp.X * vp.X + vp.Y * vp.Y) / 2
	local active = math.floor(LINE_COUNT * math.clamp(L.level, 0, 1) + 0.5)
	local sty = L.style
	for i, s in L.state do
		local f = L.frames[i]
		if i <= active then
			s.r += s.v * dt * (0.7 + L.level)
			if s.r > 1.15 then
				L.state[i] = lineState(i, false)
				s = L.state[i]
			end
			local edge = math.clamp((s.r - 0.4) / 0.25, 0, 1) -- fade in past the centre region
			f.Visible = true
			f.Position = UDim2.fromOffset(vp.X / 2 + math.cos(s.a) * s.r * half, vp.Y / 2 + math.sin(s.a) * s.r * half)
			f.Size = UDim2.fromOffset(half * s.len * (0.6 + L.level), sty.thick * s.w)
			f.Rotation = math.deg(s.a)
			f.BackgroundTransparency = 1 - sty.alpha * edge * math.clamp(L.level * 1.5, 0, 1)
		else
			f.Visible = false
		end
	end
	if L.target <= 0 and L.level < 0.02 then
		L.gui.Enabled = false
		if L.conn then
			L.conn:Disconnect()
			L.conn = nil
		end
	end
end

-- Screen-space speed lines streaming out from the centre. intensity 0..1 (e.g. speed / topSpeed; call it as speed
-- changes, 0 fades them out). opts: color, thick (px), alpha, style. Returns a handle (:set(i), :stop()).
function FXKit.speedLines(intensity, opts)
	if not IS_CLIENT then
		return NULL
	end
	opts = opts or {}
	local player = Players.LocalPlayer
	local pg = player and player:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return NULL
	end
	if not lines or not lines.gui.Parent then
		local gui = Instance.new("ScreenGui")
		gui.Name = "KitSpeedLines"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 80
		gui.Parent = pg
		local frames, state = {}, {}
		for i = 1, LINE_COUNT do
			local f = Instance.new("Frame")
			f.Name = "Line"
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.BorderSizePixel = 0
			f.BackgroundTransparency = 1
			f.Visible = false
			local g = Instance.new("UIGradient")
			g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.55, 0),
				NumberSequenceKeypoint.new(1, 0.4) })
			g.Parent = f
			f.Parent = gui
			frames[i] = f
			state[i] = lineState(i, true)
		end
		lines = { gui = gui, frames = frames, state = state, level = 0, target = 0, conn = nil, style = STYLES.toon.lines }
	end
	local L = lines :: any
	local base = styleOf(opts).lines
	local hex = asHex(opts.color) or base.color
	L.style = { thick = tonumber(opts.thick) or base.thick, alpha = tonumber(opts.alpha) or base.alpha }
	local r, g, b = FxMath.hex(hex)
	for _, f in L.frames do
		f.BackgroundColor3 = Color3.new(r :: number, g :: number, b :: number)
	end
	L.target = clamp01(intensity)
	if L.target > 0 then
		L.gui.Enabled = true
		if not L.conn then
			L.conn = RunService.RenderStepped:Connect(stepLines)
		end
	end
	local h = newHandle(nil, { function()
		L.target = 0
	end })
	function h.set(_, k)
		L.target = clamp01(k)
		if L.target > 0 and not L.conn then
			L.gui.Enabled = true
			L.conn = RunService.RenderStepped:Connect(stepLines)
		end
		return h
	end
	return h
end

------------------------------------------------------------------------------------------------ weather
-- An ambient field that follows the camera: "rain" (with splashes), "snowfall", "falling_leaves",
-- "falling_petals", "fireflies", "dust_motes". opts: area (studs, default 60), intensity, color, style.
function FXKit.weather(name, opts)
	if not IS_CLIENT then
		return NULL
	end
	opts = table.clone(opts or {})
	local n, meta = resolve(name, opts)
	if not meta or not meta.weather then
		warnOnce("weather:" .. tostring(name), "weather needs one of rain, snowfall, falling_leaves, falling_petals, fireflies, dust_motes")
		return NULL
	end
	local anchor = Instance.new("Part")
	anchor.Name = "KitWeather"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	local function place()
		local cam = workspace.CurrentCamera
		if cam then
			local look = cam.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			local ahead = if flat.Magnitude > 1e-3 then flat.Unit * (tonumber(opts.area) or 60) * 0.2 else Vector3.zero
			anchor.CFrame = CFrame.new(cam.CFrame.Position + ahead)
		end
	end
	place()
	anchor.Parent = fxFolder("KitFXWorld")
	opts.follow = true
	local h = FXKit.play(n, anchor, opts)
	if not h.alive then
		anchor:Destroy()
		return h
	end
	local splashAcc = 0
	local area = tonumber(opts.area) or 60
	local params = rayParams()
	local conn = RunService.RenderStepped:Connect(function(dt)
		place()
		if meta.splash then
			splashAcc += dt * 30 * (tonumber(opts.intensity) or 1)
			while splashAcc >= 1 do
				splashAcc -= 1
				local p = anchor.Position + Vector3.new((math.random() - 0.5) * area * 0.6, 30, (math.random() - 0.5) * area * 0.6)
				local hit = workspace:Raycast(p, Vector3.new(0, -80, 0), params)
				if hit then
					FXKit.play("rain_splash", hit.Position, { normal = hit.Normal, style = opts.style })
				end
			end
		end
	end)
	table.insert(h.cleanup, function()
		conn:Disconnect()
		task.delay(8, function()
			anchor:Destroy()
		end)
	end)
	return h
end

------------------------------------------------------------------------------------------------ play
local EFFECT_OPTS = { "scale", "intensity", "normal", "direction", "follow", "timeScaled", "onDone" }

local function startFlicker(h)
	local fx = h.fx
	if not fx or #fx.lights == 0 then
		return
	end
	local base = {}
	for _, l in fx.lights do
		base[l] = l.Brightness
	end
	local seed = math.random() * 100
	local conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() * 9 + seed
		local k = 0.82 + 0.18 * math.noise(t, 0.5) + 0.08 * math.noise(t * 2.3, 4.1)
		for l, b in base do
			if l.Parent then
				l.Brightness = b * k
			end
		end
	end)
	table.insert(h.cleanup, function()
		conn:Disconnect()
	end)
	fx:andThen(function()
		conn:Disconnect()
	end)
end

local remote = nil

local function sanitize(o)
	if type(o) ~= "table" then
		return nil
	end
	local out = {}
	for k, v in o do
		local t = typeof(v)
		if type(k) == "string" and (t == "number" or t == "string" or t == "boolean" or t == "Vector3" or t == "CFrame"
			or t == "Color3" or t == "Instance") then
			out[k] = v
		end
	end
	return out
end

-- Plays a preset at `at` (Vector3, CFrame, BasePart, Attachment or Model) and returns a handle (:stop(), :set(k),
-- :andThen(fn), .alive). On the server it plays on every client (see playAll) and returns an inert handle.
function FXKit.play(name, at, opts)
	if IS_SERVER and not IS_CLIENT then
		FXKit.playAll(name, at, opts)
		return NULL
	end
	local o = if type(opts) == "table" then table.clone(opts) else {}
	local n, meta, variant = resolve(name, o)
	if not meta then
		local guess = if type(name) == "string" then FxMath.closest(name, ORDER) else nil
		warnOnce("play:" .. tostring(name), "no preset '" .. tostring(name) .. "'" .. (if guess then " (did you mean '" .. guess .. "'?)" else ""))
		return NULL
	end
	local st = styleOf(o)
	if meta.screen then
		return FXKit.speedLines(if o.intensity == nil then 1 else o.intensity, o)
	elseif meta.trail then
		local t = FXKit.skid(at, o)
		return setmetatable({ alive = t.alive, cleanup = { function()
			t:destroy()
		end } }, Handle)
	elseif meta.controller then
		return FXKit.flicker(at, o)
	elseif meta.dynamic then
		if n == "bullet_tracer" then
			return FXKit.tracer(at, o.to, o)
		end
		return FXKit.lightning(at, o.to, o)
	elseif meta.projectile and o.to ~= nil then
		return FXKit.bolt(at, o.to, o)
	elseif meta.weather and at == nil then
		return FXKit.weather(n, o)
	end
	if at == nil then
		warnOnce("play:at:" .. n, "'" .. n .. "' needs a position, CFrame, part or attachment")
		return NULL
	end
	local spec = build(n, meta, st, variant, o)
	if not spec then
		return NULL
	end
	if meta.adapt then
		meta.adapt(at, o, variant)
	end
	if meta.continuous and o.follow == nil and typeof(at) == "Instance" then
		o.follow = true
	end
	local fxOpts = FxMath.normalizeKeys(o, EFFECT_OPTS)
	local fx = VFX.effect(spec, at, fxOpts, n)
	local h = newHandle(fx)
	if meta.flicker then
		startFlicker(h)
	end
	if meta.extra and o.juice ~= false then
		local ok, err = pcall(meta.extra, at, o, st, variant, h)
		if not ok then
			warnOnce("extra:" .. n, "'" .. n .. "' extras failed: " .. tostring(err))
		end
	end
	return h
end

-- Plays on every client. From the server: fires the kit remote. From a client: plays here and asks the server to
-- relay it to everyone else (rate-limited per player).
function FXKit.playAll(name, at, opts)
	if IS_SERVER and not IS_CLIENT then
		if remote then
			remote:FireAllClients(name, at, sanitize(opts))
		end
		return NULL
	end
	local h = FXKit.play(name, at, opts)
	local r = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
	if r and r:IsA("RemoteEvent") then
		r:FireServer(name, at, sanitize(opts))
	end
	return h
end

------------------------------------------------------------------------------------------------ setup
function FXKit.setStyle(style)
	if type(style) ~= "string" or not STYLES[style] then
		warnOnce("style:" .. tostring(style), "style must be one of " .. table.concat(FXKit.STYLES, ", "))
		return
	end
	currentStyle = style
end

function FXKit.getStyle()
	return currentStyle
end

-- Replaces a texture slot (e.g. "flame", "smoke", "spark", "star", "ring", "dust", "confetti") with an image id,
-- optionally a flipbook ({ layout = "2x2"|"4x4"|"8x8", fps = 24, mode = "loop"|"oneshot"|"pingpong"|"random" }).
function FXKit.texture(slot, imageId, flipbook)
	if type(slot) ~= "string" then
		warnOnce("texture:slot", "texture(slot, imageId) needs a slot name (" .. table.concat(FXKit.SLOTS, ", ") .. ")")
		return
	end
	if imageId == nil then
		overrides[slot] = nil
	else
		local id = if type(imageId) == "number" then "rbxassetid://" .. tostring(math.floor(imageId)) else imageId
		overrides[slot] = { id = id, flipbook = if type(flipbook) == "table" then flipbook else nil }
	end
	table.clear(specCache)
end

function FXKit.has(name)
	return (resolve(name, nil)) ~= nil
end

-- Preset names (hidden helpers left out), optionally only one group: "movement" | "combat" | "pickups" | "ambient".
function FXKit.names(group)
	local out = {}
	for _, n in ORDER do
		local m = P[n]
		if not m.hidden and (group == nil or m.group == group) then
			table.insert(out, n)
		end
	end
	return out
end

function FXKit.info(name)
	local n, meta = resolve(name, nil)
	if not meta then
		return nil
	end
	return { name = n, group = meta.group, variants = meta.variants, continuous = meta.continuous == true,
		weather = meta.weather == true }
end

local registered = false
-- Registers the presets with VFX (so VFX.play("explosion", pos, {variant = "large", style = "neon"}) works too;
-- camera extras only run through FXKit.play) and starts listening for server-played effects. Safe to call twice.
function FXKit.register()
	if registered then
		return FXKit
	end
	registered = true
	for _, n in ORDER do
		local meta = P[n]
		if meta.build then
			VFX.preset(n, function(o)
				local _, _, variant = resolve(n, o)
				return build(n, meta, styleOf(o), variant, o) or { layers = {} }
			end)
		end
	end
	VFX.budget("rain_splash", { effects = 40, particles = 400, lights = 0 })
	return FXKit
end

if IS_SERVER and not IS_CLIENT then
	remote = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = REMOTE_NAME
		remote.Parent = ReplicatedStorage
	end
	local budget = {}
	remote.OnServerEvent:Connect(function(player, name, at, opts)
		if type(name) ~= "string" or not P[(resolve(name, nil))] then
			return
		end
		local now = os.clock()
		local b = budget[player] or { t = now, n = 0 }
		if now - b.t > 1 then
			b.t, b.n = now, 0
		end
		b.n += 1
		budget[player] = b
		if b.n > 20 then
			return
		end
		for _, other in Players:GetPlayers() do
			if other ~= player then
				remote:FireClient(other, name, at, sanitize(opts))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		budget[player] = nil
	end)
elseif IS_CLIENT then
	local function listen(r)
		if r.Name == REMOTE_NAME and r:IsA("RemoteEvent") then
			r.OnClientEvent:Connect(function(name, at, opts)
				FXKit.play(name, at, opts)
			end)
			return true
		end
		return false
	end
	local existing = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
	if not (existing and listen(existing)) then
		local conn
		conn = ReplicatedStorage.ChildAdded:Connect(function(child)
			if listen(child) then
				conn:Disconnect()
			end
		end)
	end
	local Debug = optional("Debug")
	if Debug and type(Debug.register) == "function" then
		Debug.register("fxkit", function(name, style)
			if name == nil then
				return FXKit.names()
			end
			local cam = workspace.CurrentCamera
			local pos = if cam then (cam.CFrame * CFrame.new(0, -2, -14)).Position else Vector3.zero
			local h = FXKit.play(tostring(name), pos, { style = style })
			return if h.alive then "played " .. tostring(name) else "could not play " .. tostring(name)
		end, "play an FXKit preset in front of the camera: name, style (no arguments lists the presets)")
	end
end

return FXKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">FxMath</string>
          <string name="Source"><![CDATA[--!strict
--!native
-- FxMath: the pure math and data behind CameraRig and VFX. No Roblox APIs, so it also runs (and is tested)
-- outside Roblox. Values may be numbers or vectors (Vector3): lerps, springs and paths only use arithmetic.
--   FxMath.ease(0.3, "Quint Out")                         eased 0..1 ("Quint", "Quint Out", {"Back", "In"}, Enum)
--   local x, v = FxMath.springStep(x, v, goal, 12, 1, dt)  exact damped spring (speed = angular freq., damping ratio)
--   FxMath.keypoints({0.2, 1, 0}, isNumber)               -> {{t, v, e}, ...} ready for a NumberSequence
--   FxMath.validateEffect(spec)                           -> {"layers[2].lifetime: ..."} (the rules VFX applies)
local FxMath = {}

local PI = math.pi
local HALF_PI = PI * 0.5
local TAU = PI * 2
local HUGE = math.huge

export type Keypoint = { t: number, v: any, e: number }
export type Path = { points: { any }, cum: { number }, params: { number }, length: number }

local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= HUGE and v ~= -HUGE
end
FxMath.isNumber = isNum

local function isVec(v: any): boolean
	local t = typeof(v)
	return t == "Vector3" or t == "vector"
end
FxMath.isVector = isVec

function FxMath.clamp(x: number, lo: number, hi: number): number
	if x ~= x or x < lo then
		return lo
	elseif x > hi then
		return hi
	end
	return x
end
local clamp = FxMath.clamp

function FxMath.lerp(a: any, b: any, t: number): any
	return a + (b - a) * t
end

function FxMath.smoothstep(e0: number, e1: number, x: number): number
	if e1 == e0 then
		return if x >= e1 then 1 else 0
	end
	local t = clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end

-- Exponential smoothing factor for a rate (1/s): alpha = 1 - e^(-rate * dt). rate <= 0 never moves.
function FxMath.alpha(rate: number, dt: number): number
	if not (rate > 0) or not (dt > 0) then
		return 0
	elseif rate == HUGE then
		return 1
	end
	return 1 - math.exp(-rate * dt)
end

function FxMath.damp(current: any, target: any, rate: number, dt: number): any
	return current + (target - current) * FxMath.alpha(rate, dt)
end

-- Wraps an angle (radians) into [-pi, pi).
function FxMath.wrapAngle(a: number): number
	return (a + PI) % TAU - PI
end

function FxMath.dampAngle(current: number, target: number, rate: number, dt: number): number
	return current + FxMath.wrapAngle(target - current) * FxMath.alpha(rate, dt)
end

-- Distance between two numbers or two vectors.
function FxMath.distance(a: any, b: any): number
	if type(a) == "number" then
		return math.abs((b :: number) - a)
	end
	local d = b - a
	return math.sqrt(d.X * d.X + d.Y * d.Y + d.Z * d.Z)
end
local distance = FxMath.distance

------------------------------------------------------------------------------------------------ easing
-- The same styles and directions as TweenService (Enum.EasingStyle / Enum.EasingDirection). Out and InOut are
-- built from In, so every style is defined once: Out(t) = 1 - In(1 - t).
local function bounceOut(t: number): number
	local n1, d1 = 7.5625, 2.75
	if t < 1 / d1 then
		return n1 * t * t
	elseif t < 2 / d1 then
		t -= 1.5 / d1
		return n1 * t * t + 0.75
	elseif t < 2.5 / d1 then
		t -= 2.25 / d1
		return n1 * t * t + 0.9375
	end
	t -= 2.625 / d1
	return n1 * t * t + 0.984375
end

local EASE_IN: { [string]: (number) -> number } = {
	linear = function(t: number): number
		return t
	end,
	sine = function(t: number): number
		return 1 - math.cos(t * HALF_PI)
	end,
	quad = function(t: number): number
		return t * t
	end,
	cubic = function(t: number): number
		return t * t * t
	end,
	quart = function(t: number): number
		return t * t * t * t
	end,
	quint = function(t: number): number
		return t * t * t * t * t
	end,
	exponential = function(t: number): number
		return if t <= 0 then 0 else 2 ^ (10 * t - 10)
	end,
	circular = function(t: number): number
		return 1 - math.sqrt(math.max(0, 1 - t * t))
	end,
	back = function(t: number): number
		return 2.70158 * t * t * t - 1.70158 * t * t
	end,
	elastic = function(t: number): number
		if t <= 0 then
			return 0
		elseif t >= 1 then
			return 1
		end
		return -(2 ^ (10 * t - 10)) * math.sin((t * 10 - 10.75) * (TAU / 3))
	end,
	bounce = function(t: number): number
		return 1 - bounceOut(1 - t)
	end,
}

local function c01(t: number): number
	if t ~= t or t < 0 then
		return 0
	elseif t > 1 then
		return 1
	end
	return t
end

local EASE: { [string]: { [string]: (number) -> number } } = {}
for name, f in EASE_IN do
	EASE[name] = {
		["in"] = function(t: number): number
			return f(c01(t))
		end,
		out = function(t: number): number
			return 1 - f(1 - c01(t))
		end,
		inout = function(t: number): number
			t = c01(t)
			if t < 0.5 then
				return f(2 * t) * 0.5
			end
			return 1 - f(2 - 2 * t) * 0.5
		end,
	}
end

FxMath.EASE_STYLES = { "Linear", "Sine", "Quad", "Cubic", "Quart", "Quint", "Exponential", "Circular", "Back",
	"Bounce", "Elastic" }
FxMath.EASE_DIRECTIONS = { "In", "Out", "InOut" }
local STYLE_ALIAS: { [string]: string } = { expo = "exponential", circ = "circular", sin = "sine" }
local DIR_ALIAS: { [string]: string } = { inandout = "inout", both = "inout" }

local function nameOf(v: any): string?
	local ty: string = typeof(v)
	if ty == "string" then
		return v
	elseif ty == "EnumItem" then
		return (v :: any).Name
	end
	return nil
end

-- "QuintOut" / "Quint Out" / "quint.inout" -> "quint", "out"
local function splitEase(s: string): (string?, string?)
	local a, b = string.match(s, "^%s*(%a+)[%s%._:%-]+(%a+)%s*$")
	if a then
		return string.lower(a), string.lower(b :: string)
	end
	local whole = string.match(s, "^%s*(%a+)%s*$")
	if not whole then
		return nil, nil
	end
	local w = string.lower(whole)
	if EASE[w] or STYLE_ALIAS[w] then
		return w, nil
	end
	for _, suffix in { "inout", "out", "in" } do
		if #w > #suffix and string.sub(w, -#suffix) == suffix then
			local stem = string.sub(w, 1, #w - #suffix)
			if EASE[stem] or STYLE_ALIAS[stem] then
				return stem, suffix
			end
		end
	end
	return w, nil
end

local STYLE_NAMES: { [string]: string } = {}
for _, name in FxMath.EASE_STYLES do
	STYLE_NAMES[string.lower(name)] = name
end
local DIRECTION_NAMES: { [string]: string } = { ["in"] = "In", out = "Out", inout = "InOut" }

-- Canonical names for an easing spec, as Enum.EasingStyle / Enum.EasingDirection item names ("Quint", "Out").
-- ease may be "Quint", "Quint Out", "SineInOut", Enum.EasingStyle.Quint, or {style, direction}. On a problem the
-- defaults (defaultStyle / defaultDirection, else Sine InOut) are returned with the problem.
function FxMath.easeNames(ease: any, direction: any?, defaultStyle: string?, defaultDirection: string?): (string, string, string?)
	local dStyle = STYLE_NAMES[string.lower(defaultStyle or "sine")] or "Sine"
	local dDir = DIRECTION_NAMES[string.lower(defaultDirection or "inout")] or "InOut"
	local style: string?, dir: string? = nil, nil
	local problem: string? = nil
	local raw: any = ease
	if type(ease) == "table" then
		raw = ease[1]
		dir = nameOf(ease[2])
		if ease[2] ~= nil and dir == nil then
			problem = "easing direction must be In, Out or InOut"
		end
	end
	if raw ~= nil then
		local n = nameOf(raw)
		if n == nil then
			problem = "expected an easing name like \"Quint Out\" or {\"Back\", \"In\"}"
		else
			local st, d = splitEase(n)
			if st == nil then
				problem = "expected an easing name like \"Quint Out\", got \"" .. n .. "\""
			else
				style = st
				if d and dir == nil then
					dir = d
				end
			end
		end
	end
	if dir == nil then
		dir = nameOf(direction)
	end
	local styleName = dStyle
	if style then
		local key = STYLE_ALIAS[style] or style
		if STYLE_NAMES[key] then
			styleName = STYLE_NAMES[key]
		else
			local guess = FxMath.closest(style, FxMath.EASE_STYLES)
			problem = problem or ("unknown easing style \"" .. style .. "\"" .. (if guess then " (did you mean " .. guess .. "?)" else ""))
		end
	end
	local dirName = dDir
	if dir then
		local key = string.lower(dir)
		key = DIR_ALIAS[key] or key
		if DIRECTION_NAMES[key] then
			dirName = DIRECTION_NAMES[key]
		else
			problem = problem or ("unknown easing direction \"" .. dir .. "\" (In, Out or InOut)")
		end
	end
	return styleName, dirName, problem
end

-- Resolves an easing spec once (hot paths call the returned function); see easeNames for the forms accepted.
function FxMath.easeFn(ease: any, direction: any?, defaultStyle: string?, defaultDirection: string?): ((number) -> number, string?)
	local style, dir, problem = FxMath.easeNames(ease, direction, defaultStyle, defaultDirection)
	local key = if dir == "InOut" then "inout" else string.lower(dir)
	return EASE[string.lower(style)][key], problem
end

function FxMath.ease(t: number, ease: any?, direction: any?): number
	local fn = FxMath.easeFn(ease, direction)
	return fn(t)
end

-- n keypoints sampling an eased move from a to b (e.g. a ring particle's size growing with Quint Out).
function FxMath.easeKeypoints(a: number, b: number, ease: any?, n: number?): { Keypoint }
	local fn = FxMath.easeFn(ease, nil, "quint", "out")
	local count = math.clamp(math.floor(n or 8), 2, 20)
	local out: { Keypoint } = {}
	for i = 1, count do
		local t = (i - 1) / (count - 1)
		out[i] = { t = t, v = a + (b - a) * fn(t), e = 0 }
	end
	return out
end

------------------------------------------------------------------------------------------------ springs
-- Exact solution of x'' = -speed^2 (x - target) - 2 damping speed x' over dt, as coefficients:
-- x1 - target = a (x0 - target) + b v0;  v1 = c (x0 - target) + d v0. Stable for any dt, no substeps.
function FxMath.springCoefficients(speed: number, damping: number, dt: number): (number, number, number, number)
	local w = if isNum(speed) and speed > 0 then speed else 0
	local z = if isNum(damping) and damping > 0 then damping else 0
	if not (dt > 0) then
		return 1, 0, 0, 1
	end
	if w < 1e-6 then
		return 1, dt, 0, 1
	end
	if math.abs(z - 1) < 1e-4 then
		local e = math.exp(-w * dt)
		return e * (1 + w * dt), e * dt, -e * w * w * dt, e * (1 - w * dt)
	elseif z < 1 then
		local wd = w * math.sqrt(1 - z * z)
		local e = math.exp(-z * w * dt)
		local c, s = math.cos(wd * dt), math.sin(wd * dt)
		local k = z * w / wd
		return e * (c + k * s), e * s / wd, -e * (w * w / wd) * s, e * (c - k * s)
	end
	local r = w * math.sqrt(z * z - 1)
	local r1, r2 = -z * w + r, -z * w - r
	local e1, e2 = math.exp(r1 * dt), math.exp(r2 * dt)
	local inv = 1 / (r1 - r2)
	return (r1 * e2 - r2 * e1) * inv, (e1 - e2) * inv, r1 * r2 * (e2 - e1) * inv, (r1 * e1 - r2 * e2) * inv
end

-- One step of a damped spring for numbers or vectors. Returns the new position and velocity.
function FxMath.springStep(x: any, v: any, target: any, speed: number, damping: number, dt: number): (any, any)
	local a, b, c, d = FxMath.springCoefficients(speed, damping, dt)
	local y = x - target
	return target + y * a + v * b, y * c + v * d
end

-- Peak displacement per unit of initial velocity for a spring starting at rest on its target, and when it happens.
function FxMath.springPeak(speed: number, damping: number): (number, number)
	local w = if isNum(speed) and speed > 1e-3 then speed else 1e-3
	local z = if isNum(damping) and damping > 0 then damping else 0
	if math.abs(z - 1) < 1e-4 then
		return 1 / (w * math.exp(1)), 1 / w
	elseif z < 1 then
		local wd = w * math.sqrt(1 - z * z)
		local t = math.atan2(wd, z * w) / wd
		return math.exp(-z * w * t) * math.sin(wd * t) / wd, t
	end
	local r = w * math.sqrt(z * z - 1)
	local r1, r2 = -z * w + r, -z * w - r
	local t = math.log(r2 / r1) / (r1 - r2)
	return (math.exp(r1 * t) - math.exp(r2 * t)) / (r1 - r2), t
end

-- The initial velocity that makes a spring at rest peak at `peak` (so a punch's strength reads in studs).
function FxMath.impulseForPeak(peak: number, speed: number, damping: number): number
	local p = FxMath.springPeak(speed, damping)
	return peak / p
end

------------------------------------------------------------------------------------------------ envelopes
-- 0..1..0 shape of an FOV kick: a quick rise over `attack` seconds, then a smooth fall to 0 at `seconds`.
function FxMath.kickEnvelope(t: number, seconds: number, attack: number?): number
	if not (seconds > 0) or not (t >= 0) or t >= seconds then
		return 0
	end
	local a = clamp(attack or math.min(0.08, seconds * 0.3), 0, seconds)
	if t < a then
		local u = t / a
		return 1 - (1 - u) * (1 - u)
	end
	local u = (t - a) / (seconds - a)
	return 0.5 * (1 + math.cos(u * PI))
end

-- Time scale of a slow-motion beat at time t: eases from 1 to `scale` over rampIn, holds, and returns to 1 over
-- rampOut, ending at `seconds`. Ramps longer than the beat are shortened proportionally.
function FxMath.slowmoScale(t: number, scale: number, seconds: number, rampIn: number?, rampOut: number?): number
	if not (seconds > 0) or not (t >= 0) or t >= seconds then
		return 1
	end
	local s = clamp(scale, 0, 1)
	local rin = math.max(rampIn or 0, 0)
	local rout = math.max(rampOut or 0, 0)
	if rin + rout > seconds then
		local k = seconds / (rin + rout)
		rin *= k
		rout *= k
	end
	if t < rin then
		local u = t / rin
		return 1 + (s - 1) * (1 - (1 - u) * (1 - u))
	elseif rout > 0 and t > seconds - rout then
		local u = (t - (seconds - rout)) / rout
		return s + (1 - s) * u * u * (3 - 2 * u)
	end
	return s
end

-- Linear progress (0..1) of a camera move and its phase: "move" while moving, "hold" after, "done" past both.
function FxMath.shotProgress(t: number, move: number, hold: number): (number, string)
	local u = if move > 0 then clamp(t / move, 0, 1) else 1
	if t < move then
		return u, "move"
	elseif t < move + math.max(hold, 0) then
		return 1, "hold"
	end
	return 1, "done"
end

-- Fraction of the screen height each letterbox bar covers to show a `ratio` (e.g. 2.39) frame.
function FxMath.letterbox(width: number, height: number, ratio: number, maxFraction: number?): number
	if not (width > 0) or not (height > 0) or not (ratio > 0) then
		return 0
	end
	local content = width / ratio
	if content >= height then
		return 0
	end
	return math.min((height - content) / (2 * height), maxFraction or 0.25)
end

-- Camera collision: pull in to `allowed` at once (never sit inside geometry), ease back out at returnRate (1/s).
function FxMath.collisionDistance(current: number, allowed: number, returnRate: number, dt: number): number
	if allowed <= current then
		return allowed
	end
	return current + (allowed - current) * FxMath.alpha(returnRate, dt)
end

-- Yaw and pitch (radians) of a unit look vector, matching CFrame.fromEulerAnglesYXZ(pitch, yaw, 0).
function FxMath.yawPitch(x: number, y: number, z: number): (number, number)
	return math.atan2(-x, -z), math.asin(clamp(y, -1, 1))
end

-- Offset of a point on an orbit: angle 0 is +Z (behind a part facing -Z), 90 is +X (its right side).
function FxMath.orbitOffset(radius: number, height: number, degrees: number): (number, number, number)
	local a = math.rad(degrees)
	return math.sin(a) * radius, height, math.cos(a) * radius
end

-- Smooth handheld-camera noise in about [-1, 1] per axis; frequency in cycles per second.
function FxMath.handheld(t: number, frequency: number, seed: number?): (number, number, number)
	local f = t * frequency
	local s = (seed or 0) + 0.5
	local x = math.noise(f, s * 1.37, 0.31) * 2
	local y = math.noise(s * 2.11, f, 1.77) * 2
	local z = math.noise(3.13, s * 0.71, f) * 2
	return clamp(x, -1, 1), clamp(y, -1, 1), clamp(z, -1, 1)
end

------------------------------------------------------------------------------------------------ paths
-- Uniform Catmull-Rom point between p1 and p2.
function FxMath.catmullRom(p0: any, p1: any, p2: any, p3: any, t: number): any
	local t2 = t * t
	local t3 = t2 * t
	return (p1 * 2 + (p2 - p0) * t + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2 + (p1 * 3 - p0 - p2 * 3 + p3) * t3) * 0.5
end

-- Point at parameter s in [0, #points - 1] of the curve through every point (ends extended by reflection).
function FxMath.pathPoint(points: { any }, s: number): any
	local n = #points
	if n == 1 then
		return points[1]
	elseif n == 2 then
		return points[1] + (points[2] - points[1]) * clamp(s, 0, 1)
	end
	s = clamp(s, 0, n - 1)
	local i = math.min(math.floor(s), n - 2)
	local t = s - i
	local p1, p2 = points[i + 1], points[i + 2]
	local p0 = if i >= 1 then points[i] else p1 * 2 - p2
	local p3 = if i + 3 <= n then points[i + 3] else p2 * 2 - p1
	return FxMath.catmullRom(p0, p1, p2, p3, t)
end

-- A path through points with an arc-length table, so FxMath.pathAt moves at an even speed along it.
function FxMath.path(points: { any }, samples: number?): Path
	local n = #points
	local per = math.clamp(math.floor(samples or 16), 1, 256)
	local cum, params = { 0 }, { 0 }
	local total = 0
	if n >= 2 then
		local prev = points[1]
		local steps = (n - 1) * per
		for j = 1, steps do
			local s = j / per
			local p = FxMath.pathPoint(points, s)
			total += distance(prev, p)
			cum[j + 1] = total
			params[j + 1] = s
			prev = p
		end
	end
	return { points = points, cum = cum, params = params, length = total }
end

-- Point at fraction u (0..1) of the path's length.
function FxMath.pathAt(path: Path, u: number): any
	local pts = path.points
	if #pts < 2 or path.length <= 0 then
		return pts[1]
	end
	local target = clamp(u, 0, 1) * path.length
	local cum = path.cum
	local lo, hi = 1, #cum
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= target then
			lo = mid
		else
			hi = mid
		end
	end
	local span = cum[hi] - cum[lo]
	local f = if span > 0 then (target - cum[lo]) / span else 0
	local s = path.params[lo] + (path.params[hi] - path.params[lo]) * f
	return FxMath.pathPoint(pts, s)
end

------------------------------------------------------------------------------------------------ keypoints
-- Turns a keypoint spec into sorted {t, v, e} keypoints spanning 0..1 (at most 20, like NumberSequence):
--   5                         constant
--   {0.2, 1, 0}               values spread evenly over the lifetime
--   {{0, 1}, {0.3, 2, 0.5}}   {time, value, envelope?}; {time =, value =, envelope =} works too
-- isValue says what a single value is (a number, a colour...). Returns nil and problems if nothing is usable.
function FxMath.keypoints(spec: any, isValue: (any) -> boolean): ({ Keypoint }?, { string })
	local problems: { string } = {}
	if isValue(spec) then
		return { { t = 0, v = spec, e = 0 }, { t = 1, v = spec, e = 0 } }, problems
	end
	if type(spec) ~= "table" then
		table.insert(problems, "expected a value, a list of values, or {time, value} keypoints")
		return nil, problems
	end
	local n = #spec
	if n == 0 then
		table.insert(problems, "empty keypoint list")
		return nil, problems
	end
	local list: { Keypoint } = {}
	local allValues = true
	for i = 1, n do
		if not isValue(spec[i]) then
			allValues = false
			break
		end
	end
	if allValues then
		for i = 1, n do
			list[i] = { t = if n == 1 then 0 else (i - 1) / (n - 1), v = spec[i], e = 0 }
		end
		if n == 1 then
			list[2] = { t = 1, v = spec[1], e = 0 }
		end
	else
		local order: { number } = {}
		local lastT = -HUGE
		local unsorted = false
		for i = 1, n do
			local k = spec[i]
			local t, v, e = nil, nil, nil
			if type(k) == "table" then
				if k[1] ~= nil or k[2] ~= nil then
					t, v, e = k[1], k[2], k[3]
				else
					t, v, e = k.t or k.time, k.v or k.value, k.e or k.envelope
				end
			end
			if not isNum(t) or not isValue(v) then
				table.insert(problems, "keypoint " .. i .. ": expected {time, value} (time 0..1)")
			else
				local tt = t :: number
				if tt < 0 or tt > 1 then
					table.insert(problems, "keypoint " .. i .. ": time " .. tt .. " is outside 0..1")
					tt = clamp(tt, 0, 1)
				end
				if tt < lastT then
					unsorted = true
				end
				lastT = tt
				local env = 0
				if e ~= nil then
					if not isNum(e) then
						table.insert(problems, "keypoint " .. i .. ": envelope must be a number")
					else
						env = math.max(e :: number, 0)
					end
				end
				table.insert(list, { t = tt, v = v, e = env })
				table.insert(order, #list)
			end
		end
		if #list == 0 then
			return nil, problems
		end
		if unsorted then
			table.insert(problems, "keypoint times must go up from 0 to 1 (sorted them)")
			local rank: { [Keypoint]: number } = {}
			for i, k in list do
				rank[k] = order[i]
			end
			table.sort(list, function(a: Keypoint, b: Keypoint): boolean
				if a.t ~= b.t then
					return a.t < b.t
				end
				return rank[a] < rank[b]
			end)
		end
		if list[1].t > 0 then
			table.insert(list, 1, { t = 0, v = list[1].v, e = list[1].e })
		end
		if list[#list].t < 1 then
			table.insert(list, { t = 1, v = list[#list].v, e = list[#list].e })
		end
	end
	if #list > 20 then
		table.insert(problems, #list .. " keypoints; sequences hold at most 20 (resampled)")
		local out: { Keypoint } = {}
		for k = 1, 20 do
			out[k] = list[1 + math.floor((k - 1) * (#list - 1) / 19 + 0.5)]
		end
		list = out
	end
	return list, problems
end

-- Clamps number keypoints into [lo, hi] (envelopes too, so value +- envelope stays inside). Returns problems.
function FxMath.clampKeypoints(list: { Keypoint }, lo: number, hi: number): { string }
	local problems: { string } = {}
	local reported = false
	for _, k in list do
		local v = k.v :: number
		if v < lo or v > hi then
			if not reported then
				table.insert(problems, "value " .. v .. " is outside " .. lo .. ".." .. hi)
				reported = true
			end
			v = clamp(v, lo, hi)
			k.v = v
		end
		k.e = math.max(0, math.min(k.e, v - lo, hi - v))
	end
	return problems
end

------------------------------------------------------------------------------------------------ colours, content
-- "#RRGGBB" / "RRGGBB" / "#RGB" -> r, g, b in 0..1 (nil if not a hex colour).
function FxMath.hex(s: any): (number?, number?, number?)
	if type(s) ~= "string" then
		return nil, nil, nil
	end
	local h = string.match(s, "^%s*#?(%x%x%x%x%x%x)%s*$")
	if h then
		return tonumber(string.sub(h, 1, 2), 16) :: number / 255, tonumber(string.sub(h, 3, 4), 16) :: number / 255,
			tonumber(string.sub(h, 5, 6), 16) :: number / 255
	end
	local short = string.match(s, "^%s*#(%x%x%x)%s*$")
	if short then
		local r = tonumber(string.sub(short, 1, 1), 16) :: number
		local g = tonumber(string.sub(short, 2, 2), 16) :: number
		local b = tonumber(string.sub(short, 3, 3), 16) :: number
		return r * 17 / 255, g * 17 / 255, b * 17 / 255
	end
	return nil, nil, nil
end

-- "Tokens.color.primary" -> "primary"
function FxMath.tokenName(s: any): string?
	if type(s) ~= "string" then
		return nil
	end
	return string.match(s, "^%s*Tokens%.color%.([%w_]+)%s*$")
end

function FxMath.isColor(v: any): boolean
	local ty: string = typeof(v)
	if ty == "Color3" then
		return true
	end
	return FxMath.hex(v) ~= nil or FxMath.tokenName(v) ~= nil
end

function FxMath.isContentId(v: any): boolean
	if type(v) ~= "string" then
		return false
	end
	return string.match(v, "^rbxassetid://%d+$") ~= nil or string.match(v, "^rbxasset://%S+$") ~= nil
		or string.match(v, "^rbxthumb://%S+$") ~= nil or string.match(v, "^https?://%S+$") ~= nil
end

-- A texture is a content id, a positive asset id number, or the name of a kit texture / generated image.
function FxMath.isTexture(v: any): boolean
	if isNum(v) then
		return v > 0 and v % 1 == 0
	end
	return FxMath.isContentId(v) or (type(v) == "string" and string.match(v, "^[%a_][%w_%-%.]*$") ~= nil)
end

------------------------------------------------------------------------------------------------ budgets
-- A first-in-first-out budget: caps per resource ({effects = 12, particles = 600, lights = 3}); every entry counts
-- one "effects". add() returns the ids evicted (oldest first) to get back under every cap; the new entry stays even
-- if it alone is over.
local Budget = {}
Budget.__index = Budget

function FxMath.budget(caps: { [string]: number }): any
	return setmetatable({ caps = caps, totals = {}, costs = {}, order = {}, head = 1 }, Budget)
end

function Budget.over(self: any): boolean
	for k, cap in self.caps do
		if (self.totals[k] or 0) > cap then
			return true
		end
	end
	return false
end

function Budget.remove(self: any, id: any): boolean
	local cost = self.costs[id]
	if not cost then
		return false
	end
	self.costs[id] = nil
	for k, v in cost do
		self.totals[k] = (self.totals[k] or 0) - v
	end
	return true
end

function Budget.add(self: any, id: any, cost: { [string]: number }?): { any }
	if self.costs[id] then
		-- re-added: it becomes the newest entry
		self:remove(id)
		for i = self.head, #self.order do
			if self.order[i] == id then
				table.remove(self.order, i)
				break
			end
		end
	end
	local c: { [string]: number } = { effects = 1 }
	if cost then
		for k, v in cost do
			if k ~= "effects" and isNum(v) then
				c[k] = v
			end
		end
	end
	self.costs[id] = c
	for k, v in c do
		self.totals[k] = (self.totals[k] or 0) + v
	end
	table.insert(self.order, id)
	local evicted = {}
	while self:over() do
		local victim = nil
		-- the newest entry (last in order) is never a candidate; stale copies of a re-added id are skipped
		while self.head < #self.order do
			local candidate = self.order[self.head]
			self.head += 1
			if candidate ~= id and self.costs[candidate] then
				victim = candidate
				break
			end
		end
		if victim == nil then
			break
		end
		self:remove(victim)
		table.insert(evicted, victim)
	end
	if self.head > 32 and self.head > #self.order // 2 then
		local keep = {}
		for i = self.head, #self.order do
			local x = self.order[i]
			if self.costs[x] then
				table.insert(keep, x)
			end
		end
		self.order = keep
		self.head = 1
	end
	return evicted
end

function Budget.total(self: any, resource: string): number
	return self.totals[resource] or 0
end

------------------------------------------------------------------------------------------------ did-you-mean
-- Optimal-string-alignment distance (edits, with a swap of neighbours counting as one).
function FxMath.levenshtein(a: string, b: string): number
	local la, lb = #a, #b
	if la == 0 then
		return lb
	elseif lb == 0 then
		return la
	end
	local prev2 = table.create(lb + 1, 0)
	local prev = table.create(lb + 1, 0)
	local cur = table.create(lb + 1, 0)
	for j = 0, lb do
		prev[j + 1] = j
	end
	for i = 1, la do
		cur[1] = i
		local ca = string.byte(a, i)
		for j = 1, lb do
			local cb = string.byte(b, j)
			local cost = if ca == cb then 0 else 1
			local best = math.min(prev[j + 1] + 1, cur[j] + 1, prev[j] + cost)
			if i > 1 and j > 1 and ca == string.byte(b, j - 1) and string.byte(a, i - 1) == cb then
				best = math.min(best, prev2[j - 1] + 1)
			end
			cur[j + 1] = best
		end
		prev2, prev, cur = prev, cur, prev2
	end
	return prev[lb + 1]
end

-- The candidate closest to word (case-insensitive), or nil if nothing is close.
function FxMath.closest(word: string, candidates: { string }, maxDistance: number?): string?
	local lw = string.lower(word)
	local best: string?, bestD = nil, HUGE
	for _, c in candidates do
		local d = FxMath.levenshtein(lw, string.lower(c))
		if d < bestD then
			best, bestD = c, d
		end
	end
	local limit = maxDistance or math.max(1, #word // 3)
	if best and bestD <= limit then
		return best
	end
	if #lw >= 4 then
		for _, c in candidates do
			local lc = string.lower(c)
			if #lc >= 4 and (string.find(lw, lc, 1, true) or string.find(lc, lw, 1, true)) then
				return c
			end
		end
	end
	return nil
end

------------------------------------------------------------------------------------------------ spec schema
-- The VFX effect-spec schema. harness/tools/fxspec.py holds the same tables (a test keeps them identical).
FxMath.KINDS = { "particles", "beam", "light", "flash", "ring", "decal" }
FxMath.EFFECT_KEYS = { "layers", "family", "budget" }
FxMath.COMMON_KEYS = { "kind", "delay", "offset" }
FxMath.LAYER_KEYS = ({
	particles = { "count", "rate", "duration", "lifetime", "speed", "spread", "size", "transparency", "color",
		"lightEmission", "lightInfluence", "brightness", "drag", "acceleration", "rotation", "rotSpeed",
		"orientation", "squash", "zoffset", "flipbook", "texture", "direction", "shape", "lockedToPart", "timeScale" },
	beam = { "to", "from", "width", "color", "transparency", "texture", "textureSpeed", "textureLength", "textureMode",
		"lightEmission", "lightInfluence", "brightness", "curve", "segments", "faceCamera", "zoffset", "duration",
		"fadeOut" },
	light = { "color", "brightness", "range", "duration", "attack", "shadows", "spot" },
	flash = { "shape", "mesh", "meshTexture", "material", "color", "size", "transparency", "duration", "ease", "spin" },
	ring = { "size", "thickness", "color", "transparency", "duration", "texture", "lightEmission", "brightness", "flat",
		"ease", "material" },
	decal = { "texture", "size", "color", "transparency", "duration", "fade", "grow", "rotation" },
} :: any) :: { [string]: { string } }
FxMath.NESTED_KEYS = ({
	flipbook = { "layout", "mode", "fps", "random" },
	shape = { "kind", "size", "style", "inOut", "partial" },
	spot = { "angle", "face" },
	budget = { "particles", "lights", "effects" },
	trail = { "width", "offset", "axis", "lifetime", "color", "transparency", "widthScale", "texture", "textureMode",
		"textureLength", "lightEmission", "lightInfluence", "brightness", "minLength", "maxLength", "faceCamera",
		"enabled" },
} :: any) :: { [string]: { string } }
-- Other spellings a builder is likely to write (Roblox property names, synonyms) -> the canonical key.
FxMath.ALIASES = ({
	colour = "color", spreadangle = "spread", emissiondirection = "direction", emit = "count", amount = "count",
	burst = "count", lifespan = "lifetime", velocity = "speed", spin = "rotSpeed", rotationspeed = "rotSpeed",
	radius = "range", locked = "lockedToPart",
} :: any) :: { [string]: string }
local DIRS = { "up", "down", "forward", "back", "left", "right" }
local MATERIALS = { "neon", "forcefield", "glass", "smoothplastic", "plastic" }
local TEXTURE_MODES = { "stretch", "wrap", "static" }
-- Enum values also accepted under their Roblox names.
FxMath.ENUM_ALIASES = ({
	facingcamera = "facing", facingcameraworldup = "facingUp", velocityparallel = "parallel",
	velocityperpendicular = "perpendicular", top = "up", bottom = "down", front = "forward", grid2x2 = "2x2",
	grid4x4 = "4x4", grid8x8 = "8x8", ["2"] = "2x2", ["4"] = "4x4", ["8"] = "8x8", inandout = "both", ball = "sphere",
	brick = "block", cube = "block",
} :: any) :: { [string]: string }
-- {type, lo, hi} or {type, choices} or {"table", nestedName}. Types: num, int, bool, enum, range (number or
-- {min, max}), pair (number or {a, b}), vec3, numvec (number or Vector3), sizepair (numvec or {from, to}), target
-- (Vector3 or an Instance), numseq, colseq, color, texture, asset, ease, table.
FxMath.TYPES = ({
	common = { kind = { "enum", FxMath.KINDS }, delay = { "num", 0, 30 }, offset = { "vec3" } },
	particles = {
		count = { "int", 0, 1000 }, rate = { "num", 0, 1000 }, duration = { "num", 0, 600 },
		lifetime = { "range", 0, 20 }, speed = { "range", -1000, 1000 }, spread = { "pair", 0, 360 },
		size = { "numseq", 0, 1000 }, transparency = { "numseq", 0, 1 }, color = { "colseq" },
		lightEmission = { "num", 0, 1 }, lightInfluence = { "num", 0, 1 }, brightness = { "num", 0, 1000 },
		drag = { "num", -100, 100 }, acceleration = { "vec3" }, rotation = { "range", -3600, 3600 },
		rotSpeed = { "range", -36000, 36000 },
		orientation = { "enum", { "facing", "facingUp", "parallel", "perpendicular" } },
		squash = { "numseq", -3, 3 }, zoffset = { "num", -1000, 1000 }, flipbook = { "table", "flipbook" },
		texture = { "texture" }, direction = { "enum", DIRS }, shape = { "table", "shape" }, lockedToPart = { "bool" },
		timeScale = { "num", 0, 1 },
	},
	beam = {
		to = { "target" }, from = { "target" }, width = { "pair", 0, 1000 }, color = { "colseq" },
		transparency = { "numseq", 0, 1 }, texture = { "texture" }, textureSpeed = { "num", -1000, 1000 },
		textureLength = { "num", 0.001, 1000 }, textureMode = { "enum", TEXTURE_MODES },
		lightEmission = { "num", 0, 1 }, lightInfluence = { "num", 0, 1 }, brightness = { "num", 0, 1000 },
		curve = { "pair", -1000, 1000 }, segments = { "int", 1, 1000 }, faceCamera = { "bool" },
		zoffset = { "num", -1000, 1000 }, duration = { "num", 0, 600 }, fadeOut = { "num", 0, 10 },
	},
	light = {
		color = { "color" }, brightness = { "num", 0, 1000 }, range = { "num", 0, 60 }, duration = { "num", 0, 600 },
		attack = { "num", 0, 10 }, shadows = { "bool" }, spot = { "table", "spot" },
	},
	flash = {
		shape = { "enum", { "sphere", "block", "mesh" } }, mesh = { "asset" }, meshTexture = { "texture" },
		material = { "enum", MATERIALS }, color = { "color" }, size = { "sizepair", 0, 1000 },
		transparency = { "pair", 0, 1 }, duration = { "num", 0, 10 }, ease = { "ease" },
		spin = { "num", -36000, 36000 },
	},
	ring = {
		size = { "pair", 0, 1000 }, thickness = { "num", 0, 100 }, color = { "colseq" },
		transparency = { "numseq", 0, 1 }, duration = { "num", 0, 10 }, texture = { "texture" },
		lightEmission = { "num", 0, 1 }, brightness = { "num", 0, 1000 }, flat = { "bool" }, ease = { "ease" },
		material = { "enum", MATERIALS },
	},
	decal = {
		texture = { "texture" }, size = { "pair", 0, 1000 }, color = { "color" }, transparency = { "pair", 0, 1 },
		duration = { "num", 0, 600 }, fade = { "num", 0, 60 }, grow = { "num", 0, 10 },
		rotation = { "range", -3600, 3600 },
	},
	flipbook = {
		layout = { "enum", { "2x2", "4x4", "8x8" } }, mode = { "enum", { "loop", "oneshot", "pingpong", "random" } },
		fps = { "range", 0, 240 }, random = { "bool" },
	},
	shape = {
		kind = { "enum", { "sphere", "box", "disc", "cylinder" } }, size = { "numvec", 0, 1000 },
		style = { "enum", { "volume", "surface" } }, inOut = { "enum", { "outward", "inward", "both" } },
		partial = { "num", 0, 1 },
	},
	spot = { angle = { "num", 0, 180 }, face = { "enum", DIRS } },
	budget = { particles = { "int", 0, 100000 }, lights = { "int", 0, 64 }, effects = { "int", 1, 1000 } },
	trail = {
		width = { "num", 0, 1000 }, offset = { "vec3" }, axis = { "enum", { "up", "right", "forward" } },
		lifetime = { "num", 0, 20 }, color = { "colseq" }, transparency = { "numseq", 0, 1 },
		widthScale = { "numseq", 0, 1000 }, texture = { "texture" }, textureMode = { "enum", TEXTURE_MODES },
		textureLength = { "num", 0.001, 1000 }, lightEmission = { "num", 0, 1 }, lightInfluence = { "num", 0, 1 },
		brightness = { "num", 0, 1000 }, minLength = { "num", 0, 1000 }, maxLength = { "num", 0, 100000 },
		faceCamera = { "bool" }, enabled = { "bool" },
	},
} :: any) :: { [string]: { [string]: { any } } }

-- Camera option names (CameraRig warns about unknown ones with a suggestion).
FxMath.FOLLOW_KEYS = { "preset", "subject", "distance", "height", "offset", "fov", "yaw", "pitch", "pitchMin",
	"pitchMax", "orbit", "sensitivity", "invertY", "speed", "damping", "verticalSpeed", "rotSpeed", "zoomSpeed",
	"lookAhead", "lookAheadSpeed", "lookAheadRate", "collision", "collisionRadius", "minDistance", "returnSpeed",
	"speedFov", "autoAlign", "shoulder", "shoulderKey", "zoom", "ignore", "fadeSubject", "blend", "input" }
FxMath.SHOT_KEYS = { "from", "to", "path", "lookAt", "lookOffset", "orbit", "relativeTo", "track", "duration", "hold",
	"ease", "fov", "roll", "handheld", "blendIn", "blendOut", "letterbox", "slowmo", "timeScaled", "onStart", "onDone",
	"skipInput", "lockControls", "name" }
FxMath.SEQUENCE_KEYS = { "letterbox", "skipInput", "lockControls", "onDone", "blendOut", "name" }
-- Options of VFX.effect / VFX.play, VFX.hitstop and VFX.vignette.
FxMath.EFFECT_OPTS = { "scale", "intensity", "normal", "direction", "follow", "timeScaled", "onDone" }
FxMath.HITSTOP_KEYS = { "character", "animators", "tracks", "emitters", "camera", "timeScale", "speed" }
FxMath.VIGNETTE_KEYS = { "strength", "thickness", "fadeIn", "fadeOut", "texture" }
FxMath.CAMERA_NESTED_KEYS = {
	orbit = { "target", "radius", "height", "from", "to" },
	handheld = { "amount", "rotation", "frequency" },
	letterbox = { "ratio", "color", "seconds", "displayOrder", "maxFraction" },
	speedFov = { "from", "to", "fov", "pull" },
	zoom = { "min", "max", "step" },
	sensitivity = { "mouse", "touch", "gamepad" },
	autoAlign = { "delay", "speed" },
	slowmo = { "scale", "seconds", "rampIn", "rampOut" },
}

------------------------------------------------------------------------------------------------ validation
local lookupCache: { [any]: { [string]: string } } = setmetatable({}, { __mode = "k" }) :: any

local function lookupFor(keys: { string }): { [string]: string }
	local m = lookupCache[keys]
	if not m then
		m = {}
		for _, k in keys do
			m[string.lower(k)] = k
		end
		lookupCache[keys] = m
	end
	return m
end

export type Unknown = { key: string, suggestion: string? }

-- A copy of tbl with canonical keys (case-insensitive, FxMath.ALIASES), plus the keys it does not know, each with
-- a suggestion. An exact canonical key wins over an alias of it.
function FxMath.normalizeKeys(tbl: { [any]: any }, keys: { string }): ({ [string]: any }, { Unknown })
	local lookup = lookupFor(keys)
	local out: { [string]: any } = {}
	local unknown: { Unknown } = {}
	for k, v in tbl do
		if type(k) == "string" then
			local lower = string.lower(k)
			local canon = lookup[lower]
			if not canon then
				local alias = FxMath.ALIASES[lower]
				if alias and lookup[string.lower(alias)] then
					canon = alias
				end
			end
			if canon then
				if k == canon or out[canon] == nil then
					out[canon] = v
				end
			else
				table.insert(unknown, { key = k, suggestion = FxMath.closest(k, keys) })
			end
		else
			table.insert(unknown, { key = "[" .. tostring(k) .. "]", suggestion = nil })
		end
	end
	table.sort(unknown, function(a: Unknown, b: Unknown): boolean
		return a.key < b.key
	end)
	return out, unknown
end

-- The canonical choice for an enum value (string, number or EnumItem), or nil.
function FxMath.enumValue(v: any, choices: { string }): string?
	local name: string? = nil
	local ty: string = typeof(v)
	if ty == "string" then
		name = v
	elseif ty == "EnumItem" then
		name = (v :: any).Name
	elseif isNum(v) then
		name = tostring(v)
	end
	if not name then
		return nil
	end
	local lower = string.lower(name)
	lower = string.lower(FxMath.ENUM_ALIASES[lower] or lower)
	for _, c in choices do
		if string.lower(c) == lower then
			return c
		end
	end
	return nil
end

local function describe(v: any): string
	local t = typeof(v)
	if t == "string" then
		return "\"" .. string.sub(v, 1, 40) .. "\""
	elseif t == "number" or t == "boolean" or t == "nil" then
		return tostring(v)
	end
	return "a " .. t
end

local function fmtNum(x: number): string
	if x == math.floor(x) and math.abs(x) < 1e15 then
		return string.format("%d", x)
	end
	return tostring(x)
end

local function push(out: { string }, path: string, msg: string)
	table.insert(out, path .. ": " .. msg)
end

local function inRange(x: number, spec: { any }): boolean
	return x >= spec[2] and x <= spec[3]
end

local function rangeText(spec: { any }): string
	return fmtNum(spec[2]) .. ".." .. fmtNum(spec[3])
end

local checkValue: (spec: { any }, v: any, path: string, out: { string }) -> ()

local function checkTable(v: any, schemaName: string, path: string, out: { string })
	if type(v) ~= "table" then
		push(out, path, "expected a table, got " .. describe(v))
		return
	end
	local keys = FxMath.NESTED_KEYS[schemaName]
	local types = FxMath.TYPES[schemaName]
	local norm, unknown = FxMath.normalizeKeys(v, keys)
	for _, u in unknown do
		push(out, path .. "." .. u.key, "unknown key" .. (if u.suggestion then " (did you mean " .. u.suggestion .. "?)" else ""))
	end
	local names = {}
	for k in norm do
		table.insert(names, k)
	end
	table.sort(names)
	for _, k in names do
		checkValue(types[k], norm[k], path .. "." .. k, out)
	end
end

local function numOrVec(v: any, spec: { any }): boolean
	if isNum(v) then
		return inRange(v, spec)
	elseif isVec(v) then
		return inRange(v.X, spec) and inRange(v.Y, spec) and inRange(v.Z, spec)
	end
	return false
end

checkValue = function(spec: { any }, v: any, path: string, out: { string })
	local kind = spec[1]
	if kind == "num" then
		if not isNum(v) then
			push(out, path, "expected a number, got " .. describe(v))
		elseif not inRange(v, spec) then
			push(out, path, "expected " .. rangeText(spec) .. ", got " .. fmtNum(v))
		end
	elseif kind == "int" then
		if not isNum(v) or v % 1 ~= 0 then
			push(out, path, "expected a whole number, got " .. describe(v))
		elseif not inRange(v, spec) then
			push(out, path, "expected " .. rangeText(spec) .. ", got " .. fmtNum(v))
		end
	elseif kind == "bool" then
		if type(v) ~= "boolean" then
			push(out, path, "expected true or false, got " .. describe(v))
		end
	elseif kind == "enum" then
		if FxMath.enumValue(v, spec[2]) == nil then
			local name = if type(v) == "string" then v else nil
			local guess = name and FxMath.closest(name, spec[2])
			push(out, path, "expected one of " .. table.concat(spec[2], ", ") .. ", got " .. describe(v)
				.. (if guess then " (did you mean " .. guess .. "?)" else ""))
		end
	elseif kind == "range" or kind == "pair" then
		local a, b = nil, nil
		local ty: string = typeof(v)
		if ty == "NumberRange" then
			a, b = (v :: any).Min, (v :: any).Max
		elseif isNum(v) then
			a, b = v, v
		elseif type(v) == "table" and #v == 2 and isNum(v[1]) and isNum(v[2]) then
			a, b = v[1], v[2]
		end
		if a == nil or b == nil then
			push(out, path, "expected a number or {" .. (if kind == "range" then "min, max" else "a, b") .. "}, got " .. describe(v))
		elseif not inRange(a, spec) or not inRange(b, spec) then
			push(out, path, "expected values in " .. rangeText(spec))
		elseif kind == "range" and a > b then
			push(out, path, "min is greater than max")
		end
	elseif kind == "vec3" then
		if not isVec(v) then
			push(out, path, "expected a Vector3, got " .. describe(v))
		end
	elseif kind == "numvec" then
		if not numOrVec(v, spec) then
			push(out, path, "expected a number or a Vector3 in " .. rangeText(spec) .. ", got " .. describe(v))
		end
	elseif kind == "sizepair" then
		local ok = numOrVec(v, spec)
		if not ok and type(v) == "table" and #v == 2 then
			ok = numOrVec(v[1], spec) and numOrVec(v[2], spec)
		end
		if not ok then
			push(out, path, "expected a size (number or Vector3) or {from, to} in " .. rangeText(spec) .. ", got " .. describe(v))
		end
	elseif kind == "target" then
		local ty: string = typeof(v)
		if not isVec(v) and ty ~= "Instance" then
			push(out, path, "expected a Vector3 (offset in the effect's frame) or a part / attachment, got " .. describe(v))
		end
	elseif kind == "numseq" then
		local ty: string = typeof(v)
		if ty == "NumberSequence" then
			return
		end
		local list, problems = FxMath.keypoints(v, isNum)
		for _, p in problems do
			push(out, path, p)
		end
		if list then
			for _, k in list do
				if not inRange(k.v, spec) then
					push(out, path, "values must be in " .. rangeText(spec) .. ", got " .. fmtNum(k.v))
					break
				end
			end
		end
	elseif kind == "colseq" then
		local ty: string = typeof(v)
		if ty == "ColorSequence" then
			return
		end
		local _, problems = FxMath.keypoints(v, FxMath.isColor)
		for _, p in problems do
			push(out, path, p .. " (colours: Color3, \"#RRGGBB\" or \"Tokens.color.<name>\")")
		end
	elseif kind == "color" then
		if not FxMath.isColor(v) then
			push(out, path, "expected a Color3, \"#RRGGBB\" or \"Tokens.color.<name>\", got " .. describe(v))
		end
	elseif kind == "texture" then
		if not FxMath.isTexture(v) then
			push(out, path, "expected a content id (\"rbxassetid://123\") or a texture name, got " .. describe(v))
		end
	elseif kind == "asset" then
		if not (FxMath.isContentId(v) or (isNum(v) and v > 0 and v % 1 == 0)) then
			push(out, path, "expected a content id (\"rbxassetid://123\") or an asset id, got " .. describe(v))
		end
	elseif kind == "ease" then
		local _, problem = FxMath.easeFn(v)
		if problem then
			push(out, path, problem)
		end
	elseif kind == "table" then
		checkTable(v, spec[2], path, out)
	end
end

local ALL_LAYER_KEYS: { [string]: { string } } = {}
for kind, keys in FxMath.LAYER_KEYS do
	local all = table.clone(FxMath.COMMON_KEYS)
	for _, k in keys do
		table.insert(all, k)
	end
	ALL_LAYER_KEYS[kind] = all
end

-- Every key a layer of this kind may have (the common keys first).
function FxMath.layerKeys(kind: string): { string }?
	return ALL_LAYER_KEYS[kind]
end

local function findKey(tbl: { [any]: any }, name: string): any
	local v = tbl[name]
	if v ~= nil then
		return v
	end
	for k, x in tbl do
		if type(k) == "string" and string.lower(k) == name then
			return x
		end
	end
	return nil
end

FxMath.findKey = findKey

function FxMath.validateLayer(layer: any, path: string, out: { string })
	if type(layer) ~= "table" then
		push(out, path, "expected a layer table, got " .. describe(layer))
		return
	end
	local rawKind = findKey(layer, "kind")
	if rawKind == nil then
		push(out, path .. ".kind", "missing (one of " .. table.concat(FxMath.KINDS, ", ") .. ")")
		return
	end
	local kind = FxMath.enumValue(rawKind, FxMath.KINDS)
	if not kind then
		local guess = if type(rawKind) == "string" then FxMath.closest(rawKind, FxMath.KINDS) else nil
		push(out, path .. ".kind", "unknown kind " .. describe(rawKind) .. " (one of " .. table.concat(FxMath.KINDS, ", ")
			.. ")" .. (if guess then " (did you mean " .. guess .. "?)" else ""))
		return
	end
	local norm, unknown = FxMath.normalizeKeys(layer, ALL_LAYER_KEYS[kind])
	for _, u in unknown do
		push(out, path .. "." .. u.key, "unknown key for a " .. kind .. " layer"
			.. (if u.suggestion then " (did you mean " .. u.suggestion .. "?)" else ""))
	end
	local names = {}
	for k in norm do
		table.insert(names, k)
	end
	table.sort(names)
	local types = FxMath.TYPES[kind]
	for _, k in names do
		if k ~= "kind" then
			checkValue(types[k] or FxMath.TYPES.common[k], norm[k], path .. "." .. k, out)
		end
	end
	if kind == "particles" then
		if norm.count == nil and norm.rate == nil then
			push(out, path .. ".count", "set count (a burst) or rate (continuous emission)")
		elseif norm.count ~= nil and norm.rate ~= nil then
			push(out, path .. ".rate", "use count (a burst) or rate (continuous), not both")
		end
	elseif kind == "beam" then
		if norm.to == nil then
			push(out, path .. ".to", "a beam needs to (its end point)")
		end
	elseif kind == "decal" then
		if norm.texture == nil then
			push(out, path .. ".texture", "a decal needs a texture")
		end
	elseif kind == "flash" then
		if FxMath.enumValue(norm.shape, { "mesh" }) and norm.mesh == nil then
			push(out, path .. ".mesh", "shape \"mesh\" needs mesh (a mesh content id)")
		end
	end
end

-- Every problem in an effect spec, as "path: message" strings (paths like "layers[2].lifetime").
-- A bare list of layers is accepted as {layers = list}.
function FxMath.validateEffect(spec: any): { string }
	local out: { string } = {}
	if type(spec) ~= "table" then
		push(out, "effect", "expected a table with layers, got " .. describe(spec))
		return out
	end
	if findKey(spec, "layers") == nil and #spec > 0 then
		spec = { layers = spec }
	end
	local norm, unknown = FxMath.normalizeKeys(spec, FxMath.EFFECT_KEYS)
	for _, u in unknown do
		push(out, u.key, "unknown key for an effect" .. (if u.suggestion then " (did you mean " .. u.suggestion .. "?)" else ""))
	end
	local layers = norm.layers
	if type(layers) ~= "table" or #layers == 0 then
		push(out, "layers", "expected a non-empty list of layers")
	else
		for i, layer in ipairs(layers) do
			FxMath.validateLayer(layer, "layers[" .. i .. "]", out)
		end
	end
	if norm.family ~= nil and type(norm.family) ~= "string" then
		push(out, "family", "expected a string, got " .. describe(norm.family))
	end
	if norm.budget ~= nil then
		checkTable(norm.budget, "budget", "budget", out)
	end
	return out
end

-- Every problem in a VFX.trail spec.
function FxMath.validateTrail(spec: any): { string }
	local out: { string } = {}
	if type(spec) ~= "table" then
		push(out, "trail", "expected a table, got " .. describe(spec))
		return out
	end
	checkTable(spec, "trail", "trail", out)
	return out
end

return FxMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">GameplayKit</string>
          <string name="Source"><![CDATA[--!nonstrict
-- GameplayKit: self-wiring, server-authoritative game systems for any genre. Configure a system with one call;
-- remotes and replication are internal (the game never creates a RemoteEvent for a kit system).
--   local GK = require(ReplicatedStorage.Kit.GameplayKit)
--   Server: GK.Rounds.new{...}, GK.Score.new{...}, GK.Collectibles.new{...}, GK.Enemy.new{...}, GK.Race.new{...} ...
--   Client: requiring the module starts the client side (collectible bob/spin, knockback); read state with
--           GK.watch("Rounds", "State", fn), player:GetAttribute("Checkpoint"), part:GetAttribute("Progress") ...
-- Every signal is s:Connect(fn) -> conn (conn:Disconnect(), Maid-friendly); handlers run isolated (task.spawn).
-- Siblings: GameplayKit_Core, _Combat, _Items, _AI, _Race, _World (all in ReplicatedStorage.Kit).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Kit = script.Parent :: Instance
local Core = require(Kit:WaitForChild("GameplayKit_Core"))
local Combat = require(Kit:WaitForChild("GameplayKit_Combat"))
local Items = require(Kit:WaitForChild("GameplayKit_Items"))
local AI = require(Kit:WaitForChild("GameplayKit_AI"))
local Race = require(Kit:WaitForChild("GameplayKit_Race"))
local World = require(Kit:WaitForChild("GameplayKit_World"))
local Maid = require(Kit:WaitForChild("Maid"))
local Signal = Core.Signal

local GK = {}
GK.Signal = Signal
GK.Core = Core
GK.watch = Core.watch -- GK.watch(system, attr, fn) -> conn (server or client)
GK.get = Core.get -- GK.get(system, attr) -> value
GK.limiter = Core.limiter

----------------------------------------------------------------------------------------------------------------
-- Timer / stopwatch (server or client). Timer.new({duration=60 | nil (stopwatch), tick=1, name=nil (server:
-- replicate as state "Timer_<name>" attrs Remaining/Elapsed/Running)}) -> t:start(); t:pause(); t:resume();
-- t:reset(); t:elapsed(); t:remaining(); t.Tick: Signal(value); t.Finished: Signal()
----------------------------------------------------------------------------------------------------------------
local Timer = {}
Timer.__index = Timer
function Timer.new(opts)
	opts = opts or {}
	return setmetatable({
		duration = opts.duration, tickEvery = opts.tick or 1, acc = 0, running = false,
		state = (opts.name and Core.isServer) and Core.state("Timer_" .. opts.name) or nil,
		Tick = Signal.new(), Finished = Signal.new(),
	}, Timer)
end
function Timer:elapsed()
	return self.acc + (self.running and (os.clock() - self.t0) or 0)
end
function Timer:remaining()
	return self.duration and math.max(0, self.duration - self:elapsed()) or nil
end
function Timer:_sync()
	if self.state then
		self.state:SetAttribute("Elapsed", self:elapsed())
		self.state:SetAttribute("Remaining", self:remaining())
		self.state:SetAttribute("Running", self.running)
	end
end
function Timer:resume()
	if self.running then
		return
	end
	self.running = true
	self.t0 = os.clock()
	self:_sync()
	self.thread = task.spawn(function()
		while self.running do
			task.wait(self.tickEvery)
			if not self.running then
				break
			end
			local rem = self:remaining()
			self:_sync()
			self.Tick:Fire(rem or self:elapsed())
			if rem and rem <= 0 then
				self.acc, self.running = self.duration, false
				self:_sync()
				self.Finished:Fire()
			end
		end
	end)
end
Timer.start = Timer.resume
function Timer:pause()
	if self.running then
		self.acc = self:elapsed()
		self.running = false
		if self.thread and coroutine.running() ~= self.thread then
			pcall(task.cancel, self.thread)
		end
		self:_sync()
	end
end
function Timer:reset()
	self:pause()
	self.acc = 0
	self:_sync()
end
Timer.destroy = Timer.pause
-- Timer.format(seconds, centis=false) -> "m:ss" or "m:ss.cc"
function Timer.format(s, centis)
	s = math.max(0, s or 0)
	local m = math.floor(s / 60)
	local r = s - m * 60
	if centis then
		return string.format("%d:%05.2f", m, r)
	end
	return string.format("%d:%02d", m, math.floor(r))
end
GK.Timer = Timer

----------------------------------------------------------------------------------------------------------------
-- Rounds: Lobby -> Countdown -> Playing -> Results -> (Lobby). State "Rounds": State, TimeLeft, Round, Reason, Players
----------------------------------------------------------------------------------------------------------------
local Rounds = {}
Rounds.__index = Rounds
-- Rounds.new({minPlayers=1, lobby=8, countdown=3, duration=120, results=6, autoStart=true, autoRestart=true,
--   lobbySpawn=CFrame|part?, arenaSpawns={CFrame|part...}? (players are teleported on start / end),
--   endWhen=fn(rounds) -> reason? (checked every second while Playing), onState=fn(state, prev),
--   onStart=fn(players), onEnd=fn(reason, players)}) -> r (r.State; r:finish(reason); r:stop(); r.participants)
function Rounds.new(opts)
	opts = opts or {}
	local self = setmetatable({
		opts = opts, State = "Idle", Round = 0, participants = {},
		state = Core.state("Rounds"),
		StateChanged = Signal.new(), -- (state, prev)
		Tick = Signal.new(), -- (timeLeft)
		Started = Signal.new(), -- (players)
		Ended = Signal.new(), -- (reason, players)
	}, Rounds)
	if opts.onState then
		self.StateChanged:Connect(opts.onState)
	end
	if opts.onStart then
		self.Started:Connect(opts.onStart)
	end
	if opts.onEnd then
		self.Ended:Connect(opts.onEnd)
	end
	if opts.autoStart ~= false then
		self:start()
	end
	return self
end
function Rounds:_set(state, timeLeft)
	local prev = self.State
	self.State = state
	if self.state then
		self.state:SetAttribute("State", state)
		self.state:SetAttribute("TimeLeft", timeLeft or 0)
		self.state:SetAttribute("Round", self.Round)
	end
	if prev ~= state then
		self.StateChanged:Fire(state, prev)
	end
end
function Rounds:_count(seconds, check)
	for t = seconds, 1, -1 do
		if self.state then
			self.state:SetAttribute("TimeLeft", t)
			self.state:SetAttribute("Players", #Players:GetPlayers())
		end
		self.Tick:Fire(t)
		task.wait(1)
		local r = check and check()
		if r then
			return r
		end
	end
	if self.state then
		self.state:SetAttribute("TimeLeft", 0)
	end
	return nil
end
local function teleport(player, at)
	local cf = Core.cframe(at)
	local ch = Core.character(player)
	if cf and ch then
		ch:PivotTo(cf + Vector3.new(0, 4, 0))
	end
end
function Rounds:start()
	if self.thread then
		return
	end
	local o = self.opts
	self.thread = task.spawn(function()
		repeat
			-- Lobby: wait for enough players, then the lobby timer
			self:_set("Lobby", o.lobby or 8)
			while #Players:GetPlayers() < (o.minPlayers or 1) do
				if self.state then
					self.state:SetAttribute("Players", #Players:GetPlayers())
				end
				task.wait(1)
			end
			local short = self:_count(o.lobby or 8, function()
				return #Players:GetPlayers() < (o.minPlayers or 1) and "short" or nil
			end)
			if not short then
				self:_set("Countdown", o.countdown or 3)
				self:_count(o.countdown or 3)
				self.Round += 1
				self.participants = {}
				for i, p in ipairs(Players:GetPlayers()) do
					table.insert(self.participants, p)
					local spawns = o.arenaSpawns
					if spawns and #spawns > 0 then
						teleport(p, spawns[(i - 1) % #spawns + 1])
					end
				end
				self.reason = nil
				self:_set("Playing", o.duration or 120)
				self.Started:Fire(self.participants)
				local reason = self:_count(o.duration or 120, function()
					if self.reason then
						return self.reason
					end
					return o.endWhen and o.endWhen(self) or nil
				end) or "time"
				if self.state then
					self.state:SetAttribute("Reason", reason)
				end
				self:_set("Results", o.results or 6)
				self.Ended:Fire(reason, self.participants)
				self:_count(o.results or 6)
				if o.lobbySpawn then
					for _, p in ipairs(Players:GetPlayers()) do
						teleport(p, o.lobbySpawn)
					end
				end
			end
		until o.autoRestart == false and not short
		self:_set("Idle", 0)
		self.thread = nil
	end)
end
-- r:finish(reason="finished") ends the current Playing phase at the next second
function Rounds:finish(reason)
	if self.State == "Playing" then
		self.reason = reason or "finished"
	end
end
function Rounds:stop()
	if self.thread then
		pcall(task.cancel, self.thread)
		self.thread = nil
	end
	self:_set("Idle", 0)
end
Rounds.destroy = Rounds.stop
GK.Rounds = Rounds

----------------------------------------------------------------------------------------------------------------
-- Score / leaderboard: leaderstats IntValues + sorted ranking. State "Score": Top (JSON top 10 of the primary stat);
-- player attribute "Rank".
----------------------------------------------------------------------------------------------------------------
local Score = {}
Score.__index = Score
-- Score.new({stats={"Score"} (first = primary, shown first), start=0, descending=true, leaderstats=true})
function Score.new(opts)
	opts = opts or {}
	local self = setmetatable({
		stats = opts.stats or { "Score" }, start = opts.start or 0, descending = opts.descending ~= false,
		leaderstats = opts.leaderstats ~= false, values = setmetatable({}, { __mode = "k" }),
		state = Core.state("Score"), maid = Maid.new(),
		Changed = Signal.new(), -- (player, stat, value)
	}, Score)
	self.primary = self.stats[1]
	local function join(p)
		local v = {}
		self.values[p] = v
		local ls
		if self.leaderstats then
			ls = p:FindFirstChild("leaderstats") or Instance.new("Folder")
			ls.Name = "leaderstats"
			ls.Parent = p
		end
		for _, stat in ipairs(self.stats) do
			v[stat] = self.start
			if ls then
				local iv = ls:FindFirstChild(stat) or Instance.new("IntValue")
				iv.Name = stat
				iv.Value = self.start
				iv.Parent = ls
			end
		end
		self:_rank()
	end
	for _, p in ipairs(Players:GetPlayers()) do
		join(p)
	end
	self.maid:Give(Players.PlayerAdded:Connect(join))
	self.maid:Give(Players.PlayerRemoving:Connect(function(p)
		self.values[p] = nil
		self:_rank()
	end))
	return self
end
function Score:get(player, stat)
	local v = self.values[player]
	return v and v[stat or self.primary] or 0
end
function Score:set(player, value, stat)
	stat = stat or self.primary
	local v = self.values[player]
	if not v then
		return
	end
	v[stat] = value
	local ls = player:FindFirstChild("leaderstats")
	local iv = ls and ls:FindFirstChild(stat)
	if iv then
		iv.Value = math.floor(value)
	end
	self.Changed:Fire(player, stat, value)
	self:_rank()
end
-- s:add(player, n=1, stat=primary) -> new value
function Score:add(player, n, stat)
	local new = self:get(player, stat) + (n or 1)
	self:set(player, new, stat)
	return new
end
-- s:ranking(stat=primary) -> { {player, name, value, rank} } best first
function Score:ranking(stat)
	stat = stat or self.primary
	local rows = {}
	for p, v in pairs(self.values) do
		if p.Parent then
			table.insert(rows, { player = p, name = p.DisplayName, value = v[stat] or 0 })
		end
	end
	table.sort(rows, function(a, b)
		if a.value == b.value then
			return a.name < b.name
		end
		if self.descending then
			return a.value > b.value
		end
		return a.value < b.value
	end)
	for i, r in ipairs(rows) do
		r.rank = i
	end
	return rows
end
function Score:_rank()
	if self.pending then
		return
	end
	self.pending = true
	task.defer(function()
		self.pending = false
		local rows = self:ranking()
		local top = {}
		for i, r in ipairs(rows) do
			r.player:SetAttribute("Rank", i)
			if i <= 10 then
				top[i] = { name = r.name, value = r.value, rank = i, userId = r.player.UserId }
			end
		end
		if self.state then
			self.state:SetAttribute("Top", Core.encode(top))
		end
	end)
end
function Score:reset()
	for p in pairs(self.values) do
		for _, stat in ipairs(self.stats) do
			self:set(p, self.start, stat)
		end
	end
end
function Score:destroy()
	self.maid:Clean()
end
GK.Score = Score

----------------------------------------------------------------------------------------------------------------
-- Objectives / quests. State "Objectives": List (JSON {id,text,goal}); player attrs Obj_<id> (progress),
-- ObjDone (count), ObjCurrent (sequential mode)
----------------------------------------------------------------------------------------------------------------
local Objectives = {}
Objectives.__index = Objectives
-- Objectives.new({list={ {id="coins", text="Collect 10 coins", goal=10, reward=fn(player)?}, ... },
--   sequential=false (only the current one advances), onComplete=fn(player, id), onAll=fn(player)})
function Objectives.new(opts)
	opts = opts or {}
	local self = setmetatable({
		list = opts.list or {}, sequential = opts.sequential or false, byId = {},
		data = setmetatable({}, { __mode = "k" }), state = Core.state("Objectives"),
		Progress = Signal.new(), -- (player, id, value, goal)
		Completed = Signal.new(), -- (player, id)
		AllCompleted = Signal.new(), -- (player)
	}, Objectives)
	local rows = {}
	for i, q in ipairs(self.list) do
		q.goal = q.goal or 1
		self.byId[q.id] = q
		rows[i] = { id = q.id, text = q.text or q.id, goal = q.goal }
	end
	if self.state then
		self.state:SetAttribute("List", Core.encode(rows))
	end
	if opts.onComplete then
		self.Completed:Connect(opts.onComplete)
	end
	if opts.onAll then
		self.AllCompleted:Connect(opts.onAll)
	end
	return self
end
function Objectives:_d(player)
	local d = self.data[player]
	if not d then
		d = { done = 0, cur = 1 }
		self.data[player] = d
		if self.list[1] then
			player:SetAttribute("ObjCurrent", self.list[1].id)
		end
	end
	return d
end
function Objectives:get(player, id)
	return self:_d(player)[id] or 0
end
function Objectives:isComplete(player, id)
	local q = self.byId[id]
	return q ~= nil and self:get(player, id) >= q.goal
end
-- o:set(player, id, value)
function Objectives:set(player, id, value)
	local q = self.byId[id]
	if not q then
		return
	end
	local d = self:_d(player)
	if self.sequential and self.list[d.cur] ~= q then
		return
	end
	local was = (d[id] or 0) >= q.goal
	value = math.clamp(value, 0, q.goal)
	d[id] = value
	player:SetAttribute("Obj_" .. id, value)
	self.Progress:Fire(player, id, value, q.goal)
	if not was and value >= q.goal then
		d.done += 1
		player:SetAttribute("ObjDone", d.done)
		if q.reward then
			task.spawn(q.reward, player)
		end
		self.Completed:Fire(player, id)
		if self.sequential then
			d.cur += 1
			player:SetAttribute("ObjCurrent", self.list[d.cur] and self.list[d.cur].id or nil)
		end
		if d.done >= #self.list then
			self.AllCompleted:Fire(player)
		end
	end
end
-- o:progress(player, id, n=1)
function Objectives:progress(player, id, n)
	self:set(player, id, self:get(player, id) + (n or 1))
end
function Objectives:reset(player)
	self.data[player] = nil
	for _, q in ipairs(self.list) do
		player:SetAttribute("Obj_" .. q.id, 0)
	end
	player:SetAttribute("ObjDone", 0)
	self:_d(player)
end
-- Client: Objectives.client() -> {list() -> {{id,text,goal,progress,done}}, Changed: Signal()}
function Objectives.client()
	local player = Players.LocalPlayer
	local h = { Changed = Signal.new() }
	function h.list()
		local rows = Core.decode(Core.get("Objectives", "List")) or {}
		for _, r in ipairs(rows) do
			r.progress = player and player:GetAttribute("Obj_" .. r.id) or 0
			r.done = r.progress >= r.goal
		end
		return rows
	end
	if player then
		player.AttributeChanged:Connect(function(name)
			if name:sub(1, 4) == "Obj_" or name == "ObjCurrent" then
				h.Changed:Fire()
			end
		end)
	end
	return h
end
GK.Objectives = Objectives

----------------------------------------------------------------------------------------------------------------
-- Re-exports
----------------------------------------------------------------------------------------------------------------
GK.Health = Combat.Health -- Health.new(target, opts); Health.of(x); Health.damage(x, n, source, opts); Health.players(opts)
GK.Teams = Combat.Teams
GK.Checkpoints = Combat.Checkpoints
GK.Weapon = Combat.Weapon
GK.knockback = Combat.knockback
GK.hitscan = Combat.hitscan
GK.hitbox = Combat.hitbox
GK.sphere = Combat.sphere
GK.sameTeam = Combat.sameTeam
GK.Collectibles = Items.Collectibles
GK.prompt = Items.prompt
GK.Carry = Items.Carry
GK.Station = Items.Station
GK.Recipes = Items.Recipes
GK.Inventory = Items.Inventory
GK.Enemy = AI.Enemy
GK.Spawner = AI.Spawner
GK.rig = AI.rig
GK.Race = Race -- Race.new(opts) -> race; race:addFollower(model, opts); Race.Spline.new(points)
GK.Mover = World.Mover
GK.Door = World.Door
GK.Hazard = World.Hazard

----------------------------------------------------------------------------------------------------------------
-- Client side: collectible bob/spin + knockback receiver. Runs automatically when a client requires this module.
----------------------------------------------------------------------------------------------------------------
local clientStarted = false
function GK.startClient()
	if clientStarted or not Core.isClient then
		return
	end
	clientStarted = true
	task.spawn(function()
		local remote = Core.remote("Knockback")
		if remote then
			remote.OnClientEvent:Connect(function(v)
				local _, root, hum = Core.character(Players.LocalPlayer)
				if root and typeof(v) == "Vector3" and v.Magnitude < 500 then
					hum:ChangeState(Enum.HumanoidStateType.Freefall)
					root.AssemblyLinearVelocity += v
				end
			end)
		end
	end)
	task.spawn(function()
		local remote = Core.remote("Carry")
		local UserInputService = game:GetService("UserInputService")
		if not remote then
			return
		end
		UserInputService.InputBegan:Connect(function(input, processed)
			local player = Players.LocalPlayer
			if processed or not player or player:GetAttribute("Holding") == nil then
				return
			end
			if input.KeyCode == Enum.KeyCode.G then
				remote:FireServer("drop")
			elseif input.KeyCode == Enum.KeyCode.R then
				remote:FireServer("throw")
			end
		end)
	end)
	local items = {}
	local function add(inst)
		items[inst] = math.random() * 10
	end
	for _, inst in ipairs(CollectionService:GetTagged("GK_Collectible")) do
		add(inst)
	end
	CollectionService:GetInstanceAddedSignal("GK_Collectible"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("GK_Collectible"):Connect(function(inst)
		items[inst] = nil
	end)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for inst, phase in pairs(items) do
			local base = inst:GetAttribute("GKBase")
			if typeof(base) == "CFrame" and inst.Parent then
				local y = inst:GetAttribute("GKBob") and math.sin(t * 2.2 + phase) * 0.35 or 0
				local spin = inst:GetAttribute("GKSpin") and (t * 2 + phase) or 0
				local cf = base * CFrame.new(0, y, 0) * CFrame.Angles(0, spin, 0)
				if inst:IsA("BasePart") then
					inst.CFrame = cf
				elseif inst:IsA("Model") then
					inst:PivotTo(cf)
				end
			end
		end
	end)
end

-- Maid-friendly aliases (maid:Give(obj) calls obj:Destroy())
Score.Destroy = Score.destroy
Rounds.Destroy = Rounds.destroy
Timer.Destroy = Timer.destroy

if Core.isClient then
	task.defer(GK.startClient)
end

return GK
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">GameplayKit_AI</string>
          <string name="Source"><![CDATA[--!nonstrict
-- GameplayKit_AI: enemies / NPCs with a state machine (idle, patrol, chase, attack, flee, return), perception
-- (range + sight cone + line-of-sight raycast, plus a short hearing radius), PathfindingService with a
-- straight-line fallback, melee/ranged attacks, a default blocky rig, and a wave spawner. Server only.

local Workspace = game:GetService("Workspace")
local PathfindingService = game:GetService("PathfindingService")

local Core = require((script.Parent :: Instance):WaitForChild("GameplayKit_Core"))
local Combat = require((script.Parent :: Instance):WaitForChild("GameplayKit_Combat"))
local Maid = require((script.Parent :: Instance):WaitForChild("Maid"))
local Signal = Core.Signal
local Health = Combat.Health

local AI = {}

----------------------------------------------------------------------------------------------------------------
-- Default rig: a blocky humanoid (style="humanoid") or a squat monster (style="monster"). Limbs are welded
-- (no animation needed), Humanoid HipHeight keeps it standing; it walks with Humanoid:MoveTo.
----------------------------------------------------------------------------------------------------------------
-- AI.rig({style="humanoid"|"monster", color="#7A3BD1", accent="#FFE14D", scale=1, name="Enemy"}) -> Model
function AI.rig(o)
	o = o or {}
	local s = o.scale or 1
	local color = Core.color(o.color, Color3.fromRGB(122, 59, 209))
	local accent = Core.color(o.accent, Color3.fromRGB(255, 225, 77))
	local model = Instance.new("Model")
	model.Name = o.name or "Enemy"
	local monster = o.style == "monster"
	local legH = (monster and 1.2 or 2) * s
	local torso = monster and Vector3.new(3.4, 2.6, 2.6) * s or Vector3.new(2, 2, 1) * s
	local root = Core.part({
		Name = "HumanoidRootPart", Size = Vector3.new(2 * s, torso.Y, 1 * s), Transparency = 1, Anchored = false, CanCollide = true,
		CFrame = CFrame.new(0, legH + torso.Y / 2, 0), Parent = model,
	})
	model.PrimaryPart = root
	local function limb(name, size, offset, col, shape)
		local p = Core.part({
			Name = name, Size = size, Color = col, Material = Enum.Material.SmoothPlastic, Anchored = false,
			CanCollide = false, Massless = true, Shape = shape, CFrame = root.CFrame * offset, Parent = model,
		})
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
		return p
	end
	limb("Torso", torso, CFrame.new(), color)
	local headSize = (monster and 1.6 or 1.2) * s
	local headOffset = CFrame.new(0, torso.Y / 2 + headSize / 2, monster and -0.4 * s or 0)
	limb("Head", Vector3.one * headSize, headOffset, color)
	for _, x in ipairs({ -0.3, 0.3 }) do
		local eye = limb("Eye", Vector3.new(0.25, 0.25, 0.1) * s, headOffset * CFrame.new(x * headSize, 0.1 * headSize, -headSize / 2 - 0.02), accent)
		eye.Material = Enum.Material.Neon
	end
	local legX = torso.X / 2 - 0.5 * s
	for i, x in ipairs({ -legX, legX }) do
		limb(i == 1 and "LeftLeg" or "RightLeg", Vector3.new(0.9 * s, legH, 0.9 * s), CFrame.new(x, -torso.Y / 2 - legH / 2, 0), color:Lerp(Color3.new(), 0.3))
	end
	if not monster then
		for i, x in ipairs({ -1.5 * s, 1.5 * s }) do
			limb(i == 1 and "LeftArm" or "RightArm", Vector3.new(1 * s, 2 * s, 1 * s), CFrame.new(x, 0, 0), color:Lerp(Color3.new(1, 1, 1), 0.15))
		end
	end
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15 -- R15 + HipHeight: the root floats at HipHeight, no Motor6D rig required
	hum.HipHeight = legH
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.Parent = model
	return model
end

----------------------------------------------------------------------------------------------------------------
-- Targets & perception
----------------------------------------------------------------------------------------------------------------
local function defaultTargets(self)
	local out = {}
	for _, e in ipairs(Core.alivePlayers()) do
		if not Combat.sameTeam(e.character, self.model) then
			table.insert(out, e.character)
		end
	end
	return out
end

local Enemy = {}
Enemy.__index = Enemy
AI.Enemy = Enemy
local enemyWeapons = {} -- shared server-only weapons for ranged enemies, keyed by damage/range

-- Enemy.new({model=Model? (default AI.rig(rig)), rig={style, color, scale}, position=Vector3|CFrame, parent=Folder,
--   kind="melee"|"ranged", hp=100, speed=14, sight=70 (range), fov=110 (degrees), hearing=12, lose=110,
--   memory=3 (s chasing last seen position), attackRange=5 (ranged: 45), damage=10, cooldown=1.1, windup=0.25,
--   knockback=35, patrol={Vector3...} | nil (wander patrolRadius=20 around home), idleTime={1,3}, flee=0
--   (hp fraction to flee at), leash=140 (return home when this far), team="Enemies", think=0.15 (s),
--   targets=fn(enemy) -> {Model}, onAttack=fn(enemy, targetModel) (return false to skip default damage),
--   onDeath=fn(enemy, killer), onState=fn(enemy, state, prev), weapon=GameplayKit.Weapon (ranged; default hitscan)})
function Enemy.new(opts)
	opts = opts or {}
	local model = opts.model or AI.rig(opts.rig)
	local ranged = opts.kind == "ranged"
	local self = setmetatable({
		model = model,
		opts = opts,
		kind = ranged and "ranged" or "melee",
		speed = opts.speed or 14,
		sight = opts.sight or 70,
		cosHalfFov = math.cos(math.rad((opts.fov or 110) / 2)),
		hearing = opts.hearing or 12,
		lose = opts.lose or 110,
		memory = opts.memory or 3,
		attackRange = opts.attackRange or (ranged and 45 or 5),
		damage = opts.damage or 10,
		cooldown = opts.cooldown or 1.1,
		windup = opts.windup or 0.25,
		knockback = Core.opt(opts, "knockback", 35),
		patrol = opts.patrol,
		patrolRadius = opts.patrolRadius or 20,
		idleTime = opts.idleTime or { 1, 3 },
		flee = opts.flee or 0,
		leash = opts.leash or 140,
		think = opts.think or 0.15,
		targets = opts.targets or defaultTargets,
		State = "idle",
		StateChanged = Signal.new(), -- (state, prev)
		Attacked = Signal.new(), -- (targetModel)
		Died = Signal.new(), -- (killer)
		maid = Maid.new(),
		rng = Random.new(),
		lastAttack = 0,
		patrolIndex = 1,
	}, Enemy)
	model:SetAttribute("Team", opts.team or "Enemies")
	model:SetAttribute("AIState", "idle")
	local at = Core.cframe(opts.position) or CFrame.new(0, 5, 0)
	model:PivotTo(at)
	model.Parent = opts.parent or Core.folder("Enemies")
	self.home = at.Position
	self.humanoid = model:FindFirstChildOfClass("Humanoid")
	self.root = Core.root(model)
	if not self.humanoid or not self.root then
		warn("[GameplayKit] Enemy model needs a Humanoid and a root part; got " .. model:GetFullName())
	end
	if self.humanoid then
		self.humanoid.WalkSpeed = self.speed
	end
	pcall(function()
		self.root:SetNetworkOwner(nil) -- server-authoritative movement, no client can drag enemies
	end)
	self.health = Health.new(model, { max = opts.hp or 100, invuln = 0.1, destroyOnDeath = 3 })
	self.maid:Give(self.health.Died:Connect(function(killer)
		self:_setState("dead")
		self.Died:Fire(killer)
		if opts.onDeath then
			task.spawn(opts.onDeath, self, killer)
		end
		task.delay(3, function()
			self:destroy()
		end)
	end))
	if opts.onState then
		self.StateChanged:Connect(function(s, prev)
			opts.onState(self, s, prev)
		end)
	end
	if ranged then
		local key = self.damage .. "_" .. self.attackRange
		enemyWeapons[key] = enemyWeapons[key] or Combat.Weapon.new("EnemyBolt_" .. key, {
			kind = "hitscan", damage = self.damage, cooldown = 0, range = self.attackRange + 10, color = "#FF5A5A", serverOnly = true,
		})
		self.weapon = opts.weapon or enemyWeapons[key]
	end
	self.idleUntil = os.clock() + self.rng:NextNumber(self.idleTime[1], self.idleTime[2])
	self.maid:Give(task.spawn(function()
		task.wait(self.rng:NextNumber(0, self.think)) -- de-sync brains
		while self.State ~= "dead" and model.Parent do
			local ok, err = pcall(self._step, self)
			if not ok then
				warn("[GameplayKit] enemy brain: " .. tostring(err))
			end
			task.wait(self.think)
		end
	end))
	return self
end

function Enemy:_setState(s)
	if s == self.State then
		return
	end
	local prev = self.State
	self.State = s
	self.model:SetAttribute("AIState", s)
	self.path = nil
	self.StateChanged:Fire(s, prev)
end

-- returns the best visible target (closest), or nil
function Enemy:_perceive()
	local root = self.root
	local look = root.CFrame.LookVector
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local best, bestD = nil, math.huge
	for _, t in ipairs(self.targets(self)) do
		local tr = Core.root(t)
		if tr then
			local to = tr.Position - root.Position
			local d = to.Magnitude
			local range = (self.target == t) and self.lose or self.sight
			if d < bestD and d <= range then
				local inCone = d <= self.hearing or (d > 0 and look:Dot(to.Unit) >= self.cosHalfFov) or self.target == t
				if inCone then
					params.FilterDescendantsInstances = { self.model, t, Core.folder("GameplayKitFX") }
					local head = self.model:FindFirstChild("Head")
					local eye = head and head.Position or root.Position
					local hit = Workspace:Raycast(eye, tr.Position - eye, params)
					if not hit then
						best, bestD = t, d
					end
				end
			end
		end
	end
	return best, bestD
end

-- move toward a world point: pathfinding when far / blocked, straight-line steering otherwise
function Enemy:_moveTo(goal, run)
	local hum = self.humanoid
	if not hum then
		return
	end
	hum.WalkSpeed = run and self.speed or self.speed * 0.5
	local pos = self.root.Position
	local flat = Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z)
	if flat.Magnitude < 2 then
		hum:Move(Vector3.zero)
		return true
	end
	local now = os.clock()
	local direct = flat.Magnitude < 14
	if not direct then
		local p = self.path
		if not p or (p.goal - goal).Magnitude > 6 or now - p.t > 1.5 then
			p = { goal = goal, t = now, i = 2, points = nil }
			local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
			local ok = pcall(function()
				path:ComputeAsync(pos, goal)
			end)
			if ok and path.Status == Enum.PathStatus.Success then
				p.points = path:GetWaypoints()
			end
			self.path = p
		end
		if p.points and p.points[p.i] then
			local wp = p.points[p.i]
			if (Vector3.new(wp.Position.X - pos.X, 0, wp.Position.Z - pos.Z)).Magnitude < 3 then
				p.i += 1
				wp = p.points[p.i] or wp
			end
			if wp.Action == Enum.PathWaypointAction.Jump then
				hum.Jump = true
			end
			hum:MoveTo(wp.Position)
			return false
		end
	end
	hum:MoveTo(goal) -- straight-line fallback
	return false
end

function Enemy:_face(pos)
	local r = self.root
	local flat = Vector3.new(pos.X, r.Position.Y, pos.Z)
	if (flat - r.Position).Magnitude > 0.1 then
		self.humanoid:Move(Vector3.zero)
		r.CFrame = CFrame.lookAt(r.Position, flat)
	end
end

function Enemy:_attack(target)
	local now = os.clock()
	if now - self.lastAttack < self.cooldown then
		return
	end
	self.lastAttack = now
	local tr = Core.root(target)
	if not tr then
		return
	end
	self:_face(tr.Position)
	task.delay(self.windup, function()
		if self.State == "dead" or not self.model.Parent then
			return
		end
		self.Attacked:Fire(target)
		if self.opts.onAttack and self.opts.onAttack(self, target) == false then
			return
		end
		local r2 = Core.root(target)
		if not r2 then
			return
		end
		if self.kind == "ranged" then
			self.weapon:fireFrom(self.model, (r2.Position - (self.model:FindFirstChild("Head") or self.root).Position))
		elseif (r2.Position - self.root.Position).Magnitude <= self.attackRange + 2 then -- re-check at hit time
			local dir = (r2.Position - self.root.Position) * Vector3.new(1, 0, 1)
			Health.damage(target, self.damage, self.model, { knockback = dir.Magnitude > 0 and dir.Unit * self.knockback or nil })
		end
	end)
end

function Enemy:_step()
	if not self.root or not self.humanoid or self.health.dead then
		return
	end
	local now = os.clock()
	local pos = self.root.Position
	local fromHome = (pos - self.home).Magnitude
	local hpFrac = self.health:get() / self.health.Max

	local target, dist = self:_perceive()
	if target then
		self.target = target
		self.lastSeen = now
		self.lastSeenPos = Core.root(target).Position
	elseif self.target and now - (self.lastSeen or 0) > self.memory then
		self.target = nil
	end

	if self.State == "return" then
		if fromHome < 4 then
			self.health:heal(self.health.Max)
			self:_setState("idle")
		else
			self:_moveTo(self.home, true)
		end
		return
	end
	if fromHome > self.leash then
		self.target = nil
		self:_setState("return")
		return
	end
	if self.target and self.flee > 0 and hpFrac <= self.flee then
		self:_setState("flee")
		local away = pos - (self.lastSeenPos or pos)
		away = away.Magnitude > 0.1 and away.Unit or self.root.CFrame.LookVector * -1
		self:_moveTo(pos + away * 20, true)
		return
	end
	if self.target then
		local tr = Core.root(self.target)
		if target and dist <= self.attackRange then
			self:_setState("attack")
			if self.kind == "melee" then
				self.humanoid:MoveTo(tr.Position)
			end
			self:_attack(self.target)
		else
			self:_setState("chase")
			self:_moveTo(target and tr.Position or self.lastSeenPos, true)
		end
		return
	end
	-- calm: idle <-> patrol
	if self.State ~= "idle" and self.State ~= "patrol" then
		self:_setState("idle")
		self.idleUntil = now + self.rng:NextNumber(self.idleTime[1], self.idleTime[2])
	end
	if self.State == "idle" then
		self.humanoid:Move(Vector3.zero)
		if now >= self.idleUntil then
			if self.patrol and #self.patrol > 0 then
				self.goal = Core.position(self.patrol[self.patrolIndex])
				self.patrolIndex = self.patrolIndex % #self.patrol + 1
			else
				local a = self.rng:NextNumber(0, math.pi * 2)
				local r = self.rng:NextNumber(0.3, 1) * self.patrolRadius
				self.goal = self.home + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			end
			self.patrolStart = now
			self:_setState("patrol")
		end
	elseif self.State == "patrol" then
		if not self.goal or self:_moveTo(self.goal, false) or now - (self.patrolStart or now) > 12 then
			self:_setState("idle")
			self.idleUntil = now + self.rng:NextNumber(self.idleTime[1], self.idleTime[2])
		end
	end
end

function Enemy:destroy()
	if self.State ~= "dead" then
		self.State = "dead"
	end
	self.maid:Clean()
	if self.model.Parent then
		self.model:Destroy()
	end
end
Enemy.Destroy = Enemy.destroy

----------------------------------------------------------------------------------------------------------------
-- Spawner with waves. State folder "Waves": Wave, Waves, Alive, Remaining, Status ("Idle"|"Spawning"|"Fighting"|
-- "Break"|"Cleared")
----------------------------------------------------------------------------------------------------------------
local Spawner = {}
Spawner.__index = Spawner
AI.Spawner = Spawner
-- Spawner.new({points={Vector3|CFrame|BasePart...} | region={center, size}, waves={ {count=4, interval=0.6,
--   enemy={...Enemy opts}}, ... } | nil (generated: waveCount=3, baseCount=3, growth=2), enemy={...} (defaults for
--   every wave), between=5 (s break between waves), maxAlive=20, autoStart=false, loop=false,
--   onWave=fn(i), onCleared=fn(i), onAllCleared=fn()})
function Spawner.new(opts)
	opts = opts or {}
	local self = setmetatable({
		opts = opts,
		points = opts.points,
		alive = {},
		Wave = 0,
		WaveStarted = Signal.new(), -- (i)
		WaveCleared = Signal.new(), -- (i)
		AllCleared = Signal.new(),
		Spawned = Signal.new(), -- (enemy)
		maid = Maid.new(),
		state = Core.state("Waves"),
	}, Spawner)
	local waves = opts.waves
	if not waves then
		waves = {}
		for i = 1, opts.waveCount or 3 do
			table.insert(waves, { count = (opts.baseCount or 3) + (i - 1) * (opts.growth or 2) })
		end
	end
	self.waves = waves
	if opts.onWave then
		self.WaveStarted:Connect(opts.onWave)
	end
	if opts.onCleared then
		self.WaveCleared:Connect(opts.onCleared)
	end
	if opts.onAllCleared then
		self.AllCleared:Connect(opts.onAllCleared)
	end
	self:_sync("Idle")
	if opts.autoStart then
		self:start()
	end
	return self
end

function Spawner:_sync(status)
	if status then
		self.status = status
	end
	local n = 0
	for _ in pairs(self.alive) do
		n += 1
	end
	self.aliveCount = n
	if self.state then
		self.state:SetAttribute("Wave", self.Wave)
		self.state:SetAttribute("Waves", #self.waves)
		self.state:SetAttribute("Alive", n)
		self.state:SetAttribute("Status", self.status)
	end
end

function Spawner:_point(i)
	local pts = self.points
	if pts and #pts > 0 then
		local p = Core.position(pts[(i - 1) % #pts + 1])
		return p + Vector3.new(math.random() * 4 - 2, 0, math.random() * 4 - 2)
	end
	local r = self.opts.region or {}
	local c, s = r.center or Vector3.new(0, 4, 0), r.size or Vector3.new(40, 0, 40)
	return c + Vector3.new((math.random() - 0.5) * s.X, 0, (math.random() - 0.5) * s.Z)
end

-- sp:spawn(enemyOpts?, position?) -> enemy
function Spawner:spawn(eopts, position)
	local o = table.clone(self.opts.enemy or {})
	for k, v in pairs(eopts or {}) do
		o[k] = v
	end
	o.position = position or o.position or self:_point(math.random(1, 64))
	local e = Enemy.new(o)
	self.alive[e] = true
	e.Died:Connect(function()
		self.alive[e] = nil
		self:_sync()
		if self.status == "Fighting" and self.aliveCount == 0 and self._clear then
			self._clear()
		end
	end)
	self.maid:Give(e)
	self:_sync()
	self.Spawned:Fire(e)
	return e
end

function Spawner:start()
	if self.thread then
		return
	end
	self.thread = task.spawn(function()
		repeat
			for i, w in ipairs(self.waves) do
				self.Wave = i
				self:_sync("Spawning")
				self.WaveStarted:Fire(i)
				for k = 1, w.count or 3 do
					while self.aliveCount >= (self.opts.maxAlive or 20) do
						task.wait(0.5)
					end
					self:spawn(w.enemy, self:_point(k))
					task.wait(w.interval or 0.6)
				end
				self:_sync("Fighting")
				if self.aliveCount > 0 then
					local th = coroutine.running()
					self._clear = function()
						self._clear = nil
						task.spawn(th)
					end
					coroutine.yield()
				end
				self.WaveCleared:Fire(i)
				if i < #self.waves then
					self:_sync("Break")
					task.wait(self.opts.between or 5)
				end
			end
			self:_sync("Cleared")
			self.AllCleared:Fire()
		until not self.opts.loop
		self.thread = nil
	end)
end

function Spawner:stop()
	if self.thread then
		pcall(task.cancel, self.thread)
		self.thread = nil
	end
	self._clear = nil
	self.maid:Clean()
	table.clear(self.alive)
	self:_sync("Idle")
end
Spawner.destroy = Spawner.stop
Spawner.Destroy = Spawner.stop

return AI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">GameplayKit_Combat</string>
          <string name="Source"><![CDATA[--!nonstrict
-- GameplayKit_Combat: health & damage, teams, checkpoints / respawn / fall death, knockback, weapons with server
-- hit validation (hitscan, projectile, melee hitboxes). Server-authoritative; use through GameplayKit.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TeamsService = game:GetService("Teams")
local Debris = game:GetService("Debris")

local Core = require((script.Parent :: Instance):WaitForChild("GameplayKit_Core"))
local Maid = require((script.Parent :: Instance):WaitForChild("Maid"))
local Signal = Core.Signal

local Combat = {}

----------------------------------------------------------------------------------------------------------------
-- Teams. Players use the Teams service; NPC models carry a "Team" attribute.
----------------------------------------------------------------------------------------------------------------
local function teamOf(x)
	if typeof(x) ~= "Instance" then
		return nil
	end
	if x:IsA("Player") then
		return x:GetAttribute("Team") or (x.Team and x.Team.Name)
	end
	local p = Core.playerOf(x)
	if p then
		return p:GetAttribute("Team") or (p.Team and p.Team.Name)
	end
	local m = Core.modelOf(x) or x
	return m:GetAttribute("Team")
end
Combat.teamOf = teamOf

local function sameTeam(a, b)
	local ta, tb = teamOf(a), teamOf(b)
	return ta ~= nil and ta == tb
end
Combat.sameTeam = sameTeam

local Teams = {}
Teams.__index = Teams
-- Teams.new({teams={{name="Red", color=BrickColor.new("Bright red")}, ...}, autoAssign=true, balance=true,
--            friendlyFire=false})
function Teams.new(opts)
	opts = opts or {}
	local self = setmetatable({ maid = Maid.new(), byName = {}, Changed = Signal.new() }, Teams)
	self.friendlyFire = Core.opt(opts, "friendlyFire", false)
	Combat.friendlyFire = self.friendlyFire
	local defs = opts.teams or { { name = "Red", color = BrickColor.new("Bright red") }, { name = "Blue", color = BrickColor.new("Bright blue") } }
	for _, d in ipairs(defs) do
		local t = TeamsService:FindFirstChild(d.name)
		if not t then
			t = Instance.new("Team")
			t.Name = d.name
			t.TeamColor = typeof(d.color) == "BrickColor" and d.color or BrickColor.random()
			t.AutoAssignable = false
			t.Parent = TeamsService
			self.maid:Give(t)
		end
		self.byName[d.name] = t
		table.insert(self, t)
	end
	if Core.opt(opts, "autoAssign", true) then
		local function assign(p)
			if not p:GetAttribute("Team") then
				self:assign(p, nil)
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			assign(p)
		end
		self.maid:Give(Players.PlayerAdded:Connect(assign))
	end
	return self
end
-- t:assign(player, name?) (nil = smallest team)
function Teams:assign(player, name)
	local team = name and self.byName[name]
	if not team then
		local best, n = nil, math.huge
		for _, t in ipairs(self) do
			local c = #t:GetPlayers()
			if c < n then
				best, n = t, c
			end
		end
		team = best
	end
	if team then
		player.Team = team
		player.Neutral = false
		player:SetAttribute("Team", team.Name)
		self.Changed:Fire(player, team.Name)
	end
	return team and team.Name
end
function Teams:of(x)
	return teamOf(x)
end
function Teams:sameTeam(a, b)
	return sameTeam(a, b)
end
function Teams:members(name)
	local t = self.byName[name]
	return t and t:GetPlayers() or {}
end
function Teams:destroy()
	self.maid:Clean()
end
Combat.Teams = Teams

----------------------------------------------------------------------------------------------------------------
-- Health. Wraps a Humanoid (Humanoid.Health) or gives any Model/Part custom HP (attributes HP / MaxHP).
-- The target always carries attributes HP, MaxHP (and Invulnerable while i-framed) so any UI can read them.
----------------------------------------------------------------------------------------------------------------
local registry = setmetatable({}, { __mode = "k" })

local Health = {}
Health.__index = Health

-- Health.new(target, {max=100, regen=0 (hp/s), regenDelay=3, invuln=0.4 (s of i-frames after a hit),
--   destroyOnDeath=false (custom-HP targets) | seconds, team=nil, onDeath=fn(source), onDamage=fn(amount, source)})
function Health.new(target, opts)
	opts = opts or {}
	if registry[target] then
		return registry[target]
	end
	local self = setmetatable({
		target = target,
		humanoid = target:IsA("Model") and target:FindFirstChildOfClass("Humanoid") or nil,
		Max = opts.max or 100,
		invuln = Core.opt(opts, "invuln", 0.4),
		regen = opts.regen or 0,
		regenDelay = opts.regenDelay or 3,
		destroyOnDeath = opts.destroyOnDeath,
		lastHit = 0,
		iUntil = 0,
		dead = false,
		Changed = Signal.new(), -- (hp, max)
		Damaged = Signal.new(), -- (amount, source, hitPosition?)
		Died = Signal.new(), -- (source)
		maid = Maid.new(),
	}, Health)
	registry[target] = self
	if opts.team then
		target:SetAttribute("Team", opts.team)
	end
	if self.humanoid then
		local h = self.humanoid
		if opts.max then -- explicit max resets the humanoid; wrapping an existing one keeps its current health
			h.MaxHealth = opts.max
			h.Health = opts.max
		end
		self.Max = h.MaxHealth
		self.maid:Give(h.HealthChanged:Connect(function(hp)
			target:SetAttribute("HP", hp)
			self.Changed:Fire(hp, self.Max)
			if hp <= 0 and not self.dead then
				self:_die(self.lastSource)
			end
		end))
	end
	target:SetAttribute("MaxHP", self.Max)
	target:SetAttribute("HP", self.humanoid and self.humanoid.Health or self.Max)
	if opts.onDeath then
		self.Died:Connect(opts.onDeath)
	end
	if opts.onDamage then
		self.Damaged:Connect(opts.onDamage)
	end
	if self.regen > 0 then
		self.maid:Give(Core.every(0.5, function(dt)
			if not self.dead and os.clock() - self.lastHit > self.regenDelay and self:get() < self.Max then
				self:heal(self.regen * dt)
			end
			return target.Parent ~= nil
		end))
	end
	self.maid:Give(target.AncestryChanged:Connect(function(_, parent)
		if not parent then
			self:destroy()
		end
	end))
	return self
end

function Health:get()
	if self.humanoid then
		return self.humanoid.Health
	end
	return self.target:GetAttribute("HP") or 0
end

function Health:_set(hp)
	hp = math.clamp(hp, 0, self.Max)
	if self.humanoid then
		self.humanoid.Health = hp -- HealthChanged mirrors the attribute + fires Changed
	else
		self.target:SetAttribute("HP", hp)
		self.Changed:Fire(hp, self.Max)
		if hp <= 0 and not self.dead then
			self:_die(self.lastSource)
		end
	end
end

function Health:isInvulnerable()
	if os.clock() < self.iUntil then
		return true
	end
	return self.target:FindFirstChildOfClass("ForceField") ~= nil or self.target:GetAttribute("God") == true
end

-- h:damage(amount, source?, {ignoreInvuln, knockback=Vector3, hitPosition}) -> applied amount
local function applyDamage(self, amount, source, o)
	o = o or {}
	if self.dead or amount <= 0 then
		return 0
	end
	if not o.ignoreInvuln and self:isInvulnerable() then
		return 0
	end
	if source and not Combat.friendlyFire and source ~= self.target and sameTeam(source, self.target) then
		return 0
	end
	local before = self:get()
	self.lastSource = source
	self.lastHit = os.clock()
	if self.invuln > 0 then
		self.iUntil = os.clock() + self.invuln
		self.target:SetAttribute("Invulnerable", true)
		task.delay(self.invuln, function()
			if os.clock() >= self.iUntil and self.target.Parent then
				self.target:SetAttribute("Invulnerable", nil)
			end
		end)
	end
	self:_set(before - amount)
	local applied = before - self:get()
	self.Damaged:Fire(applied, source, o.hitPosition)
	if o.knockback then
		Combat.knockback(self.target, o.knockback)
	end
	return applied
end

function Health:heal(amount)
	if not self.dead then
		self:_set(self:get() + amount)
	end
end

function Health:revive(hp)
	self.dead = false
	self:_set(hp or self.Max)
end

function Health:kill(source)
	self.lastSource = source
	self:_set(0)
end

function Health:_die(source)
	self.dead = true
	self.target:SetAttribute("Dead", true)
	self.Died:Fire(source)
	local d = self.destroyOnDeath
	if d and not self.humanoid then
		task.delay(type(d) == "number" and d or 0, function()
			if self.target.Parent then
				self.target:Destroy()
			end
		end)
	end
end

function Health:destroy()
	registry[self.target] = nil
	self.maid:Clean()
end

-- Health.of(partOrModel) -> health component (auto-wraps any Humanoid it finds), or nil
function Health.of(inst)
	if not inst then
		return nil
	end
	local m = Core.modelOf(inst)
	if not m then
		return nil
	end
	local h = registry[m]
	if h then
		return h
	end
	local hum = m:IsA("Model") and m:FindFirstChildOfClass("Humanoid")
	if hum then
		return Health.new(m, {})
	end
	return nil
end

-- Health.damage(partOrModel, amount, source?, opts?) -> applied amount (0 if not damageable). Also h:damage(...).
function Health.damage(inst, amount, source, o)
	if getmetatable(inst) == Health then
		return applyDamage(inst, amount, source, o)
	end
	local h = Health.of(inst)
	return h and applyDamage(h, amount, source, o) or 0
end

-- Health.players({max=100, regen=0, invuln=1, ...}) -> wraps every player's character on spawn
function Health.players(opts)
	local maid = Maid.new()
	local function wrap(ch)
		ch:WaitForChild("Humanoid", 10)
		if ch.Parent then
			local o = table.clone(opts or {})
			o.invuln = Core.opt(opts, "invuln", 1)
			Health.new(ch, o)
		end
	end
	local function hook(p)
		if p.Character then
			task.spawn(wrap, p.Character)
		end
		maid:Give(p.CharacterAdded:Connect(wrap))
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	maid:Give(Players.PlayerAdded:Connect(hook))
	return maid
end
Combat.Health = Health

----------------------------------------------------------------------------------------------------------------
-- Knockback. NPCs (server-owned) get velocity directly; player characters are client-owned, so the push is sent
-- to that client (GameplayKit.startClient applies it).
----------------------------------------------------------------------------------------------------------------
local knockRemote = Core.isServer and Core.remote("Knockback") or nil
-- Combat.knockback(target, velocity: Vector3, upward=0.35)  velocity in studs/s; upward adds a hop
function Combat.knockback(target, velocity, upward)
	local m = Core.modelOf(target) or target
	local root = Core.root(m)
	if not root or typeof(velocity) ~= "Vector3" then
		return
	end
	local v = velocity + Vector3.new(0, velocity.Magnitude * (upward or 0.35), 0)
	local player = m:IsA("Model") and Players:GetPlayerFromCharacter(m)
	if player and knockRemote then
		knockRemote:FireClient(player, v)
	elseif not root.Anchored then
		root.AssemblyLinearVelocity += v
		local hum = Core.humanoid(m)
		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Freefall)
		end
	end
end

----------------------------------------------------------------------------------------------------------------
-- Spatial hit queries
----------------------------------------------------------------------------------------------------------------
-- Combat.hitscan(origin, direction (unit or scaled), range=300, ignore={instances}) -> RaycastResult?
function Combat.hitscan(origin, direction, range, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or {}
	params.IgnoreWater = true
	return Workspace:Raycast(origin, direction.Unit * (range or 300), params)
end

-- Combat.hitbox(cframe, size, ignore) -> { model } : damageable models whose parts overlap the box (each once)
function Combat.hitbox(cframe, size, ignore)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or {}
	local seen, out = {}, {}
	for _, part in ipairs(Workspace:GetPartBoundsInBox(cframe, size, params)) do
		local m = Core.modelOf(part)
		if m and not seen[m] then
			seen[m] = true
			table.insert(out, m)
		end
	end
	return out
end

-- Combat.sphere(position, radius, ignore) -> { model }
function Combat.sphere(position, radius, ignore)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or {}
	local seen, out = {}, {}
	for _, part in ipairs(Workspace:GetPartBoundsInRadius(position, radius, params)) do
		local m = Core.modelOf(part)
		if m and not seen[m] then
			seen[m] = true
			table.insert(out, m)
		end
	end
	return out
end

----------------------------------------------------------------------------------------------------------------
-- Weapons. Server: Weapon.new(name, opts). Client: GameplayKit.Weapon.client(name) -> w:fire(direction?) / w:fire()
-- The client only sends an aim direction; the server re-derives the origin from the character, enforces the
-- cooldown, range and line of sight, and applies damage. NPCs fire with w:fireFrom(model, direction).
----------------------------------------------------------------------------------------------------------------
local projectiles = {}
local projectileConn

local function stepProjectiles(dt)
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		pr.age += dt
		local step = pr.velocity * dt
		local hit = Combat.hitscan(pr.position, step, step.Magnitude + pr.radius, pr.ignore)
		local done = pr.age > pr.lifetime
		if hit then
			pr.weapon:_impact(pr.owner, hit.Instance, hit.Position, pr.velocity.Unit)
			done = true
		else
			pr.position += step
			pr.velocity += Vector3.new(0, -Workspace.Gravity * pr.gravity * dt, 0)
			if pr.visual then
				pr.visual.CFrame = CFrame.lookAt(pr.position, pr.position + pr.velocity)
			end
		end
		if done then
			if pr.visual then
				pr.visual:Destroy()
			end
			table.remove(projectiles, i)
		end
	end
	if #projectiles == 0 and projectileConn then
		projectileConn:Disconnect()
		projectileConn = nil
	end
end

local Weapon = {}
Weapon.__index = Weapon
-- Weapon.new(name, {kind="hitscan"|"projectile"|"melee", damage=20, cooldown=0.25, range=300 (melee: 7),
--   speed=150 (projectile studs/s), gravity=0 (fraction of Workspace.Gravity), radius=0.5, lifetime=3,
--   arc=Vector3.new(6,6,7) (melee box size), headshot=1.5, knockback=0 (studs/s), friendlyFire=false,
--   color="#FFD45A", tracer=true, serverOnly=false (true: NPC-only, no client remote), onHit=fn(attacker, targetModel, damage, position), onFire=fn(attacker, origin, dir)})
function Weapon.new(name, opts)
	opts = opts or {}
	local kind = opts.kind or "hitscan"
	local self = setmetatable({
		name = name or "Weapon",
		kind = kind,
		damage = opts.damage or 20,
		cooldown = opts.cooldown or (kind == "melee" and 0.5 or 0.25),
		range = opts.range or (kind == "melee" and 7 or 300),
		speed = opts.speed or 150,
		gravity = opts.gravity or 0,
		radius = opts.radius or 0.5,
		lifetime = opts.lifetime or 3,
		arc = opts.arc or Vector3.new(6, 6, 7),
		headshot = opts.headshot or 1.5,
		knockback = opts.knockback or 0,
		friendlyFire = Core.opt(opts, "friendlyFire", false),
		color = Core.color(opts.color, Color3.fromRGB(255, 212, 90)),
		tracer = Core.opt(opts, "tracer", true),
		onHit = opts.onHit,
		onFire = opts.onFire,
		last = setmetatable({}, { __mode = "k" }),
		Hit = Signal.new(), -- (attacker, targetModel, damage, position)
		Fired = Signal.new(), -- (attacker, origin, direction)
		maid = Maid.new(),
	}, Weapon)
	if Core.isServer and not opts.serverOnly then -- serverOnly: NPC weapons that no client may trigger
		local remote = Core.remote("Weapon_" .. self.name)
		self.maid:Give(remote.OnServerEvent:Connect(function(player, direction)
			local ch = Core.character(player)
			if not ch then
				return
			end
			if typeof(direction) ~= "Vector3" or direction.Magnitude < 1e-3 or direction.Magnitude ~= direction.Magnitude then
				direction = nil
			end
			self:fireFrom(ch, direction)
		end))
	end
	return self
end

-- origin for a shooter model: its head (or root) position
local function muzzle(model)
	local head = model:FindFirstChild("Head")
	local root = Core.root(model)
	local src = (head and head:IsA("BasePart") and head) or root
	return src and src.Position
end

-- w:fireFrom(model, direction?) -> bool  (server; direction defaults to the model's look vector)
function Weapon:fireFrom(model, direction)
	local root = Core.root(model)
	if not root then
		return false
	end
	local now = os.clock()
	local last = self.last[model] or 0
	if now - last < self.cooldown * 0.85 then -- small tolerance for network jitter
		return false
	end
	self.last[model] = now
	direction = (direction or root.CFrame.LookVector).Unit
	local origin = muzzle(model)
	self.Fired:Fire(model, origin, direction)
	if self.onFire then
		task.spawn(self.onFire, model, origin, direction)
	end
	if self.kind == "melee" then
		local flat = Vector3.new(direction.X, 0, direction.Z)
		flat = flat.Magnitude > 1e-3 and flat.Unit or root.CFrame.LookVector
		local cf = CFrame.lookAt(root.Position, root.Position + flat) * CFrame.new(0, 0, -self.arc.Z / 2)
		for _, m in ipairs(Combat.hitbox(cf, self.arc, { model })) do
			local r = Core.root(m)
			self:_apply(model, m, self.damage, r and r.Position or cf.Position, flat)
		end
	elseif self.kind == "projectile" then
		local visual = Core.part({
			Name = self.name .. "Projectile",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * math.max(0.4, self.radius * 2),
			Color = self.color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CFrame = CFrame.new(origin),
			Parent = Core.folder("GameplayKitFX"),
		})
		table.insert(projectiles, {
			weapon = self, owner = model, position = origin, velocity = direction * self.speed, gravity = self.gravity,
			radius = self.radius, lifetime = self.lifetime, age = 0, ignore = { model, Core.folder("GameplayKitFX") }, visual = visual,
		})
		if not projectileConn then
			projectileConn = RunService.Heartbeat:Connect(stepProjectiles)
		end
	else
		local hit = Combat.hitscan(origin, direction, self.range, { model, Core.folder("GameplayKitFX") })
		local finish = hit and hit.Position or origin + direction * self.range
		if self.tracer then
			local len = (finish - origin).Magnitude
			local t = Core.part({
				Name = "Tracer", Size = Vector3.new(0.12, 0.12, len), Color = self.color, Material = Enum.Material.Neon,
				CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 0.2,
				CFrame = CFrame.lookAt(origin, finish) * CFrame.new(0, 0, -len / 2), Parent = Core.folder("GameplayKitFX"),
			})
			Debris:AddItem(t, 0.06)
		end
		if hit then
			self:_impact(model, hit.Instance, hit.Position, direction)
		end
	end
	return true
end

function Weapon:_impact(attacker, part, position, direction)
	local m = Core.modelOf(part)
	if not m then
		return
	end
	local dmg = self.damage
	if part.Name == "Head" then
		dmg *= self.headshot
	end
	self:_apply(attacker, m, dmg, position, direction)
end

function Weapon:_apply(attacker, target, dmg, position, direction)
	if target == attacker then
		return
	end
	if not self.friendlyFire and sameTeam(attacker, target) then
		return
	end
	local kb = self.knockback > 0 and direction and Vector3.new(direction.X, 0, direction.Z).Unit * self.knockback or nil
	local applied = Health.damage(target, dmg, attacker, { knockback = kb, hitPosition = position })
	if applied > 0 then
		self.Hit:Fire(attacker, target, applied, position)
		if self.onHit then
			task.spawn(self.onHit, attacker, target, applied, position)
		end
	end
end

function Weapon:destroy()
	self.maid:Clean()
end

-- Client counterpart: Weapon.client(name) -> {fire = fn(direction?)}; direction defaults to the camera aim.
function Weapon.client(name)
	local remote = Core.remote("Weapon_" .. (name or "Weapon"))
	local w = {}
	function w.fire(a, b) -- w.fire(dir) or w:fire(dir)
		local direction = if a == w then b else a
		if not remote then
			return
		end
		if typeof(direction) ~= "Vector3" then
			local cam = Workspace.CurrentCamera
			direction = cam and cam.CFrame.LookVector or nil
		end
		remote:FireServer(direction)
	end
	return w
end
Combat.Weapon = Weapon

----------------------------------------------------------------------------------------------------------------
-- Checkpoints / respawn / fall death (obby, platformer). Touch a checkpoint part to set it; falling below
-- fallY (or dying) respawns at the last one. Player attribute "Checkpoint" = index (0 = start).
----------------------------------------------------------------------------------------------------------------
local Checkpoints = {}
Checkpoints.__index = Checkpoints
-- Checkpoints.new({parts = {BasePart} | Folder (sorted by name number), start = CFrame|part? (defaults to spawn),
--   fallY = -30 (kill plane Y; nil disables), forwardOnly = true, respawnDelay = nil (Players.RespawnTime),
--   color = "#5AE38C" (reached colour), onReached = fn(player, index)})
function Checkpoints.new(opts)
	opts = opts or {}
	local self = setmetatable({
		parts = Core.list(opts.parts or Workspace:FindFirstChild("Checkpoints"), "BasePart"),
		start = opts.start,
		fallY = Core.opt(opts, "fallY", -30),
		forwardOnly = Core.opt(opts, "forwardOnly", true),
		reachedColor = Core.color(opts.color, Color3.fromRGB(90, 227, 140)),
		index = setmetatable({}, { __mode = "k" }),
		Reached = Signal.new(), -- (player, index)
		maid = Maid.new(),
	}, Checkpoints)
	if opts.onReached then
		self.Reached:Connect(opts.onReached)
	end
	if opts.respawnDelay then
		Players.RespawnTime = opts.respawnDelay
	end
	for i, part in ipairs(self.parts) do
		part:SetAttribute("CheckpointIndex", i)
		self.maid:Give(part.Touched:Connect(function(hit)
			local p = Core.playerOf(hit)
			if p and Core.character(p) then
				self:set(p, i)
			end
		end))
	end
	local function onChar(p, ch)
		local i = self.index[p] or 0
		if i <= 0 and not self.start then
			return
		end
		local root = ch:WaitForChild("HumanoidRootPart", 10)
		if not root then
			return
		end
		task.delay(0.05, function() -- after the engine's own spawn placement
			if ch.Parent then
				ch:PivotTo(self:spawnCFrame(p))
			end
		end)
	end
	local function hook(p)
		p:SetAttribute("Checkpoint", self.index[p] or 0)
		self.maid:Give(p.CharacterAdded:Connect(function(ch)
			onChar(p, ch)
		end))
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	self.maid:Give(Players.PlayerAdded:Connect(hook))
	if self.fallY then
		self.maid:Give(Core.every(0.2, function()
			for _, e in ipairs(Core.alivePlayers()) do
				if e.root.Position.Y < self.fallY then
					self:respawn(e.player)
				end
			end
		end))
	end
	return self
end

function Checkpoints:get(player)
	return self.index[player] or 0
end

-- c:set(player, index) (forwardOnly ignores going back)
function Checkpoints:set(player, i)
	local cur = self.index[player] or 0
	if i == cur or (self.forwardOnly and i < cur) then
		return
	end
	self.index[player] = i
	player:SetAttribute("Checkpoint", i)
	local part = self.parts[i]
	if part then
		part.Color = self.reachedColor
	end
	self.Reached:Fire(player, i)
end

function Checkpoints:spawnCFrame(player)
	local i = self.index[player] or 0
	local part = self.parts[i]
	local base = part and part.CFrame or Core.cframe(self.start)
	if not base then
		local sp = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
		base = sp and sp.CFrame or CFrame.new(0, 5, 0)
	end
	local up = part and part.Size.Y / 2 or 0
	return CFrame.new(base.Position + Vector3.new(0, up + 3.5, 0)) * (base - base.Position)
end

-- c:respawn(player): instant teleport to the last checkpoint (no death), with i-frames if Health is used
function Checkpoints:respawn(player)
	local ch, root = Core.character(player)
	if not ch then
		return
	end
	root.AssemblyLinearVelocity = Vector3.zero
	ch:PivotTo(self:spawnCFrame(player))
	local h = Health.of(ch)
	if h then
		h.iUntil = os.clock() + 1
	end
end

function Checkpoints:reset(player)
	self.index[player] = 0
	player:SetAttribute("Checkpoint", 0)
end

function Checkpoints:destroy()
	self.maid:Clean()
end
Combat.Checkpoints = Checkpoints

-- Maid-friendly aliases (maid:Give(obj) calls obj:Destroy())
Teams.Destroy = Teams.destroy
Health.Destroy = Health.destroy
Weapon.Destroy = Weapon.destroy
Checkpoints.Destroy = Checkpoints.destroy

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">GameplayKit_Core</string>
          <string name="Source"><![CDATA[--!nonstrict
-- GameplayKit_Core: shared plumbing for every GameplayKit system (signals, internal remotes, replicated state
-- folders, rate limits, character lookups, part building). Games use it through GameplayKit; you rarely need it.
--
-- Replication model (the same for every system):
--   * Server systems write ATTRIBUTES on ReplicatedStorage.GameplayKitState.<System> (whole-game state) or on the
--     Player / the model (per-player / per-object state). Clients read them with GameplayKit.watch / :GetAttribute.
--   * Client -> server requests go through RemoteEvents the kit creates itself in ReplicatedStorage.GameplayKitRemotes.
--     The game never creates or wires a remote for a kit system.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local Core = {}
Core.isServer = RunService:IsServer()
Core.isClient = RunService:IsClient()

----------------------------------------------------------------------------------------------------------------
-- Signal: s:Connect(fn) -> conn (conn:Disconnect(); Maid-friendly), s:Once(fn), s:Wait(), s:Fire(...)
-- Handlers run in their own thread (task.spawn), so one erroring handler never breaks the others or the caller.
----------------------------------------------------------------------------------------------------------------
local Connection = {}
Connection.__index = Connection
function Connection:Disconnect()
	if self.Connected then
		self.Connected = false
		self._signal._handlers[self] = nil
	end
end
Connection.Destroy = Connection.Disconnect

local Signal = {}
Signal.__index = Signal
function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end
function Signal:Connect(fn)
	local c = setmetatable({ Connected = true, _signal = self, _fn = fn }, Connection)
	self._handlers[c] = true
	return c
end
function Signal:Once(fn)
	local c
	c = self:Connect(function(...)
		c:Disconnect()
		fn(...)
	end)
	return c
end
function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end
function Signal:Fire(...)
	for c in pairs(table.clone(self._handlers)) do
		if c.Connected then
			task.spawn(c._fn, ...)
		end
	end
end
function Signal:DisconnectAll()
	for c in pairs(self._handlers) do
		c.Connected = false
	end
	table.clear(self._handlers)
end
Signal.Destroy = Signal.DisconnectAll
Core.Signal = Signal

----------------------------------------------------------------------------------------------------------------
-- Remotes and replicated state folders (created by the server, waited for by clients; nil-safe on timeout)
----------------------------------------------------------------------------------------------------------------
local function rootFolder(name)
	local f = ReplicatedStorage:FindFirstChild(name)
	if f then
		return f
	end
	if Core.isServer then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = ReplicatedStorage
		return f
	end
	return ReplicatedStorage:WaitForChild(name, 15)
end

-- Core.remote(name) -> RemoteEvent? (server creates; client waits up to 15 s)
function Core.remote(name)
	local folder = rootFolder("GameplayKitRemotes")
	if not folder then
		return nil
	end
	local r = folder:FindFirstChild(name)
	if r then
		return r
	end
	if Core.isServer then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
		return r
	end
	return folder:WaitForChild(name, 15)
end

-- Core.state(name) -> Folder? whose attributes hold a system's replicated state
function Core.state(name)
	local folder = rootFolder("GameplayKitState")
	if not folder then
		return nil
	end
	local s = folder:FindFirstChild(name)
	if s then
		return s
	end
	if Core.isServer then
		s = Instance.new("Folder")
		s.Name = name
		s.Parent = folder
		return s
	end
	return folder:WaitForChild(name, 15)
end

-- Core.watch(system, attr, fn) -> conn: fn(value) now (if set) and on every change. Server or client.
function Core.watch(system, attr, fn)
	local handle = { Connected = true }
	local inner
	function handle:Disconnect()
		self.Connected = false
		if inner then
			inner:Disconnect()
		end
	end
	handle.Destroy = handle.Disconnect
	task.spawn(function()
		local folder = Core.state(system)
		if not folder or not handle.Connected then
			return
		end
		inner = folder:GetAttributeChangedSignal(attr):Connect(function()
			fn(folder:GetAttribute(attr))
		end)
		local v = folder:GetAttribute(attr)
		if v ~= nil then
			fn(v)
		end
	end)
	return handle
end

function Core.get(system, attr)
	local folder = ReplicatedStorage:FindFirstChild("GameplayKitState")
	folder = folder and folder:FindFirstChild(system)
	return folder and folder:GetAttribute(attr)
end

function Core.encode(t)
	local ok, s = pcall(HttpService.JSONEncode, HttpService, t)
	return ok and s or "[]"
end
function Core.decode(s)
	if type(s) ~= "string" or s == "" then
		return nil
	end
	local ok, t = pcall(HttpService.JSONDecode, HttpService, s)
	return ok and t or nil
end

----------------------------------------------------------------------------------------------------------------
-- Anti-exploit: token-bucket rate limiter. Core.limiter(perSecond=10, burst=perSecond) -> allow(player, key?) -> bool
----------------------------------------------------------------------------------------------------------------
function Core.limiter(perSecond, burst)
	perSecond = perSecond or 10
	burst = burst or perSecond
	local buckets = setmetatable({}, { __mode = "k" })
	return function(player, key)
		local per = buckets[player]
		if not per then
			per = {}
			buckets[player] = per
		end
		key = key or "_"
		local now = os.clock()
		local b = per[key]
		if not b then
			b = { tokens = burst, t = now }
			per[key] = b
		end
		b.tokens = math.min(burst, b.tokens + (now - b.t) * perSecond)
		b.t = now
		if b.tokens >= 1 then
			b.tokens -= 1
			return true
		end
		return false
	end
end

----------------------------------------------------------------------------------------------------------------
-- Characters and models
----------------------------------------------------------------------------------------------------------------
function Core.root(model)
	if not model then
		return nil
	end
	if model:IsA("BasePart") then
		return model
	end
	if not model:IsA("Model") then
		return nil
	end
	return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

function Core.humanoid(model)
	return model and model:FindFirstChildOfClass("Humanoid")
end

-- Core.character(player) -> (character, root, humanoid) only while alive, else nil
function Core.character(player)
	local ch = player and player.Character
	if not ch or not ch.Parent then
		return nil
	end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	local root = ch:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return nil
	end
	return ch, root, hum
end

-- Core.alivePlayers() -> { {player, character, root, humanoid} }
function Core.alivePlayers()
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local ch, root, hum = Core.character(p)
		if ch then
			table.insert(out, { player = p, character = ch, root = root, humanoid = hum })
		end
	end
	return out
end

-- Core.modelOf(part) -> the Model that owns health for this part (has a Humanoid or an "MaxHP" attribute), or nil
function Core.modelOf(inst)
	local cur = inst
	while cur and cur ~= Workspace and cur ~= game do
		if cur:IsA("Model") and (cur:FindFirstChildOfClass("Humanoid") or cur:GetAttribute("MaxHP") ~= nil) then
			return cur
		end
		if cur:IsA("BasePart") and cur:GetAttribute("MaxHP") ~= nil then
			return cur
		end
		cur = cur.Parent
	end
	return nil
end

function Core.playerOf(inst)
	local m = inst and (Core.modelOf(inst) or inst)
	if m and m:IsA("Model") then
		return Players:GetPlayerFromCharacter(m)
	end
	return nil
end

function Core.position(x)
	local t = typeof(x)
	if t == "Vector3" then
		return x
	elseif t == "CFrame" then
		return x.Position
	elseif t == "Instance" then
		if x:IsA("BasePart") then
			return x.Position
		elseif x:IsA("Model") then
			return x:GetPivot().Position
		elseif x:IsA("Attachment") then
			return x.WorldPosition
		end
	end
	return nil
end

function Core.cframe(x)
	local t = typeof(x)
	if t == "CFrame" then
		return x
	elseif t == "Vector3" then
		return CFrame.new(x)
	elseif t == "Instance" then
		if x:IsA("BasePart") then
			return x.CFrame
		elseif x:IsA("Model") then
			return x:GetPivot()
		end
	end
	return nil
end

-- Core.list(x) -> array of Instances/values: accepts an array, a Folder/Model (children sorted by name, numeric aware)
function Core.list(x, className)
	if type(x) == "table" then
		return x
	end
	if typeof(x) == "Instance" then
		local out = {}
		for _, c in ipairs(x:GetChildren()) do
			if not className or c:IsA(className) then
				table.insert(out, c)
			end
		end
		table.sort(out, function(a, b)
			local na, nb = tonumber(a.Name:match("%d+")), tonumber(b.Name:match("%d+"))
			if na and nb and na ~= nb then
				return na < nb
			end
			return a.Name < b.Name
		end)
		return out
	end
	return {}
end

function Core.color(v, fallback)
	if typeof(v) == "Color3" then
		return v
	end
	if typeof(v) == "BrickColor" then
		return v.Color
	end
	if type(v) == "string" then
		local ok, c = pcall(Color3.fromHex, v)
		if ok then
			return c
		end
	end
	return fallback
end

-- Core.part({...props}) -> anchored smooth Part (Shape is applied before Size, CFrame last)
function Core.part(props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = props.Anchored ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	for k, v in pairs(props) do
		if k ~= "ClassName" and k ~= "Parent" and k ~= "Shape" and k ~= "CFrame" and k ~= "Anchored" then
			if k == "Color" then
				v = Core.color(v, p.Color)
			end
			p[k] = v
		end
	end
	if props.CFrame then
		p.CFrame = props.CFrame
	end
	p.Parent = props.Parent
	return p
end

function Core.folder(name, parent)
	parent = parent or Workspace
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end

-- Core.every(seconds, fn) -> thread: runs fn(dt) every `seconds` until fn returns false or the thread is cancelled
function Core.every(seconds, fn)
	return task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(seconds)
			local now = os.clock()
			local ok, res = pcall(fn, now - last)
			last = now
			if not ok then
				warn("[GameplayKit] " .. tostring(res))
			elseif res == false then
				break
			end
		end
	end)
end

function Core.opt(opts, key, default)
	local v = opts and opts[key]
	if v == nil then
		return default
	end
	return v
end

return Core
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">GameplayKit_Items</string>
          <string name="Source"><![CDATA[--!nonstrict
-- GameplayKit_Items: collectibles, ProximityPrompt interactables, pick-up/carry/drop/throw, stations with timed
-- processes (cook: raw -> cooking -> done -> burnt), recipes, and a slot inventory. Server-authoritative.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

local Core = require((script.Parent :: Instance):WaitForChild("GameplayKit_Core"))
local Maid = require((script.Parent :: Instance):WaitForChild("Maid"))
local Signal = Core.Signal

local Items = {}

----------------------------------------------------------------------------------------------------------------
-- Collectibles
----------------------------------------------------------------------------------------------------------------
local function defaultCoin(color)
	local p = Core.part({
		Name = "Coin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, 2.2, 2.2), Color = color,
		Material = Enum.Material.Neon, CanCollide = false, CanQuery = false, CastShadow = false,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 8
	light.Brightness = 1.2
	light.Parent = p
	return p
end

local function placeItem(item, cf)
	if item:IsA("Model") then
		item:PivotTo(cf)
	else
		item.CFrame = cf
	end
end

local Collectibles = {}
Collectibles.__index = Collectibles
-- Collectibles.new({points={CFrame|Vector3|BasePart...} | region={center=Vector3, size=Vector3, count=10, seed},
--   template=BasePart|Model? (default: glowing coin), color="#FFD24A", value=1, stat="Coins" (player attribute +
--   leaderstat if score given), score=GameplayKit.Score obj?, radius=4 (pickup), magnet=0 (studs; >0 pulls items in),
--   respawn=nil|seconds, bob=true, spin=true, parent=Folder, onCollect=fn(player, value, total, item)})
-- Bob/spin run on clients (GameplayKit.startClient); collection is decided by the server only.
function Collectibles.new(opts)
	opts = opts or {}
	local self = setmetatable({
		value = opts.value or 1,
		stat = opts.stat or "Coins",
		score = opts.score,
		radius = opts.radius or 4,
		magnet = opts.magnet or 0,
		respawn = opts.respawn,
		color = Core.color(opts.color, Color3.fromRGB(255, 210, 74)),
		template = opts.template,
		bob = Core.opt(opts, "bob", true),
		spin = Core.opt(opts, "spin", true),
		parent = opts.parent or Core.folder("Collectibles"),
		items = {},
		counts = setmetatable({}, { __mode = "k" }),
		Collected = Signal.new(), -- (player, value, total, item)
		maid = Maid.new(),
	}, Collectibles)
	if opts.onCollect then
		self.Collected:Connect(opts.onCollect)
	end
	local points = opts.points or {}
	if opts.region then
		local r = Random.new(opts.region.seed or 7)
		local c, s = opts.region.center or Vector3.new(0, 3, 0), opts.region.size or Vector3.new(60, 0, 60)
		for _ = 1, opts.region.count or 10 do
			table.insert(points, c + Vector3.new(r:NextNumber(-0.5, 0.5) * s.X, r:NextNumber(-0.5, 0.5) * s.Y, r:NextNumber(-0.5, 0.5) * s.Z))
		end
	end
	for _, pt in ipairs(points) do
		local cf = Core.cframe(pt)
		if cf then
			self:spawnAt(cf)
		end
	end
	self.maid:Give(Core.every(0.1, function()
		self:_scan()
	end))
	return self
end

-- c:spawnAt(cframe) -> item
function Collectibles:spawnAt(cf)
	local item = self.template and self.template:Clone() or defaultCoin(self.color)
	for _, d in ipairs(item:IsA("Model") and item:GetDescendants() or { item }) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	placeItem(item, cf)
	item:SetAttribute("GKBase", cf)
	item:SetAttribute("GKBob", self.bob)
	item:SetAttribute("GKSpin", self.spin)
	item:SetAttribute("Value", self.value)
	CollectionService:AddTag(item, "GK_Collectible")
	item.Parent = self.parent
	self.items[item] = { cf = cf, active = true }
	self.maid:Give(item)
	return item
end

function Collectibles:_scan()
	local players = Core.alivePlayers()
	if #players == 0 then
		return
	end
	local reach = math.max(self.radius, self.magnet)
	for item, st in pairs(self.items) do
		if st.active then
			local pos = st.cf.Position
			for _, e in ipairs(players) do
				local d = (e.root.Position - pos).Magnitude
				if d <= reach then
					self:_collect(e.player, item, st, e.root, d > self.radius)
					break
				end
			end
		end
	end
end

function Collectibles:_collect(player, item, st, root, fly)
	st.active = false
	local total = (self.counts[player] or 0) + self.value
	self.counts[player] = total
	player:SetAttribute(self.stat, total)
	if self.score then
		self.score:add(player, self.value, self.stat)
	end
	self.Collected:Fire(player, self.value, total, item)
	local function hide()
		if not item.Parent then
			return
		end
		if self.respawn then
			item.Parent = nil
			task.delay(self.respawn, function()
				if self.items[item] then
					placeItem(item, st.cf)
					item.Parent = self.parent
					st.active = true
				end
			end)
		else
			self.items[item] = nil
			item:Destroy()
		end
	end
	if fly and item:IsA("BasePart") then
		local t = TweenService:Create(item, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = root.CFrame })
		t.Completed:Once(hide)
		t:Play()
	else
		hide()
	end
end

function Collectibles:count(player)
	return self.counts[player] or 0
end

function Collectibles:remaining()
	local n = 0
	for _, st in pairs(self.items) do
		if st.active then
			n += 1
		end
	end
	return n
end

function Collectibles:clear()
	self.maid:Clean()
	table.clear(self.items)
	self.maid:Give(Core.every(0.1, function()
		self:_scan()
	end))
end

function Collectibles:destroy()
	self.maid:Clean()
	table.clear(self.items)
end
Items.Collectibles = Collectibles

----------------------------------------------------------------------------------------------------------------
-- Interactables: ProximityPrompt wrapper with a server-side distance + rate check
----------------------------------------------------------------------------------------------------------------
-- Items.prompt(part, {action="Use", object=part.Name, hold=0, distance=10, key=Enum.KeyCode.E, cooldown=0.3,
--   lineOfSight=false, onUse=fn(player, part)}) -> h {prompt, Used: Signal(player, part), destroy()}
function Items.prompt(part, opts)
	opts = opts or {}
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = opts.action or "Use"
	pp.ObjectText = opts.object or part.Name
	pp.HoldDuration = opts.hold or 0
	pp.MaxActivationDistance = opts.distance or 10
	pp.KeyboardKeyCode = opts.key or Enum.KeyCode.E
	pp.RequiresLineOfSight = Core.opt(opts, "lineOfSight", false)
	pp.Parent = part
	local h = { prompt = pp, Used = Signal.new(), maid = Maid.new() }
	h.maid:Give(pp)
	local cooldown = opts.cooldown or 0.3
	local last = setmetatable({}, { __mode = "k" })
	h.maid:Give(pp.Triggered:Connect(function(player)
		local _, root = Core.character(player)
		local pos = Core.position(part)
		if not root or not pos or (root.Position - pos).Magnitude > pp.MaxActivationDistance + 6 then
			return
		end
		local now = os.clock()
		if now - (last[player] or 0) < cooldown then
			return
		end
		last[player] = now
		h.Used:Fire(player, part)
		if opts.onUse then
			task.spawn(opts.onUse, player, part)
		end
	end))
	function h.destroy()
		h.maid:Clean()
	end
	h.Destroy = h.destroy
	return h
end

----------------------------------------------------------------------------------------------------------------
-- Carry: pick up (E), drop (G), throw (R). Any part with an "Item" attribute that you pass to c:make(), or that
-- c:spawn() creates. Held items are welded to the character; stations take items out of hands.
----------------------------------------------------------------------------------------------------------------
local Carry = {}
Carry.__index = Carry
-- Carry.new({holdOffset=CFrame.new(0, 0.6, -2.4), throwSpeed=55, distance=9, parent=Folder,
--   colors={[itemType]=Color3|"#hex"} (spawn colours), onPickup=fn(player, part), onDrop=fn(player, part, thrown)})
function Carry.new(opts)
	opts = opts or {}
	local self = setmetatable({
		holdOffset = opts.holdOffset or CFrame.new(0, 0.6, -2.4),
		throwSpeed = opts.throwSpeed or 55,
		distance = opts.distance or 9,
		parent = opts.parent or Core.folder("Items"),
		colors = opts.colors or {},
		holding = setmetatable({}, { __mode = "k" }), -- player -> part
		parts = {}, -- part -> {holder, prompts...}
		PickedUp = Signal.new(), -- (player, part)
		Dropped = Signal.new(), -- (player, part, thrown)
		maid = Maid.new(),
	}, Carry)
	if opts.onPickup then
		self.PickedUp:Connect(opts.onPickup)
	end
	if opts.onDrop then
		self.Dropped:Connect(opts.onDrop)
	end
	local function hookChar(p)
		self.maid:Give(p.CharacterRemoving:Connect(function()
			self:drop(p)
		end))
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hookChar(p)
	end
	self.maid:Give(Players.PlayerAdded:Connect(hookChar))
	self.maid:Give(Players.PlayerRemoving:Connect(function(p)
		self:drop(p)
	end))
	-- key fallback (G drop / R throw) sent by GameplayKit.startClient while the player attribute "Holding" is set
	local remote = Core.remote("Carry")
	local allow = Core.limiter(4, 4)
	self.maid:Give(remote.OnServerEvent:Connect(function(player, action)
		if self.holding[player] and allow(player) then
			self:drop(player, action == "throw")
		end
	end))
	return self
end

-- c:spawn(itemType, position|CFrame, {size=Vector3.new(1.6,1.6,1.6), color, shape, material}) -> part
function Carry:spawn(itemType, at, o)
	o = o or {}
	local cf = Core.cframe(at) or CFrame.new(0, 5, 0)
	local part = Core.part({
		Name = itemType, Size = o.size or Vector3.new(1.6, 1.6, 1.6), Shape = o.shape,
		Color = Core.color(o.color or self.colors[itemType], Color3.fromRGB(230, 170, 110)),
		Material = o.material or Enum.Material.SmoothPlastic, Anchored = false, CFrame = cf, Parent = self.parent,
	})
	self:make(part, itemType)
	return part
end

-- c:make(part, itemType?) makes an existing part carryable
function Carry:make(part, itemType)
	if self.parts[part] then
		return part
	end
	part:SetAttribute("Item", itemType or part:GetAttribute("Item") or part.Name)
	local pick = Items.prompt(part, { action = "Pick up", object = part:GetAttribute("Item"), distance = self.distance, key = Enum.KeyCode.E })
	local throw = Items.prompt(part, { action = "Throw", object = "", distance = self.distance, key = Enum.KeyCode.R })
	throw.prompt.Enabled = false
	local st: any = { pick = pick, throw = throw, holder = nil, weld = nil }
	self.parts[part] = st
	pick.Used:Connect(function(player)
		if st.holder == player then
			self:drop(player)
		elseif not st.holder then
			self:pickup(player, part)
		end
	end)
	throw.Used:Connect(function(player)
		if st.holder == player then
			self:drop(player, true)
		end
	end)
	self.maid:Give(part.AncestryChanged:Connect(function(_, parent)
		if not parent and self.parts[part] then
			if st.holder then
				self.holding[st.holder] = nil
				st.holder:SetAttribute("Holding", nil)
			end
			pick.destroy()
			throw.destroy()
			self.parts[part] = nil
		end
	end))
	return part
end

function Carry:held(player)
	return self.holding[player]
end

-- c:pickup(player, part) -> bool
function Carry:pickup(player, part)
	local st = self.parts[part]
	local _, root = Core.character(player)
	if not st or st.holder or not root or self.holding[player] then
		return false
	end
	if part:GetAttribute("OnStation") then
		return false -- stations hand items out themselves
	end
	st.holder = player
	self.holding[player] = part
	player:SetAttribute("Holding", part:GetAttribute("Item"))
	part.Anchored = false
	part.CanCollide = false
	part.Massless = true
	part.CFrame = root.CFrame * self.holdOffset
	local weld = Instance.new("WeldConstraint")
	weld.Name = "CarryWeld"
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	st.weld = weld
	st.pick.prompt.ActionText = "Drop"
	st.pick.prompt.KeyboardKeyCode = Enum.KeyCode.G
	st.throw.prompt.Enabled = true
	self.PickedUp:Fire(player, part)
	return true
end

-- c:take(player) -> part?  removes the held item from the player's hands (no physics), for stations
function Carry:take(player)
	local part = self.holding[player]
	if not part then
		return nil
	end
	local st = self.parts[part]
	if st.weld then
		st.weld:Destroy()
		st.weld = nil
	end
	st.holder = nil
	self.holding[player] = nil
	player:SetAttribute("Holding", nil)
	part.Anchored = true
	part.Massless = false
	st.pick.prompt.ActionText = "Pick up"
	st.pick.prompt.KeyboardKeyCode = Enum.KeyCode.E
	st.throw.prompt.Enabled = false
	return part
end

-- c:give(player, part) -> bool  (puts a part straight into empty hands)
function Carry:give(player, part)
	self:make(part)
	part:SetAttribute("OnStation", nil)
	return self:pickup(player, part)
end

-- c:drop(player, throw?)
function Carry:drop(player, thrown)
	local part = self:take(player)
	if not part then
		return
	end
	local _, root = Core.character(player)
	part.Anchored = false
	part.CanCollide = true
	if root then
		part.CFrame = root.CFrame * CFrame.new(0, 0.5, -3)
		local v = thrown and (root.CFrame.LookVector * self.throwSpeed + Vector3.new(0, self.throwSpeed * 0.35, 0)) or root.AssemblyLinearVelocity
		part.AssemblyLinearVelocity = v
	end
	self.Dropped:Fire(player, part, thrown == true)
end

function Carry:destroy()
	self.maid:Clean()
end
Items.Carry = Carry

----------------------------------------------------------------------------------------------------------------
-- Recipes: inputs (multiset of item types) -> output
----------------------------------------------------------------------------------------------------------------
local Recipes = {}
Recipes.__index = Recipes
local function multiset(inputs)
	local m = {}
	for k, v in pairs(inputs) do
		if type(k) == "number" then
			m[v] = (m[v] or 0) + 1
		else
			m[k] = (m[k] or 0) + v
		end
	end
	return m
end
-- Recipes.new({ {inputs={"Bun","Cooked Patty"} | {Bun=1, ["Cooked Patty"]=1}, output="Burger", count=1, time=0}, ... })
function Recipes.new(list)
	local self = setmetatable({ list = {} }, Recipes)
	for _, r in ipairs(list or {}) do
		table.insert(self.list, { inputs = multiset(r.inputs or {}), output = r.output, count = r.count or 1, time = r.time or 0 })
	end
	return self
end
-- r:match({itemType...}) -> recipe? (exact multiset match)
function Recipes:match(types)
	local have = multiset(types)
	for _, r in ipairs(self.list) do
		local ok = true
		for k, n in pairs(r.inputs) do
			if have[k] ~= n then
				ok = false
				break
			end
		end
		for k in pairs(have) do
			if not r.inputs[k] then
				ok = false
				break
			end
		end
		if ok then
			return r
		end
	end
	return nil
end
-- r:partial({itemType...}) -> bool: these items are a subset of some recipe (a station can keep accepting)
function Recipes:partial(types)
	local have = multiset(types)
	for _, r in ipairs(self.list) do
		local ok = true
		for k, n in pairs(have) do
			if (r.inputs[k] or 0) < n then
				ok = false
				break
			end
		end
		if ok then
			return true
		end
	end
	return false
end
function Recipes:get(output)
	for _, r in ipairs(self.list) do
		if r.output == output then
			return r
		end
	end
	return nil
end
function Recipes:canCraft(inventory, player, output)
	local r = self:get(output)
	if not r then
		return false
	end
	for k, n in pairs(r.inputs) do
		if inventory:count(player, k) < n then
			return false
		end
	end
	return true
end
-- r:craft(inventory, player, output) -> bool (consumes inputs, adds output)
function Recipes:craft(inventory, player, output)
	if not self:canCraft(inventory, player, output) then
		return false
	end
	local r = self:get(output)
	for k, n in pairs(r.inputs) do
		inventory:remove(player, k, n)
	end
	inventory:add(player, r.output, r.count)
	return true
end
Items.Recipes = Recipes

----------------------------------------------------------------------------------------------------------------
-- Inventory: slots with stacks, replicated as JSON in player attribute "Inv_<name>"
----------------------------------------------------------------------------------------------------------------
local Inventory = {}
Inventory.__index = Inventory
-- Inventory.new({name="Main", slots=20, stack=99})
function Inventory.new(opts)
	opts = opts or {}
	return setmetatable({
		name = opts.name or "Main",
		slots = opts.slots or 20,
		stack = opts.stack or 99,
		data = setmetatable({}, { __mode = "k" }), -- player -> { {item, count} }
		Changed = Signal.new(), -- (player, item, newCount)
	}, Inventory)
end
function Inventory:_slots(player)
	local s = self.data[player]
	if not s then
		s = {}
		self.data[player] = s
	end
	return s
end
function Inventory:_sync(player, item)
	player:SetAttribute("Inv_" .. self.name, Core.encode(self:list(player)))
	self.Changed:Fire(player, item, self:count(player, item))
end
-- inv:add(player, item, n=1) -> added (may be < n when full)
function Inventory:add(player, item, n)
	n = n or 1
	local slots = self:_slots(player)
	local left = n
	for _, s in ipairs(slots) do
		if s.item == item and s.count < self.stack then
			local k = math.min(left, self.stack - s.count)
			s.count += k
			left -= k
			if left <= 0 then
				break
			end
		end
	end
	while left > 0 and #slots < self.slots do
		local k = math.min(left, self.stack)
		table.insert(slots, { item = item, count = k })
		left -= k
	end
	if left < n then
		self:_sync(player, item)
	end
	return n - left
end
-- inv:remove(player, item, n=1) -> bool (all or nothing)
function Inventory:remove(player, item, n)
	n = n or 1
	if self:count(player, item) < n then
		return false
	end
	local slots = self:_slots(player)
	for i = #slots, 1, -1 do
		local s = slots[i]
		if s.item == item then
			local k = math.min(n, s.count)
			s.count -= k
			n -= k
			if s.count <= 0 then
				table.remove(slots, i)
			end
			if n <= 0 then
				break
			end
		end
	end
	self:_sync(player, item)
	return true
end
function Inventory:count(player, item)
	local c = 0
	for _, s in ipairs(self.data[player] or {}) do
		if s.item == item then
			c += s.count
		end
	end
	return c
end
function Inventory:has(player, item, n)
	return self:count(player, item) >= (n or 1)
end
function Inventory:list(player)
	local out = {}
	for i, s in ipairs(self.data[player] or {}) do
		out[i] = { item = s.item, count = s.count }
	end
	return out
end
function Inventory:clear(player)
	self.data[player] = {}
	self:_sync(player, nil)
end
-- Client: Inventory.client(name="Main") -> {list() -> {{item,count}}, Changed: Signal(list)}
function Inventory.client(name)
	local attr = "Inv_" .. (name or "Main")
	local player = Players.LocalPlayer
	local h = { Changed = Signal.new() }
	function h.list()
		return Core.decode(player and player:GetAttribute(attr)) or {}
	end
	if player then
		player:GetAttributeChangedSignal(attr):Connect(function()
			h.Changed:Fire(h.list())
		end)
	end
	return h
end
Items.Inventory = Inventory

----------------------------------------------------------------------------------------------------------------
-- Stations: place items, run timed processes, combine by recipe, take results.
-- Part attributes for UI: State ("Empty" | process label | "Ready"), Item (top item type), Progress (0..1),
-- Contents (JSON list of item types). E.g. a stove: Raw Patty -[Cooking 5s]-> Cooked Patty -[Burning 6s]-> Burnt Patty
----------------------------------------------------------------------------------------------------------------
local Station = {}
Station.__index = Station
-- Station.new(part, {name=part.Name, carry=Carry obj | inventory=Inventory obj, accepts=nil (any) | {types},
--   process={ {from="Raw Patty", to="Cooked Patty", time=5, label="Cooking"}, ... }, recipes=Recipes obj (combine),
--   capacity=1 (4 with recipes), colors={[type]=Color3|"#hex"}, distance=9,
--   onChange=fn(state, itemType), onDone=fn(fromType, toType)})
function Station.new(part, opts)
	opts = opts or {}
	local self = setmetatable({
		part = part,
		name = opts.name or part.Name,
		carry = opts.carry,
		inventory = opts.inventory,
		accepts = opts.accepts,
		process = opts.process or {},
		recipes = opts.recipes,
		capacity = opts.capacity or (opts.recipes and 4 or 1),
		colors = opts.colors or {},
		contents = {}, -- array of item types (top = last)
		visuals = {},
		Changed = Signal.new(), -- (state, itemType, progress)
		Done = Signal.new(), -- (fromType, toType)
		maid = Maid.new(),
	}, Station)
	if opts.onChange then
		self.Changed:Connect(opts.onChange)
	end
	if opts.onDone then
		self.Done:Connect(opts.onDone)
	end
	local pr = Items.prompt(part, { action = "Place", object = self.name, distance = opts.distance or 9, key = Enum.KeyCode.E })
	self.prompt = pr.prompt
	self.maid:Give(pr)
	pr.Used:Connect(function(player)
		self:_use(player)
	end)
	self:_set("Empty", 0)
	return self
end

function Station:_accepts(itemType)
	if #self.contents >= self.capacity then
		return false
	end
	if self.accepts then
		local ok = false
		for _, t in ipairs(self.accepts) do
			if t == itemType then
				ok = true
				break
			end
		end
		if not ok then
			return false
		end
	end
	if self.recipes and #self.contents > 0 then
		local next = table.clone(self.contents)
		table.insert(next, itemType)
		return self.recipes:partial(next)
	end
	return true
end

function Station:_set(state, progress)
	local top = self.contents[#self.contents]
	self.state = state
	self.part:SetAttribute("State", state)
	self.part:SetAttribute("Item", top)
	self.part:SetAttribute("Progress", progress or 0)
	self.part:SetAttribute("Contents", Core.encode(self.contents))
	self.prompt.ObjectText = self.name .. (top and (" - " .. top) or "")
	self.prompt.ActionText = (#self.contents == 0) and "Place" or ((#self.contents < self.capacity) and "Place / Take" or "Take")
	self.Changed:Fire(state, top, progress or 0)
end

function Station:_redraw()
	for _, v in ipairs(self.visuals) do
		v:Destroy()
	end
	table.clear(self.visuals)
	local top = self.part.CFrame * CFrame.new(0, self.part.Size.Y / 2, 0)
	for i, t in ipairs(self.contents) do
		local v = Core.part({
			Name = t, Size = Vector3.new(1.6, 0.5, 1.6), Color = Core.color(self.colors[t], Color3.fromRGB(230, 170, 110)),
			Material = Enum.Material.SmoothPlastic, CanCollide = false, CFrame = top * CFrame.new(0, 0.25 + (i - 1) * 0.5, 0),
			Parent = self.part,
		})
		v:SetAttribute("Item", t)
		v:SetAttribute("OnStation", true)
		table.insert(self.visuals, v)
	end
end

-- st:put(itemType) -> bool  (server API: place an item without a player)
function Station:put(itemType)
	if not self:_accepts(itemType) then
		return false
	end
	table.insert(self.contents, itemType)
	self:_redraw()
	self:_advance()
	return true
end

-- st:takeTop() -> itemType?
function Station:takeTop()
	local t = table.remove(self.contents)
	if self.job then
		task.cancel(self.job)
		self.job = nil
	end
	self:_redraw()
	self:_advance()
	return t
end

function Station:_use(player)
	if self.carry then
		local held = self.carry:held(player)
		if held then
			local t = held:GetAttribute("Item")
			if self:_accepts(t) then
				self.carry:take(player):Destroy()
				self:put(t)
			end
		elseif #self.contents > 0 then
			local t = self:takeTop()
			local _, root = Core.character(player)
			local part = self.carry:spawn(t, root and root.CFrame or self.part.CFrame)
			self.carry:pickup(player, part)
		end
	elseif self.inventory then
		for _, t in ipairs(self.accepts or {}) do
			if self.inventory:has(player, t) and self:_accepts(t) then
				self.inventory:remove(player, t, 1)
				self:put(t)
				return
			end
		end
		if #self.contents > 0 then
			local t = self.contents[#self.contents]
			if self.inventory:add(player, t, 1) == 1 then
				self:takeTop()
			end
		end
	end
end

function Station:_advance()
	if self.job then
		task.cancel(self.job)
		self.job = nil
	end
	if #self.contents == 0 then
		self:_set("Empty", 0)
		return
	end
	if self.recipes then
		local r = self.recipes:match(self.contents)
		if r then
			self:_run("Combining", r.time, function()
				local from = table.concat(self.contents, "+")
				table.clear(self.contents)
				for _ = 1, r.count do
					table.insert(self.contents, r.output)
				end
				self.Done:Fire(from, r.output)
			end)
			return
		end
	end
	if #self.contents == 1 then
		local t = self.contents[1]
		for _, p in ipairs(self.process) do
			if p.from == t then
				self:_run(p.label or "Processing", p.time or 3, function()
					self.contents[1] = p.to
					self.Done:Fire(p.from, p.to)
				end)
				return
			end
		end
	end
	self:_set("Ready", 1)
end

function Station:_run(label, seconds, finish)
	if seconds <= 0 then
		finish()
		self:_redraw()
		self:_advance()
		return
	end
	self:_set(label, 0)
	self.job = task.spawn(function()
		local t0 = os.clock()
		while true do
			task.wait(0.1)
			local k = math.min(1, (os.clock() - t0) / seconds)
			self.part:SetAttribute("Progress", k)
			if k >= 1 then
				break
			end
		end
		self.job = nil
		finish()
		self:_redraw()
		self:_advance()
	end)
end

function Station:destroy()
	if self.job then
		task.cancel(self.job)
	end
	for _, v in ipairs(self.visuals) do
		v:Destroy()
	end
	self.maid:Clean()
end
Items.Station = Station

-- Maid-friendly aliases (maid:Give(obj) calls obj:Destroy())
Collectibles.Destroy = Collectibles.destroy
Carry.Destroy = Carry.destroy
Station.Destroy = Station.destroy

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">GameplayKit_Race</string>
          <string name="Source"><![CDATA[--!nonstrict
-- GameplayKit_Race: race manager for any vehicle (or on foot). Ordered checkpoint gates, laps, positions, split
-- and lap times, wrong-way, finish, and AI followers along a spline with rubber-banding. Server only.
--
-- Progress is a monotonic odometer along a closed Catmull-Rom spline through the gates (the wave-racer model):
-- each sample's change in arc length is unwrapped across the start line and accumulated. Gates are arc-length
-- milestones on that odometer, so they cannot be missed or double-fired, and a jump larger than a racer could
-- physically drive in one tick (a shortcut or teleport) is simply not counted.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Core = require((script.Parent :: Instance):WaitForChild("GameplayKit_Core"))
local Maid = require((script.Parent :: Instance):WaitForChild("Maid"))
local Signal = Core.Signal

local Race = {}

----------------------------------------------------------------------------------------------------------------
-- Spline: closed (or open) Catmull-Rom through points, arc-length sampled
----------------------------------------------------------------------------------------------------------------
local Spline = {}
Spline.__index = Spline
Race.Spline = Spline

local function catmull(p0, p1, p2, p3, t)
	local t2, t3 = t * t, t * t * t
	return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
end

-- Spline.new({Vector3|BasePart|CFrame...}, closed=true, samplesPerSegment=12) -> sp (sp.length; sp:at(s); sp:project(pos))
function Spline.new(points, closed, per)
	local pts = {}
	for _, p in ipairs(points) do
		table.insert(pts, Core.position(p))
	end
	closed = closed ~= false
	per = per or 12
	local self = setmetatable({ closed = closed, pos = {}, s = {}, length = 0 }, Spline)
	local n = #pts
	if n < 2 then
		pts = { Vector3.zero, Vector3.new(0, 0, -10) }
		n = 2
	end
	local function P(i)
		if closed then
			return pts[(i - 1) % n + 1]
		end
		return pts[math.clamp(i, 1, n)]
	end
	local segs = closed and n or n - 1
	local acc, prev = 0, nil
	for i = 1, segs do
		for k = 0, per - 1 do
			local q = catmull(P(i - 1), P(i), P(i + 1), P(i + 2), k / per)
			if prev then
				acc += (q - prev).Magnitude
			end
			table.insert(self.pos, q)
			table.insert(self.s, acc)
			prev = q
		end
	end
	local last = closed and P(1) or P(n)
	acc += (last - prev).Magnitude
	if not closed then
		table.insert(self.pos, last)
		table.insert(self.s, acc)
	end
	self.length = acc
	return self
end

-- sp:at(s) -> position, tangent (unit)
function Spline:at(s)
	local L = self.length
	if self.closed then
		s = s % L
	else
		s = math.clamp(s, 0, L)
	end
	local pos, arr = self.pos, self.s
	local lo, hi = 1, #arr
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if arr[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	if arr[hi] <= s then
		lo = hi
	end
	local n = #arr
	local a, b, sb = pos[lo], nil, nil
	if lo < n then
		b, sb = pos[lo + 1], arr[lo + 1]
	elseif self.closed then
		b, sb = pos[1], L
	else
		b, sb = a, arr[lo]
	end
	local sa = arr[lo]
	local seg = b - a
	local t = (sb > sa) and (s - sa) / (sb - sa) or 0
	local tangent = seg.Magnitude > 1e-4 and seg.Unit or Vector3.new(0, 0, -1)
	return a + seg * math.clamp(t, 0, 1), tangent
end

-- sp:cframe(s, lateral=0, up=0) -> CFrame facing along the spline
function Spline:cframe(s, lateral, up)
	local p, t = self:at(s)
	local right = t:Cross(Vector3.yAxis)
	right = right.Magnitude > 1e-4 and right.Unit or Vector3.xAxis
	p += right * (lateral or 0) + Vector3.yAxis * (up or 0)
	return CFrame.lookAt(p, p + t)
end

-- sp:project(pos, hintIndex?, window=24) -> s, distance, index (local search around the hint, global otherwise)
function Spline:project(p, hint, window)
	local pos, arr, n = self.pos, self.s, #self.pos
	local function test(i)
		local j = i % n + 1
		local a, b = pos[i], pos[j]
		local sa = arr[i]
		local sb = (j == 1) and self.length or arr[j]
		if j == 1 and not self.closed then
			return math.huge, sa
		end
		local ab = b - a
		local len2 = ab:Dot(ab)
		local t = len2 > 0 and math.clamp((p - a):Dot(ab) / len2, 0, 1) or 0
		local q = a + ab * t
		return (p - q).Magnitude, sa + (sb - sa) * t
	end
	local bestD, bestS, bestI = math.huge, 0, 1
	if hint then
		window = window or 24
		for k = -window, window do
			local i = (hint - 1 + k) % n + 1
			local d, s = test(i)
			if d < bestD then
				bestD, bestS, bestI = d, s, i
			end
		end
	end
	if not hint or bestD > 40 then
		for i = 1, n do
			local d, s = test(i)
			if d < bestD then
				bestD, bestS, bestI = d, s, i
			end
		end
	end
	return bestS, bestD, bestI
end

----------------------------------------------------------------------------------------------------------------
-- Race manager
----------------------------------------------------------------------------------------------------------------
local RaceMgr = {}
RaceMgr.__index = RaceMgr

-- Race.new({gates={BasePart...} | Folder (gate 1 = start/finish), path={points}? (smoother line than gate centres),
--   laps=3, countdown=3, freeze=true (anchor players during countdown), grid=true (line racers up behind gate 1),
--   width=80 (off-track distance that stops progress), maxSpeed=250 (studs/s; faster jumps don't count),
--   finishGrace=30 (s after the winner before the rest are DNF), autoJoin=true (all players join on start),
--   onGate=fn(racer, gate, split), onLap=fn(racer, lap, lapTime), onFinish=fn(racer, place, time), onOver=fn(standings)})
-- Racer records: {name, player?, model?, lap, place, finished, time, splits, lapTimes, bestLap, wrongWay, progress}
function Race.new(opts)
	opts = opts or {}
	local gates = Core.list(opts.gates or workspace:FindFirstChild("Gates"), "BasePart")
	if #gates < 2 then
		warn("[GameplayKit] Race needs at least 2 gates (opts.gates = {BasePart...} or a Folder); race:start() will do nothing")
	end
	local self = setmetatable({
		opts = opts,
		gates = gates,
		laps = opts.laps or 3,
		width = opts.width or 80,
		maxSpeed = opts.maxSpeed or 250,
		racers = {},
		Status = "Idle",
		state = Core.state("Race"),
		maid = Maid.new(),
		GatePassed = Signal.new(), -- (racer, gateIndex, splitTime)
		LapCompleted = Signal.new(), -- (racer, lap, lapTime)
		Finished = Signal.new(), -- (racer, place, time)
		WrongWay = Signal.new(), -- (racer, bool)
		StatusChanged = Signal.new(), -- (status) "Idle"|"Countdown"|"Racing"|"Finished"
		Over = Signal.new(), -- (standings)
	}, RaceMgr)
	self.spline = Spline.new(opts.path or gates, true)
	local L = self.spline.length
	local s0 = self.spline:project(Core.position(gates[1]) or Vector3.zero)
	self.s0 = s0
	self.rel = {}
	for i, g in ipairs(gates) do
		local s = self.spline:project(g.Position)
		self.rel[i] = (s - s0) % L
		g:SetAttribute("GateIndex", i)
	end
	self.rel[1] = 0
	if opts.onGate then
		self.GatePassed:Connect(opts.onGate)
	end
	if opts.onLap then
		self.LapCompleted:Connect(opts.onLap)
	end
	if opts.onFinish then
		self.Finished:Connect(opts.onFinish)
	end
	if opts.onOver then
		self.Over:Connect(opts.onOver)
	end
	self.maid:Give(Players.PlayerRemoving:Connect(function(p)
		self:removeRacer(p)
	end))
	self:_status("Idle")
	return self
end

function RaceMgr:_status(s)
	self.Status = s
	if self.state then
		self.state:SetAttribute("Status", s)
		self.state:SetAttribute("Laps", self.laps)
		self.state:SetAttribute("Gates", #self.gates)
	end
	self.StatusChanged:Fire(s)
end

local function racerRoot(r)
	if r.player then
		local _, root, hum = Core.character(r.player)
		if hum and hum.SeatPart then
			return hum.SeatPart
		end
		return root
	end
	return r.model and r.model.Parent and Core.root(r.model)
end

-- race:addRacer(player | model, name?) -> racer
function RaceMgr:addRacer(x, name)
	for _, r in ipairs(self.racers) do
		if r.key == x then
			return r
		end
	end
	local isPlayer = typeof(x) == "Instance" and x:IsA("Player")
	local r = {
		key = x, player = isPlayer and x or nil, model = (not isPlayer) and x or nil,
		name = name or (typeof(x) == "Instance" and (isPlayer and (x :: any).DisplayName or x.Name)) or "Racer",
		lap = 0, passed = 0, odo = 0, place = #self.racers + 1, finished = false, time = 0,
		splits = {}, lapTimes = {}, bestLap = nil, wrongWay = false, back = 0, progress = 0,
	}
	table.insert(self.racers, r)
	return r
end

function RaceMgr:removeRacer(x)
	for i, r in ipairs(self.racers) do
		if r.key == x then
			table.remove(self.racers, i)
			return
		end
	end
end

-- race:grid(i) -> CFrame of grid slot i (two columns, behind the start line)
function RaceMgr:grid(i)
	local row, col = (i - 1) // 2, (i - 1) % 2
	return self.spline:cframe(self.s0 - 14 - row * 12, col == 0 and -6 or 6, 3)
end

local function milestone(self, k)
	local n = #self.gates
	return (k // n) * self.spline.length + self.rel[(k % n) + 1]
end

-- race:start() -> countdown, then racing
function RaceMgr:start()
	if self.Status == "Countdown" or self.Status == "Racing" or #self.gates < 2 then
		return
	end
	if Core.opt(self.opts, "autoJoin", true) then
		for _, p in ipairs(Players:GetPlayers()) do
			self:addRacer(p)
		end
	end
	local L = self.spline.length
	for i, r in ipairs(self.racers) do
		r.lap, r.passed, r.finished, r.time, r.wrongWay, r.back = 0, 0, false, 0, false, 0
		r.splits, r.lapTimes, r.bestLap = {}, {}, nil
		if Core.opt(self.opts, "grid", true) then
			local cf = self:grid(i)
			if r.player then
				local ch = Core.character(r.player)
				if ch then
					ch:PivotTo(cf)
				end
			elseif r.model then
				r.model:PivotTo(cf)
			end
			if r.follower then
				r.follower.s = self.s0 - 14 - ((i - 1) // 2) * 12
			end
		end
		local root = racerRoot(r)
		local s, _, idx = self.spline:project(root and root.Position or Vector3.zero)
		local rel = (s - self.s0) % L
		if rel > L / 2 then
			rel -= L
		end
		r.odo, r.lastS, r.hint = rel, s, idx
	end
	self:_publish()
	self.thread = task.spawn(function()
		self:_status("Countdown")
		local freeze = Core.opt(self.opts, "freeze", true)
		local frozen = {}
		if freeze then
			for _, r in ipairs(self.racers) do
				local root = r.player and racerRoot(r)
				if root and not root.Anchored then
					root.Anchored = true
					table.insert(frozen, root)
				end
			end
		end
		for c = self.opts.countdown or 3, 1, -1 do
			if self.state then
				self.state:SetAttribute("Count", c)
			end
			task.wait(1)
		end
		if self.state then
			self.state:SetAttribute("Count", 0)
		end
		for _, root in ipairs(frozen) do
			if root.Parent then
				root.Anchored = false
			end
		end
		self.t0 = os.clock()
		self:_status("Racing")
		self.loop = Core.every(0.05, function(dt)
			self:_tick(dt)
			return self.Status == "Racing"
		end)
		self.hb = RunService.Heartbeat:Connect(function(dt)
			self:_driveFollowers(dt)
		end)
		self.maid:Give(self.hb)
	end)
end

function RaceMgr:_tick(dt)
	local L = self.spline.length
	local now = os.clock() - self.t0
	if self.state then
		self.state:SetAttribute("Time", now)
	end
	for _, r in ipairs(self.racers) do
		local root = not r.finished and racerRoot(r)
		if root then
			local s, dist, idx = self.spline:project(root.Position, r.hint)
			r.hint = idx
			local ds = s - (r.lastS or s)
			if ds > L / 2 then
				ds -= L
			elseif ds < -L / 2 then
				ds += L
			end
			r.lastS = s
			if dist <= self.width and math.abs(ds) <= self.maxSpeed * dt * 1.5 + 8 then
				r.odo += ds
			end
			-- wrong way: going backwards along the line for > 1 s
			if ds < -0.5 * dt * 4 then
				r.back += dt
			elseif ds > 0 then
				r.back = 0
			end
			local wrong = r.back > 1
			if wrong ~= r.wrongWay then
				r.wrongWay = wrong
				self.WrongWay:Fire(r, wrong)
			end
			-- milestones
			while not r.finished and r.odo >= milestone(self, r.passed + 1) do
				r.passed += 1
				local g = (r.passed % #self.gates) + 1
				table.insert(r.splits, now)
				self.GatePassed:Fire(r, g, now)
				if g == 1 then
					r.lap += 1
					local prev = 0
					for _, t in ipairs(r.lapTimes) do
						prev += t
					end
					local lapTime = now - prev
					table.insert(r.lapTimes, lapTime)
					r.bestLap = math.min(r.bestLap or math.huge, lapTime)
					self.LapCompleted:Fire(r, r.lap, lapTime)
					if r.lap >= self.laps then
						self:_finish(r, now)
					end
				end
			end
			r.progress = r.odo / L
		end
	end
	self:_rank()
	self:_publish()
	if self.firstFinish and now - self.firstFinish > (self.opts.finishGrace or 30) then
		self:stop()
	end
end

function RaceMgr:_finish(r, now)
	r.finished = true
	r.time = now
	self.finishedCount = (self.finishedCount or 0) + 1
	r.place = self.finishedCount
	self.firstFinish = self.firstFinish or now
	self.Finished:Fire(r, r.place, now)
	local all = true
	for _, o in ipairs(self.racers) do
		if not o.finished then
			all = false
			break
		end
	end
	if all then
		task.defer(function()
			self:stop()
		end)
	end
end

function RaceMgr:_rank()
	local order = table.clone(self.racers)
	table.sort(order, function(a, b)
		if a.finished ~= b.finished then
			return a.finished
		end
		if a.finished then
			return a.place < b.place
		end
		return a.odo > b.odo
	end)
	for i, r in ipairs(order) do
		r.place = i
	end
	self.order = order
end

function RaceMgr:_publish()
	local rows = {}
	for i, r in ipairs(self.order or self.racers) do
		rows[i] = { name = r.name, place = r.place, lap = math.min(r.lap + 1, self.laps), finished = r.finished, time = r.time, progress = r.progress }
		if r.player then
			local p = r.player
			p:SetAttribute("RacePlace", r.place)
			p:SetAttribute("RaceLap", math.min(r.lap + 1, self.laps))
			p:SetAttribute("RaceGate", (r.passed % #self.gates) + 1)
			p:SetAttribute("RaceWrongWay", r.wrongWay)
			p:SetAttribute("RaceFinished", r.finished)
			p:SetAttribute("RaceTime", r.time)
		end
	end
	if self.state then
		self.state:SetAttribute("Standings", Core.encode(rows))
	end
end

-- race:standings() -> racers sorted by place
function RaceMgr:standings()
	self:_rank()
	return self.order
end

function RaceMgr:stop()
	if self.Status ~= "Racing" and self.Status ~= "Countdown" then
		return
	end
	if self.hb then
		self.hb:Disconnect()
		self.hb = nil
	end
	for _, r in ipairs(self.racers) do
		if not r.finished then
			r.dnf = true
		end
	end
	self:_rank()
	self:_publish()
	self:_status("Finished")
	self.firstFinish, self.finishedCount = nil, 0
	self.Over:Fire(self:standings())
end

----------------------------------------------------------------------------------------------------------------
-- AI followers: race:addFollower(model, {drive=fn(model, target: Vector3, speedScale, dt)?, speed=60 (studs/s),
--   lookahead=18, lane=0 (lateral offset), wander=2, height=2, rubber={min=0.85, max=1.2, range=120 (studs)},
--   name}) -> racer. Without `drive`: Humanoid models walk with MoveTo; anything else is moved kinematically
--   along the spline (PivotTo each frame). With `drive`, the callback steers your vehicle toward `target`.
----------------------------------------------------------------------------------------------------------------
function RaceMgr:addFollower(model, o)
	o = o or {}
	local r = self:addRacer(model, o.name)
	local rubber = o.rubber or {}
	r.follower = {
		drive = o.drive, speed = o.speed or 60, lookahead = o.lookahead or 18, lane = o.lane or 0,
		wander = o.wander or 2, height = o.height or 2, min = rubber.min or 0.85, max = rubber.max or 1.2,
		range = rubber.range or 120, scale = 1, s = nil, seed = math.random() * 100,
	}
	return r
end

function RaceMgr:_driveFollowers(dt)
	if self.Status ~= "Racing" then
		return
	end
	local L = self.spline.length
	local humanBest
	for _, r in ipairs(self.racers) do
		if r.player and not r.finished then
			humanBest = math.max(humanBest or -math.huge, r.odo)
		end
	end
	local t = os.clock()
	for _, r in ipairs(self.racers) do
		local f = r.follower
		if f and r.model and r.model.Parent and not r.finished then
			-- rubber band toward the best human
			local target = 1
			if humanBest then
				local gap = humanBest - r.odo
				local k = math.clamp(gap / f.range, -1, 1)
				target = k > 0 and 1 + k * (f.max - 1) or 1 + k * (1 - f.min)
			end
			f.scale += (target - f.scale) * math.min(1, dt * 2)
			local lane = f.lane + math.sin(t * 0.4 + f.seed) * f.wander
			if f.drive or Core.humanoid(r.model) then
				local root = Core.root(r.model)
				local s = root and self.spline:project(root.Position, r.hint) or 0
				local aim = self.spline:cframe(s + f.lookahead, lane, 0).Position
				if f.drive then
					local ok, err = pcall(f.drive, r.model, aim, f.scale, dt)
					if not ok then
						warn("[GameplayKit] follower drive: " .. tostring(err))
					end
				else
					local hum = Core.humanoid(r.model)
					hum.WalkSpeed = f.speed * f.scale
					hum:MoveTo(aim)
				end
			else
				f.s = (f.s or (self.s0 + r.odo)) + f.speed * f.scale * dt
				r.model:PivotTo(self.spline:cframe(f.s % L, lane, f.height))
			end
		end
	end
end

function RaceMgr:destroy()
	self:stop()
	if self.loop then
		pcall(task.cancel, self.loop)
	end
	if self.thread then
		pcall(task.cancel, self.thread)
	end
	self.maid:Clean()
end

-- Maid-friendly aliases (maid:Give(obj) calls obj:Destroy())
RaceMgr.Destroy = RaceMgr.destroy

Race.RaceMgr = RaceMgr
return Race
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">GameplayKit_World</string>
          <string name="Source"><![CDATA[--!nonstrict
-- GameplayKit_World: moving platforms (players ride them), doors, and hazards for obbies/platformers: spinners,
-- lasers, crushers, kill/lava parts. Server only. Platforms and spinners are physics-driven (AlignPosition /
-- HingeConstraint motors) so characters standing on them are carried and pushed for real.

local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local Core = require((script.Parent :: Instance):WaitForChild("GameplayKit_Core"))
local Combat = require((script.Parent :: Instance):WaitForChild("GameplayKit_Combat"))
local Items = require((script.Parent :: Instance):WaitForChild("GameplayKit_Items"))
local Maid = require((script.Parent :: Instance):WaitForChild("Maid"))
local Signal = Core.Signal
local Health = Combat.Health

local World = {}

local function easing(style)
	if typeof(style) == "EnumItem" then
		return style
	end
	return Enum.EasingStyle[style or "Sine"] or Enum.EasingStyle.Sine
end

----------------------------------------------------------------------------------------------------------------
-- Mover: platforms that travel between points
----------------------------------------------------------------------------------------------------------------
local Mover = {}
Mover.__index = Mover
World.Mover = Mover
-- Mover.new(part | model, {offset=Vector3.new(0, 0, 20) | points={Vector3|CFrame...} (absolute, first = start),
--   time=3 (s per leg), pause=0.6, style="Sine", mode="pingpong"|"loop", physics=true (BaseParts: riders are
--   carried), rotate=nil (degrees/leg about Y)}) -> m (m:stop(); m.Arrived: Signal(index))
function Mover.new(target, opts)
	opts = opts or {}
	local self = setmetatable({ target = target, maid = Maid.new(), Arrived = Signal.new() }, Mover)
	local start = Core.cframe(target)
	local pts = { start }
	if opts.points then
		pts = {}
		for _, p in ipairs(opts.points) do
			local cf = Core.cframe(p)
			if cf and typeof(p) == "Vector3" then
				cf = CFrame.new(p) * start.Rotation
			end
			table.insert(pts, cf)
		end
	else
		table.insert(pts, start + (opts.offset or Vector3.new(0, 0, 20)))
	end
	if opts.rotate then
		for i = 2, #pts do
			pts[i] = pts[i] * CFrame.Angles(0, math.rad(opts.rotate * (i - 1)), 0)
		end
	end
	local driver
	if target:IsA("BasePart") and opts.physics ~= false then
		-- an anchored invisible driver is tweened; the real platform follows it with rigid constraints
		driver = Core.part({ Name = target.Name .. "Driver", Size = Vector3.one, Transparency = 1, CanCollide = false,
			CanQuery = false, CanTouch = false, CFrame = start, Parent = target.Parent })
		self.maid:Give(driver)
		local a0 = Instance.new("Attachment")
		a0.Parent = target
		local a1 = Instance.new("Attachment")
		a1.Parent = driver
		local ap = Instance.new("AlignPosition")
		ap.Attachment0, ap.Attachment1 = a0, a1
		ap.RigidityEnabled = true
		ap.Parent = target
		local ao = Instance.new("AlignOrientation")
		ao.Attachment0, ao.Attachment1 = a0, a1
		ao.RigidityEnabled = true
		ao.Parent = target
		self.maid:Give(a0)
		self.maid:Give(ap)
		self.maid:Give(ao)
		target.Anchored = false
		pcall(function()
			target:SetNetworkOwner(nil)
		end)
	end
	local cfv = Instance.new("CFrameValue")
	cfv.Value = start
	self.maid:Give(cfv)
	if not driver then
		self.maid:Give(cfv.Changed:Connect(function(v)
			if target.Parent then
				if target:IsA("Model") then
					target:PivotTo(v)
				else
					target.CFrame = v
				end
			end
		end))
	end
	local info = TweenInfo.new(opts.time or 3, easing(opts.style), Enum.EasingDirection.InOut)
	local pause = opts.pause or 0.6
	local mode = opts.mode or "pingpong"
	self.maid:Give(task.spawn(function()
		local i, dir = 1, 1
		while target.Parent do
			local ni = i + dir
			if ni > #pts then
				if mode == "loop" then
					ni = 1
				else
					dir = -1
					ni = i - 1
				end
			elseif ni < 1 then
				dir = 1
				ni = 2
			end
			local goal = pts[ni]
			local tw = driver and TweenService:Create(driver, info, { CFrame = goal }) or TweenService:Create(cfv, info, { Value = goal })
			tw:Play()
			tw.Completed:Wait()
			i = ni
			self.Arrived:Fire(i)
			task.wait(pause)
		end
	end))
	return self
end
function Mover:stop()
	self.maid:Clean()
	if self.target:IsA("BasePart") then
		self.target.Anchored = true
	end
end
Mover.destroy = Mover.stop

----------------------------------------------------------------------------------------------------------------
-- Door
----------------------------------------------------------------------------------------------------------------
local Door = {}
Door.__index = Door
World.Door = Door
-- Door.new(part | model, {open=CFrame (relative offset; default slides up by its height), time=0.6, prompt=true,
--   proximity=nil (studs: auto-open when a player is near), closeAfter=nil (s), locked=false,
--   key=nil (item type the player must be holding / have: player attribute "Holding" or Inventory),
--   inventory=Inventory?}) -> d (d:open(); d:close(); d:toggle(); d.locked; d.Changed: Signal(isOpen))
function Door.new(target, opts)
	opts = opts or {}
	local closed = Core.cframe(target)
	local size = target:IsA("BasePart") and target.Size or target:GetExtentsSize()
	local self = setmetatable({
		target = target, closedCF = closed, openCF = closed * (opts.open or CFrame.new(0, size.Y - 0.2, 0)),
		isOpen = false, locked = opts.locked or false, key = opts.key, inventory = opts.inventory,
		info = TweenInfo.new(opts.time or 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		closeAfter = opts.closeAfter, Changed = Signal.new(), maid = Maid.new(),
	}, Door)
	self.cfv = Instance.new("CFrameValue")
	self.cfv.Value = closed
	self.maid:Give(self.cfv)
	self.maid:Give(self.cfv.Changed:Connect(function(v)
		if target:IsA("Model") then
			target:PivotTo(v)
		else
			target.CFrame = v
		end
	end))
	if opts.prompt ~= false then
		local anchorPart = target:IsA("BasePart") and target or Core.root(target)
		self.promptH = Items.prompt(anchorPart, { action = "Open", object = opts.name or "Door", cooldown = 0.5 })
		self.maid:Give(self.promptH)
		self.promptH.Used:Connect(function(player)
			if self:allowed(player) then
				self:toggle()
			end
		end)
	end
	if opts.proximity then
		self.maid:Give(Core.every(0.25, function()
			local near = false
			for _, e in ipairs(Core.alivePlayers()) do
				if (e.root.Position - closed.Position).Magnitude <= opts.proximity and self:allowed(e.player) then
					near = true
					break
				end
			end
			if near ~= self.isOpen then
				if near then
					self:open()
				else
					self:close()
				end
			end
		end))
	end
	return self
end
function Door:allowed(player)
	if self.locked then
		return false
	end
	if not self.key then
		return true
	end
	if player:GetAttribute("Holding") == self.key then
		return true
	end
	return self.inventory ~= nil and self.inventory:has(player, self.key)
end
function Door:open()
	if self.isOpen then
		return
	end
	self.isOpen = true
	TweenService:Create(self.cfv, self.info, { Value = self.openCF }):Play()
	if self.promptH then
		self.promptH.prompt.ActionText = "Close"
	end
	self.Changed:Fire(true)
	if self.closeAfter then
		local token = {}
		self.token = token
		task.delay(self.closeAfter, function()
			if self.token == token then
				self:close()
			end
		end)
	end
end
function Door:close()
	if not self.isOpen then
		return
	end
	self.isOpen = false
	TweenService:Create(self.cfv, self.info, { Value = self.closedCF }):Play()
	if self.promptH then
		self.promptH.prompt.ActionText = "Open"
	end
	self.Changed:Fire(false)
end
function Door:toggle()
	if self.isOpen then
		self:close()
	else
		self:open()
	end
end
function Door:destroy()
	self.maid:Clean()
end

----------------------------------------------------------------------------------------------------------------
-- Hazards. All share one damage scanner (10 Hz spatial query per active hazard; per-target cooldown).
----------------------------------------------------------------------------------------------------------------
local Hazard = {}
World.Hazard = Hazard
local zones = {}
local scanner

local function ensureScanner()
	if scanner then
		return
	end
	scanner = Core.every(0.1, function()
		local now = os.clock()
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		for z in pairs(zones) do
			if not z.part.Parent then
				zones[z] = nil
			elseif z.active == nil or z.active() then
				params.FilterDescendantsInstances = { z.part }
				local seen = {}
				for _, hit in ipairs(Workspace:GetPartsInPart(z.part, params)) do
					local m = Core.modelOf(hit)
					if m and not seen[m] and now - (z.last[m] or 0) >= z.cooldown then
						seen[m] = true
						z.last[m] = now
						local kb
						if z.knockback > 0 then
							local r = Core.root(m)
							local away = r and (r.Position - z.part.Position) * Vector3.new(1, 0, 1)
							kb = away and away.Magnitude > 0.1 and away.Unit * z.knockback or nil
						end
						Health.damage(m, z.damage, z.part, { knockback = kb, ignoreInvuln = z.damage == math.huge })
						z.Hit:Fire(m)
					end
				end
			end
		end
		if next(zones) == nil then
			scanner = nil
			return false
		end
		return true
	end)
end

-- Hazard.zone(part, {damage=25, cooldown=0.6, knockback=0, active=fn() -> bool}) -> z (z.Hit: Signal(model); z:destroy())
function Hazard.zone(part, o)
	o = o or {}
	local z = { part = part, damage = o.damage or 25, cooldown = o.cooldown or 0.6, knockback = o.knockback or 0,
		active = o.active, last = setmetatable({}, { __mode = "k" }), Hit = Signal.new() }
	zones[z] = true
	ensureScanner()
	function z.destroy()
		zones[z] = nil
	end
	z.Destroy = z.destroy
	return z
end

-- Hazard.kill(part, {damage=math.huge (instant kill), cooldown=0.5}) : lava / kill bricks
function Hazard.kill(part, o)
	o = o or {}
	return Hazard.zone(part, { damage = o.damage or math.huge, cooldown = o.cooldown or 0.5 })
end

-- Hazard.spinner({position=Vector3, length=18, thickness=1.2, speed=90 (deg/s), damage=20, knockback=70,
--   color="#FF4B3E", parent}) -> {bar, hub, zone}. Physics motor: the bar really sweeps players.
function Hazard.spinner(o)
	o = o or {}
	local pos = o.position or Vector3.new(0, 3, 0)
	local parent = o.parent or Core.folder("Hazards")
	local hub = Core.part({ Name = "SpinnerHub", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 2, 2),
		Color = "#2B2B33", CanCollide = false, CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Parent = parent })
	local len = o.length or 18
	local t = o.thickness or 1.2
	local bar = Core.part({ Name = "SpinnerBar", Size = Vector3.new(len, t, t), Color = o.color or "#FF4B3E",
		Material = Enum.Material.Neon, Anchored = false, CFrame = CFrame.new(pos), Parent = parent })
	local a0 = Instance.new("Attachment")
	a0.CFrame = CFrame.Angles(0, 0, math.rad(90)) -- hinge axis = world Y
	a0.Parent = bar
	local a1 = Instance.new("Attachment")
	a1.CFrame = CFrame.new()
	a1.Parent = hub
	local hinge = Instance.new("HingeConstraint")
	hinge.Attachment0, hinge.Attachment1 = a0, a1
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.AngularVelocity = math.rad(o.speed or 90)
	hinge.MotorMaxTorque = 1e9
	hinge.MotorMaxAcceleration = 1e4
	hinge.Parent = bar
	pcall(function()
		bar:SetNetworkOwner(nil)
	end)
	local zone = Hazard.zone(bar, { damage = o.damage or 20, knockback = o.knockback or 70, cooldown = 0.8 })
	return { bar = bar, hub = hub, zone = zone }
end

-- Hazard.laser({from=Vector3, to=Vector3, on=1.5, off=1.5, warn=0.4, damage=100, width=0.4, color="#FF3355",
--   phase=0, parent}) -> {part, zone}: blinks on/off; harmless (and faint) while off, flickers during `warn`
function Hazard.laser(o)
	o = o or {}
	local a, b = o.from or Vector3.new(-10, 3, 0), o.to or Vector3.new(10, 3, 0)
	local len = (b - a).Magnitude
	local w = o.width or 0.4
	local part = Core.part({ Name = "Laser", Size = Vector3.new(w, w, len), Color = o.color or "#FF3355",
		Material = Enum.Material.Neon, CanCollide = false, CastShadow = false,
		CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2), Parent = o.parent or Core.folder("Hazards") })
	local on = false
	local zone = Hazard.zone(part, { damage = o.damage or 100, cooldown = 0.5, active = function()
		return on
	end })
	task.spawn(function()
		task.wait(o.phase or 0)
		while part.Parent do
			on = true
			part.Transparency = 0
			task.wait(o.on or 1.5)
			on = false
			part.Transparency = 0.9
			local offT, warnT = o.off or 1.5, math.min(o.warn or 0.4, o.off or 1.5)
			task.wait(offT - warnT)
			local tEnd = os.clock() + warnT
			while os.clock() < tEnd and part.Parent do
				part.Transparency = part.Transparency > 0.5 and 0.4 or 0.9
				task.wait(0.08)
			end
		end
	end)
	return { part = part, zone = zone }
end

-- Hazard.crusher(part? | nil, {position, size=Vector3.new(8,2,8), drop=10, down=0.25, hold=0.5, up=1.2,
--   pause=1, damage=100, phase=0, color="#5A5A66", parent}) -> {part, zone}: slams down, rises slowly
function Hazard.crusher(part, o)
	if type(part) == "table" and o == nil then
		o, part = part, nil
	end
	o = o or {}
	part = part or Core.part({ Name = "Crusher", Size = o.size or Vector3.new(8, 2, 8), Color = o.color or "#5A5A66",
		Material = Enum.Material.Metal, CFrame = CFrame.new(o.position or Vector3.new(0, 12, 0)), Parent = o.parent or Core.folder("Hazards") })
	part.Anchored = true
	local top = part.CFrame
	local bottom = top - Vector3.new(0, o.drop or 10, 0)
	local moving = false
	local zone = Hazard.zone(part, { damage = o.damage or 100, cooldown = 0.5, active = function()
		return moving
	end })
	task.spawn(function()
		task.wait(o.phase or 0)
		while part.Parent do
			moving = true
			local tw = TweenService:Create(part, TweenInfo.new(o.down or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = bottom })
			tw:Play()
			tw.Completed:Wait()
			task.wait(o.hold or 0.5)
			moving = false
			tw = TweenService:Create(part, TweenInfo.new(o.up or 1.2, Enum.EasingStyle.Sine), { CFrame = top })
			tw:Play()
			tw.Completed:Wait()
			task.wait(o.pause or 1)
		end
	end)
	return { part = part, zone = zone }
end

-- Maid-friendly aliases (maid:Give(obj) calls obj:Destroy())
Mover.Destroy = Mover.destroy
Door.Destroy = Door.destroy

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">LevelKit</string>
          <string name="Source"><![CDATA[--!nonstrict
-- LevelKit: one call builds a complete, dressed, gameplay-ready level from the other kits, so a game starts from a
-- crafted world instead of a pile of kit pieces. Server or edit mode; deterministic for a seed.
--
--   local info = LevelKit.build("sky_islands", {look = "toon_bright", seed = 7})
--
-- Live lesson that made this exist (Starbloom): a builder composed WorldKit islands itself and got islands in a
-- straight line, a garish orange grade, the player spawned on water beside a floating island and props clumped in
-- the middle. Every piece was fine; the LAYOUT was the problem. LevelKit owns the layout: a hub the player spawns ON,
-- further islands rising in an arc around it, jumpable stepping paths between them, dressing in clusters at the rims
-- (never on the paths or the spawn), and every gameplay spot tagged and returned.
--
-- Tags (CollectionService) + attributes on what it builds:
--   KitCheckpoint (Index)  one pad per island (hub = 1, at the spawn)
--   KitCoin (Value)        coins arcing over every jump and ringing the goal pedestals
--   KitGoal (Island, Final) a star per island; Final=true on the crown island's star
--   KitHazard (Damage)     thorn patches (touch parts, CanCollide off): GameplayKit Hazard.kill/zone them
--   KitMover / KitCrumble  stepping platforms at difficulty >= 2 / >= 3: run WorldKit2.animate() at runtime

local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")

local Kit = script.Parent
local LookKit = require(Kit:WaitForChild("LookKit"))
local WK2 = require(Kit:WaitForChild("WorldKit2"))

local LevelKit = {}
LevelKit.kinds = { "sky_islands", "meadow_course", "arena", "town" }

local V3 = Vector3.new
local CF = CFrame.new
local M = Enum.Material
local PI = math.pi
local FLAT = V3(1, 0, 1)
local T = Workspace.Terrain
local H = WK2._helpers

-- per look: terrain materials (top / band / body) and dressing (trees in rim clusters, small props around them)
local DRESS = {
	toon_bright = { top = M.Grass, band = M.Ground, body = M.Rock,
		trees = { { "round_tree", 4 }, { "blossom", 1 }, { "pine", 1 } },
		small = { { "bush", 3 }, { "flowers", 4 }, { "mushroom", 1 }, { "rock", 1 } } },
	cozy = { top = M.Grass, band = M.Ground, body = M.Rock,
		trees = { { "round_tree", 3 }, { "blossom", 2 } },
		small = { { "bush", 3 }, { "flowers", 5 }, { "mushroom", 1 } }, lanterns = true },
	candy = { top = M.Grass, band = M.Ground, body = M.Rock,
		trees = { { "lollipop", 3 }, { "blossom", 2 }, { "candy_cane", 2 } },
		small = { { "gumdrop", 3 }, { "flowers", 3 }, { "mushroom", 1 } } },
	realistic = { top = M.Grass, band = M.Ground, body = M.Rock,
		trees = { { "pine", 3 }, { "round_tree", 2 } },
		small = { { "rock", 2, { moss = true } }, { "bush", 3 }, { "grass", 3 } } },
	snow = { top = M.Snow, band = M.Rock, body = M.Slate,
		trees = { { "pine", 4, { snow = true } } },
		small = { { "rock", 2 }, { "snowman", 1 }, { "bush", 1 } } },
	desert = { top = M.Sand, band = M.Sandstone, body = M.Sandstone,
		trees = { { "palm", 2 }, { "cactus", 3 } },
		small = { { "rock", 3 }, { "bush", 1 } } },
	dark_fantasy = { top = M.Grass, band = M.Ground, body = M.Slate,
		trees = { { "dead_tree", 3 }, { "pine", 2 } },
		small = { { "rock", 3, { moss = true } }, { "mushroom", 2 }, { "crystal", 1 } }, lanterns = true },
	neon_night = { top = M.Grass, band = M.Rock, body = M.Basalt,
		trees = { { "crystal", 3, { height = 9 } }, { "palm", 1 } },
		small = { { "crystal", 2 }, { "rock", 1 } }, lanterns = true },
	space = { top = M.Basalt, band = M.Rock, body = M.Basalt,
		trees = { { "crystal", 3, { height = 10 } } },
		small = { { "rock", 3 }, { "crystal", 2 } }, lanterns = true, noWater = true },
}

local function tag(inst, t, attrs)
	CollectionService:AddTag(inst, t)
	for k, v in pairs(attrs or {}) do
		inst:SetAttribute(k, v)
	end
	return inst
end

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function pick(r, list)
	local total = 0
	for _, k in ipairs(list) do total += k[2] or 1 end
	local x = r:NextNumber(0, total)
	for _, k in ipairs(list) do
		x -= k[2] or 1
		if x <= 0 then return k end
	end
	return list[1]
end

local function o_or(v, d)
	if v == nil then return d end
	return v
end

local function angleOf(v)
	return math.atan2(v.Z, v.X)
end

local function angDist(a, b)
	local d = (a - b) % (2 * PI)
	return math.min(d, 2 * PI - d)
end

-- ---------------------------------------------------------------------------------------------------- terrain

-- A sky island: a flat walkable grass top at y = pos.Y (radius r), a soil band, and a rock body tapering to a point.
-- Low rim hills only away from the exits, so paths always leave from flat ground.
local function skyIsland(L, pos, r, exits, floating)
	local d, rr = L.dress, L.r
	T:FillCylinder(CF(pos - V3(0, 2.5, 0)), 5, r, d.top)
	T:FillCylinder(CF(pos - V3(0, 7.5, 0)), 6, r * 0.97, d.band)
	if floating then
		-- every ball's top stays under the soil band (live, first try: rock domes rose 20 studs over the grass top
		-- and the player spawned on a boulder)
		local y = pos.Y - 6
		for k = 1, 5 do
			local lr = r * (0.95 - k * 0.15)
			for _ = 1, 3 do
				local off = V3(rr:NextNumber(-0.2, 0.2) * lr, 0, rr:NextNumber(-0.2, 0.2) * lr)
				local br = lr * rr:NextNumber(0.75, 0.95)
				T:FillBall(V3(pos.X, math.min(y - lr * 0.5, pos.Y - 6 - br), pos.Z) + off, br, d.body)
			end
			y -= lr * 0.75
		end
		for _ = 1, 3 do -- hanging rocks under the rim give the silhouette some bite
			local a = rr:NextNumber(0, 2 * PI)
			local p = pos + V3(math.cos(a) * r * 0.6, -17 - rr:NextNumber(0, r * 0.25), math.sin(a) * r * 0.6)
			T:FillBall(p, r * rr:NextNumber(0.14, 0.22), d.body)
		end
	else
		-- a plateau rising from the valley floor (y = L.floorY): wider at the foot, cliff sides
		local h = pos.Y - 10 - L.floorY
		if h > 0 then
			T:FillCylinder(CF(pos.X, L.floorY + h / 2 - 2, pos.Z), h + 4, r * 0.98, d.body)
			T:FillCylinder(CF(pos.X, L.floorY + h * 0.2, pos.Z), h * 0.4 + 4, r * 1.12, d.body)
		end
	end
	for _ = 1, 3 do
		local a = rr:NextNumber(0, 2 * PI)
		local ok = true
		for _, e in ipairs(exits) do
			if angDist(a, e) < 0.9 then ok = false end
		end
		if ok then
			local R = r * rr:NextNumber(0.2, 0.28)
			T:FillBall(pos + V3(math.cos(a) * r * 0.74, -R * 0.62, math.sin(a) * r * 0.74), R, d.top)
		end
	end
end

local function ground(L, x, z, near)
	local hit, mat = WK2.groundAt(x, z, { top = (near or 300) + 60, bottom = (near or 0) - 80 })
	if hit and mat ~= M.Water and (not near or math.abs(hit.Y - near) < 7) then
		return hit
	end
	-- Terrain filled a moment ago is not always raycastable yet (live, first build of a place: every island came out
	-- bare). The island tops are flat at `near` by construction, so stand there.
	if near and not hit then
		return V3(x, near, z)
	end
	return nil
end

-- ---------------------------------------------------------------------------------------------------- pieces

local function prop(L, kind, pos, o)
	o = o or {}
	o.position = pos
	o.rotation = o.rotation or L.r:NextNumber(0, 360)
	o.seed = o.seed or L.r:NextInteger(1, 1e6)
	o.parent = o.parent or L.dressF
	o.palette = o.palette or L.o.palette
	return WK2.prop(kind, o)
end

local function cloud(L, pos, s)
	local m = Instance.new("Model")
	m.Name = "Cloud"
	local white = Color3.new(1, 1, 1):Lerp(L.pal.sky, 0.12)
	for i = 1, 5 do
		local a = i / 5 * 2 * PI + L.r:NextNumber(-0.3, 0.3)
		local ss = s * L.r:NextNumber(0.45, 0.7)
		local p = H.blob(m, V3(ss * 1.4, ss * 0.7, ss), CF(pos + V3(math.cos(a) * s * 0.45, L.r:NextNumber(-0.1, 0.25) * s,
			math.sin(a) * s * 0.3)), i % 2 == 0 and white or white:Lerp(Color3.new(1, 1, 1), 0.5), M.SmoothPlastic)
		p.CanCollide = false
		p.CanQuery = false
		p.CastShadow = false
	end
	m.Parent = L.decoF
	return m
end

-- a gold star (goal) floating over a small pedestal; the star's core is the touch part tagged KitGoal
local function star(L, pos, index, final)
	local m = Instance.new("Model")
	m.Name = final and "CrownStar" or ("Star" .. index)
	local pal = L.pal
	local s = final and 1.6 or 1
	H.vcyl(m, 1.2, 6 * s, CF(pos + V3(0, 0.6, 0)), pal.trim, LookKit.mat("stone"))
	H.vcyl(m, 0.4, 7 * s, CF(pos + V3(0, 0.2, 0)), pal.gold, LookKit.mat("default"))
	local c = pos + V3(0, 5 * s, 0)
	local core = H.ball(m, 2.2 * s, CF(c), pal.gold, M.Neon)
	for k = 0, 4 do
		local arm = H.wedge(m, V3(0.9 * s, 2.6 * s, 1.4 * s), CF(c) * CFrame.Angles(0, 0, k * 2 * PI / 5) * CF(0, 1.9 * s, 0),
			pal.gold, M.Neon)
		arm.CanCollide = false
		local arm2 = H.wedge(m, V3(0.9 * s, 2.6 * s, 1.4 * s), CF(c) * CFrame.Angles(0, PI, -k * 2 * PI / 5) * CF(0, 1.9 * s, 0),
			pal.gold, M.Neon)
		arm2.CanCollide = false
	end
	core.CanCollide = false
	core.CanTouch = true
	H.light(core, pal.gold, 2, 18)
	m.PrimaryPart = core
	tag(core, "KitGoal", { Island = index, Final = final == true })
	m.Parent = L.playF
	return core
end

local function checkpoint(L, pos, index)
	local m = Instance.new("Model")
	m.Name = "Checkpoint" .. index
	local pad = H.vcyl(m, 0.6, 9, CF(pos + V3(0, 0.1, 0)), L.pal.trim, LookKit.mat("stone"))
	local ring = H.vcyl(m, 0.3, 7.4, CF(pos + V3(0, 0.45, 0)), L.pal.secondary, M.Neon)
	ring.CanCollide = false
	ring.CastShadow = false
	m.PrimaryPart = pad
	tag(pad, "KitCheckpoint", { Index = index })
	m.Parent = L.playF
	WK2.prop("flag", { position = pos + V3(5, 0, 0), color = L.pal.secondary, height = 9, parent = m, palette = L.o.palette })
	table.insert(L.info.checkpoints, pos + V3(0, 3, 0))
	return pad
end

local function thorns(L, pos, radius)
	local m = Instance.new("Model")
	m.Name = "Thorns"
	local base = H.vcyl(m, 0.5, radius * 2, CF(pos + V3(0, 0.05, 0)), L.pal.woodDark, LookKit.mat("ground"))
	base.CanCollide = false
	for _ = 1, math.floor(radius * 2.2) do
		local a, d = L.r:NextNumber(0, 2 * PI), L.r:NextNumber(0, radius * 0.85)
		local h = L.r:NextNumber(1.6, 3)
		local spike = H.wedge(m, V3(0.7, h, 0.7), CF(pos + V3(math.cos(a) * d, h / 2, math.sin(a) * d))
			* CFrame.Angles(L.r:NextNumber(-0.25, 0.25), L.r:NextNumber(0, 2 * PI), 0), L.pal.danger, LookKit.mat("default"))
		spike.CanCollide = false
	end
	local hit = H.box(m, V3(radius * 2, 3, radius * 2), CF(pos + V3(0, 1.5, 0)), L.pal.danger, M.SmoothPlastic)
	hit.Transparency = 1
	hit.CanCollide = false
	hit.Name = "HazardZone"
	tag(hit, "KitHazard", { Damage = 25 })
	m.Parent = L.playF
	table.insert(L.info.hazards, { kind = "thorns", part = hit, position = pos, radius = radius })
	return hit
end

local function coin(L, pos)
	WK2.prop("coin", { position = pos, parent = L.coinF, palette = L.o.palette })
	table.insert(L.info.collectibles, pos)
end

-- Stepping platforms from island a's rim to island b's rim, bowed sideways so the path arcs. Gaps and rises are
-- player-scale (never scaled with the level): edge gaps 4..8 studs by difficulty, rises <= 3.5.
local function steps(L, a, b, bow)
	local pal, diff, r = L.pal, L.diff, L.r
	local dir = ((b.center - a.center) * FLAT).Unit
	local side = dir:Cross(V3(0, 1, 0))
	local p0 = a.center + dir * (a.radius - 1)
	local p1 = b.center - dir * (b.radius - 1)
	p0 = V3(p0.X, a.top.Y, p0.Z)
	p1 = V3(p1.X, b.top.Y, p1.Z)
	local len = ((p1 - p0) * FLAT).Magnitude
	local size = math.max(8, 13 - diff)
	local gap = 3.5 + diff * 1.1
	local n = math.max(1, math.floor(len / (size + gap) + 0.5) - 1)
	while math.abs(p1.Y - p0.Y) / (n + 1) > 3.5 do
		n += 1
	end
	local m = Instance.new("Model")
	m.Name = "Path_" .. a.name .. "_" .. b.name
	m.Parent = L.pathF
	local cols = { pal.accent, pal.secondary, pal.primary }
	local prev = p0
	local pts = {}
	for k = 1, n do
		local t = k / (n + 1)
		local pos = p0:Lerp(p1, t) + side * bow * len * math.sin(t * PI) + V3(0, r:NextNumber(-0.4, 0.4), 0)
		local col = cols[(k - 1) % #cols + 1]:Lerp(Color3.new(1, 1, 1), 0.12)
		local pm = WK2.prop("platform", { position = pos, size = size + r:NextNumber(-1, 1), color = col, parent = m,
			seed = r:NextInteger(1, 1e6), palette = L.o.palette })
		if diff >= 2 and n >= 3 and k == math.ceil(n / 2) then
			pm.Name = "Platform_moving"
			tag(pm, "KitMover", { MoveOffset = side * (4 + diff), MovePeriod = 4.6 - diff * 0.3 })
		elseif diff >= 3 and n >= 4 and k == n - 1 then
			pm.Name = "Platform_crumble"
			tag(pm, "KitCrumble")
		end
		table.insert(pts, pos)
		-- coins arc over each jump
		for c = 1, 2 do
			local tt = c / 3
			coin(L, prev:Lerp(pos, tt) + V3(0, 3.2 + 2.5 * math.sin(tt * PI), 0))
		end
		prev = pos
	end
	for c = 1, 2 do
		local tt = c / 3
		coin(L, prev:Lerp(p1, tt) + V3(0, 3.2 + 2.5 * math.sin(tt * PI), 0))
	end
	-- gateway lamps on both rims: the path reads from far away
	for _, e in ipairs({ { p0, dir, a }, { p1, -dir, b } }) do
		local at, d = e[1], e[2]
		for _, sgn in ipairs({ -1, 1 }) do
			local q = at - d * 4 + d:Cross(V3(0, 1, 0)) * sgn * 7
			local g = ground(L, q.X, q.Z, at.Y)
			if g then
				prop(L, "lamp", g, { height = 8, rotation = 0 })
			end
		end
	end
	table.insert(L.info.courses, { from = a.name, to = b.name, platforms = pts, model = m })
	return pts
end

-- trees in clusters at the rim, away from exits and the spawn; small props around each cluster; flower patches
local function dress(L, isl, exits, keepClear)
	local r, d = L.r, L.dress
	local nClusters = math.clamp(math.floor(isl.radius / 8), 3, 6)
	local placed = {}
	local function free(p, gap)
		for _, q in ipairs(placed) do
			if ((q - p) * FLAT).Magnitude < gap then return false end
		end
		for _, kc in ipairs(keepClear) do
			if ((kc[1] - p) * FLAT).Magnitude < kc[2] then return false end
		end
		return true
	end
	local tries = 0
	local clusters = 0
	while clusters < nClusters and tries < 40 do
		tries += 1
		local a = r:NextNumber(0, 2 * PI)
		local ok = true
		for _, e in ipairs(exits) do
			if angDist(a, e) < 0.75 then ok = false end
		end
		if ok then
			clusters += 1
			local cdist = isl.radius * r:NextNumber(0.6, 0.78)
			local cc = isl.center + V3(math.cos(a) * cdist, 0, math.sin(a) * cdist)
			local nt = r:NextInteger(2, 4)
			for _ = 1, nt * 3 do
				if nt <= 0 then break end
				local p = cc + V3(r:NextNumber(-1, 1) * 9, 0, r:NextNumber(-1, 1) * 9)
				if ((p - isl.center) * FLAT).Magnitude < isl.radius * 0.9 and free(p, 8) then
					local g = ground(L, p.X, p.Z, isl.top.Y)
					if g then
						local k = pick(r, d.trees)
						local o = {}
						for kk, vv in pairs(k[3] or {}) do o[kk] = vv end
						o.scale = o.scale or r:NextNumber(1.05, 1.5)
						prop(L, k[1], g - V3(0, 0.3, 0), o)
						table.insert(placed, p)
						nt -= 1
					end
				end
			end
			for _ = 1, r:NextInteger(3, 5) do
				local aa, dd = r:NextNumber(0, 2 * PI), r:NextNumber(6, 13)
				local p = cc + V3(math.cos(aa) * dd, 0, math.sin(aa) * dd)
				if ((p - isl.center) * FLAT).Magnitude < isl.radius * 0.92 and free(p, 3.5) then
					local g = ground(L, p.X, p.Z, isl.top.Y)
					if g then
						local k = pick(r, d.small)
						local o = {}
						for kk, vv in pairs(k[3] or {}) do o[kk] = vv end
						prop(L, k[1], g - V3(0, 0.2, 0), o)
						table.insert(placed, p)
					end
				end
			end
		end
	end
	-- flower patches in the open (they never collide)
	for _ = 1, math.floor(isl.radius / 8) do
		local aa, dd = r:NextNumber(0, 2 * PI), r:NextNumber(0.25, 0.85) * isl.radius
		local p = isl.center + V3(math.cos(aa) * dd, 0, math.sin(aa) * dd)
		local g = ground(L, p.X, p.Z, isl.top.Y)
		if g and free(p, 4) then
			prop(L, d.top == M.Grass and "flowers" or pick(r, d.small)[1], g - V3(0, 0.1, 0), { count = 7 })
		end
	end
	if d.lanterns then
		for _ = 1, 2 do
			local aa = r:NextNumber(0, 2 * PI)
			WK2.lantern({ position = isl.top + V3(math.cos(aa) * isl.radius * 0.5, r:NextNumber(9, 13),
				math.sin(aa) * isl.radius * 0.5), color = L.pal.glow, size = 2.6, parent = L.dressF })
		end
	end
end

-- ---------------------------------------------------------------------------------------------------- layouts

local function newLevel(kind, o)
	o = o or {}
	local look = o.look or LookKit.current or "toon_bright"
	if o.applyLook ~= false then
		LookKit.apply(look, o.lookOverrides or (o.palette and { palette = o.palette }) or nil)
	end
	local parentRoot = o.parent or Workspace:FindFirstChild("StudioWorld") or Workspace
	local name = o.name or "Level"
	local old = parentRoot:FindFirstChild(name)
	if old then old:Destroy() end
	if o.clearTerrain ~= false then
		T:Clear()
	end
	local root = folder(name, parentRoot)
	root:SetAttribute("LevelKind", kind)
	local L = {
		o = o, kind = kind, look = look, seed = o.seed or 7, r = Random.new(o.seed or 7), scale = o.scale or 1,
		diff = math.clamp(o.difficulty or 1, 1, 4), pal = LookKit.palette,
		dress = DRESS[look] or DRESS.toon_bright, root = root,
		info = { kind = kind, look = look, folder = root, islands = {}, courses = {}, checkpoints = {}, collectibles = {},
			goals = {}, hazards = {} },
	}
	L.dressF = folder("Dressing", root)
	L.pathF = folder("Paths", root)
	L.playF = folder("Gameplay", root)
	L.coinF = folder("Coins", L.playF)
	L.decoF = folder("Sky", root)
	return L
end

local function finish(L, spawnPos)
	local info = L.info
	-- Place the spawn exactly where the layout says (claimSpawn's own raycast hits STALE terrain right after a
	-- rebuild: live in edit mode, a meadow rebuilt over a sky level put the spawn 77 studs up in the air).
	local spawn = WK2.claimSpawn(spawnPos, true)
	spawn.CFrame = CF(spawnPos + V3(0, 0.6, 0))
	local Players = game:GetService("Players")
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then
			plr.Character:PivotTo(CF(spawnPos + V3(0, 4, 0)))
		end
	end
	info.spawn = spawn.Position + V3(0, 3, 0)
	tag(spawn, "KitSpawn")
	local lo, hi = V3(math.huge, math.huge, math.huge), V3(-math.huge, -math.huge, -math.huge)
	for _, isl in ipairs(info.islands) do
		lo = lo:Min(isl.center - V3(isl.radius, isl.radius, isl.radius))
		hi = hi:Max(isl.top + V3(isl.radius, 30, isl.radius))
	end
	info.bounds = { min = lo, max = hi }
	L.root:SetAttribute("Spawn", info.spawn)
	L.root:SetAttribute("BoundsMin", lo)
	L.root:SetAttribute("BoundsMax", hi)
	return info
end

-- The arc: islands around the hub at increasing angle, distance and height, so from the hub every island is in
-- view (no "tower" from the spawn camera) and the overview reads as a rising crescent.
local function arcLayout(L, hubCenter, hubR, count, rise0, floating)
	local r, S = L.r, L.scale
	local isls = {}
	local hub = { name = "Hub", center = hubCenter, radius = hubR, top = hubCenter }
	table.insert(isls, hub)
	local a0 = r:NextNumber(0, 2 * PI)
	local sweep = math.rad(o_or(L.o.arc, 200))
	for i = 1, count do
		local final = i == count
		local a = a0 + (i - 0.5) / count * sweep + r:NextNumber(-0.08, 0.08)
		local dist = (108 + i * 24) * S
		local rad = (final and 30 or r:NextNumber(26, 34)) * math.sqrt(S)
		local y = hubCenter.Y + rise0 + (i - 1) * 13 * S + r:NextNumber(-2, 2)
		local c = hubCenter + V3(math.cos(a) * dist, 0, math.sin(a) * dist)
		c = V3(c.X, y, c.Z)
		table.insert(isls, { name = final and "Crown" or ("Island" .. i), center = c, radius = rad, top = c, final = final })
	end
	-- exits: each island leaves toward the next and arrives from the previous
	for i, isl in ipairs(isls) do
		isl.exits = {}
		if isls[i - 1] then table.insert(isl.exits, angleOf(isls[i - 1].center - isl.center)) end
		if isls[i + 1] then table.insert(isl.exits, angleOf(isls[i + 1].center - isl.center)) end
	end
	local _ = floating
	return isls
end

local function islandsLevel(L, floating)
	local S, r, info, pal = L.scale, L.r, L.info, L.pal
	local count = math.clamp(L.o.islands or 4, 2, 7)
	local hubR = 46 * math.sqrt(S)
	local hubY = floating and 70 * S or 0
	L.floorY = 0
	local hubCenter = V3(0, hubY, 0)
	local isls = arcLayout(L, hubCenter, hubR, count, floating and 12 or 12, floating)
	-- terrain
	if floating then
		if not L.dress.noWater then
			T:FillBlock(CF(0, -30, 0), V3(4096, 60, 4096), M.Water)
			-- seen from above the whole sea is one flat colour: a deeper shade than the look's shore water keeps
			-- it from washing the frame out (live, first try: toon_bright read as a neon-cyan plane)
			T.WaterColor = L.pal.water:Lerp(Color3.new(0, 0.05, 0.15), 0.4)
		end
	else
		-- the valley: a wide grass floor, a ring of big hills for walls
		local R = 340 * S
		T:FillCylinder(CF(0, -6, 0), 12, R, L.dress.top)
		T:FillCylinder(CF(0, -16, 0), 10, R, L.dress.band)
		for k = 1, 14 do
			local a = k / 14 * 2 * PI + r:NextNumber(-0.15, 0.15)
			local HR = r:NextNumber(55, 85) * S
			T:FillBall(V3(math.cos(a) * R * 0.98, -HR * 0.45, math.sin(a) * R * 0.98), HR, L.dress.top)
		end
	end
	for i, isl in ipairs(isls) do
		if floating or i > 1 then
			skyIsland(L, isl.center, isl.radius, isl.exits, floating)
		end
	end
	-- spawn on the hub, facing the first path
	local first = isls[2]
	local toFirst = ((first.center - hubCenter) * FLAT).Unit
	local spawnXZ = hubCenter - toFirst * hubR * 0.25
	local spawnG = V3(spawnXZ.X, hubCenter.Y, spawnXZ.Z) -- the hub top is flat at hubCenter.Y by construction
	-- paths
	for i = 1, #isls - 1 do
		local bow = (i % 2 == 0 and 1 or -1) * 0.12
		steps(L, isls[i], isls[i + 1], bow)
	end
	-- islands: dressing, checkpoints, stars, hazards
	for i, isl in ipairs(isls) do
		local keep = {}
		local arrive = isls[i - 1] and ((isls[i - 1].center - isl.center) * FLAT).Unit or -toFirst
		local cp = i == 1 and spawnG or (isl.center + arrive * isl.radius * 0.55)
		local cpG = ground(L, cp.X, cp.Z, isl.top.Y) or cp
		table.insert(keep, { cpG, i == 1 and 16 or 9 })
		-- the walking line across the island stays clear
		if isls[i + 1] then
			local leave = ((isls[i + 1].center - isl.center) * FLAT).Unit
			for t = -1, 1, 0.25 do
				table.insert(keep, { isl.center + leave * isl.radius * t, 7 })
			end
		end
		for t = -1, 0, 0.25 do
			table.insert(keep, { isl.center + arrive * isl.radius * t, 7 })
		end
		local starPos
		if i > 1 then
			local sideDir = arrive:Cross(V3(0, 1, 0)) * (i % 2 == 0 and 1 or -1)
			local sp = isl.final and isl.center or (isl.center + sideDir * isl.radius * 0.4)
			starPos = ground(L, sp.X, sp.Z, isl.top.Y) or sp
			table.insert(keep, { starPos, isl.final and 14 or 8 })
		end
		if i > 1 and not isl.final then
			local hz = isl.center - arrive:Cross(V3(0, 1, 0)) * (i % 2 == 0 and 1 or -1) * isl.radius * 0.4
			local hg = ground(L, hz.X, hz.Z, isl.top.Y)
			if hg then
				thorns(L, hg, 4.5)
				table.insert(keep, { hg, 8 })
			end
		end
		dress(L, isl, isl.exits, keep)
		checkpoint(L, cpG, i)
		if starPos then
			local core = star(L, starPos, i, isl.final)
			table.insert(info.goals, core.Position)
			if isl.final then
				info.goal = core.Position
				-- the crown: a ring of pillars around the final star, a landmark seen from the hub
				for k = 1, 6 do
					local a = k / 6 * 2 * PI
					local p = isl.center + V3(math.cos(a) * 13, 0, math.sin(a) * 13)
					local g = ground(L, p.X, p.Z, isl.top.Y)
					if g then
						WK2.prop("pillar", { position = g - V3(0, 0.3, 0), height = 12, parent = L.playF, palette = L.o.palette })
						local tip = g + V3(0, 12.6, 0)
						local orb = H.ball(L.playF, 1.6, CF(tip + V3(0, 0.8, 0)), pal.gold, M.Neon)
						orb.CastShadow = false
					end
				end
			end
			for k = 1, 6 do -- a coin ring around every star
				local a = k / 6 * 2 * PI
				coin(L, starPos + V3(math.cos(a) * 6, 3, math.sin(a) * 6))
			end
		end
		table.insert(info.islands, { name = isl.name, top = ground(L, isl.center.X, isl.center.Z, isl.top.Y) or isl.top,
			center = isl.center, radius = isl.radius })
	end
	-- spawn dressing: a flag beside the start, a lamp pair already flanks the first path
	WK2.prop("flag", { position = spawnG - toFirst:Cross(V3(0, 1, 0)) * 9, color = pal.primary, height = 14,
		parent = L.dressF, palette = L.o.palette })
	-- sky dressing: cloud puffs below / around the islands, a few floating rocks
	if floating and L.look ~= "space" then
		for k = 1, 14 do
			local a = r:NextNumber(0, 2 * PI)
			local d = r:NextNumber(90, 330) * S
			cloud(L, V3(math.cos(a) * d, hubY - r:NextNumber(18, 45) * S, math.sin(a) * d), r:NextNumber(18, 34))
		end
	end
	if not floating then
		-- the valley floor: clustered trees and props, kept off the paths, the plateaus and the hub
		local blockers = {}
		for _, c in ipairs(info.courses) do
			for _, p in ipairs(c.platforms) do table.insert(blockers, { p, 14 }) end
		end
		for _, isl in ipairs(isls) do table.insert(blockers, { isl.center, isl.radius + 8 }) end
		for _, set in ipairs({ { L.dress.trees, 70 }, { L.dress.small, 60 } }) do
			for _, m in ipairs(WK2.populate({ center = V3(0, 0, 0), size = 600 * S, kinds = set[1], count = set[2],
				clusters = 12, seed = L.seed + set[2], parent = L.dressF, palette = L.o.palette })) do
				local p = m:GetPivot().Position
				local bad = p.Magnitude > 330 * S or (p.Y > 3 and p.Magnitude < 240 * S) -- stale-raycast guard
				for _, b in ipairs(blockers) do
					if ((b[1] - p) * FLAT).Magnitude < b[2] then bad = true; break end
				end
				if bad then m:Destroy() end
			end
		end
	end
	if floating then
		for k = 1, 8 do
			local isl = isls[r:NextInteger(1, #isls)]
			local a = r:NextNumber(0, 2 * PI)
			local d = isl.radius + r:NextNumber(10, 30)
			T:FillBall(isl.center + V3(math.cos(a) * d, r:NextNumber(-25, -5), math.sin(a) * d), r:NextNumber(3, 6),
				L.dress.body)
		end
	end
	return finish(L, spawnG)
end

-- ---------------------------------------------------------------------------------------------------- wrappers

local function arenaLevel(L)
	local S = L.scale
	local size = 170 * S
	local R = size * 1.4
	T:FillCylinder(CF(0, -6, 0), 12, R, L.dress.top)
	T:FillCylinder(CF(0, -16, 0), 10, R, L.dress.band)
	for k = 1, 12 do
		local a = k / 12 * 2 * PI + L.r:NextNumber(-0.2, 0.2)
		local HR = L.r:NextNumber(45, 70) * S
		T:FillBall(V3(math.cos(a) * R * 0.95, -HR * 0.4, math.sin(a) * R * 0.95), HR, L.dress.top)
	end
	local style = L.o.style or (L.look == "neon_night" or L.look == "space") and "scifi"
		or (L.look == "dark_fantasy" or L.look == "cozy") and "fantasy" or (LookKit.isToon and "toon" or "military")
	local ar = WK2.arena({ center = V3(0, 0, 0), size = size, style = style, seed = L.seed, parent = L.root,
		palette = L.o.palette, spawns = L.o.spawns or 8 })
	L.info.arena = ar
	L.info.spawns = ar.spawns
	-- dressing outside the walls only
	local made = WK2.populate({ center = V3(0, 0, 0), size = R * 1.8, kinds = L.dress.trees, count = 60, clusters = 10,
		clear = size * 0.75, seed = L.seed, parent = L.dressF, palette = L.o.palette })
	local _ = made
	WK2.populate({ center = V3(0, 0, 0), size = R * 1.8, kinds = L.dress.small, count = 50, clusters = 10,
		clear = size * 0.75, seed = L.seed + 1, parent = L.dressF, palette = L.o.palette })
	table.insert(L.info.islands, { name = "Arena", top = V3(0, 0, 0), center = V3(0, 0, 0), radius = size / 2 })
	local sp = ar.spawns and ar.spawns[1]
	return finish(L, sp and sp.Position or V3(0, 1, 0))
end

local function townLevel(L)
	local S = L.scale
	local blocks = L.o.blocks or 3
	local style = L.o.style or (L.look == "neon_night" and "neon") or (L.look == "dark_fantasy" and "medieval")
		or (L.look == "desert" and "western") or "suburb"
	local span = blocks * 56 + (blocks + 1) * 16
	local R = span * 0.9 + 80 * S
	T:FillCylinder(CF(0, -6, 0), 12, R, L.dress.top)
	T:FillCylinder(CF(0, -16, 0), 10, R, L.dress.band)
	for k = 1, 12 do
		local a = k / 12 * 2 * PI + L.r:NextNumber(-0.2, 0.2)
		local HR = L.r:NextNumber(45, 70) * S
		T:FillBall(V3(math.cos(a) * R * 0.95, -HR * 0.4, math.sin(a) * R * 0.95), HR, L.dress.top)
	end
	local town = WK2.town({ center = V3(0, 0, 0), blocks = blocks, style = style, seed = L.seed, parent = L.root,
		palette = L.o.palette })
	L.info.town = town
	WK2.populate({ center = V3(0, 0, 0), size = R * 1.8, kinds = L.dress.trees, count = 70, clusters = 12,
		clear = span * 0.62, seed = L.seed, parent = L.dressF, palette = L.o.palette })
	WK2.populate({ center = V3(0, 0, 0), size = R * 1.8, kinds = L.dress.small, count = 60, clusters = 12,
		clear = span * 0.62, seed = L.seed + 1, parent = L.dressF, palette = L.o.palette })
	table.insert(L.info.islands, { name = "Town", top = V3(0, 0, 0), center = V3(0, 0, 0), radius = span / 2 })
	return finish(L, town.spawn or V3(0, 1, 0))
end

-- LevelKit.build(kind, opts) -> info. kinds: "sky_islands" | "meadow_course" | "arena" | "town".
-- opts: look (LookKit look; applied unless applyLook=false), lookOverrides, palette, seed=7, scale=1, islands=4,
-- difficulty=1..4, arc=200 (degrees the islands sweep around the hub), parent (default workspace.StudioWorld),
-- name="Level", clearTerrain=true (the level owns the Terrain: build it FIRST, then add on top), style/blocks/spawns
-- (arena, town).
function LevelKit.build(kind, opts)
	kind = kind or "sky_islands"
	local L = newLevel(kind, opts)
	if kind == "sky_islands" or kind == "islands" then
		return islandsLevel(L, true)
	elseif kind == "meadow_course" or kind == "meadow" then
		return islandsLevel(L, false)
	elseif kind == "arena" then
		return arenaLevel(L)
	elseif kind == "town" then
		return townLevel(L)
	end
	warn("[LevelKit] unknown kind " .. tostring(kind) .. "; building sky_islands")
	return islandsLevel(L, true)
end

-- LevelKit.describe(info) -> string: a short readable summary (spawn, islands, spot counts) to print or return
function LevelKit.describe(info)
	local function v(p) return p and string.format("(%d, %d, %d)", p.X, p.Y, p.Z) or "nil" end
	local out = { string.format("%s/%s spawn=%s", info.kind, info.look, v(info.spawn)) }
	for _, isl in ipairs(info.islands) do
		table.insert(out, string.format("  %s top=%s radius=%d", isl.name, v(isl.top), isl.radius))
	end
	table.insert(out, string.format("  %d courses, %d checkpoints, %d coins, %d goals (final %s), %d hazards; bounds %s..%s",
		#info.courses, #info.checkpoints, #info.collectibles, #info.goals, v(info.goal), #info.hazards,
		v(info.bounds.min), v(info.bounds.max)))
	return table.concat(out, "\n")
end

LevelKit.level = LevelKit.build
return LevelKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">LookKit</string>
          <string name="Source"><![CDATA[--!nonstrict
-- LookKit: art direction from configuration. One call makes the whole place read as a look: Lighting, Atmosphere,
-- Sky, post (bloom, grade, sun rays, depth of field), clouds, terrain material colours, water, a part-material
-- palette, and a colour palette the rest of the game reads (LookKit.palette.<role>). Server or edit mode.
--
-- Looks: toon_bright, realistic, cozy, neon_night, dark_fantasy, snow, desert, candy, space.
-- Limits worth knowing (engine, not kit):
--   * Lighting.Technology is not scriptable. "realistic" assumes Future (set it in Studio); every look still reads
--     under ShadowMap/Voxel, just with softer local lights.
--   * MaterialVariant.ColorMap/NormalMap/... are only writable from plugin/command-bar security. LookKit.material
--     tries the variant first and falls back to tiled Texture instances on every face, so the look survives a
--     runtime script either way.
--   * Roblox renders at most 31 Highlights at once; LookKit.outline counts its own and refuses past the budget.
--     Highlight outlines have a fixed screen-space width (no thickness property): thickness is accepted for API
--     stability and ignored. Outline a parent Model once instead of each child to save budget.

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local MaterialService = game:GetService("MaterialService")

local LookKit = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local function hex(h)
	return Color3.fromHex(h)
end

local function c3(v, fallback)
	if typeof(v) == "Color3" then
		return v
	end
	if type(v) == "string" then
		local ok, col = pcall(Color3.fromHex, v)
		if ok then
			return col
		end
	end
	return fallback
end

local M = Enum.Material

-- Roles every look defines (missing ones fall back to BASE_PALETTE). Builders in WorldKit2 colour with these.
local BASE_PALETTE = {
	primary = hex("#e8483a"), secondary = hex("#3b7be0"), accent = hex("#ffc93c"),
	ground = hex("#6fbf4f"), groundAlt = hex("#9fd36a"), dirt = hex("#9c6b44"), rock = hex("#8f8a84"),
	sand = hex("#e9d29a"), wood = hex("#9a6640"), woodDark = hex("#5e3d28"), leaf = hex("#5bb14a"),
	leafAlt = hex("#8fd25b"), blossom = hex("#ff9fc8"), flower = hex("#ffd84a"), water = hex("#2f9fd8"),
	wall = hex("#f1e6d2"), roof = hex("#c9473b"), floor = hex("#c89a6a"), trim = hex("#ffffff"),
	ink = hex("#1b2236"), light = hex("#fff4dc"), glow = hex("#ffd27a"), metal = hex("#b9bec9"),
	path = hex("#d9c08f"), danger = hex("#ff3b3b"), gold = hex("#ffc83a"), sky = hex("#86c8ff"),
	fabric = hex("#d9534f"), snow = hex("#f4f8ff"),
}

-- Part material per role. Toon looks keep SmoothPlastic so colour does the talking.
local TOON_MATS = {
	default = M.SmoothPlastic, ground = M.SmoothPlastic, stone = M.SmoothPlastic, wood = M.SmoothPlastic,
	metal = M.SmoothPlastic, fabric = M.SmoothPlastic, glass = M.Glass, roof = M.SmoothPlastic,
	floor = M.SmoothPlastic, wall = M.SmoothPlastic, glow = M.Neon, leaf = M.SmoothPlastic, road = M.SmoothPlastic,
}
local REAL_MATS = {
	default = M.Plastic, ground = M.Ground, stone = M.Slate, wood = M.Wood, metal = M.Metal, fabric = M.Fabric,
	glass = M.Glass, roof = M.Slate, floor = M.WoodPlanks, wall = M.Plaster, glow = M.Neon, leaf = M.Grass,
	road = M.Asphalt,
}

local function merge(a, b)
	local out = {}
	for k, v in pairs(a or {}) do out[k] = v end
	for k, v in pairs(b or {}) do out[k] = v end
	return out
end

-- ---------------------------------------------------------------------------------------------------- presets
-- lighting: Lighting props. atmosphere/bloom/grade/sunrays/dof/clouds/sky: instance props (dof=false -> removed).
-- terrain: Enum.Material name -> colour. water: Terrain water props. mats: part material per role. palette: roles.
local LOOKS = {}

LOOKS.toon_bright = {
	lighting = { ClockTime = 14.2, GeographicLatitude = 35, Brightness = 3, ExposureCompensation = 0.1,
		Ambient = rgb(138, 138, 158), OutdoorAmbient = rgb(172, 172, 192), ColorShift_Top = rgb(255, 244, 222),
		ColorShift_Bottom = rgb(120, 130, 170), EnvironmentDiffuseScale = 0.4, EnvironmentSpecularScale = 0.1,
		ShadowSoftness = 0.55 },
	atmosphere = { Density = 0.24, Offset = 0.18, Color = rgb(176, 220, 255), Decay = rgb(110, 168, 236),
		Glare = 0.15, Haze = 0.7 },
	sky = { StarCount = 0, SunAngularSize = 20, MoonAngularSize = 11, CelestialBodiesShown = true },
	clouds = { Enabled = true, Cover = 0.55, Density = 0.5, Color = rgb(255, 255, 255) },
	bloom = { Intensity = 0.35, Size = 24, Threshold = 2 },
	grade = { Brightness = 0.03, Contrast = 0.12, Saturation = 0.35, TintColor = rgb(255, 252, 246) },
	sunrays = { Intensity = 0.05, Spread = 0.3 },
	dof = false,
	terrain = { Grass = rgb(92, 200, 72), LeafyGrass = rgb(70, 184, 62), Ground = rgb(176, 122, 72),
		Mud = rgb(140, 96, 60), Rock = rgb(158, 146, 136), Slate = rgb(130, 126, 124), Sand = rgb(250, 226, 150),
		Sandstone = rgb(236, 170, 104), Snow = rgb(250, 252, 255), Basalt = rgb(90, 84, 92), Limestone = rgb(236, 222, 190),
		Cobblestone = rgb(170, 160, 150) },
	water = { WaterColor = rgb(36, 168, 232), WaterTransparency = 0.25, WaterReflectance = 0.3, WaterWaveSize = 0.1,
		WaterWaveSpeed = 8 },
	mats = TOON_MATS,
	palette = { primary = hex("#ff4f3d"), secondary = hex("#3d7bff"), accent = hex("#ffd23c"), ground = hex("#5ccf4a"),
		groundAlt = hex("#a8e05f"), dirt = hex("#b5793f"), rock = hex("#a8a097"), wood = hex("#a8683a"),
		leaf = hex("#4fc443"), leafAlt = hex("#93e05a"), water = hex("#2aa7e8"), wall = hex("#fff3dd"),
		roof = hex("#ef4a3c"), trim = hex("#ffffff"), ink = hex("#1b2340"), gold = hex("#ffc93c"), sky = hex("#7cc8ff") },
	toon = true,
}

LOOKS.realistic = {
	lighting = { ClockTime = 15.3, GeographicLatitude = 40, Brightness = 3.2, ExposureCompensation = -0.1,
		Ambient = rgb(70, 70, 76), OutdoorAmbient = rgb(122, 124, 130), ColorShift_Top = rgb(255, 238, 214),
		ColorShift_Bottom = rgb(60, 64, 72), EnvironmentDiffuseScale = 1, EnvironmentSpecularScale = 1,
		ShadowSoftness = 0.12 },
	atmosphere = { Density = 0.32, Offset = 0.25, Color = rgb(199, 206, 214), Decay = rgb(106, 112, 125),
		Glare = 0.3, Haze = 1.6 },
	sky = { StarCount = 0, SunAngularSize = 11, MoonAngularSize = 9, CelestialBodiesShown = true },
	clouds = { Enabled = true, Cover = 0.62, Density = 0.6, Color = rgb(236, 238, 242) },
	bloom = { Intensity = 0.22, Size = 24, Threshold = 2.2 },
	grade = { Brightness = 0, Contrast = 0.1, Saturation = -0.06, TintColor = rgb(255, 250, 244) },
	sunrays = { Intensity = 0.07, Spread = 0.16 },
	dof = { FarIntensity = 0.12, FocusDistance = 60, InFocusRadius = 90, NearIntensity = 0 },
	terrain = { Grass = rgb(84, 102, 60), LeafyGrass = rgb(72, 92, 52), Ground = rgb(98, 82, 64), Mud = rgb(72, 60, 48),
		Rock = rgb(112, 108, 102), Slate = rgb(92, 92, 92), Sand = rgb(190, 174, 140), Sandstone = rgb(160, 124, 92),
		Snow = rgb(232, 236, 242), Asphalt = rgb(62, 62, 64), Concrete = rgb(128, 126, 122), Basalt = rgb(60, 58, 60),
		Cobblestone = rgb(110, 104, 98) },
	water = { WaterColor = rgb(40, 76, 84), WaterTransparency = 0.6, WaterReflectance = 0.8, WaterWaveSize = 0.15,
		WaterWaveSpeed = 6 },
	mats = REAL_MATS,
	palette = { primary = hex("#6b705c"), secondary = hex("#3f4a3c"), accent = hex("#c2a878"), ground = hex("#58663c"),
		groundAlt = hex("#6f7a48"), dirt = hex("#62523f"), rock = hex("#706c66"), sand = hex("#bead8c"), wood = hex("#6e5440"),
		woodDark = hex("#3e3026"), leaf = hex("#4a5e34"), leafAlt = hex("#5f7040"), blossom = hex("#d8a8b8"),
		flower = hex("#d8c25a"), water = hex("#284c54"), wall = hex("#b8b0a2"), roof = hex("#5a4a42"), floor = hex("#7a5e44"),
		trim = hex("#d8d4cc"), ink = hex("#1e2022"), light = hex("#ffe9c4"), glow = hex("#ffcf8a"), metal = hex("#7c8088"),
		path = hex("#8c8270"), danger = hex("#c43c2c"), gold = hex("#c8a24a"), sky = hex("#9fb4c8"), fabric = hex("#5c6650") },
}

LOOKS.cozy = {
	lighting = { ClockTime = 17.45, GeographicLatitude = 28, Brightness = 2.2, ExposureCompensation = 0.15,
		Ambient = rgb(132, 112, 102), OutdoorAmbient = rgb(168, 142, 126), ColorShift_Top = rgb(255, 214, 170),
		ColorShift_Bottom = rgb(110, 80, 96), EnvironmentDiffuseScale = 0.6, EnvironmentSpecularScale = 0.2,
		ShadowSoftness = 0.8 },
	atmosphere = { Density = 0.26, Offset = 0.12, Color = rgb(255, 216, 186), Decay = rgb(224, 156, 144), Glare = 0.4,
		Haze = 1.2 },
	sky = { StarCount = 0, SunAngularSize = 18, MoonAngularSize = 11, CelestialBodiesShown = true },
	clouds = { Enabled = true, Cover = 0.5, Density = 0.45, Color = rgb(255, 222, 206) },
	bloom = { Intensity = 0.6, Size = 32, Threshold = 1.4 },
	grade = { Brightness = 0.03, Contrast = 0.02, Saturation = 0.08, TintColor = rgb(255, 240, 226) },
	sunrays = { Intensity = 0.08, Spread = 0.5 },
	dof = { FarIntensity = 0.08, FocusDistance = 40, InFocusRadius = 70, NearIntensity = 0 },
	terrain = { Grass = rgb(150, 196, 120), LeafyGrass = rgb(130, 180, 108), Ground = rgb(196, 150, 112),
		Mud = rgb(150, 112, 90), Rock = rgb(186, 170, 160), Sand = rgb(246, 222, 178), Snow = rgb(255, 250, 246),
		Cobblestone = rgb(200, 182, 168), WoodPlanks = rgb(200, 150, 108) },
	water = { WaterColor = rgb(110, 190, 196), WaterTransparency = 0.35, WaterReflectance = 0.35 },
	mats = merge(TOON_MATS, { wood = M.Wood, fabric = M.Fabric, floor = M.WoodPlanks }),
	palette = { primary = hex("#f2a07b"), secondary = hex("#8ec5b5"), accent = hex("#f7d488"), ground = hex("#a4cc84"),
		groundAlt = hex("#c3dd9a"), dirt = hex("#c49670"), rock = hex("#bcaea2"), sand = hex("#f6dfb4"), wood = hex("#c08a5c"),
		woodDark = hex("#8a5c40"), leaf = hex("#8fc27a"), leafAlt = hex("#b5d98e"), blossom = hex("#ffb7c5"),
		flower = hex("#ffd27a"), water = hex("#6ebec4"), wall = hex("#fbeee0"), roof = hex("#d9776a"), floor = hex("#d9a77a"),
		trim = hex("#fff8ee"), ink = hex("#4a3a3a"), light = hex("#fff1d6"), glow = hex("#ffc98a"), metal = hex("#c9c2bc"),
		path = hex("#e6c9a0"), danger = hex("#e8645a"), gold = hex("#f2c14e"), sky = hex("#ffd9c0"), fabric = hex("#e98e8e") },
}

LOOKS.neon_night = {
	lighting = { ClockTime = 0.2, GeographicLatitude = 30, Brightness = 0.7, ExposureCompensation = 0.35,
		Ambient = rgb(42, 32, 72), OutdoorAmbient = rgb(54, 44, 96), ColorShift_Top = rgb(140, 120, 255),
		ColorShift_Bottom = rgb(20, 10, 40), EnvironmentDiffuseScale = 0.5, EnvironmentSpecularScale = 1,
		ShadowSoftness = 0.3 },
	atmosphere = { Density = 0.36, Offset = 0.05, Color = rgb(96, 44, 150), Decay = rgb(22, 10, 54), Glare = 0, Haze = 2.2 },
	sky = { StarCount = 2500, SunAngularSize = 0, MoonAngularSize = 9, CelestialBodiesShown = true },
	clouds = { Enabled = true, Cover = 0.35, Density = 0.3, Color = rgb(70, 46, 120) },
	bloom = { Intensity = 1.2, Size = 40, Threshold = 0.9 },
	grade = { Brightness = 0.02, Contrast = 0.2, Saturation = 0.35, TintColor = rgb(236, 226, 255) },
	sunrays = { Intensity = 0, Spread = 0 },
	dof = false,
	terrain = { Asphalt = rgb(26, 24, 36), Concrete = rgb(44, 42, 58), Grass = rgb(30, 60, 70), Ground = rgb(36, 30, 50),
		Rock = rgb(50, 46, 66), Slate = rgb(40, 38, 54), Pavement = rgb(48, 44, 64), Basalt = rgb(30, 28, 40) },
	water = { WaterColor = rgb(30, 16, 70), WaterTransparency = 0.2, WaterReflectance = 1 },
	mats = merge(TOON_MATS, { metal = M.Metal, glass = M.Glass, road = M.Asphalt }),
	palette = { primary = hex("#ff2bd6"), secondary = hex("#00e5ff"), accent = hex("#fff94a"), ground = hex("#16141f"),
		groundAlt = hex("#211d33"), dirt = hex("#2a2438"), rock = hex("#34304a"), sand = hex("#3a3550"), wood = hex("#3a2a3e"),
		woodDark = hex("#22182a"), leaf = hex("#1fbf8f"), leafAlt = hex("#39ffb0"), blossom = hex("#ff5fd0"),
		flower = hex("#fff94a"), water = hex("#1e1046"), wall = hex("#1c1a2e"), roof = hex("#2a2742"), floor = hex("#1a1828"),
		trim = hex("#00e5ff"), ink = hex("#07060d"), light = hex("#e8e0ff"), glow = hex("#ff2bd6"), metal = hex("#5a5878"),
		path = hex("#2d2a40"), danger = hex("#ff3355"), gold = hex("#ffd84a"), sky = hex("#3a1a6e"), fabric = hex("#7a2bff") },
